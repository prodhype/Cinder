import cinder
import process


def python_driver() -> String:
    return "import sys; from cinder.cli import main; raise SystemExit(main(sys.argv[1:]))"


def main(argc: i32, argv: **char) -> i32:
    command: List[String] = ["python3", "-c", python_driver()]
    for index in range(1, argc):
        command.append(String(argv[index]))

    result = process.run(command)
    cinder.write_stdout(result.stdout)
    cinder.write_stderr(result.stderr)
    return result.exit_code
