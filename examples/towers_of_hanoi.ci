def move_disks(
    count: i32,
    source: &const String,
    target: &const String,
    spare: &const String,
) -> void:
    if count == 0:
        return

    move_disks(count - 1, source, spare, target)
    print(f"move disk {count} from {source} to {target}")
    move_disks(count - 1, spare, target, source)


def main() -> i32:
    line = input("Disks: ")
    match parse_i32(line):
        case Ok(disks):
            if disks < 0:
                print("need a non-negative disk count")
                return 1
            print(f"solving Towers of Hanoi with {disks} disks")
            source: String = "A"
            target: String = "C"
            spare: String = "B"
            move_disks(disks, source, target, spare)
            return 0
        case Err(error):
            print("invalid disk count:", cast[i32](error))
            return 1
