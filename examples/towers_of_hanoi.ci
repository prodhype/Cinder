def move_disks(count: i32, source: const char*, target: const char*, spare: const char*) -> void:
    if count == 0:
        return

    move_disks(count - 1, source, spare, target)
    print(f"move disk {count} from {source} to {target}")
    move_disks(count - 1, spare, target, source)


def main() -> i32:
    line = input("Disks: ")
    defer free(cast[void*](line))
    match parse_i32(line):
        case Ok(disks):
            if disks < 0:
                print("need a non-negative disk count")
                return 1
            print(f"solving Towers of Hanoi with {disks} disks")
            move_disks(disks, "A", "C", "B")
            return 0
        case Err(error):
            print("invalid disk count:", cast[i32](error))
            return 1
