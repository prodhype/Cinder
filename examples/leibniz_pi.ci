# Leibniz formula for π:
#   π/4 = 1 - 1/3 + 1/5 - 1/7 + ... = Σ_{n=0}^{∞} (-1)^n / (2n + 1)
#
# Sign is derived from the index (`i & 1`) instead of a carried `sign = -sign`
# dependency, which lets optimizing C compilers auto-vectorize the loop.
# inspired by https://niklas-heer.github.io/speed-comparison/

extern "C":
    def cinder_wall_time() -> f64


def leibniz_pi(iterations: u32) -> f64:
    # Seed with the n=0 term (+1), then add n=1 .. iterations from i=2.
    pi: f64 = 1.0
    rounds = iterations + 2
    for i: u32 = 2; i < rounds; i += 1:
        x = -1.0 + 2.0 * (i & 1)
        pi += x / (2 * i - 1)
    return pi * 4.0


def main() -> i32:
    iterations: u32 = 1_000_000_000

    print(f"Leibniz π with {iterations} iterations")

    started = cinder_wall_time()
    estimate = leibniz_pi(iterations)
    end = cinder_wall_time()
    elapsed_ms = cast[i64]((end - started) * 1000.0)

    print(f"π ≈ {estimate:.12f}")
    print(f"elapsed: {elapsed_ms} ms")
    return 0
