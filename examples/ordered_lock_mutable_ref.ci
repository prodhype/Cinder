# Lock and CriticalSection tour.
#
# This example keeps the live code smoke-safe while showing how Cinder models:
# - explicit lock order declarations
# - nested CriticalSection blocks
# - lock effects through function calls
# - concrete method effects while a lock is held
# - aliases that keep static lock identity
# - independent locks
# - dynamic lock collections that must be sorted before acquisition
# - read-only views of ordered lock lists
# - ordered-list elements cannot escape through mutable pointers or references
# - external calls have unknown lock effects
#
# WRONG: this would let the callee reorder sorted locks while the caller still
# has the ordered marker. A later CriticalSection would trust stale ordering.
#
# def scramble(locks: &List[Lock], replacement: Lock) -> void:
#     locks[2] = replacement
#
# def invalid_mutable_reference() -> void:
#     locks: List[Lock] = [first, second, second]
#     ordered = sorted(locks)
#     scramble(ordered, first)
#
# WRONG: an element pointer would erase the ordered-list provenance and permit
# a later store to create non-adjacent duplicates.
#
# def invalid_element_pointer() -> void:
#     locks: List[Lock] = [first, second, second]
#     ordered = sorted(locks)
#     slot = &ordered[2]
#     slot[0] = first
#
# WRONG: dynamic lock collections must be sorted before acquisition.
#
# def invalid_plain_dynamic_list() -> void:
#     locks: List[Lock] = [cache, root]
#     CriticalSection locks:
#         pass
#
# WRONG: static nesting must follow the declared order.
#
# def invalid_reverse_order() -> void:
#     CriticalSection cache:
#         CriticalSection root:
#             pass
#
# WRONG: methods are checked against the same lock order as free functions.
#
# struct InvalidWorker:
#     def update(self) -> void:
#         CriticalSection cache:
#             CriticalSection root:
#                 pass
#
# WRONG: an alias assigned on a conditional path is dynamic after the branch.
#
# def invalid_conditional_alias(flag: bool) -> void:
#     selected = root
#     if flag:
#         selected = cache
#     CriticalSection root:
#         CriticalSection selected:
#             pass
#
# WRONG: taking a lock alias by mutable reference makes its identity dynamic;
# the callee can retarget it without a direct assignment in this function.
#
# def retarget(target: &Lock) -> void:
#     *target = root
#
# def invalid_mutable_alias() -> void:
#     selected = cache
#     retarget(&selected)
#     CriticalSection root:
#         CriticalSection selected:
#             pass
#
# WRONG: indirect calls have unknown lock effects while a lock is held.
#
# def invalid_indirect_call(callback: def() -> void) -> void:
#     CriticalSection cache:
#         callback()
#
# WRONG: external implementations have unknown lock effects, so they cannot be
# called while a lock is held.
#
# extern "C":
#     def opaque_operation() -> void
#
# def invalid_extern_call() -> void:
#     CriticalSection cache:
#         opaque_operation()
#
# WRONG: locals are destroyed before their enclosing critical section releases
# its lock, so destructor effects must also follow the declared order.
#
# class InvalidCleanup:
#     def __del__(self):
#         CriticalSection root:
#             pass
#
# def invalid_destructor_cleanup() -> void:
#     CriticalSection cache:
#         cleanup = InvalidCleanup()
#
# WRONG: a generated default constructor initializes its implementation base.
# The base constructor's lock effects still apply at the derived call site.
#
# class InvalidBase:
#     def __init__(self):
#         CriticalSection root:
#             pass
#
# class InvalidDerived(InvalidBase):
#     pass
#
# def invalid_default_constructor() -> void:
#     CriticalSection cache:
#         value = InvalidDerived()
#
# CORRECT: read-only views cannot invalidate canonical order, and sorted dynamic
# collections can be acquired as a single CriticalSection target.

lock root
lock config after root
lock cache after config
lock audit after cache
lock metrics

progress: i32 = 0


struct Counter:
    value: i32

    def current(self) -> i32:
        return self.value


def remember(step: i32) -> void:
    progress += step


def count_locks(locks: &const List[Lock]) -> i32:
    return cast[i32](len(locks))


def static_hierarchy() -> void:
    CriticalSection root:
        remember(1)
        CriticalSection config:
            remember(10)
            CriticalSection cache:
                remember(100)


def flush_audit_log() -> void:
    CriticalSection audit:
        remember(1000)


def update_configured_cache() -> void:
    CriticalSection root:
        CriticalSection config:
            CriticalSection cache:
                remember(10000)
            flush_audit_log()


def alias_keeps_lock_identity() -> void:
    selected = cache
    CriticalSection root:
        CriticalSection config:
            CriticalSection selected:
                remember(100000)


def concrete_method_effect_is_known() -> void:
    counter = Counter(value=progress)
    CriticalSection root:
        counter.current()


def record_independent_metric() -> void:
    CriticalSection metrics:
        remember(1000000)


def acquire_runtime_collection() -> i32:
    # Locks are not reentrant; duplicate entries are safe here because sorted()
    # makes them adjacent and CriticalSection acquires each distinct lock once.
    locks: List[Lock] = [audit, root, cache, config, config]
    ordered = sorted(locks)
    if count_locks(ordered) != 5:
        return 1

    CriticalSection ordered:
        remember(10000000)
    return 0


def main() -> i32:
    static_hierarchy()
    update_configured_cache()
    alias_keeps_lock_identity()
    concrete_method_effect_is_known()
    record_independent_metric()
    if acquire_runtime_collection() != 0:
        return 1
    if progress != 11111111:
        return 2
    return 0
