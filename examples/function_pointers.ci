# Transparent function pointers: pass a named def by name, store it, and call it.

def double(n: i32) -> i32:
    return n * 2


def apply(f: def(i32) -> i32, x: i32) -> i32:
    return f(x)


def main() -> i32:
    callback = double
    # the explicit annotation form:
    # typed: def(i32) -> i32 = double
    # return apply(callback, 21) + typed(0)
    print(apply(callback, 21) + double(0))
    return 0 # apply(callback, 21) + double(0)
