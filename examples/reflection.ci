@reflect
struct User:
    id: u64
    name: String
    active: bool

    def enabled(self: &const User) -> bool:
        return self.active


static_assert(field_count(User) == 3, "User layout changed")
static_assert(method_count(User) == 1)
static_assert(has_field(User, "name"))
static_assert(has_method(User, "enabled"))


def print_compile_time_layout() -> void:
    for field in comptime fields_of(User):
        print(f"compile-time field: {field.name}, offset={field.offset}, size={field.size}")


def main() -> i32:
    user = User(id=42, name="Cinder", active=true)
    info = type_info(user)
    print(f"type: {info.name}, fields={info.field_count}, methods={info.method_count}")

    for field in fields(user):
        print(f"runtime field: {field.name} ({field.type_name})")

    print_compile_time_layout()
    return 0
