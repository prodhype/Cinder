# Aggregate ownership for structs, classes, and Lists.
#
# Passing Bundle by value transfers its owning List to take_bundle. Portfolio's
# constructor likewise moves the List[Resource] into an owning class field.

class Resource:
    label: i32

    def __init__(self, label: i32):
        self.label = label

    def __del__(self):
        print(f"drop Resource({self.label})")


struct Bundle:
    items: List[i32]


class Portfolio:
    holdings: List[Resource]

    def __init__(self, holdings: List[Resource]):
        self.holdings = holdings


def take_bundle(bundle: Bundle) -> i32:
    return cast[i32](len(bundle.items))


def main() -> i32:
    bundle = Bundle(items=[1, 2, 3])
    print("take_bundle total=", take_bundle(bundle))

    holdings: List[Resource] = []
    holdings.append(Resource(9))
    portfolio = Portfolio(holdings)
    print("portfolio holdings=", len(portfolio.holdings))
    return 0
