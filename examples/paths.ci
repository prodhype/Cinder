from std.path import Path


def fail(code: i32, message: String) -> i32:
    print("path example failed:", message)
    return code


def main() -> i32:
    root = ".cinder/example-output/path-api"
    nested = Path.join(root, "nested")
    leaf = Path.join(nested, "leaf")
    Path.create_dir_all(nested)
    if not Path.exists(leaf):
        Path.create_dir(leaf)
    if not Path.exists(root) or not Path.is_dir(nested) or not Path.is_dir(leaf):
        return fail(1, "directory creation")

    original = Path.join(right="sample.tar.gz", left=nested)
    if Path.parent(original) != nested:
        return fail(2, "parent")
    if Path.name(original) != "sample.tar.gz":
        return fail(3, "name")
    if Path.stem(original) != "sample.tar":
        return fail(4, "stem")
    if Path.stem(".profile") != ".profile":
        return fail(5, "hidden-file stem")
    if Path.parent("/") != "/" or Path.name("/") != "":
        return fail(6, "root handling")
    computed = Path.join(Path.parent("alpha/file.tmp"), Path.name("beta/result.txt"))
    if computed != "alpha/result.txt":
        return fail(7, "computed String arguments")
    if Path.exists(Path.with_suffix(Path.join(nested, "missing.tmp"), ".txt")):
        return fail(8, "nested predicate")
    Path.create_dir_all(Path.join(root, "computed"))
    if not Path.is_dir(Path.join(root, "computed")):
        return fail(9, "computed mutator argument")
    print(Path.parent("a/b"))

    with open(original, "wb") as file:
        file.write("native path API\n")
    if not Path.is_file(original) or Path.is_dir(original):
        return fail(10, "file predicates")

    renamed = Path.with_suffix(path=original, suffix=".txt")
    Path.rename(destination=renamed, source=original)
    if Path.exists(original) or not Path.is_file(renamed):
        return fail(11, "rename")

    Path.remove_file(renamed)
    if Path.exists(renamed):
        return fail(12, "remove_file")
    return 0
