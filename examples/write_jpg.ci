def write_jpeg(file: &File) -> bool:
    # Minimal valid 1x1 grayscale JFIF image, written in marker order.
    soi: u8[2] = [0xFF, 0xD8]
    if file.write(soi) != 2:
        return false

    # APP0 / JFIF header
    app0: u8[18] = [
        0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46,
        0x00, 0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01,
        0x00, 0x00,
    ]
    if file.write(app0) != 18:
        return false

    # DQT: luminance quantization table
    dqt: u8[69] = [
        0xFF, 0xDB, 0x00, 0x43, 0x00, 0x08, 0x06, 0x06,
        0x07, 0x06, 0x05, 0x08, 0x07, 0x07, 0x07, 0x09,
        0x09, 0x08, 0x0A, 0x0C, 0x14, 0x0D, 0x0C, 0x0B,
        0x0B, 0x0C, 0x19, 0x12, 0x13, 0x0F, 0x14, 0x1D,
        0x1A, 0x1F, 0x1E, 0x1D, 0x1A, 0x1C, 0x1C, 0x20,
        0x24, 0x2E, 0x27, 0x20, 0x22, 0x2C, 0x23, 0x1C,
        0x1C, 0x28, 0x37, 0x29, 0x2C, 0x30, 0x31, 0x34,
        0x34, 0x34, 0x1F, 0x27, 0x39, 0x3D, 0x38, 0x32,
        0x3C, 0x2E, 0x33, 0x34, 0x32,
    ]
    if file.write(dqt) != 69:
        return false

    # SOF0: baseline frame, 1x1, one component
    sof0: u8[13] = [
        0xFF, 0xC0, 0x00, 0x0B, 0x08, 0x00, 0x01, 0x00,
        0x01, 0x01, 0x01, 0x11, 0x00,
    ]
    if file.write(sof0) != 13:
        return false

    # DHT: DC and AC Huffman tables (minimal)
    dht_dc: u8[22] = [
        0xFF, 0xC4, 0x00, 0x14, 0x00, 0x01, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x03,
    ]
    if file.write(dht_dc) != 22:
        return false

    dht_ac: u8[22] = [
        0xFF, 0xC4, 0x00, 0x14, 0x10, 0x01, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    ]
    if file.write(dht_ac) != 22:
        return false

    # SOS + compressed scan + EOI
    scan: u8[14] = [
        0xFF, 0xDA, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00,
        0x3F, 0x00, 0x7F, 0x3F, 0xFF, 0xD9,
    ]
    if file.write(scan) != 14:
        return false

    return true


def main() -> i32:
    path: String = "cinder_sample.jpg"

    with open(path, "wb") as file:
        if not write_jpeg(file):
            print(f"failed while writing {path}")
            return 2

    print(f"wrote JPEG image to {path}")
    return 0
