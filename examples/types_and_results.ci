enum ParseError:
    negative
    too_large = 10

union Number:
    integer: i32
    real: f64

variant Token:
    Integer(value: i32)
    End


def parse(value: i32) -> Result[Token, ParseError]:
    if value < 0:
        return Err(ParseError.negative)
    if value > 100:
        return Err(ParseError.too_large)
    return Ok(Token.Integer(value))


def increment(value: i32) -> Result[i32, ParseError]:
    token = parse(value)?

    match token:
        case Token.Integer(parsed):
            return Ok(parsed + 1)
        case Token.End:
            return Ok(0)


def negative_error() -> ParseError:
    return ParseError.negative


def too_large_error() -> ParseError:
    return ParseError.too_large


def format_too_large_error() -> i32:
    print(f"status={ParseError.too_large}")
    return 0


def main() -> i32:
    number = Number(integer=41)
    result = increment(number.integer)

    match result:
        case Ok(value):
            print(f"value={value}")
        case Err(error):
            print(f"error={cast[i32](error)}")

    return 0
