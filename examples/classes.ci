import math

@reflect
abstract class Shape:
    name: String

    def __init__(self, name: String):
        self.name = name

    @abstractmethod
    def area(self) -> f64:
        pass

    def describe(self) -> void:
        print(f"{self.name}: {self.area():.2f}")


@reflect
class Circle(Shape):
    radius: f64

    def __init__(self, radius: f64):
        super().__init__("circle")
        self.radius = radius

    @override
    def area(self) -> f64:
        return math.pi * self.radius * self.radius

    def print_inherited_name(self) -> void:
        print(self.name)

    def format_inherited_name(self) -> void:
        print(f"circle name: {self.name}")


@export
def export_circle_radius(circle: Circle) -> f64:
    return circle.radius


def describe(shape: &dyn Shape) -> void:
    print(f"runtime type: {type_name(shape)}")
    shape.describe()


def main() -> i32:
    circle = Circle(radius=4.0)
    circle.print_inherited_name()
    circle.format_inherited_name()
    describe(circle)
    return 0


struct DeepField10:
    value: i32


struct DeepField9:
    next: DeepField10


struct DeepField8:
    next: DeepField9


struct DeepField7:
    next: DeepField8


struct DeepField6:
    next: DeepField7


struct DeepField5:
    next: DeepField6


struct DeepField4:
    next: DeepField5


struct DeepField3:
    next: DeepField4


struct DeepField2:
    next: DeepField3


struct DeepField1:
    next: DeepField2


struct DeepField0:
    next: DeepField1


def deep_field_value(root: DeepField0) -> i32:
    return root.next.next.next.next.next.next.next.next.next.next.value


def format_deep_field_value(root: DeepField0) -> void:
    print(f"value={root.next.next.next.next.next.next.next.next.next.next.value}")


def format_indexed_deep_field_value(values: DeepField10[1]) -> void:
    print(f"value={values[0].value}")
