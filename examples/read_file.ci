import process


def ensure_output_dir() -> bool:
    command: List[String] = ["mkdir", "-p", ".cinder/example-output"]
    result = process.run(command)
    return result.exit_code == 0


def main() -> i32:
    if not ensure_output_dir():
        print("failed to create .cinder/example-output")
        return 1

    path: String = ".cinder/example-output/cinder_sample.txt"

    with open(path, "wb") as out:
        # "hello\nworld\n"
        payload: u8[12] = [
            104, 101, 108, 108, 111, 10,
            119, 111, 114, 108, 100, 10,
        ]
        if out.write(payload) != 12:
            print(f"failed while writing {path}")
            return 1

    with open(path, "rb") as file:
        chunk: u8[5]
        counted = file.read(chunk)
        print(f"read {counted} bytes:", chunk[0], chunk[1], chunk[2], chunk[3], chunk[4])

    with open(path, "rb") as file:
        first = file.read_line()
        if first.is_none:
            return 1
        second = file.read_line()
        if second.is_none:
            return 1
        print("read_line:", first.value)
        print("read_line:", second.value)

    with open(path, "rb") as file:
        data = file.read_all()
        print(f"read_all length={len(data)}")
        print(data)

    print(f"finished reading {path}")

    with open("examples/read_file.ci", "rb") as self_file:
        while true:
            line = self_file.read_line()
            if line.is_none:
                break
            print(line.value)

    return 0
