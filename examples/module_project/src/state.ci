from std.atomic import Atomic as A

enum Code:
    Zero
    One
    Two
    Three
    Four
    Five
    Six
    Seven


counter: A[u64] = cast[u64](Code.Seven)


def read[T](cell: *A[T]) -> T:
    return cell.load()


def atomic_specializations_work() -> bool:
    small: A[u32] = 7
    wide: A[u64] = 0x100000001
    return read(&small) == 7 and read(&wide) == 0x100000001
