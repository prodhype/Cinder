import stdio
import model
import support.parser as parser
from model import ParseError, Token


def increment(value: i32) -> Result[i32, ParseError]:
    token = parser.parse(value)?

    match token:
        case Token.Integer(parsed):
            return Ok(parsed + model.offset)
        case Token.End:
            return Ok(0)


def main() -> i32:
    result = increment(41)

    match result:
        case Ok(value):
            stdio.printf("value=%d\n", value)
        case Err(error):
            stdio.printf("error=%d\n", cast[i32](error))

    return 0
