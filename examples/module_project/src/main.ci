import std.atomic as atom
import model
import state
import support.parser as parser
from model import ParseError, Token

qualified_counter: atom.Atomic[u64] = 4


def increment(value: i32) -> Result[i32, ParseError]:
    token = parser.parse(value)?

    match token:
        case Token.Integer(parsed):
            return Ok(parsed + model.offset)
        case Token.End:
            return Ok(0)


def main() -> i32:
    if qualified_counter.fetch_add(2) != 4 or qualified_counter.load() != 6:
        return 1
    if state.counter.fetch_add(3) != 0 or state.counter.load() != 3:
        return 2
    if not state.atomic_specializations_work():
        return 3

    result = increment(41)

    match result:
        case Ok(value):
            print(f"value={value}")
        case Err(error):
            print(f"error={cast[i32](error)}")

    return 0
