# Rust hosts a flat C ABI. Inside Cinder we use @reflect runtime metadata and
# comptime fields_of unrolling — layout inspection Rust cannot do without
# proc-macros or an external reflection crate. A separate @export runs a tight
# Leibniz loop so the host can time native Cinder (-O2) against the same
# algorithm in optimized Rust (--release).
#
# Export only C primitives. Do not put String/List/Map on the public C API.

@reflect
struct Vec3:
    x: i32
    y: i32
    z: i32


static_assert(field_count(Vec3) == 3, "Vec3 layout changed")
static_assert(has_field(Vec3, "x"))
static_assert(has_field(Vec3, "y"))
static_assert(has_field(Vec3, "z"))


def schema_fingerprint() -> i32:
    # Unrolled at compile time into ordinary C — no runtime loop, no macros.
    h: i32 = 0
    for field in comptime fields_of(Vec3):
        h = h + cast[i32](field.offset) + cast[i32](field.size)
    return h


@export
def cinder_vec3_field_count() -> i32:
    v = Vec3(x=1, y=2, z=3)
    info = type_info(v)
    return cast[i32](info.field_count)


@export
def cinder_describe_vec3() -> i32:
    v = Vec3(x=10, y=20, z=30)
    for field in fields(v):
        print(f"runtime field: {field.name} ({field.type_name})")
    return schema_fingerprint()


# Hot path for the host timing demo. Same series as examples/leibniz_pi.ci;
# no print so the measurement is the loop, not I/O.
@export
def cinder_leibniz(iterations: i32) -> f64:
    pi: f64 = 1.0
    rounds = iterations + 2
    for i: i32 = 2; i < rounds; i += 1:
        x = -1.0 + 2.0 * (i & 1)
        pi += x / (2 * i - 1)
    return pi * 4.0


