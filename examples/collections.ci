def summarize(values: &const List[i32]) -> Tuple[i32, usize]:
    total: i32 = 0
    for value in values:
        total += value
    return (total, len(values))


def main() -> i32:
    values = [5, 1, 4, 2, 3]
    values.append(6)
    sort(values)

    summary = summarize(values)
    print(f"count={summary[1]} total={summary[0]}")

    last = values.pop()
    print(f"last={last} remaining={len(values)}")

    values.clear()
    return 0
