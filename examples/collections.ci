def summarize(values: []const i32) -> Tuple[i32, usize]:
    total: i32 = 0
    for value in values:
        total += value
    return (total, len(values))


def main() -> i32:
    values = [5, 1, 4, 2, 3]
    defer values.clear()
    values.append(6)
    sort(values)

    summary = summarize(values)
    print(f"count={summary[1]} total={summary[0]}")

    last = values.pop()
    print(f"last={last} remaining={len(values)}")

    scores = {"Ada": 3, "Grace": 5}
    scores["Ada"] += 4
    for entry in scores.items():
        print(f"{entry[0]}={entry[1]}")

    ada_score = scores.get("Ada")
    match ada_score:
        case Some(score):
            print(f"Ada score={score}")
        case None:
            print("Ada has no score")

    primes = {2, 3, 5}
    odd = {1, 3, 5, 7}
    combined = primes | odd
    print(f"unique values={len(combined)}")

    return 0
