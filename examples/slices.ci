def sum(values: []const i32) -> i32:
    total: i32 = 0
    for value in values:
        total += value
    return total


def main() -> i32:
    values: i32[5] = [1, 2, 3, 4, 5]
    middle = values[1:4]
    print(f"sum: {sum(middle)}, length: {middle.length}")
    print(f"whole: {sum(values)}")
    return 0
