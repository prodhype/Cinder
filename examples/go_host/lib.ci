# Go hosts a flat C ABI. Inside Cinder we build an arena-owned expression AST,
# evaluate it with exhaustive variant matching and Result/?, then drop the arena
# when the export returns — ownership and exhaustiveness that Go does not check.
# A separate @export runs a tight Leibniz loop so the host can time native
# Cinder (-O2) against the same algorithm in optimized Go.
#
# Export only C primitives. Do not put String/List/Map on the public C API.

class Trace:
    label: i32

    def __init__(self, label: i32):
        self.label = label

    def __del__(self):
        print(f"cinder drop Trace({self.label})")


struct NodeId:
    index: i32


variant ExprKind:
    Literal(value: i32)
    Binary(op: char, left: NodeId, right: NodeId)


struct Expr:
    kind: ExprKind


struct AstArena:
    nodes: List[Expr]
    traces: List[Trace]

    def next_node_id(self: &const AstArena) -> NodeId:
        return NodeId(index=cast[i32](len(self.nodes)))

    def add_literal(self: &AstArena, value: i32) -> NodeId:
        id = self.next_node_id()
        self.nodes.append(Expr(kind=ExprKind.Literal(value=value)))
        return id

    def add_binary(self: &AstArena, op: char, left: NodeId, right: NodeId) -> NodeId:
        id = self.next_node_id()
        self.nodes.append(Expr(kind=ExprKind.Binary(op=op, left=left, right=right)))
        return id

    def evaluate(self: &const AstArena, node_id: NodeId) -> Result[i32, i32]:
        node = self.nodes[node_id.index]
        result: Result[i32, i32] = Err(-2)
        match node.kind:
            case ExprKind.Literal(value):
                result = Ok(value)
            case ExprKind.Binary(op, left, right):
                left_value = self.evaluate(left)?
                right_value = self.evaluate(right)?
                if op == '+':
                    result = Ok(left_value + right_value)
                elif op == '*':
                    result = Ok(left_value * right_value)
                elif op == '/':
                    if right_value == 0:
                        result = Err(-1)
                    else:
                        result = Ok(left_value / right_value)
                else:
                    result = Err(-2)
        return result


def run_binary_tree(a: i32, b: i32, c: i32, op: char, trace_label: i32) -> i32:
    arena = AstArena(nodes=[], traces=[])
    arena.traces.append(Trace(trace_label))
    left = arena.add_literal(a)
    right = arena.add_literal(b)
    sum_node = arena.add_binary('+', left, right)
    root = arena.add_binary(op, sum_node, arena.add_literal(c))
    out: i32 = 0
    match arena.evaluate(root):
        case Ok(value):
            out = value
        case Err(code):
            out = code
    return out


@export
def cinder_eval_expr(a: i32, b: i32, c: i32) -> i32:
    # Builds (a + b) * c in an arena, evaluates, then drops the arena.
    return run_binary_tree(a, b, c, '*', 1)


@export
def cinder_eval_div(a: i32, b: i32, c: i32) -> i32:
    # Builds (a + b) / c — returns -1 when c == 0 via Result.
    return run_binary_tree(a, b, c, '/', 2)


# Hot path for the host timing demo. Same series as examples/leibniz_pi.ci;
# no Trace/print so the measurement is the loop, not destructor I/O.
@export
def cinder_leibniz(iterations: i32) -> f64:
    pi: f64 = 1.0
    rounds = iterations + 2
    for i: i32 = 2; i < rounds; i += 1:
        x = -1.0 + 2.0 * (i & 1)
        pi += x / (2 * i - 1)
    return pi * 4.0


# The same idea sketched in Go (not compiled). Missing pieces vs Cinder:
# - type switches on Expr are not exhaustive; a new kind is a silent runtime gap
