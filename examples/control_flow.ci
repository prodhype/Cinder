def main() -> i32:
    total: i32 = 0
    for value in range(1, 6):
        total += value

    for index: i32 = 0; index < 3; index += 1:
        total += index

    countdown: i32 = 3
    while countdown > 0:
        countdown -= 1

    if total == 18:
        print("control flow works")
    elif total < 18:
        return 2
    else:
        return 3

    return 0
