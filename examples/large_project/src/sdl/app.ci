import sdl.bindings as sdl
import sdl.audio as audio

struct App:
    window: *sdl.SDL_Window
    renderer: *sdl.SDL_Renderer
    sounds: audio.Sounds
    ok: bool


def create_app(title: const char*, width: c_int, height: c_int) -> App:
    empty = audio.Sounds(hit=null, brick=null, wall=null, lose=null)
    if sdl.SDL_Init(sdl.SDL_INIT_VIDEO | sdl.SDL_INIT_AUDIO) != 0:
        print("SDL_Init failed:", sdl.SDL_GetError())
        return App(window=null, renderer=null, sounds=empty, ok=false)

    if sdl.Mix_OpenAudio(
        sdl.MIX_DEFAULT_FREQUENCY,
        sdl.MIX_DEFAULT_FORMAT,
        sdl.MIX_DEFAULT_CHANNELS,
        8,
    ) != 0:
        print("Mix_OpenAudio failed:", sdl.SDL_GetError())
        sdl.SDL_Quit()
        return App(window=null, renderer=null, sounds=empty, ok=false)

    window = sdl.SDL_CreateWindow(
        title,
        sdl.SDL_WINDOWPOS_UNDEFINED,
        sdl.SDL_WINDOWPOS_UNDEFINED,
        width,
        height,
        0,
    )
    if window == null:
        print("SDL_CreateWindow failed:", sdl.SDL_GetError())
        sdl.Mix_CloseAudio()
        sdl.SDL_Quit()
        return App(window=null, renderer=null, sounds=empty, ok=false)

    renderer = sdl.SDL_CreateRenderer(
        window,
        -1,
        sdl.SDL_RENDERER_ACCELERATED | sdl.SDL_RENDERER_PRESENTVSYNC,
    )
    if renderer == null:
        renderer = sdl.SDL_CreateRenderer(window, -1, 0)
    if renderer == null:
        print("SDL_CreateRenderer failed:", sdl.SDL_GetError())
        sdl.SDL_DestroyWindow(window)
        sdl.Mix_CloseAudio()
        sdl.SDL_Quit()
        return App(window=null, renderer=null, sounds=empty, ok=false)

    sounds = audio.load_sounds()
    if (
        sounds.hit == null
        or sounds.brick == null
        or sounds.wall == null
        or sounds.lose == null
    ):
        print("Mix_LoadWAV failed:", sdl.SDL_GetError())
        audio.free_sounds(sounds)
        sdl.SDL_DestroyRenderer(renderer)
        sdl.SDL_DestroyWindow(window)
        sdl.Mix_CloseAudio()
        sdl.SDL_Quit()
        return App(window=null, renderer=null, sounds=empty, ok=false)

    return App(window=window, renderer=renderer, sounds=sounds, ok=true)


def destroy_app(app: App) -> void:
    if not app.ok:
        return
    audio.free_sounds(app.sounds)
    sdl.SDL_DestroyRenderer(app.renderer)
    sdl.SDL_DestroyWindow(app.window)
    sdl.Mix_CloseAudio()
    sdl.SDL_Quit()
