import game.ball as ball_mod
import game.bricks as bricks_mod
import game.config as config
import game.paddle as paddle_mod
import sdl.audio as audio
import sdl.bindings as sdl
import sdl.draw as draw
import sdl.events as events

struct World:
    paddle: paddle_mod.Paddle
    ball: ball_mod.Ball
    bricks: bricks_mod.Bricks
    sounds: audio.Sounds
    lives: i32
    score: i32
    won: bool
    lost: bool

    def reset_round(self: &World) -> void:
        self.paddle.reset()
        self.ball.reset(self.paddle)

    def reset_game(self: &World) -> void:
        self.lives = config.START_LIVES
        self.score = 0
        self.won = false
        self.lost = false
        self.bricks.reset()
        self.reset_round()

    def update(self: &World, input: events.Input, dt: f32) -> void:
        if self.won or self.lost:
            if input.space_pressed:
                self.reset_game()
            return

        self.paddle.update(input.left, input.right, dt)
        if input.space_pressed:
            self.ball.launch()
        self.ball.stick_to_paddle(self.paddle)
        self.ball.integrate(dt)

        if self.ball.bounce_walls() != 0:
            audio.play(self.sounds.wall)

        if self.ball.bounce_paddle(self.paddle):
            audio.play(self.sounds.hit)

        if self.bricks.collide(self.ball.bounds, self.ball.velocity):
            self.score += 10
            audio.play(self.sounds.brick)
            # print(f"score={self.score} bricks={self.bricks.remaining}")

        if self.bricks.remaining <= 0:
            self.won = true
            print("you win")
            return

        if self.ball.fell_off():
            self.lives -= 1
            audio.play(self.sounds.lose)
            print(f"lives={self.lives}")
            if self.lives <= 0:
                self.lost = true
                print("game over")
            else:
                self.reset_round()

    def draw_hud(self: &const World, renderer: *sdl.SDL_Renderer) -> void:
        for life in range(0, self.lives):
            draw.fill_rect(
                renderer,
                12 + life * 18,
                12,
                14,
                10,
                draw.Color(r=90, g=200, b=120, a=255),
            )
        bar_width = self.score
        if bar_width > 200:
            bar_width = 200
        if bar_width > 0:
            draw.fill_rect(
                renderer,
                config.WINDOW_WIDTH - 24 - bar_width,
                12,
                bar_width,
                10,
                draw.Color(r=80, g=160, b=255, a=255),
            )
        if self.won:
            draw.fill_rect(
                renderer,
                config.WINDOW_WIDTH / 2 - 60,
                config.WINDOW_HEIGHT / 2 - 10,
                120,
                20,
                draw.Color(r=120, g=220, b=140, a=255),
            )
        if self.lost:
            draw.fill_rect(
                renderer,
                config.WINDOW_WIDTH / 2 - 60,
                config.WINDOW_HEIGHT / 2 - 10,
                120,
                20,
                draw.Color(r=220, g=90, b=90, a=255),
            )

    def draw(self: &const World, renderer: *sdl.SDL_Renderer) -> void:
        draw.clear(renderer, draw.Color(r=18, g=22, b=30, a=255))
        self.bricks.draw(renderer)
        self.paddle.draw(renderer)
        self.ball.draw(renderer)
        self.draw_hud(renderer)
        draw.present(renderer)
