import backend_ir
import classes
import codegen_atomics
import codegen_context
import codegen_expr
import codegen_names
import codegen_reflection
import codegen_specializations
import codegen_stmt
import codegen_type_names
import generics
import project
import reflection
import semantic
import syntax
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_module_header(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
) -> String:
    registry = codegen_names.new_specialization_name_registry()
    prefix = codegen_names.c_prefix(project_name, module_name)
    codegen_specializations.collect_module_specialization_names(&registry, arena, root, source, &prefix, project_name, imports)
    return emit_module_header_with_names(arena, root, source, module_name, project_name, dependencies, imports, registry)

def emit_module_header_with_names(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> String:
    semantic_nodes: List[backend_ir.IRNode] = []
    specialization_args: List[types.TypeId] = []
    call_specializations: List[semantic.SpecializationBinding] = []
    user_specializations: List[semantic.UserSpecialization] = []
    type_table = types.new_type_table()
    return emit_module_header_with_semantics(arena, root, source, module_name, project_name, dependencies, imports, registry, semantic_nodes, specialization_args, call_specializations, user_specializations, type_table)


def emit_module_header_with_semantics(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
) -> String:
    class_model = classes.collect_single_module_class_model(
        arena,
        root,
        source,
        module_name,
        project_name,
        imports,
        registry,
    )
    return emit_module_header_with_semantics_and_classes(
        arena,
        root,
        source,
        module_name,
        project_name,
        dependencies,
        imports,
        registry,
        semantic_nodes,
        specialization_args,
        call_specializations,
        user_specializations,
        type_table,
        class_model,
    )


def emit_module_header_with_semantics_and_classes(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
    class_model: &const classes.ProjectClassModel,
) -> String:
    reflection_model = codegen_reflection.collect_single_module_reflection_model(arena, root, source, module_name, project_name, imports, registry, class_model)
    return emit_module_header_with_semantics_and_models(arena, root, source, module_name, project_name, dependencies, imports, registry, semantic_nodes, specialization_args, call_specializations, user_specializations, type_table, class_model, reflection_model)


def emit_module_header_with_semantics_and_models(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
) -> String:
    header_name = codegen_names.generated_header_name(module_name)
    guard = codegen_names.header_guard(&header_name)
    builder = StringBuilder()
    builder.append("#ifndef ")
    builder.append(guard)
    builder.append("\n#define ")
    builder.append(guard)
    builder.append("\n\n")
    builder.append("#include <stdint.h>\n")
    builder.append("#include <stddef.h>\n")
    builder.append("#include <stdbool.h>\n")
    builder.append("#include <stdio.h>\n")
    builder.append("#include <stdlib.h>\n")
    builder.append("#include <string.h>\n")
    builder.append("#include <math.h>\n")
    builder.append("#include <time.h>\n")
    builder.append("#include \"cinder_runtime.h\"\n")
    if codegen_atomics.module_uses_atomics(semantic_nodes, type_table):
        codegen_atomics.emit_atomic_header_support(builder)
    emit_common_support(builder)
    for dependency in dependencies:
        if not project.is_builtin_module(&dependency):
            builder.append("#include \"")
            builder.append(codegen_names.generated_header_name(&dependency))
            builder.append("\"\n")
    builder.append("\n")
    prefix = codegen_names.c_prefix(project_name, module_name)
    context = codegen_context.make_module_codegen_context(arena, root, source, module_name, imports, registry, class_model, reflection_model, semantic_nodes, type_table, specialization_args, call_specializations, user_specializations)
    emitted_specializations: List[String] = []
    emitted_forwards: List[String] = []
    emit_module_nominal_forward_declarations(arena, root, source, builder, &prefix, context)
    codegen_specializations.emit_module_type_specialization_forwards(arena, root, source, builder, emitted_forwards, &prefix, project_name, imports, registry)
    emit_module_nominal_drop_prototypes(arena, root, source, builder, &prefix, context)
    emitted_drop_prototypes: List[String] = []
    codegen_specializations.emit_module_drop_helper_prototypes(arena, root, source, builder, emitted_drop_prototypes, &prefix, project_name, imports, registry)
    codegen_specializations.emit_module_type_specializations(arena, root, source, builder, emitted_specializations, &prefix, project_name, imports, registry, false)
    emit_module_nominal_declarations(arena, root, source, builder, &prefix, project_name, imports, context)
    emit_module_nominal_drop_definitions(arena, root, source, builder, &prefix, project_name, imports, context)
    emit_reflection_declarations(builder, module_name, context)
    codegen_specializations.emit_module_type_specializations(arena, root, source, builder, emitted_specializations, &prefix, project_name, imports, registry, true)
    emitted_array_drop_helpers: List[String] = []
    codegen_specializations.emit_module_array_drop_helpers(arena, root, source, builder, emitted_array_drop_helpers, &prefix, project_name, imports, registry)
    emitted_late_list_helpers: List[String] = []
    codegen_specializations.emit_module_late_list_helpers(arena, root, source, builder, emitted_late_list_helpers, &prefix, project_name, imports, registry)
    emitted_owned_helpers: List[String] = []
    codegen_specializations.emit_module_owned_helpers(arena, root, source, builder, emitted_owned_helpers, &prefix, project_name, imports, registry)
    emitted_print_prototypes: List[String] = []
    codegen_specializations.emit_module_collection_print_helpers(arena, root, source, builder, emitted_print_prototypes, &prefix, project_name, imports, registry, false)
    emitted_print_helpers: List[String] = []
    codegen_specializations.emit_module_collection_print_helpers(arena, root, source, builder, emitted_print_helpers, &prefix, project_name, imports, registry, true)
    emit_module_declarations(arena, root, source, builder, &prefix, project_name, imports, context, true)
    builder.append("\n#endif\n")
    return builder.finish()


def emit_reflection_declarations(
    builder: &StringBuilder,
    module_name: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    model: &const codegen_reflection.ProjectReflectionModel = context.reflection_model
    emitted = false
    for nominal in model.nominals:
        if nominal.is_reflected and nominal.module_name == module_name[0:len(module_name)]:
            builder.append("extern const CinderTypeInfo ")
            codegen_reflection.append_type_info_name(builder, &nominal)
            builder.append(";\n")
            emitted = true
    if emitted:
        builder.append("\n")


def emit_reflection_definitions(
    builder: &StringBuilder,
    module_name: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    model: &const codegen_reflection.ProjectReflectionModel = context.reflection_model
    class_model: &const classes.ProjectClassModel = context.class_model
    nominal_index: usize = 0
    while nominal_index < len(model.nominals):
        nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[nominal_index]
        if nominal.is_reflected and nominal.module_name == module_name[0:len(module_name)]:
            field_count = codegen_reflection.effective_field_count(model, class_model, cast[i32](nominal_index))
            method_count = codegen_reflection.effective_method_count(model, class_model, cast[i32](nominal_index))
            if field_count > 0:
                builder.append("static const CinderFieldInfo ")
                codegen_reflection.append_field_info_name(builder, nominal)
                builder.append("[] = {\n")
                for field_offset in range(0, field_count):
                    field_index = codegen_reflection.effective_field_at(model, class_model, cast[i32](nominal_index), field_offset)
                    if field_index < 0:
                        continue
                    field: &const codegen_reflection.ReflectionFieldInfo = &model.fields[cast[usize](field_index)]
                    builder.append("    { .name = \"")
                    builder.append(field.name[0:len(field.name)])
                    builder.append("\", .type_name = \"")
                    builder.append(field.type_name[0:len(field.type_name)])
                    builder.append("\", .offset = ")
                    append_reflection_field_offset(builder, model, class_model, cast[i32](nominal_index), field.owner, &field.name)
                    builder.append(", .size = sizeof(")
                    builder.append(field.c_type[0:len(field.c_type)])
                    builder.append("), .alignment = CINDER_ALIGNOF(")
                    builder.append(field.c_type[0:len(field.c_type)])
                    builder.append("), .is_private = ")
                    if field.is_private:
                        builder.append("true")
                    else:
                        builder.append("false")
                    builder.append(" },\n")
                builder.append("};\n\n")
            if method_count > 0:
                builder.append("static const CinderMethodInfo ")
                codegen_reflection.append_method_info_name(builder, nominal)
                builder.append("[] = {\n")
                for method_offset in range(0, method_count):
                    method_index = codegen_reflection.effective_method_at(model, class_model, cast[i32](nominal_index), method_offset)
                    if method_index < 0:
                        continue
                    method: &const codegen_reflection.ReflectionMethodInfo = &model.methods[cast[usize](method_index)]
                    builder.append("    { .name = \"")
                    builder.append(method.name[0:len(method.name)])
                    builder.append("\", .signature = \"")
                    builder.append(method.signature[0:len(method.signature)])
                    builder.append("\", .return_type_name = \"")
                    builder.append(method.return_type_name[0:len(method.return_type_name)])
                    builder.append("\", .parameter_count = ")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](method.parameter_count))
                    builder.append(", .is_abstract = ")
                    if method.is_abstract:
                        builder.append("true")
                    else:
                        builder.append("false")
                    builder.append(", .is_override = ")
                    if method.is_override:
                        builder.append("true")
                    else:
                        builder.append("false")
                    builder.append(" },\n")
                builder.append("};\n\n")
            builder.append("const CinderTypeInfo ")
            codegen_reflection.append_type_info_name(builder, nominal)
            builder.append(" = {\n    .name = \"")
            builder.append(nominal.name[0:len(nominal.name)])
            builder.append("\",\n    .kind = ")
            append_reflection_kind(builder, nominal.kind)
            builder.append(",\n    .size = sizeof(")
            builder.append(nominal.c_name[0:len(nominal.c_name)])
            builder.append("),\n    .alignment = CINDER_ALIGNOF(")
            builder.append(nominal.c_name[0:len(nominal.c_name)])
            builder.append("),\n    .fields = ")
            if field_count > 0:
                codegen_reflection.append_field_info_name(builder, nominal)
            else:
                builder.append("NULL")
            builder.append(",\n    .field_count = ")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](field_count))
            builder.append(",\n    .methods = ")
            if method_count > 0:
                codegen_reflection.append_method_info_name(builder, nominal)
            else:
                builder.append("NULL")
            builder.append(",\n    .method_count = ")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](method_count))
            builder.append("\n};\n\n")
        nominal_index += 1


def append_reflection_kind(builder: &StringBuilder, kind: codegen_reflection.ReflectionNominalKind) -> void:
    if kind == codegen_reflection.ReflectionNominalKind.CLASS:
        builder.append("CINDER_TYPE_CLASS")
    elif kind == codegen_reflection.ReflectionNominalKind.ENUM:
        builder.append("CINDER_TYPE_ENUM")
    elif kind == codegen_reflection.ReflectionNominalKind.UNION:
        builder.append("CINDER_TYPE_UNION")
    elif kind == codegen_reflection.ReflectionNominalKind.VARIANT:
        builder.append("CINDER_TYPE_VARIANT")
    else:
        builder.append("CINDER_TYPE_STRUCT")


def append_reflection_field_offset(
    builder: &StringBuilder,
    model: &const codegen_reflection.ProjectReflectionModel,
    class_model: &const classes.ProjectClassModel,
    root: i32,
    owner: i32,
    field_name: &const String,
) -> void:
    if root < 0 or root >= cast[i32](len(model.nominals)):
        builder.append("0")
        return
    nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[cast[usize](root)]
    if root == owner:
        builder.append("offsetof(")
        builder.append(nominal.c_name[0:len(nominal.c_name)])
        builder.append(", ")
        builder.append(field_name[0:len(field_name)])
        builder.append(")")
        return
    base = codegen_reflection.nominal_primary_base(model, class_model, root)
    if base < 0:
        builder.append("0")
        return
    builder.append("(offsetof(")
    builder.append(nominal.c_name[0:len(nominal.c_name)])
    builder.append(", _base) + ")
    append_reflection_field_offset(builder, model, class_model, base, owner, field_name)
    builder.append(")")


def emit_common_support(builder: &StringBuilder) -> void:
    builder.append("\n#ifndef CINDER_SELFHOST_COMMON_SUPPORT\n")
    builder.append("#define CINDER_SELFHOST_COMMON_SUPPORT\n")
    builder.append("typedef struct CinderList { void *data; size_t length; size_t capacity; } CinderList;\n")
    builder.append("#define cinder_selfhost_list_reserve(list, minimum, element_size) do { size_t cinder_minimum = (minimum); if ((list)->capacity < cinder_minimum) (list)->data = cinder_grow_array((list)->data, &(list)->capacity, cinder_minimum, (element_size)); } while (0)\n")
    builder.append("#define cinder_selfhost_list_append(list, item, element_size) do { size_t cinder_element_size = (element_size); cinder_selfhost_list_reserve((list), (list)->length + 1, cinder_element_size); memcpy((char *)(list)->data + (list)->length * cinder_element_size, (item), cinder_element_size); (list)->length += 1; } while (0)\n")
    builder.append("#define cinder_selfhost_list_pop(list) do { if ((list)->length > 0) (list)->length -= 1; } while (0)\n")
    builder.append("#define cinder_selfhost_list_clear(list) do { free((list)->data); (list)->data = NULL; (list)->length = 0; (list)->capacity = 0; } while (0)\n")
    builder.append("#define cinder_selfhost_list_slice(list_value, start_value, stop_value, element_size) ({ __auto_type cinder_slice_list = (list_value); size_t cinder_slice_start = (start_value); size_t cinder_slice_stop = (stop_value); if (cinder_slice_start > cinder_slice_list.length) cinder_slice_start = cinder_slice_list.length; if (cinder_slice_stop > cinder_slice_list.length) cinder_slice_stop = cinder_slice_list.length; if (cinder_slice_stop < cinder_slice_start) cinder_slice_stop = cinder_slice_start; (__typeof__(cinder_slice_list)){ .data = (__typeof__(cinder_slice_list.data))((char *)cinder_slice_list.data + cinder_slice_start * (element_size)), .length = cinder_slice_stop - cinder_slice_start, .capacity = 0 }; })\n")
    builder.append("#define cinder_selfhost_list_append_value(list, value) do { __auto_type cinder_value = (value); cinder_selfhost_list_append((list), &cinder_value, sizeof(cinder_value)); } while (0)\n")
    builder.append("#ifndef CINDER_SPECIALIZED_CinderOption_String\n")
    builder.append("#define CINDER_SPECIALIZED_CinderOption_String\n")
    builder.append("typedef enum CinderOption_String_Tag { CinderOption_String_Tag_None = 0, CinderOption_String_Tag_Some = 1 } CinderOption_String_Tag;\n")
    builder.append("typedef struct CinderOption_String { CinderOption_String_Tag tag; union { unsigned char _cinder_empty; CinderString value; } data; } CinderOption_String;\n")
    builder.append("static inline CinderOption_String CinderOption_String_clone(const CinderOption_String *self) { CinderOption_String result = {0}; if (self == NULL) return result; result.tag = self->tag; if (self->tag == CinderOption_String_Tag_Some) result.data.value = cinder_string_clone(&self->data.value); return result; }\n")
    builder.append("static inline void CinderOption_String_drop(CinderOption_String *self) { if (self == NULL) return; if (self->tag == CinderOption_String_Tag_Some) cinder_string_drop(&self->data.value); self->tag = CinderOption_String_Tag_None; }\n")
    builder.append("#endif\n")
    builder.append("#ifndef CINDER_SPECIALIZED_CinderList_u8\n")
    builder.append("#define CINDER_SPECIALIZED_CinderList_u8\n")
    builder.append("typedef struct CinderList_u8 { uint8_t *data; size_t length; size_t capacity; } CinderList_u8;\n")
    builder.append("static inline CinderList_u8 CinderList_u8_clone(const CinderList_u8 *self) { CinderList_u8 result = {0}; if (self == NULL) return result; for (size_t index = 0; index < self->length; ++index) cinder_selfhost_list_append_value(&result, self->data[index]); return result; }\n")
    builder.append("static inline void CinderList_u8_drop(CinderList_u8 *self) { if (self == NULL) return; free(self->data); self->data = NULL; self->length = 0; self->capacity = 0; }\n")
    builder.append("#endif\n")
    builder.append("static inline CinderList_u8 cinder_selfhost_file_read_all(FILE *stream) { if (stream == NULL) cinder_panic(\"read_all on closed File\"); CinderList_u8 result = {0}; for (;;) { if (result.length == SIZE_MAX) { CinderList_u8_drop(&result); cinder_panic(\"File.read_all length overflow\"); } result.data = (uint8_t *)cinder_grow_array(result.data, &result.capacity, result.length + 1, sizeof(*result.data)); size_t available = result.capacity - result.length; size_t counted = fread(result.data + result.length, 1, available, stream); result.length += counted; if (counted < available) { if (ferror(stream)) { CinderList_u8_drop(&result); cinder_panic(\"File.read_all failed\"); } break; } } return result; }\n")
    builder.append("static inline void cinder_selfhost_string_builder_append_cstr(CinderStringBuilder *builder, const char *text) {\n")
    builder.append("    CinderString value = cinder_string_from_cstr(text);\n")
    builder.append("    cinder_string_builder_append(builder, &value);\n")
    builder.append("    cinder_string_drop(&value);\n")
    builder.append("}\n")
    builder.append("static inline CinderStringBuilder cinder_selfhost_string_builder_new(void) {\n")
    builder.append("    CinderStringBuilder builder;\n")
    builder.append("    cinder_string_builder_init(&builder);\n")
    builder.append("    return builder;\n")
    builder.append("}\n")
    builder.append("#define cinder_selfhost_string_builder_append_value(builder, value) do { __auto_type cinder_value = (value); cinder_string_builder_append((builder), &cinder_value); } while (0)\n")
    builder.append("static inline uint8_t cinder_selfhost_string_byte_at_value(CinderString value, size_t index) { return cinder_string_byte_at(&value, index); }\n")
    builder.append("static inline void cinder_selfhost_print_string_value(CinderString value, bool first) { printf(first ? \"%s\" : \" %s\", cinder_string_cstr(&value)); }\n")
    builder.append("static inline void cinder_selfhost_print_string_fragment(CinderString value) { printf(\"%s\", cinder_string_cstr(&value)); }\n")
    builder.append("static inline void cinder_selfhost_print_integer_value(long long value, bool first) { printf(first ? \"%lld\" : \" %lld\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_unsigned_value(unsigned long long value, bool first) { printf(first ? \"%llu\" : \" %llu\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_float_value(double value, bool first) { printf(first ? \"%g\" : \" %g\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_bool_value(bool value, bool first) { printf(first ? \"%s\" : \" %s\", value ? \"true\" : \"false\"); }\n")
    builder.append("static inline void cinder_selfhost_print_char_value(char value, bool first) { printf(first ? \"%c\" : \" %c\", (int)value); }\n")
    builder.append("static inline void cinder_selfhost_print_i32_list(const void *data, size_t length, bool first) { if (!first) printf(\" \"); printf(\"[\"); const int32_t *items = (const int32_t *)data; for (size_t index = 0; index < length; ++index) { if (index > 0) printf(\", \"); printf(\"%lld\", (long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_i64_list(const void *data, size_t length, bool first) { if (!first) printf(\" \"); printf(\"[\"); const int64_t *items = (const int64_t *)data; for (size_t index = 0; index < length; ++index) { if (index > 0) printf(\", \"); printf(\"%lld\", (long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_u64_list(const void *data, size_t length, bool first) { if (!first) printf(\" \"); printf(\"[\"); const uint64_t *items = (const uint64_t *)data; for (size_t index = 0; index < length; ++index) { if (index > 0) printf(\", \"); printf(\"%llu\", (unsigned long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_f64_list(const void *data, size_t length, bool first) { if (!first) printf(\" \"); printf(\"[\"); const double *items = (const double *)data; for (size_t index = 0; index < length; ++index) { if (index > 0) printf(\", \"); printf(\"%g\", items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_string_list(const void *data, size_t length, bool first) { if (!first) printf(\" \"); printf(\"[\"); const CinderString *items = (const CinderString *)data; for (size_t index = 0; index < length; ++index) { if (index > 0) printf(\", \"); cinder_print_repr_string(cinder_string_cstr(&items[index])); } printf(\"]\"); }\n")
    builder.append("static inline int cinder_selfhost_compare_i32(const void *left, const void *right) { const int32_t a = *(const int32_t *)left; const int32_t b = *(const int32_t *)right; return (a > b) - (a < b); }\n")
    builder.append("static inline int cinder_selfhost_compare_string(const void *left, const void *right) { return cinder_string_compare_value((const CinderString *)left, (const CinderString *)right); }\n")
    builder.append("static inline void cinder_selfhost_sort_i32(void *data, size_t length) { cinder_sort(data, length, sizeof(int32_t), cinder_selfhost_compare_i32); }\n")
    builder.append("static inline void cinder_selfhost_sort_string(void *data, size_t length) { cinder_sort(data, length, sizeof(CinderString), cinder_selfhost_compare_string); }\n")
    builder.append("static inline CinderString cinder_selfhost_input_string(CinderString prompt) { return cinder_input(cinder_string_cstr(&prompt)); }\n")
    emit_parse_support(builder, "bool", "bool")
    emit_parse_support(builder, "i32", "int32_t")
    emit_parse_support(builder, "i64", "int64_t")
    emit_parse_support(builder, "u32", "uint32_t")
    emit_parse_support(builder, "u64", "uint64_t")
    emit_parse_support(builder, "isize", "ptrdiff_t")
    emit_parse_support(builder, "usize", "size_t")
    emit_parse_support(builder, "f32", "float")
    emit_parse_support(builder, "f64", "double")
    builder.append("static inline CinderString cinder_selfhost_string_concat(CinderString left, CinderString right) {\n")
    builder.append("    CinderStringBuilder builder;\n")
    builder.append("    cinder_string_builder_init(&builder);\n")
    builder.append("    cinder_string_builder_append(&builder, &left);\n")
    builder.append("    cinder_string_builder_append(&builder, &right);\n")
    builder.append("    return cinder_string_builder_finish(&builder);\n")
    builder.append("}\n")
    builder.append("#define cinder_selfhost_string_equal(left, right) ({ __auto_type cinder_left = (left); __auto_type cinder_right = (right); cinder_string_equal_value(&cinder_left, &cinder_right); })\n")
    builder.append("#define cinder_selfhost_string_compare(left, right) ({ __auto_type cinder_left = (left); __auto_type cinder_right = (right); cinder_string_compare_value(&cinder_left, &cinder_right); })\n")
    builder.append("static inline CinderProcessResult cinder_selfhost_process_run_list(const void *data, size_t length) {\n")
    builder.append("    const CinderString *items = (const CinderString *)data;\n")
    builder.append("    const char **argv = (const char **)cinder_alloc(length, sizeof(char *));\n")
    builder.append("    for (size_t index = 0; index < length; ++index) argv[index] = cinder_string_cstr(&items[index]);\n")
    builder.append("    return cinder_process_run_argv(length, argv);\n")
    builder.append("}\n")
    builder.append("#endif\n\n")

def emit_parse_support(builder: &StringBuilder, name: String, c_type: String) -> void:
    builder.append("#ifndef CINDER_SPECIALIZED_CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError\n#define CINDER_SPECIALIZED_CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError\n")
    builder.append("typedef enum CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag { CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag_Ok = 0, CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag_Err = 1 } CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag;\n")
    builder.append("typedef struct CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError { CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag tag; union { unsigned char _cinder_empty; ")
    builder.append(c_type[0:len(c_type)])
    builder.append(" ok; CinderParseError err; } data; } CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError;\n#endif\n")
    builder.append("static inline CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError cinder_selfhost_parse_")
    builder.append(name[0:len(name)])
    builder.append("(CinderString text) { ")
    builder.append(c_type[0:len(c_type)])
    builder.append(" out = { 0 }; CinderParseError err = CinderParseError_invalid; CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError result = { CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag_Err, { 0 } }; if (cinder_parse_")
    builder.append(name[0:len(name)])
    builder.append("(cinder_string_cstr(&text), &out, &err)) { result.tag = CinderResult_")
    builder.append(name[0:len(name)])
    builder.append("_n_CinderParseError_Tag_Ok; result.data.ok = out; } else { result.data.err = err; } return result; }\n")


def emit_module_header_from_ir(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    type_table: &const types.TypeTable,
) -> String:
    if not module.is_valid:
        return ""
    if module.root.index < 0:
        return emit_module_header_with_semantics(arena, syntax.missing_node(), source, module_name, project_name, dependencies, imports, registry, module.nodes, module.specialization_args, module.call_specializations, module.user_specializations, type_table)
    root = module.nodes[module.root.index].syntax
    return emit_module_header_with_semantics(arena, root, source, module_name, project_name, dependencies, imports, registry, module.nodes, module.specialization_args, module.call_specializations, module.user_specializations, type_table)


def emit_module_header_from_ir_with_classes(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    type_table: &const types.TypeTable,
    class_model: &const classes.ProjectClassModel,
) -> String:
    if not module.is_valid:
        return ""
    root = syntax.missing_node()
    if module.root.index >= 0:
        root = module.nodes[module.root.index].syntax
    return emit_module_header_with_semantics_and_classes(
        arena,
        root,
        source,
        module_name,
        project_name,
        dependencies,
        imports,
        registry,
        module.nodes,
        module.specialization_args,
        module.call_specializations,
        module.user_specializations,
        type_table,
        class_model,
    )


