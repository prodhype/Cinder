def emit_module_source(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> String:
    registry = codegen_names.new_specialization_name_registry()
    prefix = codegen_names.c_prefix(project_name, module_name)
    codegen_specializations.collect_module_specialization_names(&registry, arena, root, source, &prefix, project_name, imports)
    return emit_module_source_with_names(arena, root, source, module_name, project_name, imports, is_entry, registry)

def emit_module_source_with_names(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> String:
    semantic_nodes: List[backend_ir.IRNode] = []
    specialization_types: List[types.TypeId] = []
    specialization_args: List[types.TypeId] = []
    call_specializations: List[semantic.SpecializationBinding] = []
    user_specializations: List[semantic.UserSpecialization] = []
    type_table = types.new_type_table()
    return emit_module_source_with_semantics(arena, root, source, module_name, project_name, imports, is_entry, registry, semantic_nodes, specialization_types, specialization_args, call_specializations, user_specializations, type_table)

def emit_module_source_with_semantics(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_types: &const List[types.TypeId],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
) -> String:
    class_model = classes.collect_single_module_class_model(
        arena,
        root,
        source,
        module_name,
        project_name,
        imports,
        registry,
    )
    return emit_module_source_with_semantics_and_classes(
        arena,
        root,
        source,
        module_name,
        project_name,
        imports,
        is_entry,
        registry,
        semantic_nodes,
        specialization_types,
        specialization_args,
        call_specializations,
        user_specializations,
        type_table,
        class_model,
    )


def emit_module_source_with_semantics_and_classes(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_types: &const List[types.TypeId],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
    class_model: &const classes.ProjectClassModel,
) -> String:
    reflection_model = codegen_reflection.collect_single_module_reflection_model(arena, root, source, module_name, project_name, imports, registry, class_model)
    return emit_module_source_with_semantics_and_models(arena, root, source, module_name, project_name, imports, is_entry, registry, semantic_nodes, specialization_types, specialization_args, call_specializations, user_specializations, type_table, class_model, reflection_model)


def emit_module_source_with_semantics_and_models(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    registry: &const codegen_names.SpecializationNameRegistry,
    semantic_nodes: &const List[backend_ir.IRNode],
    specialization_types: &const List[types.TypeId],
    specialization_args: &const List[types.TypeId],
    call_specializations: &const List[semantic.SpecializationBinding],
    user_specializations: &const List[semantic.UserSpecialization],
    type_table: &const types.TypeTable,
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
) -> String:
    header_name = codegen_names.generated_header_name(module_name)
    builder = StringBuilder()
    builder.append("#include \"")
    builder.append(header_name)
    builder.append("\"\n\n")
    prefix = codegen_names.c_prefix(project_name, module_name)
    codegen_specializations.emit_semantic_type_specializations(type_table, specialization_types, semantic_nodes, arena, source, builder, &prefix, project_name, imports, registry)
    context = codegen_context.make_module_codegen_context(arena, root, source, module_name, imports, registry, class_model, reflection_model, semantic_nodes, type_table, specialization_args, call_specializations, user_specializations)
    emit_reflection_definitions(builder, module_name, context)
    emit_module_top_level(arena, root, source, builder, &prefix, project_name, imports, is_entry, context)
    return builder.finish()

