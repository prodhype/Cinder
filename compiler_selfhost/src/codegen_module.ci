def emit_module_nominal_forward_declarations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_nominal_forward_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, context)
        return
    if generics.has_type_params(arena, id):
        previous = context.active_user_specialization
        index: usize = 0
        while index < codegen_context.user_specialization_count(context):
            if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                context.active_user_specialization = cast[i32](index)
                emit_module_nominal_forward(arena, id, source, builder, prefix, context)
            index += 1
        context.active_user_specialization = previous
        return
    emit_module_nominal_forward(arena, id, source, builder, prefix, context)


def emit_module_nominal_forward(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.STRUCT_DECL or node.kind == SyntaxKind.CLASS_DECL or node.kind == SyntaxKind.VARIANT_DECL:
        builder.append("typedef struct ")
        emit_active_declaration_name(builder, prefix, source, &node, context)
        builder.append(" ")
        emit_active_declaration_name(builder, prefix, source, &node, context)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.UNION_DECL:
        builder.append("typedef union ")
        emit_active_declaration_name(builder, prefix, source, &node, context)
        builder.append(" ")
        emit_active_declaration_name(builder, prefix, source, &node, context)
        builder.append(";\n")


def emit_module_nominal_drop_prototypes(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_nominal_drop_prototypes(arena, arena.children[node.first_child + offset], source, builder, prefix, context)
        return
    if generics.has_type_params(arena, id):
        previous = context.active_user_specialization
        index: usize = 0
        while index < codegen_context.user_specialization_count(context):
            if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                context.active_user_specialization = cast[i32](index)
                emit_module_nominal_drop_prototype(arena, id, source, builder, prefix, context)
            index += 1
        context.active_user_specialization = previous
        return
    emit_module_nominal_drop_prototype(arena, id, source, builder, prefix, context)


def emit_module_nominal_drop_prototype(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.STRUCT_DECL and node.kind != SyntaxKind.CLASS_DECL:
        return
    builder.append("static inline void ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append("__drop(")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" *self);\n")


def emit_module_nominal_declarations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_nominal_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context)
        return
    if generics.has_type_params(arena, id):
        previous = context.active_user_specialization
        index: usize = 0
        while index < codegen_context.user_specialization_count(context):
            if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                context.active_user_specialization = cast[i32](index)
                emit_module_nominal_declaration(arena, id, source, builder, prefix, project_name, imports, context)
            index += 1
        context.active_user_specialization = previous
        return
    emit_module_nominal_declaration(arena, id, source, builder, prefix, project_name, imports, context)


def emit_module_nominal_declaration(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.STRUCT_DECL or node.kind == SyntaxKind.CLASS_DECL:
        emit_module_struct(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        emit_module_enum(arena, id, source, builder, prefix, context)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        emit_module_union(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.VARIANT_DECL:
        emit_module_variant(arena, id, source, builder, prefix, project_name, imports, context)


def emit_module_nominal_drop_definitions(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_nominal_drop_definitions(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context)
        return
    if generics.has_type_params(arena, id):
        previous = context.active_user_specialization
        index: usize = 0
        while index < codegen_context.user_specialization_count(context):
            if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                context.active_user_specialization = cast[i32](index)
                emit_module_nominal_drop_definition(arena, id, source, builder, prefix, project_name, imports, context)
            index += 1
        context.active_user_specialization = previous
        return
    emit_module_nominal_drop_definition(arena, id, source, builder, prefix, project_name, imports, context)


def emit_module_nominal_drop_definition(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.STRUCT_DECL and node.kind != SyntaxKind.CLASS_DECL:
        return
    model: &const classes.ProjectClassModel = context.class_model
    builder.append("static inline void ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append("__drop(")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" *self) {\n    if (self == NULL) return;\n")
    class_index = -1
    if node.kind == SyntaxKind.CLASS_DECL:
        owner_name = source[node.value_start:node.value_start + node.value_length]
        class_index = classes.find_class(model, &context.module_name, &owner_name)
        destructor_name = "__del__"
        destructor = classes.find_own_method(model, class_index, &destructor_name)
        if destructor >= 0:
            method: &const classes.ClassMethodInfo = &model.methods[cast[usize](destructor)]
            builder.append("    ")
            builder.append(method.c_name[0:len(method.c_name)])
            builder.append("(self);\n")
    field_offset = node.child_count
    while field_offset > 0:
        field_offset -= 1
        field_id = arena.children[node.first_child + field_offset]
        field = arena.nodes[field_id.index]
        if field.kind == SyntaxKind.FIELD_DECL:
            expression_builder = StringBuilder()
            expression_builder.append("self->")
            codegen_names.append_source(&expression_builder, source, field.value_start, field.value_length)
            field_type = codegen_type_names.find_child_type(arena, field_id)
            expression = expression_builder.finish()
            codegen_context.emit_context_drop(arena, context, field_type, source, builder, &expression, prefix, project_name, imports)
    if class_index >= 0:
        class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
        if class_info.primary_base >= 0:
            base: &const classes.ClassInfo = &model.classes[cast[usize](class_info.primary_base)]
            builder.append("    ")
            builder.append(base.c_name[0:len(base.c_name)])
            builder.append("__drop(&self->_base);\n")
    builder.append("}\n")


def emit_module_declarations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
    is_entry: bool,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context, is_entry)
        return
    if node.kind == SyntaxKind.EXTERN_IMPORT_DECL:
        builder.append("#include <")
        codegen_names.append_unquoted_string(builder, source, node.value_start, node.value_length)
        builder.append(">\n")
        return
    if node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            emit_module_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context, is_entry)
        return
    if node.kind == SyntaxKind.STRUCT_DECL or node.kind == SyntaxKind.ENUM_DECL or node.kind == SyntaxKind.UNION_DECL or node.kind == SyntaxKind.VARIANT_DECL:
        return
    if node.kind == SyntaxKind.STATIC_ASSERT_DECL:
        builder.append("CINDER_STATIC_ASSERT(")
        assertion = codegen_names.first_child(arena, id)
        codegen_expr.emit_module_expression(arena, assertion, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        message = codegen_names.second_child(arena, id)
        if message.index >= 0:
            message_node = arena.nodes[message.index]
            codegen_names.append_source(builder, source, message_node.value_start, message_node.value_length)
        else:
            builder.append("\"static assertion failed\"")
        builder.append(");\n")
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        if generics.has_type_params(arena, id):
            previous = context.active_user_specialization
            index: usize = 0
            while index < codegen_context.user_specialization_count(context):
                if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                    context.active_user_specialization = cast[i32](index)
                    emit_module_function_declaration(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
                index += 1
            context.active_user_specialization = previous
        else:
            emit_module_function_declaration(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
        return
    if node.kind == SyntaxKind.GLOBAL_DECL:
        builder.append("extern ")
        if node.flags == 1:
            builder.append("const ")
        annotation = codegen_type_names.find_child_type(arena, id)
        atomic_index = codegen_atomics.atomic_node_index(context.semantic_nodes, id)
        if atomic_index >= 0:
            atomic_node = codegen_atomics.atomic_node_at(context.semantic_nodes, atomic_index)
            codegen_atomics.append_atomic_wrapper_name(builder, atomic_node.atomic_element_kind)
            builder.append(" ")
            codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        elif annotation.index >= 0:
            if codegen_specializations.context_type_is_array(arena, annotation):
                codegen_specializations.emit_module_prefixed_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length, context.specialization_names)
            else:
                codegen_context.emit_context_c_type(arena, annotation, source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        builder.append(";\n")


def emit_module_function_declaration(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    emit_module_return_type(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
    builder.append(" ")
    if node.flags == 1:
        builder.append("(")
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        builder.append(")")
    else:
        emit_module_function_name(arena, id, source, builder, prefix, is_entry, context)
    builder.append("(")
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports, context)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")
    builder.append(");\n")

def emit_module_top_level(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_top_level(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, is_entry, context)
        return
    if node.kind == SyntaxKind.EXTERN_IMPORT_DECL or node.kind == SyntaxKind.EXTERN_BLOCK:
        return
    if generics.has_type_params(arena, id) and context.active_user_specialization < 0:
        index: usize = 0
        while index < codegen_context.user_specialization_count(context):
            if codegen_context.user_specialization_declaration_index(context, index) == id.index:
                context.active_user_specialization = cast[i32](index)
                emit_module_top_level(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
            index += 1
        context.active_user_specialization = -1
        return
    if node.kind == SyntaxKind.STRUCT_DECL:
        emit_module_methods(arena, id, source, builder, prefix, project_name, imports, false, context)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        return
    if node.kind == SyntaxKind.CLASS_DECL:
        emit_module_methods(arena, id, source, builder, prefix, project_name, imports, false, context)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        emit_module_function(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
        return
    if node.kind == SyntaxKind.GLOBAL_DECL:
        if node.flags == 1:
            builder.append("const ")
        annotation = codegen_type_names.find_child_type(arena, id)
        atomic_index = codegen_atomics.atomic_node_index(context.semantic_nodes, id)
        if atomic_index >= 0:
            atomic_node = codegen_atomics.atomic_node_at(context.semantic_nodes, atomic_index)
            codegen_atomics.append_atomic_wrapper_name(builder, atomic_node.atomic_element_kind)
            builder.append(" ")
            codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        elif annotation.index >= 0:
            if codegen_specializations.context_type_is_array(arena, annotation):
                codegen_specializations.emit_module_prefixed_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length, context.specialization_names)
            else:
                codegen_type_names.emit_module_c_type(arena, annotation, source, builder, prefix, project_name, imports, context.specialization_names)
                builder.append(" ")
                codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        initializer = codegen_names.last_child(arena, id)
        if atomic_index >= 0:
            atomic_node = codegen_atomics.atomic_node_at(context.semantic_nodes, atomic_index)
            builder.append(" = { .value = ATOMIC_VAR_INIT(")
            codegen_expr.emit_module_expression(arena, atomic_node.atomic_operand0, source, builder, prefix, project_name, imports, context)
            builder.append(") }")
        elif initializer.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[initializer.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and codegen_specializations.context_type_is_array(arena, annotation):
                codegen_expr.emit_module_array_initializer(arena, initializer, annotation, source, builder, prefix, project_name, imports, context)
            else:
                previous_expected = context.expected_type
                if annotation.index >= 0:
                    context.expected_type = annotation
                codegen_expr.emit_module_expression(arena, initializer, source, builder, prefix, project_name, imports, context)
                context.expected_type = previous_expected
        builder.append(";\n\n")
        return

def emit_module_function(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    emit_module_return_type(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
    builder.append(" ")
    emit_module_function_name(arena, id, source, builder, prefix, is_entry, context)
    builder.append("(")
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports, context)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")
    builder.append(") {\n")
    body = codegen_names.find_child_kind(arena, id, SyntaxKind.BLOCK)
    if body.index >= 0:
        context.current_owner = ""
        context.current_return_type = codegen_type_names.find_child_type(arena, id)
        context.expected_type = syntax.missing_node()
        context.local_start = len(context.local_types)
        context.pointer_start = len(context.pointer_names)
        codegen_context.register_module_parameters(arena, id, source, context)
        codegen_atomics.emit_function_temporaries(arena, id, context.semantic_nodes, builder)
        codegen_stmt.emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
        codegen_context.emit_context_live_drops(arena, context, source, builder, context.local_start, prefix, project_name, imports)
        while len(context.local_types) > context.local_start:
            context.local_types.pop()
        while len(context.pointer_names) > context.pointer_start:
            context.pointer_names.pop()
    builder.append("}\n\n")

def emit_module_function_name(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder, prefix: &const String, is_entry: bool, context: &codegen_context.ModuleCodegenContext) -> void:
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    if is_entry and name == "main":
        builder.append("main")
        return
    builder.append(prefix[0:len(prefix)])
    builder.append(name)
    if context.active_user_specialization >= 0:
        codegen_context.append_active_user_specialization_suffix(context, builder)


def emit_active_declaration_name(
    builder: &StringBuilder,
    prefix: &const String,
    source: &const String,
    node: &const syntax.SyntaxNode,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    codegen_names.emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    if context.active_user_specialization >= 0:
        codegen_context.append_active_user_specialization_suffix(context, builder)


def emit_module_return_type(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    if is_entry and name == "main":
        builder.append("int")
        return
    return_type = codegen_type_names.find_child_type(arena, id)
    if return_type.index < 0:
        builder.append("void")
        return
    codegen_context.emit_context_c_type(arena, return_type, source, builder, prefix, project_name, imports, context)

def emit_module_method_parameters(
    arena: &const SyntaxArena,
    owner_id: NodeId,
    function_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    owner = arena.nodes[owner_id.index]
    node = arena.nodes[function_id.index]
    emitted_parameter = false
    method_name = source[node.value_start:node.value_start + node.value_length]
    lifecycle_method = classes.text_equals(&method_name, "__init__") or classes.text_equals(&method_name, "__del__")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            parameter_type = codegen_type_names.find_child_type(arena, child_id)
            if not emitted_parameter and parameter_type.index < 0 and codegen_names.range_text_equals(source, child.value_start, child.value_length, "self"):
                if owner.flags == 1 and not lifecycle_method:
                    builder.append("CinderDyn_")
                    emit_active_declaration_name(builder, prefix, source, &owner, context)
                    builder.append(" ")
                else:
                    emit_active_declaration_name(builder, prefix, source, &owner, context)
                    builder.append(" *")
                codegen_names.append_source(builder, source, child.value_start, child.value_length)
            else:
                emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports, context)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")

def emit_module_parameter(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    parameter_type = codegen_type_names.find_child_type(arena, id)
    if parameter_type.index >= 0 and arena.nodes[parameter_type.index].kind == SyntaxKind.TYPE_FUNCTION:
        emit_module_function_pointer_parameter(arena, parameter_type, source, builder, prefix, project_name, imports, node.value_start, node.value_length, context.specialization_names)
        return
    codegen_context.emit_context_c_type(arena, parameter_type, source, builder, prefix, project_name, imports, context)
    builder.append(" ")
    codegen_names.append_source(builder, source, node.value_start, node.value_length)

def emit_module_function_pointer_parameter(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[type_id.index]
    if node.child_count <= 0:
        builder.append("void (*")
        codegen_names.append_source(builder, source, name_start, name_length)
        builder.append(")(void)")
        return
    return_type = arena.children[node.first_child + node.child_count - 1]
    codegen_type_names.emit_module_c_type(arena, return_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" (*")
    codegen_names.append_source(builder, source, name_start, name_length)
    builder.append(")(")
    if node.child_count == 1:
        builder.append("void")
    else:
        for offset in range(0, node.child_count - 1):
            if offset > 0:
                builder.append(", ")
            codegen_type_names.emit_module_c_type(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, registry)
    builder.append(")")


def emit_module_struct(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    node = arena.nodes[id.index]
    builder.append("struct ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" {\n")
    owner_name = source[node.value_start:node.value_start + node.value_length]
    class_index = classes.find_class(context.class_model, &context.module_name, &owner_name)
    has_layout = false
    if node.kind == SyntaxKind.CLASS_DECL and class_index >= 0:
        class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
        if class_info.primary_base >= 0:
            base_info: &const classes.ClassInfo = &model.classes[cast[usize](class_info.primary_base)]
            builder.append("    ")
            builder.append(base_info.c_name[0:len(base_info.c_name)])
            builder.append(" _base;\n")
            has_layout = true
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            has_layout = true
            builder.append("    ")
            field_type = codegen_type_names.find_child_type(arena, child_id)
            if codegen_specializations.context_type_is_array(arena, field_type):
                codegen_specializations.emit_module_typed_declarator(arena, field_type, source, builder, prefix, project_name, imports, child.value_start, child.value_length, context.specialization_names)
            else:
                codegen_context.emit_context_c_type(arena, field_type, source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    if not has_layout:
        builder.append("    unsigned char _cinder_empty;\n")
    builder.append("};\n\n")
    if node.kind == SyntaxKind.CLASS_DECL and node.flags == 1:
        emit_module_abstract_class_abi(arena, id, source, builder, prefix, project_name, imports, context)
    emit_module_methods(arena, id, source, builder, prefix, project_name, imports, true, context)


def emit_module_abstract_class_abi(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    owner = arena.nodes[id.index]
    name_builder = StringBuilder()
    emit_active_declaration_name(&name_builder, prefix, source, &owner, context)
    owner_name = name_builder.finish()
    builder.append("typedef struct CinderVTable_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(" CinderVTable_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(";\n")
    builder.append("typedef struct CinderDyn_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(" { void *object; const CinderVTable_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(" *vtable; } CinderDyn_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(";\n")
    builder.append("struct CinderVTable_")
    builder.append(owner_name[0:len(owner_name)])
    builder.append(" {\n")
    builder.append("    const CinderTypeInfo *type_info;\n")
    for offset in range(0, owner.child_count):
        method_id = arena.children[owner.first_child + offset]
        method = arena.nodes[method_id.index]
        if method.kind != SyntaxKind.FUNCTION_DECL:
            continue
        method_name = source[method.value_start:method.value_start + method.value_length]
        if method_name == "__init__" or method_name == "__del__":
            continue
        builder.append("    ")
        emit_module_return_type(arena, method_id, source, builder, prefix, project_name, imports, false, context)
        builder.append(" (*")
        codegen_names.append_source(builder, source, method.value_start, method.value_length)
        builder.append(")(void *object")
        builder.append(", const CinderVTable_")
        builder.append(owner_name[0:len(owner_name)])
        builder.append(" *vtable")
        parameter_index: i32 = 0
        for parameter_offset in range(0, method.child_count):
            parameter_id = arena.children[method.first_child + parameter_offset]
            if arena.nodes[parameter_id.index].kind != SyntaxKind.PARAMETER:
                continue
            if parameter_index > 0:
                builder.append(", ")
                emit_module_parameter(arena, parameter_id, source, builder, prefix, project_name, imports, context)
            parameter_index += 1
        builder.append(");\n")
    builder.append("};\n\n")


def emit_module_union(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    builder.append("union ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    ")
            field_type = codegen_type_names.find_child_type(arena, child_id)
            if codegen_specializations.context_type_is_array(arena, field_type):
                codegen_specializations.emit_module_typed_declarator(arena, field_type, source, builder, prefix, project_name, imports, child.value_start, child.value_length, context.specialization_names)
            else:
                codegen_context.emit_context_c_type(arena, field_type, source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("};\n\n")

def emit_module_enum(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder, prefix: &const String, context: &codegen_context.ModuleCodegenContext) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef enum ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" {\n")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.ENUM_MEMBER_DECL:
            if emitted:
                builder.append(",\n")
            builder.append("    ")
            emit_active_declaration_name(builder, prefix, source, &node, context)
            builder.append("_")
            codegen_names.append_source(builder, source, child.value_start, child.value_length)
            emitted = true
    if emitted:
        builder.append("\n")
    builder.append("} ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(";\n\n")

def emit_module_variant(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef enum ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append("_Tag {\n")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.VARIANT_CASE_DECL:
            if emitted:
                builder.append(",\n")
            builder.append("    ")
            emit_active_declaration_name(builder, prefix, source, &node, context)
            builder.append("_")
            codegen_names.append_source(builder, source, child.value_start, child.value_length)
            emitted = true
    if emitted:
        builder.append("\n")
    builder.append("} ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append("_Tag;\n")
    builder.append("struct ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append(" {\n    ")
    emit_active_declaration_name(builder, prefix, source, &node, context)
    builder.append("_Tag tag;\n    union {\n        unsigned char _cinder_empty;\n")
    for offset in range(0, node.child_count):
        case_id = arena.children[node.first_child + offset]
        case_node = arena.nodes[case_id.index]
        if case_node.kind != SyntaxKind.VARIANT_CASE_DECL:
            continue
        has_fields = false
        for field_offset in range(0, case_node.child_count):
            field_id = arena.children[case_node.first_child + field_offset]
            if arena.nodes[field_id.index].kind == SyntaxKind.FIELD_DECL:
                has_fields = true
        if not has_fields:
            continue
        builder.append("        struct {\n")
        for field_offset in range(0, case_node.child_count):
            field_id = arena.children[case_node.first_child + field_offset]
            field = arena.nodes[field_id.index]
            if field.kind == SyntaxKind.FIELD_DECL:
                builder.append("            ")
                codegen_context.emit_context_c_type(arena, codegen_type_names.find_child_type(arena, field_id), source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.append_source(builder, source, field.value_start, field.value_length)
                builder.append(";\n")
        builder.append("        } ")
        codegen_names.append_source(builder, source, case_node.value_start, case_node.value_length)
        builder.append(";\n")
    builder.append("    } data;\n};\n\n")

def emit_module_methods(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    declarations_only: bool,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    owner_start = node.value_start
    owner_length = node.value_length
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FUNCTION_DECL:
            if reflection.has_decorator(arena, child_id, source, "abstractmethod"):
                continue
            emit_module_return_type(arena, child_id, source, builder, prefix, project_name, imports, false, context)
            builder.append(" ")
            emit_active_declaration_name(builder, prefix, source, &node, context)
            builder.append("_")
            codegen_names.append_source(builder, source, child.value_start, child.value_length)
            builder.append("(")
            emit_module_method_parameters(arena, id, child_id, source, builder, prefix, project_name, imports, context)
            if declarations_only:
                builder.append(");\n")
                if node.kind == SyntaxKind.STRUCT_DECL and context.active_user_specialization < 0:
                    builder.append("#define ")
                    codegen_names.append_source(builder, source, child.value_start, child.value_length)
                    builder.append(" ")
                    emit_active_declaration_name(builder, prefix, source, &node, context)
                    builder.append("_")
                    codegen_names.append_source(builder, source, child.value_start, child.value_length)
                    builder.append("\n")
            else:
                builder.append(") {\n")
                body = codegen_names.find_child_kind(arena, child_id, SyntaxKind.BLOCK)
                if body.index >= 0:
                    context.current_owner = source[owner_start:owner_start + owner_length]
                    context.current_class = classes.find_class(context.class_model, &context.module_name, &context.current_owner)
                    context.current_self_is_dyn = (
                        node.flags == 1
                        and not codegen_names.range_text_equals(source, child.value_start, child.value_length, "__init__")
                        and not codegen_names.range_text_equals(source, child.value_start, child.value_length, "__del__")
                        and first_method_parameter_is_unannotated(arena, child_id, source)
                    )
                    context.current_return_type = codegen_type_names.find_child_type(arena, child_id)
                    context.local_start = len(context.local_types)
                    context.pointer_start = len(context.pointer_names)
                    codegen_context.register_module_parameters(arena, child_id, source, context)
                    codegen_atomics.emit_function_temporaries(arena, child_id, context.semantic_nodes, builder)
                    codegen_stmt.emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
                    codegen_context.emit_context_live_drops(arena, context, source, builder, context.local_start, prefix, project_name, imports)
                    while len(context.local_types) > context.local_start:
                        context.local_types.pop()
                    while len(context.pointer_names) > context.pointer_start:
                        context.pointer_names.pop()
                builder.append("}\n\n")
    if node.kind == SyntaxKind.CLASS_DECL:
        if declarations_only:
            emit_module_class_support_declarations(arena, id, source, builder, context)
        else:
            emit_module_class_support_definitions(arena, id, source, builder, context)


def first_method_parameter_is_unannotated(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> bool:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            return (
                codegen_type_names.find_child_type(arena, child_id).index < 0
                and codegen_names.range_text_equals(source, child.value_start, child.value_length, "self")
            )
    return false


def emit_module_class_support_declarations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    class_index = classes.find_class(context.class_model, &context.module_name, &name)
    if class_index < 0:
        return
    class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
    if class_info.is_abstract and generics.has_type_params(arena, id):
        return
    emit_class_new_signature(builder, class_info, model)
    builder.append(";\n")
    offset: i32 = 0
    while offset < class_info.base_count:
        base: &const classes.ClassBaseInfo = &model.bases[cast[usize](class_info.first_base + offset)]
        if base.target >= 0 and model.classes[cast[usize](base.target)].is_abstract:
            builder.append("extern const CinderVTable_")
            builder.append(base.c_name[0:len(base.c_name)])
            builder.append(" ")
            append_vtable_instance_name(builder, class_info, &base.c_name)
            builder.append(";\n")
        offset += 1
    builder.append("\n")


def emit_module_class_support_definitions(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_context.ModuleCodegenContext,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    class_index = classes.find_class(context.class_model, &context.module_name, &name)
    if class_index < 0:
        return
    class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
    if class_info.is_abstract and generics.has_type_params(arena, id):
        return
    emit_class_new_signature(builder, class_info, model)
    builder.append(" {\n    ")
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append(" cinder_instance = {0};\n")
    if class_info.constructor >= 0:
        constructor: &const classes.ClassMethodInfo = &model.methods[cast[usize](class_info.constructor)]
        builder.append("    ")
        builder.append(constructor.c_name[0:len(constructor.c_name)])
        builder.append("(&cinder_instance")
        parameter_offset: i32 = 0
        while parameter_offset < constructor.parameter_count:
            parameter: &const classes.ClassParameterInfo = &model.parameters[cast[usize](constructor.first_parameter + parameter_offset)]
            builder.append(", ")
            builder.append(parameter.name[0:len(parameter.name)])
            parameter_offset += 1
        builder.append(");\n")
    elif class_info.primary_base >= 0:
        base: &const classes.ClassInfo = &model.classes[cast[usize](class_info.primary_base)]
        builder.append("    cinder_instance._base = ")
        builder.append(base.c_name[0:len(base.c_name)])
        builder.append("__new();\n")
    builder.append("    return cinder_instance;\n}\n\n")
    offset: i32 = 0
    while offset < class_info.base_count:
        base: &const classes.ClassBaseInfo = &model.bases[cast[usize](class_info.first_base + offset)]
        if base.target >= 0 and model.classes[cast[usize](base.target)].is_abstract:
            emit_interface_implementation(builder, class_index, base.target, &base.c_name, model)
        offset += 1


def emit_class_new_signature(
    builder: &StringBuilder,
    class_info: &const classes.ClassInfo,
    model: &const classes.ProjectClassModel,
) -> void:
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append(" ")
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append("__new(")
    if class_info.constructor < 0:
        builder.append("void")
    else:
        constructor: &const classes.ClassMethodInfo = &model.methods[cast[usize](class_info.constructor)]
        if constructor.parameter_count == 0:
            builder.append("void")
        parameter_offset: i32 = 0
        while parameter_offset < constructor.parameter_count:
            if parameter_offset > 0:
                builder.append(", ")
            parameter: &const classes.ClassParameterInfo = &model.parameters[cast[usize](constructor.first_parameter + parameter_offset)]
            builder.append(parameter.type_info.c_type[0:len(parameter.type_info.c_type)])
            builder.append(" ")
            builder.append(parameter.name[0:len(parameter.name)])
            parameter_offset += 1
    builder.append(")")


def append_vtable_instance_name(
    builder: &StringBuilder,
    class_info: &const classes.ClassInfo,
    interface_c_name: &const String,
) -> void:
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append("__as__")
    builder.append(interface_c_name[0:len(interface_c_name)])
    builder.append("__vtable")


def emit_interface_implementation(
    builder: &StringBuilder,
    class_index: i32,
    interface_index: i32,
    interface_c_name: &const String,
    model: &const classes.ProjectClassModel,
) -> void:
    class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
    interface: &const classes.ClassInfo = &model.classes[cast[usize](interface_index)]
    method_offset: i32 = 0
    while method_offset < interface.method_count:
        interface_method_index = interface.first_method + method_offset
        interface_method: &const classes.ClassMethodInfo = &model.methods[cast[usize](interface_method_index)]
        if not classes.text_equals(&interface_method.name, "__init__") and not classes.text_equals(&interface_method.name, "__del__"):
            implementation_index = classes.find_effective_method(model, class_index, &interface_method.name)
            if implementation_index >= 0:
                implementation: &const classes.ClassMethodInfo = &model.methods[cast[usize](implementation_index)]
                builder.append("static ")
                builder.append(implementation.return_c_type[0:len(implementation.return_c_type)])
                builder.append(" ")
                append_vtable_thunk_name(builder, class_info, interface_c_name, &interface_method.name)
                builder.append("(void *object, const CinderVTable_")
                builder.append(interface_c_name[0:len(interface_c_name)])
                builder.append(" *vtable")
                parameter_offset: i32 = 0
                while parameter_offset < implementation.parameter_count:
                    parameter: &const classes.ClassParameterInfo = &model.parameters[cast[usize](implementation.first_parameter + parameter_offset)]
                    builder.append(", ")
                    builder.append(parameter.type_info.c_type[0:len(parameter.type_info.c_type)])
                    builder.append(" ")
                    builder.append(parameter.name[0:len(parameter.name)])
                    parameter_offset += 1
                builder.append(") {\n    ")
                if not implementation.self_is_dyn:
                    builder.append("(void)vtable;\n    ")
                if not classes.text_equals(&implementation.return_c_type, "void"):
                    builder.append("return ")
                builder.append(implementation.c_name[0:len(implementation.c_name)])
                builder.append("(")
                if implementation.self_is_dyn:
                    builder.append("(CinderDyn_")
                    builder.append(interface_c_name[0:len(interface_c_name)])
                    builder.append("){ .object = object, .vtable = vtable }")
                else:
                    append_class_pointer_from_object(builder, class_index, implementation.owner, model)
                parameter_offset = 0
                while parameter_offset < implementation.parameter_count:
                    parameter = &model.parameters[cast[usize](implementation.first_parameter + parameter_offset)]
                    builder.append(", ")
                    builder.append(parameter.name[0:len(parameter.name)])
                    parameter_offset += 1
                builder.append(");\n}\n\n")
        method_offset += 1
    builder.append("const CinderVTable_")
    builder.append(interface_c_name[0:len(interface_c_name)])
    builder.append(" ")
    append_vtable_instance_name(builder, class_info, interface_c_name)
    builder.append(" = {\n    .type_info = ")
    if class_info.is_reflected:
        builder.append("&")
        builder.append(class_info.c_name[0:len(class_info.c_name)])
        builder.append("__type_info")
    else:
        builder.append("NULL")
    method_offset = 0
    while method_offset < interface.method_count:
        interface_method = &model.methods[cast[usize](interface.first_method + method_offset)]
        if not classes.text_equals(&interface_method.name, "__init__") and not classes.text_equals(&interface_method.name, "__del__"):
            builder.append(",\n    .")
            builder.append(interface_method.name[0:len(interface_method.name)])
            builder.append(" = ")
            append_vtable_thunk_name(builder, class_info, interface_c_name, &interface_method.name)
        method_offset += 1
    builder.append("\n};\n\n")


def append_vtable_thunk_name(
    builder: &StringBuilder,
    class_info: &const classes.ClassInfo,
    interface_c_name: &const String,
    method_name: &const String,
) -> void:
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append("__as__")
    builder.append(interface_c_name[0:len(interface_c_name)])
    builder.append("__")
    builder.append(method_name[0:len(method_name)])
    builder.append("__thunk")


def append_class_pointer_from_object(
    builder: &StringBuilder,
    source_class: i32,
    target_class: i32,
    model: &const classes.ProjectClassModel,
) -> void:
    ignored_source = source_class
    target: &const classes.ClassInfo = &model.classes[cast[usize](target_class)]
    builder.append("((")
    builder.append(target.c_name[0:len(target.c_name)])
    builder.append(" *)object)")
