import backend_ir
import checker_core
import checker_imports
import checker_scopes
import checker_symbols
import cinder
import codegen
import diagnostics
import lexer
import parser
import project
import syntax
from syntax import NodeId


def new_checker() -> checker_core.Checker:
    return checker_core.new_checker()


def collect_symbols(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    root: NodeId,
    source: &const String,
    modules: &const List[project.ParsedModule],
) -> void:
    checker_symbols.collect_symbols(checker, arena, root, source, modules)


def validate_import_member_calls(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    checker_imports.validate_import_member_calls(checker, arena, root, source, imports, modules)


def validate_names(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String) -> void:
    checker_scopes.validate_names(checker, arena, root, source)


def check_and_dump(source: String) -> i32:
    scan = lexer.new_lexer(source)
    scan.tokenize()
    if len(scan.diagnostic_values) > 0:
        return scan.dump()

    parsed = parser.new_parser(scan)
    root = parsed.parse_module()
    if len(parsed.diagnostic_values) > 0:
        diagnostic_path = "<source>"
        diagnostics.write_diagnostics_stderr(&parsed.diagnostic_values, &diagnostic_path, &scan.source)
        return 1

    checker: checker_core.Checker = new_checker()
    modules: List[project.ParsedModule] = []
    collect_symbols(checker, parsed.arena, root, scan.source, &modules)
    validate_names(checker, parsed.arena, root, scan.source)
    if len(checker.diagnostic_values) > 0:
        diagnostic_path = "<source>"
        checker_core.dump_diagnostics(checker, &diagnostic_path, &scan.source)
        return 1

    ir: backend_ir.IRModule = backend_ir.lower(parsed.arena, root, checker.model, checker.type_table)
    if not ir.is_valid:
        diagnostic_message = "internal atomic IR validation failed\n"
        cinder.write_stderr(diagnostic_message)
        return 1
    summary = backend_ir.summarize_ir(ir)
    backend_ir.dump_summary(summary)
    c_source: String = codegen.emit_c_from_ir(ir, parsed.arena, scan.source)
    with open("bootstrap_selfhost_output.c", "wb") as output:
        output.write(c_source)
    print("C", len(c_source))
    print(c_source)
    return 0
