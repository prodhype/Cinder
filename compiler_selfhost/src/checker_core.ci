import semantic
import symbols
import syntax
import types
import generics
import lock_order
import ownership
import project
from syntax import NodeId


struct CheckerDiagnostic:
    code: i32
    start: usize
    length: usize
    line: i32
    column: i32


struct Checker:
    type_table: types.TypeTable
    symbols: symbols.SymbolTable
    model: semantic.SemanticModel
    diagnostics: List[CheckerDiagnostic]
    imported_enum_names: List[String]
    qualified_atomic_template_names: List[String]
    specialization_declaration: NodeId
    specialization_args: List[types.TypeId]
    lock_model: lock_order.ProjectLockModel
    module_name: String
    module_imports: List[project.ImportBinding]

    def emit_error(self: &Checker, code: i32, start: usize, length: usize, line: i32, column: i32) -> void:
        if len(self.diagnostics) > 0:
            return
        self.diagnostics.append(
            CheckerDiagnostic(code=code, start=start, length=length, line=line, column=column)
        )


def new_checker() -> Checker:
    diagnostics: List[CheckerDiagnostic] = []
    imported_enum_names: List[String] = []
    qualified_atomic_template_names: List[String] = []
    specialization_args: List[types.TypeId] = []
    module_imports: List[project.ImportBinding] = []
    return Checker(
        type_table=types.new_type_table(),
        symbols=symbols.new_symbol_table(),
        model=semantic.new_semantic_model(),
        diagnostics=diagnostics,
        imported_enum_names=imported_enum_names,
        qualified_atomic_template_names=qualified_atomic_template_names,
        specialization_declaration=syntax.missing_node(),
        specialization_args=specialization_args,
        lock_model=lock_order.new_project_lock_model(),
        module_name="",
        module_imports=module_imports,
    )


def emit_error(checker: &Checker, code: i32, start: usize, length: usize, line: i32, column: i32) -> void:
    checker.emit_error(code, start, length, line, column)


def dump_diagnostics(checker: &const Checker) -> void:
    for diagnostic in checker.diagnostics:
        print("E", diagnostic.code, diagnostic.start, diagnostic.length, diagnostic.line, diagnostic.column)


def prepare_lock_context(checker: &Checker, source: &const String, modules: &const List[project.ParsedModule]) -> void:
    lock_order.prepare_project_lock_model(&checker.lock_model, modules)
    module_index: usize = 0
    while module_index < len(modules):
        module: &const project.ParsedModule = &modules[module_index]
        if module.source == source[0:len(source)]:
            checker.module_name = module.name[0:len(module.name)]
            while len(checker.module_imports) > 0:
                checker.module_imports.pop()
            import_index: usize = 0
            module_imports: &const List[project.ImportBinding] = &module.imports
            while import_index < len(module_imports):
                imported: &const project.ImportBinding = &module_imports[import_index]
                checker.module_imports.append(
                    project.ImportBinding(
                        alias=imported.alias[0:len(imported.alias)],
                        module_name=imported.module_name[0:len(imported.module_name)],
                        member=imported.member[0:len(imported.member)],
                    )
                )
                import_index += 1
            diagnostic_index: usize = 0
            lock_diagnostics: &const List[lock_order.LockDiagnostic] = &checker.lock_model.diagnostics
            while diagnostic_index < len(lock_diagnostics):
                diagnostic: &const lock_order.LockDiagnostic = &lock_diagnostics[diagnostic_index]
                if diagnostic.module_name == module.name:
                    emit_error(
                        checker,
                        diagnostic.code,
                        diagnostic.start,
                        diagnostic.length,
                        diagnostic.line,
                        diagnostic.column,
                    )
                    lock_order.print_diagnostic(diagnostic)
                diagnostic_index += 1
            return
        module_index += 1


def count_direct_children(arena: &const syntax.SyntaxArena, id: NodeId, kind: syntax.SyntaxKind) -> i32:
    node = arena.nodes[id.index]
    count: i32 = 0
    for offset in range(0, node.child_count):
        child = arena.nodes[arena.children[node.first_child + offset].index]
        if child.kind == kind:
            count += 1
    return count


def first_child(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child]


def second_child(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 1:
        return syntax.missing_node()
    return arena.children[node.first_child + 1]


def last_child(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child + node.child_count - 1]


def find_child_kind(arena: &const syntax.SyntaxArena, id: NodeId, kind: syntax.SyntaxKind) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == kind:
            return child_id
    return syntax.missing_node()


def resolve_declared_type_or_default(checker: &Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, fallback: types.TypeId) -> types.TypeId:
    type_node = find_child_type(arena, id)
    if type_node.index < 0:
        return fallback
    type_id = resolve_type_node(checker, arena, type_node, source)
    checker.model.record_type_node(type_node, type_id)
    return type_id


def resolve_type_node(checker: &Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> types.TypeId:
    resolved = resolve_type_node_unsubstituted(checker, arena, id, source)
    if checker.specialization_declaration.index >= 0:
        return generics.substitute_type(checker.type_table, resolved, arena, checker.specialization_declaration, &checker.specialization_args, source)
    return resolved


def resolve_type_node_unsubstituted(checker: &Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> types.TypeId:
    if id.index < 0:
        return types.type_i32()
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.TYPE_NAME:
        found = checker.symbols.find_in_scope(source, symbols.root_scope(), node.value_start, node.value_length)
        if found.index >= 0:
            symbol = checker.symbols.symbols[found.index]
            if symbol.kind == symbols.SymbolKind.TYPE_PARAMETER or is_nominal_symbol_kind(symbol.kind):
                if is_nominal_symbol_kind(symbol.kind) and generics.has_type_params(arena, symbol.node):
                    emit_error(checker, 352, node.start, node.length, node.line, node.column)
                return symbol.type_id
            if symbol.type_id.index >= 0 and symbol.type_id.index < cast[i32](len(checker.type_table.types)) and checker.type_table.types[symbol.type_id.index].kind == types.TypeKind.ATOMIC:
                emit_error(checker, 351, node.start, node.length, node.line, node.column)
                return types.type_error()
        return checker.type_table.resolve_type_name(source, node.value_start, node.value_length)
    if node.kind == syntax.SyntaxKind.TYPE_POINTER:
        return checker.type_table.pointer_to(resolve_type_node(checker, arena, first_child(arena, id), source))
    if node.kind == syntax.SyntaxKind.TYPE_REFERENCE:
        return checker.type_table.reference_to(resolve_type_node(checker, arena, first_child(arena, id), source))
    if node.kind == syntax.SyntaxKind.TYPE_CONST:
        return checker.type_table.const_of(resolve_type_node(checker, arena, first_child(arena, id), source))
    if node.kind == syntax.SyntaxKind.TYPE_SLICE:
        return checker.type_table.slice_of(resolve_type_node(checker, arena, first_child(arena, id), source))
    if node.kind == syntax.SyntaxKind.TYPE_DYN:
        return checker.type_table.dyn_of(resolve_type_node(checker, arena, first_child(arena, id), source))
    if node.kind == syntax.SyntaxKind.TYPE_ARRAY:
        return checker.type_table.array_of(resolve_type_node(checker, arena, first_child(arena, id), source), types.array_length_from_node(arena, id, source))
    if node.kind == syntax.SyntaxKind.TYPE_GENERIC:
        return resolve_generic_type_node(checker, arena, id, source)
    if node.kind == syntax.SyntaxKind.TYPE_FUNCTION or node.kind == syntax.SyntaxKind.TYPE_CLOSURE:
        return resolve_callable_type_node(checker, arena, id, source, node.kind == syntax.SyntaxKind.TYPE_CLOSURE)
    return types.type_error()


def resolve_generic_type_node(checker: &Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> types.TypeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return types.type_error()
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    if is_runtime_generic_name(source, &base):
        first_arg = syntax.missing_node()
        second_arg = syntax.missing_node()
        if node.child_count > 1:
            first_arg = arena.children[node.first_child + 1]
        if node.child_count > 2:
            second_arg = arena.children[node.first_child + 2]
        if range_text_equals(source, base.value_start, base.value_length, "Option"):
            return checker.type_table.generic1(types.TypeKind.OPTION, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Owned"):
            return checker.type_table.generic1(types.TypeKind.OWNED, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "List"):
            return checker.type_table.generic1(types.TypeKind.LIST, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Set"):
            return checker.type_table.generic1(types.TypeKind.SET, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Map"):
            return checker.type_table.generic2(types.TypeKind.MAP, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source), resolve_type_node(checker, arena, second_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "MapKeys"):
            return checker.type_table.map_view(types.TypeKind.MAP_KEYS, checker.type_table.generic2(types.TypeKind.MAP, 0, 0, resolve_type_node(checker, arena, first_arg, source), resolve_type_node(checker, arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "MapValues"):
            return checker.type_table.map_view(types.TypeKind.MAP_VALUES, checker.type_table.generic2(types.TypeKind.MAP, 0, 0, resolve_type_node(checker, arena, first_arg, source), resolve_type_node(checker, arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "MapItems"):
            return checker.type_table.map_view(types.TypeKind.MAP_ITEMS, checker.type_table.generic2(types.TypeKind.MAP, 0, 0, resolve_type_node(checker, arena, first_arg, source), resolve_type_node(checker, arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "Result"):
            return checker.type_table.generic2(types.TypeKind.RESULT, base.value_start, base.value_length, resolve_type_node(checker, arena, first_arg, source), resolve_type_node(checker, arena, second_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Tuple"):
            tuple_args: List[types.TypeId] = []
            tuple_offset: i32 = 1
            while tuple_offset < node.child_count:
                tuple_args.append(resolve_type_node(checker, arena, arena.children[node.first_child + tuple_offset], source))
                tuple_offset += 1
            return checker.type_table.tuple_from_args(tuple_args)
        return checker.type_table.resolve_generic_type_node(arena, id, source)
    args: List[types.TypeId] = []
    offset: i32 = 1
    while offset < node.child_count:
        args.append(resolve_type_node(checker, arena, arena.children[node.first_child + offset], source))
        offset += 1
    kind = types.TypeKind.NAMED
    found = checker.symbols.find_in_scope(source, symbols.root_scope(), base.value_start, base.value_length)
    if found.index >= 0:
        found_symbol = checker.symbols.symbols[found.index]
        expected_args = generics.type_param_count(arena, found_symbol.node)
        actual_args = node.child_count - 1
        if expected_args > 0 and expected_args != actual_args:
            emit_error(checker, 352, node.start, node.length, node.line, node.column)
        symbol_type = found_symbol.type_id
        is_atomic_template = is_qualified_atomic_type_import(checker, arena, base_id, source, found)
        if symbol_type.index >= 0 and symbol_type.index < cast[i32](len(checker.type_table.types)):
            kind = checker.type_table.types[symbol_type.index].kind
            if kind == types.TypeKind.ATOMIC:
                is_atomic_template = true
        if is_atomic_template:
            if actual_args != 1:
                emit_error(checker, 352, node.start, node.length, node.line, node.column)
                return types.type_error()
            element_kind = types.atomic_element_kind(&checker.type_table, args[0], source)
            if element_kind == types.AtomicElementKind.INVALID:
                if type_is_unbound_parameter(checker, args[0], source):
                    return checker.type_table.atomic_of(types.strip_const(&checker.type_table, args[0]), element_kind)
                argument_node = arena.nodes[arena.children[node.first_child + 1].index]
                emit_error(checker, 394, argument_node.start, argument_node.length, argument_node.line, argument_node.column)
                return types.type_error()
            return checker.type_table.atomic_of(types.strip_const(&checker.type_table, args[0]), element_kind)
    return checker.type_table.generic_from_args(kind, base.value_start, base.value_length, args)


def is_qualified_atomic_type_import(
    checker: &const Checker,
    arena: &const syntax.SyntaxArena,
    base: NodeId,
    source: &const String,
    found: symbols.SymbolId,
) -> bool:
    if base.index < 0 or found.index < 0:
        return false
    base_node = arena.nodes[base.index]
    if base_node.kind != syntax.SyntaxKind.TYPE_NAME or base_node.child_count != 2:
        return false
    leaf = arena.nodes[arena.children[base_node.first_child + 1].index]
    found_symbol = checker.symbols.symbols[found.index]
    declaration = found_symbol.node
    if declaration.index < 0 or arena.nodes[declaration.index].kind != syntax.SyntaxKind.IMPORT_DECL:
        return false
    qualified_name = source[base_node.value_start:base_node.value_start + base_node.value_length] + "." + source[leaf.value_start:leaf.value_start + leaf.value_length]
    return string_list_contains(&checker.qualified_atomic_template_names, &qualified_name)


def resolve_callable_type_node(checker: &Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, is_closure: bool) -> types.TypeId:
    node = arena.nodes[id.index]
    args: List[types.TypeId] = []
    offset: i32 = 0
    environment = types.type_error()
    if is_closure and node.child_count > 0:
        environment = resolve_type_node(checker, arena, arena.children[node.first_child], source)
        offset = 1
    parameter_end = node.child_count
    return_type = types.type_void()
    if types.callable_type_has_return(source, &node) and parameter_end > offset:
        parameter_end -= 1
        return_type = resolve_type_node(checker, arena, arena.children[node.first_child + parameter_end], source)
    while offset < parameter_end:
        parameter_node = arena.children[node.first_child + offset]
        parameter_type = resolve_type_node(checker, arena, parameter_node, source)
        if ownership.type_contains_atomic_storage(&checker.type_table, parameter_type):
            parameter_syntax = arena.nodes[parameter_node.index]
            emit_error(checker, 396, parameter_syntax.start, parameter_syntax.length, parameter_syntax.line, parameter_syntax.column)
        args.append(parameter_type)
        offset += 1
    if ownership.type_contains_atomic_storage(&checker.type_table, return_type):
        return_node = arena.nodes[arena.children[node.first_child + parameter_end].index]
        emit_error(checker, 396, return_node.start, return_node.length, return_node.line, return_node.column)
    if is_closure:
        return checker.type_table.closure_from_args(environment, args, return_type)
    return checker.type_table.function_from_args(args, return_type)


def is_runtime_generic_name(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    return range_text_equals(source, node.value_start, node.value_length, "Option") or range_text_equals(source, node.value_start, node.value_length, "Owned") or range_text_equals(source, node.value_start, node.value_length, "List") or range_text_equals(source, node.value_start, node.value_length, "Set") or range_text_equals(source, node.value_start, node.value_length, "Map") or range_text_equals(source, node.value_start, node.value_length, "MapKeys") or range_text_equals(source, node.value_start, node.value_length, "MapValues") or range_text_equals(source, node.value_start, node.value_length, "MapItems") or range_text_equals(source, node.value_start, node.value_length, "Result") or range_text_equals(source, node.value_start, node.value_length, "Tuple")


def is_nominal_symbol_kind(kind: symbols.SymbolKind) -> bool:
    return kind == symbols.SymbolKind.STRUCT or kind == symbols.SymbolKind.CLASS or kind == symbols.SymbolKind.ENUM or kind == symbols.SymbolKind.UNION or kind == symbols.SymbolKind.VARIANT or kind == symbols.SymbolKind.EXTERN_TYPE


def type_is_unbound_parameter(checker: &const Checker, type_id: types.TypeId, source: &const String) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(checker.type_table.types)):
        return false
    record = checker.type_table.types[type_id.index]
    if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.CONST or record.kind == types.TypeKind.SLICE or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.DYN or record.kind == types.TypeKind.ATOMIC:
        return type_is_unbound_parameter(checker, record.inner, source)
    if record.name_length == 0:
        return false
    for symbol in checker.symbols.symbols:
        if symbol.kind == symbols.SymbolKind.TYPE_PARAMETER and symbols.range_equals(source, record.name_start, record.name_length, symbol.name_start, symbol.name_length):
            return true
    return false


def find_child_type(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if is_type_kind(child.kind):
            return child_id
    return syntax.missing_node()


def is_type_kind(kind: syntax.SyntaxKind) -> bool:
    return kind == syntax.SyntaxKind.TYPE_NAME or kind == syntax.SyntaxKind.TYPE_GENERIC or kind == syntax.SyntaxKind.TYPE_CONST or kind == syntax.SyntaxKind.TYPE_POINTER or kind == syntax.SyntaxKind.TYPE_REFERENCE or kind == syntax.SyntaxKind.TYPE_ARRAY or kind == syntax.SyntaxKind.TYPE_SLICE or kind == syntax.SyntaxKind.TYPE_DYN or kind == syntax.SyntaxKind.TYPE_FUNCTION or kind == syntax.SyntaxKind.TYPE_CLOSURE


def range_text_equals(source: &const String, start: usize, length: usize, text: String) -> bool:
    if length != len(text):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true


def string_list_contains(values: &const List[String], expected: &const String) -> bool:
    for value in values:
        if value == expected:
            return true
    return false
