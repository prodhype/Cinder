from syntax import NodeId


struct SymbolFact:
    key: String
    module_name: String
    name: String
    kind: String
    owner: String
    signature: String
    canonical_signature: String
    implementation: String
    modifiers: String
    type_name: String
    ownership: String
    parameter_ownership: String
    abi: String
    members: String
    reflected: bool
    exported: bool
    path: String
    source: String
    line: i32
    column: i32
    module_index: usize
    symbol_index: i32
    node: NodeId


struct RelationFact:
    kind: String
    from_key: String
    to_key: String
    detail: String
    resolved: bool


struct SemanticFactGraph:
    facts: List[SymbolFact]
    relations: List[RelationFact]
    error: String


struct DiffSymbolFact:
    key: String
    module_name: String
    kind: String
    signature: String
    canonical_signature: String
    implementation: String
    modifiers: String
    type_name: String
    ownership: String
    parameter_ownership: String
    abi: String
    members: String
    reflected: bool
    exported: bool


struct DiffRelationFact:
    kind: String
    from_key: String
    to_key: String
    detail: String
    resolved: bool


struct DiffFactGraph:
    facts: List[DiffSymbolFact]
    relations: List[DiffRelationFact]
    error: String


struct LocationResult:
    ok: bool
    fact_index: i32
    module_index: i32
    node: NodeId
    error: String


def build_fact_graph(
    graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
) -> SemanticFactGraph:
    facts: List[SymbolFact] = []
    relations: List[RelationFact] = []
    if not analysis.ok:
        return SemanticFactGraph(
            facts=facts,
            relations=relations,
            error=analysis.error[0:len(analysis.error)],
        )
    specialization_names = emit_project.collect_project_specialization_names(graph)
    class_model: classes.ProjectClassModel = classes.collect_project_class_model(
        graph,
        &specialization_names,
    )
    reflection_model: codegen_reflection.ProjectReflectionModel = codegen_reflection.collect_project_reflection_model(
        graph,
        &specialization_names,
        &class_model,
    )
    module_index: usize = 0
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &graph.modules
    while module_index < len(analyzed_modules):
        analyzed: &const emit_project.AnalyzedModule = &analyzed_modules[module_index]
        source_module: &const project.ParsedModule = &project_modules[analyzed.module_index]
        symbol_index: usize = 0
        while symbol_index < len(analyzed.checked.symbols.symbols):
            symbol: &const symbols.SymbolRecord = &analyzed.checked.symbols.symbols[symbol_index]
            if symbol_is_fact(
                cast[i32](symbol_index),
                &analyzed.checked.symbols,
                &source_module.arena,
            ):
                facts.append(make_symbol_fact(
                    source_module,
                    &analyzed.checked,
                    analyzed.module_index,
                    cast[i32](symbol_index),
                    &class_model,
                    &reflection_model,
                ))
            symbol_index += 1
        collect_enum_member_facts(
            source_module,
            &analyzed.checked,
            analyzed.module_index,
            &facts,
        )
        collect_static_assert_facts(
            source_module,
            analyzed.module_index,
            &facts,
        )
        collect_import_facts(
            source_module,
            analyzed.module_index,
            &facts,
        )
        collect_extern_import_facts(
            source_module,
            analyzed.module_index,
            &facts,
        )
        collect_extern_block_facts(
            source_module,
            analyzed.module_index,
            &facts,
        )
        collect_lock_order_facts(
            source_module,
            analyzed.module_index,
            &facts,
        )
        module_index += 1
    graph_value = SemanticFactGraph(facts=facts, relations=relations, error="")
    mark_effective_reflected_members(
        &graph_value,
        &class_model,
        &reflection_model,
    )
    collect_member_relations(&graph_value)
    collect_layout_base_relations(&graph_value, &class_model)
    collect_override_relations(&graph_value, &class_model)
    collect_semantic_relations(graph, analysis, &graph_value)
    collect_match_variant_case_use_relations(graph, analysis, &graph_value)
    collect_enum_member_use_relations(graph, analysis, &graph_value)
    collect_nominal_field_use_relations(
        graph,
        analysis,
        &class_model,
        &graph_value,
    )
    collect_import_value_relations(graph, analysis, &graph_value)
    collect_import_call_relations(graph, analysis, &class_model, &graph_value)
    collect_layout_type_relations(graph, &graph_value)
    collect_type_relations(graph, &graph_value)
    collect_import_type_fact_relations(graph, analysis, &graph_value)
    collect_abi_surface_relations(graph, analysis, &graph_value)
    collect_lock_relations(analysis, &graph_value)
    return graph_value


def compact_diff_graph(graph: &const SemanticFactGraph) -> DiffFactGraph:
    facts: List[DiffSymbolFact] = []
    relations: List[DiffRelationFact] = []
    source_facts: &const List[SymbolFact] = &graph.facts
    source_relations: &const List[RelationFact] = &graph.relations
    for fact in source_facts:
        facts.append(
            DiffSymbolFact(
                key=owned_text(&fact.key),
                module_name=owned_text(&fact.module_name),
                kind=owned_text(&fact.kind),
                signature=owned_text(&fact.signature),
                canonical_signature=owned_text(&fact.canonical_signature),
                implementation=owned_text(&fact.implementation),
                modifiers=owned_text(&fact.modifiers),
                type_name=owned_text(&fact.type_name),
                ownership=owned_text(&fact.ownership),
                parameter_ownership=owned_text(&fact.parameter_ownership),
                abi=owned_text(&fact.abi),
                members=owned_text(&fact.members),
                reflected=fact.reflected,
                exported=fact.exported,
            )
        )
    for relation in source_relations:
        relations.append(
            DiffRelationFact(
                kind=owned_text(&relation.kind),
                from_key=owned_text(&relation.from_key),
                to_key=owned_text(&relation.to_key),
                detail=owned_text(&relation.detail),
                resolved=relation.resolved,
            )
        )
    return DiffFactGraph(
        facts=facts,
        relations=relations,
        error=owned_text(&graph.error),
    )


def owned_text(value: &const String) -> String:
    builder = StringBuilder()
    builder.append(value[0:len(value)])
    return builder.finish()


def symbol_is_fact(
    symbol_index: i32,
    table: &const symbols.SymbolTable,
    arena: &const syntax.SyntaxArena,
) -> bool:
    symbol_values: &const List[symbols.SymbolRecord] = &table.symbols
    symbol: &const symbols.SymbolRecord = &symbol_values[symbol_index]
    if symbol.node.index < 0:
        return false
    if symbol.kind == symbols.SymbolKind.FUNCTION or symbol.kind == symbols.SymbolKind.FUNCTION_TEMPLATE:
        for candidate: symbols.SymbolRecord in symbol_values:
            if candidate.node.index == symbol.node.index and candidate.kind == symbols.SymbolKind.METHOD:
                return false
    node = arena.nodes[symbol.node.index]
    if node.kind == syntax.SyntaxKind.IMPORT_DECL or node.kind == syntax.SyntaxKind.IMPORT_NAME or node.kind == syntax.SyntaxKind.FROM_IMPORT_DECL:
        return false
    return (
        symbol.kind == symbols.SymbolKind.FUNCTION
        or symbol.kind == symbols.SymbolKind.FUNCTION_TEMPLATE
        or symbol.kind == symbols.SymbolKind.STRUCT
        or symbol.kind == symbols.SymbolKind.CLASS
        or symbol.kind == symbols.SymbolKind.ENUM
        or symbol.kind == symbols.SymbolKind.UNION
        or symbol.kind == symbols.SymbolKind.VARIANT
        or symbol.kind == symbols.SymbolKind.VARIANT_CASE
        or symbol.kind == symbols.SymbolKind.FIELD
        or symbol.kind == symbols.SymbolKind.METHOD
        or symbol.kind == symbols.SymbolKind.GLOBAL
        or symbol.kind == symbols.SymbolKind.CONSTANT
        or symbol.kind == symbols.SymbolKind.EXTERN_FUNCTION
        or symbol.kind == symbols.SymbolKind.EXTERN_TYPE
        or symbol.kind == symbols.SymbolKind.LOCK
    )


def make_symbol_fact(
    module: &const project.ParsedModule,
    checked: &const checker_core.Checker,
    module_index: usize,
    symbol_index: i32,
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
) -> SymbolFact:
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    arena: &const syntax.SyntaxArena = &module.arena
    node_values: &const List[syntax.SyntaxNode] = &arena.nodes
    symbol = symbol_values[symbol_index]
    node = node_values[symbol.node.index]
    name = module.source[symbol.name_start:symbol.name_start + symbol.name_length]
    kind = symbol_kind_name(symbol.kind)
    owner = symbol_owner_path(&checked.symbols, symbol.owner, &module.source)
    key = stable_symbol_key(&module.name, &kind, &owner, &name)
    type_name = symbol_fact_type_name(
        arena,
        &checked.type_table,
        &symbol,
        &module.source,
    )
    signature = declaration_header(arena, symbol.node, &module.source)
    canonical_signature = canonical_declaration_snapshot(
        arena,
        symbol.node,
        &module.source,
    )
    implementation = function_implementation_snapshot(
        arena,
        symbol.node,
        &module.source,
    )
    modifiers = semantic_modifiers(arena, symbol.node, &module.source)
    declaration_source = declaration_source_slice(
        arena,
        symbol.node,
        &module.source,
    )
    reflected = symbol_is_reflected(
        arena,
        &checked.symbols,
        &symbol,
        &module.source,
    )
    exported = has_decorator(arena, symbol.node, &module.source, "export")
    members = ordered_nominal_member_keys(
        module,
        symbol.kind,
        &owner,
        &name,
        symbol.node,
        class_model,
        reflection_model,
    )
    return SymbolFact(
        key=key,
        module_name=module.name[0:len(module.name)],
        name=name,
        kind=kind,
        owner=owner,
        signature=signature,
        canonical_signature=canonical_signature,
        implementation=implementation,
        modifiers=modifiers,
        type_name=type_name,
        ownership=ownership_name(&checked.type_table, symbol.type_id),
        parameter_ownership=parameter_ownership_summary(
            arena,
            symbol.node,
            &module.source,
            checked,
        ),
        abi=abi_name(symbol.kind, &node, exported),
        members=members,
        reflected=reflected,
        exported=exported,
        path=module.path[0:len(module.path)],
        source=declaration_source,
        line=node.line,
        column=node.column,
        module_index=module_index,
        symbol_index=symbol_index,
        node=symbol.node,
    )


def collect_enum_member_facts(
    module: &const project.ParsedModule,
    checked: &const checker_core.Checker,
    module_index: usize,
    facts: &List[SymbolFact],
) -> void:
    arena: &const syntax.SyntaxArena = &module.arena
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    enum_bindings: &const List[semantic.NodeSymbolBinding] = &checked.model.enum_symbols
    for binding in enum_bindings:
        if (
            binding.node.index < 0
            or binding.symbol.index < 0
            or binding.symbol.index >= cast[i32](len(symbol_values))
        ):
            continue
        enum_symbol: &const symbols.SymbolRecord = &symbol_values[
            cast[usize](binding.symbol.index)
        ]
        declaration = nodes[binding.node.index]
        enum_name = module.source[
            enum_symbol.name_start:enum_symbol.name_start + enum_symbol.name_length
        ]
        enum_owner = symbol_owner_path(
            &checked.symbols,
            enum_symbol.owner,
            &module.source,
        )
        member_owner = enum_name[0:len(enum_name)]
        if len(enum_owner) > 0:
            member_owner = enum_owner[0:len(enum_owner)] + "." + enum_name[0:len(enum_name)]
        enum_type_name = symbol_fact_type_name(
            arena,
            &checked.type_table,
            enum_symbol,
            &module.source,
        )
        enum_ownership = ownership_name(&checked.type_table, enum_symbol.type_id)
        enum_reflected = has_decorator(arena, binding.node, &module.source, "reflect")
        for offset in range(0, declaration.child_count):
            member_id = children[declaration.first_child + offset]
            member = nodes[member_id.index]
            if member.kind != syntax.SyntaxKind.ENUM_MEMBER_DECL:
                continue
            member_name = module.source[
                member.value_start:member.value_start + member.value_length
            ]
            member_kind = "enum-member"
            facts.append(
                SymbolFact(
                    key=stable_symbol_key(
                        &module.name,
                        &member_kind,
                        &member_owner,
                        &member_name,
                    ),
                    module_name=module.name[0:len(module.name)],
                    name=member_name,
                    kind=member_kind,
                    owner=member_owner[0:len(member_owner)],
                    signature=declaration_header(arena, member_id, &module.source),
                    canonical_signature=canonical_declaration_snapshot(
                        arena,
                        member_id,
                        &module.source,
                    ),
                    implementation="",
                    modifiers="none",
                    type_name=enum_type_name[0:len(enum_type_name)],
                    ownership=enum_ownership[0:len(enum_ownership)],
                    parameter_ownership="(not applicable)",
                    abi="Cinder",
                    members="",
                    reflected=enum_reflected,
                    exported=false,
                    path=module.path[0:len(module.path)],
                    source=declaration_source_slice(
                        arena,
                        member_id,
                        &module.source,
                    ),
                    line=member.line,
                    column=member.column,
                    module_index=module_index,
                    symbol_index=-1,
                    node=member_id,
                )
            )


def symbol_fact_type_name(
    arena: &const syntax.SyntaxArena,
    table: &const types.TypeTable,
    symbol: &const symbols.SymbolRecord,
    source: &const String,
) -> String:
    type_node_id = codegen_type_names.find_child_type(arena, symbol.node)
    type_builder = StringBuilder()
    if type_node_contains_qualified_name(arena, type_node_id):
        codegen_type_names.emit_semantic_declared_type_name(
            arena,
            type_node_id,
            source,
            &type_builder,
        )
    else:
        codegen_type_names.emit_semantic_readable_type_name(
            table,
            symbol.type_id,
            source,
            &type_builder,
        )
    return type_builder.finish()


def type_node_contains_qualified_name(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.TYPE_NAME and node.child_count > 1:
        return true
    for offset in range(0, node.child_count):
        if type_node_contains_qualified_name(
            arena,
            arena.children[node.first_child + offset],
        ):
            return true
    return false


def collect_static_assert_facts(
    module: &const project.ParsedModule,
    module_index: usize,
    facts: &List[SymbolFact],
) -> void:
    if module.root.index < 0:
        return
    arena: &const syntax.SyntaxArena = &module.arena
    root = arena.nodes[module.root.index]
    assertion_index: i32 = 0
    for offset in range(0, root.child_count):
        declaration = arena.children[root.first_child + offset]
        node = arena.nodes[declaration.index]
        if node.kind != syntax.SyntaxKind.STATIC_ASSERT_DECL:
            continue
        name = "assertion_" + to_string(assertion_index)
        kind = "static-assert"
        facts.append(
            SymbolFact(
                key=stable_symbol_key(&module.name, &kind, "", &name),
                module_name=module.name[0:len(module.name)],
                name=name,
                kind=kind,
                owner="",
                signature=declaration_header(arena, declaration, &module.source),
                canonical_signature=canonical_declaration_snapshot(
                    arena,
                    declaration,
                    &module.source,
                ),
                implementation="",
                modifiers="none",
                type_name="not applicable",
                ownership="not applicable",
                parameter_ownership="(not applicable)",
                abi="not applicable",
                members="",
                reflected=false,
                exported=false,
                path=module.path[0:len(module.path)],
                source=declaration_source_slice(
                    arena,
                    declaration,
                    &module.source,
                ),
                line=node.line,
                column=node.column,
                module_index=module_index,
                symbol_index=-1,
                node=declaration,
            )
        )
        assertion_index += 1


def collect_import_facts(
    module: &const project.ParsedModule,
    module_index: usize,
    facts: &List[SymbolFact],
) -> void:
    if module.root.index < 0:
        return
    arena: &const syntax.SyntaxArena = &module.arena
    root = arena.nodes[module.root.index]
    import_index: i32 = 0
    for offset in range(0, root.child_count):
        declaration = arena.children[root.first_child + offset]
        node = arena.nodes[declaration.index]
        if (
            node.kind != syntax.SyntaxKind.IMPORT_DECL
            and node.kind != syntax.SyntaxKind.FROM_IMPORT_DECL
        ):
            continue
        name = "import_" + to_string(import_index)
        kind = "import"
        facts.append(
            SymbolFact(
                key=stable_symbol_key(&module.name, &kind, "", &name),
                module_name=module.name[0:len(module.name)],
                name=name,
                kind=kind,
                owner="",
                signature=declaration_header(arena, declaration, &module.source),
                canonical_signature=canonical_declaration_snapshot(
                    arena,
                    declaration,
                    &module.source,
                ),
                implementation="",
                modifiers="none",
                type_name="not applicable",
                ownership="not applicable",
                parameter_ownership="(not applicable)",
                abi="not applicable",
                members="",
                reflected=false,
                exported=false,
                path=module.path[0:len(module.path)],
                source=declaration_source_slice(
                    arena,
                    declaration,
                    &module.source,
                ),
                line=node.line,
                column=node.column,
                module_index=module_index,
                symbol_index=-1,
                node=declaration,
            )
        )
        import_index += 1


