def ordered_nominal_member_keys(
    module: &const project.ParsedModule,
    kind: symbols.SymbolKind,
    owner: &const String,
    name: &const String,
    id: NodeId,
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
) -> String:
    if (
        kind != symbols.SymbolKind.STRUCT
        and kind != symbols.SymbolKind.CLASS
        and kind != symbols.SymbolKind.UNION
        and kind != symbols.SymbolKind.ENUM
        and kind != symbols.SymbolKind.VARIANT
    ):
        return ""
    arena: &const syntax.SyntaxArena = &module.arena
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    if (
        (kind == symbols.SymbolKind.STRUCT or kind == symbols.SymbolKind.CLASS)
        and has_decorator(arena, id, &module.source, "reflect")
    ):
        nominal_index = codegen_reflection.find_nominal(
            reflection_model,
            &module.name,
            name,
        )
        if nominal_index >= 0:
            return ordered_effective_reflected_member_keys(
                class_model,
                reflection_model,
                nominal_index,
            )
    node = nodes[id.index]
    member_owner = name[0:len(name)]
    if len(owner) > 0:
        member_owner = owner[0:len(owner)] + "." + name[0:len(name)]
    builder = StringBuilder()
    first = true
    for offset in range(0, node.child_count):
        child_id = children[node.first_child + offset]
        child = nodes[child_id.index]
        member_kind = ""
        if (
            (
                kind == symbols.SymbolKind.STRUCT
                or kind == symbols.SymbolKind.CLASS
                or kind == symbols.SymbolKind.UNION
            )
            and child.kind == syntax.SyntaxKind.FIELD_DECL
        ):
            member_kind = "field"
        elif kind == symbols.SymbolKind.ENUM and child.kind == syntax.SyntaxKind.ENUM_MEMBER_DECL:
            member_kind = "enum-member"
        elif kind == symbols.SymbolKind.VARIANT and child.kind == syntax.SyntaxKind.VARIANT_CASE_DECL:
            member_kind = "variant-case"
        if len(member_kind) > 0:
            if not first:
                builder.append(", ")
            member_name = module.source[child.value_start:child.value_start + child.value_length]
            member_key = stable_symbol_key(
                &module.name,
                &member_kind,
                &member_owner,
                &member_name,
            )
            builder.append(member_key[0:len(member_key)])
            if child.kind == syntax.SyntaxKind.ENUM_MEMBER_DECL and child.child_count > 0:
                value_id = children[child.first_child]
                builder.append("=")
                append_canonical_enum_member_value(
                    &builder,
                    arena,
                    value_id,
                    &module.source,
                )
            first = false
    if (
        (kind == symbols.SymbolKind.STRUCT or kind == symbols.SymbolKind.CLASS)
        and has_decorator(arena, id, &module.source, "reflect")
    ):
        for offset in range(0, node.child_count):
            child_id = children[node.first_child + offset]
            child = nodes[child_id.index]
            if child.kind != syntax.SyntaxKind.FUNCTION_DECL:
                continue
            method_name = module.source[child.value_start:child.value_start + child.value_length]
            if (
                kind == symbols.SymbolKind.CLASS
                and (method_name == "__init__" or method_name == "__del__")
            ):
                continue
            if not first:
                builder.append(", ")
            method_kind = "method"
            method_key = stable_symbol_key(
                &module.name,
                &method_kind,
                &member_owner,
                &method_name,
            )
            builder.append(method_key[0:len(method_key)])
            first = false
    return builder.finish()


def ordered_effective_reflected_member_keys(
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
    nominal_index: i32,
) -> String:
    builder = StringBuilder()
    first = true
    field_count = codegen_reflection.effective_field_count(
        reflection_model,
        class_model,
        nominal_index,
    )
    for field_offset in range(0, field_count):
        field_index = codegen_reflection.effective_field_at(
            reflection_model,
            class_model,
            nominal_index,
            field_offset,
        )
        if field_index < 0:
            continue
        field: &const codegen_reflection.ReflectionFieldInfo = &reflection_model.fields[cast[usize](field_index)]
        field_owner: &const codegen_reflection.ReflectionNominalInfo = &reflection_model.nominals[cast[usize](field.owner)]
        if not first:
            builder.append(", ")
        field_kind = "field"
        field_key = stable_symbol_key(
            &field_owner.module_name,
            &field_kind,
            &field_owner.name,
            &field.name,
        )
        builder.append(field_key[0:len(field_key)])
        first = false
    method_count = codegen_reflection.effective_method_count(
        reflection_model,
        class_model,
        nominal_index,
    )
    for method_offset in range(0, method_count):
        method_index = codegen_reflection.effective_method_at(
            reflection_model,
            class_model,
            nominal_index,
            method_offset,
        )
        if method_index < 0:
            continue
        method: &const codegen_reflection.ReflectionMethodInfo = &reflection_model.methods[cast[usize](method_index)]
        method_owner: &const codegen_reflection.ReflectionNominalInfo = &reflection_model.nominals[cast[usize](method.owner)]
        if not first:
            builder.append(", ")
        method_kind = "method"
        method_key = stable_symbol_key(
            &method_owner.module_name,
            &method_kind,
            &method_owner.name,
            &method.name,
        )
        builder.append(method_key[0:len(method_key)])
        first = false
    return builder.finish()


def mark_effective_reflected_members(
    graph: &SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    reflection_model: &const codegen_reflection.ProjectReflectionModel,
) -> void:
    nominal_index: usize = 0
    while nominal_index < len(reflection_model.nominals):
        nominal: &const codegen_reflection.ReflectionNominalInfo = &reflection_model.nominals[nominal_index]
        if nominal.is_reflected:
            field_count = codegen_reflection.effective_field_count(
                reflection_model,
                class_model,
                cast[i32](nominal_index),
            )
            for field_offset in range(0, field_count):
                field_index = codegen_reflection.effective_field_at(
                    reflection_model,
                    class_model,
                    cast[i32](nominal_index),
                    field_offset,
                )
                if field_index < 0:
                    continue
                field: &const codegen_reflection.ReflectionFieldInfo = &reflection_model.fields[cast[usize](field_index)]
                owner: &const codegen_reflection.ReflectionNominalInfo = &reflection_model.nominals[cast[usize](field.owner)]
                kind = "field"
                key = stable_symbol_key(
                    &owner.module_name,
                    &kind,
                    &owner.name,
                    &field.name,
                )
                fact_index = find_fact_by_key(graph, &key)
                if fact_index >= 0:
                    graph.facts[cast[usize](fact_index)].reflected = true
            method_count = codegen_reflection.effective_method_count(
                reflection_model,
                class_model,
                cast[i32](nominal_index),
            )
            for method_offset in range(0, method_count):
                method_index = codegen_reflection.effective_method_at(
                    reflection_model,
                    class_model,
                    cast[i32](nominal_index),
                    method_offset,
                )
                if method_index < 0:
                    continue
                method: &const codegen_reflection.ReflectionMethodInfo = &reflection_model.methods[cast[usize](method_index)]
                owner: &const codegen_reflection.ReflectionNominalInfo = &reflection_model.nominals[cast[usize](method.owner)]
                kind = "method"
                key = stable_symbol_key(
                    &owner.module_name,
                    &kind,
                    &owner.name,
                    &method.name,
                )
                fact_index = find_fact_by_key(graph, &key)
                if fact_index >= 0:
                    graph.facts[cast[usize](fact_index)].reflected = true
        nominal_index += 1


def append_canonical_enum_member_value(
    builder: &StringBuilder,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_LITERAL:
        if snapshot_node_value_is_numeric(&node):
            value = codegen_names.canonical_numeric_literal_value(
                source,
                node.value_start,
                node.value_length,
                node.flags,
            )
            builder.append(value[0:len(value)])
        else:
            builder.append(source[node.value_start:node.value_start + node.value_length])
        return
    if node.kind == syntax.SyntaxKind.EXPR_UNARY:
        builder.append(source[node.value_start:node.value_start + node.value_length])
        index = node.value_start + node.value_length
        end = node.start + node.length
        while index < end:
            byte = source.byte_at(index)
            if byte != 32 and byte != 9 and byte != 10 and byte != 13:
                break
            index += 1
        value = codegen_names.canonical_numeric_literal_value(
            source,
            index,
            end - index,
            cast[i32](token.TokenKind.INTEGER),
        )
        builder.append(value[0:len(value)])
        return
    builder.append(source[node.value_start:node.value_start + node.value_length])


def stable_symbol_key(
    module_name: &const String,
    kind: &const String,
    owner: &const String,
    name: &const String,
) -> String:
    builder = StringBuilder()
    builder.append(module_name[0:len(module_name)])
    builder.append("::")
    builder.append(kind[0:len(kind)])
    builder.append(":")
    if len(owner) > 0:
        builder.append(owner[0:len(owner)])
        builder.append(".")
    builder.append(name[0:len(name)])
    return builder.finish()


def symbol_owner_path(
    table: &const symbols.SymbolTable,
    owner_id: symbols.SymbolId,
    source: &const String,
) -> String:
    if owner_id.index < 0 or owner_id.index >= cast[i32](len(table.symbols)):
        return ""
    owner = table.symbols[owner_id.index]
    name = source[owner.name_start:owner.name_start + owner.name_length]
    prefix = symbol_owner_path(table, owner.owner, source)
    if len(prefix) == 0:
        return name
    return prefix + "." + name


def symbol_kind_name(kind: symbols.SymbolKind) -> String:
    if kind == symbols.SymbolKind.FUNCTION:
        return "function"
    if kind == symbols.SymbolKind.FUNCTION_TEMPLATE:
        return "function-template"
    if kind == symbols.SymbolKind.STRUCT:
        return "struct"
    if kind == symbols.SymbolKind.CLASS:
        return "class"
    if kind == symbols.SymbolKind.ENUM:
        return "enum"
    if kind == symbols.SymbolKind.UNION:
        return "union"
    if kind == symbols.SymbolKind.VARIANT:
        return "variant"
    if kind == symbols.SymbolKind.VARIANT_CASE:
        return "variant-case"
    if kind == symbols.SymbolKind.FIELD:
        return "field"
    if kind == symbols.SymbolKind.METHOD:
        return "method"
    if kind == symbols.SymbolKind.GLOBAL:
        return "global"
    if kind == symbols.SymbolKind.CONSTANT:
        return "constant"
    if kind == symbols.SymbolKind.EXTERN_FUNCTION:
        return "extern-function"
    if kind == symbols.SymbolKind.EXTERN_TYPE:
        return "extern-type"
    if kind == symbols.SymbolKind.LOCK:
        return "lock"
    return "symbol"


def ownership_name(
    table: &const types.TypeTable,
    type_id: types.TypeId,
) -> String:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return "unknown"
    type_values: &const List[types.TypeRecord] = &table.types
    if type_values[type_id.index].kind == types.TypeKind.NAMED:
        return "unknown"
    kind = ownership.ownership_kind(table, type_id)
    if kind == ownership.OwnershipKind.MOVE_ONLY:
        return "owned"
    if kind == ownership.OwnershipKind.BORROWED:
        return "borrowed"
    if kind == ownership.OwnershipKind.IMMOBILE:
        return "immobile"
    return "copy"


def parameter_ownership_summary(
    arena: &const syntax.SyntaxArena,
    declaration: NodeId,
    source: &const String,
    checked: &const checker_core.Checker,
) -> String:
    if declaration.index < 0:
        return "(not applicable)"
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    node = nodes[declaration.index]
    if node.kind != syntax.SyntaxKind.FUNCTION_DECL:
        return "(not applicable)"
    builder = StringBuilder()
    count: i32 = 0
    for offset in range(0, node.child_count):
        parameter_id = children[node.first_child + offset]
        parameter = nodes[parameter_id.index]
        if parameter.kind != syntax.SyntaxKind.PARAMETER:
            continue
        if count > 0:
            builder.append(", ")
        if parameter.value_length > 0:
            builder.append(source[parameter.value_start:parameter.value_start + parameter.value_length])
        else:
            builder.append("...")
        builder.append("=")
        parameter_type = types.missing_type()
        for child_offset in range(0, parameter.child_count):
            child_id = children[parameter.first_child + child_offset]
            child = nodes[child_id.index]
            if is_type_node_kind(child.kind):
                parameter_type = checked.model.type_node(child_id)
        builder.append(ownership_name(&checked.type_table, parameter_type))
        count += 1
    if count == 0:
        return "(none)"
    return builder.finish()


def is_type_node_kind(kind: syntax.SyntaxKind) -> bool:
    return (
        kind == syntax.SyntaxKind.TYPE_NAME
        or kind == syntax.SyntaxKind.TYPE_GENERIC
        or kind == syntax.SyntaxKind.TYPE_CONST
        or kind == syntax.SyntaxKind.TYPE_POINTER
        or kind == syntax.SyntaxKind.TYPE_REFERENCE
        or kind == syntax.SyntaxKind.TYPE_ARRAY
        or kind == syntax.SyntaxKind.TYPE_SLICE
        or kind == syntax.SyntaxKind.TYPE_DYN
        or kind == syntax.SyntaxKind.TYPE_FUNCTION
        or kind == syntax.SyntaxKind.TYPE_CLOSURE
    )


def abi_name(
    kind: symbols.SymbolKind,
    node: &const syntax.SyntaxNode,
    exported: bool,
) -> String:
    if exported or kind == symbols.SymbolKind.EXTERN_FUNCTION or kind == symbols.SymbolKind.EXTERN_TYPE:
        return "C"
    if node.kind == syntax.SyntaxKind.FUNCTION_DECL and node.flags == 1:
        return "C"
    return "Cinder"


def has_decorator(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    expected: String,
) -> bool:
    if id.index < 0:
        return false
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    node = nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = children[node.first_child + offset]
        child = nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.DECORATOR and source[child.value_start:child.value_start + child.value_length] == expected:
            return true
    return false


def symbol_is_reflected(
    arena: &const syntax.SyntaxArena,
    table: &const symbols.SymbolTable,
    symbol: &const symbols.SymbolRecord,
    source: &const String,
) -> bool:
    if has_decorator(arena, symbol.node, source, "reflect"):
        return true
    if symbol.kind != symbols.SymbolKind.FIELD and symbol.kind != symbols.SymbolKind.METHOD:
        return false
    owner_id = symbol.owner
    symbol_values: &const List[symbols.SymbolRecord] = &table.symbols
    while owner_id.index >= 0 and owner_id.index < cast[i32](len(symbol_values)):
        owner: &const symbols.SymbolRecord = &symbol_values[cast[usize](owner_id.index)]
        if (
            owner.kind == symbols.SymbolKind.STRUCT
            or owner.kind == symbols.SymbolKind.CLASS
            or owner.kind == symbols.SymbolKind.ENUM
            or owner.kind == symbols.SymbolKind.UNION
            or owner.kind == symbols.SymbolKind.VARIANT
        ):
            return has_decorator(arena, owner.node, source, "reflect")
        owner_id = owner.owner
    return false


def declaration_header(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> String:
    if id.index < 0:
        return ""
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    node = nodes[id.index]
    start = declaration_location_start(arena, id)
    end = node.start + node.length
    if (
        node.kind == syntax.SyntaxKind.FUNCTION_DECL
        or is_nominal_declaration_kind(node.kind)
        or node.kind == syntax.SyntaxKind.EXTERN_BLOCK
    ):
        if node.kind == syntax.SyntaxKind.FUNCTION_DECL:
            for offset in range(0, node.child_count):
                child_id = children[node.first_child + offset]
                child = nodes[child_id.index]
                if child.kind == syntax.SyntaxKind.BLOCK:
                    end = child.start
                    break
        else:
            index = node.start
            delimiter_depth: i32 = 0
            while index < end:
                byte = source.byte_at(index)
                if byte == 40 or byte == 91:
                    delimiter_depth += 1
                elif byte == 41 or byte == 93:
                    delimiter_depth -= 1
                elif byte == 58 and delimiter_depth == 0:
                    end = index + 1
                    break
                index += 1
    while end > start:
        byte = source.byte_at(end - 1)
        if byte != 32 and byte != 9 and byte != 10 and byte != 13:
            break
        end -= 1
    return source[start:end]


def declaration_source_slice(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> String:
    if id.index < 0:
        return ""
    node = arena.nodes[id.index]
    start = declaration_location_start(arena, id)
    return source[start:node.start + node.length]


def canonical_declaration_snapshot(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> String:
    if id.index < 0:
        return ""
    builder = StringBuilder()
    append_snapshot_node_start(&builder, &arena.nodes[id.index], source)
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if node.kind == syntax.SyntaxKind.FUNCTION_DECL and child.kind == syntax.SyntaxKind.BLOCK:
            continue
        if is_nominal_declaration_kind(node.kind) and is_nominal_member_node_kind(child.kind):
            continue
        if (
            node.kind == syntax.SyntaxKind.EXTERN_BLOCK
            and (
                child.kind == syntax.SyntaxKind.FUNCTION_DECL
                or child.kind == syntax.SyntaxKind.EXTERN_TYPE_DECL
            )
        ):
            continue
        append_syntax_snapshot(&builder, arena, child_id, source)
    builder.append(")")
    return builder.finish()


def function_implementation_snapshot(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> String:
    if id.index < 0:
        return ""
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.FUNCTION_DECL:
        return ""
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.BLOCK:
            builder = StringBuilder()
            append_syntax_snapshot(&builder, arena, child_id, source)
            return builder.finish()
    return ""


def append_syntax_snapshot(
    builder: &StringBuilder,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    append_snapshot_node_start(builder, &node, source)
    for offset in range(0, node.child_count):
        append_syntax_snapshot(
            builder,
            arena,
            arena.children[node.first_child + offset],
            source,
        )
    builder.append(")")


def append_snapshot_node_start(
    builder: &StringBuilder,
    node: &const syntax.SyntaxNode,
    source: &const String,
) -> void:
    value = source[node.value_start:node.value_start + node.value_length]
    if snapshot_node_value_is_numeric(node):
        value = canonical_numeric_snapshot_value(node, source)
    elif snapshot_node_value_is_quoted_literal(node):
        value = canonical_quoted_literal_snapshot_value(node, source)
    elif snapshot_node_value_is_fstring(node, source):
        value = canonical_fstring_snapshot_value(node, source)
    builder.append("(")
    builder.append(to_string(cast[i32](node.kind)))
    builder.append(":")
    builder.append(to_string(node.flags))
    builder.append(":")
    builder.append(to_string(len(value)))
    builder.append(":")
    builder.append(value)


def snapshot_node_value_is_numeric(
    node: &const syntax.SyntaxNode,
) -> bool:
    return (
        node.kind == syntax.SyntaxKind.EXPR_LITERAL
        and (
            node.flags == cast[i32](token.TokenKind.INTEGER)
            or node.flags == cast[i32](token.TokenKind.FLOAT)
        )
    )


def snapshot_node_value_is_quoted_literal(
    node: &const syntax.SyntaxNode,
) -> bool:
    return (
        node.kind == syntax.SyntaxKind.EXPR_LITERAL
        and (
            node.flags == cast[i32](token.TokenKind.STRING)
            or node.flags == cast[i32](token.TokenKind.CHAR)
        )
    )


def canonical_quoted_literal_snapshot_value(
    node: &const syntax.SyntaxNode,
    source: &const String,
) -> String:
    return codegen_names.canonical_quoted_literal_value(
        source,
        node.value_start,
        node.value_length,
    )


def canonical_numeric_snapshot_value(
    node: &const syntax.SyntaxNode,
    source: &const String,
) -> String:
    return codegen_names.canonical_numeric_literal_value(
        source,
        node.value_start,
        node.value_length,
        node.flags,
    )


def snapshot_node_value_is_fstring(
    node: &const syntax.SyntaxNode,
    source: &const String,
) -> bool:
    if node.value_length < 3:
        return false
    quote = source.byte_at(node.value_start + 1)
    return (
        source.byte_at(node.value_start) == 102
        and (quote == 34 or quote == 39)
        and source.byte_at(node.value_start + node.value_length - 1) == quote
    )


def canonical_fstring_snapshot_value(
    node: &const syntax.SyntaxNode,
    source: &const String,
) -> String:
    raw = source[node.value_start:node.value_start + node.value_length]
    if node.value_length < 3:
        return raw
    content_start = node.value_start + 2
    content_end = node.value_start + node.value_length - 1
    builder = StringBuilder()
    builder.append(source[node.value_start:content_start])
    literal_start = content_start
    index = content_start
    while index < content_end:
        byte = source.byte_at(index)
        if byte == 92:
            if index + 1 < content_end:
                index += 2
            else:
                index += 1
            continue
        if byte == 123:
            if index + 1 < content_end and source.byte_at(index + 1) == 123:
                index += 2
                continue
            field = codegen_model.scan_fstring_field(source, index + 1, content_end)
            if not field.valid:
                return raw
            expression_start = codegen_model.trim_left(
                source,
                index + 1,
                field.expression_end,
            )
            expression_end = codegen_model.trim_right(
                source,
                expression_start,
                field.expression_end,
            )
            if expression_end <= expression_start:
                return raw
            expression_source = source[expression_start:expression_end]
            scan = lexer.new_lexer(expression_source)
            scan.tokenize()
            parsed = parser.new_parser(&scan)
            expression = parsed.parse_expression(0)
            if (
                len(scan.diagnostics) > 0
                or len(parsed.diagnostics) > 0
                or expression.index < 0
            ):
                return raw
            if not codegen_names.append_canonical_literal_content(
                &builder,
                source,
                literal_start,
                index - literal_start,
            ):
                return raw
            builder.append("{")
            append_syntax_snapshot(
                &builder,
                &parsed.arena,
                expression,
                &scan.source,
            )
            if field.format_start < field.close:
                format_start = codegen_model.trim_left(
                    source,
                    field.format_start + 1,
                    field.close,
                )
                format_end = codegen_model.trim_right(
                    source,
                    format_start,
                    field.close,
                )
                builder.append(":")
                builder.append(source[format_start:format_end])
            builder.append("}")
            index = field.close + 1
            literal_start = index
            continue
        index += 1
    if not codegen_names.append_canonical_literal_content(
        &builder,
        source,
        literal_start,
        content_end - literal_start,
    ):
        return raw
    builder.append(source[content_end:node.value_start + node.value_length])
    return builder.finish()


def is_nominal_member_node_kind(kind: syntax.SyntaxKind) -> bool:
    return (
        kind == syntax.SyntaxKind.FIELD_DECL
        or kind == syntax.SyntaxKind.FUNCTION_DECL
        or kind == syntax.SyntaxKind.ENUM_MEMBER_DECL
        or kind == syntax.SyntaxKind.VARIANT_CASE_DECL
        or kind == syntax.SyntaxKind.PASS_STMT
    )


def is_nominal_declaration_kind(kind: syntax.SyntaxKind) -> bool:
    return (
        kind == syntax.SyntaxKind.STRUCT_DECL
        or kind == syntax.SyntaxKind.CLASS_DECL
        or kind == syntax.SyntaxKind.ENUM_DECL
        or kind == syntax.SyntaxKind.UNION_DECL
        or kind == syntax.SyntaxKind.VARIANT_DECL
    )


def semantic_modifiers(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> String:
    if id.index < 0:
        return "none"
    node = arena.nodes[id.index]
    modifiers = ""
    if node.kind == syntax.SyntaxKind.FIELD_DECL and node.flags == 1:
        modifiers = "private"
    if node.kind == syntax.SyntaxKind.FUNCTION_DECL:
        if has_decorator(arena, id, source, "abstractmethod"):
            modifiers = "abstractmethod"
        if has_decorator(arena, id, source, "override"):
            if len(modifiers) > 0:
                modifiers = modifiers + ", "
            modifiers = modifiers + "override"
    if len(modifiers) == 0:
        return "none"
    return modifiers


def collect_member_relations(graph: &SemanticFactGraph) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    for fact in facts:
        if len(fact.owner) == 0:
            continue
        owner_index = find_fact_by_owner_name(
            graph,
            &fact.module_name,
            &fact.owner,
        )
        if owner_index >= 0:
            add_relation_unique(
                graph,
                "member",
                &facts[cast[usize](owner_index)].key,
                &fact.key,
                "",
                true,
            )


def collect_layout_base_relations(
    graph: &SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    class_values: &const List[classes.ClassInfo] = &class_model.classes
    for class_info in class_values:
        if class_info.primary_base < 0:
            continue
        base: &const classes.ClassInfo = &class_values[
            cast[usize](class_info.primary_base)
        ]
        class_index = find_fact_by_owner_name(
            graph,
            &class_info.module_name,
            &class_info.name,
        )
        base_index = find_fact_by_owner_name(
            graph,
            &base.module_name,
            &base.name,
        )
        if class_index >= 0 and base_index >= 0:
            add_relation_unique(
                graph,
                "layout-base",
                &facts[cast[usize](class_index)].key,
                &facts[cast[usize](base_index)].key,
                "embedded",
                true,
            )


def collect_override_relations(
    graph: &SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    class_values: &const List[classes.ClassInfo] = &class_model.classes
    method_values: &const List[classes.ClassMethodInfo] = &class_model.methods
    class_index: usize = 0
    while class_index < len(class_values):
        class_info: &const classes.ClassInfo = &class_values[class_index]
        method_offset: i32 = 0
        while method_offset < class_info.method_count:
            method_index = class_info.first_method + method_offset
            method: &const classes.ClassMethodInfo = &method_values[
                cast[usize](method_index)
            ]
            if method.name != "__init__" and method.name != "__del__":
                method_owner = (
                    class_info.name[0:len(class_info.name)]
                    + "."
                    + method.name[0:len(method.name)]
                )
                method_fact_index = find_fact_by_owner_name(
                    graph,
                    &class_info.module_name,
                    &method_owner,
                )
                if method_fact_index >= 0:
                    base_offset: i32 = 0
                    while base_offset < class_info.base_count:
                        base: &const classes.ClassBaseInfo = &class_model.bases[
                            cast[usize](class_info.first_base + base_offset)
                        ]
                        if base.target >= 0:
                            base_method_index = classes.find_effective_method(
                                class_model,
                                base.target,
                                &method.name,
                            )
                            if (
                                base_method_index >= 0
                                and base_method_index != method_index
                            ):
                                base_method: &const classes.ClassMethodInfo = &method_values[
                                    cast[usize](base_method_index)
                                ]
                                base_owner: &const classes.ClassInfo = &class_values[
                                    cast[usize](base_method.owner)
                                ]
                                base_method_owner = (
                                    base_owner.name[0:len(base_owner.name)]
                                    + "."
                                    + base_method.name[0:len(base_method.name)]
                                )
                                base_fact_index = find_fact_by_owner_name(
                                    graph,
                                    &base_owner.module_name,
                                    &base_method_owner,
                                )
                                if base_fact_index >= 0:
                                    add_relation_unique(
                                        graph,
                                        "override",
                                        &facts[cast[usize](method_fact_index)].key,
                                        &facts[cast[usize](base_fact_index)].key,
                                        "",
                                        true,
                                    )
                        base_offset += 1
            method_offset += 1
        class_index += 1


def collect_semantic_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    module_index: usize = 0
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    while module_index < len(analyzed_modules):
        analyzed: &const emit_project.AnalyzedModule = &analyzed_modules[module_index]
        module: &const project.ParsedModule = &project_modules[analyzed.module_index]
        name_bindings: &const List[semantic.NodeSymbolBinding] = &analyzed.checked.model.name_symbols
        for binding: semantic.NodeSymbolBinding in name_bindings:
            source_index = enclosing_fact_index(graph, analyzed.module_index, binding.node, &module.arena)
            target_index = fact_index_for_symbol(graph, analyzed.module_index, binding.symbol.index)
            if source_index >= 0 and target_index >= 0 and source_index != target_index:
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](source_index)].key,
                    &facts[cast[usize](target_index)].key,
                    "",
                    true,
                )
            elif source_index >= 0 and target_index < 0:
                add_import_fact_use_relation(
                    &analyzed.checked,
                    graph,
                    module,
                    analyzed.module_index,
                    source_index,
                    binding.symbol.index,
                )
                collect_import_value_relation(
                    &analyzed.checked,
                    graph,
                    module,
                    source_index,
                    binding.symbol.index,
                )
        call_resolutions: &const List[semantic.CallResolution] = &analyzed.checked.model.call_resolutions
        for call: semantic.CallResolution in call_resolutions:
            source_index = enclosing_fact_index(graph, analyzed.module_index, call.node, &module.arena)
            target_index = fact_index_for_symbol(graph, analyzed.module_index, call.callee.index)
            if source_index >= 0 and target_index >= 0:
                add_relation_unique(
                    graph,
                    "calls",
                    &facts[cast[usize](source_index)].key,
                    &facts[cast[usize](target_index)].key,
                    "",
                    true,
                )
        module_index += 1


def collect_match_variant_case_use_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        arena: &const syntax.SyntaxArena = &module.arena
        nodes: &const List[syntax.SyntaxNode] = &arena.nodes
        children: &const List[NodeId] = &arena.children
        node_index: usize = 0
        while node_index < len(nodes):
            node = nodes[node_index]
            if node.kind == syntax.SyntaxKind.MATCH_STMT and node.child_count > 1:
                subject_id = children[node.first_child]
                subject_type = semantic_expression_type(
                    &analyzed.checked,
                    arena,
                    subject_id,
                )
                subject_nominal_index = nominal_fact_for_checked_type(
                    project_graph,
                    graph,
                    &analyzed.checked,
                    module,
                    module_index,
                    subject_type,
                )
                for offset in range(1, node.child_count):
                    case_id = children[node.first_child + offset]
                    case_node = nodes[case_id.index]
                    if (
                        case_node.kind == syntax.SyntaxKind.MATCH_CASE
                        and case_node.child_count > 0
                    ):
                        pattern_id = children[case_node.first_child]
                        collect_match_pattern_variant_case_use_relation(
                            project_graph,
                            graph,
                            module,
                            module_index,
                            pattern_id,
                            subject_nominal_index,
                        )
            node_index += 1


def collect_match_pattern_variant_case_use_relation(
    project_graph: &const project.ProjectGraph,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    module_index: usize,
    pattern_id: NodeId,
    subject_nominal_index: i32,
) -> void:
    if pattern_id.index < 0:
        return
    arena: &const syntax.SyntaxArena = &module.arena
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    pattern = nodes[pattern_id.index]
    if pattern.kind == syntax.SyntaxKind.PATTERN_WILDCARD:
        return
    if pattern.kind == syntax.SyntaxKind.PATTERN_CAPTURE:
        if pattern.child_count > 1:
            collect_match_pattern_variant_case_use_relation(
                project_graph,
                graph,
                module,
                module_index,
                children[pattern.first_child + 1],
                subject_nominal_index,
            )
        return
    if pattern.kind == syntax.SyntaxKind.PATTERN_OR:
        for offset in range(0, pattern.child_count):
            collect_match_pattern_variant_case_use_relation(
                project_graph,
                graph,
                module,
                module_index,
                children[pattern.first_child + offset],
                subject_nominal_index,
            )
        return
    if pattern.kind != syntax.SyntaxKind.PATTERN_PATH:
        return
    if pattern.flags == 1:
        if pattern.child_count > 0:
            collect_match_pattern_variant_case_use_relation(
                project_graph,
                graph,
                module,
                module_index,
                children[pattern.first_child],
                subject_nominal_index,
            )
        return
    name_count: i32 = 0
    while name_count < pattern.child_count:
        child_id = children[pattern.first_child + name_count]
        if nodes[child_id.index].kind != syntax.SyntaxKind.NAME:
            break
        name_count += 1
    if name_count <= 0:
        return
    case_id = children[pattern.first_child + name_count - 1]
    case_node = nodes[case_id.index]
    case_name = module.source[
        case_node.value_start:case_node.value_start + case_node.value_length
    ]
    is_binding = (
        pattern.child_count == 1
        and codegen_names.is_lowercase_start(&module.source, case_node.value_start)
    )
    is_builtin_case = (
        case_name == "Some"
        or case_name == "None"
        or case_name == "Ok"
        or case_name == "Err"
    )
    if not is_binding and not is_builtin_case:
        nominal_index = subject_nominal_index
        if name_count >= 2:
            owner_builder = StringBuilder()
            for offset in range(0, name_count - 1):
                if offset > 0:
                    owner_builder.append(".")
                owner_id = children[pattern.first_child + offset]
                owner_node = nodes[owner_id.index]
                owner_builder.append(
                    module.source[
                        owner_node.value_start:owner_node.value_start + owner_node.value_length
                    ]
                )
            owner_name = owner_builder.finish()
            nominal_index = resolve_type_fact(
                project_graph,
                graph,
                module_index,
                &owner_name,
            )
        target_index = variant_case_fact_for_nominal(
            graph,
            nominal_index,
            &case_name,
        )
        source_index = enclosing_fact_index(
            graph,
            module_index,
            pattern_id,
            arena,
        )
        facts: &const List[SymbolFact] = &graph.facts
        if (
            source_index >= 0
            and target_index >= 0
            and source_index != target_index
        ):
            add_relation_unique(
                graph,
                "uses",
                &facts[cast[usize](source_index)].key,
                &facts[cast[usize](target_index)].key,
                "",
                true,
            )
    for offset in range(name_count, pattern.child_count):
        collect_match_pattern_variant_case_use_relation(
            project_graph,
            graph,
            module,
            module_index,
            children[pattern.first_child + offset],
            -1,
        )


def collect_enum_member_use_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
        node_index: usize = 0
        while node_index < len(nodes):
            node = nodes[node_index]
            if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and node.child_count >= 2:
                attribute_id = NodeId(index=cast[i32](node_index))
                source_index = enclosing_fact_index(
                    graph,
                    module_index,
                    attribute_id,
                    &module.arena,
                )
                target_index = enum_member_fact_for_attribute(
                    graph,
                    &analyzed.checked,
                    module,
                    attribute_id,
                    module_index,
                )
                if target_index < 0:
                    target_index = variant_case_fact_for_attribute(
                        graph,
                        &analyzed.checked,
                        module,
                        attribute_id,
                        module_index,
                    )
                if (
                    source_index >= 0
                    and target_index >= 0
                    and source_index != target_index
                ):
                    add_relation_unique(
                        graph,
                        "uses",
                        &facts[cast[usize](source_index)].key,
                        &facts[cast[usize](target_index)].key,
                        "",
                        true,
                    )
            node_index += 1


def collect_nominal_field_use_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    class_model: &const classes.ProjectClassModel,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
        node_index: usize = 0
        while node_index < len(nodes):
            node = nodes[node_index]
            if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and node.child_count >= 2:
                attribute_id = NodeId(index=cast[i32](node_index))
                source_index = enclosing_fact_index(
                    graph,
                    module_index,
                    attribute_id,
                    &module.arena,
                )
                target_index = nominal_field_fact_for_attribute(
                    project_graph,
                    graph,
                    class_model,
                    &analyzed.checked,
                    module,
                    attribute_id,
                    module_index,
                    source_index,
                )
                if (
                    source_index >= 0
                    and target_index >= 0
                    and source_index != target_index
                ):
                    add_relation_unique(
                        graph,
                        "uses",
                        &facts[cast[usize](source_index)].key,
                        &facts[cast[usize](target_index)].key,
                        "",
                        true,
                    )
            node_index += 1


def nominal_field_fact_for_attribute(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    attribute_id: NodeId,
    module_index: usize,
    source_index: i32,
) -> i32:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    attribute = nodes[attribute_id.index]
    if attribute.child_count < 2:
        return -1
    receiver_id = children[attribute.first_child]
    member_id = children[attribute.first_child + 1]
    visited: List[i32] = []
    nominal_index = nominal_fact_for_expression(
        project_graph,
        graph,
        class_model,
        checked,
        module,
        receiver_id,
        module_index,
        source_index,
        visited,
    )
    if nominal_index < 0 and source_index >= 0:
        nominal_index = receiver_field_nominal_fact(
            project_graph,
            graph,
            class_model,
            module,
            receiver_id,
            source_index,
        )
    if nominal_index < 0:
        return -1
    member = nodes[member_id.index]
    member_name = module.source[
        member.value_start:member.value_start + member.value_length
    ]
    return field_fact_for_nominal(
        graph,
        class_model,
        nominal_index,
        &member_name,
    )


def field_fact_for_nominal(
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    nominal_index: i32,
    member_name: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if nominal_index < 0 or nominal_index >= cast[i32](len(facts)):
        return -1
    nominal: &const SymbolFact = &facts[cast[usize](nominal_index)]
    effective_index = find_effective_field_fact(
        graph,
        class_model,
        &nominal.module_name,
        &nominal.name,
        member_name,
    )
    if effective_index >= 0:
        return effective_index
    owner = nominal.name[0:len(nominal.name)]
    if len(nominal.owner) > 0:
        owner = nominal.owner[0:len(nominal.owner)] + "." + nominal.name[0:len(nominal.name)]
    field_kind = "field"
    field_key = stable_symbol_key(
        &nominal.module_name,
        &field_kind,
        &owner,
        member_name,
    )
    return find_fact_by_key(graph, &field_key)


def nominal_fact_for_expression(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    id: NodeId,
    module_index: usize,
    source_index: i32,
    visited: &List[i32],
) -> i32:
    if id.index < 0 or lock_order.contains_i32(visited, id.index):
        return -1
    visited.append(id.index)
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    node = nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_NAME:
        name = module.source[node.value_start:node.value_start + node.value_length]
        if name == "self" and source_index >= 0:
            facts: &const List[SymbolFact] = &graph.facts
            source: &const SymbolFact = &facts[cast[usize](source_index)]
            if len(source.owner) > 0:
                return find_fact_by_owner_name(
                    graph,
                    &source.module_name,
                    &source.owner,
                )
        symbol_index = bound_symbol_for_node(checked, id)
        resolved = declared_nominal_fact_for_symbol(
            project_graph,
            graph,
            checked,
            module,
            module_index,
            symbol_index,
        )
        if resolved >= 0:
            return resolved
        initializer = initializer_for_symbol(
            &module.arena,
            symbol_index,
            checked,
        )
        if initializer.index >= 0:
            return nominal_fact_for_expression(
                project_graph,
                graph,
                class_model,
                checked,
                module,
                initializer,
                module_index,
                source_index,
                visited,
            )
        return -1
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        target_index = fact_for_call_expression(
            graph,
            checked,
            module,
            id,
            module_index,
        )
        return nominal_fact_for_call_target(
            project_graph,
            graph,
            target_index,
        )
    if node.kind == syntax.SyntaxKind.EXPR_INDEX and node.child_count > 0:
        resolved = nominal_fact_for_checked_type(
            project_graph,
            graph,
            checked,
            module,
            module_index,
            semantic_expression_type(checked, &module.arena, id),
        )
        if resolved >= 0:
            return resolved
        return nominal_fact_for_expression(
            project_graph,
            graph,
            class_model,
            checked,
            module,
            children[node.first_child],
            module_index,
            source_index,
            visited,
        )
    if node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or node.child_count < 2:
        return nominal_fact_for_checked_type(
            project_graph,
            graph,
            checked,
            module,
            module_index,
            semantic_expression_type(checked, &module.arena, id),
        )
    receiver_id = children[node.first_child]
    member_id = children[node.first_child + 1]
    owner_index = nominal_fact_for_expression(
        project_graph,
        graph,
        class_model,
        checked,
        module,
        receiver_id,
        module_index,
        source_index,
        visited,
    )
    if owner_index < 0:
        return -1
    member = nodes[member_id.index]
    member_name = module.source[
        member.value_start:member.value_start + member.value_length
    ]
    field_index = field_fact_for_nominal(
        graph,
        class_model,
        owner_index,
        &member_name,
    )
    if field_index < 0:
        return -1
    field: &const SymbolFact = &graph.facts[cast[usize](field_index)]
    return resolve_type_fact(
        project_graph,
        graph,
        field.module_index,
        &field.type_name,
    )


def declared_nominal_fact_for_symbol(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    module_index: usize,
    symbol_index: i32,
) -> i32:
    symbols_list: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    if symbol_index < 0 or symbol_index >= cast[i32](len(symbols_list)):
        return -1
    declaration = symbols_list[cast[usize](symbol_index)].node
    type_id = codegen_type_names.find_child_type(&module.arena, declaration)
    nominal_type_id = nominal_name_type_node(&module.arena, type_id)
    return resolve_type_fact_from_node(
        project_graph,
        graph,
        module_index,
        &module.arena,
        &module.source,
        nominal_type_id,
    )


def nominal_name_type_node(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.TYPE_NAME:
        return id
    if (
        node.kind == syntax.SyntaxKind.TYPE_GENERIC
        or node.kind == syntax.SyntaxKind.TYPE_CONST
        or node.kind == syntax.SyntaxKind.TYPE_POINTER
        or node.kind == syntax.SyntaxKind.TYPE_REFERENCE
        or node.kind == syntax.SyntaxKind.TYPE_ARRAY
        or node.kind == syntax.SyntaxKind.TYPE_SLICE
        or node.kind == syntax.SyntaxKind.TYPE_DYN
    ) and node.child_count > 0:
        return nominal_name_type_node(
            arena,
            arena.children[node.first_child],
        )
    return syntax.missing_node()


def initializer_for_symbol(
    arena: &const syntax.SyntaxArena,
    symbol_index: i32,
    checked: &const checker_core.Checker,
) -> NodeId:
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    if symbol_index < 0 or symbol_index >= cast[i32](len(symbol_values)):
        return syntax.missing_node()
    declaration = symbol_values[cast[usize](symbol_index)].node
    if declaration.index < 0:
        return syntax.missing_node()
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    declaration_node = nodes[declaration.index]
    if (
        declaration_node.kind == syntax.SyntaxKind.VAR_DECL_STMT
        and declaration_node.child_count > 0
    ):
        return children[
            declaration_node.first_child + declaration_node.child_count - 1
        ]
    for candidate in nodes:
        if (
            candidate.kind == syntax.SyntaxKind.ASSIGN_STMT
            and candidate.child_count >= 2
            and children[candidate.first_child].index == declaration.index
        ):
            return children[candidate.first_child + 1]
    return syntax.missing_node()


def fact_for_call_expression(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    call_id: NodeId,
    module_index: usize,
) -> i32:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    call = nodes[call_id.index]
    if call.child_count <= 0:
        return -1
    callee_id = children[call.first_child]
    callee = nodes[callee_id.index]
    if callee.kind == syntax.SyntaxKind.EXPR_NAME:
        symbol_index = bound_symbol_for_node(checked, callee_id)
        local_index = fact_index_for_symbol(graph, module_index, symbol_index)
        if local_index >= 0:
            return local_index
        callee_name = module.source[
            callee.value_start:callee.value_start + callee.value_length
        ]
        if symbol_is_import_binding(
            checked,
            &module.arena,
            symbol_index,
            true,
        ):
            module_imports: &const List[project.ImportBinding] = &module.imports
            for imported in module_imports:
                if len(imported.member) > 0 and imported.alias == callee_name:
                    return find_top_level_fact_by_module_name(
                        graph,
                        &imported.module_name,
                        &imported.member,
                    )
        return -1
    if callee.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or callee.child_count < 2:
        return -1
    receiver_id = children[callee.first_child]
    member_id = children[callee.first_child + 1]
    receiver = nodes[receiver_id.index]
    member = nodes[member_id.index]
    if receiver.kind != syntax.SyntaxKind.EXPR_NAME:
        return -1
    symbol_index = bound_symbol_for_node(checked, receiver_id)
    if not symbol_is_import_binding(
        checked,
        &module.arena,
        symbol_index,
        false,
    ):
        return -1
    receiver_name = module.source[
        receiver.value_start:receiver.value_start + receiver.value_length
    ]
    member_name = module.source[
        member.value_start:member.value_start + member.value_length
    ]
    module_imports: &const List[project.ImportBinding] = &module.imports
    for imported in module_imports:
        if len(imported.member) == 0 and imported.alias == receiver_name:
            return find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &member_name,
            )
    return -1


def nominal_fact_for_call_target(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    target_index: i32,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if target_index < 0 or target_index >= cast[i32](len(facts)):
        return -1
    target: &const SymbolFact = &facts[cast[usize](target_index)]
    if fact_kind_is_nominal_constructor(&target.kind):
        return target_index
    if (
        not fact_kind_is_callable(&target.kind)
        and target.kind != "method"
    ):
        return -1
    return resolve_type_fact(
        project_graph,
        graph,
        target.module_index,
        &target.type_name,
    )


def enum_member_fact_for_attribute(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    attribute_id: NodeId,
    module_index: usize,
) -> i32:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    attribute = nodes[attribute_id.index]
    if attribute.child_count < 2:
        return -1
    receiver_id = children[attribute.first_child]
    member_id = children[attribute.first_child + 1]
    enum_index = enum_fact_for_value_receiver(
        graph,
        checked,
        module,
        receiver_id,
        module_index,
    )
    member = nodes[member_id.index]
    member_name = module.source[
        member.value_start:member.value_start + member.value_length
    ]
    return enum_member_fact_for_enum(graph, enum_index, &member_name)


def variant_case_fact_for_attribute(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    attribute_id: NodeId,
    module_index: usize,
) -> i32:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    attribute = nodes[attribute_id.index]
    if attribute.child_count < 2:
        return -1
    receiver_id = children[attribute.first_child]
    member_id = children[attribute.first_child + 1]
    variant_kind = "variant"
    variant_index = nominal_fact_for_value_receiver_kind(
        graph,
        checked,
        module,
        receiver_id,
        module_index,
        &variant_kind,
    )
    member = nodes[member_id.index]
    member_name = module.source[
        member.value_start:member.value_start + member.value_length
    ]
    return variant_case_fact_for_nominal(graph, variant_index, &member_name)


def enum_member_fact_for_enum(
    graph: &const SemanticFactGraph,
    enum_index: i32,
    member_name: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if enum_index < 0 or enum_index >= cast[i32](len(facts)):
        return -1
    enum_fact: &const SymbolFact = &facts[cast[usize](enum_index)]
    member_owner = enum_fact.name[0:len(enum_fact.name)]
    if len(enum_fact.owner) > 0:
        member_owner = enum_fact.owner[0:len(enum_fact.owner)] + "." + enum_fact.name[0:len(enum_fact.name)]
    member_kind = "enum-member"
    member_key = stable_symbol_key(
        &enum_fact.module_name,
        &member_kind,
        &member_owner,
        member_name,
    )
    return find_fact_by_key(graph, &member_key)


def variant_case_fact_for_nominal(
    graph: &const SemanticFactGraph,
    nominal_index: i32,
    member_name: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if nominal_index < 0 or nominal_index >= cast[i32](len(facts)):
        return -1
    nominal: &const SymbolFact = &facts[cast[usize](nominal_index)]
    if nominal.kind != "variant":
        return -1
    member_owner = nominal.name[0:len(nominal.name)]
    if len(nominal.owner) > 0:
        member_owner = nominal.owner[0:len(nominal.owner)] + "." + nominal.name[0:len(nominal.name)]
    member_kind = "variant-case"
    member_key = stable_symbol_key(
        &nominal.module_name,
        &member_kind,
        &member_owner,
        member_name,
    )
    return find_fact_by_key(graph, &member_key)


def enum_fact_for_name_symbol(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    module_index: usize,
    symbol_index: i32,
    receiver_name: &const String,
) -> i32:
    expected_kind = "enum"
    return nominal_fact_for_name_symbol_kind(
        graph,
        checked,
        module,
        module_index,
        symbol_index,
        receiver_name,
        &expected_kind,
    )


def nominal_fact_for_name_symbol_kind(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    module_index: usize,
    symbol_index: i32,
    receiver_name: &const String,
    expected_kind: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    local_index = fact_index_for_symbol(graph, module_index, symbol_index)
    if (
        local_index >= 0
        and facts[cast[usize](local_index)].kind == expected_kind
    ):
        return local_index
    if not symbol_is_import_binding(
        checked,
        &module.arena,
        symbol_index,
        true,
    ):
        return -1
    module_imports: &const List[project.ImportBinding] = &module.imports
    for imported in module_imports:
        if len(imported.member) > 0 and imported.alias == receiver_name:
            imported_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &imported.member,
            )
            if (
                imported_index >= 0
                and facts[cast[usize](imported_index)].kind == expected_kind
            ):
                return imported_index
    return -1


def enum_fact_for_value_receiver(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    receiver_id: NodeId,
    module_index: usize,
) -> i32:
    expected_kind = "enum"
    return nominal_fact_for_value_receiver_kind(
        graph,
        checked,
        module,
        receiver_id,
        module_index,
        &expected_kind,
    )


def nominal_fact_for_value_receiver_kind(
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    receiver_id: NodeId,
    module_index: usize,
    expected_kind: &const String,
) -> i32:
    if receiver_id.index < 0:
        return -1
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    facts: &const List[SymbolFact] = &graph.facts
    receiver = nodes[receiver_id.index]
    if receiver.kind == syntax.SyntaxKind.EXPR_NAME:
        bound_symbol = bound_symbol_for_node(checked, receiver_id)
        receiver_name = module.source[
            receiver.value_start:receiver.value_start + receiver.value_length
        ]
        return nominal_fact_for_name_symbol_kind(
            graph,
            checked,
            module,
            module_index,
            bound_symbol,
            &receiver_name,
            expected_kind,
        )
    if receiver.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or receiver.child_count < 2:
        return -1
    module_id = children[receiver.first_child]
    enum_id = children[receiver.first_child + 1]
    module_node = nodes[module_id.index]
    enum_node = nodes[enum_id.index]
    if module_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return -1
    bound_module = bound_symbol_for_node(checked, module_id)
    if not symbol_is_import_binding(
        checked,
        &module.arena,
        bound_module,
        false,
    ):
        return -1
    module_alias = module.source[
        module_node.value_start:module_node.value_start + module_node.value_length
    ]
    enum_name = module.source[
        enum_node.value_start:enum_node.value_start + enum_node.value_length
    ]
    module_imports: &const List[project.ImportBinding] = &module.imports
    for imported in module_imports:
        if len(imported.member) == 0 and imported.alias == module_alias:
            imported_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &enum_name,
            )
            if (
                imported_index >= 0
                and facts[cast[usize](imported_index)].kind == expected_kind
            ):
                return imported_index
    return -1


def imported_nominal_fact_for_attribute_source(
    graph: &const SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    source: &const String,
    attribute_id: NodeId,
    expected_kind: &const String,
) -> i32:
    if attribute_id.index < 0:
        return -1
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    attribute = nodes[attribute_id.index]
    if attribute.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or attribute.child_count < 2:
        return -1
    module_id = children[attribute.first_child]
    nominal_id = children[attribute.first_child + 1]
    module_node = nodes[module_id.index]
    nominal_node = nodes[nominal_id.index]
    if module_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return -1
    module_alias = source[
        module_node.value_start:module_node.value_start + module_node.value_length
    ]
    nominal_name = source[
        nominal_node.value_start:nominal_node.value_start + nominal_node.value_length
    ]
    facts: &const List[SymbolFact] = &graph.facts
    module_imports: &const List[project.ImportBinding] = &module.imports
    for imported in module_imports:
        if len(imported.member) == 0 and imported.alias == module_alias:
            nominal_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &nominal_name,
            )
            if (
                nominal_index >= 0
                and facts[cast[usize](nominal_index)].kind == expected_kind
            ):
                return nominal_index
    return -1


def collect_import_value_relation(
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    source_index: i32,
    symbol_index: i32,
) -> void:
    if not symbol_is_import_binding(checked, &module.arena, symbol_index, true):
        return
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    symbol: &const symbols.SymbolRecord = &symbol_values[cast[usize](symbol_index)]
    alias = module.source[symbol.name_start:symbol.name_start + symbol.name_length]
    module_imports: &const List[project.ImportBinding] = &module.imports
    facts: &const List[SymbolFact] = &graph.facts
    for imported in module_imports:
        if len(imported.member) > 0 and imported.alias == alias:
            target_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &imported.member,
            )
            if target_index >= 0:
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](source_index)].key,
                    &facts[cast[usize](target_index)].key,
                    "",
                    true,
                )
            else:
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](source_index)].key,
                    &imported.module_name,
                    &imported.member,
                    false,
                )
            return


def collect_import_value_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        fact_index: usize = 0
        while fact_index < len(facts):
            fact: &const SymbolFact = &facts[fact_index]
            if (
                fact.module_index == module_index
                and (
                    fact.kind == "function"
                    or fact.kind == "function-template"
                    or fact.kind == "method"
                    or fact.kind == "global"
                    or fact.kind == "constant"
                    or fact.kind == "static-assert"
                )
            ):
                collect_import_values_in_node(
                    &analyzed.checked,
                    graph,
                    module,
                    fact.node,
                    cast[i32](fact_index),
                    false,
                )
            fact_index += 1


def collect_import_values_in_node(
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    id: NodeId,
    source_index: i32,
    skip_attribute: bool,
) -> void:
    if id.index < 0:
        return
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    node = nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and not skip_attribute:
        collect_import_attribute_value_relation(
            checked,
            graph,
            module,
            id,
            source_index,
        )
    for offset in range(0, node.child_count):
        child_id = children[node.first_child + offset]
        child = nodes[child_id.index]
        child_is_callee_attribute = (
            node.kind == syntax.SyntaxKind.EXPR_CALL
            and offset == 0
            and child.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE
        )
        collect_import_values_in_node(
            checked,
            graph,
            module,
            child_id,
            source_index,
            child_is_callee_attribute,
        )


def collect_import_attribute_value_relation(
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    attribute_id: NodeId,
    source_index: i32,
) -> void:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    attribute = nodes[attribute_id.index]
    if attribute.child_count < 2:
        return
    receiver_id = children[attribute.first_child]
    member_id = children[attribute.first_child + 1]
    receiver = nodes[receiver_id.index]
    member = nodes[member_id.index]
    if receiver.kind != syntax.SyntaxKind.EXPR_NAME:
        return
    bound_symbol = bound_symbol_for_node(checked, receiver_id)
    if not symbol_is_import_binding(checked, &module.arena, bound_symbol, false):
        return
    receiver_name = module.source[
        receiver.value_start:receiver.value_start + receiver.value_length
    ]
    member_name = module.source[member.value_start:member.value_start + member.value_length]
    module_imports: &const List[project.ImportBinding] = &module.imports
    facts: &const List[SymbolFact] = &graph.facts
    for imported in module_imports:
        if len(imported.member) == 0 and imported.alias == receiver_name:
            target_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &member_name,
            )
            if target_index >= 0:
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](source_index)].key,
                    &facts[cast[usize](target_index)].key,
                    "",
                    true,
                )
            else:
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](source_index)].key,
                    &imported.module_name,
                    &member_name,
                    false,
                )
            return


def collect_import_call_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    class_model: &const classes.ProjectClassModel,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        fact_index: usize = 0
        while fact_index < len(facts):
            fact: &const SymbolFact = &facts[fact_index]
            if (
                fact.module_index == module_index
                and (
                    fact.kind == "function"
                    or fact.kind == "function-template"
                    or fact.kind == "method"
                    or fact.kind == "global"
                    or fact.kind == "constant"
                )
            ):
                receiver_bindings: List[lock_order.MethodReceiverBinding] = []
                collect_import_calls_in_node(
                    project_graph,
                    class_model,
                    &analyzed.checked,
                    graph,
                    module,
                    fact.node,
                    cast[i32](fact_index),
                    &receiver_bindings,
                )
            fact_index += 1


def collect_import_calls_in_node(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    id: NodeId,
    caller_index: i32,
    receiver_bindings: &List[lock_order.MethodReceiverBinding],
) -> void:
    if id.index < 0:
        return
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    node = nodes[id.index]
    if node.kind == syntax.SyntaxKind.BLOCK:
        binding_count = len(receiver_bindings)
        for offset in range(0, node.child_count):
            collect_import_calls_in_node(
                project_graph,
                class_model,
                checked,
                graph,
                module,
                children[node.first_child + offset],
                caller_index,
                receiver_bindings,
            )
        while len(receiver_bindings) > binding_count:
            receiver_bindings.pop()
        return
    lock_order.record_method_receiver_binding(
        &module.name,
        &module.imports,
        &module.arena,
        id,
        &module.source,
        receiver_bindings,
    )
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        collect_import_call_relation(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            id,
            caller_index,
            receiver_bindings,
        )
    elif node.kind == syntax.SyntaxKind.EXPR_FSTRING:
        collect_fstring_relations(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            &module.arena,
            id,
            &module.source,
            caller_index,
            enclosing_scope_for_node(checked, &module.arena, id),
            receiver_bindings,
        )
    for offset in range(0, node.child_count):
        collect_import_calls_in_node(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            children[node.first_child + offset],
            caller_index,
            receiver_bindings,
        )


def collect_fstring_relations(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    fstring_id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
    receiver_bindings: &const List[lock_order.MethodReceiverBinding],
) -> void:
    if fstring_id.index < 0:
        return
    node = arena.nodes[fstring_id.index]
    if node.value_length < 3:
        return
    content_start = node.value_start + 2
    content_end = node.value_start + node.value_length - 1
    index = content_start
    while index < content_end:
        byte = source.byte_at(index)
        if byte == 92:
            if index + 1 < content_end:
                index += 2
            else:
                index += 1
            continue
        if byte == 123:
            if index + 1 < content_end and source.byte_at(index + 1) == 123:
                index += 2
                continue
            field = codegen_model.scan_fstring_field(source, index + 1, content_end)
            if not field.valid:
                return
            expression_start = codegen_model.trim_left(source, index + 1, field.expression_end)
            expression_end = codegen_model.trim_right(source, expression_start, field.expression_end)
            if expression_end > expression_start:
                expression_source = source[expression_start:expression_end]
                scan = lexer.new_lexer(expression_source)
                scan.tokenize()
                parsed = parser.new_parser(&scan)
                expression = parsed.parse_expression(0)
                if len(scan.diagnostics) == 0 and len(parsed.diagnostics) == 0 and expression.index >= 0:
                    collect_reparsed_relations_in_node(
                        project_graph,
                        class_model,
                        checked,
                        graph,
                        module,
                        &parsed.arena,
                        expression,
                        &scan.source,
                        caller_index,
                        current_scope,
                        receiver_bindings,
                        false,
                    )
            index = field.close + 1
            continue
        index += 1


def collect_reparsed_relations_in_node(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
    receiver_bindings: &const List[lock_order.MethodReceiverBinding],
    skip_value: bool,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        collect_reparsed_call_relation(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            arena,
            id,
            source,
            caller_index,
            current_scope,
            receiver_bindings,
        )
    elif node.kind == syntax.SyntaxKind.EXPR_FSTRING:
        collect_fstring_relations(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            arena,
            id,
            source,
            caller_index,
            current_scope,
            receiver_bindings,
        )
        return
    if not skip_value:
        if node.kind == syntax.SyntaxKind.EXPR_NAME:
            collect_reparsed_name_value_relation(
                checked,
                graph,
                module,
                arena,
                id,
                source,
                caller_index,
                current_scope,
            )
        elif node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
            collect_reparsed_attribute_value_relation(
                project_graph,
                class_model,
                checked,
                graph,
                module,
                arena,
                id,
                source,
                caller_index,
                current_scope,
            )
    for offset in range(0, node.child_count):
        child_skip_value = (
            (node.kind == syntax.SyntaxKind.EXPR_CALL and offset == 0)
            or (node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and offset > 0)
        )
        collect_reparsed_relations_in_node(
            project_graph,
            class_model,
            checked,
            graph,
            module,
            arena,
            arena.children[node.first_child + offset],
            source,
            caller_index,
            current_scope,
            receiver_bindings,
            child_skip_value,
        )


def collect_reparsed_name_value_relation(
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    name_id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
) -> void:
    name_node = arena.nodes[name_id.index]
    name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    found = checked.symbols.find_name_in_scope(&module.source, current_scope, &name)
    if found.index < 0:
        return
    facts: &const List[SymbolFact] = &graph.facts
    caller: &const SymbolFact = &facts[cast[usize](caller_index)]
    target_index = fact_index_for_symbol(graph, caller.module_index, found.index)
    if target_index >= 0 and target_index != caller_index:
        add_relation_unique(
            graph,
            "uses",
            &caller.key,
            &facts[cast[usize](target_index)].key,
            "",
            true,
        )
        return
    if target_index < 0:
        add_import_fact_use_relation(
            checked,
            graph,
            module,
            caller.module_index,
            caller_index,
            found.index,
        )
        collect_import_value_relation(
            checked,
            graph,
            module,
            caller_index,
            found.index,
        )


def collect_reparsed_attribute_value_relation(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    attribute_id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
) -> void:
    attribute = arena.nodes[attribute_id.index]
    if attribute.child_count < 2:
        return
    receiver_id = arena.children[attribute.first_child]
    member_id = arena.children[attribute.first_child + 1]
    receiver = arena.nodes[receiver_id.index]
    member = arena.nodes[member_id.index]
    member_name = source[member.value_start:member.value_start + member.value_length]
    module_imports: &const List[project.ImportBinding] = &module.imports
    facts: &const List[SymbolFact] = &graph.facts
    if receiver.kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_name = source[
            receiver.value_start:receiver.value_start + receiver.value_length
        ]
        found = checked.symbols.find_name_in_scope(
            &module.source,
            current_scope,
            &receiver_name,
        )
        if symbol_is_import_binding(checked, &module.arena, found.index, false):
            add_import_fact_use_relation(
                checked,
                graph,
                module,
                facts[cast[usize](caller_index)].module_index,
                caller_index,
                found.index,
            )
            for imported in module_imports:
                if len(imported.member) == 0 and imported.alias == receiver_name:
                    target_index = find_top_level_fact_by_module_name(
                        graph,
                        &imported.module_name,
                        &member_name,
                    )
                    if target_index >= 0:
                        add_relation_unique(
                            graph,
                            "uses",
                            &facts[cast[usize](caller_index)].key,
                            &facts[cast[usize](target_index)].key,
                            "",
                            true,
                        )
                    else:
                        add_relation_unique(
                            graph,
                            "uses",
                            &facts[cast[usize](caller_index)].key,
                            &imported.module_name,
                            &member_name,
                            false,
                        )
                    return
            return
        enum_index = enum_fact_for_name_symbol(
            graph,
            checked,
            module,
            facts[cast[usize](caller_index)].module_index,
            found.index,
            &receiver_name,
        )
        target_index = enum_member_fact_for_enum(graph, enum_index, &member_name)
        if target_index >= 0:
            add_relation_unique(
                graph,
                "uses",
                &facts[cast[usize](caller_index)].key,
                &facts[cast[usize](target_index)].key,
                "",
                true,
            )
            return
    nominal_fact_index = nominal_fact_for_reparsed_expression(
        project_graph,
        graph,
        class_model,
        checked,
        module,
        arena,
        receiver_id,
        source,
        caller_index,
        current_scope,
    )
    if nominal_fact_index < 0:
        return
    target_index = variant_case_fact_for_nominal(
        graph,
        nominal_fact_index,
        &member_name,
    )
    if target_index < 0:
        target_index = field_fact_for_nominal(
            graph,
            class_model,
            nominal_fact_index,
            &member_name,
        )
    if target_index >= 0:
        add_relation_unique(
            graph,
            "uses",
            &facts[cast[usize](caller_index)].key,
            &facts[cast[usize](target_index)].key,
            "",
            true,
        )


def nominal_fact_for_reparsed_expression(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    facts: &const List[SymbolFact] = &graph.facts
    module_index = facts[cast[usize](caller_index)].module_index
    if node.kind == syntax.SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        found = checked.symbols.find_name_in_scope(
            &module.source,
            current_scope,
            &name,
        )
        nominal_fact_index = declared_nominal_fact_for_symbol(
            project_graph,
            graph,
            checked,
            module,
            module_index,
            found.index,
        )
        if nominal_fact_index < 0:
            nominal_fact_index = nominal_fact_for_typed_symbol(
                project_graph,
                graph,
                checked,
                module,
                module_index,
                found.index,
            )
        if nominal_fact_index >= 0:
            return nominal_fact_index
        return receiver_field_nominal_fact_in_source(
            project_graph,
            graph,
            class_model,
            module,
            arena,
            id,
            source,
            caller_index,
        )
    if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        imported_index = imported_reparsed_nominal_fact(
            graph,
            module,
            arena,
            id,
            source,
        )
        if imported_index >= 0:
            return imported_index
        field_index = field_fact_for_reparsed_attribute(
            project_graph,
            graph,
            class_model,
            checked,
            module,
            arena,
            id,
            source,
            caller_index,
            current_scope,
        )
        return nominal_fact_for_fact_type(
            project_graph,
            graph,
            field_index,
        )
    if node.kind == syntax.SyntaxKind.EXPR_INDEX:
        checked_type = reparsed_expression_checked_type(
            checked,
            module,
            arena,
            id,
            source,
            current_scope,
        )
        nominal_fact_index = nominal_fact_for_checked_type(
            project_graph,
            graph,
            checked,
            module,
            module_index,
            checked_type,
        )
        if nominal_fact_index >= 0:
            return nominal_fact_index
        if node.child_count <= 0:
            return -1
        receiver_id = arena.children[node.first_child]
        receiver = arena.nodes[receiver_id.index]
        if receiver.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE:
            return -1
        field_index = field_fact_for_reparsed_attribute(
            project_graph,
            graph,
            class_model,
            checked,
            module,
            arena,
            receiver_id,
            source,
            caller_index,
            current_scope,
        )
        return nominal_fact_for_indexed_fact_type(
            project_graph,
            graph,
            field_index,
        )
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        return nominal_fact_for_reparsed_call(
            project_graph,
            graph,
            class_model,
            checked,
            module,
            arena,
            id,
            source,
            caller_index,
            current_scope,
        )
    if (
        node.kind == syntax.SyntaxKind.EXPR_UNARY
        or node.kind == syntax.SyntaxKind.EXPR_PROPAGATE
    ) and node.child_count > 0:
        return nominal_fact_for_reparsed_expression(
            project_graph,
            graph,
            class_model,
            checked,
            module,
            arena,
            arena.children[node.first_child],
            source,
            caller_index,
            current_scope,
        )
    if node.kind == syntax.SyntaxKind.EXPR_CAST:
        type_id = codegen_type_names.find_child_type(arena, id)
        nominal_type_id = nominal_name_type_node(arena, type_id)
        return resolve_type_fact_from_node(
            project_graph,
            graph,
            module_index,
            arena,
            source,
            nominal_type_id,
        )
    return -1


def field_fact_for_reparsed_attribute(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or node.child_count < 2:
        return -1
    receiver_id = arena.children[node.first_child]
    member_id = arena.children[node.first_child + 1]
    owner_index = nominal_fact_for_reparsed_expression(
        project_graph,
        graph,
        class_model,
        checked,
        module,
        arena,
        receiver_id,
        source,
        caller_index,
        current_scope,
    )
    if owner_index < 0:
        return -1
    member = arena.nodes[member_id.index]
    member_name = source[member.value_start:member.value_start + member.value_length]
    return field_fact_for_nominal(
        graph,
        class_model,
        owner_index,
        &member_name,
    )


def imported_reparsed_nominal_fact(
    graph: &const SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or node.child_count < 2:
        return -1
    module_id = arena.children[node.first_child]
    nominal_id = arena.children[node.first_child + 1]
    module_node = arena.nodes[module_id.index]
    nominal_node = arena.nodes[nominal_id.index]
    if module_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return -1
    module_alias = source[
        module_node.value_start:module_node.value_start + module_node.value_length
    ]
    nominal_name = source[
        nominal_node.value_start:nominal_node.value_start + nominal_node.value_length
    ]
    facts: &const List[SymbolFact] = &graph.facts
    module_imports: &const List[project.ImportBinding] = &module.imports
    for imported in module_imports:
        if len(imported.member) == 0 and imported.alias == module_alias:
            target_index = find_top_level_fact_by_module_name(
                graph,
                &imported.module_name,
                &nominal_name,
            )
            if (
                target_index >= 0
                and fact_kind_is_nominal_constructor(
                    &facts[cast[usize](target_index)].kind
                )
            ):
                return target_index
    return -1


def nominal_fact_for_fact_type(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    fact_index: i32,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if fact_index < 0 or fact_index >= cast[i32](len(facts)):
        return -1
    fact: &const SymbolFact = &facts[cast[usize](fact_index)]
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    fact_module: &const project.ParsedModule = &project_modules[fact.module_index]
    type_id = codegen_type_names.find_child_type(&fact_module.arena, fact.node)
    nominal_type_id = nominal_name_type_node(&fact_module.arena, type_id)
    return resolve_type_fact_from_node(
        project_graph,
        graph,
        fact.module_index,
        &fact_module.arena,
        &fact_module.source,
        nominal_type_id,
    )


def reparsed_expression_checked_type(
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> types.TypeId:
    if id.index < 0:
        return types.missing_type()
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        found = checked.symbols.find_name_in_scope(
            &module.source,
            current_scope,
            &name,
        )
        if found.index >= 0:
            return checked.symbols.symbols[cast[usize](found.index)].type_id
        return types.missing_type()
    if node.kind == syntax.SyntaxKind.EXPR_INDEX and node.child_count > 0:
        receiver_type = reparsed_expression_checked_type(
            checked,
            module,
            arena,
            arena.children[node.first_child],
            source,
            current_scope,
        )
        return indexed_reparsed_checked_type(
            &checked.type_table,
            arena,
            id,
            source,
            receiver_type,
        )
    if (
        node.kind == syntax.SyntaxKind.EXPR_UNARY
        or node.kind == syntax.SyntaxKind.EXPR_PROPAGATE
    ) and node.child_count > 0:
        return reparsed_expression_checked_type(
            checked,
            module,
            arena,
            arena.children[node.first_child],
            source,
            current_scope,
        )
    return types.missing_type()


def indexed_reparsed_checked_type(
    table: &const types.TypeTable,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_type: types.TypeId,
) -> types.TypeId:
    value_type = analysis_value_type(table, receiver_type)
    if value_type.index < 0 or value_type.index >= cast[i32](len(table.types)):
        return types.missing_type()
    record = table.types[value_type.index]
    if (
        record.kind == types.TypeKind.LIST
        or record.kind == types.TypeKind.ARRAY
        or record.kind == types.TypeKind.SLICE
    ):
        return record.inner
    if record.kind == types.TypeKind.MAP:
        return record.second
    if record.kind != types.TypeKind.TUPLE:
        return types.missing_type()
    node = arena.nodes[id.index]
    if node.child_count < 2:
        return types.missing_type()
    index_id = arena.children[node.first_child + 1]
    index_node = arena.nodes[index_id.index]
    if index_node.kind != syntax.SyntaxKind.EXPR_LITERAL:
        return types.missing_type()
    offset = reparsed_decimal_index(
        source,
        index_node.value_start,
        index_node.value_length,
    )
    if offset < 0 or offset >= record.flags:
        return types.missing_type()
    return table.type_args[cast[usize](record.extra + offset)]


def reparsed_decimal_index(
    source: &const String,
    start: usize,
    length: usize,
) -> i32:
    result: i32 = 0
    for offset in range(0, length):
        byte = source.byte_at(start + offset)
        if byte < 48 or byte > 57:
            return -1
        result = result * 10 + cast[i32](byte - 48)
    return result


def nominal_fact_for_indexed_fact_type(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    fact_index: i32,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    if fact_index < 0 or fact_index >= cast[i32](len(facts)):
        return -1
    fact: &const SymbolFact = &facts[cast[usize](fact_index)]
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    fact_module: &const project.ParsedModule = &project_modules[fact.module_index]
    type_id = codegen_type_names.find_child_type(&fact_module.arena, fact.node)
    element_type_id = indexed_type_element_node(
        &fact_module.arena,
        type_id,
        &fact_module.source,
    )
    nominal_type_id = nominal_name_type_node(
        &fact_module.arena,
        element_type_id,
    )
    return resolve_type_fact_from_node(
        project_graph,
        graph,
        fact.module_index,
        &fact_module.arena,
        &fact_module.source,
        nominal_type_id,
    )


def indexed_type_element_node(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if (
        node.kind == syntax.SyntaxKind.TYPE_CONST
        or node.kind == syntax.SyntaxKind.TYPE_POINTER
        or node.kind == syntax.SyntaxKind.TYPE_REFERENCE
    ) and node.child_count > 0:
        return indexed_type_element_node(
            arena,
            arena.children[node.first_child],
            source,
        )
    if (
        node.kind == syntax.SyntaxKind.TYPE_ARRAY
        or node.kind == syntax.SyntaxKind.TYPE_SLICE
    ) and node.child_count > 0:
        return arena.children[node.first_child]
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count < 2:
        return syntax.missing_node()
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    if (
        codegen_names.range_text_equals(
            source,
            base.value_start,
            base.value_length,
            "List",
        )
        or codegen_names.range_text_equals(
            source,
            base.value_start,
            base.value_length,
            "Slice",
        )
    ):
        return arena.children[node.first_child + 1]
    if (
        codegen_names.range_text_equals(
            source,
            base.value_start,
            base.value_length,
            "Map",
        )
        and node.child_count > 2
    ):
        return arena.children[node.first_child + 2]
    return syntax.missing_node()


def nominal_fact_for_reparsed_call(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
) -> i32:
    call = arena.nodes[id.index]
    if call.child_count <= 0:
        return -1
    callee_id = arena.children[call.first_child]
    callee = arena.nodes[callee_id.index]
    facts: &const List[SymbolFact] = &graph.facts
    module_imports: &const List[project.ImportBinding] = &module.imports
    module_index = facts[cast[usize](caller_index)].module_index
    if callee.kind == syntax.SyntaxKind.EXPR_NAME:
        callee_name = source[
            callee.value_start:callee.value_start + callee.value_length
        ]
        found = checked.symbols.find_name_in_scope(
            &module.source,
            current_scope,
            &callee_name,
        )
        target_index = fact_index_for_symbol(
            graph,
            module_index,
            found.index,
        )
        if target_index < 0 and symbol_is_import_binding(
            checked,
            &module.arena,
            found.index,
            true,
        ):
            for imported in module_imports:
                if len(imported.member) > 0 and imported.alias == callee_name:
                    target_index = find_top_level_fact_by_module_name(
                        graph,
                        &imported.module_name,
                        &imported.member,
                    )
                    break
        return nominal_fact_for_call_target(
            project_graph,
            graph,
            target_index,
        )
    if callee.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or callee.child_count < 2:
        return -1
    receiver_id = arena.children[callee.first_child]
    member_id = arena.children[callee.first_child + 1]
    receiver = arena.nodes[receiver_id.index]
    member = arena.nodes[member_id.index]
    member_name = source[member.value_start:member.value_start + member.value_length]
    if receiver.kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_name = source[
            receiver.value_start:receiver.value_start + receiver.value_length
        ]
        found = checked.symbols.find_name_in_scope(
            &module.source,
            current_scope,
            &receiver_name,
        )
        if symbol_is_import_binding(
            checked,
            &module.arena,
            found.index,
            false,
        ):
            for imported in module_imports:
                if len(imported.member) == 0 and imported.alias == receiver_name:
                    target_index = find_top_level_fact_by_module_name(
                        graph,
                        &imported.module_name,
                        &member_name,
                    )
                    return nominal_fact_for_call_target(
                        project_graph,
                        graph,
                        target_index,
                    )
    nominal_index = nominal_fact_for_reparsed_expression(
        project_graph,
        graph,
        class_model,
        checked,
        module,
        arena,
        receiver_id,
        source,
        caller_index,
        current_scope,
    )
    if nominal_index < 0:
        return -1
    nominal: &const SymbolFact = &facts[cast[usize](nominal_index)]
    target_index = find_effective_method_fact(
        graph,
        class_model,
        &nominal.module_name,
        &nominal.name,
        &member_name,
    )
    if target_index < 0:
        owner_method = nominal.name[0:len(nominal.name)] + "." + member_name[0:len(member_name)]
        target_index = find_fact_by_owner_name(
            graph,
            &nominal.module_name,
            &owner_method,
        )
    return nominal_fact_for_call_target(
        project_graph,
        graph,
        target_index,
    )


def nominal_fact_for_checked_type(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    module_index: usize,
    type_id: types.TypeId,
) -> i32:
    receiver_type = analysis_value_type(
        &checked.type_table,
        type_id,
    )
    if (
        receiver_type.index < 0
        or receiver_type.index >= cast[i32](len(checked.type_table.types))
    ):
        return -1
    receiver_record = checked.type_table.types[receiver_type.index]
    if (
        not types.is_nominal_kind(receiver_record.kind)
        or receiver_record.name_length <= 0
    ):
        return -1
    type_builder = StringBuilder()
    codegen_type_names.emit_semantic_readable_type_name(
        &checked.type_table,
        receiver_type,
        &module.source,
        &type_builder,
    )
    type_name = type_builder.finish()
    return resolve_type_fact(
        project_graph,
        graph,
        module_index,
        &type_name,
    )


def nominal_fact_for_typed_symbol(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    checked: &const checker_core.Checker,
    module: &const project.ParsedModule,
    module_index: usize,
    symbol_index: i32,
) -> i32:
    if (
        symbol_index < 0
        or symbol_index >= cast[i32](len(checked.symbols.symbols))
    ):
        return -1
    return nominal_fact_for_checked_type(
        project_graph,
        graph,
        checked,
        module,
        module_index,
        checked.symbols.symbols[symbol_index].type_id,
    )


def collect_reparsed_call_relation(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    source: &const String,
    caller_index: i32,
    current_scope: symbols.ScopeId,
    receiver_bindings: &const List[lock_order.MethodReceiverBinding],
) -> void:
    call = arena.nodes[call_id.index]
    if call.child_count <= 0:
        return
    callee_id = arena.children[call.first_child]
    callee = arena.nodes[callee_id.index]
    facts: &const List[SymbolFact] = &graph.facts
    module_imports: &const List[project.ImportBinding] = &module.imports
    if callee.kind == syntax.SyntaxKind.EXPR_NAME:
        callee_name = source[callee.value_start:callee.value_start + callee.value_length]
        found = checked.symbols.find_name_in_scope(&module.source, current_scope, &callee_name)
        if found.index < 0:
            return
        if symbol_is_import_binding(checked, &module.arena, found.index, true):
            add_import_fact_use_relation(
                checked,
                graph,
                module,
                facts[cast[usize](caller_index)].module_index,
                caller_index,
                found.index,
            )
            for imported in module_imports:
                if len(imported.member) > 0 and imported.alias == callee_name:
                    add_named_reparsed_call_relation(
                        graph,
                        caller_index,
                        &imported.module_name,
                        &imported.member,
                        true,
                    )
                    return
            return
        target_index = fact_index_for_symbol(graph, facts[cast[usize](caller_index)].module_index, found.index)
        if target_index >= 0 and fact_kind_is_callable(&facts[cast[usize](target_index)].kind):
            add_relation_unique(
                graph,
                "calls",
                &facts[cast[usize](caller_index)].key,
                &facts[cast[usize](target_index)].key,
                "",
                true,
            )
        return
    if callee.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or callee.child_count < 2:
        return
    receiver_id = arena.children[callee.first_child]
    member_id = arena.children[callee.first_child + 1]
    receiver = arena.nodes[receiver_id.index]
    member = arena.nodes[member_id.index]
    member_name = source[member.value_start:member.value_start + member.value_length]
    nominal_fact_index: i32 = -1
    if receiver.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and receiver.child_count >= 2:
        module_id = arena.children[receiver.first_child]
        module_node = arena.nodes[module_id.index]
        if module_node.kind == syntax.SyntaxKind.EXPR_NAME:
            module_alias = source[
                module_node.value_start:module_node.value_start + module_node.value_length
            ]
            found = checked.symbols.find_name_in_scope(
                &module.source,
                current_scope,
                &module_alias,
            )
            if (
                found.index >= 0
                and symbol_is_import_binding(
                    checked,
                    &module.arena,
                    found.index,
                    false,
                )
            ):
                add_import_fact_use_relation(
                    checked,
                    graph,
                    module,
                    facts[cast[usize](caller_index)].module_index,
                    caller_index,
                    found.index,
                )
                variant_kind = "variant"
                nominal_fact_index = imported_nominal_fact_for_attribute_source(
                    graph,
                    module,
                    arena,
                    source,
                    receiver_id,
                    &variant_kind,
                )
    if receiver.kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_name = source[receiver.value_start:receiver.value_start + receiver.value_length]
        binding_index = lock_order.find_method_receiver_binding(receiver_bindings, &receiver_name)
        if binding_index >= 0:
            binding: &const lock_order.MethodReceiverBinding = &receiver_bindings[cast[usize](binding_index)]
            add_reparsed_method_call_relation(
                graph,
                class_model,
                caller_index,
                &binding.module_name,
                &binding.owner_name,
                &member_name,
            )
            return
        found = checked.symbols.find_name_in_scope(&module.source, current_scope, &receiver_name)
        if found.index >= 0 and symbol_is_import_binding(checked, &module.arena, found.index, false):
            add_import_fact_use_relation(
                checked,
                graph,
                module,
                facts[cast[usize](caller_index)].module_index,
                caller_index,
                found.index,
            )
            for imported in module_imports:
                if len(imported.member) == 0 and imported.alias == receiver_name:
                    add_named_reparsed_call_relation(
                        graph,
                        caller_index,
                        &imported.module_name,
                        &member_name,
                        true,
                    )
                    return
        nominal_fact_index = nominal_fact_for_typed_symbol(
            project_graph,
            graph,
            checked,
            module,
            facts[cast[usize](caller_index)].module_index,
            found.index,
        )
    if nominal_fact_index < 0:
        nominal_fact_index = receiver_field_nominal_fact_in_source(
            project_graph,
            graph,
            class_model,
            module,
            arena,
            receiver_id,
            source,
            caller_index,
        )
    if nominal_fact_index >= 0:
        nominal: &const SymbolFact = &facts[cast[usize](nominal_fact_index)]
        add_reparsed_method_call_relation(
            graph,
            class_model,
            caller_index,
            &nominal.module_name,
            &nominal.name,
            &member_name,
        )


def add_named_reparsed_call_relation(
    graph: &SemanticFactGraph,
    caller_index: i32,
    module_name: &const String,
    name: &const String,
    imported: bool,
) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    target_index = find_top_level_fact_by_module_name(graph, module_name, name)
    if target_index >= 0:
        target: &const SymbolFact = &facts[cast[usize](target_index)]
        if fact_kind_is_callable(&target.kind):
            detail = ""
            if imported:
                detail = "import"
            add_relation_unique(
                graph,
                "calls",
                &facts[cast[usize](caller_index)].key,
                &target.key,
                &detail,
                true,
            )
        elif fact_kind_is_nominal_constructor(&target.kind):
            add_relation_unique(
                graph,
                "uses",
                &facts[cast[usize](caller_index)].key,
                &target.key,
                "",
                true,
            )
        return
    add_relation_unique(
        graph,
        "calls",
        &facts[cast[usize](caller_index)].key,
        module_name,
        name,
        false,
    )


def add_reparsed_method_call_relation(
    graph: &SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    caller_index: i32,
    module_name: &const String,
    owner_name: &const String,
    member_name: &const String,
) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    target_index = find_effective_method_fact(
        graph,
        class_model,
        module_name,
        owner_name,
        member_name,
    )
    if target_index >= 0:
        add_relation_unique(
            graph,
            "calls",
            &facts[cast[usize](caller_index)].key,
            &facts[cast[usize](target_index)].key,
            "import",
            true,
        )
        return
    nominal_index = find_top_level_fact_by_module_name(
        graph,
        module_name,
        owner_name,
    )
    target_index = variant_case_fact_for_nominal(
        graph,
        nominal_index,
        member_name,
    )
    if target_index >= 0:
        add_relation_unique(
            graph,
            "uses",
            &facts[cast[usize](caller_index)].key,
            &facts[cast[usize](target_index)].key,
            "",
            true,
        )
        return
    owner_method = owner_name[0:len(owner_name)] + "." + member_name[0:len(member_name)]
    add_relation_unique(
        graph,
        "calls",
        &facts[cast[usize](caller_index)].key,
        module_name,
        &owner_method,
        false,
    )


def enclosing_scope_for_node(
    checked: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
) -> symbols.ScopeId:
    if id.index < 0:
        return symbols.root_scope()
    target = arena.nodes[id.index]
    target_end = target.start + target.length
    best = symbols.root_scope()
    best_length: usize = 0
    scope_bindings: &const List[semantic.NodeScopeBinding] = &checked.model.node_scopes
    for binding in scope_bindings:
        if binding.node.index < 0 or binding.node.index >= cast[i32](len(arena.nodes)):
            continue
        candidate = arena.nodes[binding.node.index]
        candidate_end = candidate.start + candidate.length
        if candidate.start <= target.start and candidate_end >= target_end:
            if best_length == 0 or candidate.length < best_length:
                best = binding.scope
                best_length = candidate.length
    return best


def collect_import_call_relation(
    project_graph: &const project.ProjectGraph,
    class_model: &const classes.ProjectClassModel,
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    call_id: NodeId,
    caller_index: i32,
    receiver_bindings: &const List[lock_order.MethodReceiverBinding],
) -> void:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    module_imports: &const List[project.ImportBinding] = &module.imports
    facts: &const List[SymbolFact] = &graph.facts
    call = nodes[call_id.index]
    if call.child_count <= 0:
        return
    callee_id = children[call.first_child]
    callee = nodes[callee_id.index]
    target_module = ""
    target_name = ""
    if callee.kind == syntax.SyntaxKind.EXPR_NAME:
        bound_symbol = bound_symbol_for_node(checked, callee_id)
        if not symbol_is_import_binding(checked, &module.arena, bound_symbol, true):
            return
        callee_name = module.source[callee.value_start:callee.value_start + callee.value_length]
        for imported in module_imports:
            if len(imported.member) > 0 and imported.alias == callee_name:
                target_module = imported.module_name[0:len(imported.module_name)]
                target_name = imported.member[0:len(imported.member)]
    elif callee.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE and callee.child_count >= 2:
        receiver_id = children[callee.first_child]
        member_id = children[callee.first_child + 1]
        receiver = nodes[receiver_id.index]
        member = nodes[member_id.index]
        member_name = module.source[member.value_start:member.value_start + member.value_length]
        if receiver.kind == syntax.SyntaxKind.EXPR_NAME:
            receiver_name = module.source[receiver.value_start:receiver.value_start + receiver.value_length]
            binding_index = lock_order.find_method_receiver_binding(receiver_bindings, &receiver_name)
            if binding_index >= 0:
                binding: &const lock_order.MethodReceiverBinding = &receiver_bindings[cast[usize](binding_index)]
                owner_method = binding.owner_name[0:len(binding.owner_name)] + "." + member_name
                target_index = find_effective_method_fact(
                    graph,
                    class_model,
                    &binding.module_name,
                    &binding.owner_name,
                    &member_name,
                )
                if target_index >= 0:
                    add_relation_unique(
                        graph,
                        "calls",
                        &facts[cast[usize](caller_index)].key,
                        &facts[cast[usize](target_index)].key,
                        "import",
                        true,
                    )
                else:
                    add_relation_unique(
                        graph,
                        "calls",
                        &facts[cast[usize](caller_index)].key,
                        &binding.module_name,
                        &owner_method,
                        false,
                    )
                return
            bound_symbol = bound_symbol_for_node(checked, receiver_id)
            if symbol_is_import_binding(checked, &module.arena, bound_symbol, false):
                for imported in module_imports:
                    if len(imported.member) == 0 and imported.alias == receiver_name:
                        target_module = imported.module_name[0:len(imported.module_name)]
                        target_name = member_name
        if len(target_module) == 0:
            variant_kind = "variant"
            nominal_fact_index = nominal_fact_for_value_receiver_kind(
                graph,
                checked,
                module,
                receiver_id,
                facts[cast[usize](caller_index)].module_index,
                &variant_kind,
            )
            if nominal_fact_index < 0:
                receiver_type = analysis_value_type(
                    &checked.type_table,
                    semantic_expression_type(checked, &module.arena, receiver_id),
                )
                if receiver_type.index >= 0 and receiver_type.index < cast[i32](len(checked.type_table.types)):
                    receiver_record = checked.type_table.types[receiver_type.index]
                    if types.is_nominal_kind(receiver_record.kind) and receiver_record.name_length > 0:
                        type_builder = StringBuilder()
                        codegen_type_names.emit_semantic_readable_type_name(
                            &checked.type_table,
                            receiver_type,
                            &module.source,
                            &type_builder,
                        )
                        type_name = type_builder.finish()
                        nominal_fact_index = resolve_type_fact(
                            project_graph,
                            graph,
                            facts[cast[usize](caller_index)].module_index,
                            &type_name,
                        )
            if nominal_fact_index < 0:
                nominal_fact_index = receiver_field_nominal_fact(
                    project_graph,
                    graph,
                    class_model,
                    module,
                    receiver_id,
                    caller_index,
                )
            if nominal_fact_index >= 0:
                nominal: &const SymbolFact = &facts[cast[usize](nominal_fact_index)]
                target_index = find_effective_method_fact(
                    graph,
                    class_model,
                    &nominal.module_name,
                    &nominal.name,
                    &member_name,
                )
                if target_index >= 0:
                    add_relation_unique(
                        graph,
                        "calls",
                        &facts[cast[usize](caller_index)].key,
                        &facts[cast[usize](target_index)].key,
                        "import",
                        true,
                    )
                else:
                    target_index = variant_case_fact_for_nominal(
                        graph,
                        nominal_fact_index,
                        &member_name,
                    )
                    if target_index >= 0:
                        add_relation_unique(
                            graph,
                            "uses",
                            &facts[cast[usize](caller_index)].key,
                            &facts[cast[usize](target_index)].key,
                            "",
                            true,
                        )
                    else:
                        owner_method = nominal.name[0:len(nominal.name)] + "." + member_name[0:len(member_name)]
                        add_relation_unique(
                            graph,
                            "calls",
                            &facts[cast[usize](caller_index)].key,
                            &nominal.module_name,
                            &owner_method,
                            false,
                        )
                return
    if len(target_module) == 0 or len(target_name) == 0:
        return
    target_index = find_top_level_fact_by_module_name(graph, &target_module, &target_name)
    if target_index >= 0:
        target: &const SymbolFact = &facts[cast[usize](target_index)]
        if not fact_kind_is_callable(&target.kind):
            if fact_kind_is_nominal_constructor(&target.kind):
                add_relation_unique(
                    graph,
                    "uses",
                    &facts[cast[usize](caller_index)].key,
                    &target.key,
                    "",
                    true,
                )
            return
        add_relation_unique(
            graph,
            "calls",
            &facts[cast[usize](caller_index)].key,
            &facts[cast[usize](target_index)].key,
            "import",
            true,
        )
    else:
        add_relation_unique(
            graph,
            "calls",
            &facts[cast[usize](caller_index)].key,
            &target_module,
            &target_name,
            false,
        )


def analysis_value_type(
    table: &const types.TypeTable,
    type_id: types.TypeId,
) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if (
            kind != types.TypeKind.CONST
            and kind != types.TypeKind.REFERENCE
            and kind != types.TypeKind.POINTER
        ):
            break
        current = table.types[current.index].inner
    return current


def semantic_expression_type(
    checked: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
) -> types.TypeId:
    resolved = checked.model.expr_type(id)
    if (
        resolved.index >= 0
        and resolved.index < cast[i32](len(checked.type_table.types))
        and checked.type_table.types[resolved.index].kind != types.TypeKind.ERROR
    ):
        return resolved
    if id.index < 0:
        return resolved
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or node.child_count < 2:
        return resolved
    member_id = arena.children[node.first_child + 1]
    symbol_index = bound_symbol_for_node(checked, member_id)
    if symbol_index < 0 or symbol_index >= cast[i32](len(checked.symbols.symbols)):
        return resolved
    return checked.symbols.symbols[cast[usize](symbol_index)].type_id


def receiver_field_nominal_fact(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    module: &const project.ParsedModule,
    id: NodeId,
    caller_index: i32,
) -> i32:
    return receiver_field_nominal_fact_in_source(
        project_graph,
        graph,
        class_model,
        module,
        &module.arena,
        id,
        &module.source,
        caller_index,
    )


def receiver_field_nominal_fact_in_source(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    module: &const project.ParsedModule,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    caller_index: i32,
) -> i32:
    if id.index < 0:
        return -1
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    node = nodes[id.index]
    facts: &const List[SymbolFact] = &graph.facts
    caller: &const SymbolFact = &facts[cast[usize](caller_index)]
    if node.kind == syntax.SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        if name == "self" and len(caller.owner) > 0:
            return find_fact_by_owner_name(
                graph,
                &caller.module_name,
                &caller.owner,
            )
        return -1
    if node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE or node.child_count < 2:
        return -1
    receiver_id = children[node.first_child]
    member_id = children[node.first_child + 1]
    owner_index = receiver_field_nominal_fact_in_source(
        project_graph,
        graph,
        class_model,
        module,
        arena,
        receiver_id,
        source,
        caller_index,
    )
    if owner_index < 0:
        return -1
    member = nodes[member_id.index]
    member_name = source[member.value_start:member.value_start + member.value_length]
    field_index = field_fact_for_nominal(
        graph,
        class_model,
        owner_index,
        &member_name,
    )
    if field_index < 0:
        return -1
    field: &const SymbolFact = &facts[cast[usize](field_index)]
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    field_module: &const project.ParsedModule = &project_modules[field.module_index]
    field_type_id = codegen_type_names.find_child_type(&field_module.arena, field.node)
    return resolve_type_fact_from_node(
        project_graph,
        graph,
        field.module_index,
        &field_module.arena,
        &field_module.source,
        field_type_id,
    )


def fact_kind_is_callable(kind: &const String) -> bool:
    return (
        kind == "function"
        or kind == "function-template"
        or kind == "extern-function"
    )


def fact_kind_is_nominal_constructor(kind: &const String) -> bool:
    return (
        kind == "struct"
        or kind == "class"
        or kind == "enum"
        or kind == "union"
        or kind == "variant"
        or kind == "extern-type"
    )


def bound_symbol_for_node(
    checked: &const checker_core.Checker,
    node: NodeId,
) -> i32:
    bindings: &const List[semantic.NodeSymbolBinding] = &checked.model.name_symbols
    for binding in bindings:
        if binding.node.index == node.index:
            return binding.symbol.index
    return -1


def symbol_is_import_binding(
    checked: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    symbol_index: i32,
    member_import: bool,
) -> bool:
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    if symbol_index < 0 or symbol_index >= cast[i32](len(symbol_values)):
        return false
    symbol: &const symbols.SymbolRecord = &symbol_values[cast[usize](symbol_index)]
    if symbol.node.index < 0:
        return false
    node = arena.nodes[symbol.node.index]
    if member_import:
        return node.kind == syntax.SyntaxKind.IMPORT_NAME
    return node.kind == syntax.SyntaxKind.IMPORT_DECL


def add_import_fact_use_relation(
    checked: &const checker_core.Checker,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    module_index: usize,
    source_index: i32,
    symbol_index: i32,
) -> void:
    if (
        not symbol_is_import_binding(
            checked,
            &module.arena,
            symbol_index,
            false,
        )
        and not symbol_is_import_binding(
            checked,
            &module.arena,
            symbol_index,
            true,
        )
    ):
        return
    facts: &const List[SymbolFact] = &graph.facts
    if source_index < 0 or source_index >= cast[i32](len(facts)):
        return
    symbol_values: &const List[symbols.SymbolRecord] = &checked.symbols.symbols
    symbol: &const symbols.SymbolRecord = &symbol_values[cast[usize](symbol_index)]
    import_index = enclosing_fact_index(
        graph,
        module_index,
        symbol.node,
        &module.arena,
    )
    if (
        import_index < 0
        or import_index == source_index
        or facts[cast[usize](import_index)].kind != "import"
    ):
        return
    add_relation_unique(
        graph,
        "uses",
        &facts[cast[usize](source_index)].key,
        &facts[cast[usize](import_index)].key,
        "import",
        true,
    )


def collect_layout_type_relations(
    project_graph: &const project.ProjectGraph,
    graph: &SemanticFactGraph,
) -> void:
    facts: &const List[SymbolFact] = &graph.facts
    modules: &const List[project.ParsedModule] = &project_graph.modules
    fact_index: usize = 0
    while fact_index < len(facts):
        fact: &const SymbolFact = &facts[fact_index]
        if (
            fact.kind == "field"
            and fact.node.index >= 0
            and fact.module_index < len(modules)
        ):
            module: &const project.ParsedModule = &modules[fact.module_index]
            type_id = codegen_type_names.find_child_type(
                &module.arena,
                fact.node,
            )
            relation_kind = "type"
            collect_embedded_aggregate_type_relation(
                project_graph,
                module,
                graph,
                fact.module_index,
                cast[i32](fact_index),
                type_id,
                &relation_kind,
            )
        fact_index += 1


def collect_type_relations(
    project_graph: &const project.ProjectGraph,
    graph: &SemanticFactGraph,
) -> void:
    module_index: usize = 0
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    while module_index < len(project_modules):
        module: &const project.ParsedModule = &project_modules[module_index]
        nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
        node_index: usize = 0
        while node_index < len(nodes):
            node = nodes[node_index]
            if node.kind == syntax.SyntaxKind.TYPE_NAME:
                type_id = NodeId(index=cast[i32](node_index))
                source_index = enclosing_fact_index(graph, module_index, type_id, &module.arena)
                if source_index >= 0 and not type_name_is_enclosing_parameter(
                    graph,
                    module_index,
                    type_id,
                    &module.arena,
                    &module.source,
                ):
                    target_index = resolve_type_fact_from_node(
                        project_graph,
                        graph,
                        module_index,
                        &module.arena,
                        &module.source,
                        type_id,
                    )
                    if target_index >= 0 and target_index != source_index:
                        add_relation_unique(
                            graph,
                            "type",
                            &facts[cast[usize](source_index)].key,
                            &facts[cast[usize](target_index)].key,
                            "",
                            true,
                        )
            node_index += 1
        module_index += 1


def collect_import_type_fact_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
        children: &const List[NodeId] = &module.arena.children
        node_index: usize = 0
        while node_index < len(nodes):
            node = nodes[node_index]
            if node.kind == syntax.SyntaxKind.TYPE_NAME and node.child_count > 0:
                type_id = NodeId(index=cast[i32](node_index))
                source_index = enclosing_fact_index(
                    graph,
                    module_index,
                    type_id,
                    &module.arena,
                )
                if source_index >= 0 and not type_name_is_enclosing_parameter(
                    graph,
                    module_index,
                    type_id,
                    &module.arena,
                    &module.source,
                ):
                    name_id = children[node.first_child]
                    name_node = nodes[name_id.index]
                    current_scope = enclosing_scope_for_node(
                        &analyzed.checked,
                        &module.arena,
                        type_id,
                    )
                    imported_symbol = analyzed.checked.symbols.find_in_scope(
                        &module.source,
                        current_scope,
                        name_node.value_start,
                        name_node.value_length,
                    )
                    add_import_fact_use_relation(
                        &analyzed.checked,
                        graph,
                        module,
                        module_index,
                        source_index,
                        imported_symbol.index,
                    )
            node_index += 1


def collect_abi_surface_relations(
    project_graph: &const project.ProjectGraph,
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    facts: &const List[SymbolFact] = &graph.facts
    for analyzed in analyzed_modules:
        module_index = analyzed.module_index
        module: &const project.ParsedModule = &project_modules[module_index]
        nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
        children: &const List[NodeId] = &module.arena.children
        fact_index: usize = 0
        while fact_index < len(facts):
            fact: &const SymbolFact = &facts[fact_index]
            if (
                fact.module_index == module_index
                and fact.node.index >= 0
                and fact.abi == "C"
                and (
                    fact_kind_is_callable(&fact.kind)
                    or fact.kind == "method"
                )
            ):
                declaration = nodes[fact.node.index]
                if declaration.kind == syntax.SyntaxKind.FUNCTION_DECL:
                    for offset in range(0, declaration.child_count):
                        child_id = children[declaration.first_child + offset]
                        child = nodes[child_id.index]
                        if child.kind == syntax.SyntaxKind.PARAMETER:
                            for parameter_offset in range(0, child.child_count):
                                type_id = children[child.first_child + parameter_offset]
                                type_node = nodes[type_id.index]
                                if is_type_node_kind(type_node.kind):
                                    collect_abi_surface_type_relation(
                                        project_graph,
                                        module,
                                        graph,
                                        module_index,
                                        cast[i32](fact_index),
                                        type_id,
                                    )
                        elif is_type_node_kind(child.kind):
                            collect_abi_surface_type_relation(
                                project_graph,
                                module,
                                graph,
                                module_index,
                                cast[i32](fact_index),
                                child_id,
                            )
            fact_index += 1


def collect_abi_surface_type_relation(
    project_graph: &const project.ProjectGraph,
    module: &const project.ParsedModule,
    graph: &SemanticFactGraph,
    module_index: usize,
    source_index: i32,
    type_node_id: NodeId,
) -> void:
    relation_kind = "abi-surface"
    collect_embedded_aggregate_type_relation(
        project_graph,
        module,
        graph,
        module_index,
        source_index,
        type_node_id,
        &relation_kind,
    )


def collect_embedded_aggregate_type_relation(
    project_graph: &const project.ProjectGraph,
    module: &const project.ParsedModule,
    graph: &SemanticFactGraph,
    module_index: usize,
    source_index: i32,
    type_node_id: NodeId,
    relation_kind: &const String,
) -> void:
    name_id = abi_surface_nominal_name_node(&module.arena, type_node_id)
    target_index: i32 = -1
    if name_id.index >= 0:
        target_index = resolve_type_fact_from_node(
            project_graph,
            graph,
            module_index,
            &module.arena,
            &module.source,
            name_id,
        )
    facts: &const List[SymbolFact] = &graph.facts
    if (
        target_index >= 0
        and target_index != source_index
        and fact_kind_is_abi_aggregate(
            &facts[cast[usize](target_index)].kind,
        )
    ):
        add_relation_unique(
            graph,
            relation_kind[0:len(relation_kind)],
            &facts[cast[usize](source_index)].key,
            &facts[cast[usize](target_index)].key,
            "by-value",
            true,
        )
    generic_id = abi_surface_generic_type_node(&module.arena, type_node_id)
    if generic_id.index < 0:
        return
    collect_embedded_generic_argument_relations(
        project_graph,
        graph,
        module,
        module_index,
        source_index,
        generic_id,
        target_index,
        relation_kind,
    )


def collect_embedded_generic_argument_relations(
    project_graph: &const project.ProjectGraph,
    graph: &SemanticFactGraph,
    module: &const project.ParsedModule,
    module_index: usize,
    source_index: i32,
    generic_id: NodeId,
    target_index: i32,
    relation_kind: &const String,
) -> void:
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    children: &const List[NodeId] = &module.arena.children
    generic = nodes[generic_id.index]
    if generic.child_count <= 1:
        return
    base_id = children[generic.first_child]
    base = nodes[base_id.index]
    if abi_surface_is_pointer_backed_runtime_generic(&module.source, &base):
        return
    if abi_surface_is_value_runtime_generic(&module.source, &base):
        argument_offset: i32 = 1
        while argument_offset < generic.child_count:
            collect_embedded_aggregate_type_relation(
                project_graph,
                module,
                graph,
                module_index,
                source_index,
                children[generic.first_child + argument_offset],
                relation_kind,
            )
            argument_offset += 1
        return
    facts: &const List[SymbolFact] = &graph.facts
    if (
        target_index < 0
        or target_index >= cast[i32](len(facts))
        or not fact_kind_is_abi_aggregate(
            &facts[cast[usize](target_index)].kind,
        )
    ):
        return
    target: &const SymbolFact = &facts[cast[usize](target_index)]
    if target.node.index < 0:
        return
    target_module: &const project.ParsedModule = &project_graph.modules[target.module_index]
    parameter_count = generics.type_param_count(
        &target_module.arena,
        target.node,
    )
    argument_offset: i32 = 1
    while argument_offset < generic.child_count and argument_offset <= parameter_count:
        if abi_surface_declaration_embeds_parameter(
            project_graph,
            graph,
            target.module_index,
            &target_module.arena,
            target.node,
            &target_module.source,
            argument_offset - 1,
            0,
        ):
            collect_embedded_aggregate_type_relation(
                project_graph,
                module,
                graph,
                module_index,
                source_index,
                children[generic.first_child + argument_offset],
                relation_kind,
            )
        argument_offset += 1


def abi_surface_declaration_embeds_parameter(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    module_index: usize,
    arena: &const syntax.SyntaxArena,
    declaration_id: NodeId,
    source: &const String,
    parameter_index: i32,
    depth: i32,
) -> bool:
    if declaration_id.index < 0 or depth >= 32:
        return false
    declaration = arena.nodes[declaration_id.index]
    for offset in range(0, declaration.child_count):
        child_id = arena.children[declaration.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.FIELD_DECL:
            field_type = codegen_type_names.find_child_type(arena, child_id)
            if abi_surface_type_embeds_parameter(
                project_graph,
                graph,
                module_index,
                arena,
                field_type,
                source,
                declaration_id,
                parameter_index,
                depth,
            ):
                return true
        elif child.kind == syntax.SyntaxKind.VARIANT_CASE_DECL:
            for field_offset in range(0, child.child_count):
                field_id = arena.children[child.first_child + field_offset]
                field = arena.nodes[field_id.index]
                if field.kind != syntax.SyntaxKind.FIELD_DECL:
                    continue
                field_type = codegen_type_names.find_child_type(arena, field_id)
                if abi_surface_type_embeds_parameter(
                    project_graph,
                    graph,
                    module_index,
                    arena,
                    field_type,
                    source,
                    declaration_id,
                    parameter_index,
                    depth,
                ):
                    return true
    return false


def abi_surface_type_embeds_parameter(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    module_index: usize,
    arena: &const syntax.SyntaxArena,
    type_id: NodeId,
    source: &const String,
    declaration_id: NodeId,
    parameter_index: i32,
    depth: i32,
) -> bool:
    if type_id.index < 0 or depth >= 32:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == syntax.SyntaxKind.TYPE_NAME:
        return (
            generics.type_parameter_index(
                arena,
                declaration_id,
                source,
                node.value_start,
                node.value_length,
            )
            == parameter_index
        )
    if (
        node.kind == syntax.SyntaxKind.TYPE_CONST
        or node.kind == syntax.SyntaxKind.TYPE_ARRAY
    ) and node.child_count > 0:
        return abi_surface_type_embeds_parameter(
            project_graph,
            graph,
            module_index,
            arena,
            arena.children[node.first_child],
            source,
            declaration_id,
            parameter_index,
            depth,
        )
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count <= 1:
        return false
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    if abi_surface_is_pointer_backed_runtime_generic(source, &base):
        return false
    if abi_surface_is_value_runtime_generic(source, &base):
        argument_offset: i32 = 1
        while argument_offset < node.child_count:
            if abi_surface_type_embeds_parameter(
                project_graph,
                graph,
                module_index,
                arena,
                arena.children[node.first_child + argument_offset],
                source,
                declaration_id,
                parameter_index,
                depth + 1,
            ):
                return true
            argument_offset += 1
        return false
    nested_index = resolve_type_fact_from_node(
        project_graph,
        graph,
        module_index,
        arena,
        source,
        base_id,
    )
    facts: &const List[SymbolFact] = &graph.facts
    if (
        nested_index < 0
        or nested_index >= cast[i32](len(facts))
        or not fact_kind_is_abi_aggregate(
            &facts[cast[usize](nested_index)].kind,
        )
    ):
        return false
    nested: &const SymbolFact = &facts[cast[usize](nested_index)]
    if nested.node.index < 0:
        return false
    nested_module: &const project.ParsedModule = &project_graph.modules[nested.module_index]
    nested_parameter_count = generics.type_param_count(
        &nested_module.arena,
        nested.node,
    )
    argument_offset: i32 = 1
    while argument_offset < node.child_count and argument_offset <= nested_parameter_count:
        if (
            abi_surface_declaration_embeds_parameter(
                project_graph,
                graph,
                nested.module_index,
                &nested_module.arena,
                nested.node,
                &nested_module.source,
                argument_offset - 1,
                depth + 1,
            )
            and abi_surface_type_embeds_parameter(
                project_graph,
                graph,
                module_index,
                arena,
                arena.children[node.first_child + argument_offset],
                source,
                declaration_id,
                parameter_index,
                depth + 1,
            )
        ):
            return true
        argument_offset += 1
    return false


def abi_surface_generic_type_node(
    arena: &const syntax.SyntaxArena,
    type_node: NodeId,
) -> NodeId:
    if type_node.index < 0:
        return syntax.missing_node()
    node = arena.nodes[type_node.index]
    if node.kind == syntax.SyntaxKind.TYPE_GENERIC:
        return type_node
    if (
        node.kind == syntax.SyntaxKind.TYPE_CONST
        or node.kind == syntax.SyntaxKind.TYPE_ARRAY
    ) and node.child_count > 0:
        return abi_surface_generic_type_node(
            arena,
            arena.children[node.first_child],
        )
    return syntax.missing_node()


def abi_surface_nominal_name_node(
    arena: &const syntax.SyntaxArena,
    type_node: NodeId,
) -> NodeId:
    if type_node.index < 0:
        return syntax.missing_node()
    node = arena.nodes[type_node.index]
    if node.kind == syntax.SyntaxKind.TYPE_NAME:
        return type_node
    if (
        node.kind == syntax.SyntaxKind.TYPE_CONST
        or node.kind == syntax.SyntaxKind.TYPE_ARRAY
        or node.kind == syntax.SyntaxKind.TYPE_GENERIC
    ) and node.child_count > 0:
        return abi_surface_nominal_name_node(
            arena,
            arena.children[node.first_child],
        )
    return syntax.missing_node()


def fact_kind_is_abi_aggregate(kind: &const String) -> bool:
    return (
        kind == "struct"
        or kind == "class"
        or kind == "enum"
        or kind == "union"
        or kind == "variant"
    )


def abi_surface_is_pointer_backed_runtime_generic(
    source: &const String,
    base: &const syntax.SyntaxNode,
) -> bool:
    return (
        codegen_type_names.is_runtime_generic_name(source, base, "List")
        or codegen_type_names.is_runtime_generic_name(source, base, "Set")
        or codegen_type_names.is_runtime_generic_name(source, base, "Map")
        or codegen_type_names.is_runtime_generic_name(source, base, "MapKeys")
        or codegen_type_names.is_runtime_generic_name(source, base, "MapValues")
        or codegen_type_names.is_runtime_generic_name(source, base, "MapItems")
        or codegen_type_names.is_runtime_generic_name(source, base, "Owned")
    )


def abi_surface_is_value_runtime_generic(
    source: &const String,
    base: &const syntax.SyntaxNode,
) -> bool:
    return (
        codegen_type_names.is_runtime_generic_name(source, base, "Option")
        or codegen_type_names.is_runtime_generic_name(source, base, "Result")
        or codegen_type_names.is_runtime_generic_name(source, base, "Tuple")
    )


def type_name_is_enclosing_parameter(
    graph: &const SemanticFactGraph,
    module_index: usize,
    type_id: NodeId,
    arena: &const syntax.SyntaxArena,
    source: &const String,
) -> bool:
    if type_id.index < 0:
        return false
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    type_node = nodes[type_id.index]
    type_end = type_node.start + type_node.length
    facts: &const List[SymbolFact] = &graph.facts
    for fact in facts:
        if fact.module_index != module_index or fact.node.index < 0:
            continue
        declaration = nodes[fact.node.index]
        declaration_end = declaration.start + declaration.length
        if declaration.start <= type_node.start and declaration_end >= type_end:
            parameter = generics.type_parameter_index(
                arena,
                fact.node,
                source,
                type_node.value_start,
                type_node.value_length,
            )
            if parameter >= 0:
                return true
    return false


def resolve_type_fact(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    module_index: usize,
    type_text: &const String,
) -> i32:
    dot = last_dot(type_text)
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    module: &const project.ParsedModule = &project_modules[module_index]
    module_imports: &const List[project.ImportBinding] = &module.imports
    if dot >= 0:
        prefix = type_text[0:cast[usize](dot)]
        leaf = type_text[cast[usize](dot + 1):len(type_text)]
        for imported in module_imports:
            if len(imported.member) == 0 and imported.alias == prefix:
                return find_top_level_fact_by_module_name(graph, &imported.module_name, &leaf)
    for imported in module_imports:
        if len(imported.member) > 0 and imported.alias == type_text:
            return find_top_level_fact_by_module_name(graph, &imported.module_name, &imported.member)
    local = find_top_level_fact_by_module_name(graph, &module.name, type_text)
    if local >= 0:
        return local
    return -1


def resolve_type_fact_from_node(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    module_index: usize,
    arena: &const syntax.SyntaxArena,
    source: &const String,
    type_id: NodeId,
) -> i32:
    if type_id.index < 0:
        return -1
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    children: &const List[NodeId] = &arena.children
    node = nodes[type_id.index]
    if node.kind != syntax.SyntaxKind.TYPE_NAME or node.child_count == 0:
        return -1
    builder = StringBuilder()
    for offset in range(0, node.child_count):
        if offset > 0:
            builder.append(".")
        part = nodes[children[node.first_child + offset].index]
        builder.append(source[part.value_start:part.value_start + part.value_length])
    type_text = builder.finish()
    return resolve_type_fact(project_graph, graph, module_index, &type_text)


def collect_lock_relations(
    analysis: &const emit_project.AnalysisResult,
    graph: &SemanticFactGraph,
) -> void:
    analyzed_modules: &const List[emit_project.AnalyzedModule] = &analysis.modules
    if len(analyzed_modules) == 0:
        return
    model: &const lock_order.ProjectLockModel = &analyzed_modules[0].checked.lock_model
    functions: &const List[lock_order.FunctionLockEffect] = &model.functions
    locks: &const List[lock_order.ProjectLock] = &model.locks
    edges: &const List[lock_order.LockEdge] = &model.edges
    facts: &const List[SymbolFact] = &graph.facts
    for effect in functions:
        function_index = find_fact_for_lock_effect(graph, &effect)
        if function_index < 0:
            continue
        for lock_index in effect.locks:
            if lock_index < 0 or lock_index >= cast[i32](len(locks)):
                continue
            selected_lock: &const lock_order.ProjectLock = &locks[lock_index]
            target_index = find_lock_fact_by_module_name(graph, &selected_lock.module_name, &selected_lock.name)
            if target_index >= 0:
                add_relation_unique(
                    graph,
                    "acquires",
                    &facts[cast[usize](function_index)].key,
                    &facts[cast[usize](target_index)].key,
                    "",
                    true,
                )
        if effect.unknown:
            add_relation_unique(
                graph,
                "lock-effect",
                &facts[cast[usize](function_index)].key,
                "unknown",
                "unresolved callee",
                false,
            )
    for edge in edges:
        if edge.before < 0 or edge.after < 0 or edge.before >= cast[i32](len(locks)) or edge.after >= cast[i32](len(locks)):
            continue
        before: &const lock_order.ProjectLock = &locks[edge.before]
        after: &const lock_order.ProjectLock = &locks[edge.after]
        before_index = find_lock_fact_by_module_name(graph, &before.module_name, &before.name)
        after_index = find_lock_fact_by_module_name(graph, &after.module_name, &after.name)
        if before_index >= 0 and after_index >= 0:
            detail = "inferred"
            if edge.explicit:
                detail = "explicit"
            add_relation_unique(
                graph,
                "lock-before",
                &facts[cast[usize](before_index)].key,
                &facts[cast[usize](after_index)].key,
                &detail,
                true,
            )
            order_index = find_lock_order_fact_by_location(
                graph,
                &edge.module_name,
                edge.line,
                edge.column,
            )
            if order_index >= 0:
                add_relation_unique(
                    graph,
                    "lock-order-before",
                    &facts[cast[usize](order_index)].key,
                    &facts[cast[usize](before_index)].key,
                    "",
                    true,
                )
                add_relation_unique(
                    graph,
                    "lock-order-after",
                    &facts[cast[usize](order_index)].key,
                    &facts[cast[usize](after_index)].key,
                    "",
                    true,
                )


def find_fact_for_lock_effect(
    graph: &const SemanticFactGraph,
    effect: &const lock_order.FunctionLockEffect,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        if lock_effect_matches_fact(effect, &facts[index]):
            return cast[i32](index)
        index += 1
    return -1


def lock_effect_matches_fact(
    effect: &const lock_order.FunctionLockEffect,
    fact: &const SymbolFact,
) -> bool:
    if fact.kind != "function" and fact.kind != "function-template" and fact.kind != "method":
        return false
    builder = StringBuilder()
    builder.append(fact.module_name[0:len(fact.module_name)])
    builder.append("::")
    if len(fact.owner) > 0:
        for index in range(0, len(fact.owner)):
            byte = fact.owner.byte_at(index)
            if byte == 46:
                builder.append("::")
            else:
                builder.append_char(cast[char](byte))
        builder.append("::")
    builder.append(fact.name[0:len(fact.name)])
    expected = builder.finish()
    return strings_equal(&expected, &effect.qualified_name)


def strings_equal(left: &const String, right: &const String) -> bool:
    return left == right


def add_relation_unique(
    graph: &SemanticFactGraph,
    kind: String,
    from_key: &const String,
    to_key: &const String,
    detail: &const String,
    resolved: bool,
) -> void:
    relations: &const List[RelationFact] = &graph.relations
    for relation in relations:
        if relation.kind == kind and relation.from_key == from_key and relation.to_key == to_key:
            return
    graph.relations.append(
        RelationFact(
            kind=kind,
            from_key=from_key[0:len(from_key)],
            to_key=to_key[0:len(to_key)],
            detail=detail[0:len(detail)],
            resolved=resolved,
        )
    )


def fact_index_for_symbol(
    graph: &const SemanticFactGraph,
    module_index: usize,
    symbol_index: i32,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if fact.module_index == module_index and fact.symbol_index == symbol_index:
            return cast[i32](index)
        index += 1
    return -1


def enclosing_fact_index(
    graph: &const SemanticFactGraph,
    module_index: usize,
    node_id: NodeId,
    arena: &const syntax.SyntaxArena,
) -> i32:
    if node_id.index < 0:
        return -1
    nodes: &const List[syntax.SyntaxNode] = &arena.nodes
    facts: &const List[SymbolFact] = &graph.facts
    target = nodes[node_id.index]
    target_end = target.start + target.length
    best: i32 = -1
    best_length: usize = 0
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if fact.module_index == module_index and fact.node.index >= 0:
            candidate = nodes[fact.node.index]
            candidate_end = candidate.start + candidate.length
            if candidate.start <= target.start and candidate_end >= target_end:
                if best < 0 or candidate.length < best_length:
                    best = cast[i32](index)
                    best_length = candidate.length
        index += 1
    return best


def find_fact_by_key(
    graph: &const SemanticFactGraph,
    key: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        if facts[index].key == key:
            return cast[i32](index)
        index += 1
    return -1


def find_lock_fact_by_module_name(
    graph: &const SemanticFactGraph,
    module_name: &const String,
    name: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if (
            fact.module_name == module_name
            and fact.name == name
            and fact.kind == "lock"
            and len(fact.owner) == 0
        ):
            return cast[i32](index)
        index += 1
    return -1


def find_lock_order_fact_by_location(
    graph: &const SemanticFactGraph,
    module_name: &const String,
    line: i32,
    column: i32,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if (
            fact.module_name == module_name
            and fact.kind == "lock-order"
            and fact.line == line
            and fact.column == column
        ):
            return cast[i32](index)
        index += 1
    return -1


def find_top_level_fact_by_module_name(
    graph: &const SemanticFactGraph,
    module_name: &const String,
    name: &const String,
) -> i32:
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if fact.module_name == module_name and fact.name == name and len(fact.owner) == 0:
            return cast[i32](index)
        index += 1
    return -1


def find_fact_by_owner_name(
    graph: &const SemanticFactGraph,
    module_name: &const String,
    owner: &const String,
) -> i32:
    dot = last_dot(owner)
    leaf = owner[0:len(owner)]
    parent = ""
    if dot >= 0:
        leaf = owner[cast[usize](dot + 1):len(owner)]
        parent = owner[0:cast[usize](dot)]
    facts: &const List[SymbolFact] = &graph.facts
    index: usize = 0
    while index < len(facts):
        fact: &const SymbolFact = &facts[index]
        if fact.module_name == module_name and fact.name == leaf and fact.owner == parent:
            return cast[i32](index)
        index += 1
    return -1


def find_effective_field_fact(
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    module_name: &const String,
    owner_name: &const String,
    field_name: &const String,
) -> i32:
    class_index = classes.find_class(class_model, module_name, owner_name)
    if class_index < 0:
        return -1
    owner_index = classes.find_field_owner(class_model, class_index, field_name)
    if owner_index < 0:
        return -1
    owner: &const classes.ClassInfo = &class_model.classes[
        cast[usize](owner_index)
    ]
    qualified_name = owner.name[0:len(owner.name)] + "." + field_name[0:len(field_name)]
    return find_fact_by_owner_name(graph, &owner.module_name, &qualified_name)


def find_effective_method_fact(
    graph: &const SemanticFactGraph,
    class_model: &const classes.ProjectClassModel,
    module_name: &const String,
    owner_name: &const String,
    method_name: &const String,
) -> i32:
    class_index = classes.find_class(class_model, module_name, owner_name)
    if class_index < 0:
        return -1
    method_index = classes.find_effective_method(class_model, class_index, method_name)
    if method_index < 0:
        return -1
    method: &const classes.ClassMethodInfo = &class_model.methods[cast[usize](method_index)]
    owner: &const classes.ClassInfo = &class_model.classes[cast[usize](method.owner)]
    qualified_name = owner.name[0:len(owner.name)] + "." + method.name[0:len(method.name)]
    return find_fact_by_owner_name(graph, &owner.module_name, &qualified_name)


def declaration_location_start(
    arena: &const syntax.SyntaxArena,
    id: NodeId,
) -> usize:
    node = arena.nodes[id.index]
    start = node.start
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.DECORATOR and child.start < start:
            start = child.start
    return start


def locate_symbol(
    project_graph: &const project.ProjectGraph,
    graph: &const SemanticFactGraph,
    requested_path: &const String,
    requested_line: i32,
) -> LocationResult:
    if requested_line <= 0:
        return location_error("line must be a positive integer")
    project_modules: &const List[project.ParsedModule] = &project_graph.modules
    matched_module: i32 = -1
    module_index: usize = 0
    while module_index < len(project_modules):
        if paths_match(&project_modules[module_index].path, requested_path):
            if matched_module >= 0:
                return location_error("source path is ambiguous in the project graph")
            matched_module = cast[i32](module_index)
        module_index += 1
    if matched_module < 0:
        return location_error("source file is not part of the loaded project graph")
    module: &const project.ParsedModule = &project_modules[cast[usize](matched_module)]
    nodes: &const List[syntax.SyntaxNode] = &module.arena.nodes
    facts: &const List[SymbolFact] = &graph.facts
    span = line_span(&module.source, requested_line)
    if span[0] < 0:
        return location_error("line is outside the source file")
    line_start = cast[usize](span[0])
    line_end = cast[usize](span[1])
    best: i32 = -1
    best_length: usize = 0
    fact_index: usize = 0
    while fact_index < len(facts):
        fact: &const SymbolFact = &facts[fact_index]
        if fact.module_index == cast[usize](matched_module) and fact.node.index >= 0:
            node = nodes[fact.node.index]
            node_start = declaration_location_start(&module.arena, fact.node)
            node_end = node.start + node.length
            node_length = node_end - node_start
            if node_start < line_end and node_end > line_start:
                if best < 0 or node_length < best_length:
                    best = cast[i32](fact_index)
                    best_length = node_length
        fact_index += 1
    if best < 0:
        return location_error("line is not inside a semantic declaration")
    return LocationResult(
        ok=true,
        fact_index=best,
        module_index=matched_module,
        node=facts[cast[usize](best)].node,
        error="",
    )


def location_error(message: String) -> LocationResult:
    return LocationResult(
        ok=false,
        fact_index=-1,
        module_index=-1,
        node=syntax.missing_node(),
        error=message,
    )


def line_span(source: &const String, requested_line: i32) -> List[i32]:
    result: List[i32] = []
    current_line: i32 = 1
    start: usize = 0
    index: usize = 0
    while current_line < requested_line and index < len(source):
        if source.byte_at(index) == 10:
            current_line += 1
            start = index + 1
        index += 1
    if current_line != requested_line or start > len(source):
        result.append(-1)
        result.append(-1)
        return result
    end = start
    while end < len(source) and source.byte_at(end) != 10:
        end += 1
    result.append(cast[i32](start))
    result.append(cast[i32](end))
    return result


def paths_match(
    candidate: &const String,
    requested: &const String,
) -> bool:
    if candidate == requested:
        return true
    if len(requested) >= 2 and requested.byte_at(0) == 46 and requested.byte_at(1) == 47:
        stripped = requested[2:len(requested)]
        if candidate == stripped:
            return true
    if len(candidate) > len(requested):
        start = len(candidate) - len(requested)
        if candidate[start:len(candidate)] == requested and start > 0 and candidate.byte_at(start - 1) == 47:
            return true
    return false


def last_dot(value: &const String) -> i32:
    index = cast[i32](len(value)) - 1
    while index >= 0:
        if value.byte_at(cast[usize](index)) == 46:
            return index
        index -= 1
    return -1


def fact_snapshot(fact: &const SymbolFact) -> String:
    return (
        fact.key[0:len(fact.key)]
        + "|signature="
        + fact.canonical_signature[0:len(fact.canonical_signature)]
        + "|implementation="
        + fact.implementation[0:len(fact.implementation)]
        + "|modifiers="
        + fact.modifiers[0:len(fact.modifiers)]
        + "|type="
        + fact.type_name[0:len(fact.type_name)]
        + "|ownership="
        + fact.ownership[0:len(fact.ownership)]
        + "|parameters="
        + fact.parameter_ownership[0:len(fact.parameter_ownership)]
        + "|abi="
        + fact.abi[0:len(fact.abi)]
        + "|reflected="
        + bool_text(fact.reflected)
        + "|exported="
        + bool_text(fact.exported)
    )


def relation_snapshot(relation: &const RelationFact) -> String:
    resolved = "unresolved"
    if relation.resolved:
        resolved = "resolved"
    return (
        relation.kind[0:len(relation.kind)]
        + "|"
        + relation.from_key[0:len(relation.from_key)]
        + "|"
        + relation.to_key[0:len(relation.to_key)]
        + "|"
        + relation.detail[0:len(relation.detail)]
        + "|"
        + resolved
    )


def bool_text(value: bool) -> String:
    if value:
        return "yes"
    return "no"
