import syntax
from syntax import NodeId


struct ReflectionRecord:
    declaration: NodeId
    field_count: i32
    method_count: i32
    is_reflected: bool


struct StaticAssertRecord:
    declaration: NodeId
    has_message: bool


def summarize_reflection(arena: &const syntax.SyntaxArena, declaration: NodeId, source: &const String) -> ReflectionRecord:
    node = arena.nodes[declaration.index]
    field_count: i32 = 0
    method_count: i32 = 0
    reflected = has_decorator(arena, declaration, source, "reflect")
    offset: i32 = 0
    while offset < node.child_count:
        child = arena.nodes[arena.children[node.first_child + offset].index]
        if child.kind == syntax.SyntaxKind.FIELD_DECL:
            field_count += 1
        elif child.kind == syntax.SyntaxKind.FUNCTION_DECL:
            method_count += 1
        offset += 1
    return ReflectionRecord(declaration=declaration, field_count=field_count, method_count=method_count, is_reflected=reflected)


def summarize_static_assert(arena: &const syntax.SyntaxArena, declaration: NodeId) -> StaticAssertRecord:
    node = arena.nodes[declaration.index]
    return StaticAssertRecord(declaration=declaration, has_message=node.child_count > 1)


def has_decorator(arena: &const syntax.SyntaxArena, declaration: NodeId, source: &const String, name: String) -> bool:
    node = arena.nodes[declaration.index]
    offset: i32 = 0
    while offset < node.child_count:
        child = arena.nodes[arena.children[node.first_child + offset].index]
        if child.kind == syntax.SyntaxKind.DECORATOR and range_text_equals(source, child.value_start, child.value_length, name):
            return true
        offset += 1
    return false


def range_text_equals(source: &const String, start: usize, length: usize, text: String) -> bool:
    if length != len(text):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true
