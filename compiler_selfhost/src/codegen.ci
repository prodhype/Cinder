import backend_ir
import fs
import lexer
import parser
import project
import syntax
import token
from syntax import NodeId, SyntaxArena, SyntaxKind


struct ModuleNameTypeBinding:
    name: String
    type_id: NodeId
    moved: bool


struct ModuleFieldTypeBinding:
    owner: String
    field: String
    type_id: NodeId


struct FStringField:
    expression_end: usize
    format_start: usize
    close: usize
    valid: bool


struct ModuleCodegenContext:
    root: NodeId
    type_arena: &const SyntaxArena
    type_source: &const String
    local_types: List[ModuleNameTypeBinding]
    pointer_names: List[String]
    field_types: List[ModuleFieldTypeBinding]
    current_owner: String
    local_start: usize
    pointer_start: usize
    deferred_expressions: List[NodeId]
    with_resources: List[String]
    global_names: List[String]
    extern_names: List[String]


def emit_c(arena: &const SyntaxArena, root: NodeId, source: &const String) -> String:
    builder = StringBuilder()
    builder.append("#include <stdint.h>\n")
    builder.append("#include <stddef.h>\n")
    builder.append("#include <stdbool.h>\n\n")
    emit_top_level(arena, root, source, builder)
    return builder.finish()


def emit_c_from_ir(module: &const backend_ir.IRModule, arena: &const SyntaxArena, source: &const String) -> String:
    if module.root.index < 0:
        return emit_c(arena, syntax.missing_node(), source)
    root = module.nodes[module.root.index].syntax
    return emit_c(arena, root, source)


def emit_module_header(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
) -> String:
    header_name = generated_header_name(module_name)
    guard = header_guard(&header_name)
    builder = StringBuilder()
    builder.append("#ifndef ")
    builder.append(guard)
    builder.append("\n#define ")
    builder.append(guard)
    builder.append("\n\n")
    builder.append("#include <stdint.h>\n")
    builder.append("#include <stddef.h>\n")
    builder.append("#include <stdbool.h>\n")
    builder.append("#include <stdio.h>\n")
    builder.append("#include <stdlib.h>\n")
    builder.append("#include <string.h>\n")
    builder.append("#include <math.h>\n")
    builder.append("#include <time.h>\n")
    builder.append("#include \"cinder_runtime.h\"\n")
    emit_common_support(builder)
    for dependency in dependencies:
        if not project.is_builtin_module(&dependency):
            builder.append("#include \"")
            builder.append(generated_header_name(&dependency))
            builder.append("\"\n")
    builder.append("\n")
    prefix = c_prefix(project_name, module_name)
    emitted_specializations: List[String] = []
    emit_module_type_specializations(arena, root, source, builder, emitted_specializations, &prefix, project_name, imports)
    emit_module_declarations(arena, root, source, builder, &prefix, project_name, imports, true)
    builder.append("\n#endif\n")
    return builder.finish()


def emit_common_support(builder: &StringBuilder) -> void:
    builder.append("\n#ifndef CINDER_SELFHOST_COMMON_SUPPORT\n")
    builder.append("#define CINDER_SELFHOST_COMMON_SUPPORT\n")
    builder.append("typedef struct CinderList { void *data; size_t length; size_t capacity; } CinderList;\n")
    builder.append("static inline void cinder_selfhost_list_reserve(CinderList *list, size_t minimum, size_t element_size) {\n")
    builder.append("    if (list->capacity >= minimum) return;\n")
    builder.append("    list->data = cinder_grow_array(list->data, &list->capacity, minimum, element_size);\n")
    builder.append("}\n")
    builder.append("static inline void cinder_selfhost_list_append(CinderList *list, const void *item, size_t element_size) {\n")
    builder.append("    cinder_selfhost_list_reserve(list, list->length + 1, element_size);\n")
    builder.append("    memcpy((char *)list->data + list->length * element_size, item, element_size);\n")
    builder.append("    list->length += 1;\n")
    builder.append("}\n")
    builder.append("static inline void cinder_selfhost_list_pop(CinderList *list) { if (list->length > 0) list->length -= 1; }\n")
    builder.append("static inline void cinder_selfhost_list_clear(CinderList *list) { free(list->data); list->data = NULL; list->length = 0; list->capacity = 0; }\n")
    builder.append("static inline CinderList cinder_selfhost_list_slice(CinderList list, size_t start, size_t stop, size_t element_size) {\n")
    builder.append("    if (start > list.length) start = list.length;\n")
    builder.append("    if (stop > list.length) stop = list.length;\n")
    builder.append("    if (stop < start) stop = start;\n")
    builder.append("    return (CinderList){ .data = (char *)list.data + start * element_size, .length = stop - start, .capacity = 0 };\n")
    builder.append("}\n")
    builder.append("#define cinder_selfhost_list_append_value(list, value) do { __auto_type cinder_value = (value); cinder_selfhost_list_append((list), &cinder_value, sizeof(cinder_value)); } while (0)\n")
    builder.append("static inline void cinder_selfhost_string_builder_append_cstr(CinderStringBuilder *builder, const char *text) {\n")
    builder.append("    CinderString value = cinder_string_from_cstr(text);\n")
    builder.append("    cinder_string_builder_append(builder, &value);\n")
    builder.append("    cinder_string_drop(&value);\n")
    builder.append("}\n")
    builder.append("static inline CinderStringBuilder cinder_selfhost_string_builder_new(void) {\n")
    builder.append("    CinderStringBuilder builder;\n")
    builder.append("    cinder_string_builder_init(&builder);\n")
    builder.append("    return builder;\n")
    builder.append("}\n")
    builder.append("#define cinder_selfhost_string_builder_append_value(builder, value) do { __auto_type cinder_value = (value); cinder_string_builder_append((builder), &cinder_value); } while (0)\n")
    builder.append("static inline uint8_t cinder_selfhost_string_byte_at_value(CinderString value, size_t index) { return cinder_string_byte_at(&value, index); }\n")
    builder.append("static inline void cinder_selfhost_print_string_value(CinderString value, bool first) { printf(first ? \"%s\" : \" %s\", cinder_string_cstr(&value)); }\n")
    builder.append("static inline void cinder_selfhost_print_string_fragment(CinderString value) { printf(\"%s\", cinder_string_cstr(&value)); }\n")
    builder.append("static inline void cinder_selfhost_print_integer_value(long long value, bool first) { printf(first ? \"%lld\" : \" %lld\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_unsigned_value(unsigned long long value, bool first) { printf(first ? \"%llu\" : \" %llu\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_float_value(double value, bool first) { printf(first ? \"%g\" : \" %g\", value); }\n")
    builder.append("static inline void cinder_selfhost_print_bool_value(bool value, bool first) { printf(first ? \"%s\" : \" %s\", value ? \"true\" : \"false\"); }\n")
    builder.append("static inline void cinder_selfhost_print_char_value(char value, bool first) { printf(first ? \"%c\" : \" %c\", (int)value); }\n")
    builder.append("static inline void cinder_selfhost_print_i32_list(const CinderList *list, bool first) { if (!first) printf(\" \"); printf(\"[\"); const int32_t *items = (const int32_t *)list->data; for (size_t index = 0; index < list->length; ++index) { if (index > 0) printf(\", \"); printf(\"%lld\", (long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_i64_list(const CinderList *list, bool first) { if (!first) printf(\" \"); printf(\"[\"); const int64_t *items = (const int64_t *)list->data; for (size_t index = 0; index < list->length; ++index) { if (index > 0) printf(\", \"); printf(\"%lld\", (long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_u64_list(const CinderList *list, bool first) { if (!first) printf(\" \"); printf(\"[\"); const uint64_t *items = (const uint64_t *)list->data; for (size_t index = 0; index < list->length; ++index) { if (index > 0) printf(\", \"); printf(\"%llu\", (unsigned long long)items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_f64_list(const CinderList *list, bool first) { if (!first) printf(\" \"); printf(\"[\"); const double *items = (const double *)list->data; for (size_t index = 0; index < list->length; ++index) { if (index > 0) printf(\", \"); printf(\"%g\", items[index]); } printf(\"]\"); }\n")
    builder.append("static inline void cinder_selfhost_print_string_list(const CinderList *list, bool first) { if (!first) printf(\" \"); printf(\"[\"); const CinderString *items = (const CinderString *)list->data; for (size_t index = 0; index < list->length; ++index) { if (index > 0) printf(\", \"); cinder_print_repr_string(cinder_string_cstr(&items[index])); } printf(\"]\"); }\n")
    builder.append("static inline int cinder_selfhost_compare_i32(const void *left, const void *right) { const int32_t a = *(const int32_t *)left; const int32_t b = *(const int32_t *)right; return (a > b) - (a < b); }\n")
    builder.append("static inline int cinder_selfhost_compare_string(const void *left, const void *right) { return cinder_string_compare_value((const CinderString *)left, (const CinderString *)right); }\n")
    builder.append("static inline void cinder_selfhost_sort_i32(CinderList *list) { cinder_sort(list->data, list->length, sizeof(int32_t), cinder_selfhost_compare_i32); }\n")
    builder.append("static inline void cinder_selfhost_sort_string(CinderList *list) { cinder_sort(list->data, list->length, sizeof(CinderString), cinder_selfhost_compare_string); }\n")
    builder.append("static inline CinderString cinder_selfhost_input_string(CinderString prompt) { return cinder_input(cinder_string_cstr(&prompt)); }\n")
    builder.append("static inline CinderString cinder_selfhost_string_concat(CinderString left, CinderString right) {\n")
    builder.append("    CinderStringBuilder builder;\n")
    builder.append("    cinder_string_builder_init(&builder);\n")
    builder.append("    cinder_string_builder_append(&builder, &left);\n")
    builder.append("    cinder_string_builder_append(&builder, &right);\n")
    builder.append("    return cinder_string_builder_finish(&builder);\n")
    builder.append("}\n")
    builder.append("#define cinder_selfhost_string_equal(left, right) ({ __auto_type cinder_left = (left); __auto_type cinder_right = (right); cinder_string_equal_value(&cinder_left, &cinder_right); })\n")
    builder.append("static inline CinderProcessResult cinder_selfhost_process_run_list(const CinderList *args) {\n")
    builder.append("    const CinderString *items = (const CinderString *)args->data;\n")
    builder.append("    const char **argv = (const char **)cinder_alloc(args->length, sizeof(char *));\n")
    builder.append("    for (size_t index = 0; index < args->length; ++index) argv[index] = cinder_string_cstr(&items[index]);\n")
    builder.append("    return cinder_process_run_argv(args->length, argv);\n")
    builder.append("}\n")
    builder.append("#endif\n\n")


def emit_module_header_from_ir(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
) -> String:
    if module.root.index < 0:
        return emit_module_header(arena, syntax.missing_node(), source, module_name, project_name, dependencies, imports)
    root = module.nodes[module.root.index].syntax
    return emit_module_header(arena, root, source, module_name, project_name, dependencies, imports)


def emit_module_source(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> String:
    header_name = generated_header_name(module_name)
    builder = StringBuilder()
    builder.append("#include \"")
    builder.append(header_name)
    builder.append("\"\n\n")
    prefix = c_prefix(project_name, module_name)
    context = make_module_codegen_context(arena, root, source)
    emit_module_top_level(arena, root, source, builder, &prefix, project_name, imports, is_entry, context)
    return builder.finish()


def emit_module_source_from_ir(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> String:
    if module.root.index < 0:
        return emit_module_source(arena, syntax.missing_node(), source, module_name, project_name, imports, is_entry)
    root = module.nodes[module.root.index].syntax
    return emit_module_source(arena, root, source, module_name, project_name, imports, is_entry)


def emit_top_level(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_top_level(arena, arena.children[node.first_child + offset], source, builder)
        return
    if node.kind == SyntaxKind.STRUCT_DECL:
        emit_struct(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        emit_enum(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        emit_union(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        emit_function(arena, id, source, builder)
        return


def emit_struct(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef struct ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    int32_t ")
            append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_enum(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef enum ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.ENUM_MEMBER_DECL:
            if emitted:
                builder.append(",\n")
            builder.append("    ")
            append_source(builder, source, node.value_start, node.value_length)
            builder.append("_")
            append_source(builder, source, child.value_start, child.value_length)
            emitted = true
    if emitted:
        builder.append("\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_union(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef union ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    int32_t ")
            append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_module_struct(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef struct ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    ")
            field_type = find_child_type(arena, child_id)
            if context_type_is_array(arena, field_type):
                emit_module_typed_declarator(arena, field_type, source, builder, prefix, project_name, imports, child.value_start, child.value_length)
            else:
                emit_module_c_type(arena, field_type, source, builder, prefix, project_name, imports)
                builder.append(" ")
                append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(";\n\n")
    context = make_module_codegen_context(arena, id, source)
    emit_module_methods(arena, id, source, builder, prefix, project_name, imports, true, context)


def emit_module_union(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef union ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    ")
            field_type = find_child_type(arena, child_id)
            if context_type_is_array(arena, field_type):
                emit_module_typed_declarator(arena, field_type, source, builder, prefix, project_name, imports, child.value_start, child.value_length)
            else:
                emit_module_c_type(arena, field_type, source, builder, prefix, project_name, imports)
                builder.append(" ")
                append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_module_enum(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder, prefix: &const String) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef enum ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(" {\n")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.ENUM_MEMBER_DECL:
            if emitted:
                builder.append(",\n")
            builder.append("    ")
            emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
            builder.append("_")
            append_source(builder, source, child.value_start, child.value_length)
            emitted = true
    if emitted:
        builder.append("\n")
    builder.append("} ")
    emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_module_methods(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    declarations_only: bool,
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    owner_start = node.value_start
    owner_length = node.value_length
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FUNCTION_DECL:
            emit_module_return_type(arena, child_id, source, builder, prefix, project_name, imports, false)
            builder.append(" ")
            emit_prefixed_name(builder, prefix, source, owner_start, owner_length)
            builder.append("_")
            append_source(builder, source, child.value_start, child.value_length)
            builder.append("(")
            emit_module_parameters(arena, child_id, source, builder, prefix, project_name, imports)
            if declarations_only:
                builder.append(");\n")
                builder.append("#define ")
                append_source(builder, source, child.value_start, child.value_length)
                builder.append(" ")
                emit_prefixed_name(builder, prefix, source, owner_start, owner_length)
                builder.append("_")
                append_source(builder, source, child.value_start, child.value_length)
                builder.append("\n")
            else:
                builder.append(") {\n")
                body = find_child_kind(arena, child_id, SyntaxKind.BLOCK)
                if body.index >= 0:
                    context.current_owner = source[owner_start:owner_start + owner_length]
                    context.local_start = len(context.local_types)
                    context.pointer_start = len(context.pointer_names)
                    register_module_parameters(arena, child_id, source, context)
                    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context)
                builder.append("}\n\n")


def emit_function(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    return_type = find_direct_child_kind(arena, id, SyntaxKind.TYPE_NAME)
    emit_c_type(arena, return_type, source, builder)
    builder.append(" ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append("(")
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_parameter(arena, child_id, source, builder)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")
    builder.append(") {\n")
    body = find_child_kind(arena, id, SyntaxKind.BLOCK)
    if body.index >= 0:
        emit_block(arena, body, source, builder)
    builder.append("}\n\n")


def emit_parameter(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    parameter_type = find_child_kind(arena, id, SyntaxKind.TYPE_NAME)
    emit_c_type(arena, parameter_type, source, builder)
    builder.append(" ")
    append_source(builder, source, node.value_start, node.value_length)


def emit_block(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_statement(arena, arena.children[node.first_child + offset], source, builder)


def emit_statement(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.RETURN_STMT:
        builder.append("    return")
        expr = first_child(arena, id)
        if expr.index >= 0:
            builder.append(" ")
            emit_expression(arena, expr, source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        builder.append("    int32_t ")
        append_source(builder, source, node.value_start, node.value_length)
        expr = last_child(arena, id)
        if expr.index >= 0 and arena.nodes[expr.index].kind != SyntaxKind.TYPE_NAME:
            builder.append(" = ")
            emit_expression(arena, expr, source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        builder.append("    ")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(" = ")
        emit_expression(arena, second_child(arena, id), source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.IF_STMT:
        emit_if(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.WHILE_STMT:
        builder.append("    while (")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(") {\n")
        emit_block(arena, second_child(arena, id), source, builder)
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.BREAK_STMT:
        builder.append("    break;\n")
        return
    if node.kind == SyntaxKind.CONTINUE_STMT:
        builder.append("    continue;\n")
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        builder.append("    ")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.PASS_STMT:
        builder.append("    ;\n")


def emit_if(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    builder.append("    if (")
    emit_expression(arena, first_child(arena, id), source, builder)
    builder.append(") {\n")
    emit_block(arena, second_child(arena, id), source, builder)
    builder.append("    }")
    node = arena.nodes[id.index]
    for offset in range(2, node.child_count):
        branch_id = arena.children[node.first_child + offset]
        branch = arena.nodes[branch_id.index]
        if branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 1:
            builder.append(" else if (")
            emit_expression(arena, first_child(arena, branch_id), source, builder)
            builder.append(") {\n")
            emit_block(arena, second_child(arena, branch_id), source, builder)
            builder.append("    }")
        elif branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 2:
            builder.append(" else {\n")
            emit_block(arena, first_child(arena, branch_id), source, builder)
            builder.append("    }")
    builder.append("\n")


def emit_expression(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL or node.kind == SyntaxKind.EXPR_NAME:
        append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_BINARY:
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(" ")
        append_source(builder, source, node.value_start, node.value_length)
        builder.append(" ")
        emit_expression(arena, second_child(arena, id), source, builder)
        return
    if node.kind == SyntaxKind.EXPR_UNARY:
        append_source(builder, source, node.value_start, node.value_length)
        emit_expression(arena, first_child(arena, id), source, builder)
        return
    if node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, id)
        emit_expression(arena, callee, source, builder)
        builder.append("(")
        emitted_argument = false
        for offset in range(1, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind == SyntaxKind.EXPR_ARGUMENT:
                if emitted_argument:
                    builder.append(", ")
                emit_expression(arena, last_child(arena, child_id), source, builder)
                emitted_argument = true
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_CAST:
        builder.append("(int32_t)(")
        emit_expression(arena, last_child(arena, id), source, builder)
        builder.append(")")
        return
    append_source(builder, source, node.start, node.length)


def first_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child]


def second_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 1:
        return syntax.missing_node()
    return arena.children[node.first_child + 1]


def last_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child + node.child_count - 1]


def find_child_kind(arena: &const SyntaxArena, id: NodeId, kind: SyntaxKind) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == kind:
            return child_id
    return syntax.missing_node()


def find_direct_child_kind(arena: &const SyntaxArena, id: NodeId, kind: SyntaxKind) -> NodeId:
    return find_child_kind(arena, id, kind)


def emit_c_type(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        builder.append("int32_t")
        return
    node = arena.nodes[id.index]
    if range_text_equals(source, node.value_start, node.value_length, "void"):
        builder.append("void")
    elif range_text_equals(source, node.value_start, node.value_length, "bool"):
        builder.append("bool")
    elif range_text_equals(source, node.value_start, node.value_length, "i8"):
        builder.append("int8_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i16"):
        builder.append("int16_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i32"):
        builder.append("int32_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i64"):
        builder.append("int64_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u8"):
        builder.append("uint8_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u16"):
        builder.append("uint16_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u32"):
        builder.append("uint32_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u64"):
        builder.append("uint64_t")
    elif range_text_equals(source, node.value_start, node.value_length, "usize"):
        builder.append("size_t")
    elif range_text_equals(source, node.value_start, node.value_length, "isize"):
        builder.append("ptrdiff_t")
    elif range_text_equals(source, node.value_start, node.value_length, "f64"):
        builder.append("double")
    elif range_text_equals(source, node.value_start, node.value_length, "f32"):
        builder.append("float")
    elif range_text_equals(source, node.value_start, node.value_length, "char"):
        builder.append("char")
    elif range_text_equals(source, node.value_start, node.value_length, "c_int"):
        builder.append("int")
    elif range_text_equals(source, node.value_start, node.value_length, "c_long"):
        builder.append("long")
    elif range_text_equals(source, node.value_start, node.value_length, "c_size_t"):
        builder.append("size_t")
    elif range_text_equals(source, node.value_start, node.value_length, "String"):
        builder.append("CinderString")
    elif range_text_equals(source, node.value_start, node.value_length, "StringBuilder"):
        builder.append("CinderStringBuilder")
    else:
        builder.append("int32_t")


def emit_module_c_type(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    if id.index < 0:
        builder.append("int32_t")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.TYPE_REFERENCE:
        child = first_child(arena, id)
        value_child = child
        if value_child.index >= 0 and arena.nodes[value_child.index].kind == SyntaxKind.TYPE_CONST:
            value_child = first_child(arena, value_child)
        if value_child.index >= 0 and context_type_name_equals(arena, value_child, source, "File"):
            emit_module_c_type(arena, value_child, source, builder, prefix, project_name, imports)
            return
        if child.index >= 0 and arena.nodes[child.index].kind == SyntaxKind.TYPE_CONST:
            builder.append("const ")
            emit_module_c_type(arena, first_child(arena, child), source, builder, prefix, project_name, imports)
            builder.append(" *")
        else:
            emit_module_c_type(arena, child, source, builder, prefix, project_name, imports)
            builder.append(" *")
        return
    if node.kind == SyntaxKind.TYPE_POINTER:
        emit_module_c_type(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        builder.append(" *")
        return
    if node.kind == SyntaxKind.TYPE_CONST:
        builder.append("const ")
        emit_module_c_type(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        return
    if node.kind == SyntaxKind.TYPE_GENERIC:
        base = first_child(arena, id)
        if base.index >= 0:
            base_node = arena.nodes[base.index]
            if is_runtime_generic_name(source, base_node, "List") or is_runtime_generic_name(source, base_node, "Set") or is_runtime_generic_name(source, base_node, "Map") or is_runtime_generic_name(source, base_node, "Option") or is_runtime_generic_name(source, base_node, "Result") or is_runtime_generic_name(source, base_node, "Owned") or is_runtime_generic_name(source, base_node, "Tuple"):
                emit_specialized_type_name(arena, id, source, builder, prefix, project_name, imports)
                return
        emit_module_nominal_type(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        return
    if node.kind == SyntaxKind.TYPE_SLICE:
        builder.append("CinderList")
        return
    if node.kind == SyntaxKind.TYPE_DYN or node.kind == SyntaxKind.TYPE_FUNCTION or node.kind == SyntaxKind.TYPE_CLOSURE:
        builder.append("void *")
        return
    if node.kind == SyntaxKind.TYPE_ARRAY:
        emit_module_c_type(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        builder.append(" *")
        return
    if node.kind == SyntaxKind.TYPE_NAME:
        emit_module_nominal_type(arena, id, source, builder, prefix, project_name, imports)
        return
    builder.append("int32_t")


def is_runtime_generic_name(source: &const String, node: &const syntax.SyntaxNode, expected: String) -> bool:
    return range_text_equals(source, node.value_start, node.value_length, expected)


def emit_specialized_type_name(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_REFERENCE:
        emit_specialized_type_name(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        builder.append("_ptr")
        return
    if node.kind == SyntaxKind.TYPE_CONST:
        emit_specialized_type_name(arena, first_child(arena, id), source, builder, prefix, project_name, imports)
        return
    if node.kind == SyntaxKind.TYPE_GENERIC:
        base = first_child(arena, id)
        base_node = arena.nodes[base.index]
        builder.append("Cinder")
        append_source(builder, source, base_node.value_start, base_node.value_length)
        offset: i32 = 1
        while offset < node.child_count:
            builder.append("_")
            emit_specialized_type_name(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports)
            offset += 1
        return
    if node.kind == SyntaxKind.TYPE_NAME:
        if range_text_equals(source, node.value_start, node.value_length, "File"):
            builder.append("FILE")
        elif is_specialization_builtin_name(source, node):
            append_source(builder, source, node.value_start, node.value_length)
        else:
            emit_specialized_nominal_identity(arena, id, source, builder, prefix, project_name, imports)
        return
    builder.append("value")


def emit_specialized_nominal_identity(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    if node.child_count > 1:
        first = arena.children[node.first_child]
        first_node = arena.nodes[first.index]
        alias = source[first_node.value_start:first_node.value_start + first_node.value_length]
        imported_alias = find_import_alias(imports, &alias)
        if len(imported_alias.module_name) > 0:
            builder.append(c_prefix(project_name, &imported_alias.module_name))
            offset: i32 = 1
            while offset < node.child_count:
                if offset > 1:
                    builder.append("_")
                part = arena.nodes[arena.children[node.first_child + offset].index]
                append_source(builder, source, part.value_start, part.value_length)
                offset += 1
            return
    name = source[node.value_start:node.value_start + node.value_length]
    imported = find_import_member(imports, &name)
    if len(imported.module_name) > 0 and len(imported.member) > 0:
        builder.append(c_prefix(project_name, &imported.module_name))
        builder.append(imported.member)
        return
    builder.append(prefix[0:len(prefix)])
    offset: i32 = 0
    while offset < node.child_count:
        if offset > 0:
            builder.append("_")
        part = arena.nodes[arena.children[node.first_child + offset].index]
        append_source(builder, source, part.value_start, part.value_length)
        offset += 1


def is_specialization_builtin_name(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    return range_text_equals(source, node.value_start, node.value_length, "void") or range_text_equals(source, node.value_start, node.value_length, "bool") or range_text_equals(source, node.value_start, node.value_length, "i8") or range_text_equals(source, node.value_start, node.value_length, "i16") or range_text_equals(source, node.value_start, node.value_length, "i32") or range_text_equals(source, node.value_start, node.value_length, "i64") or range_text_equals(source, node.value_start, node.value_length, "u8") or range_text_equals(source, node.value_start, node.value_length, "u16") or range_text_equals(source, node.value_start, node.value_length, "u32") or range_text_equals(source, node.value_start, node.value_length, "u64") or range_text_equals(source, node.value_start, node.value_length, "f32") or range_text_equals(source, node.value_start, node.value_length, "f64") or range_text_equals(source, node.value_start, node.value_length, "char") or range_text_equals(source, node.value_start, node.value_length, "usize") or range_text_equals(source, node.value_start, node.value_length, "isize") or range_text_equals(source, node.value_start, node.value_length, "c_int") or range_text_equals(source, node.value_start, node.value_length, "c_long") or range_text_equals(source, node.value_start, node.value_length, "c_size_t") or range_text_equals(source, node.value_start, node.value_length, "String") or range_text_equals(source, node.value_start, node.value_length, "StringBuilder") or range_text_equals(source, node.value_start, node.value_length, "clock_t")


def string_list_contains(values: &const List[String], expected: &const String) -> bool:
    for value in values:
        if value == expected:
            return true
    return false


def emit_module_type_specializations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_module_type_specializations(arena, arena.children[node.first_child + offset], source, builder, emitted, prefix, project_name, imports)
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return
    base = first_child(arena, id)
    if base.index < 0:
        return
    base_node = arena.nodes[base.index]
    is_collection = is_runtime_generic_name(source, base_node, "List") or is_runtime_generic_name(source, base_node, "Set") or is_runtime_generic_name(source, base_node, "Map")
    is_scalar_wrapper = is_runtime_generic_name(source, base_node, "Option") or is_runtime_generic_name(source, base_node, "Result") or is_runtime_generic_name(source, base_node, "Owned") or is_runtime_generic_name(source, base_node, "Tuple")
    if not is_collection and not is_scalar_wrapper:
        return
    name_builder = StringBuilder()
    emit_specialized_type_name(arena, id, source, name_builder, prefix, project_name, imports)
    name = name_builder.finish()
    if string_list_contains(emitted, &name):
        return
    builder.append("#ifndef CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n")
    if is_collection:
        builder.append("typedef CinderList ")
    else:
        builder.append("typedef int32_t ")
    builder.append(name[0:len(name)])
    builder.append(";\n#endif\n")
    emitted.append(name)


def context_type_is_array(arena: &const SyntaxArena, type_id: NodeId) -> bool:
    if type_id.index < 0:
        return false
    return type_node_kind(arena, type_id) == SyntaxKind.TYPE_ARRAY


def array_length_node(arena: &const SyntaxArena, type_id: NodeId) -> NodeId:
    if type_id.index < 0 or type_node_kind(arena, type_id) != SyntaxKind.TYPE_ARRAY:
        return syntax.missing_node()
    return second_child(arena, type_id)


def append_node_numeric_literal(builder: &StringBuilder, arena: &const SyntaxArena, source: &const String, id: NodeId) -> void:
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    append_numeric_literal(builder, source, node.value_start, node.value_length)


def emit_module_typed_declarator(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
) -> void:
    base_type = type_id
    while base_type.index >= 0 and type_node_kind(arena, base_type) == SyntaxKind.TYPE_ARRAY:
        base_type = first_child(arena, base_type)
    emit_module_c_type(arena, base_type, source, builder, prefix, project_name, imports)
    builder.append(" ")
    append_source(builder, source, name_start, name_length)
    current = type_id
    while current.index >= 0 and type_node_kind(arena, current) == SyntaxKind.TYPE_ARRAY:
        builder.append("[")
        length = array_length_node(arena, current)
        if length.index >= 0:
            length_node = arena.nodes[length.index]
            append_numeric_literal(builder, source, length_node.value_start, length_node.value_length)
        builder.append("]")
        current = first_child(arena, current)


def emit_module_prefixed_typed_declarator(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
) -> void:
    base_type = type_id
    while base_type.index >= 0 and type_node_kind(arena, base_type) == SyntaxKind.TYPE_ARRAY:
        base_type = first_child(arena, base_type)
    emit_module_c_type(arena, base_type, source, builder, prefix, project_name, imports)
    builder.append(" ")
    emit_prefixed_name(builder, prefix, source, name_start, name_length)
    current = type_id
    while current.index >= 0 and type_node_kind(arena, current) == SyntaxKind.TYPE_ARRAY:
        builder.append("[")
        length = array_length_node(arena, current)
        if length.index >= 0:
            length_node = arena.nodes[length.index]
            append_numeric_literal(builder, source, length_node.value_start, length_node.value_length)
        builder.append("]")
        current = first_child(arena, current)


def emit_module_array_initializer(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_LIST:
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        return
    node = arena.nodes[id.index]
    builder.append("{")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if child_id.index >= 0 and not is_type_kind(arena.nodes[child_id.index].kind):
            if emitted:
                builder.append(", ")
            emit_module_array_initializer(arena, child_id, source, builder, prefix, project_name, imports, context)
            emitted = true
    builder.append("}")


def emit_array_as_list(
    arena: &const SyntaxArena,
    id: NodeId,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    builder.append("(CinderList){ .data = (void *)")
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
    builder.append(", .length = ")
    length = array_length_node(context.type_arena, type_id)
    append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
    builder.append(", .capacity = 0 }")


def emit_module_nominal_type(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    if id.index < 0:
        builder.append("int32_t")
        return
    node = arena.nodes[id.index]
    if range_text_equals(source, node.value_start, node.value_length, "void"):
        builder.append("void")
    elif range_text_equals(source, node.value_start, node.value_length, "bool"):
        builder.append("bool")
    elif range_text_equals(source, node.value_start, node.value_length, "i8"):
        builder.append("int8_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i16"):
        builder.append("int16_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i32"):
        builder.append("int32_t")
    elif range_text_equals(source, node.value_start, node.value_length, "i64"):
        builder.append("int64_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u16"):
        builder.append("uint16_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u32"):
        builder.append("uint32_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u64"):
        builder.append("uint64_t")
    elif range_text_equals(source, node.value_start, node.value_length, "f64"):
        builder.append("double")
    elif range_text_equals(source, node.value_start, node.value_length, "f32"):
        builder.append("float")
    elif range_text_equals(source, node.value_start, node.value_length, "char"):
        builder.append("char")
    elif range_text_equals(source, node.value_start, node.value_length, "c_int"):
        builder.append("int")
    elif range_text_equals(source, node.value_start, node.value_length, "c_long"):
        builder.append("long")
    elif range_text_equals(source, node.value_start, node.value_length, "c_size_t"):
        builder.append("size_t")
    elif range_text_equals(source, node.value_start, node.value_length, "u8"):
        builder.append("uint8_t")
    elif range_text_equals(source, node.value_start, node.value_length, "usize"):
        builder.append("size_t")
    elif range_text_equals(source, node.value_start, node.value_length, "isize"):
        builder.append("ptrdiff_t")
    elif range_text_equals(source, node.value_start, node.value_length, "String"):
        builder.append("CinderString")
    elif range_text_equals(source, node.value_start, node.value_length, "StringBuilder"):
        builder.append("CinderStringBuilder")
    elif range_text_equals(source, node.value_start, node.value_length, "File"):
        builder.append("FILE *")
    elif range_text_equals(source, node.value_start, node.value_length, "clock_t"):
        builder.append("clock_t")
    else:
        if node.child_count > 1:
            first = arena.children[node.first_child]
            second = arena.children[node.first_child + 1]
            first_node = arena.nodes[first.index]
            second_node = arena.nodes[second.index]
            alias = source[first_node.value_start:first_node.value_start + first_node.value_length]
            imported_alias = find_import_alias(imports, &alias)
            if len(imported_alias.module_name) > 0:
                imported_prefix = c_prefix(project_name, &imported_alias.module_name)
                builder.append(imported_prefix)
                append_source(builder, source, second_node.value_start, second_node.value_length)
                return
        name = source[node.value_start:node.value_start + node.value_length]
        imported = find_import_member(imports, &name)
        if len(imported.module_name) > 0 and len(imported.member) > 0:
            imported_prefix = c_prefix(project_name, &imported.module_name)
            builder.append(imported_prefix)
            builder.append(imported.member)
        else:
            builder.append(prefix[0:len(prefix)])
            append_source(builder, source, node.value_start, node.value_length)


def emit_prefixed_name(builder: &StringBuilder, prefix: &const String, source: &const String, start: usize, length: usize) -> void:
    builder.append(prefix[0:len(prefix)])
    append_source(builder, source, start, length)


def find_child_type(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.TYPE_NAME or child.kind == SyntaxKind.TYPE_GENERIC or child.kind == SyntaxKind.TYPE_CONST or child.kind == SyntaxKind.TYPE_POINTER or child.kind == SyntaxKind.TYPE_REFERENCE or child.kind == SyntaxKind.TYPE_ARRAY or child.kind == SyntaxKind.TYPE_SLICE or child.kind == SyntaxKind.TYPE_DYN or child.kind == SyntaxKind.TYPE_FUNCTION or child.kind == SyntaxKind.TYPE_CLOSURE:
            return child_id
    return syntax.missing_node()


def type_node_kind(arena: &const SyntaxArena, id: NodeId) -> SyntaxKind:
    if id.index < 0:
        return SyntaxKind.MODULE
    return arena.nodes[id.index].kind


def make_module_codegen_context(arena: &const SyntaxArena, root: NodeId, source: &const String) -> ModuleCodegenContext:
    local_types: List[ModuleNameTypeBinding] = []
    pointer_names: List[String] = []
    field_types: List[ModuleFieldTypeBinding] = []
    deferred_expressions: List[NodeId] = []
    with_resources: List[String] = []
    global_names: List[String] = []
    extern_names: List[String] = []
    context = ModuleCodegenContext(
        root=root,
        type_arena=arena,
        type_source=source,
        local_types=local_types,
        pointer_names=pointer_names,
        field_types=field_types,
        current_owner="",
        local_start=0,
        pointer_start=0,
        deferred_expressions=deferred_expressions,
        with_resources=with_resources,
        global_names=global_names,
        extern_names=extern_names,
    )
    collect_module_field_types(arena, root, source, context)
    collect_module_global_names(arena, root, source, context)
    collect_module_extern_names(arena, root, source, context)
    return context


def collect_module_extern_names(arena: &const SyntaxArena, id: NodeId, source: &const String, context: &ModuleCodegenContext) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.FUNCTION_DECL and node.flags == 1:
        context.extern_names.append(source[node.value_start:node.value_start + node.value_length])
        return
    if node.kind == SyntaxKind.MODULE or node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            collect_module_extern_names(arena, arena.children[node.first_child + offset], source, context)


def context_name_is_extern(context: &ModuleCodegenContext, name: &const String) -> bool:
    for extern_name in context.extern_names:
        if extern_name == name[0:len(name)]:
            return true
    return false


def context_has_function_name(arena: &const SyntaxArena, id: NodeId, source: &const String, name: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.FUNCTION_DECL:
        return range_text_equals(source, node.value_start, node.value_length, name[0:len(name)])
    if node.kind == SyntaxKind.MODULE or node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            if context_has_function_name(arena, arena.children[node.first_child + offset], source, name):
                return true
    return false


def find_function_return_type(arena: &const SyntaxArena, id: NodeId, source: &const String, name: &const String) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.FUNCTION_DECL and range_text_equals(source, node.value_start, node.value_length, name[0:len(name)]):
        return find_child_type(arena, id)
    if node.kind == SyntaxKind.MODULE or node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            found = find_function_return_type(arena, arena.children[node.first_child + offset], source, name)
            if found.index >= 0:
                return found
    return syntax.missing_node()


def collect_module_global_names(arena: &const SyntaxArena, id: NodeId, source: &const String, context: &ModuleCodegenContext) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            collect_module_global_names(arena, arena.children[node.first_child + offset], source, context)
        return
    if node.kind == SyntaxKind.GLOBAL_DECL:
        context.global_names.append(source[node.value_start:node.value_start + node.value_length])


def collect_module_field_types(arena: &const SyntaxArena, id: NodeId, source: &const String, context: &ModuleCodegenContext) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            collect_module_field_types(arena, arena.children[node.first_child + offset], source, context)
        return
    if node.kind == SyntaxKind.STRUCT_DECL or node.kind == SyntaxKind.CLASS_DECL or node.kind == SyntaxKind.UNION_DECL:
        owner = source[node.value_start:node.value_start + node.value_length]
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind == SyntaxKind.FIELD_DECL:
                field_type = find_child_type(arena, child_id)
                context.field_types.append(
                    ModuleFieldTypeBinding(
                        owner=owner[0:len(owner)],
                        field=source[child.value_start:child.value_start + child.value_length],
                        type_id=field_type,
                    )
                )


def register_context_name_type(arena: &const SyntaxArena, context: &ModuleCodegenContext, source: &const String, start: usize, length: usize, type_id: NodeId) -> void:
    if length == 0:
        return
    name = source[start:start + length]
    context.local_types.append(ModuleNameTypeBinding(name=name[0:len(name)], type_id=type_id, moved=false))
    if type_id.index >= 0 and context_type_is_pointer_like(arena, type_id):
        context.pointer_names.append(name[0:len(name)])


def register_context_pointer_name(context: &ModuleCodegenContext, source: &const String, start: usize, length: usize) -> void:
    if length == 0:
        return
    context.pointer_names.append(source[start:start + length])


def register_module_parameters(arena: &const SyntaxArena, id: NodeId, source: &const String, context: &ModuleCodegenContext) -> void:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            register_context_name_type(arena, context, source, child.value_start, child.value_length, find_child_type(arena, child_id))


def context_name_type(context: &ModuleCodegenContext, name: &const String) -> NodeId:
    index = len(context.local_types)
    while index > context.local_start:
        index -= 1
        if context.local_types[index].name == name[0:len(name)]:
            return context.local_types[index].type_id
    return syntax.missing_node()


def context_name_is_global(context: &ModuleCodegenContext, name: &const String) -> bool:
    index = len(context.local_types)
    while index > context.local_start:
        index -= 1
        if context.local_types[index].name == name[0:len(name)]:
            return false
    for global_name in context.global_names:
        if global_name == name[0:len(name)]:
            return true
    return false


def context_type_needs_drop(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        return node.flags == cast[i32](token.TokenKind.STRING)
    if node.kind == SyntaxKind.EXPR_CALL:
        return context_type_is_string(arena, type_id, source)
    if node.kind == SyntaxKind.EXPR_LIST or node.kind == SyntaxKind.EXPR_MAP or node.kind == SyntaxKind.EXPR_SET:
        return true
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return false
    if node.kind == SyntaxKind.TYPE_NAME:
        return range_text_equals(source, node.value_start, node.value_length, "String") or range_text_equals(source, node.value_start, node.value_length, "StringBuilder")
    if node.kind == SyntaxKind.TYPE_GENERIC:
        base = first_child(arena, type_id)
        if base.index < 0:
            return false
        base_node = arena.nodes[base.index]
        return range_text_equals(source, base_node.value_start, base_node.value_length, "List")
    return false


def mark_context_expression_moved(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_NAME:
        return
    name = source[node.value_start:node.value_start + node.value_length]
    index = len(context.local_types)
    while index > context.local_start:
        index -= 1
        if context.local_types[index].name == name[0:len(name)]:
            if context_type_needs_drop(arena, context.local_types[index].type_id, source):
                context.local_types[index].moved = true
            return


def mark_context_expression_live(context: &ModuleCodegenContext, id: NodeId, arena: &const SyntaxArena, source: &const String) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_NAME:
        return
    name = source[node.value_start:node.value_start + node.value_length]
    index = len(context.local_types)
    while index > context.local_start:
        index -= 1
        if context.local_types[index].name == name[0:len(name)]:
            context.local_types[index].moved = false
            return


def context_has_name(context: &ModuleCodegenContext, source: &const String, start: usize, length: usize) -> bool:
    if length == 0:
        return false
    name = source[start:start + length]
    local_index = len(context.local_types)
    while local_index > context.local_start:
        local_index -= 1
        if context.local_types[local_index].name == name[0:len(name)]:
            return true
    pointer_index = len(context.pointer_names)
    while pointer_index > context.pointer_start:
        pointer_index -= 1
        if context.pointer_names[pointer_index] == name[0:len(name)]:
            return true
    return false


def context_name_is_pointer(arena: &const SyntaxArena, context: &ModuleCodegenContext, name: &const String) -> bool:
    pointer_index = len(context.pointer_names)
    while pointer_index > context.pointer_start:
        pointer_index -= 1
        if context.pointer_names[pointer_index] == name[0:len(name)]:
            return true
    binding_type = context_name_type(context, name)
    return context_type_is_pointer_like(context.type_arena, binding_type)


def context_type_is_pointer_like(arena: &const SyntaxArena, type_id: NodeId) -> bool:
    if type_id.index < 0:
        return false
    kind = arena.nodes[type_id.index].kind
    if kind == SyntaxKind.EXPR_UNARY:
        return arena.nodes[type_id.index].flags == cast[i32](token.TokenKind.AMPERSAND)
    return kind == SyntaxKind.TYPE_POINTER or kind == SyntaxKind.TYPE_REFERENCE


def context_type_is_list(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LIST:
        return true
    if node.kind == SyntaxKind.TYPE_ARRAY or node.kind == SyntaxKind.TYPE_SLICE:
        return true
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return context_type_is_list(arena, first_child(arena, type_id), source)
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return false
    base = first_child(arena, type_id)
    if base.index < 0:
        return false
    base_node = arena.nodes[base.index]
    return range_text_equals(source, base_node.value_start, base_node.value_length, "List") or range_text_equals(source, base_node.value_start, base_node.value_length, "Slice")


def context_list_element_type(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> NodeId:
    if type_id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LIST:
        if node.child_count > 0:
            return arena.children[node.first_child]
        return syntax.missing_node()
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return context_list_element_type(arena, first_child(arena, type_id), source)
    if node.kind == SyntaxKind.TYPE_ARRAY:
        return first_child(arena, type_id)
    if node.kind == SyntaxKind.TYPE_SLICE:
        return first_child(arena, type_id)
    if node.kind == SyntaxKind.TYPE_GENERIC:
        base = first_child(arena, type_id)
        if base.index >= 0:
            base_node = arena.nodes[base.index]
            if range_text_equals(source, base_node.value_start, base_node.value_length, "List") or range_text_equals(source, base_node.value_start, base_node.value_length, "Slice"):
                if node.child_count > 1:
                    return arena.children[node.first_child + 1]
    return syntax.missing_node()


def context_type_owner_name(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> String:
    if type_id.index < 0:
        return ""
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, type_id)
        if callee.index >= 0:
            callee_node = arena.nodes[callee.index]
            if callee_node.kind == SyntaxKind.EXPR_NAME:
                return source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
    if node.kind == SyntaxKind.EXPR_NAME:
        return source[node.value_start:node.value_start + node.value_length]
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return context_type_owner_name(arena, first_child(arena, type_id), source)
    if node.kind == SyntaxKind.TYPE_GENERIC:
        return context_type_owner_name(arena, first_child(arena, type_id), source)
    if node.kind == SyntaxKind.TYPE_NAME:
        if node.child_count > 1:
            second = arena.children[node.first_child + 1]
            second_node = arena.nodes[second.index]
            return source[second_node.value_start:second_node.value_start + second_node.value_length]
        return source[node.value_start:node.value_start + node.value_length]
    return ""


def context_field_type(context: &ModuleCodegenContext, owner: &const String, field: &const String) -> NodeId:
    index = len(context.field_types)
    while index > 0:
        index -= 1
        if context.field_types[index].owner == owner[0:len(owner)] and context.field_types[index].field == field[0:len(field)]:
            return context.field_types[index].type_id
    return syntax.missing_node()


def context_field_type_for_receiver(
    arena: &const SyntaxArena,
    context: &ModuleCodegenContext,
    receiver: NodeId,
    member: NodeId,
    source: &const String,
) -> NodeId:
    if receiver.index < 0 or member.index < 0:
        return syntax.missing_node()
    member_node = arena.nodes[member.index]
    field_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind == SyntaxKind.EXPR_NAME:
        receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
        if receiver_name == "self" and len(context.current_owner) > 0:
            return context_field_type(context, &context.current_owner, &field_name)
    receiver_type = context_expression_type(arena, context, receiver, source)
    owner = context_type_owner_name(context.type_arena, receiver_type, context.type_source)
    if len(owner) > 0:
        return context_field_type(context, &owner, &field_name)
    return syntax.missing_node()


def context_expression_type(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL or node.kind == SyntaxKind.EXPR_LIST or node.kind == SyntaxKind.EXPR_MAP or node.kind == SyntaxKind.EXPR_SET or node.kind == SyntaxKind.EXPR_TUPLE or node.kind == SyntaxKind.EXPR_ALLOC:
        return id
    if node.kind == SyntaxKind.EXPR_SLICE:
        receiver_type = context_expression_type(arena, context, first_child(arena, id), source)
        if context_type_is_string(context.type_arena, receiver_type, context.type_source):
            value_type = receiver_type
            while value_type.index >= 0:
                value_kind = type_node_kind(context.type_arena, value_type)
                if value_kind != SyntaxKind.TYPE_REFERENCE and value_kind != SyntaxKind.TYPE_POINTER and value_kind != SyntaxKind.TYPE_CONST:
                    break
                value_type = first_child(context.type_arena, value_type)
            return value_type
        return id
    if node.kind == SyntaxKind.EXPR_CAST:
        return find_child_type(arena, id)
    if node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, id)
        if callee.index >= 0:
            callee_node = arena.nodes[callee.index]
            if callee_node.kind == SyntaxKind.EXPR_NAME:
                if is_uppercase_start(source, callee_node.value_start) or range_text_equals(source, callee_node.value_start, callee_node.value_length, "String") or range_text_equals(source, callee_node.value_start, callee_node.value_length, "input") or range_text_equals(source, callee_node.value_start, callee_node.value_length, "to_string"):
                    return id
                name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
                return_type = find_function_return_type(context.type_arena, context.root, context.type_source, &name)
                if return_type.index >= 0:
                    return return_type
            if context_type_is_string(arena, id, source):
                return id
    if node.kind == SyntaxKind.EXPR_UNARY:
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            return id
        return context_expression_type(arena, context, first_child(arena, id), source)
    if node.kind == SyntaxKind.EXPR_BINARY:
        left_type = context_expression_type(arena, context, first_child(arena, id), source)
        if left_type.index >= 0:
            return left_type
        return context_expression_type(arena, context, second_child(arena, id), source)
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        return context_name_type(context, &name)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        return context_field_type_for_receiver(arena, context, first_child(arena, id), second_child(arena, id), source)
    if node.kind == SyntaxKind.EXPR_INDEX:
        receiver_type = context_expression_type(arena, context, first_child(arena, id), source)
        return context_list_element_type(context.type_arena, receiver_type, context.type_source)
    return syntax.missing_node()


def context_expression_is_pointer_like(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        return context_name_is_pointer(arena, context, &name)
    if node.kind == SyntaxKind.EXPR_UNARY:
        return node.flags == cast[i32](token.TokenKind.AMPERSAND)
    if node.kind == SyntaxKind.EXPR_ALLOC:
        return true
    if node.kind != SyntaxKind.EXPR_ATTRIBUTE and node.kind != SyntaxKind.EXPR_INDEX:
        return false
    expr_type = context_expression_type(arena, context, id, source)
    return context_type_is_pointer_like(context.type_arena, expr_type)


def context_expression_list_element_type(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> NodeId:
    if id.index >= 0 and arena.nodes[id.index].kind == SyntaxKind.EXPR_SLICE:
        receiver = first_child(arena, id)
        return context_expression_list_element_type(arena, context, receiver, source)
    expr_type = context_expression_type(arena, context, id, source)
    return context_list_element_type(context.type_arena, expr_type, context.type_source)


def context_expression_is_pointer_initializer(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_UNARY and node.flags == cast[i32](token.TokenKind.AMPERSAND):
        return true
    return context_expression_is_pointer_like(arena, context, id, source)


def emit_context_drops(arena: &const SyntaxArena, context: &ModuleCodegenContext, source: &const String, builder: &StringBuilder, local_start: usize) -> void:
    index = len(context.local_types)
    while index > local_start:
        index -= 1
        if not context.local_types[index].moved:
            emit_context_drop(arena, context.local_types[index].type_id, source, builder, &context.local_types[index].name)


def emit_context_drop(arena: &const SyntaxArena, type_id: NodeId, source: &const String, builder: &StringBuilder, name: &const String) -> void:
    if type_id.index < 0 or len(name) == 0:
        return
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING):
        builder.append("    cinder_string_drop(&")
        builder.append(name[0:len(name)])
        builder.append(");\n")
        return
    if node.kind == SyntaxKind.EXPR_CALL and context_type_is_string(arena, type_id, source):
        builder.append("    cinder_string_drop(&")
        builder.append(name[0:len(name)])
        builder.append(");\n")
        return
    if node.kind == SyntaxKind.EXPR_LIST or node.kind == SyntaxKind.EXPR_MAP or node.kind == SyntaxKind.EXPR_SET:
        builder.append("    free(")
        builder.append(name[0:len(name)])
        builder.append(".data);\n")
        return
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return
    if node.kind == SyntaxKind.TYPE_NAME:
        if range_text_equals(source, node.value_start, node.value_length, "String"):
            builder.append("    cinder_string_drop(&")
            builder.append(name[0:len(name)])
            builder.append(");\n")
            return
        if range_text_equals(source, node.value_start, node.value_length, "StringBuilder"):
            builder.append("    cinder_string_builder_drop(&")
            builder.append(name[0:len(name)])
            builder.append(");\n")
            return
        return
    if node.kind == SyntaxKind.TYPE_GENERIC:
        base = first_child(arena, type_id)
        if base.index >= 0:
            base_node = arena.nodes[base.index]
            if range_text_equals(source, base_node.value_start, base_node.value_length, "List"):
                builder.append("    free(")
                builder.append(name[0:len(name)])
                builder.append(".data);\n")
                return


def context_type_is_string(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        return node.flags == cast[i32](token.TokenKind.STRING)
    if node.kind == SyntaxKind.EXPR_SLICE:
        return false
    if node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, type_id)
        if callee.index >= 0:
            callee_node = arena.nodes[callee.index]
            if callee_node.kind == SyntaxKind.EXPR_NAME:
                return range_text_equals(source, callee_node.value_start, callee_node.value_length, "String") or range_text_equals(source, callee_node.value_start, callee_node.value_length, "input") or range_text_equals(source, callee_node.value_start, callee_node.value_length, "to_string")
            if callee_node.kind == SyntaxKind.EXPR_ATTRIBUTE:
                member = second_child(arena, callee)
                if member.index >= 0:
                    member_node = arena.nodes[member.index]
                    return range_text_equals(source, member_node.value_start, member_node.value_length, "read_text") or range_text_equals(source, member_node.value_start, member_node.value_length, "finish") or range_text_equals(source, member_node.value_start, member_node.value_length, "trim") or range_text_equals(source, member_node.value_start, member_node.value_length, "strip_quotes") or range_text_equals(source, member_node.value_start, member_node.value_length, "basename") or range_text_equals(source, member_node.value_start, member_node.value_length, "parent_dir") or range_text_equals(source, member_node.value_start, member_node.value_length, "join_path") or range_text_equals(source, member_node.value_start, member_node.value_length, "stem") or range_text_equals(source, member_node.value_start, member_node.value_length, "replace_char") or range_text_equals(source, member_node.value_start, member_node.value_length, "with_suffix")
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        return context_type_is_string(arena, first_child(arena, type_id), source)
    return node.kind == SyntaxKind.TYPE_NAME and range_text_equals(source, node.value_start, node.value_length, "String")


def expression_may_be_string(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING):
        return true
    if node.kind == SyntaxKind.EXPR_SLICE:
        receiver = first_child(arena, id)
        receiver_type = context_expression_type(arena, context, receiver, source)
        if context_type_is_string(context.type_arena, receiver_type, context.type_source):
            return true
        return expression_may_be_string(arena, context, receiver, source)
    if node.kind == SyntaxKind.EXPR_BINARY and node.flags == cast[i32](token.TokenKind.PLUS):
        return expression_may_be_string(arena, context, first_child(arena, id), source) or expression_may_be_string(arena, context, second_child(arena, id), source)
    if node.kind == SyntaxKind.EXPR_INDEX:
        receiver = first_child(arena, id)
        if receiver.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_ATTRIBUTE:
            member = second_child(arena, receiver)
            if member.index >= 0:
                member_node = arena.nodes[member.index]
                if range_text_equals(source, member_node.value_start, member_node.value_length, "include_dirs") or range_text_equals(source, member_node.value_start, member_node.value_length, "library_dirs") or range_text_equals(source, member_node.value_start, member_node.value_length, "libraries") or range_text_equals(source, member_node.value_start, member_node.value_length, "link_files") or range_text_equals(source, member_node.value_start, member_node.value_length, "cflags") or range_text_equals(source, member_node.value_start, member_node.value_length, "ldflags") or range_text_equals(source, member_node.value_start, member_node.value_length, "dependencies"):
                    return true
    expr_type = context_expression_type(arena, context, id, source)
    if context_type_is_string(context.type_arena, expr_type, context.type_source):
        return true
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        member = second_child(arena, id)
        if member.index < 0:
            return false
        member_node = arena.nodes[member.index]
        if range_text_equals(source, member_node.value_start, member_node.value_length, "alias") or range_text_equals(source, member_node.value_start, member_node.value_length, "module_name") or range_text_equals(source, member_node.value_start, member_node.value_length, "member") or range_text_equals(source, member_node.value_start, member_node.value_length, "name") or range_text_equals(source, member_node.value_start, member_node.value_length, "source") or range_text_equals(source, member_node.value_start, member_node.value_length, "output") or range_text_equals(source, member_node.value_start, member_node.value_length, "stdout") or range_text_equals(source, member_node.value_start, member_node.value_length, "stderr") or range_text_equals(source, member_node.value_start, member_node.value_length, "path") or range_text_equals(source, member_node.value_start, member_node.value_length, "root") or range_text_equals(source, member_node.value_start, member_node.value_length, "entry") or range_text_equals(source, member_node.value_start, member_node.value_length, "manifest") or range_text_equals(source, member_node.value_start, member_node.value_length, "project_name") or range_text_equals(source, member_node.value_start, member_node.value_length, "error") or range_text_equals(source, member_node.value_start, member_node.value_length, "source_root"):
            return true
    if node.kind == SyntaxKind.EXPR_NAME and expr_type.index >= 0 and type_node_kind(context.type_arena, expr_type) == SyntaxKind.EXPR_SLICE:
        return expression_may_be_string(context.type_arena, context, expr_type, context.type_source)
    if expr_type.index >= 0:
        return false
    if node.kind == SyntaxKind.EXPR_NAME:
        return range_text_equals(source, node.value_start, node.value_length, "command") or range_text_equals(source, node.value_start, node.value_length, "output") or range_text_equals(source, node.value_start, node.value_length, "c_source") or range_text_equals(source, node.value_start, node.value_length, "path") or range_text_equals(source, node.value_start, node.value_length, "source") or range_text_equals(source, node.value_start, node.value_length, "message") or range_text_equals(source, node.value_start, node.value_length, "text") or range_text_equals(source, node.value_start, node.value_length, "alias") or range_text_equals(source, node.value_start, node.value_length, "module_name") or range_text_equals(source, node.value_start, node.value_length, "member")
    return false

def emit_string_value_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if context_expression_is_pointer_like(arena, context, id, source):
        builder.append("*(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)


def is_type_kind(kind: SyntaxKind) -> bool:
    return kind == SyntaxKind.TYPE_NAME or kind == SyntaxKind.TYPE_GENERIC or kind == SyntaxKind.TYPE_CONST or kind == SyntaxKind.TYPE_POINTER or kind == SyntaxKind.TYPE_REFERENCE or kind == SyntaxKind.TYPE_ARRAY or kind == SyntaxKind.TYPE_SLICE or kind == SyntaxKind.TYPE_DYN or kind == SyntaxKind.TYPE_FUNCTION or kind == SyntaxKind.TYPE_CLOSURE


def append_source(builder: &StringBuilder, source: &const String, start: usize, length: usize) -> void:
    if length == 0:
        return
    builder.append(source[start:start + length])


def append_unquoted_string(builder: &StringBuilder, source: &const String, start: usize, length: usize) -> void:
    if length <= 2:
        return
    builder.append(source[start + 1:start + length - 1])


def range_text_equals(source: &const String, start: usize, length: usize, text: String) -> bool:
    if length != len(text):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true


def emit_module_declarations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, is_entry)
        return
    if node.kind == SyntaxKind.EXTERN_IMPORT_DECL:
        builder.append("#include <")
        append_unquoted_string(builder, source, node.value_start, node.value_length)
        builder.append(">\n")
        return
    if node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            emit_module_declarations(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, is_entry)
        return
    if node.kind == SyntaxKind.STRUCT_DECL:
        emit_module_struct(arena, id, source, builder, prefix, project_name, imports)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        emit_module_enum(arena, id, source, builder, prefix)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        emit_module_union(arena, id, source, builder, prefix, project_name, imports)
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        emit_module_return_type(arena, id, source, builder, prefix, project_name, imports, is_entry)
        builder.append(" ")
        if node.flags == 1:
            builder.append("(")
            append_source(builder, source, node.value_start, node.value_length)
            builder.append(")")
        else:
            emit_module_function_name(arena, id, source, builder, prefix, is_entry)
        builder.append("(")
        emitted_parameter = false
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind == SyntaxKind.PARAMETER:
                if emitted_parameter:
                    builder.append(", ")
                emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports)
                emitted_parameter = true
        if not emitted_parameter:
            builder.append("void")
        builder.append(");\n")
        return
    if node.kind == SyntaxKind.GLOBAL_DECL:
        builder.append("extern ")
        if node.flags == 1:
            builder.append("const ")
        annotation = find_child_type(arena, id)
        if annotation.index >= 0:
            if context_type_is_array(arena, annotation):
                emit_module_prefixed_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length)
            else:
                emit_module_c_type(arena, annotation, source, builder, prefix, project_name, imports)
                builder.append(" ")
                emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        builder.append(";\n")


def emit_module_top_level(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_module_top_level(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, is_entry, context)
        return
    if node.kind == SyntaxKind.EXTERN_IMPORT_DECL or node.kind == SyntaxKind.EXTERN_BLOCK:
        return
    if node.kind == SyntaxKind.STRUCT_DECL:
        emit_module_methods(arena, id, source, builder, prefix, project_name, imports, false, context)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        return
    if node.kind == SyntaxKind.CLASS_DECL:
        emit_module_methods(arena, id, source, builder, prefix, project_name, imports, false, context)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        emit_module_function(arena, id, source, builder, prefix, project_name, imports, is_entry, context)
        return
    if node.kind == SyntaxKind.GLOBAL_DECL:
        if node.flags == 1:
            builder.append("const ")
        annotation = find_child_type(arena, id)
        if annotation.index >= 0:
            if context_type_is_array(arena, annotation):
                emit_module_prefixed_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length)
            else:
                emit_module_c_type(arena, annotation, source, builder, prefix, project_name, imports)
                builder.append(" ")
                emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            emit_prefixed_name(builder, prefix, source, node.value_start, node.value_length)
        initializer = last_child(arena, id)
        if initializer.index >= 0 and not is_type_kind(arena.nodes[initializer.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and context_type_is_array(arena, annotation):
                emit_module_array_initializer(arena, initializer, source, builder, prefix, project_name, imports, context)
            else:
                emit_module_expression(arena, initializer, source, builder, prefix, project_name, imports, context)
        builder.append(";\n\n")
        return


def emit_module_function(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    emit_module_return_type(arena, id, source, builder, prefix, project_name, imports, is_entry)
    builder.append(" ")
    emit_module_function_name(arena, id, source, builder, prefix, is_entry)
    builder.append("(")
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")
    builder.append(") {\n")
    body = find_child_kind(arena, id, SyntaxKind.BLOCK)
    if body.index >= 0:
        context.current_owner = ""
        context.local_start = len(context.local_types)
        context.pointer_start = len(context.pointer_names)
        register_module_parameters(arena, id, source, context)
        emit_module_block(arena, body, source, builder, prefix, project_name, imports, context)
    builder.append("}\n\n")


def emit_module_function_name(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder, prefix: &const String, is_entry: bool) -> void:
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    if is_entry and name == "main":
        builder.append("main")
        return
    builder.append(prefix[0:len(prefix)])
    builder.append(name)


def emit_module_return_type(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> void:
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    if is_entry and name == "main":
        builder.append("int")
        return
    return_type = find_child_type(arena, id)
    emit_module_c_type(arena, return_type, source, builder, prefix, project_name, imports)


def emit_module_parameters(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_module_parameter(arena, child_id, source, builder, prefix, project_name, imports)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")


def emit_module_parameter(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    node = arena.nodes[id.index]
    parameter_type = find_child_type(arena, id)
    if parameter_type.index >= 0 and arena.nodes[parameter_type.index].kind == SyntaxKind.TYPE_FUNCTION:
        emit_module_function_pointer_parameter(arena, parameter_type, source, builder, prefix, project_name, imports, node.value_start, node.value_length)
        return
    emit_module_c_type(arena, parameter_type, source, builder, prefix, project_name, imports)
    builder.append(" ")
    append_source(builder, source, node.value_start, node.value_length)


def emit_module_function_pointer_parameter(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
) -> void:
    node = arena.nodes[type_id.index]
    if node.child_count <= 0:
        builder.append("void (*")
        append_source(builder, source, name_start, name_length)
        builder.append(")(void)")
        return
    return_type = arena.children[node.first_child + node.child_count - 1]
    emit_module_c_type(arena, return_type, source, builder, prefix, project_name, imports)
    builder.append(" (*")
    append_source(builder, source, name_start, name_length)
    builder.append(")(")
    if node.child_count == 1:
        builder.append("void")
    else:
        for offset in range(0, node.child_count - 1):
            if offset > 0:
                builder.append(", ")
            emit_module_c_type(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports)
    builder.append(")")


def emit_module_block(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    local_start = len(context.local_types)
    pointer_start = len(context.pointer_names)
    defer_start = len(context.deferred_expressions)
    for offset in range(0, node.child_count):
        emit_module_statement(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context)
    emit_module_defers(arena, source, builder, prefix, project_name, imports, context, defer_start)
    emit_context_drops(arena, context, source, builder, local_start)
    while len(context.local_types) > local_start:
        context.local_types.pop()
    while len(context.pointer_names) > pointer_start:
        context.pointer_names.pop()
    while len(context.deferred_expressions) > defer_start:
        context.deferred_expressions.pop()


def emit_module_defers(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
    defer_start: usize,
) -> void:
    index = len(context.deferred_expressions)
    while index > defer_start:
        index -= 1
        builder.append("    ")
        emit_module_expression(arena, context.deferred_expressions[index], source, builder, prefix, project_name, imports, context)
        builder.append(";\n")


def emit_module_return_cleanups(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    emit_module_defers(arena, source, builder, prefix, project_name, imports, context, 0)
    index = len(context.with_resources)
    while index > 0:
        index -= 1
        builder.append("    fclose(")
        builder.append(context.with_resources[index])
        builder.append(");\n")


def emit_module_statement(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.RETURN_STMT:
        expr = first_child(arena, id)
        has_cleanups = len(context.deferred_expressions) > 0 or len(context.with_resources) > 0
        if not has_cleanups:
            builder.append("    return")
            if expr.index >= 0:
                builder.append(" ")
                emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
            builder.append(";\n")
            return
        builder.append("    {\n")
        if expr.index >= 0:
            builder.append("    __auto_type cinder_return_value = ")
            emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
            builder.append(";\n")
            mark_context_expression_moved(arena, context, expr, source)
        emit_module_return_cleanups(arena, source, builder, prefix, project_name, imports, context)
        builder.append("    return")
        if expr.index >= 0:
            builder.append(" cinder_return_value")
        builder.append(";\n")
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.DEFER_STMT:
        expr = first_child(arena, id)
        if expr.index >= 0:
            context.deferred_expressions.append(expr)
        return
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        builder.append("    ")
        annotation = find_child_type(arena, id)
        expr = last_child(arena, id)
        if annotation.index >= 0:
            if context_type_is_array(arena, annotation):
                emit_module_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length)
            else:
                emit_module_c_type(arena, annotation, source, builder, prefix, project_name, imports)
                builder.append(" ")
                append_source(builder, source, node.value_start, node.value_length)
        elif expr.index >= 0:
            builder.append("__auto_type")
            builder.append(" ")
            append_source(builder, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            append_source(builder, source, node.value_start, node.value_length)
        if expr.index >= 0 and not is_type_kind(arena.nodes[expr.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and context_type_is_array(arena, annotation):
                emit_module_array_initializer(arena, expr, source, builder, prefix, project_name, imports, context)
            else:
                emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
            mark_context_expression_moved(arena, context, expr, source)
        builder.append(";\n")
        if annotation.index >= 0:
            register_context_name_type(arena, context, source, node.value_start, node.value_length, annotation)
        elif context_expression_is_pointer_initializer(arena, context, expr, source):
            register_context_pointer_name(context, source, node.value_start, node.value_length)
        else:
            inferred_type = context_expression_type(arena, context, expr, source)
            register_context_name_type(arena, context, source, node.value_start, node.value_length, inferred_type)
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        builder.append("    ")
        target = first_child(arena, id)
        if node.flags == cast[i32](token.TokenKind.ASSIGN) and target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            if not context_has_name(context, source, target_node.value_start, target_node.value_length):
                builder.append("__auto_type ")
                emit_module_expression(arena, target, source, builder, prefix, project_name, imports, context)
                builder.append(" = ")
                value = second_child(arena, id)
                emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
                mark_context_expression_moved(arena, context, value, source)
                builder.append(";\n")
                if context_expression_is_pointer_initializer(arena, context, value, source):
                    register_context_pointer_name(context, source, target_node.value_start, target_node.value_length)
                else:
                    inferred_type = context_expression_type(arena, context, value, source)
                    register_context_name_type(arena, context, source, target_node.value_start, target_node.value_length, inferred_type)
                return
        emit_module_assignment_target(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(" ")
        append_assignment_operator(builder, node.flags)
        builder.append(" ")
        value = second_child(arena, id)
        emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
        mark_context_expression_moved(arena, context, value, source)
        mark_context_expression_live(context, first_child(arena, id), arena, source)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.IF_STMT:
        emit_module_if(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.WHILE_STMT:
        builder.append("    while (")
        emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(") {\n")
        emit_module_block(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.WITH_STMT:
        emit_module_with(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.FOR_EACH_STMT:
        emit_module_for_each(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.FOR_C_STMT:
        emit_module_for_c(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.BREAK_STMT:
        builder.append("    break;\n")
        return
    if node.kind == SyntaxKind.CONTINUE_STMT:
        builder.append("    continue;\n")
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        builder.append("    ")
        emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.PASS_STMT:
        builder.append("    ;\n")


def emit_module_assignment_target(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index >= 0:
        node = arena.nodes[id.index]
        if node.kind == SyntaxKind.EXPR_NAME:
            name = source[node.value_start:node.value_start + node.value_length]
            type_id = context_name_type(context, &name)
            if type_id.index >= 0 and type_node_kind(context.type_arena, type_id) == SyntaxKind.TYPE_REFERENCE:
                builder.append("(*")
                append_source(builder, source, node.value_start, node.value_length)
                builder.append(")")
                return
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)


def emit_module_for_c(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count < 4:
        return
    local_start = len(context.local_types)
    pointer_start = len(context.pointer_names)
    builder.append("    for (")
    emit_module_for_clause(arena, arena.children[node.first_child], source, builder, prefix, project_name, imports, context)
    builder.append("; ")
    emit_module_expression(arena, arena.children[node.first_child + 1], source, builder, prefix, project_name, imports, context)
    builder.append("; ")
    emit_module_for_clause(arena, arena.children[node.first_child + 2], source, builder, prefix, project_name, imports, context)
    builder.append(") {\n")
    emit_module_block(arena, arena.children[node.first_child + 3], source, builder, prefix, project_name, imports, context)
    builder.append("    }\n")
    while len(context.local_types) > local_start:
        context.local_types.pop()
    while len(context.pointer_names) > pointer_start:
        context.pointer_names.pop()


def emit_module_for_clause(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        annotation = find_child_type(arena, id)
        expr = last_child(arena, id)
        if annotation.index >= 0:
            if context_type_is_array(arena, annotation):
                emit_module_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length)
            else:
                emit_module_c_type(arena, annotation, source, builder, prefix, project_name, imports)
                builder.append(" ")
                append_source(builder, source, node.value_start, node.value_length)
        else:
            builder.append("__auto_type")
            builder.append(" ")
            append_source(builder, source, node.value_start, node.value_length)
        if expr.index >= 0 and not is_type_kind(arena.nodes[expr.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and context_type_is_array(arena, annotation):
                emit_module_array_initializer(arena, expr, source, builder, prefix, project_name, imports, context)
            else:
                emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
        if annotation.index >= 0:
            register_context_name_type(arena, context, source, node.value_start, node.value_length, annotation)
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        emit_module_assignment_target(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(" ")
        append_assignment_operator(builder, node.flags)
        builder.append(" ")
        emit_module_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)


def emit_module_if(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    builder.append("    if (")
    emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
    builder.append(") {\n")
    emit_module_block(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
    builder.append("    }")
    node = arena.nodes[id.index]
    for offset in range(2, node.child_count):
        branch_id = arena.children[node.first_child + offset]
        branch = arena.nodes[branch_id.index]
        if branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 1:
            builder.append(" else if (")
            emit_module_expression(arena, first_child(arena, branch_id), source, builder, prefix, project_name, imports, context)
            builder.append(") {\n")
            emit_module_block(arena, second_child(arena, branch_id), source, builder, prefix, project_name, imports, context)
            builder.append("    }")
        elif branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 2:
            builder.append(" else {\n")
            emit_module_block(arena, first_child(arena, branch_id), source, builder, prefix, project_name, imports, context)
            builder.append("    }")
    builder.append("\n")


def emit_module_with(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    expr = first_child(arena, id)
    name = second_child(arena, id)
    body = last_child(arena, id)
    name_node = arena.nodes[name.index]
    builder.append("    FILE *")
    append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(" = ")
    emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
    builder.append(";\n")
    register_context_pointer_name(context, source, name_node.value_start, name_node.value_length)
    resource_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    context.with_resources.append(resource_name[0:len(resource_name)])
    builder.append("    if (")
    append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(" == NULL) cinder_panic(\"failed to open file\");\n")
    builder.append("    {\n")
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context)
    context.with_resources.pop()
    builder.append("    }\n")
    builder.append("    fclose(")
    append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(");\n")


def emit_module_for_each(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    target = first_child(arena, id)
    iterable = for_each_iterable(arena, id)
    body = last_child(arena, id)
    target_node = arena.nodes[target.index]
    if is_range_call(arena, iterable, source):
        range_type = context_expression_type(arena, context, range_argument_expression(arena, iterable, 1), source)
        if range_type.index < 0:
            range_type = context_expression_type(arena, context, range_argument_expression(arena, iterable, 0), source)
        builder.append("    for (")
        if range_type.index >= 0 and is_type_kind(type_node_kind(context.type_arena, range_type)):
            emit_module_c_type(context.type_arena, range_type, context.type_source, builder, prefix, project_name, imports)
        else:
            builder.append("int32_t")
        builder.append(" ")
        append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" = ")
        emit_range_argument(arena, iterable, 0, source, builder, prefix, project_name, imports, context)
        builder.append("; ")
        append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" < ")
        emit_range_argument(arena, iterable, 1, source, builder, prefix, project_name, imports, context)
        builder.append("; ")
        append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" += ")
        emit_range_argument(arena, iterable, 2, source, builder, prefix, project_name, imports, context)
        builder.append(") {\n")
        if range_type.index >= 0:
            register_context_name_type(context.type_arena, context, source, target_node.value_start, target_node.value_length, range_type)
        emit_module_block(arena, body, source, builder, prefix, project_name, imports, context)
        if range_type.index >= 0 and len(context.local_types) > 0:
            context.local_types.pop()
        builder.append("    }\n")
        return
    element_type = context_expression_list_element_type(arena, context, iterable, source)
    if element_type.index < 0:
        element_type = find_child_type(arena, id)
    element_name = ""
    if element_type.index < 0:
        element_name = known_list_element_name(arena, iterable, source, context)
    builder.append("    for (size_t cinder_index = 0; cinder_index < ")
    emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
    if context_expression_is_pointer_like(arena, context, iterable, source):
        builder.append("->length")
    else:
        builder.append(".length")
    builder.append("; ++cinder_index) {\n")
    builder.append("    ")
    if element_type.index >= 0:
        emit_module_c_type(arena, element_type, source, builder, prefix, project_name, imports)
    elif len(element_name) > 0:
        builder.append(element_name)
    else:
        builder.append("__auto_type")
    builder.append(" ")
    append_source(builder, source, target_node.value_start, target_node.value_length)
    builder.append(" = ((")
    if element_type.index >= 0:
        emit_module_c_type(arena, element_type, source, builder, prefix, project_name, imports)
    elif len(element_name) > 0:
        builder.append(element_name)
    else:
        builder.append("char")
    builder.append(" *)")
    emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
    if context_expression_is_pointer_like(arena, context, iterable, source):
        builder.append("->data)[cinder_index];\n")
    else:
        builder.append(".data)[cinder_index];\n")
    if element_type.index >= 0:
        register_context_name_type(arena, context, source, target_node.value_start, target_node.value_length, element_type)
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context)
    if element_type.index >= 0:
        if len(context.local_types) > 0:
            context.local_types.pop()
    builder.append("    }\n")


def for_each_iterable(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != SyntaxKind.NAME and not is_type_kind(child.kind) and child.kind != SyntaxKind.BLOCK:
            return child_id
    return syntax.missing_node()


def is_range_call(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = first_child(arena, id)
    if callee.index < 0:
        return false
    callee_node = arena.nodes[callee.index]
    return callee_node.kind == SyntaxKind.EXPR_NAME and range_text_equals(source, callee_node.value_start, callee_node.value_length, "range")


def range_argument_expression(arena: &const SyntaxArena, id: NodeId, argument_index: i32) -> NodeId:
    actual_index: i32 = 0
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if actual_index == argument_index:
                return last_child(arena, child_id)
            actual_index += 1
    return syntax.missing_node()


def emit_range_argument(
    arena: &const SyntaxArena,
    id: NodeId,
    argument_index: i32,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    actual_index: i32 = 0
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if actual_index == argument_index:
                emit_module_expression(arena, last_child(arena, child_id), source, builder, prefix, project_name, imports, context)
                return
            actual_index += 1
    if argument_index == 0:
        builder.append("0")
    elif argument_index == 2:
        builder.append("1")
    else:
        builder.append("0")


def append_assignment_operator(builder: &StringBuilder, flag: i32) -> void:
    if flag == cast[i32](token.TokenKind.PLUS_ASSIGN):
        builder.append("+=")
        return
    if flag == cast[i32](token.TokenKind.MINUS_ASSIGN):
        builder.append("-=")
        return
    if flag == cast[i32](token.TokenKind.STAR_ASSIGN):
        builder.append("*=")
        return
    if flag == cast[i32](token.TokenKind.SLASH_ASSIGN):
        builder.append("/=")
        return
    if flag == cast[i32](token.TokenKind.PERCENT_ASSIGN):
        builder.append("%=")
        return
    builder.append("=")


def emit_module_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        if node.flags == cast[i32](token.TokenKind.STRING):
            builder.append("cinder_string_from_cstr(")
            append_source(builder, source, node.value_start, node.value_length)
            builder.append(")")
        elif node.flags == cast[i32](token.TokenKind.NONE) or node.flags == cast[i32](token.TokenKind.NULL):
            builder.append("NULL")
        elif node.flags == cast[i32](token.TokenKind.INTEGER) or node.flags == cast[i32](token.TokenKind.FLOAT):
            append_numeric_literal(builder, source, node.value_start, node.value_length)
        else:
            append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_LIST:
        builder.append("({ CinderList cinder_list = (CinderList){0};")
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            if child_id.index >= 0 and not is_type_kind(arena.nodes[child_id.index].kind):
                builder.append(" cinder_selfhost_list_append_value(&cinder_list, (")
                emit_module_expression(arena, child_id, source, builder, prefix, project_name, imports, context)
                builder.append("));")
        builder.append(" cinder_list; })")
        return
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        if context_name_is_global(context, &name) or (not context_has_name(context, source, node.value_start, node.value_length) and not context_name_is_extern(context, &name) and context_has_function_name(context.type_arena, context.root, context.type_source, &name)):
            builder.append(prefix[0:len(prefix)])
        append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_BINARY:
        if node.flags == cast[i32](token.TokenKind.AND):
            builder.append("(")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(" && ")
            emit_module_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.OR):
            builder.append("(")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(" || ")
            emit_module_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.EQUAL):
            if expression_may_be_string(arena, context, first_child(arena, id), source) or expression_may_be_string(arena, context, second_child(arena, id), source):
                builder.append("cinder_selfhost_string_equal(")
                emit_string_value_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
                builder.append(", ")
                emit_string_value_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
                builder.append(")")
                return
            builder.append("(")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(" == ")
            emit_module_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.PLUS) and (expression_may_be_string(arena, context, first_child(arena, id), source) or expression_may_be_string(arena, context, second_child(arena, id), source)):
            builder.append("cinder_selfhost_string_concat(")
            emit_string_value_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(", ")
            emit_string_value_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
            builder.append(")")
            return
        builder.append("(")
        emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(" ")
        append_source(builder, source, node.value_start, node.value_length)
        builder.append(" ")
        emit_module_expression(arena, second_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_INDEX:
        emit_module_index(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_SLICE:
        emit_module_slice(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_UNARY:
        if node.flags == cast[i32](token.TokenKind.NOT):
            builder.append("!")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            return
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            builder.append("&")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            return
        if node.flags == cast[i32](token.TokenKind.STAR):
            builder.append("*")
            emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
            return
        append_source(builder, source, node.value_start, node.value_length)
        emit_module_expression(arena, first_child(arena, id), source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_ALLOC:
        allocation_type = find_child_type(arena, id)
        builder.append("(")
        emit_module_c_type(arena, allocation_type, source, builder, prefix, project_name, imports)
        builder.append(" *)cinder_alloc(")
        value = last_child(arena, id)
        emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
        builder.append(", sizeof(")
        emit_module_c_type(arena, allocation_type, source, builder, prefix, project_name, imports)
        builder.append("))")
        return
    if node.kind == SyntaxKind.EXPR_CAST:
        cast_type = find_child_type(arena, id)
        builder.append("(")
        emit_module_c_type(arena, cast_type, source, builder, prefix, project_name, imports)
        builder.append(")(")
        emit_module_expression(arena, last_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_TUPLE:
        builder.append("0")
        return
    if node.kind == SyntaxKind.EXPR_CALL:
        emit_module_call(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        emit_module_attribute(arena, id, source, builder, prefix, project_name, imports, context)
        return
    append_source(builder, source, node.start, node.length)


def append_numeric_literal(builder: &StringBuilder, source: &const String, start: usize, length: usize) -> void:
    offset: usize = 0
    while offset < length:
        byte = source.byte_at(start + offset)
        if byte != 95:
            builder.append(source[start + offset:start + offset + 1])
        offset += 1


def emit_module_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    callee = first_child(arena, id)
    if callee.index >= 0:
        callee_node = arena.nodes[callee.index]
        if callee_node.kind == SyntaxKind.EXPR_NAME:
            name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
            if name == "String":
                emit_string_constructor(arena, id, source, builder, prefix, project_name, imports, context)
                return
            if name == "StringBuilder":
                builder.append("cinder_selfhost_string_builder_new()")
                return
            if name == "len":
                emit_len_call(arena, id, source, builder, prefix, project_name, imports, context)
                return
            if name == "print":
                emit_print_call(arena, id, source, builder, prefix, project_name, imports, context)
                return
            if name == "input":
                builder.append("cinder_selfhost_input_string(")
                emit_module_expression(arena, first_call_argument(arena, id), source, builder, prefix, project_name, imports, context)
                builder.append(")")
                return
            if name == "sort":
                emit_sort_call(arena, id, source, builder, prefix, project_name, imports, context)
                return
            if name == "free":
                builder.append("free(")
                emit_module_expression(arena, first_call_argument(arena, id), source, builder, prefix, project_name, imports, context)
                builder.append(")")
                return
            if name == "open":
                emit_open_call(arena, id, source, builder, prefix, project_name, imports, context)
                return
            if name == "access":
                emit_access_call(arena, id, source, builder, prefix, project_name, imports, context)
                return
            else:
                if is_uppercase_start(source, callee_node.value_start):
                    emit_nominal_constructor(arena, id, source, builder, prefix, project_name, imports, &name, context)
                    return
                imported = find_import_member(imports, &name)
                if len(imported.module_name) > 0 and len(imported.member) > 0:
                    if project.is_builtin_module(&imported.module_name):
                        emit_builtin_function_name(builder, &imported.module_name, &imported.member)
                    else:
                        builder.append(c_prefix(project_name, &imported.module_name))
                        builder.append(imported.member)
                elif context_name_is_extern(context, &name) or context_has_name(context, source, callee_node.value_start, callee_node.value_length):
                    builder.append(name)
                else:
                    builder.append(prefix[0:len(prefix)])
                    builder.append(name)
        if callee_node.kind == SyntaxKind.EXPR_ATTRIBUTE:
            emit_attribute_call(arena, id, callee, source, builder, prefix, project_name, imports, context)
            return
        if callee_node.kind != SyntaxKind.EXPR_NAME:
            emit_module_expression(arena, callee, source, builder, prefix, project_name, imports, context)
    builder.append("(")
    emitted_argument = false
    argument_index: usize = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted_argument:
                builder.append(", ")
            arg = last_child(arena, child_id)
            expected_type = context_callee_parameter_type(arena, context, callee, source, argument_index)
            arg_type = context_expression_type(arena, context, arg, source)
            if expected_type.index >= 0 and type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_SLICE and context_type_is_array(context.type_arena, arg_type):
                emit_array_as_list(arena, arg, arg_type, source, builder, prefix, project_name, imports, context)
                emitted_argument = true
                argument_index += 1
                continue
            borrow_argument = should_borrow_named_argument(arena, context, arg, source)
            if not borrow_argument:
                borrow_argument = should_borrow_for_callee(arena, context, callee, arg, source, argument_index)
            if borrow_argument and not call_is_name(arena, callee, source, "dump_summary"):
                builder.append("&")
            emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
            if not borrow_argument:
                mark_context_expression_moved(arena, context, arg, source)
            emitted_argument = true
            argument_index += 1
    builder.append(")")
    return


def emit_builtin_function_name(builder: &StringBuilder, module_name: &const String, member: &const String) -> void:
    if module_name == "cinder" and member == "panic":
        builder.append("cinder_panic")
        return
    builder.append(member[0:len(member)])


def emit_nominal_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name: &const String,
    context: &ModuleCodegenContext,
) -> void:
    imported = find_import_member(imports, name)
    builder.append("(")
    if len(imported.module_name) > 0 and len(imported.member) > 0:
        builder.append(c_prefix(project_name, &imported.module_name))
        builder.append(imported.member)
    else:
        builder.append(prefix[0:len(prefix)])
        builder.append(name[0:len(name)])
    builder.append("){")
    node = arena.nodes[id.index]
    emitted = false
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted:
                builder.append(", ")
            named = first_child(arena, child_id)
            if child.flags == 1 and named.index >= 0:
                named_node = arena.nodes[named.index]
                builder.append(".")
                append_source(builder, source, named_node.value_start, named_node.value_length)
                builder.append(" = ")
            value = last_child(arena, child_id)
            emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
            mark_context_expression_moved(arena, context, value, source)
            emitted = true
    builder.append("}")


def emit_imported_nominal_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    module_name: &const String,
    name: &const String,
    context: &ModuleCodegenContext,
) -> void:
    builder.append("(")
    builder.append(c_prefix(project_name, module_name))
    builder.append(name[0:len(name)])
    builder.append("){")
    node = arena.nodes[id.index]
    emitted = false
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted:
                builder.append(", ")
            named = first_child(arena, child_id)
            if child.flags == 1 and named.index >= 0:
                named_node = arena.nodes[named.index]
                builder.append(".")
                append_source(builder, source, named_node.value_start, named_node.value_length)
                builder.append(" = ")
            value = last_child(arena, child_id)
            emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
            mark_context_expression_moved(arena, context, value, source)
            emitted = true
    builder.append("}")


def emit_string_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    arg = first_call_argument(arena, id)
    builder.append("cinder_string_from_cstr(")
    emit_c_string_argument(arena, arg, source, builder, prefix, project_name, imports, context)
    builder.append(")")


def emit_len_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    arg = first_call_argument(arena, id)
    arg_type = context_expression_type(arena, context, arg, source)
    if context_type_is_array(context.type_arena, arg_type):
        length = array_length_node(context.type_arena, arg_type)
        append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
        return
    emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
    if context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("->length")
    else:
        builder.append(".length")


def emit_sort_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    arg = first_call_argument(arena, id)
    element_type = context_expression_list_element_type(arena, context, arg, source)
    if context_type_name_equals(context.type_arena, element_type, context.type_source, "String"):
        builder.append("cinder_selfhost_sort_string(")
    else:
        builder.append("cinder_selfhost_sort_i32(")
    if not context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("&")
    emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
    builder.append(")")


def emit_print_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    builder.append("({ ")
    first = true
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            arg = last_child(arena, child_id)
            if arg.index >= 0 and arena.nodes[arg.index].kind == SyntaxKind.EXPR_FSTRING:
                if not first:
                    builder.append("printf(\" \"); ")
                emit_print_fstring_segments(arena, arg, source, builder, prefix, project_name, imports, context)
            else:
                emit_print_argument(arena, arg, source, builder, prefix, project_name, imports, context, first)
            first = false
    builder.append("printf(\"\\n\"); 0; })")


def emit_print_argument(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
    first: bool,
) -> void:
    type_id = context_expression_type(arena, context, id, source)
    if context_type_is_list(context.type_arena, type_id, context.type_source):
        emit_print_list_value(arena, id, source, builder, prefix, project_name, imports, context, type_id, first)
        return
    if expression_may_be_string(arena, context, id, source):
        builder.append("cinder_selfhost_print_string_value(")
        emit_string_value_expression(arena, id, source, builder, prefix, project_name, imports, context)
    elif context_type_name_equals(context.type_arena, type_id, context.type_source, "bool"):
        builder.append("cinder_selfhost_print_bool_value(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
    elif context_type_name_equals(context.type_arena, type_id, context.type_source, "char"):
        builder.append("cinder_selfhost_print_char_value(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
    elif context_type_name_equals(context.type_arena, type_id, context.type_source, "f32") or context_type_name_equals(context.type_arena, type_id, context.type_source, "f64"):
        builder.append("cinder_selfhost_print_float_value((double)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append("), ")
        if first:
            builder.append("true); ")
        else:
            builder.append("false); ")
        return
    elif context_type_is_unsigned_integer(context.type_arena, type_id, context.type_source):
        builder.append("cinder_selfhost_print_unsigned_value((unsigned long long)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append("), ")
        if first:
            builder.append("true); ")
        else:
            builder.append("false); ")
        return
    else:
        builder.append("cinder_selfhost_print_integer_value((long long)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(")")
    if first:
        builder.append(", true); ")
    else:
        builder.append(", false); ")


def context_type_is_unsigned_integer(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    return context_type_name_equals(arena, type_id, source, "u8") or context_type_name_equals(arena, type_id, source, "u16") or context_type_name_equals(arena, type_id, source, "u32") or context_type_name_equals(arena, type_id, source, "u64") or context_type_name_equals(arena, type_id, source, "usize") or context_type_name_equals(arena, type_id, source, "c_size_t")


def emit_print_list_value(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
    type_id: NodeId,
    first: bool,
) -> void:
    element_type = context_list_element_type(context.type_arena, type_id, context.type_source)
    if context_type_name_equals(context.type_arena, element_type, context.type_source, "String"):
        builder.append("cinder_selfhost_print_string_list(")
    elif context_type_name_equals(context.type_arena, element_type, context.type_source, "i64") or context_type_name_equals(context.type_arena, element_type, context.type_source, "isize") or context_type_name_equals(context.type_arena, element_type, context.type_source, "c_long"):
        builder.append("cinder_selfhost_print_i64_list(")
    elif context_type_is_unsigned_integer(context.type_arena, element_type, context.type_source):
        builder.append("cinder_selfhost_print_u64_list(")
    elif context_type_name_equals(context.type_arena, element_type, context.type_source, "f32") or context_type_name_equals(context.type_arena, element_type, context.type_source, "f64"):
        builder.append("cinder_selfhost_print_f64_list(")
    else:
        builder.append("cinder_selfhost_print_i32_list(")
    if not context_expression_is_pointer_like(arena, context, id, source):
        builder.append("&")
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
    if first:
        builder.append(", true); ")
    else:
        builder.append(", false); ")

def emit_print_fstring_segments(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.value_length < 3:
        return
    content_start = node.value_start + 2
    content_end = node.value_start + node.value_length - 1
    segment_start = content_start
    index = content_start
    while index < content_end:
        byte = source.byte_at(index)
        if byte == 92:
            if index + 1 < content_end:
                index += 2
            else:
                index += 1
            continue
        if byte == 123:
            if index + 1 < content_end and source.byte_at(index + 1) == 123:
                emit_fstring_literal(source, segment_start, index, builder)
                builder.append("printf(\"{\"); ")
                index += 2
                segment_start = index
                continue
            emit_fstring_literal(source, segment_start, index, builder)
            field = scan_fstring_field(source, index + 1, content_end)
            if not field.valid:
                emit_fstring_literal(source, index, content_end, builder)
                return
            expression_start = trim_left(source, index + 1, field.expression_end)
            expression_end = trim_right(source, expression_start, field.expression_end)
            if expression_end > expression_start:
                expression_source = source[expression_start:expression_end]
                scan = lexer.new_lexer(expression_source)
                scan.tokenize()
                parsed = parser.new_parser(&scan)
                expression = parsed.parse_expression(0)
                if len(scan.diagnostics) == 0 and len(parsed.diagnostics) == 0 and expression.index >= 0:
                    format_start = field.format_start
                    format_length: usize = 0
                    if format_start < field.close:
                        format_start = trim_left(source, format_start + 1, field.close)
                        format_end = trim_right(source, format_start, field.close)
                        format_length = format_end - format_start
                    emit_fstring_replacement(
                        &parsed.arena,
                        expression,
                        &scan.source,
                        source,
                        format_start,
                        format_length,
                        builder,
                        prefix,
                        project_name,
                        imports,
                        context,
                    )
            index = field.close + 1
            segment_start = index
            continue
        if byte == 125 and index + 1 < content_end and source.byte_at(index + 1) == 125:
            emit_fstring_literal(source, segment_start, index, builder)
            builder.append("printf(\"}\"); ")
            index += 2
            segment_start = index
            continue
        index += 1
    emit_fstring_literal(source, segment_start, content_end, builder)


def scan_fstring_field(source: &const String, start: usize, end: usize) -> FStringField:
    brackets: List[u8] = []
    index = start
    format_start = end
    while index < end:
        byte = source.byte_at(index)
        if byte == 34 or byte == 39:
            index = skip_fstring_quoted(source, index, end)
            continue
        if byte == 40:
            brackets.append(41)
            index += 1
            continue
        if byte == 91:
            brackets.append(93)
            index += 1
            continue
        if byte == 123:
            brackets.append(125)
            index += 1
            continue
        if byte == 41 or byte == 93 or byte == 125:
            if len(brackets) > 0:
                if brackets[len(brackets) - 1] == byte:
                    brackets.pop()
                index += 1
                continue
            if byte == 125:
                expression_end = index
                if format_start < end:
                    expression_end = format_start
                return FStringField(
                    expression_end=expression_end,
                    format_start=format_start,
                    close=index,
                    valid=true,
                )
            index += 1
            continue
        if byte == 58 and len(brackets) == 0 and format_start == end:
            format_start = index
        index += 1
    return FStringField(expression_end=end, format_start=end, close=end, valid=false)


def skip_fstring_quoted(source: &const String, start: usize, end: usize) -> usize:
    quote = source.byte_at(start)
    index = start + 1
    escaped = false
    while index < end:
        byte = source.byte_at(index)
        if escaped:
            escaped = false
        elif byte == 92:
            escaped = true
        elif byte == quote:
            return index + 1
        index += 1
    return index


def trim_left(source: &const String, start: usize, end: usize) -> usize:
    index = start
    while index < end:
        byte = source.byte_at(index)
        if byte != 32 and byte != 9 and byte != 10 and byte != 13:
            break
        index += 1
    return index


def trim_right(source: &const String, start: usize, end: usize) -> usize:
    index = end
    while index > start:
        byte = source.byte_at(index - 1)
        if byte != 32 and byte != 9 and byte != 10 and byte != 13:
            break
        index -= 1
    return index


def emit_fstring_literal(source: &const String, start: usize, end: usize, builder: &StringBuilder) -> void:
    if start >= end:
        return
    builder.append("printf(\"")
    index = start
    chunk_start = start
    while index < end:
        byte = source.byte_at(index)
        if byte == 92 and index + 1 < end:
            if index > chunk_start:
                builder.append(source[chunk_start:index])
            builder.append(source[index:index + 2])
            index += 2
            chunk_start = index
            continue
        if byte == 34:
            if index > chunk_start:
                builder.append(source[chunk_start:index])
            builder.append("\\\"")
            chunk_start = index + 1
        elif byte == 37:
            if index > chunk_start:
                builder.append(source[chunk_start:index])
            builder.append("%%")
            chunk_start = index + 1
        elif byte == 10:
            if index > chunk_start:
                builder.append(source[chunk_start:index])
            builder.append("\\n")
            chunk_start = index + 1
        elif byte == 13:
            if index > chunk_start:
                builder.append(source[chunk_start:index])
            builder.append("\\r")
            chunk_start = index + 1
        index += 1
    if end > chunk_start:
        builder.append(source[chunk_start:end])
    builder.append("\"); ")


def emit_fstring_replacement(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    format_source: &const String,
    format_start: usize,
    format_length: usize,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index >= 0 and arena.nodes[id.index].kind == SyntaxKind.EXPR_FSTRING:
        emit_print_fstring_segments(arena, id, source, builder, prefix, project_name, imports, context)
        return
    type_id = context_expression_type(arena, context, id, source)
    if context_type_is_list(context.type_arena, type_id, context.type_source):
        emit_print_list_value(arena, id, source, builder, prefix, project_name, imports, context, type_id, true)
        return
    conversion: u8 = 0
    if format_length > 0:
        conversion = format_source.byte_at(format_start + format_length - 1)
    string_value = expression_may_be_string(arena, context, id, source)
    if conversion == 115 and fstring_expression_is_type(arena, context, id, source, "bool"):
        builder.append("printf(\"%s\", (")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(") ? \"true\" : \"false\"); ")
        return
    if conversion == 115 or (conversion == 0 and string_value):
        if string_value:
            builder.append("cinder_selfhost_print_string_fragment(")
            emit_string_value_expression(arena, id, source, builder, prefix, project_name, imports, context)
            builder.append("); ")
        else:
            builder.append("printf(\"%s\", ")
            emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
            builder.append("); ")
        return
    if conversion == 99 or (conversion == 0 and fstring_expression_is_type(arena, context, id, source, "char")):
        builder.append("printf(\"%c\", (int)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(")); ")
        return
    if conversion == 0 and fstring_expression_is_type(arena, context, id, source, "bool"):
        builder.append("printf(\"%s\", (")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(") ? \"true\" : \"false\"); ")
        return
    if is_float_conversion(conversion) or (conversion == 0 and fstring_expression_is_float(arena, context, id, source)):
        builder.append("printf(\"")
        if format_length == 0:
            builder.append("%g")
        else:
            builder.append("%")
            builder.append(format_source[format_start:format_start + format_length])
        builder.append("\", (double)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(")); ")
        return
    if conversion == 117 or conversion == 111 or conversion == 120 or conversion == 88:
        builder.append("printf(\"%ll")
        builder.append(format_source[format_start + format_length - 1:format_start + format_length])
        builder.append("\", (unsigned long long)(")
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        builder.append(")); ")
        return
    builder.append("printf(\"%lld\", (long long)(")
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
    builder.append(")); ")


def is_float_conversion(conversion: u8) -> bool:
    return conversion == 102 or conversion == 70 or conversion == 101 or conversion == 69 or conversion == 103 or conversion == 71


def fstring_expression_is_float(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> bool:
    return fstring_expression_is_type(arena, context, id, source, "f32") or fstring_expression_is_type(arena, context, id, source, "f64")


def fstring_expression_is_type(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String, expected: String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        if expected == "bool":
            return node.flags == cast[i32](token.TokenKind.TRUE) or node.flags == cast[i32](token.TokenKind.FALSE)
        if expected == "char":
            return node.flags == cast[i32](token.TokenKind.CHAR)
        if expected == "f64":
            return node.flags == cast[i32](token.TokenKind.FLOAT)
    type_id = context_expression_type(arena, context, id, source)
    return context_type_name_equals(context.type_arena, type_id, context.type_source, expected)


def context_type_name_equals(arena: &const SyntaxArena, type_id: NodeId, source: &const String, expected: String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        if expected == "bool":
            return node.flags == cast[i32](token.TokenKind.TRUE) or node.flags == cast[i32](token.TokenKind.FALSE)
        if expected == "char":
            return node.flags == cast[i32](token.TokenKind.CHAR)
        if expected == "f64":
            return node.flags == cast[i32](token.TokenKind.FLOAT)
        if expected == "String":
            return node.flags == cast[i32](token.TokenKind.STRING)
        if expected == "i32":
            return node.flags == cast[i32](token.TokenKind.INTEGER)
        return false
    if node.kind == SyntaxKind.EXPR_CALL or node.kind == SyntaxKind.EXPR_NAME:
        owner = context_type_owner_name(arena, type_id, source)
        return owner == expected
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST:
        expected_length = len(expected)
        return context_type_name_equals(arena, first_child(arena, type_id), source, expected[0:expected_length])
    expected_length = len(expected)
    return node.kind == SyntaxKind.TYPE_NAME and range_text_equals(source, node.value_start, node.value_length, expected[0:expected_length])


def emit_access_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    path = first_call_argument(arena, id)
    mode = second_call_argument(arena, id)
    builder.append("access(cinder_string_cstr(")
    if not context_expression_is_pointer_like(arena, context, path, source):
        builder.append("&")
    emit_module_expression(arena, path, source, builder, prefix, project_name, imports, context)
    builder.append("), ")
    emit_module_expression(arena, mode, source, builder, prefix, project_name, imports, context)
    builder.append(")")


def emit_open_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    path = first_call_argument(arena, id)
    mode = second_call_argument(arena, id)
    if path.index >= 0:
        path_node = arena.nodes[path.index]
        if path_node.kind == SyntaxKind.EXPR_LITERAL and path_node.flags == cast[i32](token.TokenKind.STRING):
            builder.append("fopen(")
            append_source(builder, source, path_node.value_start, path_node.value_length)
            builder.append(", ")
            emit_c_string_argument(arena, mode, source, builder, prefix, project_name, imports, context)
            builder.append(")")
            return
    builder.append("fopen(cinder_string_cstr(")
    if not context_expression_is_pointer_like(arena, context, path, source):
        builder.append("&")
    emit_module_expression(arena, path, source, builder, prefix, project_name, imports, context)
    builder.append("), ")
    emit_c_string_argument(arena, mode, source, builder, prefix, project_name, imports, context)
    builder.append(")")


def emit_attribute_call(
    arena: &const SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    receiver = first_child(arena, callee_id)
    member = second_child(arena, callee_id)
    if member.index < 0:
        emit_module_expression(arena, callee_id, source, builder, prefix, project_name, imports, context)
        return
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    if receiver.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME:
            receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = find_import_alias(imports, &receiver_name)
            if len(imported.module_name) > 0:
                if is_uppercase_start(source, member_node.value_start):
                    emit_imported_nominal_constructor(arena, call_id, source, builder, prefix, project_name, imports, &imported.module_name, &member_name, context)
                    return
                if imported.module_name == "process" and member_name == "run":
                    builder.append("cinder_selfhost_process_run_list(&")
                    emit_module_expression(arena, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
                    builder.append(")")
                    return
                if imported.module_name == "cinder" and (member_name == "write_stdout" or member_name == "write_stderr"):
                    if member_name == "write_stdout":
                        builder.append("cinder_write_stdout")
                    else:
                        builder.append("cinder_write_stderr")
                    builder.append("(&")
                    emit_module_expression(arena, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
                    builder.append(")")
                    return
                if project.is_builtin_module(&imported.module_name):
                    emit_builtin_function_name(builder, &imported.module_name, &member_name)
                    builder.append("(")
                    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, false, context)
                    builder.append(")")
                    return
                builder.append(c_prefix(project_name, &imported.module_name))
                append_source(builder, source, member_node.value_start, member_node.value_length)
                builder.append("(")
                if member_name == "dump_summary":
                    emit_module_expression(arena, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
                else:
                    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, false, context)
                builder.append(")")
                return
    if member_name == "dump" and receiver.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME and range_text_equals(source, receiver_node.value_start, receiver_node.value_length, "scan"):
            lexer_module = "lexer"
            builder.append(c_prefix(project_name, &lexer_module))
            builder.append("Lexer_dump(")
            emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context)
            emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context)
            builder.append(")")
            return
    if member_name == "clear":
        receiver_type = context_expression_type(arena, context, receiver, source)
        if context_type_is_string(context.type_arena, receiver_type, context.type_source):
            builder.append("cinder_string_clear(")
        else:
            builder.append("cinder_selfhost_list_clear(")
        if not context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "append":
        arg = first_call_argument(arena, call_id)
        if receiver_is_builder(arena, receiver, source):
            emit_builder_append_call(arena, receiver, arg, source, builder, prefix, project_name, imports, context)
        else:
            builder.append("cinder_selfhost_list_append_value(")
            if not context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("&")
            emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
            builder.append(", (")
            emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
            mark_context_expression_moved(arena, context, arg, source)
            builder.append("))")
        return
    if member_name == "append_char":
        builder.append("cinder_string_builder_append_char(")
        if not context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        emit_module_expression(arena, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "pop":
        builder.append("cinder_selfhost_list_pop(")
        if not context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "finish":
        builder.append("cinder_string_builder_finish(&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "byte_at":
        if context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("cinder_string_byte_at(")
        else:
            builder.append("cinder_selfhost_string_byte_at_value(")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        emit_module_expression(arena, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "read_text":
        builder.append("cinder_read_all_text(")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if member_name == "write":
        emit_file_write_call(arena, receiver, first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context)
        return
    append_source(builder, source, member_node.value_start, member_node.value_length)
    builder.append("(")
    emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context)
    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context)
    builder.append(")")


def emit_builder_append_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    arg_node = arena.nodes[arg.index]
    if arg_node.kind == SyntaxKind.EXPR_LITERAL and arg_node.flags == cast[i32](token.TokenKind.STRING):
        builder.append("cinder_selfhost_string_builder_append_cstr(")
        if not context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        append_source(builder, source, arg_node.value_start, arg_node.value_length)
        builder.append(")")
    else:
        builder.append("cinder_selfhost_string_builder_append_value(")
        if not context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
        builder.append(")")


def emit_file_write_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    arg_type = context_expression_type(arena, context, arg, source)
    if context_type_is_array(context.type_arena, arg_type):
        builder.append("fwrite((const void *)")
        emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
        builder.append(", 1, ")
        length = array_length_node(context.type_arena, arg_type)
        append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
        builder.append(", ")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    if context_type_is_list(context.type_arena, arg_type, context.type_source):
        builder.append("fwrite(")
        emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
        if context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->data, 1, ")
        else:
            builder.append(".data, 1, ")
        emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
        if context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->length, ")
        else:
            builder.append(".length, ")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(")")
        return
    builder.append("fwrite(cinder_string_cstr(")
    if not context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("&")
    emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
    builder.append("), 1, ")
    emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
    if context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("->length, ")
    else:
        builder.append(".length, ")
    emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
    builder.append(")")


def emit_module_index(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    receiver = first_child(arena, id)
    index = second_child(arena, id)
    receiver_type = context_expression_type(arena, context, receiver, source)
    if context_type_is_array(context.type_arena, receiver_type):
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append("[")
        emit_module_expression(arena, index, source, builder, prefix, project_name, imports, context)
        builder.append("]")
        return
    if emit_known_list_index(arena, receiver, index, source, builder, prefix, project_name, imports, context):
        return
    element_type = context_expression_list_element_type(arena, context, receiver, source)
    if element_type.index >= 0:
        receiver_type = context_expression_type(arena, context, receiver, source)
        builder.append("((")
        emit_module_c_type(arena, element_type, source, builder, prefix, project_name, imports)
        builder.append(" *)")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        if context_type_is_pointer_like(arena, receiver_type):
            builder.append("->data")
        else:
            builder.append(".data")
        builder.append(")")
    else:
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
    builder.append("[")
    emit_module_expression(arena, index, source, builder, prefix, project_name, imports, context)
    builder.append("]")


def emit_known_list_index(
    arena: &const SyntaxArena,
    receiver: NodeId,
    index: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> bool:
    element = known_list_element_name(arena, receiver, source, context)
    if len(element) == 0:
        return false
    builder.append("(((")
    builder.append(element)
    builder.append(" *)")
    emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
    if context_expression_is_pointer_like(arena, context, receiver, source):
        builder.append("->data)[")
    else:
        builder.append(".data)[")
    emit_module_expression(arena, index, source, builder, prefix, project_name, imports, context)
    builder.append("])")
    return true


def known_list_element_name(arena: &const SyntaxArena, receiver: NodeId, source: &const String, context: &ModuleCodegenContext) -> String:
    if receiver.index < 0:
        return ""
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind != SyntaxKind.EXPR_ATTRIBUTE:
        return ""
    object = first_child(arena, receiver)
    member = second_child(arena, receiver)
    if object.index < 0 or member.index < 0:
        return ""
    object_node = arena.nodes[object.index]
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    owner = ""
    if object_node.kind == SyntaxKind.EXPR_NAME:
        object_name = source[object_node.value_start:object_node.value_start + object_node.value_length]
        if object_name == "self":
            owner = context.current_owner[0:len(context.current_owner)]
        if object_name == "arena":
            owner = "SyntaxArena"
        if object_name == "scan":
            owner = "Lexer"
        if object_name == "parser" or object_name == "parsed":
            owner = "Parser"
        if object_name == "checker" or object_name == "check":
            owner = "Checker"
        if len(owner) == 0:
            owner = context_type_owner_name(arena, context_name_type(context, &object_name), source)
    if owner == "SyntaxArena" and member_name == "nodes":
        return "cinder_cinder_selfhost_syntax__SyntaxNode"
    if owner == "SyntaxArena" and member_name == "children":
        return "cinder_cinder_selfhost_syntax__NodeId"
    if owner == "IRModule" and member_name == "nodes":
        return "cinder_cinder_selfhost_backend_ir__IRNode"
    if owner == "IRModule" and member_name == "children":
        return "cinder_cinder_selfhost_backend_ir__IRNodeId"
    if owner == "TypeTable" and member_name == "types":
        return "cinder_cinder_selfhost_types__TypeRecord"
    if owner == "TypeTable" and member_name == "type_args":
        return "cinder_cinder_selfhost_types__TypeId"
    if member_name == "types":
        return "cinder_cinder_selfhost_types__TypeRecord"
    if member_name == "type_args":
        return "cinder_cinder_selfhost_types__TypeId"
    if owner == "SymbolTable" and member_name == "symbols":
        return "cinder_cinder_selfhost_symbols__SymbolRecord"
    if owner == "SymbolTable" and member_name == "scopes":
        return "cinder_cinder_selfhost_symbols__ScopeRecord"
    if member_name == "symbols":
        return "cinder_cinder_selfhost_symbols__SymbolRecord"
    if member_name == "scopes":
        return "cinder_cinder_selfhost_symbols__ScopeRecord"
    if owner == "Lexer" and member_name == "tokens":
        return "cinder_cinder_selfhost_token__Token"
    if member_name == "tokens":
        return "cinder_cinder_selfhost_token__Token"
    if owner == "Lexer" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_token__LexerDiagnostic"
    if owner == "Parser" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_syntax__ParseDiagnostic"
    if owner == "Checker" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_checker__CheckerDiagnostic"
    if owner == "ProjectGraph" and member_name == "modules":
        return "cinder_cinder_selfhost_project__ParsedModule"
    if owner == "DriverOptions" and member_name == "program_args":
        return "CinderString"
    if owner == "DriverOptions" and member_name == "cflags":
        return "CinderString"
    if owner == "DriverOptions" and member_name == "ldflags":
        return "CinderString"
    if owner == "EmitResult" and member_name == "sources":
        return "CinderString"
    if owner == "EmitResult" and member_name == "headers":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "include_dirs":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "library_dirs":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "libraries":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "link_files":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "cflags":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "ldflags":
        return "CinderString"
    return ""


def emit_module_slice(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    receiver = first_child(arena, id)
    start = second_child(arena, id)
    stop = last_child(arena, id)
    receiver_type = context_expression_type(arena, context, receiver, source)
    if not expression_may_be_string(arena, context, receiver, source):
        element_type = context_expression_list_element_type(arena, context, receiver, source)
        if context_type_is_array(context.type_arena, receiver_type):
            builder.append("(CinderList){ .data = (void *)(&")
            emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
            builder.append("[")
            if start.index >= 0 and start.index != stop.index:
                emit_module_expression(arena, start, source, builder, prefix, project_name, imports, context)
            else:
                builder.append("0")
            builder.append("]), .length = (")
            if stop.index >= 0 and stop.index != receiver.index:
                emit_module_expression(arena, stop, source, builder, prefix, project_name, imports, context)
            else:
                length = array_length_node(context.type_arena, receiver_type)
                append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
            builder.append(" - ")
            if start.index >= 0 and start.index != stop.index:
                emit_module_expression(arena, start, source, builder, prefix, project_name, imports, context)
            else:
                builder.append("0")
            builder.append("), .capacity = 0 }")
            return
        builder.append("cinder_selfhost_list_slice(")
        if context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("*")
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        builder.append(", ")
        if start.index >= 0 and start.index != stop.index:
            emit_module_expression(arena, start, source, builder, prefix, project_name, imports, context)
        else:
            builder.append("0")
        builder.append(", ")
        if stop.index >= 0 and stop.index != receiver.index:
            emit_module_expression(arena, stop, source, builder, prefix, project_name, imports, context)
        else:
            emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
            if context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("->length")
            else:
                builder.append(".length")
        builder.append(", sizeof(")
        if element_type.index >= 0:
            emit_module_c_type(context.type_arena, element_type, context.type_source, builder, prefix, project_name, imports)
        else:
            builder.append("char")
        builder.append("))")
        return
    builder.append("cinder_string_slice(")
    receiver_is_pointer = context_expression_is_pointer_like(arena, context, receiver, source)
    if not receiver_is_pointer:
        builder.append("&")
    emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
    builder.append(", ")
    if start.index >= 0 and start.index != stop.index:
        emit_module_expression(arena, start, source, builder, prefix, project_name, imports, context)
    else:
        builder.append("0")
    builder.append(", ")
    if stop.index >= 0 and stop.index != receiver.index:
        emit_module_expression(arena, stop, source, builder, prefix, project_name, imports, context)
    else:
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        if receiver_is_pointer:
            builder.append("->length")
        else:
            builder.append(".length")
    builder.append(")")


def emit_module_attribute(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    receiver = first_child(arena, id)
    member = second_child(arena, id)
    if receiver.index >= 0 and member.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        member_node = arena.nodes[member.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME and member_node.kind == SyntaxKind.NAME:
            receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = find_import_alias(imports, &receiver_name)
            if len(imported.module_name) > 0:
                if imported.module_name == "math" and range_text_equals(source, member_node.value_start, member_node.value_length, "pi"):
                    builder.append("CINDER_PI")
                    return
                builder.append(c_prefix(project_name, &imported.module_name))
                append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            imported_member = find_import_member(imports, &receiver_name)
            if len(imported_member.module_name) > 0 and len(imported_member.member) > 0:
                builder.append(c_prefix(project_name, &imported_member.module_name))
                builder.append(imported_member.member)
                builder.append("_")
                append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            if is_uppercase_start(source, receiver_node.value_start):
                builder.append(prefix[0:len(prefix)])
                append_source(builder, source, receiver_node.value_start, receiver_node.value_length)
                builder.append("_")
                append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            if range_text_equals(source, receiver_node.value_start, receiver_node.value_length, "self"):
                builder.append("self->")
                append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            receiver_type = context_name_type(context, &receiver_name)
            if range_text_equals(source, member_node.value_start, member_node.value_length, "length") and context_type_is_array(context.type_arena, receiver_type):
                length = array_length_node(context.type_arena, receiver_type)
                append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
                return
            if context_name_is_pointer(arena, context, &receiver_name):
                append_source(builder, source, receiver_node.value_start, receiver_node.value_length)
                builder.append("->")
                append_source(builder, source, member_node.value_start, member_node.value_length)
                return
    if receiver.index >= 0 and member.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        member_node = arena.nodes[member.index]
        if receiver_node.kind == SyntaxKind.EXPR_ATTRIBUTE and is_uppercase_start(source, member_node.value_start):
            emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
            builder.append("_")
            append_source(builder, source, member_node.value_start, member_node.value_length)
            return
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        if context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("->")
        else:
            builder.append(".")
        append_source(builder, source, member_node.value_start, member_node.value_length)
        return
    append_source(builder, source, node_start(arena, id), node_length(arena, id))


def is_uppercase_start(source: &const String, start: usize) -> bool:
    if start >= len(source):
        return false
    byte = source.byte_at(start)
    return byte >= 65 and byte <= 90


def first_call_argument(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            return last_child(arena, child_id)
    return syntax.missing_node()


def second_call_argument(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    seen: i32 = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if seen == 1:
                return last_child(arena, child_id)
            seen += 1
    return syntax.missing_node()


def should_borrow_named_argument(arena: &const SyntaxArena, context: &ModuleCodegenContext, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if context_expression_is_pointer_like(arena, context, id, source):
        return false
    if node.kind == SyntaxKind.EXPR_NAME:
        return range_text_equals(source, node.value_start, node.value_length, "summary") or range_text_equals(source, node.value_start, node.value_length, "module") or range_text_equals(source, node.value_start, node.value_length, "child_nodes") or range_text_equals(source, node.value_start, node.value_length, "builder") or range_text_equals(source, node.value_start, node.value_length, "context") or range_text_equals(source, node.value_start, node.value_length, "check") or range_text_equals(source, node.value_start, node.value_length, "checker") or range_text_equals(source, node.value_start, node.value_length, "checked") or range_text_equals(source, node.value_start, node.value_length, "ir") or range_text_equals(source, node.value_start, node.value_length, "scan") or range_text_equals(source, node.value_start, node.value_length, "parsed")
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        member = second_child(arena, id)
        if member.index < 0:
            return false
        member_node = arena.nodes[member.index]
        return range_text_equals(source, member_node.value_start, member_node.value_length, "type_table") or range_text_equals(source, member_node.value_start, member_node.value_length, "symbols") or range_text_equals(source, member_node.value_start, member_node.value_length, "model") or range_text_equals(source, member_node.value_start, member_node.value_length, "arena") or range_text_equals(source, member_node.value_start, member_node.value_length, "native") or range_text_equals(source, member_node.value_start, member_node.value_length, "source")
    return false


def call_is_name(arena: &const SyntaxArena, callee: NodeId, source: &const String, name: String) -> bool:
    if callee.index < 0:
        return false
    node = arena.nodes[callee.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        return range_text_equals(source, node.value_start, node.value_length, name[0:len(name)])
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        member = second_child(arena, callee)
        if member.index >= 0:
            member_node = arena.nodes[member.index]
            return range_text_equals(source, member_node.value_start, member_node.value_length, name[0:len(name)])
    return false


def should_borrow_for_callee(
    arena: &const SyntaxArena,
    context: &ModuleCodegenContext,
    callee: NodeId,
    arg: NodeId,
    source: &const String,
    argument_index: usize,
) -> bool:
    if arg.index < 0 or context_expression_is_pointer_like(arena, context, arg, source):
        return false
    arg_node = arena.nodes[arg.index]
    if arg_node.kind == SyntaxKind.EXPR_UNARY and arg_node.flags == cast[i32](token.TokenKind.AMPERSAND):
        return false
    expected_type = context_callee_parameter_type(arena, context, callee, source, argument_index)
    if expected_type.index >= 0 and type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_REFERENCE:
        return true
    if expected_type.index >= 0:
        return false
    if arg_node.kind == SyntaxKind.EXPR_NAME and (range_text_equals(source, arg_node.value_start, arg_node.value_length, "decorators") or range_text_equals(source, arg_node.value_start, arg_node.value_length, "member_decorators")):
        return true
    arg_type = context_expression_type(arena, context, arg, source)
    if context_type_is_list(context.type_arena, arg_type, context.type_source):
        if call_is_name(arena, callee, source, "parse_options") or call_is_name(arena, callee, source, "emit_ok") or call_is_name(arena, callee, source, "resolve_paths"):
            return false
        return true
    if arg_node.kind != SyntaxKind.EXPR_NAME:
        return false
    if not range_text_equals(source, arg_node.value_start, arg_node.value_length, "args"):
        return false
    return call_is_name(arena, callee, source, "tuple_from_args") or call_is_name(arena, callee, source, "function_from_args") or call_is_name(arena, callee, source, "closure_from_args") or call_is_name(arena, callee, source, "specialization_suffix") or call_is_name(arena, callee, source, "record_specialization")


def context_callee_parameter_type(
    arena: &const SyntaxArena,
    context: &ModuleCodegenContext,
    callee: NodeId,
    source: &const String,
    argument_index: usize,
) -> NodeId:
    if callee.index < 0:
        return syntax.missing_node()
    callee_node = arena.nodes[callee.index]
    if callee_node.kind != SyntaxKind.EXPR_NAME:
        return syntax.missing_node()
    name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
    return find_function_parameter_type(
        context.type_arena,
        context.root,
        context.type_source,
        &name,
        argument_index,
    )


def find_function_parameter_type(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    name: &const String,
    parameter_index: usize,
) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.FUNCTION_DECL and range_text_equals(source, node.value_start, node.value_length, name[0:len(name)]):
        seen: usize = 0
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind == SyntaxKind.PARAMETER:
                if seen == parameter_index:
                    return find_child_type(arena, child_id)
                seen += 1
        return syntax.missing_node()
    if node.kind == SyntaxKind.MODULE or node.kind == SyntaxKind.EXTERN_BLOCK:
        for offset in range(0, node.child_count):
            found = find_function_parameter_type(
                arena,
                arena.children[node.first_child + offset],
                source,
                name,
                parameter_index,
            )
            if found.index >= 0:
                return found
    return syntax.missing_node()


def emit_remaining_call_arguments(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    already_emitted: bool,
    context: &ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    emitted_argument = already_emitted
    argument_index: usize = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted_argument:
                builder.append(", ")
            arg = last_child(arena, child_id)
            callee = first_child(arena, id)
            expected_type = context_callee_parameter_type(arena, context, callee, source, argument_index)
            arg_type = context_expression_type(arena, context, arg, source)
            if expected_type.index >= 0 and type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_SLICE and context_type_is_array(context.type_arena, arg_type):
                emit_array_as_list(arena, arg, arg_type, source, builder, prefix, project_name, imports, context)
                emitted_argument = true
                argument_index += 1
                continue
            borrow_argument = should_borrow_named_argument(arena, context, arg, source)
            if not borrow_argument:
                borrow_argument = should_borrow_for_callee(arena, context, callee, arg, source, argument_index)
            if borrow_argument and not call_is_name(arena, callee, source, "dump_summary"):
                builder.append("&")
            emit_module_expression(arena, arg, source, builder, prefix, project_name, imports, context)
            if not borrow_argument:
                mark_context_expression_moved(arena, context, arg, source)
            emitted_argument = true
            argument_index += 1


def receiver_is_builder(arena: &const SyntaxArena, receiver: NodeId, source: &const String) -> bool:
    if receiver.index < 0:
        return false
    node = arena.nodes[receiver.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        return range_text_equals(source, node.value_start, node.value_length, "builder")
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        member = second_child(arena, receiver)
        if member.index >= 0:
            member_node = arena.nodes[member.index]
            return range_text_equals(source, member_node.value_start, member_node.value_length, "builder")
    return false


def emit_c_string_argument(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if id.index < 0:
        builder.append("\"\"")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING):
        append_source(builder, source, node.value_start, node.value_length)
        return
    emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)


def emit_receiver_argument(
    arena: &const SyntaxArena,
    receiver: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &ModuleCodegenContext,
) -> void:
    if receiver.index >= 0:
        node = arena.nodes[receiver.index]
        if node.kind == SyntaxKind.EXPR_NAME and range_text_equals(source, node.value_start, node.value_length, "self"):
            builder.append("self")
            return
    if context_expression_is_pointer_like(arena, context, receiver, source):
        emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
        return
    builder.append("&")
    emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)


def find_import_alias(imports: &const List[project.ImportBinding], alias: &const String) -> project.ImportBinding:
    for item in imports:
        if item.alias == alias and len(item.member) == 0:
            return project.ImportBinding(
                alias=item.alias[0:len(item.alias)],
                module_name=item.module_name[0:len(item.module_name)],
                member=item.member[0:len(item.member)],
            )
    return project.ImportBinding(alias="", module_name="", member="")


def find_import_member(imports: &const List[project.ImportBinding], alias: &const String) -> project.ImportBinding:
    for item in imports:
        if item.alias == alias and len(item.member) > 0:
            return project.ImportBinding(
                alias=item.alias[0:len(item.alias)],
                module_name=item.module_name[0:len(item.module_name)],
                member=item.member[0:len(item.member)],
            )
    return project.ImportBinding(alias="", module_name="", member="")


def generated_header_name(module_name: &const String) -> String:
    return "cinder_gen/" + fs.replace_char(module_name, 46, 47) + ".cinder.h"


def generated_source_name(module_name: &const String) -> String:
    return "cinder_gen/" + fs.replace_char(module_name, 46, 47) + ".c"


def c_prefix(project_name: &const String, module_name: &const String) -> String:
    qualified = project_name + "_" + fs.replace_char(module_name, 46, 95)
    cleaned = fs.sanitize_identifier(&qualified)
    return "cinder_" + cleaned + "__"


def header_guard(header_name: &const String) -> String:
    cleaned = fs.sanitize_identifier(header_name)
    return "CINDER_GEN_" + cleaned + "_"


def node_start(arena: &const SyntaxArena, id: NodeId) -> usize:
    return arena.nodes[id.index].start


def node_length(arena: &const SyntaxArena, id: NodeId) -> usize:
    return arena.nodes[id.index].length
