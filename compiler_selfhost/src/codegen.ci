import backend_ir
import codegen_legacy
import codegen_module
import codegen_names
import codegen_specializations
import project
import syntax
import types
from syntax import NodeId, SyntaxArena


def emit_c(arena: &const SyntaxArena, root: NodeId, source: &const String) -> String:
    return codegen_legacy.emit_c(arena, root, source)


def emit_c_from_ir(module: &const backend_ir.IRModule, arena: &const SyntaxArena, source: &const String) -> String:
    return codegen_legacy.emit_c_from_ir(module, arena, source)


def new_specialization_name_registry() -> codegen_names.SpecializationNameRegistry:
    return codegen_names.new_specialization_name_registry()


def collect_module_specialization_names(
    registry: &codegen_names.SpecializationNameRegistry,
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    codegen_specializations.collect_module_specialization_names(registry, arena, id, source, prefix, project_name, imports)


def emit_module_header(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
) -> String:
    return codegen_module.emit_module_header(arena, root, source, module_name, project_name, dependencies, imports)


def emit_module_header_from_ir(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    dependencies: &const List[String],
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> String:
    return codegen_module.emit_module_header_from_ir(module, arena, source, module_name, project_name, dependencies, imports, registry)


def emit_module_source(
    arena: &const SyntaxArena,
    root: NodeId,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
) -> String:
    return codegen_module.emit_module_source(arena, root, source, module_name, project_name, imports, is_entry)


def emit_module_source_from_ir(
    module: &const backend_ir.IRModule,
    arena: &const SyntaxArena,
    source: &const String,
    module_name: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    is_entry: bool,
    registry: &const codegen_names.SpecializationNameRegistry,
    type_table: &const types.TypeTable,
) -> String:
    return codegen_module.emit_module_source_from_ir(module, arena, source, module_name, project_name, imports, is_entry, registry, type_table)


def generated_header_name(module_name: &const String) -> String:
    return codegen_names.generated_header_name(module_name)


def generated_source_name(module_name: &const String) -> String:
    return codegen_names.generated_source_name(module_name)


def c_prefix(project_name: &const String, module_name: &const String) -> String:
    return codegen_names.c_prefix(project_name, module_name)
