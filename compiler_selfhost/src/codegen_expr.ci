import codegen_access
import codegen_calls
import codegen_context
import codegen_format
import codegen_context as codegen_model
import codegen_names
import codegen_specializations
import codegen_type_names
import project
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_module_array_initializer(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_LIST:
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        return
    node = arena.nodes[id.index]
    builder.append("{")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
            if emitted:
                builder.append(", ")
            emit_module_array_initializer(arena, child_id, source, builder, prefix, project_name, imports, context)
            emitted = true
    builder.append("}")

def emit_module_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    state = codegen_model.ModuleExpressionState(
        arena=arena,
        source=source,
        builder=builder,
        prefix=prefix,
        project_name=project_name,
        imports=imports,
        context=context,
    )
    emit_module_expression_state(state, id)


def emit_module_expression_state(state: &codegen_model.ModuleExpressionState, id: NodeId) -> void:
    arena: &const SyntaxArena = state.arena
    source: &const String = state.source
    builder: &StringBuilder = state.builder
    prefix: &const String = state.prefix
    project_name: &const String = state.project_name
    imports: &const List[project.ImportBinding] = state.imports
    context: &codegen_model.ModuleCodegenContext = state.context
    type_table: &const types.TypeTable = context.type_table
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        if node.flags == cast[i32](token.TokenKind.STRING):
            builder.append("cinder_string_from_cstr(")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
            builder.append(")")
        elif node.flags == cast[i32](token.TokenKind.NONE):
            if not codegen_calls.emit_option_none(builder, prefix, project_name, imports, context):
                builder.append("NULL")
        elif node.flags == cast[i32](token.TokenKind.NULL):
            builder.append("NULL")
        elif node.flags == cast[i32](token.TokenKind.INTEGER) or node.flags == cast[i32](token.TokenKind.FLOAT):
            codegen_names.append_numeric_literal(builder, source, node.value_start, node.value_length)
        else:
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_LIST:
        list_type = context.expected_type
        has_specialized_list = codegen_context.context_type_is_runtime_generic(context.type_arena, list_type, context.type_source, "List")
        semantic_list_type = codegen_context.context_semantic_type(context, id)
        has_semantic_list = codegen_type_names.semantic_type_is_kind(type_table, semantic_list_type, types.TypeKind.LIST)
        if has_semantic_list:
            semantic_list_record = type_table.types[semantic_list_type.index]
            if codegen_type_names.semantic_type_is_kind(type_table, semantic_list_record.inner, types.TypeKind.ERROR):
                has_semantic_list = false
        builder.append("({ ")
        if has_specialized_list:
            codegen_type_names.emit_module_c_type(context.type_arena, list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        elif has_semantic_list:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("CinderList")
        builder.append(" cinder_list = (")
        if has_specialized_list:
            codegen_type_names.emit_module_c_type(context.type_arena, list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        elif has_semantic_list:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("CinderList")
        builder.append("){0};")
        element_type = codegen_context.context_generic_argument(context.type_arena, list_type, 0)
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                builder.append(" cinder_selfhost_list_append_value(&cinder_list, (")
                previous_expected = context.expected_type
                if element_type.index >= 0:
                    context.expected_type = element_type
                emit_module_expression_state(state, child_id)
                context.expected_type = previous_expected
                builder.append("));")
        builder.append(" cinder_list; })")
        return
    if node.kind == SyntaxKind.EXPR_SET:
        set_type = context.expected_type
        has_specialized_set = codegen_context.context_type_is_runtime_generic(context.type_arena, set_type, context.type_source, "Set")
        semantic_set_type = codegen_context.context_semantic_type(context, id)
        has_semantic_set = codegen_type_names.semantic_type_is_kind(type_table, semantic_set_type, types.TypeKind.SET)
        set_name_builder = StringBuilder()
        if has_specialized_set:
            codegen_type_names.emit_module_c_type(context.type_arena, set_type, context.type_source, &set_name_builder, prefix, project_name, imports, context.specialization_names)
        elif has_semantic_set:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_set_type, context.type_source, &set_name_builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("((CinderSet){0})")
            return
        set_name = set_name_builder.finish()
        builder.append("({ ")
        builder.append(set_name[0:len(set_name)])
        builder.append(" cinder_set = {0};")
        element_type = codegen_context.context_generic_argument(context.type_arena, set_type, 0)
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            builder.append(" (void)")
            builder.append(set_name[0:len(set_name)])
            builder.append("_add(&cinder_set, ")
            previous_expected = context.expected_type
            if element_type.index >= 0:
                context.expected_type = element_type
            emit_module_expression_state(state, child_id)
            context.expected_type = previous_expected
            builder.append(");")
        builder.append(" cinder_set; })")
        return
    if node.kind == SyntaxKind.EXPR_MAP:
        map_type = context.expected_type
        has_specialized_map = codegen_context.context_type_is_runtime_generic(context.type_arena, map_type, context.type_source, "Map")
        semantic_map_type = codegen_context.context_semantic_type(context, id)
        has_semantic_map = codegen_type_names.semantic_type_is_kind(type_table, semantic_map_type, types.TypeKind.MAP)
        map_name_builder = StringBuilder()
        if has_specialized_map:
            codegen_type_names.emit_module_c_type(context.type_arena, map_type, context.type_source, &map_name_builder, prefix, project_name, imports, context.specialization_names)
        elif has_semantic_map:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_map_type, context.type_source, &map_name_builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("((CinderMap){0})")
            return
        map_name = map_name_builder.finish()
        builder.append("({ ")
        builder.append(map_name[0:len(map_name)])
        builder.append(" cinder_map = {0};")
        key_type = codegen_context.context_generic_argument(context.type_arena, map_type, 0)
        value_type = codegen_context.context_generic_argument(context.type_arena, map_type, 1)
        for offset in range(0, node.child_count):
            entry_id = arena.children[node.first_child + offset]
            entry = arena.nodes[entry_id.index]
            if entry.kind != SyntaxKind.EXPR_MAP_ENTRY or entry.child_count < 2:
                continue
            builder.append(" ")
            builder.append(map_name[0:len(map_name)])
            builder.append("_set(&cinder_map, ")
            previous_expected = context.expected_type
            if key_type.index >= 0:
                context.expected_type = key_type
            emit_module_expression_state(state, arena.children[entry.first_child])
            builder.append(", ")
            if value_type.index >= 0:
                context.expected_type = value_type
            emit_module_expression_state(state, arena.children[entry.first_child + 1])
            context.expected_type = previous_expected
            builder.append(");")
        builder.append(" cinder_map; })")
        return
    if node.kind == SyntaxKind.EXPR_TUPLE:
        tuple_type = context.expected_type
        if codegen_context.context_type_is_runtime_generic(context.type_arena, tuple_type, context.type_source, "Tuple"):
            builder.append("((")
            codegen_type_names.emit_module_c_type(context.type_arena, tuple_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
            builder.append("){")
            item_index: i32 = 0
            for offset in range(0, node.child_count):
                child_id = arena.children[node.first_child + offset]
                if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                    if item_index > 0:
                        builder.append(", ")
                    builder.append(".item_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](item_index))
                    builder.append(" = ")
                    previous_expected = context.expected_type
                    item_type = codegen_context.context_generic_argument(context.type_arena, tuple_type, item_index)
                    if item_type.index >= 0:
                        context.expected_type = item_type
                    emit_module_expression_state(state, child_id)
                    context.expected_type = previous_expected
                    item_index += 1
            builder.append(" })")
            return
        semantic_tuple_type = codegen_context.context_semantic_type(context, id)
        if codegen_type_names.semantic_type_is_kind(type_table, semantic_tuple_type, types.TypeKind.TUPLE):
            builder.append("((")
            codegen_type_names.emit_semantic_c_type(type_table, semantic_tuple_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
            builder.append("){")
            semantic_item_index: i32 = 0
            for offset in range(0, node.child_count):
                child_id = arena.children[node.first_child + offset]
                if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                    if semantic_item_index > 0:
                        builder.append(", ")
                    builder.append(".item_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](semantic_item_index))
                    builder.append(" = ")
                    emit_module_expression_state(state, child_id)
                    semantic_item_index += 1
            builder.append(" })")
            return
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        if codegen_context.context_name_is_global(context, &name) or (not codegen_context.context_has_name(context, source, node.value_start, node.value_length) and not codegen_context.context_name_is_extern(context, &name) and codegen_context.context_has_function_name(context.type_arena, context.root, context.type_source, &name)):
            builder.append(prefix[0:len(prefix)])
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_BINARY:
        if node.flags == cast[i32](token.TokenKind.AND):
            builder.append("(")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            builder.append(" && ")
            emit_module_expression_state(state, codegen_names.second_child(arena, id))
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.OR):
            builder.append("(")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            builder.append(" || ")
            emit_module_expression_state(state, codegen_names.second_child(arena, id))
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.EQUAL):
            if codegen_context.expression_may_be_string(arena, context, codegen_names.first_child(arena, id), source) or codegen_context.expression_may_be_string(arena, context, codegen_names.second_child(arena, id), source):
                builder.append("cinder_selfhost_string_equal(")
                codegen_format.emit_string_value_expression(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
                builder.append(", ")
                codegen_format.emit_string_value_expression(arena, codegen_names.second_child(arena, id), source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
                builder.append(")")
                return
            builder.append("(")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            builder.append(" == ")
            emit_module_expression_state(state, codegen_names.second_child(arena, id))
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.PLUS) and (codegen_context.expression_may_be_string(arena, context, codegen_names.first_child(arena, id), source) or codegen_context.expression_may_be_string(arena, context, codegen_names.second_child(arena, id), source)):
            builder.append("cinder_selfhost_string_concat(")
            codegen_format.emit_string_value_expression(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
            builder.append(", ")
            codegen_format.emit_string_value_expression(arena, codegen_names.second_child(arena, id), source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
            builder.append(")")
            return
        builder.append("(")
        emit_module_expression_state(state, codegen_names.first_child(arena, id))
        builder.append(" ")
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        builder.append(" ")
        emit_module_expression_state(state, codegen_names.second_child(arena, id))
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_INDEX:
        codegen_access.emit_module_index(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_SLICE:
        codegen_access.emit_module_slice(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_UNARY:
        if node.flags == cast[i32](token.TokenKind.NOT):
            builder.append("!")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            return
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            builder.append("&")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            return
        if node.flags == cast[i32](token.TokenKind.STAR):
            builder.append("*")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            return
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        emit_module_expression_state(state, codegen_names.first_child(arena, id))
        return
    if node.kind == SyntaxKind.EXPR_ALLOC:
        allocation_type = codegen_type_names.find_child_type(arena, id)
        builder.append("(")
        codegen_type_names.emit_module_c_type(arena, allocation_type, source, builder, prefix, project_name, imports, context.specialization_names)
        builder.append(" *)cinder_alloc(")
        value = codegen_names.last_child(arena, id)
        emit_module_expression_state(state, value)
        builder.append(", sizeof(")
        codegen_type_names.emit_module_c_type(arena, allocation_type, source, builder, prefix, project_name, imports, context.specialization_names)
        builder.append("))")
        return
    if node.kind == SyntaxKind.EXPR_CAST:
        cast_type = codegen_type_names.find_child_type(arena, id)
        builder.append("(")
        codegen_type_names.emit_module_c_type(arena, cast_type, source, builder, prefix, project_name, imports, context.specialization_names)
        builder.append(")(")
        emit_module_expression_state(state, codegen_names.last_child(arena, id))
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_PROPAGATE:
        emit_module_propagate(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_TUPLE:
        builder.append("0")
        return
    if node.kind == SyntaxKind.EXPR_CALL:
        codegen_calls.emit_module_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        codegen_access.emit_module_attribute(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    codegen_names.append_source(builder, source, node.start, node.length)

def emit_module_propagate(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    value = codegen_names.first_child(arena, id)
    source_type = codegen_context.context_expression_type(arena, context, value, source)
    enclosing_type = context.current_return_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, source_type, context.type_source, "Result") or not codegen_context.context_type_is_runtime_generic(context.type_arena, enclosing_type, context.type_source, "Result"):
        builder.append("0")
        return
    source_name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, source_type, context.type_source, &source_name_builder, prefix, project_name, imports, context.specialization_names)
    source_name = source_name_builder.finish()
    enclosing_name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, enclosing_type, context.type_source, &enclosing_name_builder, prefix, project_name, imports, context.specialization_names)
    enclosing_name = enclosing_name_builder.finish()
    builder.append("({ ")
    builder.append(source_name[0:len(source_name)])
    builder.append(" cinder_result = ")
    previous_expected = context.expected_type
    context.expected_type = source_type
    emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
    context.expected_type = previous_expected
    builder.append("; if (cinder_result.tag == ")
    builder.append(source_name[0:len(source_name)])
    builder.append("_Tag_Err) return (")
    builder.append(enclosing_name[0:len(enclosing_name)])
    builder.append("){ .tag = ")
    builder.append(enclosing_name[0:len(enclosing_name)])
    builder.append("_Tag_Err, .data.err = cinder_result.data.err }; cinder_result.data.ok; })")
