import backend_ir
import codegen_access
import codegen_atomics
import codegen_calls
import codegen_context
import codegen_format
import codegen_context as codegen_model
import codegen_names
import codegen_specializations
import codegen_type_names
import project
import semantic
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_module_array_initializer(
    arena: &const SyntaxArena,
    id: NodeId,
    expected_type: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_LIST or not codegen_specializations.context_type_is_array(context.type_arena, expected_type):
        previous_expected = context.expected_type
        if expected_type.index >= 0:
            context.expected_type = expected_type
        emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)
        context.expected_type = previous_expected
        return
    node = arena.nodes[id.index]
    element_type = codegen_context.context_list_element_type(context.type_arena, expected_type, context.type_source)
    builder.append("{")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
            if emitted:
                builder.append(", ")
            emit_module_array_initializer(arena, child_id, element_type, source, builder, prefix, project_name, imports, context)
            emitted = true
    builder.append("}")

def emit_module_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    state = codegen_model.ModuleExpressionState(
        arena=arena,
        source=source,
        builder=builder,
        prefix=prefix,
        project_name=project_name,
        imports=imports,
        context=context,
    )
    emit_module_expression_state(state, id)


def emit_atomic_expression_state(state: &codegen_model.ModuleExpressionState, node: backend_ir.IRNode) -> void:
    builder: &StringBuilder = state.builder
    if node.kind == backend_ir.IRNodeKind.ATOMIC_RESULT_FIELD:
        builder.append("(")
        emit_module_expression_state(state, node.atomic_receiver)
        builder.append(").")
        if node.atomic_kind == semantic.AtomicIntrinsicKind.RESULT_EXCHANGED:
            builder.append("exchanged")
        else:
            builder.append("observed")
        return

    builder.append("(")
    append_atomic_temp_name(builder, "receiver", node.syntax.index)
    builder.append(" = ")
    if (node.flags & 16) == 0:
        builder.append("&(")
        emit_module_expression_state(state, node.atomic_receiver)
        builder.append(")")
    else:
        emit_module_expression_state(state, node.atomic_receiver)
    if node.atomic_first_evaluated.index >= 0:
        builder.append(", ")
        append_atomic_temp_name(builder, "first", node.syntax.index)
        builder.append(" = ")
        emit_module_expression_state(state, node.atomic_first_evaluated)
    if node.atomic_second_evaluated.index >= 0:
        builder.append(", ")
        append_atomic_temp_name(builder, "second", node.syntax.index)
        builder.append(" = ")
        emit_module_expression_state(state, node.atomic_second_evaluated)
    builder.append(", ")
    if node.kind == backend_ir.IRNodeKind.ATOMIC_LOAD:
        builder.append("atomic_load_explicit(&")
        append_atomic_temp_name(builder, "receiver", node.syntax.index)
        builder.append("->value, ")
        append_atomic_order(builder, node.atomic_order)
        builder.append(")")
    elif node.kind == backend_ir.IRNodeKind.ATOMIC_STORE:
        builder.append("atomic_store_explicit(&")
        append_atomic_temp_name(builder, "receiver", node.syntax.index)
        builder.append("->value, ")
        append_atomic_temp_name(builder, "first", node.syntax.index)
        builder.append(", ")
        append_atomic_order(builder, node.atomic_order)
        builder.append(")")
    elif node.kind == backend_ir.IRNodeKind.ATOMIC_EXCHANGE:
        builder.append("atomic_exchange_explicit(&")
        append_atomic_temp_name(builder, "receiver", node.syntax.index)
        builder.append("->value, ")
        append_atomic_temp_name(builder, "first", node.syntax.index)
        builder.append(", ")
        append_atomic_order(builder, node.atomic_order)
        builder.append(")")
    elif node.kind == backend_ir.IRNodeKind.ATOMIC_FETCH:
        append_atomic_fetch_name(builder, node.atomic_fetch_kind)
        builder.append("(&")
        append_atomic_temp_name(builder, "receiver", node.syntax.index)
        builder.append("->value, ")
        append_atomic_temp_name(builder, "first", node.syntax.index)
        builder.append(", ")
        append_atomic_order(builder, node.atomic_order)
        builder.append(")")
    elif node.kind == backend_ir.IRNodeKind.ATOMIC_COMPARE_EXCHANGE:
        append_atomic_temp_name(builder, "expected", node.syntax.index)
        builder.append(" = ")
        append_atomic_role_temp_name(builder, node, semantic.AtomicArgumentRole.EXPECTED)
        builder.append(", ")
        append_atomic_temp_name(builder, "exchanged", node.syntax.index)
        builder.append(" = atomic_compare_exchange_strong_explicit(&")
        append_atomic_temp_name(builder, "receiver", node.syntax.index)
        builder.append("->value, &")
        append_atomic_temp_name(builder, "expected", node.syntax.index)
        builder.append(", ")
        append_atomic_role_temp_name(builder, node, semantic.AtomicArgumentRole.DESIRED)
        builder.append(", ")
        append_atomic_order(builder, node.atomic_order)
        builder.append(", ")
        append_atomic_order(builder, node.atomic_order)
        builder.append("), (")
        codegen_atomics.append_atomic_result_name(builder, node.atomic_element_kind)
        builder.append("){ .exchanged = ")
        append_atomic_temp_name(builder, "exchanged", node.syntax.index)
        builder.append(", .observed = ")
        append_atomic_temp_name(builder, "expected", node.syntax.index)
        builder.append(" }")
    else:
        builder.append("0")
    builder.append(")")


def append_atomic_fetch_name(builder: &StringBuilder, kind: backend_ir.IRAtomicFetchKind) -> void:
    if kind == backend_ir.IRAtomicFetchKind.ADD:
        builder.append("atomic_fetch_add_explicit")
    elif kind == backend_ir.IRAtomicFetchKind.SUB:
        builder.append("atomic_fetch_sub_explicit")
    elif kind == backend_ir.IRAtomicFetchKind.AND:
        builder.append("atomic_fetch_and_explicit")
    elif kind == backend_ir.IRAtomicFetchKind.OR:
        builder.append("atomic_fetch_or_explicit")
    else:
        builder.append("atomic_fetch_xor_explicit")


def append_atomic_order(builder: &StringBuilder, order: backend_ir.IRAtomicMemoryOrder) -> void:
    if order == backend_ir.IRAtomicMemoryOrder.SEQ_CST:
        builder.append("memory_order_seq_cst")
    else:
        builder.append("memory_order_seq_cst")


def append_atomic_role_temp_name(builder: &StringBuilder, node: backend_ir.IRNode, role: semantic.AtomicArgumentRole) -> void:
    if node.atomic_first_role == role:
        append_atomic_temp_name(builder, "first", node.syntax.index)
    elif node.atomic_second_role == role:
        append_atomic_temp_name(builder, "second", node.syntax.index)
    else:
        builder.append("0")


def append_atomic_temp_name(builder: &StringBuilder, label: String, syntax_index: i32) -> void:
    builder.append("cinder_atomic_")
    builder.append(label[0:len(label)])
    builder.append("_")
    codegen_atomics.append_decimal(builder, syntax_index)


def emit_module_expression_state(state: &codegen_model.ModuleExpressionState, id: NodeId) -> void:
    arena: &const SyntaxArena = state.arena
    source: &const String = state.source
    builder: &StringBuilder = state.builder
    prefix: &const String = state.prefix
    project_name: &const String = state.project_name
    imports: &const List[project.ImportBinding] = state.imports
    context: &codegen_model.ModuleCodegenContext = state.context
    type_table: &const types.TypeTable = context.type_table
    if id.index < 0:
        builder.append("0")
        return
    path_borrow_temporary = codegen_context.context_path_borrow_temporary(context, id)
    if path_borrow_temporary >= 0:
        codegen_access.append_path_temporary_name(builder, "borrow", path_borrow_temporary)
        return
    atomic_index = codegen_atomics.atomic_node_index(context.semantic_nodes, id, context.active_user_specialization)
    if atomic_index >= 0:
        atomic_node = codegen_atomics.atomic_node_at(context.semantic_nodes, atomic_index)
        if atomic_node.kind != backend_ir.IRNodeKind.ATOMIC_INIT:
            emit_atomic_expression_state(state, atomic_node)
            return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        if node.flags == cast[i32](token.TokenKind.STRING):
            if codegen_specializations.module_type_is_c_string(context.type_arena, context.expected_type, context.type_source):
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
            else:
                builder.append("((CinderString){ .data = (char *)")
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
                builder.append(", .length = sizeof(")
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
                builder.append(") - 1, .capacity = 0 })")
        elif node.flags == cast[i32](token.TokenKind.NONE):
            if not codegen_calls.emit_option_none(builder, prefix, project_name, imports, context):
                builder.append("NULL")
        elif node.flags == cast[i32](token.TokenKind.NULL):
            builder.append("NULL")
        elif node.flags == cast[i32](token.TokenKind.INTEGER) or node.flags == cast[i32](token.TokenKind.FLOAT):
            codegen_names.append_numeric_literal(builder, source, node.value_start, node.value_length)
        else:
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_LIST:
        list_type = context.expected_type
        if codegen_specializations.context_type_is_array(context.type_arena, list_type):
            emit_module_array_initializer(arena, id, list_type, source, builder, prefix, project_name, imports, context)
            return
        has_specialized_list = codegen_context.context_type_is_runtime_generic(context.type_arena, list_type, context.type_source, "List")
        semantic_list_type = codegen_context.context_semantic_type(context, list_type)
        if not codegen_type_names.semantic_type_is_kind(type_table, semantic_list_type, types.TypeKind.LIST):
            semantic_list_type = codegen_context.context_semantic_type(context, id)
        has_semantic_list = codegen_type_names.semantic_type_is_kind(type_table, semantic_list_type, types.TypeKind.LIST)
        if has_semantic_list:
            semantic_list_record = type_table.types[semantic_list_type.index]
            if codegen_type_names.semantic_type_is_kind(type_table, semantic_list_record.inner, types.TypeKind.ERROR):
                has_semantic_list = false
        builder.append("({ ")
        if has_specialized_list:
            codegen_context.emit_context_c_type(context.type_arena, list_type, context.type_source, builder, prefix, project_name, imports, context)
        elif has_semantic_list:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("CinderList")
        builder.append(" cinder_list = (")
        if has_specialized_list:
            codegen_context.emit_context_c_type(context.type_arena, list_type, context.type_source, builder, prefix, project_name, imports, context)
        elif has_semantic_list:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_list_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("CinderList")
        builder.append("){0};")
        element_type = codegen_context.context_list_element_type(context.type_arena, list_type, context.type_source)
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                builder.append(" cinder_selfhost_list_append_value(&cinder_list, (")
                previous_expected = context.expected_type
                if element_type.index >= 0:
                    context.expected_type = element_type
                emit_module_expression_state(state, child_id)
                context.expected_type = previous_expected
                builder.append("));")
        builder.append(" cinder_list; })")
        return
    if node.kind == SyntaxKind.EXPR_SET:
        set_type = context.expected_type
        has_specialized_set = codegen_context.context_type_is_runtime_generic(context.type_arena, set_type, context.type_source, "Set")
        semantic_set_type = codegen_context.context_semantic_type(context, id)
        has_semantic_set = codegen_type_names.semantic_type_is_kind(type_table, semantic_set_type, types.TypeKind.SET)
        set_name_builder = StringBuilder()
        if has_specialized_set:
            codegen_context.emit_context_c_type(context.type_arena, set_type, context.type_source, &set_name_builder, prefix, project_name, imports, context)
        elif has_semantic_set:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_set_type, context.type_source, &set_name_builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("((CinderSet){0})")
            return
        set_name = set_name_builder.finish()
        builder.append("({ ")
        builder.append(set_name[0:len(set_name)])
        builder.append(" cinder_set = {0};")
        element_type = codegen_context.context_generic_argument(context.type_arena, set_type, 0)
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child_owned_path = codegen_access.expression_is_owned_path_string(arena, child_id, source, imports, context)
            child_temporary: i32 = -1
            if child_owned_path:
                child_temporary = context.temporary_index
                context.temporary_index += 1
                builder.append(" CinderString ")
                codegen_access.append_path_temporary_name(builder, "set_literal", child_temporary)
                builder.append(" = ")
                previous_expected = context.expected_type
                if element_type.index >= 0:
                    context.expected_type = element_type
                emit_module_expression_state(state, child_id)
                context.expected_type = previous_expected
                builder.append(";")
            builder.append(" (void)")
            builder.append(set_name[0:len(set_name)])
            builder.append("_add(&cinder_set, ")
            if child_owned_path:
                codegen_access.append_path_temporary_name(builder, "set_literal", child_temporary)
            else:
                previous_expected = context.expected_type
                if element_type.index >= 0:
                    context.expected_type = element_type
                emit_module_expression_state(state, child_id)
                context.expected_type = previous_expected
            builder.append(");")
            if child_owned_path:
                builder.append(" cinder_string_drop(&")
                codegen_access.append_path_temporary_name(builder, "set_literal", child_temporary)
                builder.append(");")
        builder.append(" cinder_set; })")
        return
    if node.kind == SyntaxKind.EXPR_MAP:
        map_type = context.expected_type
        has_specialized_map = codegen_context.context_type_is_runtime_generic(context.type_arena, map_type, context.type_source, "Map")
        semantic_map_type = codegen_context.context_semantic_type(context, id)
        has_semantic_map = codegen_type_names.semantic_type_is_kind(type_table, semantic_map_type, types.TypeKind.MAP)
        map_name_builder = StringBuilder()
        if has_specialized_map:
            codegen_context.emit_context_c_type(context.type_arena, map_type, context.type_source, &map_name_builder, prefix, project_name, imports, context)
        elif has_semantic_map:
            codegen_type_names.emit_semantic_c_type(type_table, semantic_map_type, context.type_source, &map_name_builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("((CinderMap){0})")
            return
        map_name = map_name_builder.finish()
        builder.append("({ ")
        builder.append(map_name[0:len(map_name)])
        builder.append(" cinder_map = {0};")
        key_type = codegen_context.context_generic_argument(context.type_arena, map_type, 0)
        value_type = codegen_context.context_generic_argument(context.type_arena, map_type, 1)
        for offset in range(0, node.child_count):
            entry_id = arena.children[node.first_child + offset]
            entry = arena.nodes[entry_id.index]
            if entry.kind != SyntaxKind.EXPR_MAP_ENTRY or entry.child_count < 2:
                continue
            key = arena.children[entry.first_child]
            key_owned_path = codegen_access.expression_is_owned_path_string(arena, key, source, imports, context)
            key_temporary: i32 = -1
            if key_owned_path:
                key_temporary = context.temporary_index
                context.temporary_index += 1
                builder.append(" CinderString ")
                codegen_access.append_path_temporary_name(builder, "map_literal_key", key_temporary)
                builder.append(" = ")
                previous_expected = context.expected_type
                if key_type.index >= 0:
                    context.expected_type = key_type
                emit_module_expression_state(state, key)
                context.expected_type = previous_expected
                builder.append(";")
            builder.append(" ")
            builder.append(map_name[0:len(map_name)])
            builder.append("_set(&cinder_map, ")
            previous_expected = context.expected_type
            if key_owned_path:
                codegen_access.append_path_temporary_name(builder, "map_literal_key", key_temporary)
            else:
                if key_type.index >= 0:
                    context.expected_type = key_type
                emit_module_expression_state(state, key)
            builder.append(", ")
            if value_type.index >= 0:
                context.expected_type = value_type
            emit_module_expression_state(state, arena.children[entry.first_child + 1])
            context.expected_type = previous_expected
            builder.append(");")
            if key_owned_path:
                builder.append(" cinder_string_drop(&")
                codegen_access.append_path_temporary_name(builder, "map_literal_key", key_temporary)
                builder.append(");")
        builder.append(" cinder_map; })")
        return
    if node.kind == SyntaxKind.EXPR_TUPLE:
        tuple_type = context.expected_type
        if codegen_context.context_type_is_runtime_generic(context.type_arena, tuple_type, context.type_source, "Tuple"):
            builder.append("((")
            codegen_context.emit_context_c_type(context.type_arena, tuple_type, context.type_source, builder, prefix, project_name, imports, context)
            builder.append("){")
            item_index: i32 = 0
            for offset in range(0, node.child_count):
                child_id = arena.children[node.first_child + offset]
                if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                    if item_index > 0:
                        builder.append(", ")
                    builder.append(".item_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](item_index))
                    builder.append(" = ")
                    previous_expected = context.expected_type
                    item_type = codegen_context.context_generic_argument(context.type_arena, tuple_type, item_index)
                    if item_type.index >= 0:
                        context.expected_type = item_type
                    emit_module_expression_state(state, child_id)
                    context.expected_type = previous_expected
                    item_index += 1
            builder.append(" })")
            return
        semantic_tuple_type = codegen_context.context_semantic_type(context, id)
        if codegen_type_names.semantic_type_is_kind(type_table, semantic_tuple_type, types.TypeKind.TUPLE):
            builder.append("((")
            codegen_type_names.emit_semantic_c_type(type_table, semantic_tuple_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
            builder.append("){")
            semantic_item_index: i32 = 0
            for offset in range(0, node.child_count):
                child_id = arena.children[node.first_child + offset]
                if child_id.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[child_id.index].kind):
                    if semantic_item_index > 0:
                        builder.append(", ")
                    builder.append(".item_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](semantic_item_index))
                    builder.append(" = ")
                    emit_module_expression_state(state, child_id)
                    semantic_item_index += 1
            builder.append(" })")
            return
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        imported = codegen_names.find_import_member(imports, &name)
        if len(imported.module_name) > 0 and len(imported.member) > 0 and not imported.virtual_builtin:
            builder.append(codegen_names.c_prefix(project_name, &imported.module_name))
            builder.append(imported.member)
            return
        if codegen_context.context_name_is_global(context, &name) or (not codegen_context.context_has_name(context, source, node.value_start, node.value_length) and not codegen_context.context_name_is_extern(context, &name) and codegen_context.context_has_function_name(context.type_arena, context.root, context.type_source, &name)):
            builder.append(prefix[0:len(prefix)])
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_BINARY:
        if emit_set_algebra_binary(arena, id, source, builder, prefix, project_name, imports, context, state):
            return
        if emit_collection_membership_binary(arena, id, source, builder, prefix, project_name, imports, context, state):
            return
        if node.flags == cast[i32](token.TokenKind.AND):
            builder.append("(")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            builder.append(" && ")
            emit_module_expression_state(state, codegen_names.second_child(arena, id))
            builder.append(")")
            return
        if node.flags == cast[i32](token.TokenKind.OR):
            builder.append("(")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            builder.append(" || ")
            emit_module_expression_state(state, codegen_names.second_child(arena, id))
            builder.append(")")
            return
        is_comparison = node.flags == cast[i32](token.TokenKind.EQUAL) or node.flags == cast[i32](token.TokenKind.NOT_EQUAL) or node.flags == cast[i32](token.TokenKind.LESS) or node.flags == cast[i32](token.TokenKind.LESS_EQUAL) or node.flags == cast[i32](token.TokenKind.GREATER) or node.flags == cast[i32](token.TokenKind.GREATER_EQUAL)
        if is_comparison:
            left = codegen_names.first_child(arena, id)
            right = codegen_names.second_child(arena, id)
            if codegen_context.expression_may_be_string(arena, context, left, source) or codegen_context.expression_may_be_string(arena, context, right, source):
                if codegen_access.expression_is_owned_path_string(arena, left, source, imports, context) or codegen_access.expression_is_owned_path_string(arena, right, source, imports, context):
                    emit_owned_path_string_comparison(arena, id, left, right, source, builder, prefix, project_name, imports, context, state)
                    return
                if node.flags == cast[i32](token.TokenKind.NOT_EQUAL):
                    builder.append("!")
                if node.flags == cast[i32](token.TokenKind.EQUAL) or node.flags == cast[i32](token.TokenKind.NOT_EQUAL):
                    builder.append("cinder_selfhost_string_equal(")
                else:
                    builder.append("(cinder_selfhost_string_compare(")
                codegen_format.emit_string_value_expression(arena, left, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
                builder.append(", ")
                codegen_format.emit_string_value_expression(arena, right, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
                builder.append(")")
                if node.flags == cast[i32](token.TokenKind.LESS):
                    builder.append(" < 0)")
                elif node.flags == cast[i32](token.TokenKind.LESS_EQUAL):
                    builder.append(" <= 0)")
                elif node.flags == cast[i32](token.TokenKind.GREATER):
                    builder.append(" > 0)")
                elif node.flags == cast[i32](token.TokenKind.GREATER_EQUAL):
                    builder.append(" >= 0)")
                return
        if node.flags == cast[i32](token.TokenKind.PLUS) and (codegen_context.expression_may_be_string(arena, context, codegen_names.first_child(arena, id), source) or codegen_context.expression_may_be_string(arena, context, codegen_names.second_child(arena, id), source)):
            left = codegen_names.first_child(arena, id)
            right = codegen_names.second_child(arena, id)
            if codegen_access.expression_is_owned_path_string(arena, left, source, imports, context) or codegen_access.expression_is_owned_path_string(arena, right, source, imports, context):
                emit_owned_path_string_concat(arena, left, right, source, builder, prefix, project_name, imports, context, state)
                return
            builder.append("cinder_selfhost_string_concat(")
            codegen_format.emit_string_value_expression(arena, left, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
            builder.append(", ")
            codegen_format.emit_string_value_expression(arena, right, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
            builder.append(")")
            return
        builder.append("(")
        emit_module_expression_state(state, codegen_names.first_child(arena, id))
        builder.append(" ")
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        builder.append(" ")
        emit_module_expression_state(state, codegen_names.second_child(arena, id))
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_INDEX:
        codegen_access.emit_module_index(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_SLICE:
        codegen_access.emit_module_slice(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_UNARY:
        if node.flags == cast[i32](token.TokenKind.NOT):
            builder.append("!")
            emit_module_expression_state(state, codegen_names.first_child(arena, id))
            return
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            operand = codegen_names.first_child(arena, id)
            if operand.index >= 0:
                operand_node = arena.nodes[operand.index]
                if operand_node.kind == SyntaxKind.EXPR_UNARY and operand_node.flags == cast[i32](token.TokenKind.STAR):
                    owner = codegen_names.first_child(arena, operand)
                    if codegen_context.context_expression_is_owned(arena, context, owner, source):
                        builder.append("(")
                        emit_module_expression_state(state, owner)
                        builder.append(").ptr")
                        return
            builder.append("&")
            emit_module_expression_state(state, operand)
            return
        if node.flags == cast[i32](token.TokenKind.STAR):
            operand = codegen_names.first_child(arena, id)
            if codegen_context.context_expression_is_owned(arena, context, operand, source):
                builder.append("(*(")
                emit_module_expression_state(state, operand)
                builder.append(").ptr)")
                return
            builder.append("*")
            emit_module_expression_state(state, operand)
            return
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        emit_module_expression_state(state, codegen_names.first_child(arena, id))
        return
    if node.kind == SyntaxKind.EXPR_ALLOC:
        allocation_type = codegen_type_names.find_child_type(arena, id)
        builder.append("(")
        codegen_context.emit_context_c_type(arena, allocation_type, source, builder, prefix, project_name, imports, context)
        builder.append(" *)cinder_alloc(")
        value = codegen_names.last_child(arena, id)
        emit_module_expression_state(state, value)
        builder.append(", sizeof(")
        codegen_context.emit_context_c_type(arena, allocation_type, source, builder, prefix, project_name, imports, context)
        builder.append("))")
        return
    if node.kind == SyntaxKind.EXPR_CAST:
        cast_type = codegen_type_names.find_child_type(arena, id)
        builder.append("(")
        codegen_context.emit_context_c_type(arena, cast_type, source, builder, prefix, project_name, imports, context)
        builder.append(")(")
        emit_module_expression_state(state, codegen_names.last_child(arena, id))
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_PROPAGATE:
        emit_module_propagate(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_TUPLE:
        builder.append("0")
        return
    if node.kind == SyntaxKind.EXPR_CALL:
        codegen_calls.emit_module_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        codegen_access.emit_module_attribute(arena, id, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
        return
    codegen_names.append_source(builder, source, node.start, node.length)


def emit_owned_path_string_concat(
    arena: &const SyntaxArena,
    left: NodeId,
    right: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
) -> void:
    left_owned = codegen_access.expression_is_owned_path_string(arena, left, source, imports, context)
    right_owned = codegen_access.expression_is_owned_path_string(arena, right, source, imports, context)
    builder.append("({ ")
    left_temporary: i32 = -1
    right_temporary: i32 = -1
    if left_owned:
        left_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
        builder.append(" = ")
        emit_module_expression_state(state, left)
        builder.append("; ")
    if right_owned:
        right_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
        builder.append(" = ")
        emit_module_expression_state(state, right)
        builder.append("; ")
    result_temporary = context.temporary_index
    context.temporary_index += 1
    builder.append("CinderString ")
    codegen_access.append_path_temporary_name(builder, "concat", result_temporary)
    builder.append(" = cinder_selfhost_string_concat(")
    if left_owned:
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
    else:
        codegen_format.emit_string_value_expression(arena, left, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
    builder.append(", ")
    if right_owned:
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
    else:
        codegen_format.emit_string_value_expression(arena, right, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
    builder.append("); ")
    if right_owned:
        builder.append("cinder_string_drop(&")
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
        builder.append("); ")
    if left_owned:
        builder.append("cinder_string_drop(&")
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
        builder.append("); ")
    codegen_access.append_path_temporary_name(builder, "concat", result_temporary)
    builder.append("; })")


def emit_owned_path_string_comparison(
    arena: &const SyntaxArena,
    id: NodeId,
    left: NodeId,
    right: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
) -> void:
    left_owned = codegen_access.expression_is_owned_path_string(arena, left, source, imports, context)
    right_owned = codegen_access.expression_is_owned_path_string(arena, right, source, imports, context)
    builder.append("({ ")
    left_temporary: i32 = -1
    right_temporary: i32 = -1
    if left_owned:
        left_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
        builder.append(" = ")
        emit_module_expression_state(state, left)
        builder.append("; ")
    if right_owned:
        right_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
        builder.append(" = ")
        emit_module_expression_state(state, right)
        builder.append("; ")
    result_temporary = context.temporary_index
    context.temporary_index += 1
    builder.append("bool ")
    codegen_access.append_path_temporary_name(builder, "comparison", result_temporary)
    builder.append(" = ")
    node = arena.nodes[id.index]
    if node.flags == cast[i32](token.TokenKind.NOT_EQUAL):
        builder.append("!")
    if node.flags == cast[i32](token.TokenKind.EQUAL) or node.flags == cast[i32](token.TokenKind.NOT_EQUAL):
        builder.append("cinder_selfhost_string_equal(")
    else:
        builder.append("(cinder_selfhost_string_compare(")
    if left_owned:
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
    else:
        codegen_format.emit_string_value_expression(arena, left, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
    builder.append(", ")
    if right_owned:
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
    else:
        codegen_format.emit_string_value_expression(arena, right, source, builder, prefix, project_name, imports, context, state, emit_module_expression_state)
    builder.append(")")
    if node.flags == cast[i32](token.TokenKind.LESS):
        builder.append(" < 0)")
    elif node.flags == cast[i32](token.TokenKind.LESS_EQUAL):
        builder.append(" <= 0)")
    elif node.flags == cast[i32](token.TokenKind.GREATER):
        builder.append(" > 0)")
    elif node.flags == cast[i32](token.TokenKind.GREATER_EQUAL):
        builder.append(" >= 0)")
    builder.append("; ")
    if right_owned:
        builder.append("cinder_string_drop(&")
        codegen_access.append_path_temporary_name(builder, "consumer", right_temporary)
        builder.append("); ")
    if left_owned:
        builder.append("cinder_string_drop(&")
        codegen_access.append_path_temporary_name(builder, "consumer", left_temporary)
        builder.append("); ")
    codegen_access.append_path_temporary_name(builder, "comparison", result_temporary)
    builder.append("; })")


def emit_set_algebra_binary(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
) -> bool:
    operator = arena.nodes[id.index].flags
    operation = ""
    if operator == cast[i32](token.TokenKind.PIPE):
        operation = "union"
    elif operator == cast[i32](token.TokenKind.AMPERSAND):
        operation = "intersection"
    elif operator == cast[i32](token.TokenKind.MINUS):
        operation = "difference"
    elif operator == cast[i32](token.TokenKind.CARET):
        operation = "symmetric_difference"
    else:
        return false
    left = codegen_names.first_child(arena, id)
    right = codegen_names.second_child(arena, id)
    if not codegen_context.context_expression_is_collection(arena, context, left, source, "Set", types.TypeKind.SET):
        return false
    name_builder = StringBuilder()
    if not codegen_context.emit_context_expression_specialization_name(arena, context, left, source, &name_builder, prefix, project_name, imports, "Set", types.TypeKind.SET):
        return false
    name = name_builder.finish()
    builder.append("({ ")
    builder.append(name[0:len(name)])
    builder.append(" cinder_left = ")
    emit_module_expression_state(state, left)
    builder.append("; ")
    builder.append(name[0:len(name)])
    builder.append(" cinder_right = ")
    emit_module_expression_state(state, right)
    builder.append("; ")
    builder.append(name[0:len(name)])
    builder.append(" cinder_result = ")
    builder.append(name[0:len(name)])
    builder.append("_")
    builder.append(operation[0:len(operation)])
    builder.append("(&cinder_left, &cinder_right); ")
    if expression_creates_owned_set(arena, left, source):
        builder.append(name[0:len(name)])
        builder.append("_drop(&cinder_left); ")
    if expression_creates_owned_set(arena, right, source):
        builder.append(name[0:len(name)])
        builder.append("_drop(&cinder_right); ")
    builder.append("cinder_result; })")
    return true


def emit_collection_membership_binary(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
) -> bool:
    operator = arena.nodes[id.index].flags
    if operator != cast[i32](token.TokenKind.IN) and operator != cast[i32](token.TokenKind.NOT):
        return false
    member = codegen_names.first_child(arena, id)
    collection = codegen_names.second_child(arena, id)
    table: &const types.TypeTable = context.type_table
    collection_type = strip_semantic_indirection(table, codegen_context.context_semantic_type(context, collection))
    if collection_type.index < 0 or collection_type.index >= cast[i32](len(table.types)):
        return false
    record = table.types[collection_type.index]
    is_not_in = operator == cast[i32](token.TokenKind.NOT)
    if record.kind == types.TypeKind.SET or record.kind == types.TypeKind.MAP:
        name_builder = StringBuilder()
        codegen_type_names.emit_semantic_specialized_type_name(table, collection_type, context.type_source, &name_builder, context.specialization_names)
        name = name_builder.finish()
        member_owned_path = codegen_access.expression_is_owned_path_string(arena, member, source, imports, context)
        member_temporary: i32 = -1
        builder.append("({ ")
        builder.append(name[0:len(name)])
        builder.append(" cinder_collection = ")
        emit_module_expression_state(state, collection)
        builder.append("; ")
        if member_owned_path:
            member_temporary = context.temporary_index
            context.temporary_index += 1
            builder.append("CinderString ")
            codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
            builder.append(" = ")
            emit_module_expression_state(state, member)
            builder.append("; ")
        builder.append("bool cinder_contains = ")
        if record.kind == types.TypeKind.SET:
            builder.append(name[0:len(name)])
            builder.append("_contains(&cinder_collection, ")
            if member_owned_path:
                codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
            else:
                emit_module_expression_state(state, member)
            builder.append(")")
        else:
            builder.append(name[0:len(name)])
            builder.append("_lookup(&cinder_collection, ")
            if member_owned_path:
                codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
            else:
                emit_module_expression_state(state, member)
            builder.append(") != NULL")
        builder.append("; ")
        if member_owned_path:
            builder.append("cinder_string_drop(&")
            codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
            builder.append("); ")
        if expression_creates_owned_collection(arena, collection, source):
            builder.append(name[0:len(name)])
            builder.append("_drop(&cinder_collection); ")
        if is_not_in:
            builder.append("!")
        builder.append("cinder_contains; })")
        return true
    if not types.is_map_view_kind(record.kind):
        return false
    if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
        return false
    map_name_builder = StringBuilder()
    codegen_type_names.emit_semantic_specialized_type_name(table, record.inner, context.type_source, &map_name_builder, context.specialization_names)
    map_name = map_name_builder.finish()
    member_owned_path = codegen_access.expression_is_owned_path_string(arena, member, source, imports, context)
    member_temporary: i32 = -1
    builder.append("({ __auto_type cinder_view = ")
    emit_module_expression_state(state, collection)
    builder.append("; ")
    if member_owned_path:
        member_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
        builder.append(" = ")
        emit_module_expression_state(state, member)
        builder.append("; ")
    if record.kind == types.TypeKind.MAP_ITEMS:
        builder.append("__auto_type cinder_item = ")
        emit_module_expression_state(state, member)
        builder.append("; ")
    builder.append("bool cinder_contains = ")
    if is_not_in:
        builder.append("!")
    builder.append(map_name[0:len(map_name)])
    if record.kind == types.TypeKind.MAP_KEYS:
        builder.append("_keys_contains(&cinder_view, ")
        if member_owned_path:
            codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
        else:
            emit_module_expression_state(state, member)
    elif record.kind == types.TypeKind.MAP_VALUES:
        builder.append("_values_contains(&cinder_view, ")
        if member_owned_path:
            codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
        else:
            emit_module_expression_state(state, member)
    else:
        builder.append("_items_contains(&cinder_view, cinder_item.item_0, cinder_item.item_1")
    builder.append("); ")
    if member_owned_path:
        builder.append("cinder_string_drop(&")
        codegen_access.append_path_temporary_name(builder, "membership", member_temporary)
        builder.append("); ")
    builder.append("cinder_contains; })")
    return true


def strip_semantic_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current


def expression_creates_owned_set(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_SET or node.kind == SyntaxKind.EXPR_BINARY:
        return true
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0:
        return true
    callee_node = arena.nodes[callee.index]
    if callee_node.kind != SyntaxKind.EXPR_ATTRIBUTE:
        return true
    member = codegen_names.second_child(arena, callee)
    if member.index < 0:
        return true
    member_node = arena.nodes[member.index]
    return (
        codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "union")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "intersection")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "difference")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "symmetric_difference")
    )


def expression_creates_owned_collection(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    kind = arena.nodes[id.index].kind
    if kind == SyntaxKind.EXPR_MAP or kind == SyntaxKind.EXPR_SET:
        return true
    if kind == SyntaxKind.EXPR_BINARY or kind == SyntaxKind.EXPR_CALL:
        return expression_creates_owned_set(arena, id, source)
    return false


def emit_module_propagate(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    value = codegen_names.first_child(arena, id)
    source_type = codegen_context.context_expression_type(arena, context, value, source)
    enclosing_type = context.current_return_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, enclosing_type, context.type_source, "Result"):
        builder.append("0")
        return
    source_is_local_result = codegen_context.context_type_is_runtime_generic(context.type_arena, source_type, context.type_source, "Result")
    source_name = ""
    if source_is_local_result:
        source_name_builder = StringBuilder()
        codegen_type_names.emit_specialized_type_name(context.type_arena, source_type, context.type_source, &source_name_builder, prefix, project_name, imports, context.specialization_names)
        source_name = source_name_builder.finish()
    else:
        source_name = codegen_context.context_call_result_c_type(arena, context, value, source)
    if len(source_name) == 0:
        builder.append("0")
        return
    enclosing_name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, enclosing_type, context.type_source, &enclosing_name_builder, prefix, project_name, imports, context.specialization_names)
    enclosing_name = enclosing_name_builder.finish()
    builder.append("({ ")
    builder.append(source_name[0:len(source_name)])
    builder.append(" cinder_result = ")
    previous_expected = context.expected_type
    if source_is_local_result:
        context.expected_type = source_type
    emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
    context.expected_type = previous_expected
    builder.append("; if (cinder_result.tag == ")
    builder.append(source_name[0:len(source_name)])
    builder.append("_Tag_Err) { ")
    emit_module_propagate_cleanups(arena, source, builder, prefix, project_name, imports, context)
    builder.append("return (")
    builder.append(enclosing_name[0:len(enclosing_name)])
    builder.append("){ .tag = ")
    builder.append(enclosing_name[0:len(enclosing_name)])
    builder.append("_Tag_Err, .data.err = cinder_result.data.err }; } cinder_result.data.ok; })")


def emit_module_propagate_cleanups(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    emit_module_propagate_active_cleanups(arena, source, builder, prefix, project_name, imports, context, 0)


def emit_module_propagate_iterator_guard_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    iterator_guard_names: &const List[String] = &context.iterator_guard_names
    index = end
    while index > start:
        index -= 1
        name: &const String = &iterator_guard_names[index]
        builder.append("if (")
        builder.append(name[0:len(name)])
        builder.append(" != NULL && ")
        builder.append(name[0:len(name)])
        builder.append("->active_iterators > 0) ")
        builder.append(name[0:len(name)])
        builder.append("->active_iterators -= 1; ")


def emit_module_propagate_defers_until(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    defer_start: usize,
    defer_end: usize,
) -> void:
    index = defer_end
    while index > defer_start:
        index -= 1
        emit_module_expression(arena, context.deferred_expressions[index], source, builder, prefix, project_name, imports, context)
        builder.append("; ")


def emit_module_propagate_with_resource_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    index = end
    while index > start:
        index -= 1
        builder.append("fclose(")
        builder.append(context.with_resources[index])
        builder.append("); ")


def emit_module_propagate_lock_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    lock_cleanups: &const List[codegen_context.CodegenLockCleanup] = &context.lock_cleanups
    index = end
    while index > start:
        index -= 1
        cleanup: &const codegen_context.CodegenLockCleanup = &lock_cleanups[index]
        if not cleanup.collection:
            builder.append("cinder_lock_release(")
            builder.append(cleanup.name[0:len(cleanup.name)])
            builder.append("); ")
            continue
        builder.append("for (size_t cinder_lock_release_index = ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".length; cinder_lock_release_index > 0; --cinder_lock_release_index) { size_t cinder_lock_item = cinder_lock_release_index - 1; if (cinder_lock_release_index < ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".length && ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_item] == ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_release_index]) continue; cinder_lock_release(")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_item]); } CinderList_Lock_drop(&")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append("); ")


def emit_module_propagate_cleanup_segment(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    local_start: usize,
    local_end: usize,
    defer_start: usize,
    defer_end: usize,
    with_resource_start: usize,
    with_resource_end: usize,
    iterator_guard_start: usize,
    iterator_guard_end: usize,
    lock_cleanup_start: usize,
    lock_cleanup_end: usize,
) -> void:
    emit_module_propagate_iterator_guard_cleanups_until(builder, context, iterator_guard_start, iterator_guard_end)
    emit_module_propagate_defers_until(arena, source, builder, prefix, project_name, imports, context, defer_start, defer_end)
    emit_module_propagate_with_resource_cleanups_until(builder, context, with_resource_start, with_resource_end)
    codegen_context.emit_context_live_drops_range(arena, context, source, builder, local_start, local_end, prefix, project_name, imports)
    emit_module_propagate_lock_cleanups_until(builder, context, lock_cleanup_start, lock_cleanup_end)


def emit_module_propagate_active_cleanups(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    boundary_start: usize,
) -> void:
    local_end = len(context.local_types)
    defer_end = len(context.deferred_expressions)
    with_resource_end = len(context.with_resources)
    iterator_guard_end = len(context.iterator_guard_names)
    lock_cleanup_end = len(context.lock_cleanups)
    boundary_index = len(context.cleanup_boundaries)
    while boundary_index > boundary_start:
        boundary_index -= 1
        emit_module_propagate_cleanup_segment(
            arena,
            source,
            builder,
            prefix,
            project_name,
            imports,
            context,
            codegen_context.context_scope_local_start(context, boundary_index),
            local_end,
            codegen_context.context_scope_defer_start(context, boundary_index),
            defer_end,
            codegen_context.context_scope_with_resource_start(context, boundary_index),
            with_resource_end,
            codegen_context.context_scope_iterator_guard_start(context, boundary_index),
            iterator_guard_end,
            codegen_context.context_scope_lock_cleanup_start(context, boundary_index),
            lock_cleanup_end,
        )
        local_end = codegen_context.context_scope_local_start(context, boundary_index)
        defer_end = codegen_context.context_scope_defer_start(context, boundary_index)
        with_resource_end = codegen_context.context_scope_with_resource_start(context, boundary_index)
        iterator_guard_end = codegen_context.context_scope_iterator_guard_start(context, boundary_index)
        lock_cleanup_end = codegen_context.context_scope_lock_cleanup_start(context, boundary_index)
    if boundary_start == 0:
        emit_module_propagate_cleanup_segment(
            arena,
            source,
            builder,
            prefix,
            project_name,
            imports,
            context,
            context.local_start,
            local_end,
            0,
            defer_end,
            0,
            with_resource_end,
            0,
            iterator_guard_end,
            0,
            lock_cleanup_end,
        )
