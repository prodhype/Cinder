import backend_ir
import checker
import checker_core
import classes
import codegen
import codegen_names
import codegen_reflection
import fs
import lexer
import parser
import project


struct EmitResult:
    ok: bool
    sources: List[String]
    headers: List[String]
    error: String


def emit_error(message: String) -> EmitResult:
    sources: List[String] = []
    headers: List[String] = []
    return EmitResult(ok=false, sources=sources, headers=headers, error=message)


def emit_ok(sources: List[String], headers: List[String]) -> EmitResult:
    return EmitResult(ok=true, sources=sources, headers=headers, error="")


def write_project(graph: &const project.ProjectGraph, output_dir: String) -> EmitResult:
    if not fs.ensure_dir(&output_dir):
        return emit_error("failed to create output directory: " + output_dir)
    sources: List[String] = []
    headers: List[String] = []
    specialization_names = collect_project_specialization_names(graph)
    class_model = classes.collect_project_class_model(graph, &specialization_names)
    reflection_model = codegen_reflection.collect_project_reflection_model(graph, &specialization_names, &class_model)
    index: usize = 0
    while index < len(graph.modules):
        header_name = codegen.generated_header_name(&graph.modules[index].name)
        source_name = codegen.generated_source_name(&graph.modules[index].name)
        header_path = fs.join_path(&output_dir, &header_name)
        source_path = fs.join_path(&output_dir, &source_name)
        header_parent = fs.parent_dir(&header_path)
        source_parent = fs.parent_dir(&source_path)
        if not fs.ensure_dir(&header_parent) or not fs.ensure_dir(&source_parent):
            return emit_error("failed to create generated directory")
        scan = lexer.new_lexer(graph.modules[index].source[0:len(graph.modules[index].source)])
        scan.tokenize()
        parsed = parser.new_parser(scan)
        root = parsed.parse_module()
        checked: checker_core.Checker = checker.new_checker()
        checker.collect_symbols(checked, parsed.arena, root, graph.modules[index].source)
        checker.validate_import_member_calls(checked, parsed.arena, root, graph.modules[index].source, &graph.modules[index].imports, &graph.modules)
        checker.validate_names(checked, parsed.arena, root, graph.modules[index].source)
        ir = backend_ir.lower(parsed.arena, root, checked.model, checked.type_table)
        if not ir.is_valid:
            return emit_error("internal atomic IR validation failed")
        header = codegen.emit_module_header_from_ir_with_models(
            ir,
            parsed.arena,
            &graph.modules[index].source,
            &graph.modules[index].name,
            &graph.project_name,
            &graph.modules[index].dependencies,
            &graph.modules[index].imports,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        source = codegen.emit_module_source_from_ir_with_models(
            ir,
            parsed.arena,
            &graph.modules[index].source,
            &graph.modules[index].name,
            &graph.project_name,
            &graph.modules[index].imports,
            graph.modules[index].name == graph.entry_module,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        headers.append(header_path[0:len(header_path)])
        sources.append(source_path[0:len(source_path)])
        write_text(header_path, header)
        write_text(source_path, source)
        index += 1
    return emit_ok(sources, headers)


def amalgamated_c(graph: &const project.ProjectGraph) -> String:
    builder = StringBuilder()
    specialization_names = collect_project_specialization_names(graph)
    class_model = classes.collect_project_class_model(graph, &specialization_names)
    reflection_model = codegen_reflection.collect_project_reflection_model(graph, &specialization_names, &class_model)
    builder.append("/* Generated by Cinder self-host stage. */\n")
    builder.append("/* Amalgamated project: ")
    builder.append(graph.project_name)
    builder.append(" */\n\n")
    index: usize = 0
    while index < len(graph.modules):
        scan = lexer.new_lexer(graph.modules[index].source[0:len(graph.modules[index].source)])
        scan.tokenize()
        parsed = parser.new_parser(scan)
        root = parsed.parse_module()
        checked: checker_core.Checker = checker.new_checker()
        checker.collect_symbols(checked, parsed.arena, root, graph.modules[index].source)
        checker.validate_import_member_calls(checked, parsed.arena, root, graph.modules[index].source, &graph.modules[index].imports, &graph.modules)
        checker.validate_names(checked, parsed.arena, root, graph.modules[index].source)
        ir = backend_ir.lower(parsed.arena, root, checked.model, checked.type_table)
        if not ir.is_valid:
            return ""
        header = codegen.emit_module_header_from_ir_with_models(
            ir,
            parsed.arena,
            &graph.modules[index].source,
            &graph.modules[index].name,
            &graph.project_name,
            &graph.modules[index].dependencies,
            &graph.modules[index].imports,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        builder.append(strip_generated_includes(&header))
        builder.append("\n")
        index += 1
    index = 0
    while index < len(graph.modules):
        scan = lexer.new_lexer(graph.modules[index].source[0:len(graph.modules[index].source)])
        scan.tokenize()
        parsed = parser.new_parser(scan)
        root = parsed.parse_module()
        checked: checker_core.Checker = checker.new_checker()
        checker.collect_symbols(checked, parsed.arena, root, graph.modules[index].source)
        checker.validate_import_member_calls(checked, parsed.arena, root, graph.modules[index].source, &graph.modules[index].imports, &graph.modules)
        checker.validate_names(checked, parsed.arena, root, graph.modules[index].source)
        ir = backend_ir.lower(parsed.arena, root, checked.model, checked.type_table)
        if not ir.is_valid:
            return ""
        source = codegen.emit_module_source_from_ir_with_models(
            ir,
            parsed.arena,
            &graph.modules[index].source,
            &graph.modules[index].name,
            &graph.project_name,
            &graph.modules[index].imports,
            graph.modules[index].name == graph.entry_module,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        builder.append(strip_generated_includes(&source))
        builder.append("\n")
        index += 1
    return builder.finish()


def collect_project_specialization_names(graph: &const project.ProjectGraph) -> codegen_names.SpecializationNameRegistry:
    registry = codegen.new_specialization_name_registry()
    index: usize = 0
    while index < len(graph.modules):
        scan = lexer.new_lexer(graph.modules[index].source[0:len(graph.modules[index].source)])
        scan.tokenize()
        parsed = parser.new_parser(scan)
        root = parsed.parse_module()
        prefix = codegen.c_prefix(&graph.project_name, &graph.modules[index].name)
        codegen.collect_module_specialization_names(
            &registry,
            parsed.arena,
            root,
            &graph.modules[index].source,
            &prefix,
            &graph.project_name,
            &graph.modules[index].imports,
        )
        index += 1
    return registry


def write_text(path: String, content: String) -> void:
    parent = fs.parent_dir(&path)
    fs.ensure_dir(&parent)
    with open(path, "wb") as file:
        file.write(content)



def strip_generated_includes(source: &const String) -> String:
    builder = StringBuilder()
    start: usize = 0
    while start <= len(source):
        end = start
        while end < len(source) and source.byte_at(end) != 10 and source.byte_at(end) != 13:
            end += 1
        line = source[start:end]
        if not fs.starts_with(&line, "#include \"cinder_gen/"):
            builder.append(line)
            builder.append("\n")
        if end >= len(source):
            break
        start = end + 1
        if start < len(source) and source.byte_at(end) == 13 and source.byte_at(start) == 10:
            start += 1
    return builder.finish()
