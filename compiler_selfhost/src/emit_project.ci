import backend_ir
import checker
import checker_core
import classes
import codegen
import codegen_names
import codegen_reflection
import fs
import project


struct CompiledModule:
    module_index: usize
    checked: checker_core.Checker
    ir: backend_ir.IRModule


struct AnalyzedModule:
    module_index: usize
    checked: checker_core.Checker


struct AnalysisResult:
    ok: bool
    modules: List[AnalyzedModule]
    error: String


struct CompileResult:
    ok: bool
    modules: List[CompiledModule]
    error: String


struct EmitResult:
    ok: bool
    sources: List[String]
    headers: List[String]
    error: String


def emit_error(message: String) -> EmitResult:
    sources: List[String] = []
    headers: List[String] = []
    return EmitResult(ok=false, sources=sources, headers=headers, error=message)


def emit_ok(sources: List[String], headers: List[String]) -> EmitResult:
    return EmitResult(ok=true, sources=sources, headers=headers, error="")


def compile_error(message: String) -> CompileResult:
    modules: List[CompiledModule] = []
    return CompileResult(ok=false, modules=modules, error=message)


def compile_ok(modules: List[CompiledModule]) -> CompileResult:
    return CompileResult(ok=true, modules=modules, error="")


def analysis_error(message: String) -> AnalysisResult:
    modules: List[AnalyzedModule] = []
    return AnalysisResult(ok=false, modules=modules, error=message)


def analysis_ok(modules: List[AnalyzedModule]) -> AnalysisResult:
    return AnalysisResult(ok=true, modules=modules, error="")


def analyze_module(
    checked: &checker_core.Checker,
    module: &const project.ParsedModule,
    modules: &const List[project.ParsedModule],
) -> String:
    checker.collect_symbols(checked, module.arena, module.root, module.source, modules)
    checker.validate_import_member_calls(checked, module.arena, module.root, module.source, &module.imports, modules)
    checker.validate_names(checked, module.arena, module.root, module.source)
    if len(checked.diagnostics) > 0:
        checker_core.dump_diagnostics(checked)
        return "semantic check failed"
    return ""


def analyze_project(graph: &const project.ProjectGraph) -> AnalysisResult:
    analyzed: List[AnalyzedModule] = []
    index: usize = 0
    while index < len(graph.modules):
        module: &const project.ParsedModule = &graph.modules[index]
        checked: checker_core.Checker = checker.new_checker()
        error = analyze_module(&checked, module, &graph.modules)
        if len(error) > 0:
            return analysis_error(error[0:len(error)])
        analyzed.append(AnalyzedModule(module_index=index, checked=checked))
        index += 1
    return analysis_ok(analyzed)


def compile_project(graph: &const project.ProjectGraph) -> CompileResult:
    compiled: List[CompiledModule] = []
    index: usize = 0
    while index < len(graph.modules):
        module: &const project.ParsedModule = &graph.modules[index]
        checked: checker_core.Checker = checker.new_checker()
        error = analyze_module(&checked, module, &graph.modules)
        if len(error) > 0:
            return compile_error(error[0:len(error)])
        ir: backend_ir.IRModule = backend_ir.lower(module.arena, module.root, checked.model, checked.type_table)
        if not ir.is_valid:
            return compile_error("internal atomic IR validation failed")
        compiled.append(CompiledModule(module_index=index, checked=checked, ir=ir))
        index += 1
    return compile_ok(compiled)


def check_project(graph: &const project.ProjectGraph) -> String:
    index: usize = 0
    while index < len(graph.modules):
        module: &const project.ParsedModule = &graph.modules[index]
        checked: checker_core.Checker = checker.new_checker()
        error = analyze_module(&checked, module, &graph.modules)
        if len(error) > 0:
            return error[0:len(error)]
        ir: backend_ir.IRModule = backend_ir.lower(
            module.arena,
            module.root,
            checked.model,
            checked.type_table,
        )
        if not ir.is_valid:
            return "internal atomic IR validation failed"
        index += 1
    return ""


def write_project(graph: &const project.ProjectGraph, output_dir: String) -> EmitResult:
    if not fs.ensure_dir(&output_dir):
        return emit_error("failed to create output directory: " + output_dir)
    sources: List[String] = []
    headers: List[String] = []
    specialization_names = collect_project_specialization_names(graph)
    class_model: classes.ProjectClassModel = classes.collect_project_class_model(graph, &specialization_names)
    reflection_model: codegen_reflection.ProjectReflectionModel = codegen_reflection.collect_project_reflection_model(graph, &specialization_names, &class_model)
    index: usize = 0
    while index < len(graph.modules):
        module: &const project.ParsedModule = &graph.modules[index]
        header_name: String = codegen.generated_header_name(&module.name)
        source_name: String = codegen.generated_source_name(&module.name)
        header_path = fs.join_path(&output_dir, &header_name)
        source_path = fs.join_path(&output_dir, &source_name)
        header_parent = fs.parent_dir(&header_path)
        source_parent = fs.parent_dir(&source_path)
        if not fs.ensure_dir(&header_parent) or not fs.ensure_dir(&source_parent):
            return emit_error("failed to create generated directory")
        checked: checker_core.Checker = checker.new_checker()
        error = analyze_module(&checked, module, &graph.modules)
        if len(error) > 0:
            return emit_error(error[0:len(error)])
        ir: backend_ir.IRModule = backend_ir.lower(module.arena, module.root, checked.model, checked.type_table)
        if not ir.is_valid:
            return emit_error("internal atomic IR validation failed")
        header: String = codegen.emit_module_header_from_ir_with_models(
            ir,
            module.arena,
            &module.source,
            &module.name,
            &graph.project_name,
            &module.dependencies,
            &module.imports,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        source: String = codegen.emit_module_source_from_ir_with_models(
            ir,
            module.arena,
            &module.source,
            &module.name,
            &graph.project_name,
            &module.imports,
            module.name == graph.entry_module,
            &specialization_names,
            &checked.type_table,
            &class_model,
            &reflection_model,
        )
        headers.append(header_path[0:len(header_path)])
        sources.append(source_path[0:len(source_path)])
        write_text(header_path, header)
        write_text(source_path, source)
        index += 1
    return emit_ok(sources, headers)


def amalgamated_c(graph: &const project.ProjectGraph) -> String:
    compiled = compile_project(graph)
    if not compiled.ok:
        return ""
    builder = StringBuilder()
    specialization_names = collect_project_specialization_names(graph)
    class_model: classes.ProjectClassModel = classes.collect_project_class_model(graph, &specialization_names)
    reflection_model: codegen_reflection.ProjectReflectionModel = codegen_reflection.collect_project_reflection_model(graph, &specialization_names, &class_model)
    builder.append("/* Generated by Cinder self-host stage. */\n")
    builder.append("/* Amalgamated project: ")
    builder.append(graph.project_name)
    builder.append(" */\n\n")
    index: usize = 0
    while index < len(compiled.modules):
        compiled_module: &const CompiledModule = &compiled.modules[index]
        module: &const project.ParsedModule = &graph.modules[compiled_module.module_index]
        header: String = codegen.emit_module_header_from_ir_with_models(
            &compiled_module.ir,
            module.arena,
            &module.source,
            &module.name,
            &graph.project_name,
            &module.dependencies,
            &module.imports,
            &specialization_names,
            &compiled_module.checked.type_table,
            &class_model,
            &reflection_model,
        )
        builder.append(strip_generated_includes(&header))
        builder.append("\n")
        index += 1
    index = 0
    while index < len(compiled.modules):
        compiled_module: &const CompiledModule = &compiled.modules[index]
        module: &const project.ParsedModule = &graph.modules[compiled_module.module_index]
        source: String = codegen.emit_module_source_from_ir_with_models(
            &compiled_module.ir,
            module.arena,
            &module.source,
            &module.name,
            &graph.project_name,
            &module.imports,
            module.name == graph.entry_module,
            &specialization_names,
            &compiled_module.checked.type_table,
            &class_model,
            &reflection_model,
        )
        builder.append(strip_generated_includes(&source))
        builder.append("\n")
        index += 1
    return builder.finish()


def collect_project_specialization_names(graph: &const project.ProjectGraph) -> codegen_names.SpecializationNameRegistry:
    registry = codegen.new_specialization_name_registry()
    index: usize = 0
    while index < len(graph.modules):
        module: &const project.ParsedModule = &graph.modules[index]
        prefix: String = codegen.c_prefix(&graph.project_name, &graph.modules[index].name)
        codegen.collect_module_specialization_names(
            &registry,
            module.arena,
            module.root,
            &module.source,
            &prefix,
            &graph.project_name,
            &module.imports,
        )
        index += 1
    return registry


def write_text(path: String, content: String) -> void:
    parent = fs.parent_dir(&path)
    fs.ensure_dir(&parent)
    with open(path, "wb") as file:
        file.write(content)



def strip_generated_includes(source: &const String) -> String:
    builder = StringBuilder()
    start: usize = 0
    while start <= len(source):
        end = start
        while end < len(source) and source.byte_at(end) != 10 and source.byte_at(end) != 13:
            end += 1
        line = source[start:end]
        if not fs.starts_with(&line, "#include \"cinder_gen/"):
            builder.append(line)
            builder.append("\n")
        if end >= len(source):
            break
        start = end + 1
        if start < len(source) and source.byte_at(end) == 13 and source.byte_at(start) == 10:
            start += 1
    return builder.finish()
