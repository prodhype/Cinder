import backend_ir
import codegen_access
import codegen_atomics
import codegen_context
import codegen_expr
import codegen_context as codegen_model
import codegen_names
import codegen_reflection
import codegen_specializations
import codegen_type_names
import project
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


struct MatchValueInfo:
    syntax_type: NodeId
    semantic_type: types.TypeId
    c_type: String
    valid: bool


struct MatchNominalCase:
    nominal_index: i32
    case_index: i32
    declaration: NodeId
    case_declaration: NodeId
    c_name: String
    case_name: String
    is_enum: bool
    valid: bool


def emit_module_block(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    loop_body: bool,
) -> void:
    node = arena.nodes[id.index]
    local_start = len(context.local_types)
    semantic_name_start = len(context.semantic_name_types)
    pointer_start = len(context.pointer_names)
    tuple_item_start = len(context.tuple_items)
    semantic_string_start = len(context.semantic_string_names)
    reflection_binding_start = len(context.reflection_bindings)
    defer_start = len(context.deferred_expressions)
    lock_cleanup_start = len(context.lock_cleanups)
    context.cleanup_boundaries.append(
        codegen_context.CodegenCleanupBoundary(
            local_start=local_start,
            defer_start=defer_start,
            with_resource_start=len(context.with_resources),
            iterator_guard_start=len(context.iterator_guard_names),
            lock_cleanup_start=lock_cleanup_start,
            value_cleanup_start=len(context.value_cleanups),
            loop_body=loop_body,
        )
    )
    for offset in range(0, node.child_count):
        emit_module_statement(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context)
    emit_module_defers(arena, source, builder, prefix, project_name, imports, context, defer_start)
    codegen_context.emit_context_drops(arena, context, source, builder, local_start, prefix, project_name, imports)
    emit_module_lock_cleanups_from(builder, context, lock_cleanup_start)
    while len(context.local_types) > local_start:
        context.local_types.pop()
    while len(context.semantic_name_types) > semantic_name_start:
        context.semantic_name_types.pop()
    while len(context.pointer_names) > pointer_start:
        context.pointer_names.pop()
    while len(context.tuple_items) > tuple_item_start:
        context.tuple_items.pop()
    while len(context.semantic_string_names) > semantic_string_start:
        context.semantic_string_names.pop()
    while len(context.reflection_bindings) > reflection_binding_start:
        context.reflection_bindings.pop()
    while len(context.deferred_expressions) > defer_start:
        context.deferred_expressions.pop()
    while len(context.lock_cleanups) > lock_cleanup_start:
        context.lock_cleanups.pop()
    context.cleanup_boundaries.pop()

def emit_module_defers(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    defer_start: usize,
) -> void:
    emit_module_defers_until(arena, source, builder, prefix, project_name, imports, context, defer_start, len(context.deferred_expressions))


def emit_module_defers_until(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    defer_start: usize,
    defer_end: usize,
) -> void:
    index = defer_end
    while index > defer_start:
        index -= 1
        builder.append("    ")
        codegen_expr.emit_module_expression(arena, context.deferred_expressions[index], source, builder, prefix, project_name, imports, context)
        builder.append(";\n")

def emit_module_iterator_guard_cleanups(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext) -> void:
    emit_module_iterator_guard_cleanups_from(builder, context, 0)


def emit_module_iterator_guard_cleanups_from(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize) -> void:
    emit_module_iterator_guard_cleanups_until(builder, context, start, len(context.iterator_guard_names))


def emit_module_iterator_guard_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    guard_names: &const List[String] = &context.iterator_guard_names
    index = end
    while index > start:
        index -= 1
        builder.append("    if (")
        builder.append(guard_names[index])
        builder.append(" != NULL && ")
        builder.append(guard_names[index])
        builder.append("->active_iterators > 0) ")
        builder.append(guard_names[index])
        builder.append("->active_iterators -= 1;\n")


def emit_module_with_resource_cleanups_from(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize) -> void:
    emit_module_with_resource_cleanups_until(builder, context, start, len(context.with_resources))


def emit_module_with_resource_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    index = end
    while index > start:
        index -= 1
        builder.append("    fclose(")
        builder.append(context.with_resources[index])
        builder.append(");\n")


def emit_module_lock_cleanups_from(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize) -> void:
    emit_module_lock_cleanups_until(builder, context, start, len(context.lock_cleanups))


def emit_module_lock_cleanups_until(builder: &StringBuilder, context: &const codegen_model.ModuleCodegenContext, start: usize, end: usize) -> void:
    lock_cleanups: &const List[codegen_context.CodegenLockCleanup] = &context.lock_cleanups
    index = end
    while index > start:
        index -= 1
        cleanup: &const codegen_context.CodegenLockCleanup = &lock_cleanups[index]
        if not cleanup.collection:
            builder.append("    cinder_lock_release(")
            builder.append(cleanup.name[0:len(cleanup.name)])
            builder.append(");\n")
            continue
        builder.append("    for (size_t cinder_lock_release_index = ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".length; cinder_lock_release_index > 0; --cinder_lock_release_index) {\n")
        builder.append("        size_t cinder_lock_item = cinder_lock_release_index - 1;\n")
        builder.append("        if (cinder_lock_release_index < ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".length && ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_item] == ")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_release_index]) continue;\n")
        builder.append("        cinder_lock_release(")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(".data[cinder_lock_item]);\n    }\n")
        builder.append("    CinderList_Lock_drop(&")
        builder.append(cleanup.name[0:len(cleanup.name)])
        builder.append(");\n")


def emit_module_value_cleanups_until(
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    start: usize,
    end: usize,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    value_cleanups: &const List[codegen_context.CodegenValueCleanup] = &context.value_cleanups
    index = end
    while index > start:
        index -= 1
        cleanup: &const codegen_context.CodegenValueCleanup = &value_cleanups[index]
        codegen_context.emit_context_semantic_drop(context, cleanup.semantic_type, builder, &cleanup.name, prefix, project_name, imports)


def emit_module_cleanup_segment(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    local_start: usize,
    local_end: usize,
    defer_start: usize,
    defer_end: usize,
    with_resource_start: usize,
    with_resource_end: usize,
    iterator_guard_start: usize,
    iterator_guard_end: usize,
    lock_cleanup_start: usize,
    lock_cleanup_end: usize,
    value_cleanup_start: usize,
    value_cleanup_end: usize,
) -> void:
    emit_module_iterator_guard_cleanups_until(builder, context, iterator_guard_start, iterator_guard_end)
    emit_module_defers_until(arena, source, builder, prefix, project_name, imports, context, defer_start, defer_end)
    emit_module_with_resource_cleanups_until(builder, context, with_resource_start, with_resource_end)
    codegen_context.emit_context_live_drops_range(arena, context, source, builder, local_start, local_end, prefix, project_name, imports)
    emit_module_lock_cleanups_until(builder, context, lock_cleanup_start, lock_cleanup_end)
    emit_module_value_cleanups_until(builder, context, value_cleanup_start, value_cleanup_end, prefix, project_name, imports)


def emit_module_active_cleanups(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    boundary_start: usize,
) -> void:
    local_end = len(context.local_types)
    defer_end = len(context.deferred_expressions)
    with_resource_end = len(context.with_resources)
    iterator_guard_end = len(context.iterator_guard_names)
    lock_cleanup_end = len(context.lock_cleanups)
    value_cleanup_end = len(context.value_cleanups)
    boundary_index = len(context.cleanup_boundaries)
    while boundary_index > boundary_start:
        boundary_index -= 1
        emit_module_cleanup_segment(
            arena,
            source,
            builder,
            prefix,
            project_name,
            imports,
            context,
            codegen_context.context_scope_local_start(context, boundary_index),
            local_end,
            codegen_context.context_scope_defer_start(context, boundary_index),
            defer_end,
            codegen_context.context_scope_with_resource_start(context, boundary_index),
            with_resource_end,
            codegen_context.context_scope_iterator_guard_start(context, boundary_index),
            iterator_guard_end,
            codegen_context.context_scope_lock_cleanup_start(context, boundary_index),
            lock_cleanup_end,
            codegen_context.context_scope_value_cleanup_start(context, boundary_index),
            value_cleanup_end,
        )
        local_end = codegen_context.context_scope_local_start(context, boundary_index)
        defer_end = codegen_context.context_scope_defer_start(context, boundary_index)
        with_resource_end = codegen_context.context_scope_with_resource_start(context, boundary_index)
        iterator_guard_end = codegen_context.context_scope_iterator_guard_start(context, boundary_index)
        lock_cleanup_end = codegen_context.context_scope_lock_cleanup_start(context, boundary_index)
        value_cleanup_end = codegen_context.context_scope_value_cleanup_start(context, boundary_index)
    if boundary_start == 0:
        emit_module_cleanup_segment(
            arena,
            source,
            builder,
            prefix,
            project_name,
            imports,
            context,
            context.local_start,
            local_end,
            0,
            defer_end,
            0,
            with_resource_end,
            0,
            iterator_guard_end,
            0,
            lock_cleanup_end,
            0,
            value_cleanup_end,
        )


def emit_module_return_cleanups(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    emit_module_active_cleanups(arena, source, builder, prefix, project_name, imports, context, 0)


def emit_module_loop_exit(
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    keyword: String,
) -> void:
    scope_index = codegen_context.context_nearest_loop_scope(context)
    if scope_index >= 0:
        index = cast[usize](scope_index)
        emit_module_active_cleanups(arena, source, builder, prefix, project_name, imports, context, index)
        builder.append("    ")
        builder.append(keyword[0:len(keyword)])
        builder.append(";\n")
        return
    builder.append("    ")
    builder.append(keyword[0:len(keyword)])
    builder.append(";\n")


def emit_module_statement(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.RETURN_STMT:
        expr = codegen_names.first_child(arena, id)
        has_cleanups = len(context.deferred_expressions) > 0 or len(context.with_resources) > 0 or len(context.iterator_guard_names) > 0 or len(context.lock_cleanups) > 0 or len(context.value_cleanups) > 0 or codegen_context.context_has_live_drops(arena, context, source)
        if not has_cleanups:
            builder.append("    return")
            if expr.index >= 0:
                builder.append(" ")
                previous_expected = context.expected_type
                context.expected_type = context.current_return_type
                codegen_expr.emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
                context.expected_type = previous_expected
            builder.append(";\n")
            return
        builder.append("    {\n")
        if expr.index >= 0:
            builder.append("    __auto_type cinder_return_value = ")
            previous_expected = context.expected_type
            context.expected_type = context.current_return_type
            codegen_expr.emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
            context.expected_type = previous_expected
            builder.append(";\n")
            codegen_context.mark_context_expression_moved(arena, context, expr, source)
        emit_module_return_cleanups(arena, source, builder, prefix, project_name, imports, context)
        builder.append("    return")
        if expr.index >= 0:
            builder.append(" cinder_return_value")
        builder.append(";\n")
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.DEFER_STMT:
        expr = codegen_names.first_child(arena, id)
        if expr.index >= 0:
            context.deferred_expressions.append(expr)
        return
    if node.kind == SyntaxKind.CRITICAL_SECTION_STMT:
        emit_module_critical_section(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        atomic_index = codegen_atomics.atomic_node_index(context.semantic_nodes, id, context.active_user_specialization)
        if atomic_index >= 0:
            atomic_node: backend_ir.IRNode = codegen_atomics.atomic_node_at(context.semantic_nodes, atomic_index)
            builder.append("    ")
            codegen_atomics.append_atomic_wrapper_name(builder, atomic_node.atomic_element_kind)
            builder.append(" ")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
            builder.append(";\n    atomic_init(&")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
            builder.append(".value, ")
            codegen_expr.emit_module_expression(arena, atomic_node.atomic_operand0, source, builder, prefix, project_name, imports, context)
            builder.append(");\n")
            annotation = codegen_type_names.find_child_type(arena, id)
            if annotation.index >= 0:
                codegen_context.register_context_name_type(arena, context, source, node.value_start, node.value_length, annotation)
            return
        builder.append("    ")
        annotation = codegen_type_names.find_child_type(arena, id)
        expr = codegen_names.last_child(arena, id)
        if annotation.index >= 0:
            if codegen_specializations.context_type_is_array(arena, annotation):
                codegen_specializations.emit_module_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length, context.specialization_names)
            else:
                codegen_context.emit_context_c_type(arena, annotation, source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
        elif expr.index >= 0:
            builder.append("__auto_type")
            builder.append(" ")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
        else:
            builder.append("int32_t")
            builder.append(" ")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
        if expr.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[expr.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and codegen_specializations.context_type_is_array(arena, annotation):
                codegen_expr.emit_module_array_initializer(arena, expr, annotation, source, builder, prefix, project_name, imports, context)
            else:
                previous_expected = context.expected_type
                if annotation.index >= 0:
                    context.expected_type = annotation
                codegen_expr.emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
                context.expected_type = previous_expected
            codegen_context.mark_context_expression_moved(arena, context, expr, source)
        builder.append(";\n")
        if expression_is_named_call(arena, expr, source, "type_info"):
            codegen_context.register_context_pointer_name(context, source, node.value_start, node.value_length)
            codegen_context.register_context_reflection_binding(context, source, node.value_start, node.value_length, codegen_context.ReflectionBindingKind.TYPE_INFO, -1, -1)
        elif annotation.index >= 0:
            codegen_context.register_context_name_type(arena, context, source, node.value_start, node.value_length, annotation)
        elif codegen_context.context_expression_is_pointer_initializer(arena, context, expr, source):
            codegen_context.register_context_pointer_name(context, source, node.value_start, node.value_length)
        else:
            inferred_type = codegen_context.context_expression_type(arena, context, expr, source)
            semantic_type = codegen_context.context_semantic_type(context, expr)
            if semantic_type.index < 0:
                semantic_type = codegen_context.context_semantic_type(context, id)
            if inferred_type.index < 0 and semantic_type.index >= 0:
                codegen_context.register_context_semantic_name_type(context, source, node.value_start, node.value_length, semantic_type)
            codegen_context.register_context_name_type(arena, context, source, node.value_start, node.value_length, inferred_type)
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        builder.append("    ")
        target = codegen_names.first_child(arena, id)
        if emit_set_compound_assignment(arena, id, target, source, builder, prefix, project_name, imports, context):
            return
        if node.flags == cast[i32](token.TokenKind.ASSIGN) and target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_INDEX:
            receiver = codegen_names.first_child(arena, target)
            key = codegen_names.second_child(arena, target)
            if codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP):
                receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
                name_builder = StringBuilder()
                codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, &name_builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
                name = name_builder.finish()
                previous_expected = context.expected_type
                key_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 0)
                key_is_string = codegen_context.context_type_is_string(context.type_arena, key_type, context.type_source)
                if not key_is_string:
                    semantic_key_type = codegen_context.context_semantic_type(context, key)
                    key_is_string = codegen_context.context_semantic_type_is_kind(context, semantic_key_type, types.TypeKind.STRING)
                materialize_key = false
                temporary_index: i32 = -1
                if key_is_string and key.index >= 0 and not codegen_context.context_expression_is_pointer_like(arena, context, key, source):
                    key_node = arena.nodes[key.index]
                    materialize_key = (
                        key_node.kind != SyntaxKind.EXPR_NAME
                        and key_node.kind != SyntaxKind.EXPR_ATTRIBUTE
                        and key_node.kind != SyntaxKind.EXPR_INDEX
                        and key_node.kind != SyntaxKind.EXPR_LITERAL
                    )
                if materialize_key:
                    temporary_index = context.temporary_index
                    context.temporary_index += 1
                    builder.append("{\n        CinderString cinder_map_key_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
                    builder.append(" = ")
                    if key_type.index >= 0:
                        context.expected_type = key_type
                    codegen_expr.emit_module_expression(arena, key, source, builder, prefix, project_name, imports, context)
                    context.expected_type = previous_expected
                    builder.append(";\n        ")
                builder.append(name[0:len(name)])
                builder.append("_set(")
                if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                    builder.append("&")
                codegen_expr.emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
                builder.append(", ")
                if materialize_key:
                    builder.append("cinder_map_key_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
                else:
                    if key_type.index >= 0:
                        context.expected_type = key_type
                    codegen_expr.emit_module_expression(arena, key, source, builder, prefix, project_name, imports, context)
                builder.append(", ")
                value = codegen_names.second_child(arena, id)
                value_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 1)
                if value_type.index >= 0:
                    context.expected_type = value_type
                codegen_expr.emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
                context.expected_type = previous_expected
                builder.append(");\n")
                if materialize_key:
                    builder.append("        cinder_string_drop(&cinder_map_key_")
                    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
                    builder.append(");\n    }\n")
                if not key_is_string:
                    codegen_context.mark_context_expression_moved(arena, context, key, source)
                codegen_context.mark_context_expression_moved(arena, context, value, source)
                return
        if node.flags == cast[i32](token.TokenKind.ASSIGN) and target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            if not codegen_context.context_has_name(context, source, target_node.value_start, target_node.value_length):
                builder.append("__auto_type ")
                codegen_expr.emit_module_expression(arena, target, source, builder, prefix, project_name, imports, context)
                builder.append(" = ")
                value = codegen_names.second_child(arena, id)
                codegen_expr.emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
                codegen_context.mark_context_expression_moved(arena, context, value, source)
                builder.append(";\n")
                if codegen_context.context_expression_is_pointer_initializer(arena, context, value, source):
                    codegen_context.register_context_pointer_name(context, source, target_node.value_start, target_node.value_length)
                else:
                    inferred_type = codegen_context.context_expression_type(arena, context, value, source)
                    semantic_type = codegen_context.context_semantic_type(context, value)
                    if semantic_type.index < 0:
                        semantic_type = codegen_context.context_semantic_type(context, id)
                    if inferred_type.index < 0 and semantic_type.index >= 0:
                        codegen_context.register_context_semantic_name_type(context, source, target_node.value_start, target_node.value_length, semantic_type)
                    codegen_context.register_context_name_type(arena, context, source, target_node.value_start, target_node.value_length, inferred_type)
                return
        value = codegen_names.second_child(arena, id)
        target_type = codegen_context.context_expression_type(arena, context, target, source)
        if (
            node.flags == cast[i32](token.TokenKind.ASSIGN)
            and target.index >= 0
            and (
                arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME
                or arena.nodes[target.index].kind == SyntaxKind.EXPR_ATTRIBUTE
                or arena.nodes[target.index].kind == SyntaxKind.EXPR_INDEX
            )
            and codegen_context.context_type_needs_drop(arena, context, target_type, source)
        ):
            temporary_index = context.temporary_index
            context.temporary_index += 1
            builder.append("{\n        __auto_type cinder_move_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(" = ")
            previous_expected = context.expected_type
            context.expected_type = target_type
            codegen_expr.emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
            context.expected_type = previous_expected
            builder.append(";\n        __auto_type cinder_target_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(" = &(")
            emit_module_assignment_target(arena, target, source, builder, prefix, project_name, imports, context)
            builder.append(");\n")
            codegen_context.mark_context_expression_moved(arena, context, value, source)
            if not codegen_context.context_expression_is_moved(context, target, arena, source):
                drop_expression_builder = StringBuilder()
                drop_expression_builder.append("(*cinder_target_")
                codegen_type_names.append_specialization_decimal(&drop_expression_builder, cast[usize](temporary_index))
                drop_expression_builder.append(")")
                drop_expression = drop_expression_builder.finish()
                codegen_context.emit_context_drop(arena, context, target_type, source, builder, &drop_expression, prefix, project_name, imports)
            builder.append("        *cinder_target_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(" = cinder_move_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(";\n    }\n")
            codegen_context.mark_context_expression_live(context, target, arena, source)
            return
        emit_module_assignment_target(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(" ")
        codegen_names.append_assignment_operator(builder, node.flags)
        builder.append(" ")
        previous_expected = context.expected_type
        if target_type.index >= 0:
            context.expected_type = target_type
        codegen_expr.emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
        context.expected_type = previous_expected
        codegen_context.mark_context_expression_moved(arena, context, value, source)
        codegen_context.mark_context_expression_live(context, codegen_names.first_child(arena, id), arena, source)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.IF_STMT:
        emit_module_if(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.MATCH_STMT:
        emit_module_match(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.WHILE_STMT:
        builder.append("    while (")
        codegen_expr.emit_module_expression(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(") {\n")
        emit_module_block(arena, codegen_names.second_child(arena, id), source, builder, prefix, project_name, imports, context, true)
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.WITH_STMT:
        emit_module_with(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.FOR_EACH_STMT:
        emit_module_for_each(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.FOR_C_STMT:
        emit_module_for_c(arena, id, source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.BREAK_STMT:
        emit_module_loop_exit(arena, source, builder, prefix, project_name, imports, context, "break")
        return
    if node.kind == SyntaxKind.CONTINUE_STMT:
        emit_module_loop_exit(arena, source, builder, prefix, project_name, imports, context, "continue")
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        expression = codegen_names.first_child(arena, id)
        drop_type = expression
        if not codegen_context.context_type_needs_drop(arena, context, drop_type, source):
            inferred_drop_type = codegen_context.context_expression_type(arena, context, expression, source)
            if inferred_drop_type.index >= 0:
                drop_type = inferred_drop_type
        if codegen_context.context_type_needs_drop(arena, context, drop_type, source):
            temporary_index = context.temporary_index
            context.temporary_index += 1
            name_builder = StringBuilder()
            name_builder.append("cinder_discarded_")
            codegen_type_names.append_specialization_decimal(&name_builder, cast[usize](temporary_index))
            name = name_builder.finish()
            builder.append("    {\n    __auto_type ")
            builder.append(name[0:len(name)])
            builder.append(" = ")
            codegen_expr.emit_module_expression(arena, expression, source, builder, prefix, project_name, imports, context)
            builder.append(";\n")
            codegen_context.mark_context_expression_moved(arena, context, expression, source)
            codegen_context.emit_context_drop(arena, context, drop_type, source, builder, &name, prefix, project_name, imports)
            builder.append("    }\n")
        else:
            builder.append("    ")
            codegen_expr.emit_module_expression(arena, expression, source, builder, prefix, project_name, imports, context)
            builder.append(";\n")
        return
    if node.kind == SyntaxKind.PASS_STMT:
        builder.append("    ;\n")


def emit_module_critical_section(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    expression = codegen_names.first_child(arena, id)
    body = codegen_names.second_child(arena, id)
    cleanup_start = len(context.lock_cleanups)
    temporary_index = context.temporary_index
    context.temporary_index += 1
    name_builder = StringBuilder()
    name_builder.append("cinder_critical_")
    codegen_type_names.append_specialization_decimal(&name_builder, cast[usize](temporary_index))
    name = name_builder.finish()
    kind = codegen_context.context_lock_kind(context, id)
    builder.append("    {\n")
    context.cleanup_boundaries.append(
        codegen_context.CodegenCleanupBoundary(
            local_start=len(context.local_types),
            defer_start=len(context.deferred_expressions),
            with_resource_start=len(context.with_resources),
            iterator_guard_start=len(context.iterator_guard_names),
            lock_cleanup_start=cleanup_start,
            value_cleanup_start=len(context.value_cleanups),
            loop_body=false,
        )
    )
    if kind == 3:
        builder.append("    CinderList_Lock ")
        builder.append(name[0:len(name)])
        builder.append(" = ")
        expression_node = arena.nodes[expression.index]
        direct_sorted = false
        if expression_node.kind == SyntaxKind.EXPR_CALL:
            callee = codegen_names.first_child(arena, expression)
            if callee.index >= 0:
                callee_node = arena.nodes[callee.index]
                direct_sorted = callee_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "sorted")
        if direct_sorted:
            codegen_expr.emit_module_expression(arena, expression, source, builder, prefix, project_name, imports, context)
        else:
            builder.append("({ CinderList_Lock cinder_lock_snapshot = {0}; __auto_type cinder_lock_source = &(")
            codegen_expr.emit_module_expression(arena, expression, source, builder, prefix, project_name, imports, context)
            builder.append("); for (size_t cinder_lock_copy = 0; cinder_lock_copy < cinder_lock_source->length; ++cinder_lock_copy) cinder_selfhost_list_append_value(&cinder_lock_snapshot, cinder_lock_source->data[cinder_lock_copy]); cinder_lock_snapshot; })")
        builder.append(";\n")
        builder.append("    for (size_t cinder_lock_index = 0; cinder_lock_index < ")
        builder.append(name[0:len(name)])
        builder.append(".length; ++cinder_lock_index) {\n")
        builder.append("        if (cinder_lock_index > 0 && ")
        builder.append(name[0:len(name)])
        builder.append(".data[cinder_lock_index] == ")
        builder.append(name[0:len(name)])
        builder.append(".data[cinder_lock_index - 1]) continue;\n")
        builder.append("        cinder_lock_acquire(")
        builder.append(name[0:len(name)])
        builder.append(".data[cinder_lock_index]);\n    }\n")
        context.lock_cleanups.append(codegen_context.CodegenLockCleanup(name=name[0:len(name)], collection=true))
    else:
        builder.append("    CinderLock ")
        builder.append(name[0:len(name)])
        builder.append(" = ")
        codegen_expr.emit_module_expression(arena, expression, source, builder, prefix, project_name, imports, context)
        builder.append(";\n    cinder_lock_acquire(")
        builder.append(name[0:len(name)])
        builder.append(");\n")
        context.lock_cleanups.append(codegen_context.CodegenLockCleanup(name=name[0:len(name)], collection=false))
    if body.index >= 0:
        emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
    emit_module_lock_cleanups_from(builder, context, cleanup_start)
    while len(context.lock_cleanups) > cleanup_start:
        context.lock_cleanups.pop()
    context.cleanup_boundaries.pop()
    builder.append("    }\n")


def emit_set_compound_assignment(
    arena: &const SyntaxArena,
    id: NodeId,
    target: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    operator = arena.nodes[id.index].flags
    operation = ""
    if operator == cast[i32](token.TokenKind.PIPE_ASSIGN):
        operation = "union"
    elif operator == cast[i32](token.TokenKind.AMPERSAND_ASSIGN):
        operation = "intersection"
    elif operator == cast[i32](token.TokenKind.MINUS_ASSIGN):
        operation = "difference"
    elif operator == cast[i32](token.TokenKind.CARET_ASSIGN):
        operation = "symmetric_difference"
    else:
        return false
    if not codegen_context.context_expression_is_collection(arena, context, target, source, "Set", types.TypeKind.SET):
        return false
    name_builder = StringBuilder()
    if not codegen_context.emit_context_expression_specialization_name(arena, context, target, source, &name_builder, prefix, project_name, imports, "Set", types.TypeKind.SET):
        return false
    name = name_builder.finish()
    value = codegen_names.second_child(arena, id)
    builder.append("{ ")
    builder.append(name[0:len(name)])
    builder.append(" cinder_rhs = ")
    codegen_expr.emit_module_expression(arena, value, source, builder, prefix, project_name, imports, context)
    builder.append("; ")
    builder.append(name[0:len(name)])
    builder.append(" cinder_result = ")
    builder.append(name[0:len(name)])
    builder.append("_")
    builder.append(operation[0:len(operation)])
    builder.append("(")
    if not codegen_context.context_expression_is_pointer_like(arena, context, target, source):
        builder.append("&")
    codegen_expr.emit_module_expression(arena, target, source, builder, prefix, project_name, imports, context)
    builder.append(", &cinder_rhs); ")
    builder.append(name[0:len(name)])
    builder.append("_drop(")
    if not codegen_context.context_expression_is_pointer_like(arena, context, target, source):
        builder.append("&")
    codegen_expr.emit_module_expression(arena, target, source, builder, prefix, project_name, imports, context)
    builder.append("); ")
    emit_module_assignment_target(arena, target, source, builder, prefix, project_name, imports, context)
    builder.append(" = cinder_result; ")
    if codegen_expr.expression_creates_owned_set(arena, value, source):
        builder.append(name[0:len(name)])
        builder.append("_drop(&cinder_rhs); ")
    builder.append("}\n")
    codegen_context.mark_context_expression_live(context, target, arena, source)
    return true


def emit_module_assignment_target(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if id.index >= 0:
        node = arena.nodes[id.index]
        if node.kind == SyntaxKind.EXPR_INDEX:
            receiver = codegen_names.first_child(arena, id)
            key = codegen_names.second_child(arena, id)
            if codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP):
                receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
                key_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 0)
                key_owned_path = codegen_access.expression_is_owned_path_string(arena, key, source, imports, context)
                key_temporary: i32 = -1
                result_temporary: i32 = -1
                previous_expected = context.expected_type
                if key_owned_path:
                    key_temporary = context.temporary_index
                    context.temporary_index += 1
                    result_temporary = context.temporary_index
                    context.temporary_index += 1
                    builder.append("(*({ CinderString ")
                    codegen_access.append_path_temporary_name(builder, "assignment_key", key_temporary)
                    builder.append(" = ")
                    if key_type.index >= 0:
                        context.expected_type = key_type
                    codegen_expr.emit_module_expression(arena, key, source, builder, prefix, project_name, imports, context)
                    context.expected_type = previous_expected
                    builder.append("; __auto_type ")
                    codegen_access.append_path_temporary_name(builder, "assignment_result", result_temporary)
                    builder.append(" = ")
                else:
                    builder.append("(*")
                codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
                builder.append("_at_mut(")
                if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                    builder.append("&")
                codegen_expr.emit_module_expression(arena, receiver, source, builder, prefix, project_name, imports, context)
                builder.append(", ")
                if key_owned_path:
                    codegen_access.append_path_temporary_name(builder, "assignment_key", key_temporary)
                else:
                    codegen_expr.emit_module_expression(arena, key, source, builder, prefix, project_name, imports, context)
                builder.append(")")
                if key_owned_path:
                    builder.append("; cinder_string_drop(&")
                    codegen_access.append_path_temporary_name(builder, "assignment_key", key_temporary)
                    builder.append("); ")
                    codegen_access.append_path_temporary_name(builder, "assignment_result", result_temporary)
                    builder.append("; }))")
                else:
                    builder.append(")")
                return
        if node.kind == SyntaxKind.EXPR_NAME:
            name = source[node.value_start:node.value_start + node.value_length]
            type_id = codegen_context.context_name_type(context, &name)
            if type_id.index >= 0 and codegen_type_names.type_node_kind(context.type_arena, type_id) == SyntaxKind.TYPE_REFERENCE:
                builder.append("(*")
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
                builder.append(")")
                return
    codegen_expr.emit_module_expression(arena, id, source, builder, prefix, project_name, imports, context)

def emit_module_for_c(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count < 4:
        return
    local_start = len(context.local_types)
    pointer_start = len(context.pointer_names)
    builder.append("    {\n    ")
    emit_module_for_clause(arena, arena.children[node.first_child], source, builder, prefix, project_name, imports, context)
    builder.append(";\n    for (; ")
    codegen_expr.emit_module_expression(arena, arena.children[node.first_child + 1], source, builder, prefix, project_name, imports, context)
    builder.append("; ")
    emit_module_for_clause(arena, arena.children[node.first_child + 2], source, builder, prefix, project_name, imports, context)
    builder.append(") {\n")
    emit_module_block(arena, arena.children[node.first_child + 3], source, builder, prefix, project_name, imports, context, true)
    builder.append("    }\n")
    codegen_context.emit_context_live_drops(arena, context, source, builder, local_start, prefix, project_name, imports)
    builder.append("    }\n")
    while len(context.local_types) > local_start:
        context.local_types.pop()
    while len(context.pointer_names) > pointer_start:
        context.pointer_names.pop()

def emit_module_for_clause(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        annotation = codegen_type_names.find_child_type(arena, id)
        expr = codegen_names.last_child(arena, id)
        if annotation.index >= 0:
            if codegen_specializations.context_type_is_array(arena, annotation):
                codegen_specializations.emit_module_typed_declarator(arena, annotation, source, builder, prefix, project_name, imports, node.value_start, node.value_length, context.specialization_names)
            else:
                codegen_context.emit_context_c_type(arena, annotation, source, builder, prefix, project_name, imports, context)
                builder.append(" ")
                codegen_names.append_source(builder, source, node.value_start, node.value_length)
        else:
            builder.append("__auto_type")
            builder.append(" ")
            codegen_names.append_source(builder, source, node.value_start, node.value_length)
        if expr.index >= 0 and not codegen_type_names.is_type_kind(arena.nodes[expr.index].kind):
            builder.append(" = ")
            if annotation.index >= 0 and codegen_specializations.context_type_is_array(arena, annotation):
                codegen_expr.emit_module_array_initializer(arena, expr, annotation, source, builder, prefix, project_name, imports, context)
            else:
                codegen_expr.emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
            codegen_context.mark_context_expression_moved(arena, context, expr, source)
        if annotation.index >= 0:
            codegen_context.register_context_name_type(arena, context, source, node.value_start, node.value_length, annotation)
        elif expr.index >= 0:
            inferred_type = codegen_context.context_expression_type(arena, context, expr, source)
            codegen_context.register_context_name_type(arena, context, source, node.value_start, node.value_length, inferred_type)
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        emit_module_assignment_target(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context)
        builder.append(" ")
        codegen_names.append_assignment_operator(builder, node.flags)
        builder.append(" ")
        codegen_expr.emit_module_expression(arena, codegen_names.second_child(arena, id), source, builder, prefix, project_name, imports, context)
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        codegen_expr.emit_module_expression(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context)

def emit_module_if(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    builder.append("    if (")
    codegen_expr.emit_module_expression(arena, codegen_names.first_child(arena, id), source, builder, prefix, project_name, imports, context)
    builder.append(") {\n")
    emit_module_block(arena, codegen_names.second_child(arena, id), source, builder, prefix, project_name, imports, context, false)
    builder.append("    }")
    node = arena.nodes[id.index]
    for offset in range(2, node.child_count):
        branch_id = arena.children[node.first_child + offset]
        branch = arena.nodes[branch_id.index]
        if branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 1:
            builder.append(" else if (")
            codegen_expr.emit_module_expression(arena, codegen_names.first_child(arena, branch_id), source, builder, prefix, project_name, imports, context)
            builder.append(") {\n")
            emit_module_block(arena, codegen_names.second_child(arena, branch_id), source, builder, prefix, project_name, imports, context, false)
            builder.append("    }")
        elif branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 2:
            builder.append(" else {\n")
            emit_module_block(arena, codegen_names.first_child(arena, branch_id), source, builder, prefix, project_name, imports, context, false)
            builder.append("    }")
    builder.append("\n")

def emit_module_match(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    subject = codegen_names.first_child(arena, id)
    subject_info = match_subject_value_info(arena, subject, source, prefix, project_name, imports, context)
    subject_owned_path = codegen_access.expression_is_owned_path_string(arena, subject, source, imports, context)
    value_name = "cinder_match_value"
    found_name = "cinder_match_found"
    if subject_owned_path:
        temporary_index = context.temporary_index
        context.temporary_index += 1
        value_name_builder = StringBuilder()
        value_name_builder.append("cinder_match_value_")
        codegen_type_names.append_specialization_decimal(&value_name_builder, cast[usize](temporary_index))
        value_name = value_name_builder.finish()
        found_name_builder = StringBuilder()
        found_name_builder.append("cinder_match_found_")
        codegen_type_names.append_specialization_decimal(&found_name_builder, cast[usize](temporary_index))
        found_name = found_name_builder.finish()
    builder.append("    {\n    __auto_type ")
    builder.append(value_name[0:len(value_name)])
    builder.append(" = ")
    previous_expected = context.expected_type
    context.expected_type = subject_info.syntax_type
    codegen_expr.emit_module_expression(arena, subject, source, builder, prefix, project_name, imports, context)
    context.expected_type = previous_expected
    builder.append(";\n    bool ")
    builder.append(found_name[0:len(found_name)])
    builder.append(" = false;\n")
    if subject_owned_path:
        context.cleanup_boundaries.append(
            codegen_context.CodegenCleanupBoundary(
                local_start=len(context.local_types),
                defer_start=len(context.deferred_expressions),
                with_resource_start=len(context.with_resources),
                iterator_guard_start=len(context.iterator_guard_names),
                lock_cleanup_start=len(context.lock_cleanups),
                value_cleanup_start=len(context.value_cleanups),
                loop_body=false,
            )
        )
        context.value_cleanups.append(
            codegen_context.CodegenValueCleanup(
                name=value_name[0:len(value_name)],
                semantic_type=subject_info.semantic_type,
            )
        )
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        case_id = arena.children[node.first_child + offset]
        case_node = arena.nodes[case_id.index]
        if case_node.kind != SyntaxKind.MATCH_CASE:
            continue
        pattern = codegen_names.first_child(arena, case_id)
        builder.append("    if (!")
        builder.append(found_name[0:len(found_name)])
        builder.append(") {\n    if (")
        root_access = value_name[0:len(value_name)]
        emit_match_pattern_condition(arena, pattern, source, builder, prefix, project_name, imports, context, &root_access, &subject_info)
        builder.append(") {\n")
        local_start = len(context.local_types)
        semantic_name_start = len(context.semantic_name_types)
        pointer_start = len(context.pointer_names)
        emitted_bindings: List[String] = []
        emit_match_binding_declarations(arena, pattern, pattern, source, builder, prefix, project_name, imports, context, &root_access, &subject_info, subject_owned_path, emitted_bindings)
        guard = match_case_guard(arena, case_id)
        body = codegen_names.find_child_kind(arena, case_id, SyntaxKind.BLOCK)
        if guard.index >= 0:
            builder.append("    if (")
            codegen_expr.emit_module_expression(arena, guard, source, builder, prefix, project_name, imports, context)
            builder.append(") {\n    ")
            builder.append(found_name[0:len(found_name)])
            builder.append(" = true;\n")
            if body.index >= 0:
                emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
            builder.append("    }\n")
        else:
            builder.append("    ")
            builder.append(found_name[0:len(found_name)])
            builder.append(" = true;\n")
            if body.index >= 0:
                emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
        while len(context.local_types) > local_start:
            context.local_types.pop()
        while len(context.semantic_name_types) > semantic_name_start:
            context.semantic_name_types.pop()
        while len(context.pointer_names) > pointer_start:
            context.pointer_names.pop()
        builder.append("    }\n    }\n")
    if subject_owned_path:
        emit_module_value_cleanups_until(builder, context, len(context.value_cleanups) - 1, len(context.value_cleanups), prefix, project_name, imports)
        context.value_cleanups.pop()
        context.cleanup_boundaries.pop()
    builder.append("    }\n")

def match_case_guard(arena: &const SyntaxArena, case_id: NodeId) -> NodeId:
    node = arena.nodes[case_id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind != SyntaxKind.BLOCK:
            return child_id
    return syntax.missing_node()


def match_subject_value_info(
    arena: &const SyntaxArena,
    subject: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> MatchValueInfo:
    syntax_type = codegen_context.context_expression_type(arena, context, subject, source)
    table: &const types.TypeTable = context.type_table
    semantic_subject_type = statement_strip_semantic_indirection(table, codegen_context.context_semantic_type(context, subject))
    c_type = match_parse_result_c_name(arena, subject, source)
    if len(c_type) == 0:
        c_type = match_value_c_type(syntax_type, semantic_subject_type, prefix, project_name, imports, context)
    return MatchValueInfo(syntax_type=syntax_type, semantic_type=semantic_subject_type, c_type=c_type, valid=true)


def match_value_c_type(
    syntax_type: NodeId,
    semantic_type: types.TypeId,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> String:
    if syntax_type.index >= 0:
        syntax_builder = StringBuilder()
        codegen_context.emit_context_c_type(context.type_arena, syntax_type, context.type_source, &syntax_builder, prefix, project_name, imports, context)
        syntax_name = syntax_builder.finish()
        if len(syntax_name) > 0:
            return syntax_name
    table: &const types.TypeTable = context.type_table
    if semantic_type.index >= 0 and semantic_type.index < cast[i32](len(table.types)):
        semantic_builder = StringBuilder()
        codegen_type_names.emit_semantic_c_type(table, semantic_type, context.type_source, &semantic_builder, prefix, project_name, imports, context.specialization_names)
        return semantic_builder.finish()
    return ""


def match_parse_result_c_name(arena: &const SyntaxArena, subject: NodeId, source: &const String) -> String:
    if subject.index < 0 or arena.nodes[subject.index].kind != SyntaxKind.EXPR_CALL:
        return ""
    callee = codegen_names.first_child(arena, subject)
    if callee.index < 0 or arena.nodes[callee.index].kind != SyntaxKind.EXPR_NAME:
        return ""
    callee_node = arena.nodes[callee.index]
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_bool"):
        return "CinderResult_bool_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_i32"):
        return "CinderResult_i32_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_i64"):
        return "CinderResult_i64_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_u32"):
        return "CinderResult_u32_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_u64"):
        return "CinderResult_u64_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_isize"):
        return "CinderResult_isize_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_usize"):
        return "CinderResult_usize_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_f32"):
        return "CinderResult_f32_n_CinderParseError"
    if codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "parse_f64"):
        return "CinderResult_f64_n_CinderParseError"
    return ""


def match_text_equals(value: &const String, expected: String) -> bool:
    if len(value) != len(expected):
        return false
    for offset in range(0, len(value)):
        if value.byte_at(offset) != expected.byte_at(offset):
            return false
    return true


def missing_match_value_info() -> MatchValueInfo:
    return MatchValueInfo(
        syntax_type=syntax.missing_node(),
        semantic_type=types.missing_type(),
        c_type="",
        valid=false,
    )


def match_runtime_payload_info(
    context: &codegen_model.ModuleCodegenContext,
    value_info: &const MatchValueInfo,
    constructor: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> MatchValueInfo:
    argument_index: i32 = 0
    if match_text_equals(constructor, "Err"):
        argument_index = 1
    syntax_type = syntax.missing_node()
    if value_info.syntax_type.index >= 0:
        syntax_type = codegen_context.context_generic_argument(context.type_arena, value_info.syntax_type, argument_index)
    semantic_type = types.missing_type()
    table: &const types.TypeTable = context.type_table
    if value_info.semantic_type.index >= 0 and value_info.semantic_type.index < cast[i32](len(table.types)):
        record = table.types[value_info.semantic_type.index]
        if record.kind == types.TypeKind.OPTION:
            semantic_type = record.inner
        elif record.kind == types.TypeKind.RESULT:
            if argument_index == 0:
                semantic_type = record.inner
            else:
                semantic_type = record.second
    c_type = match_value_c_type(syntax_type, semantic_type, prefix, project_name, imports, context)
    return MatchValueInfo(syntax_type=syntax_type, semantic_type=semantic_type, c_type=c_type, valid=true)

def emit_match_pattern_condition(
    arena: &const SyntaxArena,
    pattern: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    value: &const String,
    value_info: &const MatchValueInfo,
) -> void:
    if pattern.index < 0:
        builder.append("false")
        return
    node = arena.nodes[pattern.index]
    if node.kind == SyntaxKind.PATTERN_WILDCARD:
        builder.append("true")
        return
    if node.kind == SyntaxKind.PATTERN_PATH and node.flags == 1:
        emit_match_pattern_condition(arena, codegen_names.first_child(arena, pattern), source, builder, prefix, project_name, imports, context, value, value_info)
        return
    if node.kind == SyntaxKind.PATTERN_CAPTURE:
        emit_match_pattern_condition(arena, codegen_names.second_child(arena, pattern), source, builder, prefix, project_name, imports, context, value, value_info)
        return
    if node.kind == SyntaxKind.PATTERN_OR:
        builder.append("(")
        for offset in range(0, node.child_count):
            if offset > 0:
                builder.append(" || ")
            emit_match_pattern_condition(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context, value, value_info)
        builder.append(")")
        return
    if node.kind != SyntaxKind.PATTERN_PATH or node.child_count <= 0:
        builder.append("false")
        return
    name_count = match_pattern_name_count(arena, pattern)
    if name_count <= 0:
        builder.append("false")
        return
    constructor_id = arena.children[node.first_child + name_count - 1]
    constructor_node = arena.nodes[constructor_id.index]
    constructor = source[constructor_node.value_start:constructor_node.value_start + constructor_node.value_length]
    if node.child_count == 1 and codegen_names.is_lowercase_start(source, constructor_node.value_start):
        builder.append("true")
        return
    if match_text_equals(&constructor, "Some") or match_text_equals(&constructor, "None") or match_text_equals(&constructor, "Ok") or match_text_equals(&constructor, "Err"):
        builder.append("(")
        builder.append(value[0:len(value)])
        builder.append(".tag == ")
        builder.append(value_info.c_type[0:len(value_info.c_type)])
        builder.append("_Tag_")
        builder.append(constructor[0:len(constructor)])
        if name_count < node.child_count:
            nested = arena.children[node.first_child + name_count]
            nested_value = match_runtime_field_access(value, &constructor)
            nested_info = match_runtime_payload_info(context, value_info, &constructor, prefix, project_name, imports)
            builder.append(" && ")
            emit_match_pattern_condition(arena, nested, source, builder, prefix, project_name, imports, context, &nested_value, &nested_info)
        builder.append(")")
        return
    nominal_case = match_resolve_nominal_case(arena, pattern, source, prefix, project_name, imports, context, value_info)
    if not nominal_case.valid:
        builder.append("false")
        return
    builder.append("(")
    builder.append(value[0:len(value)])
    if nominal_case.is_enum:
        builder.append(" == ")
    else:
        builder.append(".tag == ")
    builder.append(nominal_case.c_name[0:len(nominal_case.c_name)])
    builder.append("_")
    builder.append(nominal_case.case_name[0:len(nominal_case.case_name)])
    argument_index: i32 = 0
    for offset in range(name_count, node.child_count):
        nested = arena.children[node.first_child + offset]
        nested_value = match_nominal_field_access(value, &nominal_case, argument_index, context)
        nested_info = match_nominal_field_info(&nominal_case, argument_index, prefix, project_name, imports, context)
        builder.append(" && ")
        emit_match_pattern_condition(arena, nested, source, builder, prefix, project_name, imports, context, &nested_value, &nested_info)
        argument_index += 1
    builder.append(")")


def match_runtime_field_access(value: &const String, constructor: &const String) -> String:
    builder = StringBuilder()
    builder.append(value[0:len(value)])
    if match_text_equals(constructor, "Some"):
        builder.append(".data.value")
    elif match_text_equals(constructor, "Ok"):
        builder.append(".data.ok")
    elif match_text_equals(constructor, "Err"):
        builder.append(".data.err")
    return builder.finish()

def emit_match_binding_declarations(
    arena: &const SyntaxArena,
    root_pattern: NodeId,
    pattern: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    root_value: &const String,
    root_info: &const MatchValueInfo,
    borrowed: bool,
    emitted: &List[String],
) -> void:
    if pattern.index < 0:
        return
    node = arena.nodes[pattern.index]
    if node.kind == SyntaxKind.PATTERN_PATH and node.flags == 1:
        emit_match_binding_declarations(arena, root_pattern, codegen_names.first_child(arena, pattern), source, builder, prefix, project_name, imports, context, root_value, root_info, borrowed, emitted)
        return
    if node.kind == SyntaxKind.PATTERN_CAPTURE or node.kind == SyntaxKind.PATTERN_OR:
        for offset in range(0, node.child_count):
            emit_match_binding_declarations(arena, root_pattern, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context, root_value, root_info, borrowed, emitted)
        return
    if node.kind != SyntaxKind.PATTERN_PATH:
        return
    name_count = match_pattern_name_count(arena, pattern)
    if node.child_count == 1 and name_count == 1:
        name_id = arena.children[node.first_child]
        name = arena.nodes[name_id.index]
        if codegen_names.is_lowercase_start(source, name.value_start):
            emit_match_binding_declaration_once(arena, root_pattern, name_id, source, builder, prefix, project_name, imports, context, root_value, root_info, borrowed, emitted)
        return
    for offset in range(name_count, node.child_count):
        emit_match_binding_declarations(arena, root_pattern, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, context, root_value, root_info, borrowed, emitted)

def emit_match_binding_declaration_once(
    arena: &const SyntaxArena,
    root_pattern: NodeId,
    name_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    root_value: &const String,
    root_info: &const MatchValueInfo,
    borrowed: bool,
    emitted: &List[String],
) -> void:
    name = arena.nodes[name_id.index]
    name_text = source[name.value_start:name.value_start + name.value_length]
    for existing in emitted:
        if match_text_equals(&existing, name_text[0:len(name_text)]):
            return
    emitted.append(name_text[0:len(name_text)])
    builder.append("    __auto_type ")
    builder.append(name_text[0:len(name_text)])
    builder.append(" = ")
    binding_info = emit_match_binding_value(arena, root_pattern, &name_text, source, builder, prefix, project_name, imports, context, root_value, root_info)
    builder.append(";\n")
    if binding_info.syntax_type.index >= 0:
        if borrowed:
            codegen_context.register_context_borrowed_name_type(arena, context, source, name.value_start, name.value_length, binding_info.syntax_type)
        else:
            codegen_context.register_context_name_type(arena, context, source, name.value_start, name.value_length, binding_info.syntax_type)
    if binding_info.semantic_type.index >= 0:
        codegen_context.register_context_semantic_name_type(context, source, name.value_start, name.value_length, binding_info.semantic_type)


def emit_match_binding_value(
    arena: &const SyntaxArena,
    pattern: NodeId,
    name: &const String,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    value: &const String,
    value_info: &const MatchValueInfo,
) -> MatchValueInfo:
    if pattern.index < 0:
        return missing_match_value_info()
    node = arena.nodes[pattern.index]
    if node.kind == SyntaxKind.PATTERN_PATH and node.flags == 1:
        return emit_match_binding_value(arena, codegen_names.first_child(arena, pattern), name, source, builder, prefix, project_name, imports, context, value, value_info)
    if node.kind == SyntaxKind.PATTERN_CAPTURE:
        binding = codegen_names.first_child(arena, pattern)
        if match_pattern_contains_binding(arena, binding, name, source):
            return emit_match_binding_value(arena, binding, name, source, builder, prefix, project_name, imports, context, value, value_info)
        return emit_match_binding_value(arena, codegen_names.second_child(arena, pattern), name, source, builder, prefix, project_name, imports, context, value, value_info)
    if node.kind == SyntaxKind.PATTERN_OR:
        return emit_match_or_binding_value(arena, pattern, 0, name, source, builder, prefix, project_name, imports, context, value, value_info)
    if node.kind != SyntaxKind.PATTERN_PATH:
        return missing_match_value_info()
    name_count = match_pattern_name_count(arena, pattern)
    if node.child_count == 1 and name_count == 1:
        name_id = arena.children[node.first_child]
        name_node = arena.nodes[name_id.index]
        candidate = source[name_node.value_start:name_node.value_start + name_node.value_length]
        if match_text_equals(&candidate, name[0:len(name)]):
            builder.append(value[0:len(value)])
            return MatchValueInfo(
                syntax_type=value_info.syntax_type,
                semantic_type=value_info.semantic_type,
                c_type=value_info.c_type[0:len(value_info.c_type)],
                valid=value_info.valid,
            )
        return missing_match_value_info()
    constructor_id = arena.children[node.first_child + name_count - 1]
    constructor_node = arena.nodes[constructor_id.index]
    constructor = source[constructor_node.value_start:constructor_node.value_start + constructor_node.value_length]
    argument_index: i32 = 0
    for offset in range(name_count, node.child_count):
        nested = arena.children[node.first_child + offset]
        if match_pattern_contains_binding(arena, nested, name, source):
            if match_text_equals(&constructor, "Some") or match_text_equals(&constructor, "Ok") or match_text_equals(&constructor, "Err"):
                nested_value = match_runtime_field_access(value, &constructor)
                nested_info = match_runtime_payload_info(context, value_info, &constructor, prefix, project_name, imports)
                return emit_match_binding_value(arena, nested, name, source, builder, prefix, project_name, imports, context, &nested_value, &nested_info)
            nominal_case = match_resolve_nominal_case(arena, pattern, source, prefix, project_name, imports, context, value_info)
            nested_value = match_nominal_field_access(value, &nominal_case, argument_index, context)
            nested_info = match_nominal_field_info(&nominal_case, argument_index, prefix, project_name, imports, context)
            return emit_match_binding_value(arena, nested, name, source, builder, prefix, project_name, imports, context, &nested_value, &nested_info)
        argument_index += 1
    return missing_match_value_info()


def emit_match_or_binding_value(
    arena: &const SyntaxArena,
    pattern: NodeId,
    start_offset: i32,
    name: &const String,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    value: &const String,
    value_info: &const MatchValueInfo,
) -> MatchValueInfo:
    node = arena.nodes[pattern.index]
    current = match_next_binding_alternative(arena, pattern, start_offset, name, source)
    if current < 0:
        return missing_match_value_info()
    nested = arena.children[node.first_child + current]
    following = match_next_binding_alternative(arena, pattern, current + 1, name, source)
    if following < 0:
        return emit_match_binding_value(arena, nested, name, source, builder, prefix, project_name, imports, context, value, value_info)
    builder.append("(")
    emit_match_pattern_condition(arena, nested, source, builder, prefix, project_name, imports, context, value, value_info)
    builder.append(" ? ")
    selected_info = emit_match_binding_value(arena, nested, name, source, builder, prefix, project_name, imports, context, value, value_info)
    builder.append(" : ")
    ignored_info = emit_match_or_binding_value(arena, pattern, following, name, source, builder, prefix, project_name, imports, context, value, value_info)
    builder.append(")")
    return selected_info


def match_next_binding_alternative(
    arena: &const SyntaxArena,
    pattern: NodeId,
    start_offset: i32,
    name: &const String,
    source: &const String,
) -> i32:
    node = arena.nodes[pattern.index]
    offset = start_offset
    while offset < node.child_count:
        nested = arena.children[node.first_child + offset]
        if match_pattern_contains_binding(arena, nested, name, source):
            return offset
        offset += 1
    return -1


def match_pattern_contains_binding(arena: &const SyntaxArena, pattern: NodeId, name: &const String, source: &const String) -> bool:
    if pattern.index < 0:
        return false
    node = arena.nodes[pattern.index]
    if node.kind == SyntaxKind.PATTERN_PATH and node.flags == 1:
        return match_pattern_contains_binding(arena, codegen_names.first_child(arena, pattern), name, source)
    if node.kind == SyntaxKind.PATTERN_CAPTURE or node.kind == SyntaxKind.PATTERN_OR:
        for offset in range(0, node.child_count):
            if match_pattern_contains_binding(arena, arena.children[node.first_child + offset], name, source):
                return true
        return false
    if node.kind != SyntaxKind.PATTERN_PATH:
        return false
    name_count = match_pattern_name_count(arena, pattern)
    if node.child_count == 1 and name_count == 1:
        name_id = arena.children[node.first_child]
        name_node = arena.nodes[name_id.index]
        candidate = source[name_node.value_start:name_node.value_start + name_node.value_length]
        return match_text_equals(&candidate, name[0:len(name)])
    for offset in range(name_count, node.child_count):
        if match_pattern_contains_binding(arena, arena.children[node.first_child + offset], name, source):
            return true
    return false


def match_pattern_name_count(arena: &const SyntaxArena, pattern: NodeId) -> i32:
    if pattern.index < 0:
        return 0
    node = arena.nodes[pattern.index]
    count: i32 = 0
    while count < node.child_count:
        child = arena.nodes[arena.children[node.first_child + count].index]
        if child.kind != SyntaxKind.NAME:
            break
        count += 1
    return count


def match_resolve_nominal_case(
    arena: &const SyntaxArena,
    pattern: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    value_info: &const MatchValueInfo,
) -> MatchNominalCase:
    if pattern.index < 0:
        return missing_match_nominal_case()
    node = arena.nodes[pattern.index]
    name_count = match_pattern_name_count(arena, pattern)
    if name_count <= 0:
        return missing_match_nominal_case()
    case_id = arena.children[node.first_child + name_count - 1]
    case_node = arena.nodes[case_id.index]
    case_name = source[case_node.value_start:case_node.value_start + case_node.value_length]
    owner_name = ""
    nominal_index: i32 = -1
    type_arena: &const SyntaxArena = context.type_arena
    type_source: &const String = context.type_source
    if name_count >= 2:
        owner_id = arena.children[node.first_child + name_count - 2]
        owner = arena.nodes[owner_id.index]
        owner_name = source[owner.value_start:owner.value_start + owner.value_length]
        if name_count >= 3:
            alias_id = arena.children[node.first_child + name_count - 3]
            alias_node = arena.nodes[alias_id.index]
            alias = source[alias_node.value_start:alias_node.value_start + alias_node.value_length]
            imported_alias = codegen_names.find_import_alias(imports, &alias)
            if len(imported_alias.module_name) > 0:
                nominal_index = codegen_reflection.find_nominal(context.reflection_model, &imported_alias.module_name, &owner_name)
        if nominal_index < 0:
            nominal_index = codegen_reflection.find_nominal_for_name(context.reflection_model, imports, &context.module_name, &owner_name)
    else:
        owner_name = codegen_type_names.context_type_owner_name(context.type_arena, value_info.syntax_type, context.type_source)
        if len(owner_name) > 0:
            nominal_index = codegen_reflection.find_nominal_for_name(context.reflection_model, imports, &context.module_name, &owner_name)
    if owner_name == "ConvertError":
        return MatchNominalCase(
            nominal_index=-1,
            case_index=-1,
            declaration=syntax.missing_node(),
            case_declaration=syntax.missing_node(),
            c_name="CinderParseError",
            case_name=case_name[0:len(case_name)],
            is_enum=true,
            valid=true,
        )
    if nominal_index >= 0 and nominal_index < codegen_reflection.nominal_count(context.reflection_model):
        nominal_kind = codegen_reflection.nominal_kind_at(context.reflection_model, nominal_index)
        is_enum = nominal_kind == codegen_reflection.ReflectionNominalKind.ENUM
        metadata_case: i32 = -1
        declaration = syntax.missing_node()
        case_declaration = syntax.missing_node()
        if nominal_kind == codegen_reflection.ReflectionNominalKind.VARIANT:
            metadata_case = codegen_reflection.find_variant_case(context.reflection_model, nominal_index, &case_name)
            if metadata_case < 0:
                return missing_match_nominal_case()
        elif not is_enum:
            return missing_match_nominal_case()
        nominal_module = codegen_reflection.nominal_module_name_at(context.reflection_model, nominal_index)
        if nominal_module == context.module_name:
            declaration = match_find_local_nominal(type_arena, context.root, type_source, &owner_name)
            if declaration.index >= 0 and nominal_kind == codegen_reflection.ReflectionNominalKind.VARIANT:
                case_declaration = codegen_names.find_variant_case_declaration(type_arena, declaration, type_source, &case_name)
        return MatchNominalCase(
            nominal_index=nominal_index,
            case_index=metadata_case,
            declaration=declaration,
            case_declaration=case_declaration,
            c_name=match_reflection_nominal_c_name(value_info, nominal_index, context),
            case_name=case_name[0:len(case_name)],
            is_enum=is_enum,
            valid=true,
        )
    if len(owner_name) == 0:
        return missing_match_nominal_case()
    declaration = match_find_local_nominal(type_arena, context.root, type_source, &owner_name)
    if declaration.index < 0:
        return missing_match_nominal_case()
    declaration_node = codegen_names.arena_node_at(context.type_arena, declaration)
    is_enum = declaration_node.kind == SyntaxKind.ENUM_DECL
    case_declaration = syntax.missing_node()
    if declaration_node.kind == SyntaxKind.VARIANT_DECL:
        case_declaration = codegen_names.find_variant_case_declaration(type_arena, declaration, type_source, &case_name)
        if case_declaration.index < 0:
            return missing_match_nominal_case()
    elif not is_enum:
        return missing_match_nominal_case()
    return MatchNominalCase(
        nominal_index=-1,
        case_index=-1,
        declaration=declaration,
        case_declaration=case_declaration,
        c_name=match_local_nominal_c_name(value_info, prefix, &owner_name),
        case_name=case_name[0:len(case_name)],
        is_enum=is_enum,
        valid=true,
    )


def match_reflection_nominal_c_name(
    value_info: &const MatchValueInfo,
    nominal_index: i32,
    context: &codegen_model.ModuleCodegenContext,
) -> String:
    if value_info.syntax_type.index >= 0:
        syntax_node = codegen_names.arena_node_at(context.type_arena, value_info.syntax_type)
        if syntax_node.kind == SyntaxKind.TYPE_GENERIC and len(value_info.c_type) > 0:
            return value_info.c_type[0:len(value_info.c_type)]
    return codegen_reflection.nominal_c_name_at(context.reflection_model, nominal_index)


def match_local_nominal_c_name(value_info: &const MatchValueInfo, prefix: &const String, owner_name: &const String) -> String:
    if len(value_info.c_type) > 0:
        return value_info.c_type[0:len(value_info.c_type)]
    builder = StringBuilder()
    builder.append(prefix[0:len(prefix)])
    builder.append(owner_name[0:len(owner_name)])
    return builder.finish()


def missing_match_nominal_case() -> MatchNominalCase:
    return MatchNominalCase(
        nominal_index=-1,
        case_index=-1,
        declaration=syntax.missing_node(),
        case_declaration=syntax.missing_node(),
        c_name="",
        case_name="",
        is_enum=false,
        valid=false,
    )


def match_find_local_nominal(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    name: &const String,
) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if (node.kind == SyntaxKind.ENUM_DECL or node.kind == SyntaxKind.VARIANT_DECL) and codegen_names.range_text_equals(source, node.value_start, node.value_length, name[0:len(name)]):
        return id
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            found = match_find_local_nominal(arena, arena.children[node.first_child + offset], source, name)
            if found.index >= 0:
                return found
    return syntax.missing_node()


def match_nominal_field_access(
    value: &const String,
    nominal_case: &const MatchNominalCase,
    field_index: i32,
    context: &codegen_model.ModuleCodegenContext,
) -> String:
    field_name = ""
    type_arena: &const SyntaxArena = context.type_arena
    if nominal_case.case_index >= 0:
        metadata_field = codegen_reflection.variant_field_at(context.reflection_model, nominal_case.case_index, field_index)
        if metadata_field >= 0:
            field_name = codegen_reflection.variant_field_name_at(context.reflection_model, metadata_field)
    if len(field_name) == 0:
        field_id = match_local_variant_field(type_arena, nominal_case.case_declaration, field_index)
        if field_id.index >= 0:
            field = codegen_names.arena_node_at(context.type_arena, field_id)
            type_source: &const String = context.type_source
            field_name = type_source[field.value_start:field.value_start + field.value_length]
    builder = StringBuilder()
    builder.append(value[0:len(value)])
    builder.append(".data.")
    builder.append(nominal_case.case_name[0:len(nominal_case.case_name)])
    if len(field_name) > 0:
        builder.append(".")
        builder.append(field_name[0:len(field_name)])
    return builder.finish()


def match_nominal_field_info(
    nominal_case: &const MatchNominalCase,
    field_index: i32,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> MatchValueInfo:
    type_arena: &const SyntaxArena = context.type_arena
    field_id = match_local_variant_field(type_arena, nominal_case.case_declaration, field_index)
    if field_id.index >= 0:
        field_type = codegen_type_names.find_child_type(context.type_arena, field_id)
        c_type = match_value_c_type(field_type, types.missing_type(), prefix, project_name, imports, context)
        return MatchValueInfo(
            syntax_type=field_type,
            semantic_type=types.missing_type(),
            c_type=c_type,
            valid=true,
        )
    if nominal_case.case_index >= 0:
        metadata_field = codegen_reflection.variant_field_at(context.reflection_model, nominal_case.case_index, field_index)
        if metadata_field >= 0:
            return MatchValueInfo(
                syntax_type=syntax.missing_node(),
                semantic_type=types.missing_type(),
                c_type=codegen_reflection.variant_field_c_type_at(context.reflection_model, metadata_field),
                valid=true,
            )
    return missing_match_value_info()


def match_local_variant_field(arena: &const SyntaxArena, case_id: NodeId, wanted: i32) -> NodeId:
    if case_id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[case_id.index]
    seen: i32 = 0
    for offset in range(0, node.child_count):
        field_id = arena.children[node.first_child + offset]
        if arena.nodes[field_id.index].kind != SyntaxKind.FIELD_DECL:
            continue
        if seen == wanted:
            return field_id
        seen += 1
    return syntax.missing_node()


def emit_module_with(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    expr = codegen_names.first_child(arena, id)
    name = codegen_names.second_child(arena, id)
    body = codegen_names.last_child(arena, id)
    name_node = arena.nodes[name.index]
    pointer_start = len(context.pointer_names)
    builder.append("    {\n")
    builder.append("    FILE *")
    codegen_names.append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(" = ")
    codegen_expr.emit_module_expression(arena, expr, source, builder, prefix, project_name, imports, context)
    builder.append(";\n")
    codegen_context.register_context_pointer_name(context, source, name_node.value_start, name_node.value_length)
    resource_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    context.with_resources.append(resource_name[0:len(resource_name)])
    builder.append("    if (")
    codegen_names.append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(" == NULL) cinder_panic(\"failed to open file\");\n")
    builder.append("    {\n")
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
    context.with_resources.pop()
    builder.append("    }\n")
    builder.append("    fclose(")
    codegen_names.append_source(builder, source, name_node.value_start, name_node.value_length)
    builder.append(");\n")
    builder.append("    }\n")
    while len(context.pointer_names) > pointer_start:
        context.pointer_names.pop()

def emit_module_for_each(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    node = arena.nodes[id.index]
    target = codegen_names.first_child(arena, id)
    iterable = for_each_iterable(arena, id)
    body = codegen_names.last_child(arena, id)
    if node.flags == 1:
        emit_comptime_reflection_for_each(arena, target, iterable, body, source, builder, prefix, project_name, imports, context)
        return
    if expression_is_named_call(arena, iterable, source, "fields"):
        emit_runtime_reflection_for_each(arena, target, iterable, body, source, builder, prefix, project_name, imports, context)
        return
    target_node = arena.nodes[target.index]
    if is_range_call(arena, iterable, source):
        range_type = codegen_context.context_expression_type(arena, context, range_argument_expression(arena, iterable, 1), source)
        if range_type.index < 0:
            range_type = codegen_context.context_expression_type(arena, context, range_argument_expression(arena, iterable, 0), source)
        builder.append("    for (")
        if range_type.index >= 0 and codegen_type_names.is_type_kind(codegen_type_names.type_node_kind(context.type_arena, range_type)):
            codegen_context.emit_context_c_type(context.type_arena, range_type, context.type_source, builder, prefix, project_name, imports, context)
        else:
            builder.append("int32_t")
        builder.append(" ")
        codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" = ")
        emit_range_argument(arena, iterable, 0, source, builder, prefix, project_name, imports, context)
        builder.append("; ")
        codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" < ")
        emit_range_argument(arena, iterable, 1, source, builder, prefix, project_name, imports, context)
        builder.append("; ")
        codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" += ")
        emit_range_argument(arena, iterable, 2, source, builder, prefix, project_name, imports, context)
        builder.append(") {\n")
        if range_type.index >= 0:
            codegen_context.register_context_name_type(context.type_arena, context, source, target_node.value_start, target_node.value_length, range_type)
        emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, true)
        if range_type.index >= 0 and len(context.local_types) > 0:
            context.local_types.pop()
        builder.append("    }\n")
        return
    if emit_semantic_collection_for_each(arena, iterable, target, body, source, builder, prefix, project_name, imports, context):
        return
    element_type = codegen_context.context_expression_list_element_type(arena, context, iterable, source)
    if element_type.index < 0:
        element_type = codegen_type_names.find_child_type(arena, id)
    element_name = ""
    if element_type.index < 0:
        element_name = codegen_access.known_list_element_name(arena, iterable, source, context)
    iterable_owned_path = codegen_access.expression_is_owned_path_string(arena, iterable, source, imports, context)
    iteration_value_name = ""
    if iterable_owned_path:
        temporary_index = context.temporary_index
        context.temporary_index += 1
        iteration_name_builder = StringBuilder()
        iteration_name_builder.append("cinder_path_iteration_")
        codegen_type_names.append_specialization_decimal(&iteration_name_builder, cast[usize](temporary_index))
        iteration_value_name = iteration_name_builder.finish()
        builder.append("    {\n    CinderString ")
        builder.append(iteration_value_name[0:len(iteration_value_name)])
        builder.append(" = ")
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
        builder.append(";\n")
        context.cleanup_boundaries.append(
            codegen_context.CodegenCleanupBoundary(
                local_start=len(context.local_types),
                defer_start=len(context.deferred_expressions),
                with_resource_start=len(context.with_resources),
                iterator_guard_start=len(context.iterator_guard_names),
                lock_cleanup_start=len(context.lock_cleanups),
                value_cleanup_start=len(context.value_cleanups),
                loop_body=false,
            )
        )
        context.value_cleanups.append(
            codegen_context.CodegenValueCleanup(
                name=iteration_value_name[0:len(iteration_value_name)],
                semantic_type=codegen_context.context_semantic_type(context, iterable),
            )
        )
    builder.append("    for (size_t cinder_index = 0; cinder_index < ")
    if iterable_owned_path:
        builder.append(iteration_value_name[0:len(iteration_value_name)])
    else:
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
    if codegen_context.context_expression_is_pointer_like(arena, context, iterable, source):
        builder.append("->length")
    else:
        builder.append(".length")
    builder.append("; ++cinder_index) {\n")
    builder.append("    ")
    if element_type.index >= 0:
        codegen_context.emit_context_c_type(arena, element_type, source, builder, prefix, project_name, imports, context)
    elif len(element_name) > 0:
        builder.append(element_name)
    else:
        builder.append("__auto_type")
    builder.append(" ")
    codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
    builder.append(" = ((")
    if element_type.index >= 0:
        codegen_context.emit_context_c_type(arena, element_type, source, builder, prefix, project_name, imports, context)
    elif len(element_name) > 0:
        builder.append(element_name)
    else:
        builder.append("char")
    builder.append(" *)")
    if iterable_owned_path:
        builder.append(iteration_value_name[0:len(iteration_value_name)])
    else:
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
    if codegen_context.context_expression_is_pointer_like(arena, context, iterable, source):
        builder.append("->data)[cinder_index];\n")
    else:
        builder.append(".data)[cinder_index];\n")
    if element_type.index >= 0:
        codegen_context.register_context_borrowed_name_type(arena, context, source, target_node.value_start, target_node.value_length, element_type)
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, true)
    if element_type.index >= 0:
        if len(context.local_types) > 0:
            context.local_types.pop()
    builder.append("    }\n")
    if iterable_owned_path:
        emit_module_value_cleanups_until(builder, context, len(context.value_cleanups) - 1, len(context.value_cleanups), prefix, project_name, imports)
        context.value_cleanups.pop()
        context.cleanup_boundaries.pop()
        builder.append("    }\n")


def emit_runtime_reflection_for_each(
    arena: &const SyntaxArena,
    target: NodeId,
    iterable: NodeId,
    body: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    target_node = arena.nodes[target.index]
    temporary_index = context.temporary_index
    context.temporary_index += 1
    builder.append("    {\n    CinderList cinder_reflection_fields_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(" = ")
    codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
    builder.append(";\n    for (size_t cinder_index = 0; cinder_index < cinder_reflection_fields_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".length; ++cinder_index) {\n    CinderFieldInfo ")
    codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
    builder.append(" = ((const CinderFieldInfo *)cinder_reflection_fields_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".data)[cinder_index];\n")
    codegen_context.register_context_reflection_binding(context, source, target_node.value_start, target_node.value_length, codegen_context.ReflectionBindingKind.RUNTIME_FIELD, -1, -1)
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, true)
    context.reflection_bindings.pop()
    builder.append("    }\n    }\n")


def emit_comptime_reflection_for_each(
    arena: &const SyntaxArena,
    target: NodeId,
    iterable: NodeId,
    body: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    if not expression_is_named_call(arena, iterable, source, "fields_of"):
        return
    type_argument = codegen_names.first_call_argument(arena, iterable)
    nominal_index = reflection_type_expression_nominal(arena, type_argument, source, context)
    count = codegen_reflection.effective_field_count(context.reflection_model, context.class_model, nominal_index)
    target_node = arena.nodes[target.index]
    for offset in range(0, count):
        field_index = codegen_reflection.effective_field_at(context.reflection_model, context.class_model, nominal_index, offset)
        builder.append("    /* comptime fields iteration ")
        codegen_type_names.append_specialization_decimal(builder, cast[usize](offset))
        builder.append(" */\n    {\n")
        codegen_context.register_context_reflection_binding(context, source, target_node.value_start, target_node.value_length, codegen_context.ReflectionBindingKind.COMPTIME_FIELD, nominal_index, field_index)
        emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, false)
        context.reflection_bindings.pop()
        builder.append("    }\n")


def reflection_type_expression_nominal(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    context: &codegen_model.ModuleCodegenContext,
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        return codegen_reflection.find_nominal_for_name(context.reflection_model, context.imports, &context.module_name, &name)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = codegen_names.first_child(arena, id)
        member = codegen_names.second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = codegen_names.find_import_alias(context.imports, &alias)
            if len(imported.module_name) > 0:
                name = source[member_node.value_start:member_node.value_start + member_node.value_length]
                return codegen_reflection.find_nominal(context.reflection_model, &imported.module_name, &name)
    return -1

def emit_semantic_collection_for_each(
    arena: &const SyntaxArena,
    iterable: NodeId,
    target: NodeId,
    body: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    table: &const types.TypeTable = context.type_table
    semantic_type = statement_strip_semantic_indirection(table, codegen_context.context_semantic_type(context, iterable))
    if semantic_type.index < 0 or semantic_type.index >= cast[i32](len(table.types)):
        return false
    record = table.types[semantic_type.index]
    if record.kind != types.TypeKind.SET and record.kind != types.TypeKind.MAP and not types.is_map_view_kind(record.kind):
        return false
    collection_type = semantic_type
    view_kind = types.TypeKind.ERROR
    if types.is_map_view_kind(record.kind):
        view_kind = record.kind
        collection_type = record.inner
    collection_record = table.types[collection_type.index]
    name_builder = StringBuilder()
    codegen_type_names.emit_semantic_specialized_type_name(table, collection_type, context.type_source, &name_builder, context.specialization_names)
    name = name_builder.finish()
    guard_name_builder = StringBuilder()
    guard_name_builder.append("cinder_collection_")
    codegen_type_names.append_specialization_decimal(&guard_name_builder, cast[usize](iterable.index))
    guard_name = guard_name_builder.finish()
    target_node = arena.nodes[target.index]
    iterable_node = arena.nodes[iterable.index]
    owns_iteration_value = view_kind == types.TypeKind.ERROR and iterable_node.kind != SyntaxKind.EXPR_NAME and not codegen_context.context_expression_is_pointer_like(arena, context, iterable, source)
    iteration_value_name = ""
    if owns_iteration_value:
        temporary_index = context.temporary_index
        context.temporary_index += 1
        iteration_name_builder = StringBuilder()
        iteration_name_builder.append("cinder_iteration_value_")
        codegen_type_names.append_specialization_decimal(&iteration_name_builder, cast[usize](temporary_index))
        iteration_value_name = iteration_name_builder.finish()

    builder.append("    {\n")
    if view_kind != types.TypeKind.ERROR:
        builder.append("    __auto_type cinder_view = ")
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
        builder.append(";\n    ")
        builder.append(name[0:len(name)])
        builder.append(" *")
        builder.append(guard_name[0:len(guard_name)])
        builder.append(" = (")
        builder.append(name[0:len(name)])
        builder.append(" *)cinder_view.map;\n")
    elif owns_iteration_value:
        builder.append("    ")
        builder.append(name[0:len(name)])
        builder.append(" ")
        builder.append(iteration_value_name[0:len(iteration_value_name)])
        builder.append(" = ")
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
        builder.append(";\n    ")
        builder.append(name[0:len(name)])
        builder.append(" *")
        builder.append(guard_name[0:len(guard_name)])
        builder.append(" = &")
        builder.append(iteration_value_name[0:len(iteration_value_name)])
        builder.append(";\n")
        codegen_context.register_context_generated_name_type(context, iteration_value_name[0:len(iteration_value_name)], iterable)
    else:
        builder.append("    ")
        builder.append(name[0:len(name)])
        builder.append(" *")
        builder.append(guard_name[0:len(guard_name)])
        builder.append(" = ")
        if not codegen_context.context_expression_is_pointer_like(arena, context, iterable, source):
            builder.append("&")
        codegen_expr.emit_module_expression(arena, iterable, source, builder, prefix, project_name, imports, context)
        builder.append(";\n")
    builder.append("    ")
    builder.append(name[0:len(name)])
    builder.append(" *cinder_collection = ")
    builder.append(guard_name[0:len(guard_name)])
    builder.append(";\n")
    builder.append("    if (cinder_collection != NULL) cinder_collection->active_iterators += 1;\n")
    builder.append("    for (size_t cinder_index = 0; cinder_collection != NULL && cinder_index < cinder_collection->")
    if collection_record.kind == types.TypeKind.SET:
        builder.append("capacity")
    else:
        builder.append("entries_length")
    builder.append("; ++cinder_index) {\n")
    if collection_record.kind == types.TypeKind.SET:
        builder.append("    if (cinder_collection->entries[cinder_index].state != 1) continue;\n")
    else:
        builder.append("    if (!cinder_collection->entries[cinder_index].occupied) continue;\n")
    builder.append("    ")
    registered_semantic_string = false
    if view_kind == types.TypeKind.MAP_ITEMS:
        target_type = codegen_context.context_semantic_type(context, target)
        if codegen_type_names.semantic_type_is_kind(table, target_type, types.TypeKind.TUPLE):
            codegen_type_names.emit_semantic_c_type(table, target_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            builder.append("__auto_type")
        builder.append(" ")
        codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" = { .item_0 = cinder_collection->entries[cinder_index].key, .item_1 = cinder_collection->entries[cinder_index].value };\n")
    else:
        builder.append("__auto_type ")
        codegen_names.append_source(builder, source, target_node.value_start, target_node.value_length)
        builder.append(" = cinder_collection->entries[cinder_index].")
        if collection_record.kind == types.TypeKind.SET:
            builder.append("value")
        elif view_kind == types.TypeKind.MAP_VALUES:
            builder.append("value")
        else:
            builder.append("key")
        builder.append(";\n")
    if view_kind == types.TypeKind.MAP_ITEMS:
        key_type = statement_strip_semantic_indirection(table, collection_record.inner)
        value_type = statement_strip_semantic_indirection(table, collection_record.second)
        key_is_string = codegen_type_names.semantic_type_is_kind(table, key_type, types.TypeKind.STRING)
        value_is_string = codegen_type_names.semantic_type_is_kind(table, value_type, types.TypeKind.STRING)
        codegen_context.register_context_tuple_item_name(context, source, target_node.value_start, target_node.value_length, key_is_string, value_is_string)
    else:
        iteration_type = collection_record.inner
        if view_kind == types.TypeKind.MAP_VALUES:
            iteration_type = collection_record.second
        iteration_type = statement_strip_semantic_indirection(table, iteration_type)
        if codegen_type_names.semantic_type_is_kind(table, iteration_type, types.TypeKind.STRING):
            codegen_context.register_context_semantic_string_name(context, source, target_node.value_start, target_node.value_length)
            registered_semantic_string = true
    context.iterator_guard_names.append(guard_name[0:len(guard_name)])
    emit_module_block(arena, body, source, builder, prefix, project_name, imports, context, true)
    context.iterator_guard_names.pop()
    if view_kind == types.TypeKind.MAP_ITEMS and len(context.tuple_items) > 0:
        context.tuple_items.pop()
    if registered_semantic_string and len(context.semantic_string_names) > 0:
        context.semantic_string_names.pop()
    builder.append("    }\n")
    builder.append("    if (cinder_collection != NULL) cinder_collection->active_iterators -= 1;\n")
    if owns_iteration_value:
        codegen_context.emit_context_drop(arena, context, iterable, source, builder, &iteration_value_name, prefix, project_name, imports)
        if len(context.local_types) > 0:
            context.local_types.pop()
    builder.append("    }\n")
    return true


def statement_strip_semantic_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current


def for_each_iterable(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != SyntaxKind.NAME and not codegen_type_names.is_type_kind(child.kind) and child.kind != SyntaxKind.BLOCK:
            return child_id
    return syntax.missing_node()

def is_range_call(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0:
        return false
    callee_node = arena.nodes[callee.index]
    return callee_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "range")


def expression_is_named_call(arena: &const SyntaxArena, id: NodeId, source: &const String, expected: String) -> bool:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0:
        return false
    callee_node = arena.nodes[callee.index]
    return callee_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, expected[0:len(expected)])


def range_argument_expression(arena: &const SyntaxArena, id: NodeId, argument_index: i32) -> NodeId:
    actual_index: i32 = 0
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if actual_index == argument_index:
                return codegen_names.last_child(arena, child_id)
            actual_index += 1
    return syntax.missing_node()

def emit_range_argument(
    arena: &const SyntaxArena,
    id: NodeId,
    argument_index: i32,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> void:
    actual_index: i32 = 0
    node = arena.nodes[id.index]
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if actual_index == argument_index:
                codegen_expr.emit_module_expression(arena, codegen_names.last_child(arena, child_id), source, builder, prefix, project_name, imports, context)
                return
            actual_index += 1
    if argument_index == 0:
        builder.append("0")
    elif argument_index == 2:
        builder.append("1")
    else:
        builder.append("0")
