import types
from types import TypeId


enum CollectionKind:
    STRING
    LIST
    MAP
    SET


struct CollectionMethod:
    kind: CollectionKind
    name: String
    mutates: bool


def list_type(table: &types.TypeTable, element: TypeId) -> TypeId:
    return table.generic1(types.TypeKind.LIST, 0, 0, element)


def set_type(table: &types.TypeTable, element: TypeId) -> TypeId:
    return table.generic1(types.TypeKind.SET, 0, 0, element)


def map_type(table: &types.TypeTable, key: TypeId, value: TypeId) -> TypeId:
    return table.generic2(types.TypeKind.MAP, 0, 0, key, value)


def map_view_type(table: &types.TypeTable, map_type_id: TypeId, name: &const String) -> TypeId:
    if text_equals(name, "keys"):
        return table.map_view(types.TypeKind.MAP_KEYS, map_type_id)
    if text_equals(name, "values"):
        return table.map_view(types.TypeKind.MAP_VALUES, map_type_id)
    if text_equals(name, "items"):
        return table.map_view(types.TypeKind.MAP_ITEMS, map_type_id)
    return types.type_error()


def method_is_mutating(kind: CollectionKind, name: &const String) -> bool:
    if kind == CollectionKind.STRING:
        return text_equals(name, "append") or text_equals(name, "append_char") or text_equals(name, "reserve") or text_equals(name, "clear")
    if kind == CollectionKind.LIST:
        return text_equals(name, "append") or text_equals(name, "pop") or text_equals(name, "clear")
    if kind == CollectionKind.MAP:
        return text_equals(name, "pop") or text_equals(name, "clear") or text_equals(name, "update")
    if kind == CollectionKind.SET:
        return text_equals(name, "add") or text_equals(name, "discard") or text_equals(name, "remove") or text_equals(name, "pop") or text_equals(name, "clear") or text_equals(name, "update")
    return false


def text_equals(left: &const String, right: String) -> bool:
    if len(left) != len(right):
        return false
    offset: usize = 0
    while offset < len(left):
        if left.byte_at(offset) != right.byte_at(offset):
            return false
        offset += 1
    return true
