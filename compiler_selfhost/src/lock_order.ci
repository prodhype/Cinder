import diagnostics
import project
import syntax
from syntax import NodeId, SyntaxArena, SyntaxKind
from token import TokenKind


struct ProjectLock:
    module_name: String
    name: String
    canonical_key: i32


struct LockEdge:
    before: i32
    after: i32
    explicit: bool
    module_name: String
    source_path: String
    start: usize
    length: usize
    line: i32
    column: i32


struct FunctionLockEffect:
    qualified_name: String
    module_name: String
    name: String
    locks: List[i32]
    callees: List[String]
    unknown: bool


struct LockAlias:
    name: String
    lock_index: i32


struct MethodOwner:
    module_name: String
    name: String


struct MethodReceiverBinding:
    name: String
    module_name: String
    owner_name: String


struct ClassLockLifecycle:
    module_name: String
    name: String
    is_interface_only: bool
    primary_base: i32
    has_explicit_init: bool
    has_explicit_del: bool


struct CallLockResolution:
    qualified_name: String
    known: bool


struct ProjectLockModel:
    locks: List[ProjectLock]
    edges: List[LockEdge]
    functions: List[FunctionLockEffect]
    classes: List[ClassLockLifecycle]
    diagnostic_values: List[diagnostics.Diagnostic]
    diagnostic_modules: List[String]
    prepared: bool


def new_project_lock_model() -> ProjectLockModel:
    lock_values: List[ProjectLock] = []
    edge_values: List[LockEdge] = []
    function_values: List[FunctionLockEffect] = []
    class_values: List[ClassLockLifecycle] = []
    diagnostic_values: List[diagnostics.Diagnostic] = []
    diagnostic_modules: List[String] = []
    return ProjectLockModel(
        locks=lock_values,
        edges=edge_values,
        functions=function_values,
        classes=class_values,
        diagnostic_values=diagnostic_values,
        diagnostic_modules=diagnostic_modules,
        prepared=false,
    )


def prepare_project_lock_model(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    if model.prepared:
        return
    model.prepared = true
    if not project_uses_locks(modules):
        return
    collect_locks(model, modules)
    collect_class_lifecycles(model, modules)
    collect_explicit_edges(model, modules)
    collect_function_effects(model, modules)
    infer_function_effects(model)
    infer_nested_edges(model, modules)
    assign_canonical_keys(model)


def project_uses_locks(modules: &const List[project.ParsedModule]) -> bool:
    for module in modules:
        if node_uses_locks(&module.arena, module.root):
            return true
    return false


def node_uses_locks(arena: &const SyntaxArena, id: NodeId) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.LOCK_DECL or node.kind == SyntaxKind.LOCK_ORDER_DECL or node.kind == SyntaxKind.CRITICAL_SECTION_STMT:
        return true
    for offset in range(0, node.child_count):
        if node_uses_locks(arena, arena.children[node.first_child + offset]):
            return true
    return false


def collect_locks(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    module_index: usize = 0
    while module_index < len(modules):
        module: &const project.ParsedModule = &modules[module_index]
        if module.root.index < 0:
            module_index += 1
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            declaration = module_arena.nodes[declaration_id.index]
            if declaration.kind == SyntaxKind.LOCK_DECL:
                name = module.source[declaration.value_start:declaration.value_start + declaration.value_length]
                if find_lock(model, &module.name, &name) < 0:
                    model.locks.append(
                        ProjectLock(
                            module_name=module.name[0:len(module.name)],
                            name=name,
                            canonical_key=-1,
                        )
                    )
        module_index += 1


def collect_class_lifecycles(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    module_index: usize = 0
    while module_index < len(modules):
        module: &const project.ParsedModule = &modules[module_index]
        if module.root.index < 0:
            module_index += 1
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            declaration = module_arena.nodes[declaration_id.index]
            if declaration.kind != SyntaxKind.CLASS_DECL:
                continue
            name = module.source[declaration.value_start:declaration.value_start + declaration.value_length]
            has_layout = false
            has_explicit_init = false
            has_explicit_del = false
            for child_offset in range(0, declaration.child_count):
                child_id = module_arena.children[declaration.first_child + child_offset]
                child = module_arena.nodes[child_id.index]
                if child.kind == SyntaxKind.FIELD_DECL:
                    has_layout = true
                elif child.kind == SyntaxKind.FUNCTION_DECL:
                    method_name = module.source[child.value_start:child.value_start + child.value_length]
                    if method_name == "__init__":
                        has_explicit_init = true
                        has_layout = true
                    if method_name == "__del__":
                        has_explicit_del = true
                        has_layout = true
            model.classes.append(
                ClassLockLifecycle(
                    module_name=module.name[0:len(module.name)],
                    name=name,
                    is_interface_only=declaration.flags == 1 and not has_layout,
                    primary_base=-1,
                    has_explicit_init=has_explicit_init,
                    has_explicit_del=has_explicit_del,
                )
            )
        module_index += 1
    module_index = 0
    while module_index < len(modules):
        module: &const project.ParsedModule = &modules[module_index]
        if module.root.index < 0:
            module_index += 1
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            declaration = module_arena.nodes[declaration_id.index]
            if declaration.kind != SyntaxKind.CLASS_DECL:
                continue
            name = module.source[declaration.value_start:declaration.value_start + declaration.value_length]
            class_index = find_class_lifecycle(model, &module.name, &name)
            if class_index < 0:
                continue
            for child_offset in range(0, declaration.child_count):
                child_id = module_arena.children[declaration.first_child + child_offset]
                child = module_arena.nodes[child_id.index]
                if not lock_order_is_type_kind(child.kind):
                    continue
                base_index = class_index_from_type(model, &module.name, &module.imports, module_arena, child_id, &module.source)
                if base_index >= 0 and not model.classes[cast[usize](base_index)].is_interface_only:
                    model.classes[cast[usize](class_index)].primary_base = base_index
                    break
        module_index += 1


def collect_explicit_edges(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    for module in modules:
        if module.root.index < 0:
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            declaration = module_arena.nodes[declaration_id.index]
            if declaration.kind == SyntaxKind.LOCK_DECL and declaration.child_count > 0:
                name = module.source[declaration.value_start:declaration.value_start + declaration.value_length]
                after = find_lock(model, &module.name, &name)
                before = resolve_lock_reference(
                    model,
                    &module.name,
                    &module.imports,
                    module_arena,
                    module_arena.children[declaration.first_child],
                    &module.source,
                )
                if before >= 0 and after >= 0:
                    add_explicit_edge(model, before, after, &module.name, &module.path, &declaration)
                elif before < 0:
                    reference = module_arena.nodes[module_arena.children[declaration.first_child].index]
                    reference_name = module.source[reference.start:reference.start + reference.length]
                    add_lock_name_diagnostic(
                        model,
                        &module.name,
                        diagnostics.DiagnosticId.LOCK_404,
                        &declaration,
                        &reference_name,
                    )
            elif declaration.kind == SyntaxKind.LOCK_ORDER_DECL and declaration.child_count >= 2:
                before = resolve_lock_reference(
                    model,
                    &module.name,
                    &module.imports,
                    module_arena,
                    module_arena.children[declaration.first_child],
                    &module.source,
                )
                after = resolve_lock_reference(
                    model,
                    &module.name,
                    &module.imports,
                    module_arena,
                    module_arena.children[declaration.first_child + 1],
                    &module.source,
                )
                if before >= 0 and after >= 0:
                    add_explicit_edge(model, before, after, &module.name, &module.path, &declaration)
                else:
                    reference_id = module_arena.children[declaration.first_child]
                    if before >= 0 and after < 0:
                        reference_id = module_arena.children[declaration.first_child + 1]
                    reference = module_arena.nodes[reference_id.index]
                    reference_name = module.source[reference.start:reference.start + reference.length]
                    add_lock_name_diagnostic(
                        model,
                        &module.name,
                        diagnostics.DiagnosticId.LOCK_404,
                        &reference,
                        &reference_name,
                    )


def collect_function_effects(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    module_index: usize = 0
    while module_index < len(modules):
        module: &const project.ParsedModule = &modules[module_index]
        if module.root.index < 0:
            module_index += 1
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        empty_owner = ""
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            collect_function_effect_from_declaration(model, &module.name, &module.imports, module_arena, declaration_id, &module.source, &empty_owner)
        module_index += 1


def collect_function_effect_from_declaration(
    model: &ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    declaration_id: NodeId,
    source: &const String,
    owner_name: &const String,
) -> void:
    if declaration_id.index < 0:
        return
    declaration = arena.nodes[declaration_id.index]
    if declaration.kind == SyntaxKind.FUNCTION_DECL:
        name = source[declaration.value_start:declaration.value_start + declaration.value_length]
        effect_locks: List[i32] = []
        callees: List[String] = []
        model.functions.append(
            FunctionLockEffect(
                qualified_name=qualified_function_name(module_name, owner_name, &name),
                module_name=module_name[0:len(module_name)],
                name=name,
                locks=effect_locks,
                callees=callees,
                unknown=false,
            )
        )
        function_index = cast[i32](len(model.functions)) - 1
        receiver_bindings: List[MethodReceiverBinding] = []
        if len(owner_name) > 0:
            self_name = "self"
            set_method_receiver_binding(receiver_bindings, &self_name, module_name, owner_name)
        collect_direct_effects(
            model,
            function_index,
            module_name,
            imports,
            arena,
            declaration_id,
            source,
            receiver_bindings,
            owner_name,
        )
        return
    if declaration.kind == SyntaxKind.STRUCT_DECL or declaration.kind == SyntaxKind.CLASS_DECL:
        owner = source[declaration.value_start:declaration.value_start + declaration.value_length]
        for offset in range(0, declaration.child_count):
            child_id = arena.children[declaration.first_child + offset]
            if arena.nodes[child_id.index].kind == SyntaxKind.FUNCTION_DECL:
                collect_function_effect_from_declaration(model, module_name, imports, arena, child_id, source, &owner)


def collect_direct_effects(
    model: &ProjectLockModel,
    function_index: i32,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &List[MethodReceiverBinding],
    owner_name: &const String,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.BLOCK:
        binding_count = len(receiver_bindings)
        cleanup_classes: List[i32] = []
        cleanup_names: List[String] = []
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            cleanup_class = local_drop_class_from_statement(
                model,
                module_name,
                imports,
                arena,
                child_id,
                source,
                receiver_bindings,
            )
            if cleanup_class >= 0:
                cleanup_classes.append(cleanup_class)
                cleanup_names.append(local_statement_name(arena, child_id, source))
            collect_direct_effects(
                model,
                function_index,
                module_name,
                imports,
                arena,
                child_id,
                source,
                receiver_bindings,
                owner_name,
            )
        cleanup_index: usize = 0
        while cleanup_index < len(cleanup_classes):
            if not node_moves_name(arena, id, source, &cleanup_names[cleanup_index]):
                visited: List[i32] = []
                append_class_drop_callees(model, function_index, cleanup_classes[cleanup_index], visited)
            cleanup_index += 1
        while len(receiver_bindings) > binding_count:
            receiver_bindings.pop()
        return
    record_method_receiver_binding(module_name, imports, arena, id, source, receiver_bindings)
    if node.kind == SyntaxKind.CRITICAL_SECTION_STMT:
        expression = first_child(arena, id)
        lock_index = resolve_lock_expression(model, module_name, imports, arena, expression, source)
        if lock_index >= 0:
            append_i32_once(&model.functions[cast[usize](function_index)].locks, lock_index)
        else:
            model.functions[cast[usize](function_index)].unknown = true
    elif node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, id)
        if not call_is_known_builtin(arena, callee, source):
            resolution = resolve_call_lock_effect(model, module_name, imports, arena, callee, source, receiver_bindings, owner_name)
            if len(resolution.qualified_name) > 0:
                append_string_once(&model.functions[cast[usize](function_index)].callees, resolution.qualified_name[0:len(resolution.qualified_name)])
            elif not resolution.known:
                model.functions[cast[usize](function_index)].unknown = true
    for offset in range(0, node.child_count):
        collect_direct_effects(
            model,
            function_index,
            module_name,
            imports,
            arena,
            arena.children[node.first_child + offset],
            source,
            receiver_bindings,
            owner_name,
        )


def infer_function_effects(model: &ProjectLockModel) -> void:
    changed = true
    while changed:
        changed = false
        function_index: usize = 0
        while function_index < len(model.functions):
            callee_index: usize = 0
            while callee_index < len(model.functions[function_index].callees):
                name: &const String = &model.functions[function_index].callees[callee_index]
                target = find_function(model, name)
                if target < 0:
                    if not model.functions[function_index].unknown:
                        model.functions[function_index].unknown = true
                        changed = true
                else:
                    target_effect: &const FunctionLockEffect = &model.functions[cast[usize](target)]
                    for lock_index in target_effect.locks:
                        if append_i32_once(&model.functions[function_index].locks, lock_index):
                            changed = true
                    if target_effect.unknown and not model.functions[function_index].unknown:
                        model.functions[function_index].unknown = true
                        changed = true
                callee_index += 1
            function_index += 1


def infer_nested_edges(model: &ProjectLockModel, modules: &const List[project.ParsedModule]) -> void:
    for module in modules:
        if module.root.index < 0:
            continue
        module_arena: &const SyntaxArena = &module.arena
        root_node = module_arena.nodes[module.root.index]
        empty_owner = ""
        for offset in range(0, root_node.child_count):
            declaration_id = module_arena.children[root_node.first_child + offset]
            validate_lock_declaration(model, &module.name, &module.imports, module_arena, declaration_id, &module.source, &empty_owner)


def validate_lock_declaration(
    model: &ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    declaration_id: NodeId,
    source: &const String,
    owner_name: &const String,
) -> void:
    if declaration_id.index < 0:
        return
    declaration = arena.nodes[declaration_id.index]
    if declaration.kind == SyntaxKind.FUNCTION_DECL:
        held: List[i32] = []
        aliases: List[LockAlias] = []
        unstable_aliases = unstable_lock_alias_names(arena, declaration_id, source)
        for name in unstable_aliases:
            set_alias(aliases, name[0:len(name)], -1)
        receiver_bindings: List[MethodReceiverBinding] = []
        if len(owner_name) > 0:
            self_name = "self"
            set_method_receiver_binding(receiver_bindings, &self_name, module_name, owner_name)
        validate_lock_node(
            model,
            module_name,
            imports,
            arena,
            declaration_id,
            source,
            held,
            aliases,
            &unstable_aliases,
            false,
            receiver_bindings,
            owner_name,
        )
        return
    if declaration.kind == SyntaxKind.STRUCT_DECL or declaration.kind == SyntaxKind.CLASS_DECL:
        owner = source[declaration.value_start:declaration.value_start + declaration.value_length]
        for offset in range(0, declaration.child_count):
            child_id = arena.children[declaration.first_child + offset]
            if arena.nodes[child_id.index].kind == SyntaxKind.FUNCTION_DECL:
                validate_lock_declaration(model, module_name, imports, arena, child_id, source, &owner)


def unstable_lock_alias_names(arena: &const SyntaxArena, function_id: NodeId, source: &const String) -> List[String]:
    declared_names: List[String] = []
    collect_declared_names(arena, function_id, source, &declared_names)
    assignment_names: List[String] = []
    assignment_counts: List[i32] = []
    unstable_names: List[String] = []
    collect_unstable_alias_names(arena, function_id, source, false, &declared_names, &assignment_names, &assignment_counts, &unstable_names)
    return unstable_names


def collect_declared_names(arena: &const SyntaxArena, id: NodeId, source: &const String, result: &List[String]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        append_string_once(result, source[node.value_start:node.value_start + node.value_length])
    for offset in range(0, node.child_count):
        collect_declared_names(arena, arena.children[node.first_child + offset], source, result)


def collect_unstable_alias_names(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    conditional_context: bool,
    declared_names: &const List[String],
    assignment_names: &List[String],
    assignment_counts: &List[i32],
    result: &List[String],
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        name = source[node.value_start:node.value_start + node.value_length]
        if conditional_context:
            append_string_once(result, name)
    elif node.kind == SyntaxKind.ASSIGN_STMT:
        target = first_child(arena, id)
        if target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            name = source[target_node.value_start:target_node.value_start + target_node.value_length]
            count = increment_string_count(assignment_names, assignment_counts, &name)
            if conditional_context or contains_string(declared_names, &name) or count > 1:
                append_string_once(result, name)
    elif node.kind == SyntaxKind.EXPR_UNARY and node.flags == cast[i32](TokenKind.AMPERSAND):
        operand = first_child(arena, id)
        if operand.index >= 0 and arena.nodes[operand.index].kind == SyntaxKind.EXPR_NAME:
            operand_node = arena.nodes[operand.index]
            name = source[operand_node.value_start:operand_node.value_start + operand_node.value_length]
            append_string_once(result, name)
    nested_conditional = conditional_context or node.kind == SyntaxKind.IF_STMT or node.kind == SyntaxKind.IF_BRANCH or node.kind == SyntaxKind.WHILE_STMT or node.kind == SyntaxKind.FOR_EACH_STMT or node.kind == SyntaxKind.FOR_C_STMT or node.kind == SyntaxKind.MATCH_STMT or node.kind == SyntaxKind.MATCH_CASE
    for offset in range(0, node.child_count):
        collect_unstable_alias_names(arena, arena.children[node.first_child + offset], source, nested_conditional, declared_names, assignment_names, assignment_counts, result)


def validate_lock_node(
    model: &ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    held: &List[i32],
    aliases: &List[LockAlias],
    unstable_aliases: &const List[String],
    dynamic_held: bool,
    receiver_bindings: &List[MethodReceiverBinding],
    owner_name: &const String,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.BLOCK:
        binding_count = len(receiver_bindings)
        cleanup_classes: List[i32] = []
        cleanup_names: List[String] = []
        cleanup_nodes: List[NodeId] = []
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            cleanup_class = local_drop_class_from_statement(
                model,
                module_name,
                imports,
                arena,
                child_id,
                source,
                receiver_bindings,
            )
            if cleanup_class >= 0:
                cleanup_classes.append(cleanup_class)
                cleanup_names.append(local_statement_name(arena, child_id, source))
                cleanup_nodes.append(child_id)
            validate_lock_node(
                model,
                module_name,
                imports,
                arena,
                child_id,
                source,
                held,
                aliases,
                unstable_aliases,
                dynamic_held,
                receiver_bindings,
                owner_name,
            )
        cleanup_index = len(cleanup_classes)
        while cleanup_index > 0:
            cleanup_index -= 1
            if not node_moves_name(arena, id, source, &cleanup_names[cleanup_index]):
                visited: List[i32] = []
                validate_class_drop_effect(
                    model,
                    cleanup_classes[cleanup_index],
                    held,
                    dynamic_held,
                    &arena.nodes[cleanup_nodes[cleanup_index].index],
                    module_name,
                    visited,
                )
        while len(receiver_bindings) > binding_count:
            receiver_bindings.pop()
        return
    record_method_receiver_binding(module_name, imports, arena, id, source, receiver_bindings)
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        name = source[node.value_start:node.value_start + node.value_length]
        if contains_string(unstable_aliases, &name):
            set_alias(aliases, source[node.value_start:node.value_start + node.value_length], -1)
        else:
            initializer = last_child(arena, id)
            lock_index = resolve_lock_expression_with_aliases(model, module_name, imports, arena, initializer, source, aliases)
            if lock_index >= 0:
                set_alias(aliases, source[node.value_start:node.value_start + node.value_length], lock_index)
    elif node.kind == SyntaxKind.ASSIGN_STMT:
        target = first_child(arena, id)
        value = second_child(arena, id)
        if target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            name = source[target_node.value_start:target_node.value_start + target_node.value_length]
            if contains_string(unstable_aliases, &name):
                set_alias(aliases, source[target_node.value_start:target_node.value_start + target_node.value_length], -1)
            else:
                lock_index = resolve_lock_expression_with_aliases(model, module_name, imports, arena, value, source, aliases)
                set_alias(aliases, source[target_node.value_start:target_node.value_start + target_node.value_length], lock_index)
    if node.kind == SyntaxKind.CRITICAL_SECTION_STMT:
        expression = first_child(arena, id)
        lock_index = resolve_lock_expression_with_aliases(model, module_name, imports, arena, expression, source, aliases)
        body = find_child_kind(arena, id, SyntaxKind.BLOCK)
        if lock_index >= 0:
            if dynamic_held:
                add_diagnostic(
                    model,
                    module_name,
                    diagnostics.DiagnosticId.LOCK_415,
                    &arena.nodes[expression.index],
                )
            for current in held:
                if current == lock_index:
                    name: &const String = &model.locks[cast[usize](lock_index)].name
                    add_lock_name_diagnostic(
                        model,
                        module_name,
                        diagnostics.DiagnosticId.LOCK_411,
                        &arena.nodes[expression.index],
                        name,
                    )
                elif explicit_path_exists(model, lock_index, current):
                    name: &const String = &model.locks[cast[usize](lock_index)].name
                    held_name: &const String = &model.locks[cast[usize](current)].name
                    add_lock_pair_diagnostic(
                        model,
                        module_name,
                        &arena.nodes[expression.index],
                        name,
                        held_name,
                        lock_index,
                        current,
                    )
                else:
                    add_edge(model, current, lock_index, false, module_name, &arena.nodes[expression.index])
            held.append(lock_index)
            validate_lock_node(model, module_name, imports, arena, body, source, held, aliases, unstable_aliases, dynamic_held, receiver_bindings, owner_name)
            held.pop()
        else:
            if len(held) > 0 or dynamic_held:
                add_diagnostic(
                    model,
                    module_name,
                    diagnostics.DiagnosticId.LOCK_416,
                    &arena.nodes[expression.index],
                )
            validate_lock_node(model, module_name, imports, arena, body, source, held, aliases, unstable_aliases, true, receiver_bindings, owner_name)
        return
    if node.kind == SyntaxKind.EXPR_CALL and (len(held) > 0 or dynamic_held):
        callee = first_child(arena, id)
        resolution = resolve_call_lock_effect(model, module_name, imports, arena, callee, source, receiver_bindings, owner_name)
        function_index = find_function(model, &resolution.qualified_name)
        known_builtin = call_is_known_builtin(arena, callee, source)
        unknown = not known_builtin and not resolution.known and (len(resolution.qualified_name) == 0 or function_index < 0)
        if function_index >= 0:
            effect: &const FunctionLockEffect = &model.functions[cast[usize](function_index)]
            validate_lock_effect(model, &effect.locks, effect.unknown, held, dynamic_held, &node, module_name)
        elif unknown:
            no_locks: List[i32] = []
            validate_lock_effect(model, &no_locks, true, held, dynamic_held, &node, module_name)
    for offset in range(0, node.child_count):
        validate_lock_node(
            model,
            module_name,
            imports,
            arena,
            arena.children[node.first_child + offset],
            source,
            held,
            aliases,
            unstable_aliases,
            dynamic_held,
            receiver_bindings,
            owner_name,
        )


def assign_canonical_keys(model: &ProjectLockModel) -> void:
    count = len(model.locks)
    indegree: List[i32] = []
    assigned: List[bool] = []
    index: usize = 0
    while index < count:
        indegree.append(0)
        assigned.append(false)
        index += 1
    for edge in model.edges:
        if edge.after >= 0 and edge.after < cast[i32](count):
            indegree[cast[usize](edge.after)] += 1
    key: i32 = 0
    while key < cast[i32](count):
        selected: i32 = -1
        index = 0
        while index < count:
            if not assigned[index] and indegree[index] == 0:
                if selected < 0 or lock_name_less(&model.locks[index], &model.locks[cast[usize](selected)]):
                    selected = cast[i32](index)
            index += 1
        if selected < 0:
            if len(model.edges) > 0:
                edge: &const LockEdge = &model.edges[len(model.edges) - 1]
                before_name: &const String = &model.locks[cast[usize](edge.before)].name
                after_name: &const String = &model.locks[cast[usize](edge.after)].name
                add_cycle_diagnostic(model, edge, before_name, after_name)
            index = 0
            while index < count:
                if not assigned[index]:
                    model.locks[index].canonical_key = key
                    key += 1
                index += 1
            return
        assigned[cast[usize](selected)] = true
        model.locks[cast[usize](selected)].canonical_key = key
        for edge in model.edges:
            if edge.before == selected:
                indegree[cast[usize](edge.after)] -= 1
        key += 1


def resolve_lock_reference(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.child_count == 1:
        part = arena.nodes[arena.children[node.first_child].index]
        name = source[part.value_start:part.value_start + part.value_length]
        local = find_lock(model, module_name, &name)
        if local >= 0:
            return local
        for imported in imports:
            if len(imported.member) > 0 and imported.alias == name:
                return find_lock(model, &imported.module_name, &imported.member)
        return -1
    if node.child_count == 2:
        first = arena.nodes[arena.children[node.first_child].index]
        second = arena.nodes[arena.children[node.first_child + 1].index]
        alias = source[first.value_start:first.value_start + first.value_length]
        name = source[second.value_start:second.value_start + second.value_length]
        for imported in imports:
            if len(imported.member) == 0 and imported.alias == alias:
                return find_lock(model, &imported.module_name, &name)
        return -1
    return -1


def resolve_lock_expression(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    aliases: List[LockAlias] = []
    return resolve_lock_expression_with_aliases(model, module_name, imports, arena, id, source, aliases)


def resolve_lock_expression_with_aliases(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    aliases: &const List[LockAlias],
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        alias_index = find_alias(aliases, &name)
        if alias_index >= 0:
            return aliases[cast[usize](alias_index)].lock_index
        local = find_lock(model, module_name, &name)
        if local >= 0:
            return local
        for imported in imports:
            if len(imported.member) > 0 and imported.alias == name:
                return find_lock(model, &imported.module_name, &imported.member)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = first_child(arena, id)
        member = second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            for imported in imports:
                if len(imported.member) == 0 and imported.alias == alias:
                    return find_lock(model, &imported.module_name, &name)
    return -1


def missing_method_owner() -> MethodOwner:
    return MethodOwner(module_name="", name="")


def method_owner_for_name(
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    name: &const String,
) -> MethodOwner:
    for imported in imports:
        if len(imported.member) > 0 and imported.alias == name[0:len(name)]:
            return MethodOwner(
                module_name=imported.module_name[0:len(imported.module_name)],
                name=imported.member[0:len(imported.member)],
            )
    return MethodOwner(
        module_name=module_name[0:len(module_name)],
        name=name[0:len(name)],
    )


def method_owner_from_constructor(
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> MethodOwner:
    if id.index < 0:
        return missing_method_owner()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        return method_owner_for_name(module_name, imports, &name)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = first_child(arena, id)
        member = second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            for imported in imports:
                if len(imported.member) == 0 and imported.alias == alias:
                    return MethodOwner(
                        module_name=imported.module_name[0:len(imported.module_name)],
                        name=name,
                    )
    return missing_method_owner()


def lock_order_type_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        kind = arena.nodes[child_id.index].kind
        if lock_order_is_type_kind(kind):
            return child_id
    return syntax.missing_node()


def lock_order_is_type_kind(kind: SyntaxKind) -> bool:
    return kind == SyntaxKind.TYPE_NAME or kind == SyntaxKind.TYPE_GENERIC or kind == SyntaxKind.TYPE_CONST or kind == SyntaxKind.TYPE_POINTER or kind == SyntaxKind.TYPE_REFERENCE or kind == SyntaxKind.TYPE_ARRAY or kind == SyntaxKind.TYPE_SLICE or kind == SyntaxKind.TYPE_DYN or kind == SyntaxKind.TYPE_FUNCTION or kind == SyntaxKind.TYPE_CLOSURE


def method_owner_from_type(
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> MethodOwner:
    if id.index < 0:
        return missing_method_owner()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.TYPE_REFERENCE or node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_CONST or node.kind == SyntaxKind.TYPE_GENERIC:
        return method_owner_from_type(module_name, imports, arena, first_child(arena, id), source)
    if node.kind != SyntaxKind.TYPE_NAME:
        return missing_method_owner()
    if node.child_count > 1:
        receiver = first_child(arena, id)
        member = second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            for imported in imports:
                if len(imported.member) == 0 and imported.alias == alias:
                    return MethodOwner(
                        module_name=imported.module_name[0:len(imported.module_name)],
                        name=name,
                    )
        return missing_method_owner()
    name = source[node.value_start:node.value_start + node.value_length]
    return method_owner_for_name(module_name, imports, &name)


def find_method_receiver_binding(
    bindings: &const List[MethodReceiverBinding],
    name: &const String,
) -> i32:
    index = len(bindings)
    while index > 0:
        index -= 1
        if bindings[index].name == name[0:len(name)]:
            return cast[i32](index)
    return -1


def method_owner_from_expression(
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &const List[MethodReceiverBinding],
) -> MethodOwner:
    if id.index < 0:
        return missing_method_owner()
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_CALL:
        return method_owner_from_constructor(module_name, imports, arena, first_child(arena, id), source)
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        binding_index = find_method_receiver_binding(receiver_bindings, &name)
        if binding_index >= 0:
            binding: &const MethodReceiverBinding = &receiver_bindings[cast[usize](binding_index)]
            return MethodOwner(
                module_name=binding.module_name[0:len(binding.module_name)],
                name=binding.owner_name[0:len(binding.owner_name)],
            )
    if node.kind == SyntaxKind.EXPR_UNARY and (node.flags == cast[i32](TokenKind.AMPERSAND) or node.flags == cast[i32](TokenKind.STAR)):
        return method_owner_from_expression(module_name, imports, arena, first_child(arena, id), source, receiver_bindings)
    return missing_method_owner()


def set_method_receiver_binding(
    bindings: &List[MethodReceiverBinding],
    name: &const String,
    module_name: &const String,
    owner_name: &const String,
) -> void:
    if len(name) == 0 or len(module_name) == 0 or len(owner_name) == 0:
        return
    bindings.append(
        MethodReceiverBinding(
            name=name[0:len(name)],
            module_name=module_name[0:len(module_name)],
            owner_name=owner_name[0:len(owner_name)],
        )
    )


def record_method_receiver_binding(
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &List[MethodReceiverBinding],
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    name = ""
    owner = missing_method_owner()
    if node.kind == SyntaxKind.PARAMETER or node.kind == SyntaxKind.VAR_DECL_STMT:
        name = source[node.value_start:node.value_start + node.value_length]
        owner = method_owner_from_type(module_name, imports, arena, lock_order_type_child(arena, id), source)
        if len(owner.name) == 0 and node.kind == SyntaxKind.VAR_DECL_STMT:
            owner = method_owner_from_expression(module_name, imports, arena, last_child(arena, id), source, receiver_bindings)
    elif node.kind == SyntaxKind.ASSIGN_STMT:
        target = first_child(arena, id)
        if target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            name = source[target_node.value_start:target_node.value_start + target_node.value_length]
            owner = method_owner_from_expression(module_name, imports, arena, second_child(arena, id), source, receiver_bindings)
    if len(owner.name) > 0:
        set_method_receiver_binding(receiver_bindings, &name, &owner.module_name, &owner.name)


def resolve_callee_name(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &const List[MethodReceiverBinding],
) -> String:
    if id.index < 0:
        return ""
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        for imported in imports:
            if len(imported.member) > 0 and imported.alias == name:
                return qualified_name(&imported.module_name, &imported.member)
        return qualified_name(module_name, &name)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = first_child(arena, id)
        member = second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            binding_index = find_method_receiver_binding(receiver_bindings, &alias)
            if binding_index >= 0:
                binding: &const MethodReceiverBinding = &receiver_bindings[cast[usize](binding_index)]
                candidate = qualified_function_name(&binding.module_name, &binding.owner_name, &name)
                if find_function(model, &candidate) >= 0:
                    return candidate
                return ""
            for imported in imports:
                if len(imported.member) == 0 and imported.alias == alias:
                    return qualified_name(&imported.module_name, &name)
    return ""


def resolve_call_lock_effect(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &const List[MethodReceiverBinding],
    owner_name: &const String,
) -> CallLockResolution:
    if id.index < 0:
        return CallLockResolution(qualified_name="", known=false)
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = first_child(arena, id)
        member = second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0:
            member_node = arena.nodes[member.index]
            member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            if member_name == "__init__" and expression_is_super(arena, receiver, source) and len(owner_name) > 0:
                owner_index = find_class_lifecycle(model, module_name, owner_name)
                if owner_index >= 0:
                    base_index = model.classes[cast[usize](owner_index)].primary_base
                    if base_index >= 0:
                        return CallLockResolution(
                            qualified_name=class_constructor_effect_name(model, base_index),
                            known=true,
                        )
    constructor_owner = method_owner_from_constructor(module_name, imports, arena, id, source)
    constructor_class = find_class_lifecycle(model, &constructor_owner.module_name, &constructor_owner.name)
    if constructor_class >= 0:
        return CallLockResolution(
            qualified_name=class_constructor_effect_name(model, constructor_class),
            known=true,
        )
    return CallLockResolution(
        qualified_name=resolve_callee_name(model, module_name, imports, arena, id, source, receiver_bindings),
        known=false,
    )


def expression_is_super(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        return source[node.value_start:node.value_start + node.value_length] == "super"
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = first_child(arena, id)
    if callee.index < 0 or arena.nodes[callee.index].kind != SyntaxKind.EXPR_NAME:
        return false
    callee_node = arena.nodes[callee.index]
    return source[callee_node.value_start:callee_node.value_start + callee_node.value_length] == "super"


def class_constructor_effect_name(model: &const ProjectLockModel, class_index: i32) -> String:
    current = class_index
    visited: List[i32] = []
    while current >= 0 and current < cast[i32](len(model.classes)) and not contains_i32(&visited, current):
        visited.append(current)
        class_info: &const ClassLockLifecycle = &model.classes[cast[usize](current)]
        if class_info.has_explicit_init:
            init_name = "__init__"
            return qualified_function_name(&class_info.module_name, &class_info.name, &init_name)
        current = class_info.primary_base
    return ""


def append_class_drop_callees(
    model: &ProjectLockModel,
    function_index: i32,
    class_index: i32,
    visited: &List[i32],
) -> void:
    if class_index < 0 or class_index >= cast[i32](len(model.classes)) or contains_i32(visited, class_index):
        return
    visited.append(class_index)
    class_info: &const ClassLockLifecycle = &model.classes[cast[usize](class_index)]
    if class_info.has_explicit_del:
        del_name = "__del__"
        append_string_once(
            &model.functions[cast[usize](function_index)].callees,
            qualified_function_name(&class_info.module_name, &class_info.name, &del_name),
        )
    if class_info.primary_base >= 0:
        append_class_drop_callees(model, function_index, class_info.primary_base, visited)


def validate_class_drop_effect(
    model: &ProjectLockModel,
    class_index: i32,
    held: &List[i32],
    dynamic_held: bool,
    node: &const syntax.SyntaxNode,
    module_name: &const String,
    visited: &List[i32],
) -> void:
    if class_index < 0 or class_index >= cast[i32](len(model.classes)) or contains_i32(visited, class_index):
        return
    visited.append(class_index)
    class_info: &const ClassLockLifecycle = &model.classes[cast[usize](class_index)]
    if class_info.has_explicit_del:
        del_name = "__del__"
        qualified = qualified_function_name(&class_info.module_name, &class_info.name, &del_name)
        function_index = find_function(model, &qualified)
        if function_index >= 0:
            effect: &const FunctionLockEffect = &model.functions[cast[usize](function_index)]
            validate_lock_effect(model, &effect.locks, effect.unknown, held, dynamic_held, node, module_name)
        else:
            no_locks: List[i32] = []
            validate_lock_effect(model, &no_locks, true, held, dynamic_held, node, module_name)
    if class_info.primary_base >= 0:
        validate_class_drop_effect(model, class_info.primary_base, held, dynamic_held, node, module_name, visited)


def validate_lock_effect(
    model: &ProjectLockModel,
    locks: &const List[i32],
    unknown: bool,
    held: &List[i32],
    dynamic_held: bool,
    node: &const syntax.SyntaxNode,
    module_name: &const String,
) -> void:
    if unknown and (len(held) > 0 or dynamic_held):
        add_diagnostic(model, module_name, diagnostics.DiagnosticId.LOCK_413, node)
    if dynamic_held and len(locks) > 0:
        add_diagnostic(model, module_name, diagnostics.DiagnosticId.LOCK_414, node)
        return
    if dynamic_held:
        return
    for lock_index in locks:
        for current in held:
            if current == lock_index:
                name: &const String = &model.locks[cast[usize](lock_index)].name
                add_lock_name_diagnostic(
                    model,
                    module_name,
                    diagnostics.DiagnosticId.LOCK_411,
                    node,
                    name,
                )
            elif explicit_path_exists(model, lock_index, current):
                name: &const String = &model.locks[cast[usize](lock_index)].name
                held_name: &const String = &model.locks[cast[usize](current)].name
                add_lock_pair_diagnostic(
                    model,
                    module_name,
                    node,
                    name,
                    held_name,
                    lock_index,
                    current,
                )
            else:
                add_edge(model, current, lock_index, false, module_name, node)


def local_drop_class_from_statement(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    receiver_bindings: &const List[MethodReceiverBinding],
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        class_index = drop_class_index_from_type(model, module_name, imports, arena, lock_order_type_child(arena, id), source)
        if class_index >= 0:
            return class_index
        return drop_class_index_from_expression(model, module_name, imports, arena, last_child(arena, id), source)
    if node.kind != SyntaxKind.ASSIGN_STMT or node.flags != cast[i32](TokenKind.ASSIGN):
        return -1
    target = first_child(arena, id)
    if target.index < 0 or arena.nodes[target.index].kind != SyntaxKind.EXPR_NAME:
        return -1
    target_node = arena.nodes[target.index]
    name = source[target_node.value_start:target_node.value_start + target_node.value_length]
    if find_method_receiver_binding(receiver_bindings, &name) >= 0:
        return -1
    return drop_class_index_from_expression(model, module_name, imports, arena, second_child(arena, id), source)


def local_statement_name(arena: &const SyntaxArena, id: NodeId, source: &const String) -> String:
    if id.index < 0:
        return ""
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        return source[node.value_start:node.value_start + node.value_length]
    if node.kind == SyntaxKind.ASSIGN_STMT:
        target = first_child(arena, id)
        if target.index >= 0 and arena.nodes[target.index].kind == SyntaxKind.EXPR_NAME:
            target_node = arena.nodes[target.index]
            return source[target_node.value_start:target_node.value_start + target_node.value_length]
    return ""


def drop_class_index_from_type(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    if id.index < 0:
        return -1
    kind = arena.nodes[id.index].kind
    if kind == SyntaxKind.TYPE_CONST:
        return drop_class_index_from_type(model, module_name, imports, arena, first_child(arena, id), source)
    if kind != SyntaxKind.TYPE_NAME and kind != SyntaxKind.TYPE_GENERIC:
        return -1
    return class_index_from_type(model, module_name, imports, arena, id, source)


def drop_class_index_from_expression(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_CALL:
        return -1
    owner = method_owner_from_constructor(module_name, imports, arena, first_child(arena, id), source)
    return find_class_lifecycle(model, &owner.module_name, &owner.name)


def node_moves_name(arena: &const SyntaxArena, id: NodeId, source: &const String, name: &const String) -> bool:
    if id.index < 0 or len(name) == 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.RETURN_STMT and expression_contains_name(arena, first_child(arena, id), source, name):
        return true
    for offset in range(0, node.child_count):
        if node_moves_name(arena, arena.children[node.first_child + offset], source, name):
            return true
    return false


def expression_contains_name(arena: &const SyntaxArena, id: NodeId, source: &const String, name: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME and source[node.value_start:node.value_start + node.value_length] == name[0:len(name)]:
        return true
    for offset in range(0, node.child_count):
        if expression_contains_name(arena, arena.children[node.first_child + offset], source, name):
            return true
    return false


def call_is_known_builtin(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0 or arena.nodes[id.index].kind != SyntaxKind.EXPR_NAME:
        return false
    node = arena.nodes[id.index]
    name = source[node.value_start:node.value_start + node.value_length]
    return name == "print" or name == "len" or name == "range" or name == "sort" or name == "sorted" or name == "input" or name == "to_string" or name == "set" or name == "free" or name == "panic" or name == "String" or name == "StringBuilder" or name == "Some" or name == "Owned" or name == "Ok" or name == "Err" or name == "cast" or name == "alloc" or name == "closure" or name == "super"


def add_edge(
    model: &ProjectLockModel,
    before: i32,
    after: i32,
    explicit: bool,
    module_name: &const String,
    node: &const syntax.SyntaxNode,
) -> void:
    empty_path = ""
    add_edge_with_path(model, before, after, explicit, module_name, &empty_path, node)


def add_explicit_edge(
    model: &ProjectLockModel,
    before: i32,
    after: i32,
    module_name: &const String,
    source_path: &const String,
    node: &const syntax.SyntaxNode,
) -> void:
    add_edge_with_path(model, before, after, true, module_name, source_path, node)


def add_edge_with_path(
    model: &ProjectLockModel,
    before: i32,
    after: i32,
    explicit: bool,
    module_name: &const String,
    source_path: &const String,
    node: &const syntax.SyntaxNode,
) -> void:
    edge_index: usize = 0
    while edge_index < len(model.edges):
        if model.edges[edge_index].before == before and model.edges[edge_index].after == after:
            if explicit and not model.edges[edge_index].explicit:
                model.edges[edge_index].explicit = true
                model.edges[edge_index].module_name = module_name[0:len(module_name)]
                model.edges[edge_index].source_path = source_path[0:len(source_path)]
                model.edges[edge_index].start = node.start
                model.edges[edge_index].length = node.length
                model.edges[edge_index].line = node.line
                model.edges[edge_index].column = node.column
            return
        edge_index += 1
    model.edges.append(
        LockEdge(
            before=before,
            after=after,
            explicit=explicit,
            module_name=module_name[0:len(module_name)],
            source_path=source_path[0:len(source_path)],
            start=node.start,
            length=node.length,
            line=node.line,
            column=node.column,
        )
    )


def explicit_path_exists(model: &const ProjectLockModel, start: i32, target: i32) -> bool:
    pending: List[i32] = [start]
    visited: List[i32] = []
    while len(pending) > 0:
        current = pending[len(pending) - 1]
        pending.pop()
        if current == target:
            return true
        if contains_i32(&visited, current):
            continue
        visited.append(current)
        edge_index: usize = 0
        while edge_index < len(model.edges):
            if model.edges[edge_index].explicit and model.edges[edge_index].before == current:
                pending.append(model.edges[edge_index].after)
            edge_index += 1
    return false


def add_diagnostic(
    model: &ProjectLockModel,
    module_name: &const String,
    id: diagnostics.DiagnosticId,
    node: &const syntax.SyntaxNode,
) -> void:
    diagnostic = diagnostics.new_diagnostic(id, diagnostic_span(node))
    add_raw_diagnostic(model, module_name, diagnostic)


def add_lock_name_diagnostic(
    model: &ProjectLockModel,
    module_name: &const String,
    id: diagnostics.DiagnosticId,
    node: &const syntax.SyntaxNode,
    name: &const String,
) -> void:
    diagnostic = diagnostics.diagnostic_with_argument(
        id,
        diagnostic_span(node),
        diagnostics.argument_symbol("lock", name[0:len(name)]),
    )
    add_raw_diagnostic(model, module_name, diagnostic)


def add_lock_pair_diagnostic(
    model: &ProjectLockModel,
    module_name: &const String,
    node: &const syntax.SyntaxNode,
    lock_name: &const String,
    held_name: &const String,
    lock_index: i32,
    held_index: i32,
) -> void:
    diagnostic = diagnostics.diagnostic_with_arguments(
        diagnostics.DiagnosticId.LOCK_412,
        diagnostic_span(node),
        diagnostics.argument_symbol("lock", lock_name[0:len(lock_name)]),
        diagnostics.argument_symbol("held", held_name[0:len(held_name)]),
    )
    add_explicit_order_related(model, &diagnostic, lock_index, held_index)
    add_raw_diagnostic(model, module_name, diagnostic)


def add_cycle_diagnostic(
    model: &ProjectLockModel,
    edge: &const LockEdge,
    before_name: &const String,
    after_name: &const String,
) -> void:
    diagnostic = diagnostics.diagnostic_with_arguments(
        diagnostics.DiagnosticId.LOCK_410,
        diagnostics.source_span(edge.start, edge.length, edge.line, edge.column),
        diagnostics.argument_symbol("before", before_name[0:len(before_name)]),
        diagnostics.argument_symbol("after", after_name[0:len(after_name)]),
    )
    add_explicit_order_related(model, &diagnostic, edge.after, edge.before)
    add_raw_diagnostic(model, &edge.module_name, diagnostic)


def add_explicit_order_related(
    model: &const ProjectLockModel,
    diagnostic: &diagnostics.Diagnostic,
    before: i32,
    after: i32,
) -> void:
    for edge in model.edges:
        if edge.explicit and edge.before == before and edge.after == after:
            diagnostic.add_related(
                diagnostics.related_span(
                    "conflicting lock order declared here",
                    diagnostics.source_span_in(
                        edge.source_path[0:len(edge.source_path)],
                        edge.start,
                        edge.length,
                        edge.line,
                        edge.column,
                    ),
                )
            )
            return


def add_raw_diagnostic(
    model: &ProjectLockModel,
    module_name: &const String,
    diagnostic: diagnostics.Diagnostic,
) -> void:
    index: usize = 0
    while index < len(model.diagnostic_values):
        if (
            model.diagnostic_modules[index] == module_name[0:len(module_name)]
            and diagnostics.diagnostic_matches_at(
                &model.diagnostic_values,
                index,
                diagnostic.id,
                diagnostic.primary.start,
            )
        ):
            return
        index += 1
    model.diagnostic_modules.append(module_name[0:len(module_name)])
    model.diagnostic_values.append(
        diagnostic
    )


def diagnostic_span(node: &const syntax.SyntaxNode) -> diagnostics.SourceSpan:
    return diagnostics.source_span(node.start, node.length, node.line, node.column)


def find_lock(model: &const ProjectLockModel, module_name: &const String, name: &const String) -> i32:
    index: usize = 0
    while index < len(model.locks):
        if model.locks[index].module_name == module_name[0:len(module_name)] and model.locks[index].name == name[0:len(name)]:
            return cast[i32](index)
        index += 1
    return -1


def find_function(model: &const ProjectLockModel, qualified: &const String) -> i32:
    if len(qualified) == 0:
        return -1
    index: usize = 0
    while index < len(model.functions):
        if model.functions[index].qualified_name == qualified[0:len(qualified)]:
            return cast[i32](index)
        index += 1
    return -1


def find_class_lifecycle(model: &const ProjectLockModel, module_name: &const String, name: &const String) -> i32:
    if len(module_name) == 0 or len(name) == 0:
        return -1
    index: usize = 0
    while index < len(model.classes):
        class_info: &const ClassLockLifecycle = &model.classes[index]
        if class_info.module_name == module_name[0:len(module_name)] and class_info.name == name[0:len(name)]:
            return cast[i32](index)
        index += 1
    return -1


def class_index_from_type(
    model: &const ProjectLockModel,
    module_name: &const String,
    imports: &const List[project.ImportBinding],
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
) -> i32:
    owner = method_owner_from_type(module_name, imports, arena, id, source)
    return find_class_lifecycle(model, &owner.module_name, &owner.name)


def qualified_name(module_name: &const String, name: &const String) -> String:
    return module_name[0:len(module_name)] + "::" + name[0:len(name)]


def qualified_function_name(module_name: &const String, owner_name: &const String, name: &const String) -> String:
    if len(owner_name) > 0:
        return module_name[0:len(module_name)] + "::" + owner_name[0:len(owner_name)] + "::" + name[0:len(name)]
    return qualified_name(module_name, name)


def first_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    if id.index < 0 or arena.nodes[id.index].child_count < 1:
        return syntax.missing_node()
    return arena.children[arena.nodes[id.index].first_child]


def second_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    if id.index < 0 or arena.nodes[id.index].child_count < 2:
        return syntax.missing_node()
    return arena.children[arena.nodes[id.index].first_child + 1]


def last_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    if id.index < 0 or arena.nodes[id.index].child_count < 1:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    return arena.children[node.first_child + node.child_count - 1]


def find_child_kind(arena: &const SyntaxArena, id: NodeId, kind: SyntaxKind) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind == kind:
            return child_id
    return syntax.missing_node()


def find_alias(aliases: &const List[LockAlias], name: &const String) -> i32:
    index = len(aliases)
    while index > 0:
        index -= 1
        if aliases[index].name == name[0:len(name)]:
            return cast[i32](index)
    return -1


def set_alias(aliases: &List[LockAlias], name: String, lock_index: i32) -> void:
    index = find_alias(aliases, &name)
    if index >= 0:
        aliases[cast[usize](index)].lock_index = lock_index
        return
    aliases.append(LockAlias(name=name, lock_index=lock_index))


def append_i32_once(values: &List[i32], value: i32) -> bool:
    if contains_i32(values, value):
        return false
    values.append(value)
    return true


def contains_i32(values: &const List[i32], value: i32) -> bool:
    for item in values:
        if item == value:
            return true
    return false


def contains_string(values: &const List[String], value: &const String) -> bool:
    for item in values:
        if item == value[0:len(value)]:
            return true
    return false


def increment_string_count(names: &List[String], counts: &List[i32], name: &const String) -> i32:
    index: usize = 0
    while index < len(names):
        if names[index] == name[0:len(name)]:
            counts[index] += 1
            return counts[index]
        index += 1
    names.append(name[0:len(name)])
    counts.append(1)
    return 1


def append_string_once(values: &List[String], value: String) -> void:
    for item in values:
        if item == value:
            return
    values.append(value)


def lock_name_less(left: &const ProjectLock, right: &const ProjectLock) -> bool:
    left_name = left.module_name[0:len(left.module_name)] + "::" + left.name[0:len(left.name)]
    right_name = right.module_name[0:len(right.module_name)] + "::" + right.name[0:len(right.name)]
    return left_name < right_name
