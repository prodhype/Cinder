import backend_ir
import codegen_names
import codegen_type_names
import project
import syntax
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


enum ManagedHashKind:
    UNSUPPORTED
    SCALAR
    STRING
    C_STRING


enum PrintValueKind:
    UNSUPPORTED
    BOOL
    CHAR
    STRING
    C_STRING
    SIGNED_INTEGER
    UNSIGNED_INTEGER
    FLOAT
    COLLECTION


struct PrintTypeInfo:
    kind: PrintValueKind
    helper: String


struct ManagedTypeInfo:
    c_type: String
    token: String
    helper: String
    is_string: bool
    is_c_string: bool
    is_complete: bool
    hash_kind: ManagedHashKind


def collect_module_specialization_names(
    registry: &codegen_names.SpecializationNameRegistry,
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.ENUM_DECL:
        enum_builder = StringBuilder()
        codegen_names.emit_prefixed_name(&enum_builder, prefix, source, node.value_start, node.value_length)
        codegen_names.record_enum_name(registry, enum_builder.finish())
    for offset in range(0, node.child_count):
        collect_module_specialization_names(registry, arena, arena.children[node.first_child + offset], source, prefix, project_name, imports)
    if node.kind == SyntaxKind.TYPE_CLOSURE:
        canonical_builder = StringBuilder()
        codegen_type_names.emit_canonical_specialized_type_name(arena, id, source, &canonical_builder, prefix, project_name, imports)
        readable_builder = StringBuilder()
        codegen_type_names.emit_readable_specialized_type_name(arena, id, source, &readable_builder)
        codegen_names.record_specialization_name(registry, canonical_builder.finish(), readable_builder.finish())
        return
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return
    base = codegen_names.first_child(arena, id)
    if base.index < 0:
        return
    base_node = arena.nodes[base.index]
    if not is_runtime_specialization_name(source, base_node):
        return
    canonical_builder = StringBuilder()
    codegen_type_names.emit_canonical_specialized_type_name(arena, id, source, &canonical_builder, prefix, project_name, imports)
    readable_builder = StringBuilder()
    codegen_type_names.emit_readable_specialized_type_name(arena, id, source, &readable_builder)
    codegen_names.record_specialization_name(registry, canonical_builder.finish(), readable_builder.finish())

def is_runtime_specialization_name(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    return codegen_type_names.is_runtime_generic_name(source, node, "List") or codegen_type_names.is_runtime_generic_name(source, node, "Set") or codegen_type_names.is_runtime_generic_name(source, node, "Map") or codegen_type_names.is_runtime_generic_name(source, node, "MapKeys") or codegen_type_names.is_runtime_generic_name(source, node, "MapValues") or codegen_type_names.is_runtime_generic_name(source, node, "MapItems") or codegen_type_names.is_runtime_generic_name(source, node, "Option") or codegen_type_names.is_runtime_generic_name(source, node, "Result") or codegen_type_names.is_runtime_generic_name(source, node, "Owned") or codegen_type_names.is_runtime_generic_name(source, node, "Tuple")

def emit_semantic_type_specializations(
    table: &const types.TypeTable,
    specializations: &const List[types.TypeId],
    semantic_nodes: &const List[backend_ir.IRNode],
    arena: &const SyntaxArena,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    emitted: List[String] = []
    for type_id in specializations:
        if codegen_type_names.semantic_type_is_kind(table, type_id, types.TypeKind.CLOSURE) or semantic_specialization_is_inferred_expression(semantic_nodes, arena, type_id):
            emit_semantic_type_specialization(table, type_id, source, builder, emitted, prefix, project_name, imports, registry)
    emitted_print_prototypes: List[String] = []
    for type_id in specializations:
        if semantic_specialization_is_inferred_expression(semantic_nodes, arena, type_id):
            emit_semantic_collection_print_helpers(table, type_id, source, builder, emitted_print_prototypes, registry, false)
    emitted_print_helpers: List[String] = []
    for type_id in specializations:
        if semantic_specialization_is_inferred_expression(semantic_nodes, arena, type_id):
            emit_semantic_collection_print_helpers(table, type_id, source, builder, emitted_print_helpers, registry, true)

def semantic_specialization_is_inferred_expression(
    semantic_nodes: &const List[backend_ir.IRNode],
    arena: &const SyntaxArena,
    type_id: types.TypeId,
) -> bool:
    for node in semantic_nodes:
        if node.type_id.index == type_id.index and node.syntax.index >= 0:
            kind = arena.nodes[node.syntax.index].kind
            if kind == SyntaxKind.EXPR_LIST or kind == SyntaxKind.EXPR_MAP or kind == SyntaxKind.EXPR_SET or kind == SyntaxKind.EXPR_TUPLE or kind == SyntaxKind.NAME:
                return true
    return false

def emit_semantic_type_specialization(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return
    record = table.types[type_id.index]
    if (
        record.kind != types.TypeKind.LIST
        and record.kind != types.TypeKind.MAP
        and record.kind != types.TypeKind.SET
        and not types.is_map_view_kind(record.kind)
        and record.kind != types.TypeKind.TUPLE
        and record.kind != types.TypeKind.CLOSURE
    ):
        return
    if record.kind == types.TypeKind.CLOSURE:
        emit_semantic_type_specialization(table, record.second, source, builder, emitted, prefix, project_name, imports, registry)
        closure_offset: i32 = 0
        while closure_offset < record.flags:
            emit_semantic_type_specialization(table, table.type_args[cast[usize](record.extra + closure_offset)], source, builder, emitted, prefix, project_name, imports, registry)
            closure_offset += 1
        emit_semantic_type_specialization(table, record.inner, source, builder, emitted, prefix, project_name, imports, registry)
    elif record.kind == types.TypeKind.TUPLE:
        tuple_offset: i32 = 0
        while tuple_offset < record.flags:
            element_type = table.type_args[cast[usize](record.extra + tuple_offset)]
            if codegen_type_names.semantic_type_is_kind(table, element_type, types.TypeKind.ERROR):
                return
            emit_semantic_type_specialization(table, element_type, source, builder, emitted, prefix, project_name, imports, registry)
            tuple_offset += 1
    else:
        if codegen_type_names.semantic_type_is_kind(table, record.inner, types.TypeKind.ERROR):
            return
        emit_semantic_type_specialization(table, record.inner, source, builder, emitted, prefix, project_name, imports, registry)
        if record.kind == types.TypeKind.MAP:
            if codegen_type_names.semantic_type_is_kind(table, record.second, types.TypeKind.ERROR):
                return
            emit_semantic_type_specialization(table, record.second, source, builder, emitted, prefix, project_name, imports, registry)
    name_builder = StringBuilder()
    codegen_type_names.emit_semantic_specialized_type_name(table, type_id, source, &name_builder, registry)
    name = name_builder.finish()
    if codegen_type_names.string_list_contains(emitted, &name):
        return
    emitted.append(name[0:len(name)])
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\ntypedef struct ")
    builder.append(name[0:len(name)])
    builder.append(" ")
    builder.append(name[0:len(name)])
    builder.append(";\n#endif\n")
    builder.append("#ifndef CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n")
    if record.kind == types.TypeKind.CLOSURE:
        emit_semantic_closure_specialization(table, type_id, source, builder, &name, prefix, project_name, imports, registry)
    elif record.kind == types.TypeKind.LIST:
        emit_semantic_list_specialization(table, record.inner, source, builder, &name, prefix, project_name, imports, registry)
    elif record.kind == types.TypeKind.MAP:
        emit_semantic_map_specialization(table, record.inner, record.second, source, builder, &name, prefix, project_name, imports, registry)
    elif types.is_map_view_kind(record.kind):
        emit_semantic_map_view_specialization(table, record.inner, source, builder, &name, registry)
    elif record.kind == types.TypeKind.TUPLE:
        emit_semantic_tuple_specialization(table, type_id, source, builder, &name, prefix, project_name, imports, registry)
    else:
        emit_semantic_set_specialization(table, record.inner, source, builder, &name, prefix, project_name, imports, registry)
    builder.append("#endif\n")


def emit_semantic_closure_specialization(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    record = table.types[type_id.index]
    environment_type = record.second
    value_environment_type = environment_type
    if codegen_type_names.semantic_type_is_kind(table, value_environment_type, types.TypeKind.CONST):
        value_environment_type = table.types[value_environment_type.index].inner
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    codegen_type_names.emit_semantic_c_type(table, value_environment_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" env;\n    ")
    codegen_type_names.emit_semantic_c_type(table, record.inner, source, builder, prefix, project_name, imports, registry)
    builder.append(" (*call)(")
    codegen_type_names.emit_semantic_c_type(table, environment_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" *")
    offset: i32 = 0
    while offset < record.flags:
        builder.append(", ")
        parameter_type = table.type_args[cast[usize](record.extra + offset)]
        codegen_type_names.emit_semantic_c_type(table, parameter_type, source, builder, prefix, project_name, imports, registry)
        offset += 1
    builder.append(");\n};\n")


def emit_semantic_array_pointer_data_declarator(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    base_type = type_id
    while codegen_type_names.semantic_type_is_kind(table, base_type, types.TypeKind.ARRAY):
        base_type = table.types[base_type.index].inner
    codegen_type_names.emit_semantic_c_type(table, base_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" (*data)")
    current = type_id
    while codegen_type_names.semantic_type_is_kind(table, current, types.TypeKind.ARRAY):
        builder.append("[")
        codegen_type_names.append_specialization_decimal(builder, cast[usize](table.types[current.index].extra))
        builder.append("]")
        current = table.types[current.index].inner

def emit_module_type_specialization_forwards(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_module_type_specialization_forwards(arena, arena.children[node.first_child + offset], source, builder, emitted, prefix, project_name, imports, registry)
    if node.kind != SyntaxKind.TYPE_CLOSURE:
        if node.kind != SyntaxKind.TYPE_GENERIC:
            return
        base = codegen_names.first_child(arena, id)
        if base.index < 0 or not is_runtime_specialization_name(source, arena.nodes[base.index]):
            return
    name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(arena, id, source, &name_builder, prefix, project_name, imports, registry)
    name = name_builder.finish()
    if codegen_type_names.string_list_contains(emitted, &name):
        return
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\ntypedef struct ")
    builder.append(name[0:len(name)])
    builder.append(" ")
    builder.append(name[0:len(name)])
    builder.append(";\n#endif\n")
    emitted.append(name)

def emit_module_type_specializations(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    result_only: bool,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_module_type_specializations(arena, arena.children[node.first_child + offset], source, builder, emitted, prefix, project_name, imports, registry, result_only)
    is_closure = node.kind == SyntaxKind.TYPE_CLOSURE
    is_list = false
    is_set = false
    is_map = false
    is_map_view = false
    is_owned = false
    is_option = false
    is_tuple = false
    is_result = false
    if not is_closure:
        if node.kind != SyntaxKind.TYPE_GENERIC:
            return
        base = codegen_names.first_child(arena, id)
        if base.index < 0:
            return
        base_node = arena.nodes[base.index]
        is_list = codegen_type_names.is_runtime_generic_name(source, &base_node, "List")
        is_set = codegen_type_names.is_runtime_generic_name(source, &base_node, "Set")
        is_map = codegen_type_names.is_runtime_generic_name(source, &base_node, "Map")
        is_map_view = codegen_type_names.is_runtime_generic_name(source, &base_node, "MapKeys") or codegen_type_names.is_runtime_generic_name(source, &base_node, "MapValues") or codegen_type_names.is_runtime_generic_name(source, &base_node, "MapItems")
        is_owned = codegen_type_names.is_runtime_generic_name(source, &base_node, "Owned")
        is_option = codegen_type_names.is_runtime_generic_name(source, &base_node, "Option")
        is_tuple = codegen_type_names.is_runtime_generic_name(source, &base_node, "Tuple")
        is_result = codegen_type_names.is_runtime_generic_name(source, &base_node, "Result")
        if not is_list and not is_set and not is_map and not is_map_view and not is_option and not is_result and not is_owned and not is_tuple:
            return
    name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(arena, id, source, &name_builder, prefix, project_name, imports, registry)
    name = name_builder.finish()
    is_late = is_result or is_closure
    if is_map or is_set:
        phase_builder = StringBuilder()
        phase_builder.append(name[0:len(name)])
        if result_only:
            phase_builder.append("_helpers")
        else:
            phase_builder.append("_layout")
        phase_name = phase_builder.finish()
        if codegen_type_names.string_list_contains(emitted, &phase_name):
            return
        if result_only:
            builder.append("#ifndef CINDER_COLLECTION_HELPERS_")
            builder.append(name[0:len(name)])
            builder.append("\n#define CINDER_COLLECTION_HELPERS_")
            builder.append(name[0:len(name)])
            builder.append("\n")
            if is_map:
                emit_module_map_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
            else:
                emit_module_set_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
            builder.append("#endif\n")
        else:
            builder.append("#ifndef CINDER_SPECIALIZED_")
            builder.append(name[0:len(name)])
            builder.append("\n#define CINDER_SPECIALIZED_")
            builder.append(name[0:len(name)])
            builder.append("\n")
            if is_map:
                emit_map_specialization_layout(builder, &name)
            else:
                emit_set_specialization_layout(builder, &name)
            builder.append("#endif\n")
        emitted.append(phase_name)
        return
    if result_only != is_late:
        return
    if codegen_type_names.string_list_contains(emitted, &name):
        return
    builder.append("#ifndef CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n")
    if is_closure:
        emit_module_closure_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    elif is_result:
        emit_module_result_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    elif is_list:
        emit_module_list_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    elif is_option:
        emit_module_option_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    elif is_tuple:
        emit_module_tuple_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    elif is_map_view:
        emit_module_map_view_specialization(arena, id, source, builder, &name)
    else:
        emit_module_owned_specialization(arena, id, source, builder, &name, prefix, project_name, imports, registry)
    builder.append("#endif\n")
    emitted.append(name)


def emit_module_closure_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        builder.append("struct ")
        builder.append(name[0:len(name)])
        builder.append(" { int32_t _cinder_invalid; };\n")
        return
    environment_type = arena.children[node.first_child]
    value_environment_type = environment_type
    if codegen_type_names.type_node_kind(arena, value_environment_type) == SyntaxKind.TYPE_CONST:
        value_environment_type = codegen_names.first_child(arena, value_environment_type)
    parameter_end = node.child_count
    return_type = syntax.missing_node()
    if codegen_type_names.callable_type_has_return(source, &node):
        parameter_end -= 1
        return_type = arena.children[node.first_child + parameter_end]
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    codegen_type_names.emit_module_c_type(arena, value_environment_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" env;\n    ")
    if return_type.index >= 0:
        codegen_type_names.emit_module_c_type(arena, return_type, source, builder, prefix, project_name, imports, registry)
    else:
        builder.append("void")
    builder.append(" (*call)(")
    codegen_type_names.emit_module_c_type(arena, environment_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" *")
    offset: i32 = 1
    while offset < parameter_end:
        builder.append(", ")
        codegen_type_names.emit_module_c_type(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, registry)
        offset += 1
    builder.append(");\n};\n")


def emit_module_list_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    if node.child_count > 1:
        element = arena.children[node.first_child + 1]
        if context_type_is_array(arena, element):
            emit_module_array_pointer_data_declarator(arena, element, source, builder, prefix, project_name, imports, registry)
            builder.append(";\n")
        elif specialization_type_has_simple_declarator(arena, element):
            codegen_type_names.emit_module_c_type(arena, element, source, builder, prefix, project_name, imports, registry)
            builder.append(" *data;\n")
        else:
            builder.append("void *data;\n")
    else:
        builder.append("void *data;\n")
    builder.append("    size_t length;\n    size_t capacity;\n};\n")
    if node.child_count > 1:
        element = arena.children[node.first_child + 1]
        element_info = module_managed_type_info(arena, element, source, prefix, project_name, imports, registry)
        if element_info.is_complete:
            emit_list_helper_suite(builder, name, &element_info)

def emit_module_array_pointer_data_declarator(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    base_type = type_id
    while base_type.index >= 0 and context_type_is_array(arena, base_type):
        base_type = codegen_names.first_child(arena, base_type)
    codegen_type_names.emit_module_c_type(arena, base_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" (*data)")
    current = type_id
    while current.index >= 0 and context_type_is_array(arena, current):
        builder.append("[")
        append_node_numeric_literal(builder, arena, source, array_length_node(arena, current))
        builder.append("]")
        current = codegen_names.first_child(arena, current)

def emit_module_set_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count <= 1:
        builder.append("struct ")
        builder.append(name[0:len(name)])
        builder.append(" { int32_t _cinder_invalid; };\n")
        return
    element = arena.children[node.first_child + 1]
    element_info = module_managed_type_info(arena, element, source, prefix, project_name, imports, registry)
    emit_set_specialization_body(builder, name, &element_info)

def emit_module_map_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count <= 2:
        builder.append("struct ")
        builder.append(name[0:len(name)])
        builder.append(" { int32_t _cinder_invalid; };\n")
        return
    key = arena.children[node.first_child + 1]
    value = arena.children[node.first_child + 2]
    key_info = module_managed_type_info(arena, key, source, prefix, project_name, imports, registry)
    value_info = module_managed_type_info(arena, value, source, prefix, project_name, imports, registry)
    emit_map_specialization_body(builder, name, &key_info, &value_info)

def emit_module_option_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    value_info = ManagedTypeInfo(
        c_type=String(),
        token=String(),
        helper=String(),
        is_string=false,
        is_c_string=false,
        is_complete=false,
        hash_kind=ManagedHashKind.UNSUPPORTED,
    )
    builder.append("typedef enum ")
    builder.append(name[0:len(name)])
    builder.append("_Tag {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_None = 0,\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Some = 1\n} ")
    builder.append(name[0:len(name)])
    builder.append("_Tag;\nstruct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag tag;\n    union {\n        unsigned char _cinder_empty;\n")
    if node.child_count > 1:
        value_type = arena.children[node.first_child + 1]
        value_info = module_managed_type_info(arena, value_type, source, prefix, project_name, imports, registry)
        if not codegen_type_names.context_type_name_equals(arena, value_type, source, "void"):
            builder.append("        ")
            codegen_type_names.emit_module_c_type(arena, value_type, source, builder, prefix, project_name, imports, registry)
            builder.append(" value;\n")
    builder.append("    } data;\n};\n")
    if node.child_count > 1:
        emit_option_drop_helper(builder, name, &value_info)

def emit_module_tuple_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n")
    if node.child_count <= 1:
        builder.append("    unsigned char _cinder_empty;\n")
    offset: i32 = 1
    while offset < node.child_count:
        builder.append("    ")
        codegen_type_names.emit_module_c_type(arena, arena.children[node.first_child + offset], source, builder, prefix, project_name, imports, registry)
        builder.append(" item_")
        codegen_type_names.append_specialization_decimal(builder, cast[usize](offset - 1))
        builder.append(";\n")
        offset += 1
    builder.append("};\n")

def emit_module_owned_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    if node.child_count > 1:
        codegen_type_names.emit_module_c_type(arena, arena.children[node.first_child + 1], source, builder, prefix, project_name, imports, registry)
    else:
        builder.append("void")
    builder.append(" *ptr;\n};\n")

def specialization_type_has_simple_declarator(arena: &const SyntaxArena, id: NodeId) -> bool:
    if id.index < 0:
        return false
    kind = arena.nodes[id.index].kind
    if kind == SyntaxKind.TYPE_CONST:
        return specialization_type_has_simple_declarator(arena, codegen_names.first_child(arena, id))
    return kind != SyntaxKind.TYPE_ARRAY and kind != SyntaxKind.TYPE_FUNCTION and kind != SyntaxKind.TYPE_CLOSURE

def emit_module_result_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    node = arena.nodes[id.index]
    if node.child_count < 3:
        builder.append("struct ")
        builder.append(name[0:len(name)])
        builder.append(" { int32_t _cinder_invalid; };\n")
        return
    ok_type = arena.children[node.first_child + 1]
    error_type = arena.children[node.first_child + 2]
    builder.append("typedef enum ")
    builder.append(name[0:len(name)])
    builder.append("_Tag {\n")
    builder.append("    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Ok = 0,\n")
    builder.append("    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Err = 1\n")
    builder.append("} ")
    builder.append(name[0:len(name)])
    builder.append("_Tag;\n")
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag tag;\n    union {\n        unsigned char _cinder_empty;\n")
    if not codegen_type_names.context_type_name_equals(arena, ok_type, source, "void"):
        builder.append("        ")
        codegen_type_names.emit_module_c_type(arena, ok_type, source, builder, prefix, project_name, imports, registry)
        builder.append(" ok;\n")
    if not codegen_type_names.context_type_name_equals(arena, error_type, source, "void"):
        builder.append("        ")
        codegen_type_names.emit_module_c_type(arena, error_type, source, builder, prefix, project_name, imports, registry)
        builder.append(" err;\n")
    builder.append("    } data;\n};\n")

def context_type_is_array(arena: &const SyntaxArena, type_id: NodeId) -> bool:
    if type_id.index < 0:
        return false
    return codegen_type_names.type_node_kind(arena, type_id) == SyntaxKind.TYPE_ARRAY

def array_length_node(arena: &const SyntaxArena, type_id: NodeId) -> NodeId:
    if type_id.index < 0 or codegen_type_names.type_node_kind(arena, type_id) != SyntaxKind.TYPE_ARRAY:
        return syntax.missing_node()
    return codegen_names.second_child(arena, type_id)

def append_node_numeric_literal(builder: &StringBuilder, arena: &const SyntaxArena, source: &const String, id: NodeId) -> void:
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    codegen_names.append_numeric_literal(builder, source, node.value_start, node.value_length)

def emit_module_typed_declarator(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    base_type = type_id
    while base_type.index >= 0 and codegen_type_names.type_node_kind(arena, base_type) == SyntaxKind.TYPE_ARRAY:
        base_type = codegen_names.first_child(arena, base_type)
    codegen_type_names.emit_module_c_type(arena, base_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" ")
    codegen_names.append_source(builder, source, name_start, name_length)
    current = type_id
    while current.index >= 0 and codegen_type_names.type_node_kind(arena, current) == SyntaxKind.TYPE_ARRAY:
        builder.append("[")
        length = array_length_node(arena, current)
        if length.index >= 0:
            length_node = arena.nodes[length.index]
            codegen_names.append_numeric_literal(builder, source, length_node.value_start, length_node.value_length)
        builder.append("]")
        current = codegen_names.first_child(arena, current)

def emit_module_prefixed_typed_declarator(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name_start: usize,
    name_length: usize,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    base_type = type_id
    while base_type.index >= 0 and codegen_type_names.type_node_kind(arena, base_type) == SyntaxKind.TYPE_ARRAY:
        base_type = codegen_names.first_child(arena, base_type)
    codegen_type_names.emit_module_c_type(arena, base_type, source, builder, prefix, project_name, imports, registry)
    builder.append(" ")
    codegen_names.emit_prefixed_name(builder, prefix, source, name_start, name_length)
    current = type_id
    while current.index >= 0 and codegen_type_names.type_node_kind(arena, current) == SyntaxKind.TYPE_ARRAY:
        builder.append("[")
        length = array_length_node(arena, current)
        if length.index >= 0:
            length_node = arena.nodes[length.index]
            codegen_names.append_numeric_literal(builder, source, length_node.value_start, length_node.value_length)
        builder.append("]")
        current = codegen_names.first_child(arena, current)


def module_managed_type_info(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> ManagedTypeInfo:
    c_builder = StringBuilder()
    codegen_type_names.emit_module_c_type(arena, type_id, source, &c_builder, prefix, project_name, imports, registry)
    c_type = c_builder.finish()
    token_builder = StringBuilder()
    codegen_type_names.emit_readable_specialized_type_name(arena, type_id, source, &token_builder)
    helper_builder = StringBuilder()
    is_string = module_type_is_exact_name(arena, type_id, source, "String")
    is_c_string = module_type_is_c_string(arena, type_id, source)
    is_enum = codegen_names.is_registered_enum_name(registry, &c_type)
    hash_kind = ManagedHashKind.UNSUPPORTED
    if is_string:
        hash_kind = ManagedHashKind.STRING
    elif is_c_string:
        hash_kind = ManagedHashKind.C_STRING
    elif module_type_is_hash_scalar(arena, type_id, source) or is_enum:
        hash_kind = ManagedHashKind.SCALAR
    is_complete = false
    if type_id.index >= 0:
        type_node = arena.nodes[type_id.index]
        is_complete = (
            type_node.kind == SyntaxKind.TYPE_POINTER
            or type_node.kind == SyntaxKind.TYPE_REFERENCE
            or (type_node.kind == SyntaxKind.TYPE_GENERIC and module_type_has_value_helper(arena, type_id, source, prefix, project_name, imports, registry))
            or (type_node.kind == SyntaxKind.TYPE_NAME and codegen_type_names.is_specialization_builtin_name(source, &type_node))
            or is_c_string
            or is_enum
        )
    if type_id.index >= 0 and codegen_type_names.type_node_kind(arena, type_id) == SyntaxKind.TYPE_GENERIC:
        base = codegen_names.first_child(arena, type_id)
        base_node = arena.nodes[base.index]
        if (
            codegen_type_names.is_runtime_generic_name(source, &base_node, "List")
            or codegen_type_names.is_runtime_generic_name(source, &base_node, "Map")
            or codegen_type_names.is_runtime_generic_name(source, &base_node, "Set")
            or codegen_type_names.is_runtime_generic_name(source, &base_node, "Option")
        ):
            codegen_type_names.emit_specialized_type_name(arena, type_id, source, &helper_builder, prefix, project_name, imports, registry)
    return ManagedTypeInfo(
        c_type=c_type,
        token=token_builder.finish(),
        helper=helper_builder.finish(),
        is_string=is_string,
        is_c_string=is_c_string,
        is_complete=is_complete,
        hash_kind=hash_kind,
    )


def semantic_managed_type_info(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> ManagedTypeInfo:
    c_builder = StringBuilder()
    codegen_type_names.emit_semantic_c_type(table, type_id, source, &c_builder, prefix, project_name, imports, registry)
    token_builder = StringBuilder()
    codegen_type_names.emit_semantic_readable_type_name(table, type_id, source, &token_builder)
    helper_builder = StringBuilder()
    kind = types.TypeKind.ERROR
    if type_id.index >= 0 and type_id.index < cast[i32](len(table.types)):
        kind = table.types[type_id.index].kind
    is_string = kind == types.TypeKind.STRING
    is_c_string = semantic_type_is_c_string(table, type_id)
    c_type = c_builder.finish()
    hash_kind = ManagedHashKind.UNSUPPORTED
    if is_string:
        hash_kind = ManagedHashKind.STRING
    elif is_c_string:
        hash_kind = ManagedHashKind.C_STRING
    elif semantic_type_is_hash_scalar(table, type_id, source) or codegen_names.is_registered_enum_name(registry, &c_type):
        hash_kind = ManagedHashKind.SCALAR
    if kind == types.TypeKind.LIST or kind == types.TypeKind.MAP or kind == types.TypeKind.SET or kind == types.TypeKind.OPTION:
        codegen_type_names.emit_semantic_specialized_type_name(table, type_id, source, &helper_builder, registry)
    return ManagedTypeInfo(
        c_type=c_type,
        token=token_builder.finish(),
        helper=helper_builder.finish(),
        is_string=is_string,
        is_c_string=is_c_string,
        is_complete=semantic_type_has_value_helper(table, type_id) or is_c_string or hash_kind == ManagedHashKind.SCALAR,
        hash_kind=hash_kind,
    )


def unsupported_print_type_info() -> PrintTypeInfo:
    return PrintTypeInfo(kind=PrintValueKind.UNSUPPORTED, helper=String())


def module_type_is_unsigned_print_integer(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    return module_type_is_exact_name(arena, type_id, source, "u8") or module_type_is_exact_name(arena, type_id, source, "u16") or module_type_is_exact_name(arena, type_id, source, "u32") or module_type_is_exact_name(arena, type_id, source, "u64") or module_type_is_exact_name(arena, type_id, source, "usize") or module_type_is_exact_name(arena, type_id, source, "c_size_t")


def module_type_is_signed_print_integer(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    return module_type_is_exact_name(arena, type_id, source, "i8") or module_type_is_exact_name(arena, type_id, source, "i16") or module_type_is_exact_name(arena, type_id, source, "i32") or module_type_is_exact_name(arena, type_id, source, "i64") or module_type_is_exact_name(arena, type_id, source, "isize") or module_type_is_exact_name(arena, type_id, source, "c_int") or module_type_is_exact_name(arena, type_id, source, "c_long")


def module_print_type_info(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> PrintTypeInfo:
    if type_id.index < 0:
        return unsupported_print_type_info()
    if module_type_is_c_string(arena, type_id, source):
        return PrintTypeInfo(kind=PrintValueKind.C_STRING, helper=String())
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.TYPE_CONST:
        return module_print_type_info(arena, codegen_names.first_child(arena, type_id), source, prefix, project_name, imports, registry)
    if module_type_is_exact_name(arena, type_id, source, "bool"):
        return PrintTypeInfo(kind=PrintValueKind.BOOL, helper=String())
    if module_type_is_exact_name(arena, type_id, source, "char"):
        return PrintTypeInfo(kind=PrintValueKind.CHAR, helper=String())
    if module_type_is_exact_name(arena, type_id, source, "String"):
        return PrintTypeInfo(kind=PrintValueKind.STRING, helper=String())
    if module_type_is_exact_name(arena, type_id, source, "f32") or module_type_is_exact_name(arena, type_id, source, "f64"):
        return PrintTypeInfo(kind=PrintValueKind.FLOAT, helper=String())
    if module_type_is_unsigned_print_integer(arena, type_id, source):
        return PrintTypeInfo(kind=PrintValueKind.UNSIGNED_INTEGER, helper=String())
    if module_type_is_signed_print_integer(arena, type_id, source):
        return PrintTypeInfo(kind=PrintValueKind.SIGNED_INTEGER, helper=String())
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return unsupported_print_type_info()
    base = codegen_names.first_child(arena, type_id)
    if base.index < 0:
        return unsupported_print_type_info()
    base_node = arena.nodes[base.index]
    is_list = codegen_type_names.is_runtime_generic_name(source, &base_node, "List")
    is_map = codegen_type_names.is_runtime_generic_name(source, &base_node, "Map")
    is_set = codegen_type_names.is_runtime_generic_name(source, &base_node, "Set")
    is_tuple = codegen_type_names.is_runtime_generic_name(source, &base_node, "Tuple")
    if not is_list and not is_map and not is_set and not is_tuple:
        return unsupported_print_type_info()
    if (is_list or is_set) and node.child_count <= 1:
        return unsupported_print_type_info()
    if is_map and node.child_count <= 2:
        return unsupported_print_type_info()
    offset: i32 = 1
    while offset < node.child_count:
        child_info = module_print_type_info(arena, arena.children[node.first_child + offset], source, prefix, project_name, imports, registry)
        if child_info.kind == PrintValueKind.UNSUPPORTED:
            return unsupported_print_type_info()
        offset += 1
    helper_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(arena, type_id, source, &helper_builder, prefix, project_name, imports, registry)
    return PrintTypeInfo(kind=PrintValueKind.COLLECTION, helper=helper_builder.finish())


def semantic_named_print_kind(source: &const String, record: &const types.TypeRecord) -> PrintValueKind:
    if record.name_length == 0:
        return PrintValueKind.UNSUPPORTED
    name = source[record.name_start:record.name_start + record.name_length]
    if name == "f32" or name == "f64":
        return PrintValueKind.FLOAT
    if name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "usize" or name == "c_size_t":
        return PrintValueKind.UNSIGNED_INTEGER
    if name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "isize" or name == "c_int" or name == "c_long":
        return PrintValueKind.SIGNED_INTEGER
    return PrintValueKind.UNSUPPORTED


def semantic_print_type_info(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> PrintTypeInfo:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return unsupported_print_type_info()
    if semantic_type_is_c_string(table, type_id):
        return PrintTypeInfo(kind=PrintValueKind.C_STRING, helper=String())
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        return semantic_print_type_info(table, record.inner, source, registry)
    if record.kind == types.TypeKind.BOOL:
        return PrintTypeInfo(kind=PrintValueKind.BOOL, helper=String())
    if record.kind == types.TypeKind.CHAR:
        return PrintTypeInfo(kind=PrintValueKind.CHAR, helper=String())
    if record.kind == types.TypeKind.STRING:
        return PrintTypeInfo(kind=PrintValueKind.STRING, helper=String())
    if record.kind == types.TypeKind.F64:
        return PrintTypeInfo(kind=PrintValueKind.FLOAT, helper=String())
    if record.kind == types.TypeKind.I32 or record.kind == types.TypeKind.I64:
        return PrintTypeInfo(kind=PrintValueKind.SIGNED_INTEGER, helper=String())
    if record.kind == types.TypeKind.NAMED:
        named_kind = semantic_named_print_kind(source, &record)
        return PrintTypeInfo(kind=named_kind, helper=String())
    is_collection = record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.TUPLE
    if not is_collection:
        return unsupported_print_type_info()
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        child_info = semantic_print_type_info(table, record.inner, source, registry)
        if child_info.kind == PrintValueKind.UNSUPPORTED:
            return unsupported_print_type_info()
    elif record.kind == types.TypeKind.MAP:
        key_info = semantic_print_type_info(table, record.inner, source, registry)
        value_info = semantic_print_type_info(table, record.second, source, registry)
        if key_info.kind == PrintValueKind.UNSUPPORTED or value_info.kind == PrintValueKind.UNSUPPORTED:
            return unsupported_print_type_info()
    else:
        offset: i32 = 0
        while offset < record.flags:
            element_info = semantic_print_type_info(table, table.type_args[cast[usize](record.extra + offset)], source, registry)
            if element_info.kind == PrintValueKind.UNSUPPORTED:
                return unsupported_print_type_info()
            offset += 1
    helper_builder = StringBuilder()
    codegen_type_names.emit_semantic_specialized_type_name(table, type_id, source, &helper_builder, registry)
    return PrintTypeInfo(kind=PrintValueKind.COLLECTION, helper=helper_builder.finish())


def emit_print_helper_value(builder: &StringBuilder, info: &const PrintTypeInfo, expression: String) -> void:
    if info.kind == PrintValueKind.BOOL:
        builder.append("printf(\"%s\", (")
        builder.append(expression[0:len(expression)])
        builder.append(") ? \"true\" : \"false\");\n")
    elif info.kind == PrintValueKind.CHAR:
        builder.append("cinder_print_repr_char(")
        builder.append(expression[0:len(expression)])
        builder.append(");\n")
    elif info.kind == PrintValueKind.STRING:
        builder.append("cinder_print_repr_string(cinder_string_cstr(&(")
        builder.append(expression[0:len(expression)])
        builder.append(")));\n")
    elif info.kind == PrintValueKind.C_STRING:
        builder.append("cinder_print_repr_string(")
        builder.append(expression[0:len(expression)])
        builder.append(");\n")
    elif info.kind == PrintValueKind.FLOAT:
        builder.append("printf(\"%g\", (double)(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")
    elif info.kind == PrintValueKind.UNSIGNED_INTEGER:
        builder.append("printf(\"%llu\", (unsigned long long)(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")
    elif info.kind == PrintValueKind.SIGNED_INTEGER:
        builder.append("printf(\"%lld\", (long long)(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")
    elif info.kind == PrintValueKind.COLLECTION:
        builder.append(info.helper[0:len(info.helper)])
        builder.append("_print(&(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")


def emit_collection_print_prototype(builder: &StringBuilder, name: &const String) -> void:
    builder.append("#ifndef CINDER_PRINT_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_PRINT_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\nstatic inline CINDER_MAYBE_UNUSED void ")
    builder.append(name[0:len(name)])
    builder.append("_print(const ")
    builder.append(name[0:len(name)])
    builder.append(" *value);\n#endif\n")


def emit_collection_print_definition_start(builder: &StringBuilder, name: &const String) -> void:
    builder.append("#ifndef CINDER_PRINT_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_PRINT_")
    builder.append(name[0:len(name)])
    builder.append("\nstatic inline CINDER_MAYBE_UNUSED void ")
    builder.append(name[0:len(name)])
    builder.append("_print(const ")
    builder.append(name[0:len(name)])
    builder.append(" *value) {\n")


def emit_collection_print_definition_end(builder: &StringBuilder) -> void:
    builder.append("}\n#endif\n")


def emit_list_print_helper(builder: &StringBuilder, name: &const String, element_info: &const PrintTypeInfo) -> void:
    emit_collection_print_definition_start(builder, name)
    builder.append("    printf(\"[\");\n    for (size_t index = 0; index < value->length; index += 1) {\n        if (index > 0) printf(\", \");\n        ")
    emit_print_helper_value(builder, element_info, "value->data[index]")
    builder.append("    }\n    printf(\"]\");\n")
    emit_collection_print_definition_end(builder)


def emit_map_print_helper(builder: &StringBuilder, name: &const String, key_info: &const PrintTypeInfo, value_info: &const PrintTypeInfo) -> void:
    emit_collection_print_definition_start(builder, name)
    builder.append("    printf(\"{\");\n    bool first = true;\n    for (size_t index = 0; index < value->entries_length; index += 1) {\n        const ")
    builder.append(name[0:len(name)])
    builder.append("_Entry *entry = &value->entries[index];\n        if (!entry->occupied) continue;\n        if (!first) printf(\", \");\n        first = false;\n        ")
    emit_print_helper_value(builder, key_info, "entry->key")
    builder.append("        printf(\": \");\n        ")
    emit_print_helper_value(builder, value_info, "entry->value")
    builder.append("    }\n    printf(\"}\");\n")
    emit_collection_print_definition_end(builder)


def emit_set_print_helper(builder: &StringBuilder, name: &const String, element_info: &const PrintTypeInfo) -> void:
    emit_collection_print_definition_start(builder, name)
    builder.append("    if (value->length == 0) { printf(\"set()\"); return; }\n    printf(\"{\");\n    bool first = true;\n    for (size_t index = 0; index < value->capacity; index += 1) {\n        const ")
    builder.append(name[0:len(name)])
    builder.append("_Entry *entry = &value->entries[index];\n        if (entry->state != 1) continue;\n        if (!first) printf(\", \");\n        first = false;\n        ")
    emit_print_helper_value(builder, element_info, "entry->value")
    builder.append("    }\n    printf(\"}\");\n")
    emit_collection_print_definition_end(builder)


def emit_tuple_print_helper(builder: &StringBuilder, name: &const String, element_infos: &const List[PrintTypeInfo]) -> void:
    emit_collection_print_definition_start(builder, name)
    builder.append("    printf(\"(\");\n")
    index: usize = 0
    while index < len(element_infos):
        if index > 0:
            builder.append("    printf(\", \");\n")
        expression_builder = StringBuilder()
        expression_builder.append("value->item_")
        codegen_type_names.append_specialization_decimal(&expression_builder, index)
        builder.append("    ")
        emit_print_helper_value(builder, &element_infos[index], expression_builder.finish())
        index += 1
    if len(element_infos) == 1:
        builder.append("    printf(\",\");\n")
    builder.append("    printf(\")\");\n")
    emit_collection_print_definition_end(builder)


def emit_module_collection_print_helpers(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
    definitions: bool,
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_module_collection_print_helpers(arena, arena.children[node.first_child + offset], source, builder, emitted, prefix, project_name, imports, registry, definitions)
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return
    print_info = module_print_type_info(arena, id, source, prefix, project_name, imports, registry)
    if print_info.kind != PrintValueKind.COLLECTION:
        return
    if codegen_type_names.string_list_contains(emitted, &print_info.helper):
        return
    emitted.append(print_info.helper[0:len(print_info.helper)])
    if not definitions:
        emit_collection_print_prototype(builder, &print_info.helper)
        return
    base = codegen_names.first_child(arena, id)
    if base.index < 0:
        return
    base_node = arena.nodes[base.index]
    if codegen_type_names.is_runtime_generic_name(source, &base_node, "List"):
        element_info = module_print_type_info(arena, arena.children[node.first_child + 1], source, prefix, project_name, imports, registry)
        emit_list_print_helper(builder, &print_info.helper, &element_info)
    elif codegen_type_names.is_runtime_generic_name(source, &base_node, "Map"):
        key_info = module_print_type_info(arena, arena.children[node.first_child + 1], source, prefix, project_name, imports, registry)
        value_info = module_print_type_info(arena, arena.children[node.first_child + 2], source, prefix, project_name, imports, registry)
        emit_map_print_helper(builder, &print_info.helper, &key_info, &value_info)
    elif codegen_type_names.is_runtime_generic_name(source, &base_node, "Set"):
        element_info = module_print_type_info(arena, arena.children[node.first_child + 1], source, prefix, project_name, imports, registry)
        emit_set_print_helper(builder, &print_info.helper, &element_info)
    elif codegen_type_names.is_runtime_generic_name(source, &base_node, "Tuple"):
        element_infos: List[PrintTypeInfo] = []
        item_offset: i32 = 1
        while item_offset < node.child_count:
            element_infos.append(module_print_type_info(arena, arena.children[node.first_child + item_offset], source, prefix, project_name, imports, registry))
            item_offset += 1
        emit_tuple_print_helper(builder, &print_info.helper, &element_infos)


def emit_semantic_collection_print_helpers(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    emitted: &List[String],
    registry: &const codegen_names.SpecializationNameRegistry,
    definitions: bool,
) -> void:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        emit_semantic_collection_print_helpers(table, record.inner, source, builder, emitted, registry, definitions)
    elif record.kind == types.TypeKind.MAP:
        emit_semantic_collection_print_helpers(table, record.inner, source, builder, emitted, registry, definitions)
        emit_semantic_collection_print_helpers(table, record.second, source, builder, emitted, registry, definitions)
    elif record.kind == types.TypeKind.TUPLE:
        child_offset: i32 = 0
        while child_offset < record.flags:
            emit_semantic_collection_print_helpers(table, table.type_args[cast[usize](record.extra + child_offset)], source, builder, emitted, registry, definitions)
            child_offset += 1
    else:
        return
    print_info = semantic_print_type_info(table, type_id, source, registry)
    if print_info.kind != PrintValueKind.COLLECTION:
        return
    if codegen_type_names.string_list_contains(emitted, &print_info.helper):
        return
    emitted.append(print_info.helper[0:len(print_info.helper)])
    if not definitions:
        emit_collection_print_prototype(builder, &print_info.helper)
        return
    if record.kind == types.TypeKind.LIST:
        element_info = semantic_print_type_info(table, record.inner, source, registry)
        emit_list_print_helper(builder, &print_info.helper, &element_info)
    elif record.kind == types.TypeKind.MAP:
        key_info = semantic_print_type_info(table, record.inner, source, registry)
        value_info = semantic_print_type_info(table, record.second, source, registry)
        emit_map_print_helper(builder, &print_info.helper, &key_info, &value_info)
    elif record.kind == types.TypeKind.SET:
        element_info = semantic_print_type_info(table, record.inner, source, registry)
        emit_set_print_helper(builder, &print_info.helper, &element_info)
    else:
        element_infos: List[PrintTypeInfo] = []
        offset: i32 = 0
        while offset < record.flags:
            element_infos.append(semantic_print_type_info(table, table.type_args[cast[usize](record.extra + offset)], source, registry))
            offset += 1
        emit_tuple_print_helper(builder, &print_info.helper, &element_infos)


def module_type_is_exact_name(arena: &const SyntaxArena, type_id: NodeId, source: &const String, expected: String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    return node.kind == SyntaxKind.TYPE_NAME and codegen_names.range_text_equals(source, node.value_start, node.value_length, expected)


def module_type_is_c_string(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.TYPE_CONST:
        pointer = codegen_names.first_child(arena, type_id)
        if pointer.index < 0 or arena.nodes[pointer.index].kind != SyntaxKind.TYPE_POINTER:
            return false
        return module_type_is_exact_name(arena, codegen_names.first_child(arena, pointer), source, "char")
    if node.kind == SyntaxKind.TYPE_POINTER:
        const_type = codegen_names.first_child(arena, type_id)
        if const_type.index < 0 or arena.nodes[const_type.index].kind != SyntaxKind.TYPE_CONST:
            return false
        return module_type_is_exact_name(arena, codegen_names.first_child(arena, const_type), source, "char")
    return false


def module_type_is_hash_scalar(arena: &const SyntaxArena, type_id: NodeId, source: &const String) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind != SyntaxKind.TYPE_NAME:
        return false
    return codegen_names.range_text_equals(source, node.value_start, node.value_length, "bool") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "char") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "i8") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "i16") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "i32") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "i64") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "u8") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "u16") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "u32") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "u64") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "isize") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "usize") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "c_int") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "c_long") or codegen_names.range_text_equals(source, node.value_start, node.value_length, "c_size_t")


def semantic_type_is_c_string(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        pointer = table.types[record.inner.index]
        return pointer.kind == types.TypeKind.POINTER and codegen_type_names.semantic_type_is_kind(table, pointer.inner, types.TypeKind.CHAR)
    if record.kind == types.TypeKind.POINTER:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        const_type = table.types[record.inner.index]
        return const_type.kind == types.TypeKind.CONST and codegen_type_names.semantic_type_is_kind(table, const_type.inner, types.TypeKind.CHAR)
    return false


def semantic_type_is_hash_scalar(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.BOOL or record.kind == types.TypeKind.I32 or record.kind == types.TypeKind.I64 or record.kind == types.TypeKind.CHAR or record.kind == types.TypeKind.ENUM:
        return true
    if record.kind != types.TypeKind.NAMED:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def module_type_has_value_helper(
    arena: &const SyntaxArena,
    type_id: NodeId,
    source: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> bool:
    if type_id.index < 0:
        return false
    node = arena.nodes[type_id.index]
    if node.kind == SyntaxKind.TYPE_POINTER or node.kind == SyntaxKind.TYPE_REFERENCE:
        return true
    if node.kind == SyntaxKind.TYPE_CONST:
        return module_type_has_value_helper(arena, codegen_names.first_child(arena, type_id), source, prefix, project_name, imports, registry)
    if node.kind == SyntaxKind.TYPE_NAME:
        if codegen_type_names.is_specialization_builtin_name(source, &node):
            return true
        c_builder = StringBuilder()
        codegen_type_names.emit_module_c_type(arena, type_id, source, &c_builder, prefix, project_name, imports, registry)
        c_type = c_builder.finish()
        return codegen_names.is_registered_enum_name(registry, &c_type)
    if node.kind != SyntaxKind.TYPE_GENERIC:
        return false
    base = codegen_names.first_child(arena, type_id)
    if base.index < 0:
        return false
    base_node = arena.nodes[base.index]
    if (
        codegen_type_names.is_runtime_generic_name(source, &base_node, "List")
        or codegen_type_names.is_runtime_generic_name(source, &base_node, "Set")
        or codegen_type_names.is_runtime_generic_name(source, &base_node, "Option")
    ):
        return node.child_count > 1 and module_type_has_value_helper(arena, arena.children[node.first_child + 1], source, prefix, project_name, imports, registry)
    if codegen_type_names.is_runtime_generic_name(source, &base_node, "Map"):
        return (
            node.child_count > 2
            and module_type_has_value_helper(arena, arena.children[node.first_child + 1], source, prefix, project_name, imports, registry)
            and module_type_has_value_helper(arena, arena.children[node.first_child + 2], source, prefix, project_name, imports, registry)
        )
    return false


def semantic_type_has_value_helper(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if (
        record.kind == types.TypeKind.BOOL
        or record.kind == types.TypeKind.I32
        or record.kind == types.TypeKind.I64
        or record.kind == types.TypeKind.F64
        or record.kind == types.TypeKind.CHAR
        or record.kind == types.TypeKind.STRING
        or record.kind == types.TypeKind.ENUM
        or record.kind == types.TypeKind.POINTER
        or record.kind == types.TypeKind.REFERENCE
    ):
        return true
    if record.kind == types.TypeKind.CONST:
        return semantic_type_has_value_helper(table, record.inner)
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.OPTION:
        return semantic_type_has_value_helper(table, record.inner)
    if record.kind == types.TypeKind.MAP:
        return semantic_type_has_value_helper(table, record.inner) and semantic_type_has_value_helper(table, record.second)
    return false


def emit_clone_expression(builder: &StringBuilder, info: &const ManagedTypeInfo, expression: String) -> void:
    if info.is_string:
        builder.append("cinder_string_clone(&(")
        builder.append(expression[0:len(expression)])
        builder.append("))")
    elif info.is_c_string:
        builder.append("cinder_clone_string(")
        builder.append(expression[0:len(expression)])
        builder.append(")")
    elif len(info.helper) > 0:
        builder.append(info.helper[0:len(info.helper)])
        builder.append("_clone(&(")
        builder.append(expression[0:len(expression)])
        builder.append("))")
    else:
        builder.append(expression[0:len(expression)])


def emit_drop_statement(builder: &StringBuilder, info: &const ManagedTypeInfo, expression: String) -> void:
    if info.is_string:
        builder.append("cinder_string_drop(&(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")
    elif info.is_c_string:
        builder.append("free((void *)(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")
    elif len(info.helper) > 0:
        builder.append(info.helper[0:len(info.helper)])
        builder.append("_drop(&(")
        builder.append(expression[0:len(expression)])
        builder.append("));\n")


def emit_hash_expression(builder: &StringBuilder, info: &const ManagedTypeInfo, expression: String) -> void:
    if info.hash_kind == ManagedHashKind.STRING:
        builder.append("cinder_string_hash_value(&(")
        builder.append(expression[0:len(expression)])
        builder.append("))")
    elif info.hash_kind == ManagedHashKind.C_STRING:
        builder.append("cinder_hash_string(")
        builder.append(expression[0:len(expression)])
        builder.append(")")
    else:
        builder.append("cinder_hash_u64((uint64_t)(")
        builder.append(expression[0:len(expression)])
        builder.append("))")


def emit_equal_expression(builder: &StringBuilder, info: &const ManagedTypeInfo, left: String, right: String) -> void:
    if info.hash_kind == ManagedHashKind.STRING:
        builder.append("cinder_string_equal_value(&(")
        builder.append(left[0:len(left)])
        builder.append("), &(")
        builder.append(right[0:len(right)])
        builder.append("))")
    elif info.hash_kind == ManagedHashKind.C_STRING:
        builder.append("cinder_string_equal(")
        builder.append(left[0:len(left)])
        builder.append(", ")
        builder.append(right[0:len(right)])
        builder.append(")")
    else:
        builder.append("((")
        builder.append(left[0:len(left)])
        builder.append(") == (")
        builder.append(right[0:len(right)])
        builder.append("))")


def emit_semantic_tuple_specialization(
    table: &const types.TypeTable,
    type_id: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    record = table.types[type_id.index]
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n")
    if record.flags == 0:
        builder.append("    unsigned char _cinder_empty;\n")
    offset: i32 = 0
    while offset < record.flags:
        builder.append("    ")
        codegen_type_names.emit_semantic_c_type(table, table.type_args[cast[usize](record.extra + offset)], source, builder, prefix, project_name, imports, registry)
        builder.append(" item_")
        codegen_type_names.append_specialization_decimal(builder, cast[usize](offset))
        builder.append(";\n")
        offset += 1
    builder.append("};\n")


def emit_semantic_list_specialization(
    table: &const types.TypeTable,
    element_type: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    element_info = semantic_managed_type_info(table, element_type, source, prefix, project_name, imports, registry)
    builder.append("struct ")
    builder.append(name[0:len(name)])
    builder.append(" { ")
    builder.append(element_info.c_type[0:len(element_info.c_type)])
    builder.append(" *data; size_t length; size_t capacity; };\n")
    if element_info.is_complete:
        emit_list_helper_suite(builder, name, &element_info)


def emit_semantic_set_specialization(
    table: &const types.TypeTable,
    element_type: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    element_info = semantic_managed_type_info(table, element_type, source, prefix, project_name, imports, registry)
    emit_set_specialization_layout(builder, name)
    emit_set_specialization_body(builder, name, &element_info)


def map_view_name(map_name: &const String, prefix: String) -> String:
    builder = StringBuilder()
    builder.append(prefix[0:len(prefix)])
    if len(map_name) > 10:
        builder.append(map_name[10:len(map_name)])
    return builder.finish()


def emit_map_view_layout(builder: &StringBuilder, map_name: &const String, view_name: &const String) -> void:
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(view_name[0:len(view_name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(view_name[0:len(view_name)])
    builder.append("\ntypedef struct ")
    builder.append(view_name[0:len(view_name)])
    builder.append(" ")
    builder.append(view_name[0:len(view_name)])
    builder.append(";\n#endif\n#ifndef CINDER_SPECIALIZED_")
    builder.append(view_name[0:len(view_name)])
    builder.append("\n#define CINDER_SPECIALIZED_")
    builder.append(view_name[0:len(view_name)])
    builder.append("\nstruct ")
    builder.append(view_name[0:len(view_name)])
    builder.append(" { const ")
    builder.append(map_name[0:len(map_name)])
    builder.append(" *map; };\n#endif\n")


def emit_map_view_layouts(builder: &StringBuilder, map_name: &const String) -> void:
    keys_name = map_view_name(map_name, "CinderMapKeys_")
    values_name = map_view_name(map_name, "CinderMapValues_")
    items_name = map_view_name(map_name, "CinderMapItems_")
    emit_map_view_layout(builder, map_name, &keys_name)
    emit_map_view_layout(builder, map_name, &values_name)
    emit_map_view_layout(builder, map_name, &items_name)


def emit_semantic_map_view_specialization(
    table: &const types.TypeTable,
    map_type: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    map_name_builder = StringBuilder()
    codegen_type_names.emit_semantic_specialized_type_name(table, map_type, source, &map_name_builder, registry)
    map_name = map_name_builder.finish()
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(map_name[0:len(map_name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(map_name[0:len(map_name)])
    builder.append("\ntypedef struct ")
    builder.append(map_name[0:len(map_name)])
    builder.append(" ")
    builder.append(map_name[0:len(map_name)])
    builder.append(";\n#endif\nstruct ")
    builder.append(name[0:len(name)])
    builder.append(" { const ")
    builder.append(map_name[0:len(map_name)])
    builder.append(" *map; };\n")


def emit_module_map_view_specialization(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
) -> void:
    node = arena.nodes[id.index]
    map_name_builder = StringBuilder()
    map_name_builder.append("CinderMap_")
    if node.child_count > 2:
        codegen_type_names.emit_readable_specialized_type_name(arena, arena.children[node.first_child + 1], source, &map_name_builder)
        map_name_builder.append("_")
        codegen_type_names.emit_readable_specialized_type_name(arena, arena.children[node.first_child + 2], source, &map_name_builder)
    map_name = map_name_builder.finish()
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(map_name[0:len(map_name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(map_name[0:len(map_name)])
    builder.append("\ntypedef struct ")
    builder.append(map_name[0:len(map_name)])
    builder.append(" ")
    builder.append(map_name[0:len(map_name)])
    builder.append(";\n#endif\nstruct ")
    builder.append(name[0:len(name)])
    builder.append(" { const ")
    builder.append(map_name[0:len(map_name)])
    builder.append(" *map; };\n")


def emit_semantic_map_specialization(
    table: &const types.TypeTable,
    key_type: types.TypeId,
    value_type: types.TypeId,
    source: &const String,
    builder: &StringBuilder,
    name: &const String,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    registry: &const codegen_names.SpecializationNameRegistry,
) -> void:
    key_info = semantic_managed_type_info(table, key_type, source, prefix, project_name, imports, registry)
    value_info = semantic_managed_type_info(table, value_type, source, prefix, project_name, imports, registry)
    emit_map_specialization_layout(builder, name)
    emit_map_specialization_body(builder, name, &key_info, &value_info)


def emit_list_helper_suite(builder: &StringBuilder, name: &const String, element_info: &const ManagedTypeInfo) -> void:
    builder.append("static inline ")
    builder.append(name[0:len(name)])
    builder.append(" ")
    builder.append(name[0:len(name)])
    builder.append("_clone(const ")
    builder.append(name[0:len(name)])
    builder.append(" *self) {\n    ")
    builder.append(name[0:len(name)])
    builder.append(" result = {0};\n    if (self == NULL) return result;\n    for (size_t index = 0; index < self->length; index += 1) {\n        ")
    builder.append(element_info.c_type[0:len(element_info.c_type)])
    builder.append(" value = ")
    emit_clone_expression(builder, element_info, "self->data[index]")
    builder.append(";\n        cinder_selfhost_list_append_value(&result, value);\n    }\n    return result;\n}\n")
    builder.append("static inline void ")
    builder.append(name[0:len(name)])
    builder.append("_drop(")
    builder.append(name[0:len(name)])
    builder.append(" *self) {\n    if (self == NULL) return;\n")
    if element_info.is_string or len(element_info.helper) > 0:
        builder.append("    for (size_t index = 0; index < self->length; index += 1) {\n        ")
        emit_drop_statement(builder, element_info, "self->data[index]")
        builder.append("    }\n")
    builder.append("    free(self->data);\n    self->data = NULL;\n    self->length = 0;\n    self->capacity = 0;\n}\n")


def emit_option_drop_helper(builder: &StringBuilder, name: &const String, value_info: &const ManagedTypeInfo) -> void:
    builder.append("static inline ")
    builder.append(name[0:len(name)])
    builder.append(" ")
    builder.append(name[0:len(name)])
    builder.append("_clone(const ")
    builder.append(name[0:len(name)])
    builder.append(" *self) {\n    ")
    builder.append(name[0:len(name)])
    builder.append(" result = {0};\n    if (self == NULL) return result;\n    result.tag = self->tag;\n    if (self->tag == ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Some) result.data.value = ")
    emit_clone_expression(builder, value_info, "self->data.value")
    builder.append(";\n    return result;\n}\n")
    builder.append("static inline void ")
    builder.append(name[0:len(name)])
    builder.append("_drop(")
    builder.append(name[0:len(name)])
    builder.append(" *self) {\n    if (self == NULL) return;\n    if (self->tag == ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Some) {\n        ")
    emit_drop_statement(builder, value_info, "self->data.value")
    builder.append("    }\n    self->tag = ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_None;\n}\n")


def emit_inline_option_specialization(builder: &StringBuilder, name: &const String, value_info: &const ManagedTypeInfo) -> void:
    builder.append("#ifndef CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_DECLARED_")
    builder.append(name[0:len(name)])
    builder.append("\ntypedef struct ")
    builder.append(name[0:len(name)])
    builder.append(" ")
    builder.append(name[0:len(name)])
    builder.append(";\n#endif\n#ifndef CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\n#define CINDER_SPECIALIZED_")
    builder.append(name[0:len(name)])
    builder.append("\ntypedef enum ")
    builder.append(name[0:len(name)])
    builder.append("_Tag {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_None = 0,\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Some = 1\n} ")
    builder.append(name[0:len(name)])
    builder.append("_Tag;\nstruct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Tag tag;\n    union {\n        unsigned char _cinder_empty;\n        ")
    builder.append(value_info.c_type[0:len(value_info.c_type)])
    builder.append(" value;\n    } data;\n};\n")
    emit_option_drop_helper(builder, name, value_info)
    builder.append("#endif\n")


def emit_set_specialization_layout(builder: &StringBuilder, name: &const String) -> void:
    builder.append("typedef struct ")
    builder.append(name[0:len(name)])
    builder.append("_Entry ")
    builder.append(name[0:len(name)])
    builder.append("_Entry;\nstruct ")
    builder.append(name[0:len(name)])
    builder.append(" {\n    ")
    builder.append(name[0:len(name)])
    builder.append("_Entry *entries;\n    size_t capacity;\n    size_t length;\n    size_t tombstones;\n    size_t active_iterators;\n};\n")


def emit_map_specialization_layout(builder: &StringBuilder, name: &const String) -> void:
    builder.append("typedef struct ")
    builder.append(name[0:len(name)])
    builder.append("_Entry ")
    builder.append(name[0:len(name)])
