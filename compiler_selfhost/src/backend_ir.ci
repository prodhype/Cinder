import semantic
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind
from types import TypeId


enum IRNodeKind:
    MODULE
    FUNCTION
    STRUCT
    CLASS
    ENUM
    UNION
    VARIANT
    GLOBAL
    BLOCK
    LOCAL
    ASSIGN
    RETURN
    IF
    WHILE
    MATCH
    MATCH_CASE
    BREAK
    CONTINUE
    DEFER
    DROP
    EXPR
    CALL
    NAME
    LITERAL
    BINARY
    UNARY
    CAST
    PROPAGATE
    UNSUPPORTED
    ATOMIC_INIT
    ATOMIC_LOAD
    ATOMIC_STORE
    ATOMIC_EXCHANGE
    ATOMIC_COMPARE_EXCHANGE
    ATOMIC_FETCH
    ATOMIC_RESULT_FIELD


enum IRAtomicFetchKind:
    INVALID
    ADD
    SUB
    AND
    OR
    XOR


enum IRAtomicMemoryOrder:
    INVALID
    SEQ_CST


struct IRNodeId:
    index: i32


struct IRNode:
    kind: IRNodeKind
    syntax: NodeId
    specialization: i32
    type_id: TypeId
    first_child: i32
    child_count: i32
    flags: i32
    atomic_kind: semantic.AtomicIntrinsicKind
    atomic_element_kind: types.AtomicElementKind
    atomic_type: TypeId
    atomic_element_type: TypeId
    atomic_receiver: NodeId
    atomic_operand0: NodeId
    atomic_operand1: NodeId
    atomic_operand0_type: TypeId
    atomic_operand1_type: TypeId
    atomic_first_evaluated: NodeId
    atomic_second_evaluated: NodeId
    atomic_first_role: semantic.AtomicArgumentRole
    atomic_second_role: semantic.AtomicArgumentRole
    atomic_fetch_kind: IRAtomicFetchKind
    atomic_order: IRAtomicMemoryOrder


struct BackendSummary:
    function_count: i32
    struct_count: i32
    class_count: i32
    enum_count: i32
    union_count: i32
    variant_count: i32
    extern_count: i32
    global_count: i32
    statement_count: i32
    expression_count: i32
    type_count: i32
    node_count: i32


struct IRModule:
    nodes: List[IRNode]
    children: List[IRNodeId]
    specialization_types: List[TypeId]
    specialization_args: List[TypeId]
    call_specializations: List[semantic.SpecializationBinding]
    user_specializations: List[semantic.UserSpecialization]
    root: IRNodeId
    summary: BackendSummary
    is_valid: bool

    def add_node(self: &IRModule, kind: IRNodeKind, syntax_id: NodeId, specialization: i32, type_id: TypeId, children: &const List[IRNodeId], flags: i32) -> IRNodeId:
        first_child = cast[i32](len(self.children))
        index: usize = 0
        while index < len(children):
            child = children[index]
            if child.index >= 0:
                self.children.append(child)
            index += 1
        child_count = cast[i32](len(self.children)) - first_child
        id = IRNodeId(index=cast[i32](len(self.nodes)))
        self.nodes.append(
            IRNode(
                kind=kind,
                syntax=syntax_id,
                specialization=specialization,
                type_id=type_id,
                first_child=first_child,
                child_count=child_count,
                flags=flags,
                atomic_kind=semantic.AtomicIntrinsicKind.NONE,
                atomic_element_kind=types.AtomicElementKind.INVALID,
                atomic_type=types.missing_type(),
                atomic_element_type=types.missing_type(),
                atomic_receiver=syntax.missing_node(),
                atomic_operand0=syntax.missing_node(),
                atomic_operand1=syntax.missing_node(),
                atomic_operand0_type=types.missing_type(),
                atomic_operand1_type=types.missing_type(),
                atomic_first_evaluated=syntax.missing_node(),
                atomic_second_evaluated=syntax.missing_node(),
                atomic_first_role=semantic.AtomicArgumentRole.NONE,
                atomic_second_role=semantic.AtomicArgumentRole.NONE,
                atomic_fetch_kind=IRAtomicFetchKind.INVALID,
                atomic_order=IRAtomicMemoryOrder.INVALID,
            )
        )
        return id


def summarize(arena: &const SyntaxArena, root: NodeId) -> BackendSummary:
    summary = BackendSummary(
        function_count=0,
        struct_count=0,
        class_count=0,
        enum_count=0,
        union_count=0,
        variant_count=0,
        extern_count=0,
        global_count=0,
        statement_count=0,
        expression_count=0,
        type_count=0,
        node_count=cast[i32](len(arena.nodes)),
    )
    visit_summary(arena, root, summary)
    return summary


def lower(arena: &const SyntaxArena, root: NodeId, model: &const semantic.SemanticModel, table: &const types.TypeTable) -> IRModule:
    nodes: List[IRNode] = []
    children: List[IRNodeId] = []
    specialization_types: List[TypeId] = []
    specialization_args: List[TypeId] = []
    call_specializations: List[semantic.SpecializationBinding] = []
    user_specializations: List[semantic.UserSpecialization] = []
    summary = summarize(arena, root)
    module = IRModule(
        nodes=nodes,
        children=children,
        specialization_types=specialization_types,
        specialization_args=specialization_args,
        call_specializations=call_specializations,
        user_specializations=user_specializations,
        root=missing_ir_node(),
        summary=summary,
        is_valid=true,
    )
    module.root = lower_node(module, arena, root, model, -1)
    model_user_specializations: &const List[semantic.UserSpecialization] = &model.user_specializations
    specialization_index: i32 = 0
    while specialization_index < cast[i32](len(model_user_specializations)):
        declaration = model_user_specializations[cast[usize](specialization_index)].declaration
        if declaration.index >= 0:
            lower_node(module, arena, declaration, model, specialization_index)
        specialization_index += 1
    copy_semantic_specializations(module, model)
    collect_module_specializations(module, table)
    module.is_valid = validate_atomic_ir(module, table)
    return module


def copy_semantic_specializations(module: &IRModule, model: &const semantic.SemanticModel) -> void:
    specialization_args: &const List[TypeId] = &model.specialization_args
    specializations: &const List[semantic.SpecializationBinding] = &model.specializations
    user_specializations: &const List[semantic.UserSpecialization] = &model.user_specializations
    index: usize = 0
    while index < len(specialization_args):
        module.specialization_args.append(specialization_args[index])
        index += 1
    index = 0
    while index < len(specializations):
        binding: &const semantic.SpecializationBinding = &specializations[index]
        module.call_specializations.append(
            semantic.SpecializationBinding(
                node=binding.node,
                callee=binding.callee,
                first_arg=binding.first_arg,
                arg_count=binding.arg_count,
                suffix=binding.suffix[0:len(binding.suffix)],
            )
        )
        index += 1
    index = 0
    while index < len(user_specializations):
        specialization: &const semantic.UserSpecialization = &user_specializations[index]
        module.user_specializations.append(
            semantic.UserSpecialization(
                declaration=specialization.declaration,
                first_arg=specialization.first_arg,
                arg_count=specialization.arg_count,
                suffix=specialization.suffix[0:len(specialization.suffix)],
            )
        )
        index += 1


def collect_module_specializations(module: &IRModule, table: &const types.TypeTable) -> void:
    for node in module.nodes:
        collect_specialization_type(module.specialization_types, table, node.type_id)


def collect_specialization_type(result: &List[TypeId], table: &const types.TypeTable, type_id: TypeId) -> void:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.OPTION or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        append_specialization_once(result, type_id)
        collect_specialization_type(result, table, record.inner)
        return
    if record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.RESULT:
        append_specialization_once(result, type_id)
        collect_specialization_type(result, table, record.inner)
        collect_specialization_type(result, table, record.second)
        return
    if types.is_map_view_kind(record.kind):
        append_specialization_once(result, type_id)
        collect_specialization_type(result, table, record.inner)
        return
    if record.kind == types.TypeKind.TUPLE:
        append_specialization_once(result, type_id)
        offset: i32 = 0
        while offset < record.flags:
            collect_specialization_type(result, table, table.type_args[cast[usize](record.extra + offset)])
            offset += 1
        return
    if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.CONST or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.SLICE or record.kind == types.TypeKind.DYN:
        collect_specialization_type(result, table, record.inner)
        return
    if record.kind == types.TypeKind.FUNCTION or record.kind == types.TypeKind.CLOSURE:
        if record.kind == types.TypeKind.CLOSURE:
            append_specialization_once(result, type_id)
            collect_specialization_type(result, table, record.second)
        collect_specialization_type(result, table, record.inner)
        offset: i32 = 0
        while offset < record.flags:
            collect_specialization_type(result, table, table.type_args[cast[usize](record.extra + offset)])
            offset += 1


def append_specialization_once(result: &List[TypeId], type_id: TypeId) -> void:
    for existing in result:
        if existing.index == type_id.index:
            return
    result.append(type_id)


def summarize_ir(module: &const IRModule) -> BackendSummary:
    return module.summary


def lower_node(module: &IRModule, arena: &const SyntaxArena, id: NodeId, model: &const semantic.SemanticModel, specialization: i32) -> IRNodeId:
    if id.index < 0:
        return missing_ir_node()
    node = arena.nodes[id.index]
    child_nodes: List[IRNodeId] = []
    offset: i32 = 0
    while offset < node.child_count:
        lowered = lower_node(module, arena, arena.children[node.first_child + offset], model, specialization)
        if lowered.index >= 0:
            child_nodes.append(lowered)
        offset += 1
    lowered = module.add_node(ir_kind_for_syntax(node.kind), id, specialization, ir_type_for_node(node.kind, id, model, specialization), child_nodes, node.flags)
    attach_atomic_metadata(module, lowered, id, model, specialization)
    return lowered


def attach_atomic_metadata(module: &IRModule, lowered: IRNodeId, syntax_id: NodeId, model: &const semantic.SemanticModel, specialization: i32) -> void:
    atomic_intrinsics: &const List[semantic.AtomicIntrinsicResolution] = &model.atomic_intrinsics
    for resolution in atomic_intrinsics:
        if resolution.node.index != syntax_id.index or resolution.specialization != specialization:
            continue
        node: &IRNode = &module.nodes[lowered.index]
        node.kind = atomic_ir_kind(resolution.kind)
        node.type_id = resolution.result_type
        node.flags = resolution.flags
        node.atomic_kind = resolution.kind
        node.atomic_element_kind = resolution.element_kind
        node.atomic_type = resolution.atomic_type
        node.atomic_element_type = resolution.element_type
        node.atomic_receiver = resolution.receiver
        node.atomic_operand0 = resolution.operand0
        node.atomic_operand1 = resolution.operand1
        if resolution.operand0.index >= 0:
            node.atomic_operand0_type = resolution.element_type
        if resolution.operand1.index >= 0:
            node.atomic_operand1_type = resolution.element_type
        node.atomic_first_evaluated = resolution.first_evaluated
        node.atomic_second_evaluated = resolution.second_evaluated
        node.atomic_first_role = resolution.first_role
        node.atomic_second_role = resolution.second_role
        node.atomic_fetch_kind = atomic_fetch_kind(resolution.kind)
        if resolution.kind != semantic.AtomicIntrinsicKind.INIT and resolution.kind != semantic.AtomicIntrinsicKind.RESULT_EXCHANGED and resolution.kind != semantic.AtomicIntrinsicKind.RESULT_OBSERVED:
            node.atomic_order = IRAtomicMemoryOrder.SEQ_CST
        return


def atomic_ir_kind(kind: semantic.AtomicIntrinsicKind) -> IRNodeKind:
    if kind == semantic.AtomicIntrinsicKind.INIT:
        return IRNodeKind.ATOMIC_INIT
    if kind == semantic.AtomicIntrinsicKind.LOAD:
        return IRNodeKind.ATOMIC_LOAD
    if kind == semantic.AtomicIntrinsicKind.STORE:
        return IRNodeKind.ATOMIC_STORE
    if kind == semantic.AtomicIntrinsicKind.EXCHANGE:
        return IRNodeKind.ATOMIC_EXCHANGE
    if kind == semantic.AtomicIntrinsicKind.COMPARE_EXCHANGE:
        return IRNodeKind.ATOMIC_COMPARE_EXCHANGE
    if kind == semantic.AtomicIntrinsicKind.FETCH_ADD or kind == semantic.AtomicIntrinsicKind.FETCH_SUB or kind == semantic.AtomicIntrinsicKind.FETCH_AND or kind == semantic.AtomicIntrinsicKind.FETCH_OR or kind == semantic.AtomicIntrinsicKind.FETCH_XOR:
        return IRNodeKind.ATOMIC_FETCH
    if kind == semantic.AtomicIntrinsicKind.RESULT_EXCHANGED or kind == semantic.AtomicIntrinsicKind.RESULT_OBSERVED:
        return IRNodeKind.ATOMIC_RESULT_FIELD
    return IRNodeKind.UNSUPPORTED


def atomic_fetch_kind(kind: semantic.AtomicIntrinsicKind) -> IRAtomicFetchKind:
    if kind == semantic.AtomicIntrinsicKind.FETCH_ADD:
        return IRAtomicFetchKind.ADD
    if kind == semantic.AtomicIntrinsicKind.FETCH_SUB:
        return IRAtomicFetchKind.SUB
    if kind == semantic.AtomicIntrinsicKind.FETCH_AND:
        return IRAtomicFetchKind.AND
    if kind == semantic.AtomicIntrinsicKind.FETCH_OR:
        return IRAtomicFetchKind.OR
    if kind == semantic.AtomicIntrinsicKind.FETCH_XOR:
        return IRAtomicFetchKind.XOR
    return IRAtomicFetchKind.INVALID


def validate_atomic_ir(module: &const IRModule, table: &const types.TypeTable) -> bool:
    for node in module.nodes:
        if ir_node_may_escape_atomic_value(node.kind) and ir_type_matches_atomic_storage(module, node.type_id, node.specialization) and not atomic_syntax_is_receiver(module, node.syntax, node.specialization) and not atomic_node_has_unary_parent(module, node.syntax, node.specialization):
            return false
        if not ir_node_is_atomic(node.kind):
            continue
        if node.atomic_kind == semantic.AtomicIntrinsicKind.NONE or node.atomic_element_kind == types.AtomicElementKind.INVALID or node.atomic_element_type.index < 0:
            return false
        if node.atomic_type.index >= 0:
            if node.atomic_type.index >= cast[i32](len(table.types)):
                return false
            atomic_record = table.types[node.atomic_type.index]
            if atomic_record.kind != types.TypeKind.ATOMIC or atomic_record.extra != cast[i32](node.atomic_element_kind) or not table.same(atomic_record.inner, node.atomic_element_type):
                return false
        if node.kind == IRNodeKind.ATOMIC_INIT:
            if node.atomic_operand0.index < 0 or node.atomic_receiver.index >= 0 or node.atomic_order != IRAtomicMemoryOrder.INVALID or not table.same(node.type_id, node.atomic_type) or not table.same(node.atomic_operand0_type, node.atomic_element_type):
                return false
            continue
        if node.kind == IRNodeKind.ATOMIC_RESULT_FIELD:
            if node.atomic_receiver.index < 0 or node.atomic_operand0.index >= 0 or node.atomic_operand1.index >= 0 or node.atomic_order != IRAtomicMemoryOrder.INVALID:
                return false
            if node.atomic_kind == semantic.AtomicIntrinsicKind.RESULT_EXCHANGED:
                if not table.same(node.type_id, types.type_bool()):
                    return false
            elif node.atomic_kind == semantic.AtomicIntrinsicKind.RESULT_OBSERVED:
                if not table.same(node.type_id, node.atomic_element_type):
                    return false
            else:
                return false
            continue
        if node.atomic_receiver.index < 0 or (node.flags & 1) == 0 or node.atomic_order != IRAtomicMemoryOrder.SEQ_CST:
            return false
        if not atomic_receiver_type_is_valid(module, table, node):
            return false
        if node.kind == IRNodeKind.ATOMIC_LOAD:
            if node.atomic_operand0.index >= 0 or node.atomic_operand1.index >= 0 or not table.same(node.type_id, node.atomic_element_type):
                return false
            continue
        if node.kind == IRNodeKind.ATOMIC_COMPARE_EXCHANGE:
            if node.atomic_operand0.index < 0 or node.atomic_operand1.index < 0 or node.atomic_first_evaluated.index < 0 or node.atomic_second_evaluated.index < 0:
                return false
            if node.atomic_first_role == semantic.AtomicArgumentRole.NONE or node.atomic_second_role == semantic.AtomicArgumentRole.NONE:
                return false
            if not table.same(node.atomic_operand0_type, node.atomic_element_type) or not table.same(node.atomic_operand1_type, node.atomic_element_type):
                return false
            if node.type_id.index < 0 or node.type_id.index >= cast[i32](len(table.types)):
                return false
            result_record = table.types[node.type_id.index]
            if result_record.kind != types.TypeKind.ATOMIC_COMPARE_EXCHANGE_RESULT or result_record.extra != cast[i32](node.atomic_element_kind) or not table.same(result_record.inner, node.atomic_element_type):
                return false
            continue
        if node.atomic_operand0.index < 0 or node.atomic_operand1.index >= 0 or node.atomic_first_evaluated.index < 0:
            return false
        if not table.same(node.atomic_operand0_type, node.atomic_element_type) or node.atomic_operand1_type.index >= 0:
            return false
        if node.kind == IRNodeKind.ATOMIC_STORE:
            if node.type_id.index != types.type_void().index:
                return false
        elif not table.same(node.type_id, node.atomic_element_type):
            return false
        if node.kind == IRNodeKind.ATOMIC_FETCH and (not types.atomic_element_is_integer(node.atomic_element_kind) or node.atomic_fetch_kind == IRAtomicFetchKind.INVALID):
            return false
        if node.kind != IRNodeKind.ATOMIC_FETCH and node.atomic_fetch_kind != IRAtomicFetchKind.INVALID:
            return false
    return true


def ir_node_is_atomic(kind: IRNodeKind) -> bool:
    return kind == IRNodeKind.ATOMIC_INIT or kind == IRNodeKind.ATOMIC_LOAD or kind == IRNodeKind.ATOMIC_STORE or kind == IRNodeKind.ATOMIC_EXCHANGE or kind == IRNodeKind.ATOMIC_COMPARE_EXCHANGE or kind == IRNodeKind.ATOMIC_FETCH or kind == IRNodeKind.ATOMIC_RESULT_FIELD


def ir_node_may_escape_atomic_value(kind: IRNodeKind) -> bool:
    return kind == IRNodeKind.NAME or kind == IRNodeKind.CALL or kind == IRNodeKind.BINARY or kind == IRNodeKind.UNARY or kind == IRNodeKind.CAST or kind == IRNodeKind.PROPAGATE or kind == IRNodeKind.EXPR


def ir_type_matches_atomic_storage(module: &const IRModule, type_id: TypeId, specialization: i32) -> bool:
    if type_id.index < 0:
        return false
    for node in module.nodes:
        if node.specialization == specialization and ir_node_is_atomic(node.kind) and node.atomic_type.index == type_id.index:
            return true
    return false


def atomic_syntax_is_receiver(module: &const IRModule, syntax_id: NodeId, specialization: i32) -> bool:
    for node in module.nodes:
        if node.specialization == specialization and ir_node_is_atomic(node.kind) and node.atomic_receiver.index == syntax_id.index:
            return true
    return false


def atomic_node_has_unary_parent(module: &const IRModule, syntax_id: NodeId, specialization: i32) -> bool:
    for node in module.nodes:
        if node.specialization == specialization and node.kind == IRNodeKind.UNARY and node.flags == cast[i32](token.TokenKind.AMPERSAND):
            offset: i32 = 0
            while offset < node.child_count:
                child = module.children[cast[usize](node.first_child + offset)]
                if child.index >= 0 and module.nodes[child.index].syntax.index == syntax_id.index:
                    return true
                offset += 1
    return false


def atomic_receiver_type_is_valid(module: &const IRModule, table: &const types.TypeTable, operation: &const IRNode) -> bool:
    receiver_type = type_for_syntax(module, operation.atomic_receiver, operation.specialization)
    current = receiver_type
    indirections: i32 = 0
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        record = table.types[current.index]
        if record.kind == types.TypeKind.CONST:
            current = record.inner
            continue
        if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE:
            indirections += 1
            if indirections > 1:
                return false
            current = record.inner
            continue
        break
    return current.index >= 0 and table.same(current, operation.atomic_type)


def type_for_syntax(module: &const IRModule, syntax_id: NodeId, specialization: i32) -> TypeId:
    for node in module.nodes:
        if node.syntax.index == syntax_id.index and node.specialization == specialization:
            return node.type_id
    return types.missing_type()


def ir_kind_for_syntax(kind: SyntaxKind) -> IRNodeKind:
    if kind == SyntaxKind.MODULE:
        return IRNodeKind.MODULE
    if kind == SyntaxKind.FUNCTION_DECL:
        return IRNodeKind.FUNCTION
    if kind == SyntaxKind.STRUCT_DECL:
        return IRNodeKind.STRUCT
    if kind == SyntaxKind.CLASS_DECL:
        return IRNodeKind.CLASS
    if kind == SyntaxKind.ENUM_DECL:
        return IRNodeKind.ENUM
    if kind == SyntaxKind.UNION_DECL:
        return IRNodeKind.UNION
    if kind == SyntaxKind.VARIANT_DECL:
        return IRNodeKind.VARIANT
    if kind == SyntaxKind.GLOBAL_DECL:
        return IRNodeKind.GLOBAL
    if kind == SyntaxKind.BLOCK:
        return IRNodeKind.BLOCK
    if kind == SyntaxKind.VAR_DECL_STMT or kind == SyntaxKind.PARAMETER:
        return IRNodeKind.LOCAL
    if kind == SyntaxKind.ASSIGN_STMT:
        return IRNodeKind.ASSIGN
    if kind == SyntaxKind.RETURN_STMT:
        return IRNodeKind.RETURN
    if kind == SyntaxKind.IF_STMT or kind == SyntaxKind.IF_BRANCH:
        return IRNodeKind.IF
    if kind == SyntaxKind.WHILE_STMT:
        return IRNodeKind.WHILE
    if kind == SyntaxKind.MATCH_STMT:
        return IRNodeKind.MATCH
    if kind == SyntaxKind.MATCH_CASE:
        return IRNodeKind.MATCH_CASE
    if kind == SyntaxKind.BREAK_STMT:
        return IRNodeKind.BREAK
    if kind == SyntaxKind.CONTINUE_STMT:
        return IRNodeKind.CONTINUE
    if kind == SyntaxKind.DEFER_STMT:
        return IRNodeKind.DEFER
    if kind == SyntaxKind.EXPR_CALL:
        return IRNodeKind.CALL
    if kind == SyntaxKind.EXPR_NAME:
        return IRNodeKind.NAME
    if kind == SyntaxKind.EXPR_LITERAL:
        return IRNodeKind.LITERAL
    if kind == SyntaxKind.EXPR_BINARY:
        return IRNodeKind.BINARY
    if kind == SyntaxKind.EXPR_UNARY:
        return IRNodeKind.UNARY
    if kind == SyntaxKind.EXPR_CAST:
        return IRNodeKind.CAST
    if kind == SyntaxKind.EXPR_PROPAGATE:
        return IRNodeKind.PROPAGATE
    if is_expression_kind(kind):
        return IRNodeKind.EXPR
    return IRNodeKind.UNSUPPORTED


def ir_type_for_node(kind: SyntaxKind, id: NodeId, model: &const semantic.SemanticModel, specialization: i32) -> TypeId:
    if is_expression_kind(kind) or kind == SyntaxKind.NAME:
        return model.expr_type_for_specialization(id, specialization)
    if is_type_kind(kind):
        return model.type_node_for_specialization(id, specialization)
    return types.type_error()


def missing_ir_node() -> IRNodeId:
    return IRNodeId(index=-1)


def visit_summary(arena: &const SyntaxArena, id: NodeId, summary: &BackendSummary) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.FUNCTION_DECL:
        summary.function_count += 1
    elif node.kind == SyntaxKind.STRUCT_DECL:
        summary.struct_count += 1
    elif node.kind == SyntaxKind.CLASS_DECL:
        summary.class_count += 1
    elif node.kind == SyntaxKind.ENUM_DECL:
        summary.enum_count += 1
    elif node.kind == SyntaxKind.UNION_DECL:
        summary.union_count += 1
    elif node.kind == SyntaxKind.VARIANT_DECL:
        summary.variant_count += 1
    elif node.kind == SyntaxKind.EXTERN_BLOCK or node.kind == SyntaxKind.EXTERN_IMPORT_DECL:
        summary.extern_count += 1
    elif node.kind == SyntaxKind.GLOBAL_DECL:
        summary.global_count += 1
    elif is_statement_kind(node.kind):
        summary.statement_count += 1
    elif is_expression_kind(node.kind):
        summary.expression_count += 1
    elif is_type_kind(node.kind):
        summary.type_count += 1
    for offset in range(0, node.child_count):
        visit_summary(arena, arena.children[node.first_child + offset], summary)


def dump_summary(summary: BackendSummary) -> void:
    print(
        "B",
        summary.function_count,
        summary.struct_count,
        summary.class_count,
        summary.enum_count,
        summary.union_count,
        summary.variant_count,
        summary.extern_count,
        summary.global_count,
        summary.statement_count,
        summary.expression_count,
        summary.type_count,
        summary.node_count,
    )


def is_statement_kind(kind: SyntaxKind) -> bool:
    return kind == SyntaxKind.VAR_DECL_STMT or kind == SyntaxKind.ASSIGN_STMT or kind == SyntaxKind.EXPR_STMT or kind == SyntaxKind.IF_STMT or kind == SyntaxKind.IF_BRANCH or kind == SyntaxKind.WHILE_STMT or kind == SyntaxKind.FOR_EACH_STMT or kind == SyntaxKind.FOR_C_STMT or kind == SyntaxKind.MATCH_STMT or kind == SyntaxKind.MATCH_CASE or kind == SyntaxKind.RETURN_STMT or kind == SyntaxKind.BREAK_STMT or kind == SyntaxKind.CONTINUE_STMT or kind == SyntaxKind.PASS_STMT or kind == SyntaxKind.DEFER_STMT or kind == SyntaxKind.WITH_STMT or kind == SyntaxKind.UNSAFE_STMT


def is_expression_kind(kind: SyntaxKind) -> bool:
    return kind == SyntaxKind.EXPR_NAME or kind == SyntaxKind.EXPR_LITERAL or kind == SyntaxKind.EXPR_UNARY or kind == SyntaxKind.EXPR_BINARY or kind == SyntaxKind.EXPR_CALL or kind == SyntaxKind.EXPR_ARGUMENT or kind == SyntaxKind.EXPR_ATTRIBUTE or kind == SyntaxKind.EXPR_INDEX or kind == SyntaxKind.EXPR_SLICE or kind == SyntaxKind.EXPR_PROPAGATE or kind == SyntaxKind.EXPR_TUPLE or kind == SyntaxKind.EXPR_LIST or kind == SyntaxKind.EXPR_MAP or kind == SyntaxKind.EXPR_MAP_ENTRY or kind == SyntaxKind.EXPR_SET or kind == SyntaxKind.EXPR_CAST or kind == SyntaxKind.EXPR_ALLOC or kind == SyntaxKind.EXPR_FSTRING


def is_type_kind(kind: SyntaxKind) -> bool:
    return kind == SyntaxKind.TYPE_NAME or kind == SyntaxKind.TYPE_GENERIC or kind == SyntaxKind.TYPE_CONST or kind == SyntaxKind.TYPE_POINTER or kind == SyntaxKind.TYPE_REFERENCE or kind == SyntaxKind.TYPE_ARRAY or kind == SyntaxKind.TYPE_SLICE or kind == SyntaxKind.TYPE_DYN or kind == SyntaxKind.TYPE_FUNCTION or kind == SyntaxKind.TYPE_CLOSURE
