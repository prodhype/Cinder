import checker_core
import collections
import diagnostics
import generics
import lock_order
import ownership
import project
import semantic
import symbols
import syntax
import token
import types
from syntax import NodeId


def type_is_borrowed_for_transfer(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind == types.TypeKind.CONST:
            current = table.types[current.index].inner
            continue
        return kind == types.TypeKind.POINTER or kind == types.TypeKind.REFERENCE or kind == types.TypeKind.SLICE or kind == types.TypeKind.DYN or types.is_map_view_kind(kind)
    return false


def checker_type_needs_drop(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, type_id: types.TypeId, source: &const String) -> bool:
    seen: List[i32] = []
    return checker_type_needs_drop_inner(checker, arena, type_id, source, seen)


def checker_expression_is_derived_from_owned_temporary(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        return checker_type_needs_drop(checker, arena, checker.model.expr_type(id), source)
    if node.kind == syntax.SyntaxKind.EXPR_CAST:
        operand = checker_core.last_child(arena, id)
        if operand.index < 0:
            return false
        cast_type = checker.model.expr_type(id)
        operand_type = checker.model.expr_type(operand)
        if not checker.type_table.same(cast_type, operand_type):
            return false
        return checker_expression_is_derived_from_owned_temporary(checker, arena, operand, source)
    if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE or node.kind == syntax.SyntaxKind.EXPR_INDEX or node.kind == syntax.SyntaxKind.EXPR_SLICE:
        return checker_expression_is_derived_from_owned_temporary(checker, arena, checker_core.first_child(arena, id), source)
    return false


def type_is_string_reference(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind != types.TypeKind.REFERENCE:
        return false
    inner = types.strip_const(table, record.inner)
    return inner.index >= 0 and inner.index < cast[i32](len(table.types)) and table.types[inner.index].kind == types.TypeKind.STRING


def validate_temporary_reference_escape(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    argument: NodeId,
    destination_type: types.TypeId,
    source: &const String,
) -> void:
    if (
        not type_is_string_reference(&checker.type_table, checker.model.expr_type(call_id))
        or not type_is_string_reference(&checker.type_table, destination_type)
        or not checker_expression_is_derived_from_owned_temporary(checker, arena, argument, source)
    ):
        return
    emit_ownership_failure(
        checker,
        arena,
        diagnostics.DiagnosticId.CHECK_421,
        argument,
        checker.model.expr_type(argument),
        destination_type,
        source,
        "reference escape",
    )


def checker_type_can_clone(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if (
        record.kind == types.TypeKind.BOOL
        or record.kind == types.TypeKind.I32
        or record.kind == types.TypeKind.I64
        or record.kind == types.TypeKind.F64
        or record.kind == types.TypeKind.CHAR
        or record.kind == types.TypeKind.STRING
        or record.kind == types.TypeKind.ENUM
        or record.kind == types.TypeKind.LOCK
        or record.kind == types.TypeKind.I16
        or record.kind == types.TypeKind.U8
        or record.kind == types.TypeKind.USIZE
        or record.kind == types.TypeKind.POLL_FD
        or record.kind == types.TypeKind.NET_ERROR
        or record.kind == types.TypeKind.NET_ERROR_KIND
        or record.kind == types.TypeKind.POINTER
        or record.kind == types.TypeKind.REFERENCE
    ):
        return true
    if record.kind == types.TypeKind.CONST:
        return checker_type_can_clone(table, record.inner)
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.OPTION:
        return checker_type_can_clone(table, record.inner)
    if record.kind == types.TypeKind.MAP:
        return checker_type_can_clone(table, record.inner) and checker_type_can_clone(table, record.second)
    return false


def checker_named_scalar_can_clone(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        return checker_named_scalar_can_clone(table, record.inner, source)
    if record.kind != types.TypeKind.NAMED or record.flags != 0 or record.name_length == 0:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "i16" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def checker_type_needs_drop_inner(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, type_id: types.TypeId, source: &const String, seen: &List[i32]) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(checker.type_table.types)):
        return false
    record = checker.type_table.types[type_id.index]
    if record.kind == types.TypeKind.STRING or record.kind == types.TypeKind.STRING_BUILDER or record.kind == types.TypeKind.FILE or record.kind == types.TypeKind.SOCKET or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.SET:
        return true
    if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.SLICE or record.kind == types.TypeKind.DYN or types.is_map_view_kind(record.kind):
        return false
    if record.kind == types.TypeKind.CONST or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.OPTION:
        return checker_type_needs_drop_inner(checker, arena, record.inner, source, seen)
    if record.kind == types.TypeKind.CLOSURE:
        return checker_type_needs_drop_inner(checker, arena, record.second, source, seen)
    if record.kind == types.TypeKind.RESULT:
        return checker_type_needs_drop_inner(checker, arena, record.inner, source, seen) or checker_type_needs_drop_inner(checker, arena, record.second, source, seen)
    if record.kind == types.TypeKind.TUPLE:
        offset: i32 = 0
        while offset < record.flags:
            if checker_type_needs_drop_inner(checker, arena, checker.type_table.type_args[cast[usize](record.extra + offset)], source, seen):
                return true
            offset += 1
        return false
    if record.kind != types.TypeKind.STRUCT and record.kind != types.TypeKind.CLASS:
        return false
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), record.name_start, record.name_length)
    if owner.index < 0:
        return false
    seen_index: usize = 0
    while seen_index < len(seen):
        if seen[seen_index] == type_id.index:
            return false
        seen_index += 1
    seen.append(type_id.index)
    owner_symbol = checker.symbols.symbols[owner.index]
    if record.kind == types.TypeKind.CLASS:
        for member in checker.symbols.symbols:
            if member.scope.index == owner_symbol.member_scope.index and member.kind == symbols.SymbolKind.METHOD and checker_core.range_text_equals(source, member.name_start, member.name_length, "__del__"):
                return true
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, type_id)
    for member in checker.symbols.symbols:
        if member.scope.index != owner_symbol.member_scope.index or member.kind != symbols.SymbolKind.FIELD:
            continue
        field_type = member.type_id
        if len(args) > 0 and generics.has_type_params(arena, owner_symbol.node):
            field_type = generics.substitute_type(checker.type_table, field_type, arena, owner_symbol.node, &args, source)
        if checker_type_needs_drop_inner(checker, arena, field_type, source, seen):
            return true
    return false


def validate_partial_move_source(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expression: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    validate_partial_move_source_impl(
        checker,
        arena,
        expression,
        value_type,
        destination_type,
        source,
        current_scope,
        true,
    )


def validate_discarded_expression(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expression: NodeId,
    value_type: types.TypeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    validate_partial_move_source_impl(
        checker,
        arena,
        expression,
        value_type,
        value_type,
        source,
        current_scope,
        false,
    )


def validate_partial_move_source_impl(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expression: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    record_transfer: bool,
) -> void:
    if expression.index < 0:
        return
    if record_transfer:
        record_transfer_value_use(checker, expression, value_type, destination_type)
    if type_is_borrowed_for_transfer(checker.type_table, destination_type):
        return
    if ownership.type_contains_atomic_storage(&checker.type_table, value_type):
        id = diagnostics.DiagnosticId.CHECK_395
        if types.is_atomic_type(&checker.type_table, value_type):
            id = diagnostics.DiagnosticId.CHECK_399
        emit_ownership_failure(
            checker,
            arena,
            id,
            expression,
            value_type,
            destination_type,
            source,
            "transfer",
        )
        return
    kind = arena.nodes[expression.index].kind
    if kind == syntax.SyntaxKind.EXPR_SET:
        return
    if kind == syntax.SyntaxKind.EXPR_MAP:
        expression_node = arena.nodes[expression.index]
        for offset in range(0, expression_node.child_count):
            entry_id = arena.children[expression_node.first_child + offset]
            entry = arena.nodes[entry_id.index]
            if entry.kind == syntax.SyntaxKind.EXPR_MAP_ENTRY and entry.child_count > 1:
                value = arena.children[entry.first_child + 1]
                value_type = infer_expression_type(checker, arena, value, source, current_scope)
                validate_partial_move_source(checker, arena, value, value_type, value_type, source, current_scope)
        return
    if kind == syntax.SyntaxKind.EXPR_LIST or kind == syntax.SyntaxKind.EXPR_TUPLE:
        expression_node = arena.nodes[expression.index]
        for offset in range(0, expression_node.child_count):
            child_id = arena.children[expression_node.first_child + offset]
            child_type = infer_expression_type(checker, arena, child_id, source, current_scope)
            validate_partial_move_source(checker, arena, child_id, child_type, child_type, source, current_scope)
        return
    if kind == syntax.SyntaxKind.EXPR_NAME:
        node = arena.nodes[expression.index]
        found = symbols.missing_symbol()
        for binding: semantic.NodeSymbolBinding in checker.model.name_symbols:
            if binding.node.index == expression.index:
                found = binding.symbol
        if (
            found.index >= 0
            and checker.symbols.symbols[found.index].kind == symbols.SymbolKind.LOCAL
            and checker.symbols.symbols[found.index].flags == 1
            and checker_type_needs_drop(checker, arena, destination_type, source)
        ):
            emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_254,
                expression,
                value_type,
                destination_type,
                source,
                "move",
            )
        return
    if kind != syntax.SyntaxKind.EXPR_ATTRIBUTE and kind != syntax.SyntaxKind.EXPR_INDEX:
        return
    if not checker_type_needs_drop(checker, arena, value_type, source):
        return
    emit_ownership_failure(
        checker,
        arena,
        diagnostics.DiagnosticId.CHECK_254,
        expression,
        value_type,
        destination_type,
        source,
        "partial move",
    )


def record_transfer_value_use(
    checker: &checker_core.Checker,
    expression: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
) -> void:
    if destination_type.index == types.type_void().index:
        return
    kind = semantic.ValueUseKind.COPY
    if type_is_borrowed_for_transfer(checker.type_table, destination_type):
        kind = semantic.ValueUseKind.BORROW
    else:
        if value_type.index < 0 or value_type.index >= cast[i32](len(checker.type_table.types)):
            return
        type_values: &const List[types.TypeRecord] = &checker.type_table.types
        if type_values[value_type.index].kind == types.TypeKind.NAMED:
            return
        ownership_kind = ownership.ownership_kind(&checker.type_table, value_type)
        if ownership_kind == ownership.OwnershipKind.MOVE_ONLY:
            kind = semantic.ValueUseKind.MOVE
        elif ownership_kind == ownership.OwnershipKind.BORROWED:
            kind = semantic.ValueUseKind.BORROW
    symbol = symbols.missing_symbol()
    name_bindings: &const List[semantic.NodeSymbolBinding] = &checker.model.name_symbols
    for binding: semantic.NodeSymbolBinding in name_bindings:
        if binding.node.index == expression.index:
            symbol = binding.symbol
    checker.model.record_value_use(expression, kind, symbol, value_type, destination_type)


def emit_ownership_failure(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: diagnostics.DiagnosticId,
    expression: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
    source: &const String,
    transfer_kind: String,
) -> void:
    if expression.index < 0:
        return
    node = arena.nodes[expression.index]
    owner = source[node.start:node.start + node.length]
    previous_move = syntax.missing_node()
    value_uses: &const List[semantic.ValueUseResolution] = &checker.model.value_use_resolutions
    for use in value_uses:
        if use.node.index == expression.index:
            previous_move = use.previous_move
            if use.symbol.index >= 0 and use.symbol.index < cast[i32](len(checker.symbols.symbols)):
                owner_symbol = checker.symbols.symbols[use.symbol.index]
                owner = source[owner_symbol.name_start:owner_symbol.name_start + owner_symbol.name_length]
    transfer = transfer_kind[0:len(transfer_kind)]
    transfer.append(": ")
    transfer.append(types.display_type(&checker.type_table, value_type, source))
    transfer.append(" -> ")
    transfer.append(types.display_type(&checker.type_table, destination_type, source))
    diagnostic = diagnostics.diagnostic_with_three_arguments(
        id,
        checker_core.source_span_from_node(&node),
        diagnostics.argument_symbol("owner", owner),
        diagnostics.argument_text("transfer", transfer),
        diagnostics.argument_type("actual", types.display_type(&checker.type_table, value_type, source)),
    )
    if previous_move.index >= 0 and previous_move.index < cast[i32](len(arena.nodes)):
        diagnostic.add_related(
            diagnostics.related_span(
                "previous move occurred here",
                checker_core.source_span_from_node(&arena.nodes[previous_move.index]),
            )
        )
    checker_core.emit_diagnostic(checker, diagnostic)


def validate_call(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    call = arena.nodes[id.index]
    callee = checker_core.first_child(arena, id)
    if callee.index < 0:
        return
    callee_node = arena.nodes[callee.index]
    if callee_node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        if validate_path_namespace_call(checker, arena, id, callee, source, current_scope):
            return
        if validate_net_namespace_call(checker, arena, id, callee, source, current_scope):
            return
        if validate_socket_method_call(checker, arena, id, callee, source, current_scope):
            return
        if validate_atomic_method_call(checker, arena, id, callee, source, current_scope):
            return
        validate_collection_method_call(checker, arena, id, callee, source, current_scope)
        if checker.model.expr_type(id).index == types.type_error().index:
            validate_user_method_call(checker, arena, id, callee, source, current_scope)
        return
    if callee_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return
    if validate_net_named_call(checker, arena, id, callee, source, current_scope):
        return
    if direct_std_net_import_kind(checker, arena, callee, source, current_scope) == 4:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_422,
            &callee_node,
            source[callee_node.value_start:callee_node.value_start + callee_node.value_length],
        )
        checker.model.record_expr_type(id, types.type_error())
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "closure"):
        validate_closure_constructor(checker, arena, id, source, current_scope)
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "Owned"):
        validate_owned_constructor(checker, arena, id, callee, source, current_scope)
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "String"):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(id, types.type_string())
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "StringBuilder"):
        checker.model.record_expr_type(id, types.type_string_builder())
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "sorted"):
        validate_sorted_call(checker, arena, id, source, current_scope)
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "input") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "to_string"):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(id, types.type_string())
        return
    if is_parse_builtin_name(source, callee_node.value_start, callee_node.value_length):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        value_type = checker.type_table.resolve_type_name(
            source,
            callee_node.value_start + 6,
            callee_node.value_length - 6,
        )
        checker.model.record_expr_type(
            id,
            checker.type_table.generic2(
                types.TypeKind.RESULT,
                callee_node.value_start,
                callee_node.value_length,
                value_type,
                types.type_convert_error(),
            ),
        )
        return
    if is_reflection_builtin_name(source, callee_node.value_start, callee_node.value_length):
        if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "type_name"):
            checker.model.record_expr_type(id, types.type_string())
            return
        if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "has_field") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "has_method") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "implements"):
            checker.model.record_expr_type(id, types.type_bool())
            return
        checker.model.record_expr_type(id, types.type_i32())
        return
    if is_builtin_name(source, callee_node.value_start, callee_node.value_length):
        checker.model.record_expr_type(id, types.type_i32())
        return
    found = checker.symbols.find_in_scope(source, current_scope, callee_node.value_start, callee_node.value_length)
    if found.index < 0:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_048,
            &callee_node,
            source[callee_node.value_start:callee_node.value_start + callee_node.value_length],
        )
        return
    symbol = checker.symbols.symbols[found.index]
    if symbol.type_id.index >= 0 and symbol.type_id.index < cast[i32](len(checker.type_table.types)) and checker.type_table.types[symbol.type_id.index].kind == types.TypeKind.ATOMIC:
        for offset in range(1, call.child_count):
            child_id = arena.children[call.first_child + offset]
            child = arena.nodes[child_id.index]
            if checker_core.is_type_kind(child.kind):
                resolved_argument = checker_core.resolve_type_node(checker, arena, child_id, source)
                ignored_resolved_argument = resolved_argument
            elif child.kind == syntax.SyntaxKind.EXPR_ARGUMENT:
                argument_value = checker_core.last_child(arena, child_id)
                argument_type = infer_expression_type(checker, arena, argument_value, source, current_scope)
                ignored_argument_type = argument_type
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_359, &call)
        checker.model.record_expr_type(id, types.type_error())
        return
    if is_nominal_constructor_symbol(symbol.kind) or symbol.kind == symbols.SymbolKind.GLOBAL:
        checker.model.record_name_symbol(callee, found)
        checker.model.record_expr_type(id, symbol.type_id)
        if symbol.kind == symbols.SymbolKind.STRUCT or symbol.kind == symbols.SymbolKind.CLASS:
            validate_nominal_constructor_move_arguments(checker, arena, id, found, source, current_scope)
        return
    if symbol.type_id.index >= 0:
        callable_type = checker.type_table.types[symbol.type_id.index]
        if callable_type.kind == types.TypeKind.FUNCTION or callable_type.kind == types.TypeKind.CLOSURE:
            checker.model.record_name_symbol(callee, found)
            checker.model.record_call(id, found, callable_type.inner, 0)
            checker.model.record_expr_type(id, callable_type.inner)
            actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
            expected = callable_type.flags
            if actual < expected:
                checker_core.emit_argument_count_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_078,
                    &call,
                    expected,
                    actual,
                )
            elif actual > expected:
                checker_core.emit_argument_count_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_077,
                    &call,
                    expected,
                    actual,
                )
            validate_callable_call_move_arguments(checker, arena, id, callable_type, source, current_scope)
            return
    if symbol.kind == symbols.SymbolKind.LOCAL or symbol.kind == symbols.SymbolKind.PARAMETER or symbol.kind == symbols.SymbolKind.CONSTANT:
        checker.model.record_name_symbol(callee, found)
        checker.model.record_expr_type(id, types.type_i32())
        return
    if symbol.kind != symbols.SymbolKind.FUNCTION and symbol.kind != symbols.SymbolKind.FUNCTION_TEMPLATE:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_048,
            &callee_node,
            source[callee_node.value_start:callee_node.value_start + callee_node.value_length],
        )
        return
    checker.model.record_name_symbol(callee, found)
    checker.model.record_call(id, found, symbol.type_id, 0)
    checker.model.record_expr_type(id, symbol.type_id)
    if call.flags == 1:
        record_generic_call_specialization(checker, arena, id, source, found)
    elif symbol.kind == symbols.SymbolKind.FUNCTION_TEMPLATE:
        infer_generic_call_specialization(checker, arena, id, source, current_scope, found)
    validate_declared_call_move_arguments(checker, arena, id, symbol.node, source, current_scope, 0)
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    expected = symbol.flags
    if actual < expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_078,
            &call,
            expected,
            actual,
        )
    elif actual > expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_077,
            &call,
            expected,
            actual,
        )


def validate_path_namespace_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return false
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind == syntax.SyntaxKind.EXPR_NAME:
        found = checker.symbols.find_in_scope(source, current_scope, receiver_node.value_start, receiver_node.value_length)
        if found.index < 0:
            return false
        resolved = checker.symbols.symbols[found.index]
        if resolved.kind != symbols.SymbolKind.BUILTIN or resolved.node.index < 0 or arena.nodes[resolved.node.index].kind != syntax.SyntaxKind.IMPORT_NAME:
            return false
        receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
        matched = false
        module_imports: &const List[project.ImportBinding] = &checker.module_imports
        for imported in module_imports:
            if imported.alias == receiver_name and imported.virtual_builtin and imported.module_name == "std.path" and imported.member == "Path":
                matched = true
        if not matched:
            return false
        checker.model.record_name_symbol(receiver, found)
    elif not qualified_path_namespace_receiver_is_imported(checker, arena, receiver, source, current_scope):
        return false

    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    expected: i32 = 1
    result_type = types.type_void()
    if member_name == "exists" or member_name == "is_file" or member_name == "is_dir":
        result_type = types.type_bool()
    elif member_name == "parent" or member_name == "name" or member_name == "stem":
        result_type = types.type_string()
    elif member_name == "join" or member_name == "with_suffix":
        expected = 2
        result_type = types.type_string()
    elif member_name == "rename":
        expected = 2
    elif member_name != "create_dir" and member_name != "create_dir_all" and member_name != "remove_file":
        checker_core.emit_import_member_error(checker, &member_node, "std.path", member_name)
        checker.model.record_expr_type(call_id, types.type_error())
        return true

    call = arena.nodes[call_id.index]
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_078,
            &call,
            expected,
            actual,
        )
    elif actual > expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_077,
            &call,
            expected,
            actual,
        )

    seen_first = false
    seen_second = false
    seen_named = false
    source_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        role = source_index
        if argument.flags == 1:
            seen_named = true
            role = path_named_argument_index(arena, argument_id, source, &member_name)
        elif seen_named:
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_076, &argument)
        if role < 0 or role >= expected:
            checker_core.emit_symbol_error(
                checker,
                diagnostics.DiagnosticId.CHECK_048,
                &argument,
                source[argument.start:argument.start + argument.length],
            )
        elif role == 0:
            if seen_first:
                checker_core.emit_symbol_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_048,
                    &argument,
                    source[argument.start:argument.start + argument.length],
                )
            seen_first = true
        else:
            if seen_second:
                checker_core.emit_symbol_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_048,
                    &argument,
                    source[argument.start:argument.start + argument.length],
                )
            seen_second = true
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        if not path_argument_type_is_string(checker.type_table, value_type):
            value_node = arena.nodes[value.index]
            expected_type = checker.type_table.reference_to(
                checker.type_table.const_of(types.type_string())
            )
            checker_core.emit_type_mismatch(
                checker,
                &value_node,
                expected_type,
                value_type,
                source,
            )
        destination_type = checker.type_table.reference_to(checker.type_table.const_of(types.type_string()))
        record_transfer_value_use(checker, value, value_type, destination_type)
        source_index += 1

    checker.model.record_expr_type(callee_id, result_type)
    checker.model.record_expr_type(call_id, result_type)
    return true


def qualified_path_namespace_receiver_is_imported(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    receiver: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE:
        return false
    name = checker_core.first_child(arena, receiver)
    namespace = checker_core.second_child(arena, receiver)
    if name.index < 0 or namespace.index < 0:
        return false
    name_node = arena.nodes[name.index]
    namespace_node = arena.nodes[namespace.index]
    if (
        name_node.kind != syntax.SyntaxKind.EXPR_NAME
        or namespace_node.kind != syntax.SyntaxKind.NAME
        or not checker_core.range_text_equals(source, namespace_node.value_start, namespace_node.value_length, "Path")
    ):
        return false
    found = checker.symbols.find_in_scope(source, current_scope, name_node.value_start, name_node.value_length)
    if found.index < 0:
        return false
    resolved = checker.symbols.symbols[found.index]
    if (
        resolved.kind != symbols.SymbolKind.GLOBAL
        or resolved.node.index < 0
        or arena.nodes[resolved.node.index].kind != syntax.SyntaxKind.IMPORT_DECL
    ):
        return false

    receiver_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    module_imports: &const List[project.ImportBinding] = &checker.module_imports
    for imported in module_imports:
        if (
            imported.alias == receiver_name
            and imported.virtual_builtin
            and imported.module_name == "std.path"
            and len(imported.member) == 0
        ):
            checker.model.record_name_symbol(name, found)
            return true
    return false


def path_named_argument_index(
    arena: &const syntax.SyntaxArena,
    argument_id: NodeId,
    source: &const String,
    member_name: &const String,
) -> i32:
    name = checker_core.first_child(arena, argument_id)
    if name.index < 0:
        return -1
    name_node = arena.nodes[name.index]
    argument_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    if member_name == "join":
        if argument_name == "left":
            return 0
        if argument_name == "right":
            return 1
        return -1
    if member_name == "rename":
        if argument_name == "source":
            return 0
        if argument_name == "destination":
            return 1
        return -1
    if member_name == "with_suffix":
        if argument_name == "path":
            return 0
        if argument_name == "suffix":
            return 1
        return -1
    if argument_name == "path":
        return 0
    return -1


def path_argument_type_is_string(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = type_id
    indirection_depth: i32 = 0
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        record = table.types[current.index]
        if record.kind == types.TypeKind.CONST:
            current = record.inner
            continue
        if record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.POINTER:
            indirection_depth += 1
            if indirection_depth > 1:
                return false
            current = record.inner
            continue
        return record.kind == types.TypeKind.STRING
    return false


def virtual_net_namespace_receiver(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    receiver: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    if receiver.index < 0 or arena.nodes[receiver.index].kind != syntax.SyntaxKind.EXPR_NAME:
        return false
    receiver_node = arena.nodes[receiver.index]
    found = checker.symbols.find_in_scope(source, current_scope, receiver_node.value_start, receiver_node.value_length)
    if found.index < 0:
        return false
    resolved = checker.symbols.symbols[found.index]
    if resolved.kind != symbols.SymbolKind.GLOBAL or resolved.node.index < 0 or arena.nodes[resolved.node.index].kind != syntax.SyntaxKind.IMPORT_DECL:
        return false
    receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
    module_imports: &const List[project.ImportBinding] = &checker.module_imports
    for imported in module_imports:
        if imported.alias == receiver_name and imported.virtual_builtin and imported.module_name == "std.net" and len(imported.member) == 0:
            checker.model.record_name_symbol(receiver, found)
            return true
    return false


def net_result_type(checker: &checker_core.Checker, value_type: types.TypeId) -> types.TypeId:
    return checker.type_table.generic2(types.TypeKind.RESULT, 0, 0, value_type, types.type_net_error())


def direct_std_net_import_kind(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    callee: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> i32:
    if callee.index < 0 or arena.nodes[callee.index].kind != syntax.SyntaxKind.EXPR_NAME:
        return 0
    callee_node = arena.nodes[callee.index]
    found = checker.symbols.find_in_scope(source, current_scope, callee_node.value_start, callee_node.value_length)
    if found.index < 0:
        return 0
    resolved = checker.symbols.symbols[found.index]
    if resolved.node.index < 0 or arena.nodes[resolved.node.index].kind != syntax.SyntaxKind.IMPORT_NAME:
        return 0
    name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
    module_imports: &const List[project.ImportBinding] = &checker.module_imports
    for imported in module_imports:
        if imported.alias != name or not imported.virtual_builtin or imported.module_name != "std.net":
            continue
        if imported.member == "socket":
            return 1
        if imported.member == "poll":
            return 2
        if imported.member == "PollFd":
            return 3
        if imported.member == "Socket":
            return 4
    return 0


def validate_net_named_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    kind = direct_std_net_import_kind(checker, arena, callee, source, current_scope)
    if kind <= 0 or kind == 4:
        return false
    operation = "socket"
    minimum: i32 = 0
    maximum: i32 = 3
    result = net_result_type(checker, types.type_socket())
    if kind == 2:
        operation = "poll"
        minimum = 2
        maximum = 2
        result = net_result_type(checker, types.type_usize())
    elif kind == 3:
        operation = "PollFd"
        minimum = 2
        maximum = 2
        result = types.type_poll_fd()
    validate_net_call_arguments(checker, arena, call_id, source, current_scope, &operation, minimum, maximum)
    found = checker.symbols.find_in_scope(
        source,
        current_scope,
        arena.nodes[callee.index].value_start,
        arena.nodes[callee.index].value_length,
    )
    checker.model.record_name_symbol(callee, found)
    checker.model.record_expr_type(callee, result)
    checker.model.record_expr_type(call_id, result)
    return true


def validate_net_namespace_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0 or not virtual_net_namespace_receiver(checker, arena, receiver, source, current_scope):
        return false
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    minimum: i32 = 0
    maximum: i32 = 0
    result = types.type_error()
    if member_name == "socket":
        maximum = 3
        result = net_result_type(checker, types.type_socket())
    elif member_name == "PollFd":
        minimum = 2
        maximum = 2
        result = types.type_poll_fd()
    elif member_name == "poll":
        minimum = 2
        maximum = 2
        result = net_result_type(checker, types.type_usize())
    else:
        checker_core.emit_import_member_error(checker, &member_node, "std.net", member_name)
        checker.model.record_expr_type(call_id, types.type_error())
        return true
    validate_net_call_arguments(checker, arena, call_id, source, current_scope, &member_name, minimum, maximum)
    checker.model.record_expr_type(callee_id, result)
    checker.model.record_expr_type(call_id, result)
    return true


def validate_socket_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return false
    inferred_receiver_type = infer_expression_type(checker, arena, receiver, source, current_scope)
    receiver_is_const = net_socket_receiver_type_is_const(checker.type_table, inferred_receiver_type)
    receiver_type = strip_collection_indirection(checker.type_table, inferred_receiver_type)
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)) or checker.type_table.types[receiver_type.index].kind != types.TypeKind.SOCKET:
        return false
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    expected: i32 = 0
    result = types.type_error()
    if member_name == "bind" or member_name == "connect":
        expected = 2
        result = net_result_type(checker, types.type_void())
    elif member_name == "listen" or member_name == "recv" or member_name == "send" or member_name == "set_blocking":
        expected = 1
        if member_name == "recv" or member_name == "send":
            result = net_result_type(checker, types.type_usize())
        else:
            result = net_result_type(checker, types.type_void())
    elif member_name == "accept":
        result = net_result_type(checker, types.type_socket())
    elif member_name == "fileno":
        result = types.type_i32()
    elif member_name == "close":
        result = net_result_type(checker, types.type_void())
    else:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_402,
            &member_node,
            member_name[0:len(member_name)],
        )
        checker.model.record_expr_type(call_id, types.type_error())
        return true
    if receiver_is_const and member_name != "fileno":
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_423,
            &member_node,
            member_name[0:len(member_name)],
        )
    validate_net_call_arguments(checker, arena, call_id, source, current_scope, &member_name, expected, expected)
    receiver_symbol = symbols.missing_symbol()
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_symbol = checker.symbols.find_in_scope(source, current_scope, receiver_node.value_start, receiver_node.value_length)
    checker.model.record_value_use(receiver, semantic.ValueUseKind.ADDRESS, receiver_symbol, receiver_type, receiver_type)
    checker.model.record_expr_type(callee_id, result)
    checker.model.record_expr_type(call_id, result)
    return true


def net_socket_receiver_type_is_const(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        record = table.types[current.index]
        if record.kind == types.TypeKind.CONST:
            return true
        if record.kind != types.TypeKind.POINTER and record.kind != types.TypeKind.REFERENCE:
            return false
        current = record.inner
    return false


def validate_net_call_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    operation: &const String,
    minimum: i32,
    maximum: i32,
) -> void:
    call = arena.nodes[call_id.index]
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < minimum:
        checker_core.emit_argument_count_error(checker, diagnostics.DiagnosticId.CHECK_078, &call, minimum, actual)
    elif actual > maximum:
        checker_core.emit_argument_count_error(checker, diagnostics.DiagnosticId.CHECK_077, &call, maximum, actual)
    seen_first = false
    seen_second = false
    seen_third = false
    seen_named = false
    positional_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        role = positional_index
        if argument.flags == 1:
            seen_named = true
            role = net_named_argument_index(arena, argument_id, source, operation)
        else:
            if seen_named:
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_076, &argument)
            positional_index += 1
        duplicate = false
        if role == 0:
            duplicate = seen_first
            seen_first = true
        elif role == 1:
            duplicate = seen_second
            seen_second = true
        elif role == 2:
            duplicate = seen_third
            seen_third = true
        if role < 0 or role >= maximum or duplicate:
            checker_core.emit_symbol_error(
                checker,
                diagnostics.DiagnosticId.CHECK_048,
                &argument,
                source[argument.start:argument.start + argument.length],
            )
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        if role >= 0 and role < maximum:
            destination_type = net_argument_destination_type(checker, operation, role)
            if not net_argument_type_matches(checker, operation, role, value_type, source):
                value_node = arena.nodes[value.index]
                checker_core.emit_type_mismatch(checker, &value_node, destination_type, value_type, source)
            validate_partial_move_source(checker, arena, value, value_type, destination_type, source, current_scope)


def net_named_argument_index(arena: &const syntax.SyntaxArena, argument: NodeId, source: &const String, operation: &const String) -> i32:
    name = checker_core.first_child(arena, argument)
    if name.index < 0:
        return -1
    name_node = arena.nodes[name.index]
    argument_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    if operation == "socket":
        if argument_name == "family":
            return 0
        if argument_name == "type":
            return 1
        if argument_name == "protocol":
            return 2
        return -1
    if operation == "PollFd":
        if argument_name == "socket":
            return 0
        if argument_name == "events":
            return 1
        return -1
    if operation == "poll":
        if argument_name == "fds":
            return 0
        if argument_name == "timeout_ms":
            return 1
        return -1
    if operation == "bind" or operation == "connect":
        if argument_name == "host":
            return 0
        if argument_name == "port":
            return 1
        return -1
    if operation == "listen" and argument_name == "backlog":
        return 0
    if operation == "recv" and argument_name == "buffer":
        return 0
    if operation == "send" and argument_name == "data":
        return 0
    if operation == "set_blocking" and argument_name == "blocking":
        return 0
    return -1


def net_argument_destination_type(checker: &checker_core.Checker, operation: &const String, role: i32) -> types.TypeId:
    if operation == "PollFd":
        if role == 0:
            return checker.type_table.pointer_to(checker.type_table.const_of(types.type_socket()))
        return types.type_i16()
    if operation == "poll":
        if role == 0:
            return checker.type_table.slice_of(types.type_poll_fd())
        return types.type_i32()
    if operation == "bind" or operation == "connect":
        if role == 0:
            return checker.type_table.reference_to(checker.type_table.const_of(types.type_string()))
        return types.type_i32()
    if operation == "recv":
        return checker.type_table.slice_of(types.type_u8())
    if operation == "send":
        return checker.type_table.slice_of(checker.type_table.const_of(types.type_u8()))
    if operation == "set_blocking":
        return types.type_bool()
    if operation == "socket":
        return types.type_i32()
    return types.type_i32()


def net_argument_type_matches(checker: &const checker_core.Checker, operation: &const String, role: i32, actual: types.TypeId, source: &const String) -> bool:
    if operation == "socket":
        return net_type_is_integer(checker.type_table, actual, source)
    if operation == "PollFd":
        if role == 0:
            return net_type_is_socket_reference(checker.type_table, actual)
        return net_type_is_integer(checker.type_table, actual, source)
    if operation == "poll":
        if role == 0:
            return net_type_is_poll_fd_buffer(checker.type_table, actual)
        return types.strip_const(&checker.type_table, actual).index == types.type_i32().index
    if operation == "bind" or operation == "connect":
        if role == 0:
            return path_argument_type_is_string(checker.type_table, actual)
        return net_type_is_integer(checker.type_table, actual, source)
    if operation == "listen":
        return types.strip_const(&checker.type_table, actual).index == types.type_i32().index
    if operation == "recv":
        return net_type_is_byte_buffer(checker.type_table, actual, source, true)
    if operation == "send":
        return net_type_is_byte_buffer(checker.type_table, actual, source, false)
    if operation == "set_blocking":
        return types.strip_const(&checker.type_table, actual).index == types.type_bool().index
    return true


def net_type_is_integer(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind == types.TypeKind.I16 or record.kind == types.TypeKind.I32 or record.kind == types.TypeKind.I64 or record.kind == types.TypeKind.U8 or record.kind == types.TypeKind.USIZE:
        return true
    if record.kind != types.TypeKind.NAMED or record.flags != 0 or record.name_length == 0:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def net_type_is_socket_reference(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind != types.TypeKind.POINTER and record.kind != types.TypeKind.REFERENCE:
        return false
    return types.strip_const(table, record.inner).index == types.type_socket().index


def net_type_is_poll_fd_buffer(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = strip_collection_indirection(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind != types.TypeKind.LIST and record.kind != types.TypeKind.ARRAY and record.kind != types.TypeKind.SLICE:
        return false
    element = record.inner
    if element.index < 0 or element.index >= cast[i32](len(table.types)):
        return false
    if table.types[element.index].kind == types.TypeKind.CONST:
        return false
    return element.index == types.type_poll_fd().index


def net_type_is_byte_buffer(table: &const types.TypeTable, type_id: types.TypeId, source: &const String, mutable: bool) -> bool:
    current = strip_collection_indirection(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind != types.TypeKind.LIST and record.kind != types.TypeKind.ARRAY and record.kind != types.TypeKind.SLICE:
        return false
    element = record.inner
    if element.index < 0 or element.index >= cast[i32](len(table.types)):
        return false
    element_record = table.types[element.index]
    if mutable and element_record.kind == types.TypeKind.CONST:
        return false
    stripped = types.strip_const(table, element)
    if stripped.index == types.type_u8().index:
        return true
    if stripped.index < 0 or stripped.index >= cast[i32](len(table.types)):
        return false
    stripped_record = table.types[stripped.index]
    if stripped_record.kind != types.TypeKind.NAMED or stripped_record.flags != 0 or stripped_record.name_length == 0:
        return false
    return source[stripped_record.name_start:stripped_record.name_start + stripped_record.name_length] == "u8"


def validate_sorted_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    call = arena.nodes[id.index]
    argument_count = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    argument = call_argument_value(arena, id, 0)
    if argument_count != 1 or call_argument_is_named(arena, id, 0):
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_405,
            &call,
            1,
            argument_count,
        )
        checker.model.record_expr_type(id, collections.list_type(checker.type_table, types.type_error()))
        return
    argument_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, argument, source, current_scope))
    if argument_type.index < 0 or argument_type.index >= cast[i32](len(checker.type_table.types)):
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_406, &call)
        checker.model.record_expr_type(id, collections.list_type(checker.type_table, types.type_error()))
        return
    record = checker.type_table.types[argument_type.index]
    if record.kind != types.TypeKind.LIST and record.kind != types.TypeKind.ARRAY and record.kind != types.TypeKind.SLICE:
        argument_node = arena.nodes[argument.index]
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_406, &argument_node)
        checker.model.record_expr_type(id, collections.list_type(checker.type_table, types.type_error()))
        return
    element = types.strip_const(&checker.type_table, record.inner)
    if not semantic_type_is_sortable(checker.type_table, element, source):
        argument_node = arena.nodes[argument.index]
        checker_core.emit_actual_type_error(
            checker,
            diagnostics.DiagnosticId.CHECK_407,
            &argument_node,
            element,
            source,
        )
    if element.index == types.type_lock().index:
        checker.model.record_expr_type(id, checker.type_table.ordered_lock_list())
    else:
        checker.model.record_expr_type(id, collections.list_type(checker.type_table, element))


def call_argument_is_named(arena: &const syntax.SyntaxArena, call_id: NodeId, wanted: i32) -> bool:
    call = arena.nodes[call_id.index]
    seen: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind == syntax.SyntaxKind.EXPR_ARGUMENT:
            if seen == wanted:
                return argument.flags == 1
            seen += 1
    return false


def semantic_type_is_sortable(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    kind = table.types[current.index].kind
    return kind == types.TypeKind.BOOL or kind == types.TypeKind.STRING or kind == types.TypeKind.ENUM or kind == types.TypeKind.LOCK or semantic_type_is_numeric(table, current, source)


def validate_owned_constructor(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    callee: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    call = arena.nodes[id.index]
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < 1:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_078,
            &call,
            1,
            actual,
        )
        checker.model.record_expr_type(id, types.type_error())
        return
    if actual > 1:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_077,
            &call,
            1,
            actual,
        )
    argument = call_argument_value(arena, id, 0)
    payload_type = infer_expression_type(checker, arena, argument, source, current_scope)
    validate_partial_move_source(checker, arena, argument, payload_type, payload_type, source, current_scope)
    callee_node = arena.nodes[callee.index]
    result = checker.type_table.generic1(
        types.TypeKind.OWNED,
        callee_node.value_start,
        callee_node.value_length,
        payload_type,
    )
    checker.model.record_expr_type(id, result)


def validate_closure_constructor(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    call = arena.nodes[id.index]
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual != 2:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_378,
            &call,
            2,
            actual,
        )
        checker.model.record_expr_type(id, types.type_error())
        return
    for offset in range(0, call.child_count):
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.EXPR_ARGUMENT and child.flags == 1:
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_379, &child)
            checker.model.record_expr_type(id, types.type_error())
            return
    environment_expression = call_argument_value(arena, id, 0)
    adapter_expression = call_argument_value(arena, id, 1)
    environment_type = infer_expression_type(checker, arena, environment_expression, source, current_scope)
    if environment_type.index < 0 or environment_type.index >= cast[i32](len(checker.type_table.types)):
        checker.model.record_expr_type(id, types.type_error())
        return
    environment_record = checker.type_table.types[environment_type.index]
    if environment_record.kind != types.TypeKind.STRUCT:
        environment_node = arena.nodes[environment_expression.index]
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_380, &environment_node)
        checker.model.record_expr_type(id, types.type_error())
        return
    validate_partial_move_source(checker, arena, environment_expression, environment_type, environment_type, source, current_scope)
    if adapter_expression.index < 0:
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_node = arena.nodes[adapter_expression.index]
    if adapter_node.kind != syntax.SyntaxKind.EXPR_NAME:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_383, &adapter_node)
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_symbol_id = checker.symbols.find_in_scope(source, current_scope, adapter_node.value_start, adapter_node.value_length)
    if adapter_symbol_id.index < 0:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_048,
            &adapter_node,
            source[adapter_node.value_start:adapter_node.value_start + adapter_node.value_length],
        )
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_symbol = checker.symbols.symbols[adapter_symbol_id.index]
    if adapter_symbol.kind != symbols.SymbolKind.FUNCTION:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_383, &adapter_node)
        checker.model.record_expr_type(id, types.type_error())
        return
    declaration = arena.nodes[adapter_symbol.node.index]
    adapter_args: List[types.TypeId] = []
    visible_args: List[types.TypeId] = []
    closure_environment = types.type_error()
    parameter_index: i32 = 0
    for offset in range(0, declaration.child_count):
        parameter_id = arena.children[declaration.first_child + offset]
        parameter = arena.nodes[parameter_id.index]
        if parameter.kind != syntax.SyntaxKind.PARAMETER:
            continue
        parameter_type = checker_core.resolve_declared_type_or_default(checker, arena, parameter_id, source, types.type_i32())
        adapter_args.append(parameter_type)
        if parameter_index == 0:
            if parameter_type.index < 0 or parameter_type.index >= cast[i32](len(checker.type_table.types)) or checker.type_table.types[parameter_type.index].kind != types.TypeKind.REFERENCE:
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_385, &parameter)
                checker.model.record_expr_type(id, types.type_error())
                return
            closure_environment = checker.type_table.types[parameter_type.index].inner
        else:
            visible_args.append(parameter_type)
        parameter_index += 1
    if parameter_index == 0:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_384, &adapter_node)
        checker.model.record_expr_type(id, types.type_error())
        return
    expected_environment = strip_const_type(checker.type_table, closure_environment)
    if not closure_environment_types_match(checker.type_table, expected_environment, environment_type, source):
        environment_node = arena.nodes[environment_expression.index]
        checker_core.emit_type_mismatch(
            checker,
            &environment_node,
            expected_environment,
            environment_type,
            source,
        )
    adapter_type = checker.type_table.function_from_args(adapter_args, adapter_symbol.type_id)
    checker.model.record_name_symbol(adapter_expression, adapter_symbol_id)
    checker.model.record_expr_type(adapter_expression, adapter_type)
    closure_type = checker.type_table.closure_from_args(closure_environment, visible_args, adapter_symbol.type_id)
    checker.model.record_call(id, adapter_symbol_id, closure_type, 1)
    checker.model.record_expr_type(id, closure_type)


def validate_atomic_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return false
    receiver_type = infer_expression_type(checker, arena, receiver, source, current_scope)
    current = receiver_type
    flags: i32 = 1
    pointer_receiver = false
    indirection_count: i32 = 0
    while current.index >= 0 and current.index < cast[i32](len(checker.type_table.types)):
        record = checker.type_table.types[current.index]
        if record.kind == types.TypeKind.CONST:
            flags = flags | 2
            current = record.inner
            continue
        if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE:
            pointer_receiver = true
            indirection_count += 1
            flags = flags | 16
            current = record.inner
            continue
        break
    if current.index < 0 or current.index >= cast[i32](len(checker.type_table.types)):
        return false
    atomic_record = checker.type_table.types[current.index]
    if atomic_record.kind != types.TypeKind.ATOMIC:
        return false
    if indirection_count > 1:
        receiver_node = arena.nodes[receiver.index]
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &receiver_node)
        checker.model.record_expr_type(call_id, types.type_error())
        return true

    call = arena.nodes[call_id.index]
    if call.flags == 1:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &call)
    member_node = arena.nodes[member.index]
    kind = atomic_intrinsic_kind(source, &member_node)
    if kind == semantic.AtomicIntrinsicKind.NONE:
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_402,
            &member_node,
            source[member_node.value_start:member_node.value_start + member_node.value_length],
        )
        checker.model.record_expr_type(call_id, types.type_error())
        return true
    if not pointer_receiver and not atomic_receiver_is_addressable(arena, receiver):
        receiver_node = arena.nodes[receiver.index]
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &receiver_node)
    if kind != semantic.AtomicIntrinsicKind.LOAD and (flags & 2) != 0:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &member_node)

    element_kind = types.atomic_type_element_kind(&checker.type_table, current)
    if is_atomic_fetch_intrinsic(kind) and not types.atomic_element_is_integer(element_kind):
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &member_node)

    expected: i32 = 1
    result_type = atomic_record.inner
    if kind == semantic.AtomicIntrinsicKind.LOAD:
        expected = 0
    elif kind == semantic.AtomicIntrinsicKind.STORE:
        result_type = types.type_void()
    elif kind == semantic.AtomicIntrinsicKind.COMPARE_EXCHANGE:
        expected = 2
        result_type = checker.type_table.atomic_compare_exchange_result(atomic_record.inner, element_kind)
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_403,
            &call,
            expected,
            actual,
        )
        checker.model.record_expr_type(call_id, types.type_error())
        return true
    if actual > expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_403,
            &call,
            expected,
            actual,
        )
        checker.model.record_expr_type(call_id, types.type_error())
        return true

    operand0 = syntax.missing_node()
    operand1 = syntax.missing_node()
    first_evaluated = syntax.missing_node()
    second_evaluated = syntax.missing_node()
    first_role = semantic.AtomicArgumentRole.NONE
    second_role = semantic.AtomicArgumentRole.NONE
    source_index: i32 = 0
    seen_named = false
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        if argument.flags == 1:
            seen_named = true
        elif seen_named:
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_076, &argument)
        role = semantic.AtomicArgumentRole.VALUE
        if kind == semantic.AtomicIntrinsicKind.COMPARE_EXCHANGE:
            if argument.flags == 1:
                role = compare_exchange_argument_role(arena, argument_id, source)
            elif operand0.index < 0:
                role = semantic.AtomicArgumentRole.EXPECTED
            else:
                role = semantic.AtomicArgumentRole.DESIRED
            if role == semantic.AtomicArgumentRole.NONE:
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &argument)
            elif role == semantic.AtomicArgumentRole.EXPECTED:
                if operand0.index >= 0:
                    checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &argument)
                operand0 = value
            elif role == semantic.AtomicArgumentRole.DESIRED:
                if operand1.index >= 0:
                    checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &argument)
                operand1 = value
        else:
            if argument.flags == 1 and not atomic_argument_name_is(arena, argument_id, source, "value"):
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_403, &argument)
            operand0 = value
        if source_index == 0:
            first_evaluated = value
            first_role = role
        else:
            second_evaluated = value
            second_role = role
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        value_node = arena.nodes[value.index]
        if types.is_atomic_type(&checker.type_table, value_type):
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_400,
                &value_node,
                value_type,
                source,
            )
        elif not atomic_value_type_is_compatible(checker, element_kind, value_type, source):
            checker_core.emit_type_mismatch(
                checker,
                &value_node,
                atomic_record.inner,
                value_type,
                source,
            )
        source_index += 1
    if expected == 2 and (operand0.index < 0 or operand1.index < 0):
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_403,
            &call,
            expected,
            actual,
        )

    receiver_symbol = symbols.missing_symbol()
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_symbol = checker.symbols.find_in_scope(source, current_scope, receiver_node.value_start, receiver_node.value_length)
    checker.model.record_value_use(receiver, semantic.ValueUseKind.ADDRESS, receiver_symbol, current, current)
    checker.model.record_atomic_intrinsic(
        call_id,
        kind,
        element_kind,
        current,
        atomic_record.inner,
        result_type,
        receiver,
        operand0,
        operand1,
        first_evaluated,
        second_evaluated,
        first_role,
        second_role,
        flags,
    )
    checker.model.record_expr_type(callee_id, result_type)
    checker.model.record_expr_type(call_id, result_type)
    return true


def atomic_intrinsic_kind(source: &const String, member: &const syntax.SyntaxNode) -> semantic.AtomicIntrinsicKind:
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "load"):
        return semantic.AtomicIntrinsicKind.LOAD
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "store"):
        return semantic.AtomicIntrinsicKind.STORE
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "exchange"):
        return semantic.AtomicIntrinsicKind.EXCHANGE
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "compare_exchange"):
        return semantic.AtomicIntrinsicKind.COMPARE_EXCHANGE
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "fetch_add"):
        return semantic.AtomicIntrinsicKind.FETCH_ADD
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "fetch_sub"):
        return semantic.AtomicIntrinsicKind.FETCH_SUB
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "fetch_and"):
        return semantic.AtomicIntrinsicKind.FETCH_AND
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "fetch_or"):
        return semantic.AtomicIntrinsicKind.FETCH_OR
    if checker_core.range_text_equals(source, member.value_start, member.value_length, "fetch_xor"):
        return semantic.AtomicIntrinsicKind.FETCH_XOR
    return semantic.AtomicIntrinsicKind.NONE


def is_atomic_fetch_intrinsic(kind: semantic.AtomicIntrinsicKind) -> bool:
    return kind == semantic.AtomicIntrinsicKind.FETCH_ADD or kind == semantic.AtomicIntrinsicKind.FETCH_SUB or kind == semantic.AtomicIntrinsicKind.FETCH_AND or kind == semantic.AtomicIntrinsicKind.FETCH_OR or kind == semantic.AtomicIntrinsicKind.FETCH_XOR


def atomic_receiver_is_addressable(arena: &const syntax.SyntaxArena, id: NodeId) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_NAME or node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE or node.kind == syntax.SyntaxKind.EXPR_INDEX:
        return true
    return node.kind == syntax.SyntaxKind.EXPR_UNARY and node.flags == cast[i32](token.TokenKind.STAR)


def atomic_argument_name_is(arena: &const syntax.SyntaxArena, argument: NodeId, source: &const String, expected: String) -> bool:
    name = checker_core.first_child(arena, argument)
    if name.index < 0:
        return false
    node = arena.nodes[name.index]
    return checker_core.range_text_equals(source, node.value_start, node.value_length, expected)


def compare_exchange_argument_role(arena: &const syntax.SyntaxArena, argument: NodeId, source: &const String) -> semantic.AtomicArgumentRole:
    if atomic_argument_name_is(arena, argument, source, "expected"):
        return semantic.AtomicArgumentRole.EXPECTED
    if atomic_argument_name_is(arena, argument, source, "desired"):
        return semantic.AtomicArgumentRole.DESIRED
    return semantic.AtomicArgumentRole.NONE


def call_argument_value(arena: &const syntax.SyntaxArena, id: NodeId, argument_index: i32) -> NodeId:
    call = arena.nodes[id.index]
    seen: i32 = 0
    for offset in range(0, call.child_count):
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.EXPR_ARGUMENT:
            if seen == argument_index:
                return checker_core.last_child(arena, child_id)
            seen += 1
    return syntax.missing_node()


def declaration_parameter_at(arena: &const syntax.SyntaxArena, declaration: NodeId, wanted: i32) -> NodeId:
    if declaration.index < 0:
        return syntax.missing_node()
    node = arena.nodes[declaration.index]
    seen: i32 = 0
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind == syntax.SyntaxKind.PARAMETER:
            if seen == wanted:
                return child_id
            seen += 1
    return syntax.missing_node()


def is_mutable_reference_type(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if record.kind != types.TypeKind.REFERENCE:
        return false
    if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
        return true
    return table.types[record.inner.index].kind != types.TypeKind.CONST


def validate_ordered_lock_element_mutation(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expression: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    if expression.index < 0:
        return
    expression_node = arena.nodes[expression.index]
    if expression_node.kind != syntax.SyntaxKind.EXPR_INDEX:
        return
    collection = checker_core.first_child(arena, expression)
    collection_type = infer_expression_type(checker, arena, collection, source, current_scope)
    if types.is_ordered_lock_list(&checker.type_table, collection_type):
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_419, &expression_node)


def validate_atomic_call_argument_type(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    value: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
    source: &const String,
) -> void:
    if value.index < 0:
        return
    if checker_core.type_is_unbound_parameter(checker, destination_type, source) or checker_core.type_is_unbound_parameter(checker, value_type, source):
        return
    expected_atomic = semantic_type_is_kind(checker.type_table, destination_type, types.TypeKind.ATOMIC)
    if not expected_atomic:
        return
    if types_compatible(checker, destination_type, value_type):
        return
    node = arena.nodes[value.index]
    checker_core.emit_type_mismatch(checker, &node, destination_type, value_type, source)


def validate_declared_call_move_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    declaration: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    skipped_parameters: i32,
) -> void:
    call = arena.nodes[call_id.index]
    argument_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        parameter = declaration_parameter_at(arena, declaration, argument_index + skipped_parameters)
        destination_type = value_type
        if parameter.index >= 0:
            destination_type = checker_core.resolve_declared_type_or_default(checker, arena, parameter, source, value_type)
        validate_temporary_reference_escape(checker, arena, call_id, value, destination_type, source)
        if is_mutable_reference_type(&checker.type_table, destination_type):
            validate_ordered_lock_element_mutation(checker, arena, value, source, current_scope)
        validate_atomic_call_argument_type(checker, arena, value, value_type, destination_type, source)
        validate_partial_move_source(checker, arena, value, value_type, destination_type, source, current_scope)
        argument_index += 1


def validate_callable_call_move_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callable_type: types.TypeRecord,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    call = arena.nodes[call_id.index]
    argument_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        if arena.nodes[argument_id.index].kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        destination_type = generic_actual_argument(checker.type_table, callable_type, argument_index)
        if destination_type.index < 0:
            destination_type = value_type
        validate_temporary_reference_escape(checker, arena, call_id, value, destination_type, source)
        if is_mutable_reference_type(&checker.type_table, destination_type):
            validate_ordered_lock_element_mutation(checker, arena, value, source, current_scope)
        validate_atomic_call_argument_type(checker, arena, value, value_type, destination_type, source)
        validate_partial_move_source(checker, arena, value, value_type, destination_type, source, current_scope)
        argument_index += 1


def nominal_constructor_parameter(
    checker: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    owner: symbols.SymbolId,
    argument_id: NodeId,
    positional_index: i32,
    source: &const String,
) -> NodeId:
    owner_symbol = checker.symbols.symbols[owner.index]
    argument = arena.nodes[argument_id.index]
    if argument.flags == 1:
        name = checker_core.first_child(arena, argument_id)
        if name.index >= 0:
            name_node = arena.nodes[name.index]
            field = checker.symbols.find_in_current_scope(source, owner_symbol.member_scope, name_node.value_start, name_node.value_length)
            if field.index >= 0 and checker.symbols.symbols[field.index].kind == symbols.SymbolKind.FIELD:
                return checker.symbols.symbols[field.index].node
        return syntax.missing_node()
    seen: i32 = 0
    for field in checker.symbols.symbols:
        if field.scope.index == owner_symbol.member_scope.index and field.kind == symbols.SymbolKind.FIELD:
            if seen == positional_index:
                return field.node
            seen += 1
    return syntax.missing_node()


def nominal_initializer_declaration(checker: &const checker_core.Checker, owner: symbols.SymbolId, source: &const String) -> NodeId:
    owner_symbol = checker.symbols.symbols[owner.index]
    for member in checker.symbols.symbols:
        if member.scope.index == owner_symbol.member_scope.index and member.kind == symbols.SymbolKind.METHOD and checker_core.range_text_equals(source, member.name_start, member.name_length, "__init__"):
            return member.node
    return syntax.missing_node()


def validate_nominal_constructor_move_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    owner: symbols.SymbolId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    owner_symbol = checker.symbols.symbols[owner.index]
    if owner_symbol.kind == symbols.SymbolKind.CLASS:
        initializer = nominal_initializer_declaration(checker, owner, source)
        if initializer.index >= 0:
            validate_declared_call_move_arguments(checker, arena, call_id, initializer, source, current_scope, 1)
        return
    call = arena.nodes[call_id.index]
    positional_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        field = nominal_constructor_parameter(checker, arena, owner, argument_id, positional_index, source)
        destination_type = value_type
        if field.index >= 0:
            destination_type = checker_core.resolve_declared_type_or_default(checker, arena, field, source, value_type)
        validate_partial_move_source(checker, arena, value, value_type, destination_type, source, current_scope)
        if argument.flags == 0:
            positional_index += 1


def strip_const_type(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    if type_id.index >= 0 and type_id.index < cast[i32](len(table.types)) and table.types[type_id.index].kind == types.TypeKind.CONST:
        return table.types[type_id.index].inner
    return type_id


def closure_environment_types_match(table: &const types.TypeTable, expected: types.TypeId, actual: types.TypeId, source: &const String) -> bool:
    if table.same(expected, actual):
        return true
    if expected.index < 0 or actual.index < 0 or expected.index >= cast[i32](len(table.types)) or actual.index >= cast[i32](len(table.types)):
        return false
    expected_record = table.types[expected.index]
    actual_record = table.types[actual.index]
    if expected_record.name_length == 0 or actual_record.name_length == 0:
        return false
    return symbols.range_equals(source, expected_record.name_start, expected_record.name_length, actual_record.name_start, actual_record.name_length)


def is_nominal_constructor_symbol(kind: symbols.SymbolKind) -> bool:
    return kind == symbols.SymbolKind.STRUCT or kind == symbols.SymbolKind.CLASS or kind == symbols.SymbolKind.ENUM or kind == symbols.SymbolKind.UNION or kind == symbols.SymbolKind.VARIANT or kind == symbols.SymbolKind.EXTERN_TYPE


def record_generic_call_specialization(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, callee: symbols.SymbolId) -> void:
    call = arena.nodes[id.index]
    args: List[types.TypeId] = []
    offset: i32 = 1
    while offset < call.child_count:
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if checker_core.is_type_kind(child.kind):
            type_id = checker_core.resolve_type_node(checker, arena, child_id, source)
            checker.model.record_type_node(child_id, type_id)
            args.append(type_id)
        offset += 1
    declaration = checker.symbols.symbols[callee.index].node
    expected_count = generics.type_param_count(arena, declaration)
    actual_count = cast[i32](len(args))
    if actual_count != expected_count:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_354,
            &call,
            expected_count,
            actual_count,
        )
        return
    suffix = generics.specialization_suffix(checker.type_table, &args, source)
    user_suffix = suffix[0:len(suffix)]
    checker.model.record_specialization(id, callee, &args, suffix)
    checker.model.record_user_specialization(declaration, &args, user_suffix)
    specialized_return = generics.substitute_type(checker.type_table, checker.symbols.symbols[callee.index].type_id, arena, declaration, &args, source)
    checker.model.record_call(id, callee, specialized_return, 1)
    checker.model.record_expr_type(id, specialized_return)


def record_user_type_specialization(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count <= 1:
        return
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    found = checker.symbols.find_in_scope(source, symbols.root_scope(), base.value_start, base.value_length)
    if found.index < 0:
        return
    declaration = checker.symbols.symbols[found.index].node
    if not generics.has_type_params(arena, declaration):
        return
    type_id = checker_core.resolve_type_node(checker, arena, id, source)
    checker.model.record_type_node(id, type_id)
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, type_id)
    arg_index: usize = 0
    while arg_index < len(args):
        arg = args[arg_index]
        if generics.contains_type_parameter(checker.type_table, arg, arena, declaration, source):
            return
        arg_index += 1
    suffix = generics.specialization_suffix(checker.type_table, &args, source)
    checker.model.record_user_specialization(declaration, &args, suffix)


def validate_user_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)):
        return
    receiver_record = checker.type_table.types[receiver_type.index]
    if not types.is_nominal_kind(receiver_record.kind) or receiver_record.name_length == 0:
        return
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), receiver_record.name_start, receiver_record.name_length)
    if owner.index < 0:
        return
    member_scope = checker.symbols.symbols[owner.index].member_scope
    member_node = arena.nodes[member.index]
    method = checker.symbols.find_in_current_scope(source, member_scope, member_node.value_start, member_node.value_length)
    if method.index < 0 or checker.symbols.symbols[method.index].kind != symbols.SymbolKind.METHOD:
        return
    declaration = checker.symbols.symbols[owner.index].node
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, receiver_type)
    return_type = checker.symbols.symbols[method.index].type_id
    if len(args) > 0 and generics.has_type_params(arena, declaration):
        return_type = generics.substitute_type(checker.type_table, return_type, arena, declaration, &args, source)
    checker.model.record_name_symbol(member, method)
    checker.model.record_call(call_id, method, return_type, 0)
    checker.model.record_expr_type(call_id, return_type)
    expected = checker.symbols.symbols[method.index].arity - 1
    if expected < 0:
        expected = 0
    validate_collection_method_argument_count(checker, arena, call_id, expected)
    validate_declared_call_move_arguments(checker, arena, call_id, checker.symbols.symbols[method.index].node, source, current_scope, 1)


def infer_generic_call_specialization(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    callee: symbols.SymbolId,
) -> void:
    declaration = checker.symbols.symbols[callee.index].node
    params: List[NodeId] = generics.collect_type_params(arena, declaration)
    inferred: List[types.TypeId] = []
    param_offset: usize = 0
    while param_offset < len(params):
        inferred.append(types.missing_type())
        param_offset += 1
    function = arena.nodes[declaration.index]
    parameter_index: i32 = 0
    for declaration_offset in range(0, function.child_count):
        parameter_id = arena.children[function.first_child + declaration_offset]
        parameter = arena.nodes[parameter_id.index]
        if parameter.kind != syntax.SyntaxKind.PARAMETER:
            continue
        argument = call_argument_value(arena, call_id, parameter_index)
        if argument.index >= 0:
            actual = infer_expression_type(checker, arena, argument, source, current_scope)
            pattern = checker_core.find_child_type(arena, parameter_id)
            infer_type_arguments_from_pattern(checker, arena, declaration, pattern, actual, &inferred, source)
        parameter_index += 1
    inferred_index: usize = 0
    while inferred_index < len(inferred):
        inferred_type = inferred[inferred_index]
        if inferred_type.index < 0 or inferred_type.index == types.type_error().index:
            call_node = arena.nodes[call_id.index]
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_355, &call_node)
            return
        inferred_index += 1
    suffix = generics.specialization_suffix(checker.type_table, &inferred, source)
    user_suffix = suffix[0:len(suffix)]
    checker.model.record_specialization(call_id, callee, &inferred, suffix)
    checker.model.record_user_specialization(declaration, &inferred, user_suffix)
    specialized_return = generics.substitute_type(checker.type_table, checker.symbols.symbols[callee.index].type_id, arena, declaration, &inferred, source)
    checker.model.record_call(call_id, callee, specialized_return, 1)
    checker.model.record_expr_type(call_id, specialized_return)


def infer_type_arguments_from_pattern(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    declaration: NodeId,
    pattern: NodeId,
    actual: types.TypeId,
    inferred: &List[types.TypeId],
    source: &const String,
) -> void:
    if pattern.index < 0 or actual.index < 0 or actual.index >= cast[i32](len(checker.type_table.types)):
        return
    pattern_node = arena.nodes[pattern.index]
    if pattern_node.kind == syntax.SyntaxKind.TYPE_NAME:
        parameter = generics.type_parameter_index(arena, declaration, source, pattern_node.value_start, pattern_node.value_length)
        if parameter >= 0 and parameter < cast[i32](len(inferred)):
            existing = inferred[cast[usize](parameter)]
            if existing.index < 0:
                inferred[cast[usize](parameter)] = actual
            elif not checker.type_table.same(existing, actual):
                pattern_span = arena.nodes[pattern.index]
                checker_core.emit_type_mismatch(
                    checker,
                    &pattern_span,
                    existing,
                    actual,
                    source,
                )
        return
    actual_record = checker.type_table.types[actual.index]
    if pattern_node.kind == syntax.SyntaxKind.TYPE_POINTER or pattern_node.kind == syntax.SyntaxKind.TYPE_REFERENCE or pattern_node.kind == syntax.SyntaxKind.TYPE_CONST or pattern_node.kind == syntax.SyntaxKind.TYPE_SLICE or pattern_node.kind == syntax.SyntaxKind.TYPE_ARRAY or pattern_node.kind == syntax.SyntaxKind.TYPE_DYN:
        infer_type_arguments_from_pattern(checker, arena, declaration, checker_core.first_child(arena, pattern), actual_record.inner, inferred, source)
        return
    if pattern_node.kind != syntax.SyntaxKind.TYPE_GENERIC:
        return
    offset: i32 = 1
    while offset < pattern_node.child_count:
        actual_argument = generic_actual_argument(checker.type_table, actual_record, offset - 1)
        infer_type_arguments_from_pattern(checker, arena, declaration, arena.children[pattern_node.first_child + offset], actual_argument, inferred, source)
        offset += 1


def generic_actual_argument(table: &const types.TypeTable, record: types.TypeRecord, index: i32) -> types.TypeId:
    if index < 0:
        return types.missing_type()
    if record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.RESULT:
        if index == 0:
            return record.inner
        if index == 1:
            return record.second
        return types.missing_type()
    if record.kind == types.TypeKind.OPTION or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        if index == 0:
            return record.inner
        return types.missing_type()
    if record.kind == types.TypeKind.ATOMIC:
        if index == 0:
            return record.inner
        return types.missing_type()
    if index < record.flags:
        return table.type_args[cast[usize](record.extra + index)]
    return types.missing_type()


def infer_expression_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    if id.index < 0:
        return types.type_error()
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_INDEX:
        receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope))
        if receiver_type.index >= 0 and receiver_type.index < cast[i32](len(checker.type_table.types)) and checker.type_table.types[receiver_type.index].kind == types.TypeKind.STRING:
            emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_420,
                id,
                receiver_type,
                receiver_type,
                source,
                "index",
            )
            checker.model.record_expr_type(id, types.type_error())
            return types.type_error()
    existing = checker.model.expr_type(id)
    if existing.index != types.type_error().index and checker.specialization_declaration.index < 0:
        return existing
    result = types.type_error()
    if node.kind == syntax.SyntaxKind.EXPR_LITERAL:
        if node.flags == cast[i32](token.TokenKind.TRUE) or node.flags == cast[i32](token.TokenKind.FALSE):
            result = types.type_bool()
        elif node.flags == cast[i32](token.TokenKind.STRING):
            result = types.type_string()
        elif node.flags == cast[i32](token.TokenKind.CHAR):
            result = types.type_char()
        elif node.flags == cast[i32](token.TokenKind.FLOAT):
            result = types.type_f64()
        elif node.flags == cast[i32](token.TokenKind.NULL) or node.flags == cast[i32](token.TokenKind.NONE):
            result = types.type_error()
        else:
            result = types.type_i32()
    elif node.kind == syntax.SyntaxKind.EXPR_NAME:
        found = checker.symbols.find_in_scope(source, current_scope, node.value_start, node.value_length)
        if found.index >= 0:
            checker.model.record_name_symbol(id, found)
            result = checker.symbols.symbols[found.index].type_id
    elif node.kind == syntax.SyntaxKind.EXPR_CALL:
        validate_call(checker, arena, id, source, current_scope)
        result = checker.model.expr_type(id)
    elif node.kind == syntax.SyntaxKind.EXPR_PROPAGATE:
        operand = checker_core.first_child(arena, id)
        operand_type = infer_expression_type(checker, arena, operand, source, current_scope)
        if operand_type.index >= 0 and operand_type.index < cast[i32](len(checker.type_table.types)):
            operand_record = checker.type_table.types[operand_type.index]
            if operand_record.kind == types.TypeKind.RESULT:
                result = operand_record.inner
    elif node.kind == syntax.SyntaxKind.EXPR_CAST:
        type_node = checker_core.find_child_type(arena, id)
        result = checker_core.resolve_type_node(checker, arena, type_node, source)
        checker.model.record_type_node(type_node, result)
        if node.child_count > 1:
            operand = arena.children[node.first_child + 1]
            operand_type = infer_expression_type(checker, arena, operand, source, current_scope)
            if types.is_atomic_type(&checker.type_table, operand_type):
                operand_node = arena.nodes[operand.index]
                checker_core.emit_actual_type_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_400,
                    &operand_node,
                    operand_type,
                    source,
                )
                result = types.type_error()
    elif node.kind == syntax.SyntaxKind.EXPR_LIST:
        result = infer_list_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_MAP:
        result = infer_map_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_SET:
        result = infer_set_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_TUPLE:
        result = infer_tuple_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_INDEX:
        receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope))
        result = indexed_element_type(checker.type_table, arena, checker_core.second_child(arena, id), source, receiver_type)
    elif node.kind == syntax.SyntaxKind.EXPR_SLICE:
        result = infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        result = infer_attribute_expression_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_UNARY:
        operand = checker_core.first_child(arena, id)
        operand_type = infer_expression_type(checker, arena, operand, source, current_scope)
        result = operand_type
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            operand_is_owned_temporary = checker_expression_is_derived_from_owned_temporary(checker, arena, operand, source)
            if operand_is_owned_temporary:
                emit_ownership_failure(
                    checker,
                    arena,
                    diagnostics.DiagnosticId.CHECK_421,
                    id,
                    operand_type,
                    operand_type,
                    source,
                    "reference escape",
                )
                result = types.type_error()
            else:
                validate_ordered_lock_element_mutation(checker, arena, operand, source, current_scope)
                if operand.index >= 0:
                    address_symbol = symbols.missing_symbol()
                    operand_node = arena.nodes[operand.index]
                    if operand_node.kind == syntax.SyntaxKind.EXPR_NAME:
                        address_symbol = checker.symbols.find_in_scope(source, current_scope, operand_node.value_start, operand_node.value_length)
                    checker.model.record_value_use(
                        operand,
                        semantic.ValueUseKind.ADDRESS,
                        address_symbol,
                        operand_type,
                        operand_type,
                    )
                result = checker.type_table.pointer_to(operand_type)
        elif types.is_atomic_type(&checker.type_table, operand_type):
            operand_node = arena.nodes[operand.index]
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_400,
                &operand_node,
                operand_type,
                source,
            )
            result = types.type_error()
        elif node.flags == cast[i32](token.TokenKind.STAR) and operand_type.index >= 0 and operand_type.index < cast[i32](len(checker.type_table.types)):
            operand_record = checker.type_table.types[operand_type.index]
            if operand_record.kind == types.TypeKind.POINTER or operand_record.kind == types.TypeKind.REFERENCE or operand_record.kind == types.TypeKind.OWNED:
                result = operand_record.inner
    elif node.kind == syntax.SyntaxKind.EXPR_BINARY:
        operator = node.flags
        left = checker_core.first_child(arena, id)
        right = checker_core.second_child(arena, id)
        left_type = infer_expression_type(checker, arena, left, source, current_scope)
        right_type = infer_expression_type(checker, arena, right, source, current_scope)
        if types.is_atomic_type(&checker.type_table, left_type) or types.is_atomic_type(&checker.type_table, right_type):
            operand = left
            if not types.is_atomic_type(&checker.type_table, left_type):
                operand = right
            operand_node = arena.nodes[operand.index]
            actual_type = left_type
            if operand.index == right.index:
                actual_type = right_type
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_400,
                &operand_node,
                actual_type,
                source,
            )
            result = types.type_error()
        elif operator == cast[i32](token.TokenKind.EQUAL) or operator == cast[i32](token.TokenKind.NOT_EQUAL) or operator == cast[i32](token.TokenKind.LESS) or operator == cast[i32](token.TokenKind.LESS_EQUAL) or operator == cast[i32](token.TokenKind.GREATER) or operator == cast[i32](token.TokenKind.GREATER_EQUAL) or operator == cast[i32](token.TokenKind.AND) or operator == cast[i32](token.TokenKind.OR) or operator == cast[i32](token.TokenKind.IN) or operator == cast[i32](token.TokenKind.NOT):
            result = types.type_bool()
        else:
            if is_set_algebra_operator(operator) and semantic_type_is_kind(checker.type_table, left_type, types.TypeKind.SET):
                if not checker.type_table.same(left_type, right_type):
                    right_node = arena.nodes[right.index]
                    checker_core.emit_type_mismatch(
                        checker,
                        &right_node,
                        left_type,
                        right_type,
                        source,
                    )
                    result = types.type_error()
                else:
                    result = left_type
            elif checker.specialization_declaration.index >= 0 and not specialized_operand_types_compatible(checker, left_type, right_type):
                right_node = arena.nodes[right.index]
                checker_core.emit_type_mismatch(
                    checker,
                    &right_node,
                    left_type,
                    right_type,
                    source,
                )
                result = types.type_error()
            else:
                result = left_type
    checker.model.record_expr_type(id, result)
    return result


def infer_attribute_expression_type(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> types.TypeId:
    receiver = checker_core.first_child(arena, id)
    member = checker_core.second_child(arena, id)
    if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == syntax.SyntaxKind.EXPR_NAME:
        receiver_node = arena.nodes[receiver.index]
        member_node = arena.nodes[member.index]
        alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
        name = source[member_node.value_start:member_node.value_start + member_node.value_length]
        if virtual_net_namespace_receiver(checker, arena, receiver, source, current_scope):
            if name == "AF_INET" or name == "AF_INET6" or name == "SOCK_STREAM":
                return types.type_i32()
            if name == "POLL_IN" or name == "POLL_OUT" or name == "POLL_ERROR" or name == "POLL_HANGUP" or name == "POLL_INVALID":
                return types.type_i16()
            if name == "Socket":
                return types.type_socket()
            if name == "PollFd":
                return types.type_poll_fd()
            if name == "NetError":
                return types.type_net_error()
            if name == "NetErrorKind":
                return types.type_net_error_kind()
            checker_core.emit_import_member_error(checker, &member_node, "std.net", name)
            return types.type_error()
        import_index: usize = 0
        module_imports: &const List[project.ImportBinding] = &checker.module_imports
        while import_index < len(module_imports):
            imported: &const project.ImportBinding = &module_imports[import_index]
            if len(imported.member) == 0 and imported.alias == alias and lock_order.find_lock(&checker.lock_model, &imported.module_name, &name) >= 0:
                return types.type_lock()
            import_index += 1
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)) or member.index < 0:
        return receiver_type
    receiver_record = checker.type_table.types[receiver_type.index]
    member_node = arena.nodes[member.index]
    if receiver_record.kind == types.TypeKind.POLL_FD:
        if checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "events") or checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "revents"):
            return types.type_i16()
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_402,
            &member_node,
            source[member_node.value_start:member_node.value_start + member_node.value_length],
        )
        return types.type_error()
    if receiver_record.kind == types.TypeKind.NET_ERROR:
        if checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "kind"):
            return types.type_net_error_kind()
        if checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "code"):
            return types.type_i32()
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_402,
            &member_node,
            source[member_node.value_start:member_node.value_start + member_node.value_length],
        )
        return types.type_error()
    if receiver_record.kind == types.TypeKind.NET_ERROR_KIND:
        if net_error_kind_member(source, &member_node):
            return types.type_net_error_kind()
        checker_core.emit_symbol_error(
            checker,
            diagnostics.DiagnosticId.CHECK_402,
            &member_node,
            source[member_node.value_start:member_node.value_start + member_node.value_length],
        )
        return types.type_error()
    if receiver_record.kind == types.TypeKind.OPTION and checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "value"):
        return receiver_record.inner
    if receiver_record.kind == types.TypeKind.ATOMIC_COMPARE_EXCHANGE_RESULT:
        kind = semantic.AtomicIntrinsicKind.NONE
        result = types.type_error()
        if checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "exchanged"):
            kind = semantic.AtomicIntrinsicKind.RESULT_EXCHANGED
            result = types.type_bool()
        elif checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "observed"):
            kind = semantic.AtomicIntrinsicKind.RESULT_OBSERVED
            result = receiver_record.inner
        else:
            checker_core.emit_symbol_error(
                checker,
                diagnostics.DiagnosticId.CHECK_402,
                &member_node,
                source[member_node.value_start:member_node.value_start + member_node.value_length],
            )
            return types.type_error()
        missing = syntax.missing_node()
        checker.model.record_atomic_intrinsic(
            id,
            kind,
            types.atomic_type_element_kind(&checker.type_table, receiver_type),
            types.missing_type(),
            receiver_record.inner,
            result,
            receiver,
            missing,
            missing,
            missing,
            missing,
            semantic.AtomicArgumentRole.NONE,
            semantic.AtomicArgumentRole.NONE,
            0,
        )
        return result
    if receiver_record.kind == types.TypeKind.ATOMIC:
        if atomic_intrinsic_kind(source, &member_node) == semantic.AtomicIntrinsicKind.NONE:
            checker_core.emit_symbol_error(
                checker,
                diagnostics.DiagnosticId.CHECK_402,
                &member_node,
                source[member_node.value_start:member_node.value_start + member_node.value_length],
            )
            return types.type_error()
        return receiver_type
    if not types.is_nominal_kind(receiver_record.kind) or receiver_record.name_length == 0:
        return receiver_type
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), receiver_record.name_start, receiver_record.name_length)
    if owner.index < 0:
        return receiver_type
    field = checker.symbols.find_in_current_scope(source, checker.symbols.symbols[owner.index].member_scope, member_node.value_start, member_node.value_length)
    if field.index < 0 or checker.symbols.symbols[field.index].kind != symbols.SymbolKind.FIELD:
        return receiver_type
    checker.model.record_name_symbol(member, field)
    field_type = checker.symbols.symbols[field.index].type_id
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, receiver_type)
    declaration = checker.symbols.symbols[owner.index].node
    if len(args) > 0 and generics.has_type_params(arena, declaration):
        field_type = generics.substitute_type(checker.type_table, field_type, arena, declaration, &args, source)
    return field_type


def net_error_kind_member(source: &const String, member: &const syntax.SyntaxNode) -> bool:
    return checker_core.range_text_equals(source, member.value_start, member.value_length, "would_block") or checker_core.range_text_equals(source, member.value_start, member.value_length, "interrupted") or checker_core.range_text_equals(source, member.value_start, member.value_length, "address_in_use") or checker_core.range_text_equals(source, member.value_start, member.value_length, "connection_refused") or checker_core.range_text_equals(source, member.value_start, member.value_length, "connection_reset") or checker_core.range_text_equals(source, member.value_start, member.value_length, "timed_out") or checker_core.range_text_equals(source, member.value_start, member.value_length, "not_connected") or checker_core.range_text_equals(source, member.value_start, member.value_length, "invalid_input") or checker_core.range_text_equals(source, member.value_start, member.value_length, "unsupported") or checker_core.range_text_equals(source, member.value_start, member.value_length, "system")


def infer_list_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    element = types.type_error()
    if node.child_count > 0:
        element = infer_expression_type(checker, arena, arena.children[node.first_child], source, current_scope)
    return collections.list_type(checker.type_table, element)


def infer_set_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    element = types.type_error()
    if node.child_count > 0:
        element = infer_expression_type(checker, arena, arena.children[node.first_child], source, current_scope)
    return collections.set_type(checker.type_table, element)


def infer_map_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    key_type = types.type_error()
    value_type = types.type_error()
    if node.child_count > 0:
        entry_id = arena.children[node.first_child]
        entry = arena.nodes[entry_id.index]
        if entry.child_count > 0:
            key_type = infer_expression_type(checker, arena, arena.children[entry.first_child], source, current_scope)
        if entry.child_count > 1:
            value_type = infer_expression_type(checker, arena, arena.children[entry.first_child + 1], source, current_scope)
    return collections.map_type(checker.type_table, key_type, value_type)


def infer_tuple_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    args: List[types.TypeId] = []
    for offset in range(0, node.child_count):
        args.append(infer_expression_type(checker, arena, arena.children[node.first_child + offset], source, current_scope))
    return checker.type_table.tuple_from_args(args)


def indexed_element_type(table: &const types.TypeTable, arena: &const syntax.SyntaxArena, index: NodeId, source: &const String, receiver_type: types.TypeId) -> types.TypeId:
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(table.types)):
        return types.type_error()
    record = table.types[receiver_type.index]
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.SLICE:
        return record.inner
    if record.kind == types.TypeKind.MAP:
        return record.second
    if record.kind != types.TypeKind.TUPLE or index.index < 0:
        return receiver_type
    index_node = arena.nodes[index.index]
    if index_node.kind != syntax.SyntaxKind.EXPR_LITERAL:
        return types.type_error()
    offset = parse_decimal_index(source, index_node.value_start, index_node.value_length)
    if offset < 0 or offset >= record.flags:
        return types.type_error()
    return table.type_args[cast[usize](record.extra + offset)]


def parse_decimal_index(source: &const String, start: usize, length: usize) -> i32:
    result: i32 = 0
    for offset in range(0, length):
        byte = source.byte_at(start + offset)
        if byte < 48 or byte > 57:
            return -1
        result = result * 10 + cast[i32](byte - 48)
    return result


def validate_collection_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)):
        return
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    receiver_record = checker.type_table.types[receiver_type.index]
    if receiver_record.kind == types.TypeKind.STRING:
        expected: i32 = 0
        result = types.type_void()
        if collections.text_equals(&member_name, "clone"):
            result = types.type_string()
        elif collections.text_equals(&member_name, "byte_at"):
            expected = 1
            result = types.type_i32()
        elif collections.text_equals(&member_name, "append") or collections.text_equals(&member_name, "append_char") or collections.text_equals(&member_name, "reserve"):
            expected = 1
        elif not collections.text_equals(&member_name, "clear"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.STRING_BUILDER:
        expected: i32 = 1
        result = types.type_void()
        if collections.text_equals(&member_name, "finish"):
            expected = 0
            result = types.type_string()
        elif not collections.text_equals(&member_name, "append") and not collections.text_equals(&member_name, "append_char") and not collections.text_equals(&member_name, "reserve"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.LIST:
        if types.is_ordered_lock_list(&checker.type_table, receiver_type) and not collections.text_equals(&member_name, "sort"):
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_419, &member_node)
        expected: i32 = 0
        result = types.type_void()
        takes_element = false
        if collections.text_equals(&member_name, "append"):
            expected = 1
            takes_element = true
        elif collections.text_equals(&member_name, "pop"):
            result = receiver_record.inner
        elif not collections.text_equals(&member_name, "clear") and not collections.text_equals(&member_name, "sort"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            argument_type = infer_expression_type(checker, arena, argument, source, current_scope)
            if takes_element:
                validate_partial_move_source(checker, arena, argument, argument_type, receiver_record.inner, source, current_scope)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.MAP and (collections.text_equals(&member_name, "keys") or collections.text_equals(&member_name, "values") or collections.text_equals(&member_name, "items")):
        validate_collection_method_argument_count(checker, arena, call_id, 0)
        checker.model.record_expr_type(call_id, collections.map_view_type(checker.type_table, receiver_type, &member_name))
        return
    if receiver_record.kind == types.TypeKind.MAP and collections.text_equals(&member_name, "get"):
        validate_collection_method_argument_count(checker, arena, call_id, 1)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        if not checker_type_can_clone(checker.type_table, receiver_record.second) and not checker_named_scalar_can_clone(checker.type_table, receiver_record.second, source):
            emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_254,
                call_id,
                receiver_record.second,
                receiver_record.second,
                source,
                "clone",
            )
        checker.model.record_expr_type(call_id, checker.type_table.generic1(types.TypeKind.OPTION, 0, 0, receiver_record.second))
        return
    if receiver_record.kind == types.TypeKind.SET:
        is_algebra = collections.text_equals(&member_name, "union") or collections.text_equals(&member_name, "intersection") or collections.text_equals(&member_name, "difference") or collections.text_equals(&member_name, "symmetric_difference")
        is_update = collections.text_equals(&member_name, "update")
        if is_algebra or is_update:
            validate_collection_method_argument_count(checker, arena, call_id, 1)
            argument = call_argument_value(arena, call_id, 0)
            if argument.index >= 0:
                argument_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, argument, source, current_scope))
                if not checker.type_table.same(receiver_type, argument_type):
                    argument_node = arena.nodes[argument.index]
                    checker_core.emit_type_mismatch(
                        checker,
                        &argument_node,
                        receiver_type,
                        argument_type,
                        source,
                    )
            if is_algebra:
                checker.model.record_expr_type(call_id, receiver_type)
            else:
                checker.model.record_expr_type(call_id, types.type_void())


def validate_collection_method_argument_count(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, call_id: NodeId, expected: i32) -> void:
    call = arena.nodes[call_id.index]
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_078,
            &call,
            expected,
            actual,
        )
    elif actual > expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_077,
            &call,
            expected,
            actual,
        )


def strip_collection_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current


def collection_indirection_depth(table: &const types.TypeTable, type_id: types.TypeId) -> i32:
    current = type_id
    depth: i32 = 0
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        record = table.types[current.index]
        if record.kind == types.TypeKind.CONST:
            current = record.inner
            continue
        if record.kind != types.TypeKind.REFERENCE and record.kind != types.TypeKind.POINTER:
            break
        depth += 1
        current = record.inner
    return depth


def semantic_type_is_kind(table: &const types.TypeTable, type_id: types.TypeId, kind: types.TypeKind) -> bool:
    value_type = strip_collection_indirection(table, type_id)
    return value_type.index >= 0 and value_type.index < cast[i32](len(table.types)) and table.types[value_type.index].kind == kind


def lock_list_storage_type(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    value_type = types.strip_const(table, type_id)
    if value_type.index < 0 or value_type.index >= cast[i32](len(table.types)):
        return false
    record = table.types[value_type.index]
    return record.kind == types.TypeKind.LIST and types.strip_const(table, record.inner).index == types.type_lock().index


def const_lock_element_type(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind != types.TypeKind.CONST:
        return false
    return types.strip_const(table, record.inner).index == types.type_lock().index


def ordered_lock_list_readonly_view(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        return lock_list_storage_type(table, record.inner)
    if record.kind == types.TypeKind.SLICE:
        return const_lock_element_type(table, record.inner)
    if record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.POINTER:
        inner = record.inner
        if inner.index < 0 or inner.index >= cast[i32](len(table.types)):
            return false
        inner_record = table.types[inner.index]
        if inner_record.kind != types.TypeKind.CONST:
            return false
        return lock_list_storage_type(table, inner_record.inner)
    return false


def is_set_algebra_operator(operator: i32) -> bool:
    return operator == cast[i32](token.TokenKind.PIPE) or operator == cast[i32](token.TokenKind.AMPERSAND) or operator == cast[i32](token.TokenKind.MINUS) or operator == cast[i32](token.TokenKind.CARET)


def atomic_indirection_const_compatible(table: &const types.TypeTable, expected: types.TypeId, actual: types.TypeId) -> bool:
    expected_current = types.strip_const(table, expected)
    actual_current = types.strip_const(table, actual)
    while expected_current.index >= 0 and expected_current.index < cast[i32](len(table.types)) and actual_current.index >= 0 and actual_current.index < cast[i32](len(table.types)):
        expected_record = table.types[expected_current.index]
        actual_record = table.types[actual_current.index]
        expected_is_const = expected_record.kind == types.TypeKind.CONST
        actual_is_const = actual_record.kind == types.TypeKind.CONST
        if actual_is_const and not expected_is_const:
            return false
        if expected_is_const:
            expected_current = expected_record.inner
        if actual_is_const:
            actual_current = actual_record.inner
        if expected_is_const or actual_is_const:
            continue
        expected_is_indirection = expected_record.kind == types.TypeKind.REFERENCE or expected_record.kind == types.TypeKind.POINTER
        actual_is_indirection = actual_record.kind == types.TypeKind.REFERENCE or actual_record.kind == types.TypeKind.POINTER
        if expected_is_indirection or actual_is_indirection:
            if not expected_is_indirection or not actual_is_indirection:
                return false
            expected_current = expected_record.inner
            actual_current = actual_record.inner
            continue
        return true
    return false


def types_compatible(checker: &checker_core.Checker, expected: types.TypeId, actual: types.TypeId) -> bool:
    expected_ordered = types.is_ordered_lock_list(&checker.type_table, expected)
    actual_ordered = types.is_ordered_lock_list(&checker.type_table, actual)
    if expected_ordered and not actual_ordered:
        return false
    if actual_ordered and not expected_ordered and not ordered_lock_list_readonly_view(&checker.type_table, expected):
        return false
    if checker.type_table.same(expected, actual):
        return true
    if expected.index < 0 or actual.index < 0:
        return true
    expected_atomic = types.is_atomic_type(&checker.type_table, expected)
    actual_atomic = types.is_atomic_type(&checker.type_table, actual)
    if expected_atomic or actual_atomic:
        return false
    expected_value = strip_collection_indirection(checker.type_table, expected)
    actual_value = strip_collection_indirection(checker.type_table, actual)
    expected_value_atomic = types.is_atomic_type(&checker.type_table, expected_value)
    actual_value_atomic = types.is_atomic_type(&checker.type_table, actual_value)
    if expected_value_atomic or actual_value_atomic:
        if not expected_value_atomic or not actual_value_atomic:
            return false
        if collection_indirection_depth(checker.type_table, expected) != collection_indirection_depth(checker.type_table, actual):
            return false
        if not atomic_indirection_const_compatible(checker.type_table, expected, actual):
            return false
        expected_element = types.atomic_type_element_kind(&checker.type_table, expected_value)
        actual_element = types.atomic_type_element_kind(&checker.type_table, actual_value)
        if expected_element != types.AtomicElementKind.INVALID or actual_element != types.AtomicElementKind.INVALID:
            return expected_element == actual_element
        return checker.type_table.same(expected_value, actual_value)
    expected_kind = checker.type_table.types[expected.index].kind
    actual_kind = checker.type_table.types[actual.index].kind
    if expected_kind == types.TypeKind.ERROR or actual_kind == types.TypeKind.ERROR:
        return true
    if types.is_map_view_kind(expected_kind) or types.is_map_view_kind(actual_kind):
        return checker.type_table.same(expected, actual)
    if is_numeric_kind(expected_kind) and is_numeric_kind(actual_kind):
        return true
    if expected_kind == types.TypeKind.BOOL and is_scalar_kind(actual_kind):
        return true
    if actual_kind == types.TypeKind.STRING:
        if expected_kind == types.TypeKind.CONST or expected_kind == types.TypeKind.POINTER:
            return true
        return false
    return true


def atomic_value_type_is_compatible(checker: &checker_core.Checker, element_kind: types.AtomicElementKind, actual: types.TypeId, source: &const String) -> bool:
    if actual.index < 0:
        return true
    actual_value = types.strip_const(&checker.type_table, actual)
    if actual_value.index < 0 or actual_value.index >= cast[i32](len(checker.type_table.types)):
        return true
    actual_kind = checker.type_table.types[actual_value.index].kind
    if actual_kind == types.TypeKind.ERROR:
        return true
    if types.atomic_element_is_integer(element_kind):
        return semantic_type_is_numeric(checker.type_table, actual, source)
    if element_kind == types.AtomicElementKind.BOOL:
        return semantic_type_is_scalar(checker.type_table, actual, source)
    return true


def semantic_type_is_numeric(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    record = table.types[current.index]
    if is_numeric_kind(record.kind):
        return true
    if record.kind != types.TypeKind.NAMED or record.flags != 0 or record.name_length == 0:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "i16" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "f32" or name == "isize" or name == "usize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def semantic_type_is_scalar(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    current = types.strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return false
    kind = table.types[current.index].kind
    return kind == types.TypeKind.BOOL or semantic_type_is_numeric(table, current, source) or kind == types.TypeKind.ENUM or kind == types.TypeKind.POINTER or kind == types.TypeKind.REFERENCE or kind == types.TypeKind.DYN or kind == types.TypeKind.LOCK


def specialized_operand_types_compatible(checker: &checker_core.Checker, left: types.TypeId, right: types.TypeId) -> bool:
    if checker.type_table.same(left, right):
        return true
    if left.index < 0 or right.index < 0:
        return false
    left_kind = checker.type_table.types[left.index].kind
    right_kind = checker.type_table.types[right.index].kind
    return is_numeric_kind(left_kind) and is_numeric_kind(right_kind)


def is_numeric_kind(kind: types.TypeKind) -> bool:
    return kind == types.TypeKind.I16 or kind == types.TypeKind.I32 or kind == types.TypeKind.I64 or kind == types.TypeKind.U8 or kind == types.TypeKind.USIZE or kind == types.TypeKind.F64 or kind == types.TypeKind.CHAR


def is_scalar_kind(kind: types.TypeKind) -> bool:
    return kind == types.TypeKind.BOOL or is_numeric_kind(kind) or kind == types.TypeKind.ENUM or kind == types.TypeKind.POINTER or kind == types.TypeKind.REFERENCE or kind == types.TypeKind.DYN or kind == types.TypeKind.LOCK


def validate_hashable_collection_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count <= 1:
        return
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    if checker_core.range_text_equals(source, base.value_start, base.value_length, "Map"):
        item_id = arena.children[node.first_child + 1]
        if type_node_is_hashable(checker, arena, item_id, source, current_scope):
            return
        item = arena.nodes[item_id.index]
        item_type = checker_core.resolve_type_node(checker, arena, item_id, source)
        checker_core.emit_actual_type_error(
            checker,
            diagnostics.DiagnosticId.CHECK_297,
            &item,
            item_type,
            source,
        )
        return
    elif checker_core.range_text_equals(source, base.value_start, base.value_length, "Set"):
        item_id = arena.children[node.first_child + 1]
        if type_node_is_hashable(checker, arena, item_id, source, current_scope):
            return
        item = arena.nodes[item_id.index]
        item_type = checker_core.resolve_type_node(checker, arena, item_id, source)
        checker_core.emit_actual_type_error(
            checker,
            diagnostics.DiagnosticId.CHECK_300,
            &item,
            item_type,
            source,
        )


def type_node_is_hashable(checker: &const checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if type_node_is_c_string(arena, id, source):
        return true
    if node.kind != syntax.SyntaxKind.TYPE_NAME:
        return false
    if type_name_is_hash_scalar(source, &node) or checker_core.range_text_equals(source, node.value_start, node.value_length, "String"):
        return true
    type_name = source[node.start:node.start + node.length]
    if checker_core.string_list_contains(&checker.imported_enum_names, &type_name):
        return true
    found = checker.symbols.find_in_scope(source, current_scope, node.value_start, node.value_length)
    return found.index >= 0 and checker.symbols.symbols[found.index].kind == symbols.SymbolKind.ENUM


def type_node_is_c_string(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.TYPE_CONST:
        pointer = checker_core.first_child(arena, id)
        if pointer.index < 0 or arena.nodes[pointer.index].kind != syntax.SyntaxKind.TYPE_POINTER:
            return false
        return type_node_is_exact_name(arena, checker_core.first_child(arena, pointer), source, "char")
    if node.kind == syntax.SyntaxKind.TYPE_POINTER:
        const_type = checker_core.first_child(arena, id)
        if const_type.index < 0 or arena.nodes[const_type.index].kind != syntax.SyntaxKind.TYPE_CONST:
            return false
        return type_node_is_exact_name(arena, checker_core.first_child(arena, const_type), source, "char")
    return false


def type_node_is_exact_name(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, expected: String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    return node.kind == syntax.SyntaxKind.TYPE_NAME and checker_core.range_text_equals(source, node.value_start, node.value_length, expected)


def type_name_is_hash_scalar(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    return checker_core.range_text_equals(source, node.value_start, node.value_length, "bool") or checker_core.range_text_equals(source, node.value_start, node.value_length, "char") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i8") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i16") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i32") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i64") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u8") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u16") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u32") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u64") or checker_core.range_text_equals(source, node.value_start, node.value_length, "isize") or checker_core.range_text_equals(source, node.value_start, node.value_length, "usize") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_int") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_long") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_size_t")


def semantic_type_is_hashable(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return true
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.ERROR or record.kind == types.TypeKind.BOOL or record.kind == types.TypeKind.I32 or record.kind == types.TypeKind.I64 or record.kind == types.TypeKind.CHAR or record.kind == types.TypeKind.STRING or record.kind == types.TypeKind.ENUM:
        return true
    if semantic_type_is_c_string(table, type_id):
        return true
    if record.kind != types.TypeKind.NAMED:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def semantic_type_is_c_string(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        pointer = table.types[record.inner.index]
        return pointer.kind == types.TypeKind.POINTER and pointer.inner.index >= 0 and pointer.inner.index < cast[i32](len(table.types)) and table.types[pointer.inner.index].kind == types.TypeKind.CHAR
    if record.kind == types.TypeKind.POINTER:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        const_type = table.types[record.inner.index]
        return const_type.kind == types.TypeKind.CONST and const_type.inner.index >= 0 and const_type.inner.index < cast[i32](len(table.types)) and table.types[const_type.inner.index].kind == types.TypeKind.CHAR
    return false


def is_string_literal(arena: &const syntax.SyntaxArena, id: NodeId) -> bool:
    node = arena.nodes[id.index]
    return node.kind == syntax.SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING)


def is_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "print") or checker_core.range_text_equals(source, start, length, "len") or checker_core.range_text_equals(source, start, length, "open") or checker_core.range_text_equals(source, start, length, "range") or checker_core.range_text_equals(source, start, length, "sort") or checker_core.range_text_equals(source, start, length, "sorted") or checker_core.range_text_equals(source, start, length, "input") or checker_core.range_text_equals(source, start, length, "to_string") or checker_core.range_text_equals(source, start, length, "set") or checker_core.range_text_equals(source, start, length, "free") or checker_core.range_text_equals(source, start, length, "panic") or checker_core.range_text_equals(source, start, length, "String") or checker_core.range_text_equals(source, start, length, "StringBuilder") or checker_core.range_text_equals(source, start, length, "Some") or checker_core.range_text_equals(source, start, length, "Owned") or checker_core.range_text_equals(source, start, length, "Ok") or checker_core.range_text_equals(source, start, length, "Err") or checker_core.range_text_equals(source, start, length, "closure") or checker_core.range_text_equals(source, start, length, "super") or is_parse_builtin_name(source, start, length) or is_reflection_builtin_name(source, start, length)


def is_parse_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "parse_i32") or checker_core.range_text_equals(source, start, length, "parse_i64") or checker_core.range_text_equals(source, start, length, "parse_u32") or checker_core.range_text_equals(source, start, length, "parse_u64") or checker_core.range_text_equals(source, start, length, "parse_isize") or checker_core.range_text_equals(source, start, length, "parse_usize") or checker_core.range_text_equals(source, start, length, "parse_f32") or checker_core.range_text_equals(source, start, length, "parse_f64") or checker_core.range_text_equals(source, start, length, "parse_bool")


def is_reflection_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "type_of") or checker_core.range_text_equals(source, start, length, "type_name") or checker_core.range_text_equals(source, start, length, "type_info") or checker_core.range_text_equals(source, start, length, "size_of") or checker_core.range_text_equals(source, start, length, "align_of") or checker_core.range_text_equals(source, start, length, "field_count") or checker_core.range_text_equals(source, start, length, "method_count") or checker_core.range_text_equals(source, start, length, "fields") or checker_core.range_text_equals(source, start, length, "methods") or checker_core.range_text_equals(source, start, length, "fields_of") or checker_core.range_text_equals(source, start, length, "methods_of") or checker_core.range_text_equals(source, start, length, "has_field") or checker_core.range_text_equals(source, start, length, "has_method") or checker_core.range_text_equals(source, start, length, "implements")
