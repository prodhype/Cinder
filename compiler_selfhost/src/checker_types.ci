import checker_core
import collections
import generics
import semantic
import symbols
import syntax
import token
import types
from syntax import NodeId


def type_is_borrowed_for_transfer(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind == types.TypeKind.CONST:
            current = table.types[current.index].inner
            continue
        return kind == types.TypeKind.POINTER or kind == types.TypeKind.REFERENCE or kind == types.TypeKind.SLICE or kind == types.TypeKind.DYN or types.is_map_view_kind(kind)
    return false


def checker_type_needs_drop(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, type_id: types.TypeId, source: &const String) -> bool:
    seen: List[i32] = []
    return checker_type_needs_drop_inner(checker, arena, type_id, source, seen)


def checker_type_needs_drop_inner(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, type_id: types.TypeId, source: &const String, seen: &List[i32]) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(checker.type_table.types)):
        return false
    record = checker.type_table.types[type_id.index]
    if record.kind == types.TypeKind.STRING or record.kind == types.TypeKind.STRING_BUILDER or record.kind == types.TypeKind.FILE or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.SET:
        return true
    if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.SLICE or record.kind == types.TypeKind.DYN or types.is_map_view_kind(record.kind):
        return false
    if record.kind == types.TypeKind.CONST or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.OPTION:
        return checker_type_needs_drop_inner(checker, arena, record.inner, source, seen)
    if record.kind == types.TypeKind.CLOSURE:
        return checker_type_needs_drop_inner(checker, arena, record.second, source, seen)
    if record.kind == types.TypeKind.RESULT:
        return checker_type_needs_drop_inner(checker, arena, record.inner, source, seen) or checker_type_needs_drop_inner(checker, arena, record.second, source, seen)
    if record.kind == types.TypeKind.TUPLE:
        offset: i32 = 0
        while offset < record.flags:
            if checker_type_needs_drop_inner(checker, arena, checker.type_table.type_args[cast[usize](record.extra + offset)], source, seen):
                return true
            offset += 1
        return false
    if record.kind != types.TypeKind.STRUCT and record.kind != types.TypeKind.CLASS:
        return false
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), record.name_start, record.name_length)
    if owner.index < 0:
        return false
    seen_index: usize = 0
    while seen_index < len(seen):
        if seen[seen_index] == type_id.index:
            return false
        seen_index += 1
    seen.append(type_id.index)
    owner_symbol = checker.symbols.symbols[owner.index]
    if record.kind == types.TypeKind.CLASS:
        for member in checker.symbols.symbols:
            if member.scope.index == owner_symbol.member_scope.index and member.kind == symbols.SymbolKind.METHOD and checker_core.range_text_equals(source, member.name_start, member.name_length, "__del__"):
                return true
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, type_id)
    for member in checker.symbols.symbols:
        if member.scope.index != owner_symbol.member_scope.index or member.kind != symbols.SymbolKind.FIELD:
            continue
        field_type = member.type_id
        if len(args) > 0 and generics.has_type_params(arena, owner_symbol.node):
            field_type = generics.substitute_type(checker.type_table, field_type, arena, owner_symbol.node, &args, source)
        if checker_type_needs_drop_inner(checker, arena, field_type, source, seen):
            return true
    return false


def validate_partial_move_source(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expression: NodeId,
    value_type: types.TypeId,
    destination_type: types.TypeId,
    source: &const String,
) -> void:
    if expression.index < 0 or type_is_borrowed_for_transfer(checker.type_table, destination_type):
        return
    kind = arena.nodes[expression.index].kind
    if kind != syntax.SyntaxKind.EXPR_ATTRIBUTE and kind != syntax.SyntaxKind.EXPR_INDEX:
        return
    if not checker_type_needs_drop(checker, arena, value_type, source):
        return
    node = arena.nodes[expression.index]
    checker_core.emit_error(checker, 254, node.start, node.length, node.line, node.column)


def validate_call(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    call = arena.nodes[id.index]
    callee = checker_core.first_child(arena, id)
    if callee.index < 0:
        return
    callee_node = arena.nodes[callee.index]
    if callee_node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        validate_collection_method_call(checker, arena, id, callee, source, current_scope)
        if checker.model.expr_type(id).index == types.type_error().index:
            validate_user_method_call(checker, arena, id, callee, source, current_scope)
        return
    if callee_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "closure"):
        validate_closure_constructor(checker, arena, id, source, current_scope)
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "Owned"):
        validate_owned_constructor(checker, arena, id, callee, source, current_scope)
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "String"):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(id, types.type_string())
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "StringBuilder"):
        checker.model.record_expr_type(id, types.type_string_builder())
        return
    if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "input") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "to_string"):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(id, types.type_string())
        return
    if is_parse_builtin_name(source, callee_node.value_start, callee_node.value_length):
        argument = call_argument_value(arena, id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        value_type = checker.type_table.resolve_type_name(
            source,
            callee_node.value_start + 6,
            callee_node.value_length - 6,
        )
        checker.model.record_expr_type(
            id,
            checker.type_table.generic2(
                types.TypeKind.RESULT,
                callee_node.value_start,
                callee_node.value_length,
                value_type,
                types.type_convert_error(),
            ),
        )
        return
    if is_reflection_builtin_name(source, callee_node.value_start, callee_node.value_length):
        if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "type_name"):
            checker.model.record_expr_type(id, types.type_string())
            return
        if checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "has_field") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "has_method") or checker_core.range_text_equals(source, callee_node.value_start, callee_node.value_length, "implements"):
            checker.model.record_expr_type(id, types.type_bool())
            return
        checker.model.record_expr_type(id, types.type_i32())
        return
    if is_builtin_name(source, callee_node.value_start, callee_node.value_length):
        checker.model.record_expr_type(id, types.type_i32())
        return
    found = checker.symbols.find_in_scope(source, current_scope, callee_node.value_start, callee_node.value_length)
    if found.index < 0:
        checker_core.emit_error(checker, 48, callee_node.start, callee_node.length, callee_node.line, callee_node.column)
        return
    symbol = checker.symbols.symbols[found.index]
    if is_nominal_constructor_symbol(symbol.kind) or symbol.kind == symbols.SymbolKind.GLOBAL:
        checker.model.record_name_symbol(callee, found)
        checker.model.record_expr_type(id, symbol.type_id)
        if symbol.kind == symbols.SymbolKind.STRUCT or symbol.kind == symbols.SymbolKind.CLASS:
            validate_nominal_constructor_move_arguments(checker, arena, id, found, source, current_scope)
        return
    if symbol.type_id.index >= 0:
        callable_type = checker.type_table.types[symbol.type_id.index]
        if callable_type.kind == types.TypeKind.FUNCTION or callable_type.kind == types.TypeKind.CLOSURE:
            checker.model.record_name_symbol(callee, found)
            checker.model.record_call(id, found, callable_type.inner, 0)
            checker.model.record_expr_type(id, callable_type.inner)
            actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
            expected = callable_type.flags
            if actual < expected:
                checker_core.emit_error(checker, 78, call.start, call.length, call.line, call.column)
            elif actual > expected:
                checker_core.emit_error(checker, 77, call.start, call.length, call.line, call.column)
            return
    if symbol.kind == symbols.SymbolKind.LOCAL or symbol.kind == symbols.SymbolKind.PARAMETER or symbol.kind == symbols.SymbolKind.CONSTANT:
        checker.model.record_name_symbol(callee, found)
        checker.model.record_expr_type(id, types.type_i32())
        return
    if symbol.kind != symbols.SymbolKind.FUNCTION and symbol.kind != symbols.SymbolKind.FUNCTION_TEMPLATE:
        checker_core.emit_error(checker, 48, callee_node.start, callee_node.length, callee_node.line, callee_node.column)
        return
    checker.model.record_name_symbol(callee, found)
    checker.model.record_call(id, found, symbol.type_id, 0)
    checker.model.record_expr_type(id, symbol.type_id)
    if call.flags == 1:
        record_generic_call_specialization(checker, arena, id, source, found)
    elif symbol.kind == symbols.SymbolKind.FUNCTION_TEMPLATE:
        infer_generic_call_specialization(checker, arena, id, source, current_scope, found)
    validate_declared_call_move_arguments(checker, arena, id, symbol.node, source, current_scope, 0)
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    expected = symbol.flags
    if actual < expected:
        checker_core.emit_error(checker, 78, call.start, call.length, call.line, call.column)
    elif actual > expected:
        checker_core.emit_error(checker, 77, call.start, call.length, call.line, call.column)


def validate_owned_constructor(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    callee: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    call = arena.nodes[id.index]
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < 1:
        checker_core.emit_error(checker, 78, call.start, call.length, call.line, call.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    if actual > 1:
        checker_core.emit_error(checker, 77, call.start, call.length, call.line, call.column)
    argument = call_argument_value(arena, id, 0)
    payload_type = infer_expression_type(checker, arena, argument, source, current_scope)
    validate_partial_move_source(checker, arena, argument, payload_type, payload_type, source)
    callee_node = arena.nodes[callee.index]
    result = checker.type_table.generic1(
        types.TypeKind.OWNED,
        callee_node.value_start,
        callee_node.value_length,
        payload_type,
    )
    checker.model.record_expr_type(id, result)


def validate_closure_constructor(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    call = arena.nodes[id.index]
    actual = checker_core.count_direct_children(arena, id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual != 2:
        checker_core.emit_error(checker, 378, call.start, call.length, call.line, call.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    for offset in range(0, call.child_count):
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.EXPR_ARGUMENT and child.flags == 1:
            checker_core.emit_error(checker, 379, child.start, child.length, child.line, child.column)
            checker.model.record_expr_type(id, types.type_error())
            return
    environment_expression = call_argument_value(arena, id, 0)
    adapter_expression = call_argument_value(arena, id, 1)
    environment_type = infer_expression_type(checker, arena, environment_expression, source, current_scope)
    if environment_type.index < 0 or environment_type.index >= cast[i32](len(checker.type_table.types)):
        checker.model.record_expr_type(id, types.type_error())
        return
    environment_record = checker.type_table.types[environment_type.index]
    if environment_record.kind != types.TypeKind.STRUCT:
        environment_node = arena.nodes[environment_expression.index]
        checker_core.emit_error(checker, 380, environment_node.start, environment_node.length, environment_node.line, environment_node.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    if adapter_expression.index < 0:
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_node = arena.nodes[adapter_expression.index]
    if adapter_node.kind != syntax.SyntaxKind.EXPR_NAME:
        checker_core.emit_error(checker, 383, adapter_node.start, adapter_node.length, adapter_node.line, adapter_node.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_symbol_id = checker.symbols.find_in_scope(source, current_scope, adapter_node.value_start, adapter_node.value_length)
    if adapter_symbol_id.index < 0:
        checker_core.emit_error(checker, 48, adapter_node.start, adapter_node.length, adapter_node.line, adapter_node.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    adapter_symbol = checker.symbols.symbols[adapter_symbol_id.index]
    if adapter_symbol.kind != symbols.SymbolKind.FUNCTION:
        checker_core.emit_error(checker, 383, adapter_node.start, adapter_node.length, adapter_node.line, adapter_node.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    declaration = arena.nodes[adapter_symbol.node.index]
    adapter_args: List[types.TypeId] = []
    visible_args: List[types.TypeId] = []
    closure_environment = types.type_error()
    parameter_index: i32 = 0
    for offset in range(0, declaration.child_count):
        parameter_id = arena.children[declaration.first_child + offset]
        parameter = arena.nodes[parameter_id.index]
        if parameter.kind != syntax.SyntaxKind.PARAMETER:
            continue
        parameter_type = checker_core.resolve_declared_type_or_default(checker, arena, parameter_id, source, types.type_i32())
        adapter_args.append(parameter_type)
        if parameter_index == 0:
            if parameter_type.index < 0 or parameter_type.index >= cast[i32](len(checker.type_table.types)) or checker.type_table.types[parameter_type.index].kind != types.TypeKind.REFERENCE:
                checker_core.emit_error(checker, 385, parameter.start, parameter.length, parameter.line, parameter.column)
                checker.model.record_expr_type(id, types.type_error())
                return
            closure_environment = checker.type_table.types[parameter_type.index].inner
        else:
            visible_args.append(parameter_type)
        parameter_index += 1
    if parameter_index == 0:
        checker_core.emit_error(checker, 384, adapter_node.start, adapter_node.length, adapter_node.line, adapter_node.column)
        checker.model.record_expr_type(id, types.type_error())
        return
    expected_environment = strip_const_type(checker.type_table, closure_environment)
    if not closure_environment_types_match(checker.type_table, expected_environment, environment_type, source):
        environment_node = arena.nodes[environment_expression.index]
        checker_core.emit_error(checker, 107, environment_node.start, environment_node.length, environment_node.line, environment_node.column)
    adapter_type = checker.type_table.function_from_args(adapter_args, adapter_symbol.type_id)
    checker.model.record_name_symbol(adapter_expression, adapter_symbol_id)
    checker.model.record_expr_type(adapter_expression, adapter_type)
    closure_type = checker.type_table.closure_from_args(closure_environment, visible_args, adapter_symbol.type_id)
    checker.model.record_call(id, adapter_symbol_id, closure_type, 1)
    checker.model.record_expr_type(id, closure_type)


def call_argument_value(arena: &const syntax.SyntaxArena, id: NodeId, argument_index: i32) -> NodeId:
    call = arena.nodes[id.index]
    seen: i32 = 0
    for offset in range(0, call.child_count):
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.EXPR_ARGUMENT:
            if seen == argument_index:
                return checker_core.last_child(arena, child_id)
            seen += 1
    return syntax.missing_node()


def declaration_parameter_at(arena: &const syntax.SyntaxArena, declaration: NodeId, wanted: i32) -> NodeId:
    if declaration.index < 0:
        return syntax.missing_node()
    node = arena.nodes[declaration.index]
    seen: i32 = 0
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind == syntax.SyntaxKind.PARAMETER:
            if seen == wanted:
                return child_id
            seen += 1
    return syntax.missing_node()


def validate_declared_call_move_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    declaration: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    skipped_parameters: i32,
) -> void:
    call = arena.nodes[call_id.index]
    argument_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        parameter = declaration_parameter_at(arena, declaration, argument_index + skipped_parameters)
        destination_type = value_type
        if parameter.index >= 0:
            destination_type = checker_core.resolve_declared_type_or_default(checker, arena, parameter, source, value_type)
        validate_partial_move_source(checker, arena, value, value_type, destination_type, source)
        argument_index += 1


def nominal_constructor_parameter(
    checker: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    owner: symbols.SymbolId,
    argument_id: NodeId,
    positional_index: i32,
    source: &const String,
) -> NodeId:
    owner_symbol = checker.symbols.symbols[owner.index]
    argument = arena.nodes[argument_id.index]
    if argument.flags == 1:
        name = checker_core.first_child(arena, argument_id)
        if name.index >= 0:
            name_node = arena.nodes[name.index]
            field = checker.symbols.find_in_current_scope(source, owner_symbol.member_scope, name_node.value_start, name_node.value_length)
            if field.index >= 0 and checker.symbols.symbols[field.index].kind == symbols.SymbolKind.FIELD:
                return checker.symbols.symbols[field.index].node
        return syntax.missing_node()
    seen: i32 = 0
    for field in checker.symbols.symbols:
        if field.scope.index == owner_symbol.member_scope.index and field.kind == symbols.SymbolKind.FIELD:
            if seen == positional_index:
                return field.node
            seen += 1
    return syntax.missing_node()


def nominal_initializer_declaration(checker: &const checker_core.Checker, owner: symbols.SymbolId, source: &const String) -> NodeId:
    owner_symbol = checker.symbols.symbols[owner.index]
    for member in checker.symbols.symbols:
        if member.scope.index == owner_symbol.member_scope.index and member.kind == symbols.SymbolKind.METHOD and checker_core.range_text_equals(source, member.name_start, member.name_length, "__init__"):
            return member.node
    return syntax.missing_node()


def validate_nominal_constructor_move_arguments(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    owner: symbols.SymbolId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    owner_symbol = checker.symbols.symbols[owner.index]
    if owner_symbol.kind == symbols.SymbolKind.CLASS:
        initializer = nominal_initializer_declaration(checker, owner, source)
        if initializer.index >= 0:
            validate_declared_call_move_arguments(checker, arena, call_id, initializer, source, current_scope, 1)
        return
    call = arena.nodes[call_id.index]
    positional_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != syntax.SyntaxKind.EXPR_ARGUMENT:
            continue
        value = checker_core.last_child(arena, argument_id)
        value_type = infer_expression_type(checker, arena, value, source, current_scope)
        field = nominal_constructor_parameter(checker, arena, owner, argument_id, positional_index, source)
        destination_type = value_type
        if field.index >= 0:
            destination_type = checker_core.resolve_declared_type_or_default(checker, arena, field, source, value_type)
        validate_partial_move_source(checker, arena, value, value_type, destination_type, source)
        if argument.flags == 0:
            positional_index += 1


def strip_const_type(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    if type_id.index >= 0 and type_id.index < cast[i32](len(table.types)) and table.types[type_id.index].kind == types.TypeKind.CONST:
        return table.types[type_id.index].inner
    return type_id


def closure_environment_types_match(table: &const types.TypeTable, expected: types.TypeId, actual: types.TypeId, source: &const String) -> bool:
    if table.same(expected, actual):
        return true
    if expected.index < 0 or actual.index < 0 or expected.index >= cast[i32](len(table.types)) or actual.index >= cast[i32](len(table.types)):
        return false
    expected_record = table.types[expected.index]
    actual_record = table.types[actual.index]
    if expected_record.name_length == 0 or actual_record.name_length == 0:
        return false
    return symbols.range_equals(source, expected_record.name_start, expected_record.name_length, actual_record.name_start, actual_record.name_length)


def is_nominal_constructor_symbol(kind: symbols.SymbolKind) -> bool:
    return kind == symbols.SymbolKind.STRUCT or kind == symbols.SymbolKind.CLASS or kind == symbols.SymbolKind.ENUM or kind == symbols.SymbolKind.UNION or kind == symbols.SymbolKind.VARIANT or kind == symbols.SymbolKind.EXTERN_TYPE


def record_generic_call_specialization(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, callee: symbols.SymbolId) -> void:
    call = arena.nodes[id.index]
    args: List[types.TypeId] = []
    offset: i32 = 1
    while offset < call.child_count:
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if checker_core.is_type_kind(child.kind):
            type_id = checker_core.resolve_type_node(checker, arena, child_id, source)
            checker.model.record_type_node(child_id, type_id)
            args.append(type_id)
        offset += 1
    declaration = checker.symbols.symbols[callee.index].node
    if cast[i32](len(args)) != generics.type_param_count(arena, declaration):
        checker_core.emit_error(checker, 354, call.start, call.length, call.line, call.column)
        return
    suffix = generics.specialization_suffix(checker.type_table, &args, source)
    user_suffix = suffix[0:len(suffix)]
    checker.model.record_specialization(id, callee, &args, suffix)
    checker.model.record_user_specialization(declaration, &args, user_suffix)
    specialized_return = generics.substitute_type(checker.type_table, checker.symbols.symbols[callee.index].type_id, arena, declaration, &args, source)
    checker.model.record_call(id, callee, specialized_return, 1)
    checker.model.record_expr_type(id, specialized_return)


def record_user_type_specialization(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count <= 1:
        return
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    found = checker.symbols.find_in_scope(source, symbols.root_scope(), base.value_start, base.value_length)
    if found.index < 0:
        return
    declaration = checker.symbols.symbols[found.index].node
    if not generics.has_type_params(arena, declaration):
        return
    type_id = checker_core.resolve_type_node(checker, arena, id, source)
    checker.model.record_type_node(id, type_id)
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, type_id)
    arg_index: usize = 0
    while arg_index < len(args):
        arg = args[arg_index]
        if generics.contains_type_parameter(checker.type_table, arg, arena, declaration, source):
            return
        arg_index += 1
    suffix = generics.specialization_suffix(checker.type_table, &args, source)
    checker.model.record_user_specialization(declaration, &args, suffix)


def validate_user_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)):
        return
    receiver_record = checker.type_table.types[receiver_type.index]
    if not types.is_nominal_kind(receiver_record.kind) or receiver_record.name_length == 0:
        return
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), receiver_record.name_start, receiver_record.name_length)
    if owner.index < 0:
        return
    member_scope = checker.symbols.symbols[owner.index].member_scope
    member_node = arena.nodes[member.index]
    method = checker.symbols.find_in_current_scope(source, member_scope, member_node.value_start, member_node.value_length)
    if method.index < 0 or checker.symbols.symbols[method.index].kind != symbols.SymbolKind.METHOD:
        return
    declaration = checker.symbols.symbols[owner.index].node
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, receiver_type)
    return_type = checker.symbols.symbols[method.index].type_id
    if len(args) > 0 and generics.has_type_params(arena, declaration):
        return_type = generics.substitute_type(checker.type_table, return_type, arena, declaration, &args, source)
    checker.model.record_name_symbol(member, method)
    checker.model.record_call(call_id, method, return_type, 0)
    checker.model.record_expr_type(call_id, return_type)
    expected = checker.symbols.symbols[method.index].arity - 1
    if expected < 0:
        expected = 0
    validate_collection_method_argument_count(checker, arena, call_id, expected)
    validate_declared_call_move_arguments(checker, arena, call_id, checker.symbols.symbols[method.index].node, source, current_scope, 1)


def infer_generic_call_specialization(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    callee: symbols.SymbolId,
) -> void:
    declaration = checker.symbols.symbols[callee.index].node
    params: List[NodeId] = generics.collect_type_params(arena, declaration)
    inferred: List[types.TypeId] = []
    param_offset: usize = 0
    while param_offset < len(params):
        inferred.append(types.missing_type())
        param_offset += 1
    function = arena.nodes[declaration.index]
    parameter_index: i32 = 0
    for declaration_offset in range(0, function.child_count):
        parameter_id = arena.children[function.first_child + declaration_offset]
        parameter = arena.nodes[parameter_id.index]
        if parameter.kind != syntax.SyntaxKind.PARAMETER:
            continue
        argument = call_argument_value(arena, call_id, parameter_index)
        if argument.index >= 0:
            actual = infer_expression_type(checker, arena, argument, source, current_scope)
            pattern = checker_core.find_child_type(arena, parameter_id)
            infer_type_arguments_from_pattern(checker, arena, declaration, pattern, actual, &inferred, source)
        parameter_index += 1
    inferred_index: usize = 0
    while inferred_index < len(inferred):
        inferred_type = inferred[inferred_index]
        if inferred_type.index < 0 or inferred_type.index == types.type_error().index:
            call_node = arena.nodes[call_id.index]
            checker_core.emit_error(checker, 355, call_node.start, call_node.length, call_node.line, call_node.column)
            return
        inferred_index += 1
    suffix = generics.specialization_suffix(checker.type_table, &inferred, source)
    user_suffix = suffix[0:len(suffix)]
    checker.model.record_specialization(call_id, callee, &inferred, suffix)
    checker.model.record_user_specialization(declaration, &inferred, user_suffix)
    specialized_return = generics.substitute_type(checker.type_table, checker.symbols.symbols[callee.index].type_id, arena, declaration, &inferred, source)
    checker.model.record_call(call_id, callee, specialized_return, 1)
    checker.model.record_expr_type(call_id, specialized_return)


def infer_type_arguments_from_pattern(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    declaration: NodeId,
    pattern: NodeId,
    actual: types.TypeId,
    inferred: &List[types.TypeId],
    source: &const String,
) -> void:
    if pattern.index < 0 or actual.index < 0 or actual.index >= cast[i32](len(checker.type_table.types)):
        return
    pattern_node = arena.nodes[pattern.index]
    if pattern_node.kind == syntax.SyntaxKind.TYPE_NAME:
        parameter = generics.type_parameter_index(arena, declaration, source, pattern_node.value_start, pattern_node.value_length)
        if parameter >= 0 and parameter < cast[i32](len(inferred)):
            existing = inferred[cast[usize](parameter)]
            if existing.index < 0:
                inferred[cast[usize](parameter)] = actual
            elif not checker.type_table.same(existing, actual):
                pattern_span = arena.nodes[pattern.index]
                checker_core.emit_error(checker, 107, pattern_span.start, pattern_span.length, pattern_span.line, pattern_span.column)
        return
    actual_record = checker.type_table.types[actual.index]
    if pattern_node.kind == syntax.SyntaxKind.TYPE_POINTER or pattern_node.kind == syntax.SyntaxKind.TYPE_REFERENCE or pattern_node.kind == syntax.SyntaxKind.TYPE_CONST or pattern_node.kind == syntax.SyntaxKind.TYPE_SLICE or pattern_node.kind == syntax.SyntaxKind.TYPE_ARRAY or pattern_node.kind == syntax.SyntaxKind.TYPE_DYN:
        infer_type_arguments_from_pattern(checker, arena, declaration, checker_core.first_child(arena, pattern), actual_record.inner, inferred, source)
        return
    if pattern_node.kind != syntax.SyntaxKind.TYPE_GENERIC:
        return
    offset: i32 = 1
    while offset < pattern_node.child_count:
        actual_argument = generic_actual_argument(checker.type_table, actual_record, offset - 1)
        infer_type_arguments_from_pattern(checker, arena, declaration, arena.children[pattern_node.first_child + offset], actual_argument, inferred, source)
        offset += 1


def generic_actual_argument(table: &const types.TypeTable, record: types.TypeRecord, index: i32) -> types.TypeId:
    if index < 0:
        return types.missing_type()
    if record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.RESULT:
        if index == 0:
            return record.inner
        if index == 1:
            return record.second
        return types.missing_type()
    if record.kind == types.TypeKind.OPTION or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        if index == 0:
            return record.inner
        return types.missing_type()
    if index < record.flags:
        return table.type_args[cast[usize](record.extra + index)]
    return types.missing_type()


def infer_expression_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    if id.index < 0:
        return types.type_error()
    existing = checker.model.expr_type(id)
    if existing.index != types.type_error().index and checker.specialization_declaration.index < 0:
        return existing
    node = arena.nodes[id.index]
    result = types.type_error()
    if node.kind == syntax.SyntaxKind.EXPR_LITERAL:
        if node.flags == cast[i32](token.TokenKind.TRUE) or node.flags == cast[i32](token.TokenKind.FALSE):
            result = types.type_bool()
        elif node.flags == cast[i32](token.TokenKind.STRING):
            result = types.type_string()
        elif node.flags == cast[i32](token.TokenKind.CHAR):
            result = types.type_char()
        elif node.flags == cast[i32](token.TokenKind.FLOAT):
            result = types.type_f64()
        elif node.flags == cast[i32](token.TokenKind.NULL) or node.flags == cast[i32](token.TokenKind.NONE):
            result = types.type_error()
        else:
            result = types.type_i32()
    elif node.kind == syntax.SyntaxKind.EXPR_NAME:
        found = checker.symbols.find_in_scope(source, current_scope, node.value_start, node.value_length)
        if found.index >= 0:
            checker.model.record_name_symbol(id, found)
            result = checker.symbols.symbols[found.index].type_id
    elif node.kind == syntax.SyntaxKind.EXPR_CALL:
        validate_call(checker, arena, id, source, current_scope)
        result = checker.model.expr_type(id)
    elif node.kind == syntax.SyntaxKind.EXPR_CAST:
        type_node = checker_core.find_child_type(arena, id)
        result = checker_core.resolve_type_node(checker, arena, type_node, source)
        checker.model.record_type_node(type_node, result)
    elif node.kind == syntax.SyntaxKind.EXPR_LIST:
        result = infer_list_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_MAP:
        result = infer_map_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_SET:
        result = infer_set_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_TUPLE:
        result = infer_tuple_literal_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_INDEX:
        receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope))
        result = indexed_element_type(checker.type_table, arena, checker_core.second_child(arena, id), source, receiver_type)
    elif node.kind == syntax.SyntaxKind.EXPR_SLICE:
        result = infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        result = infer_attribute_expression_type(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_UNARY:
        operand_type = infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope)
        result = operand_type
        if node.flags == cast[i32](token.TokenKind.AMPERSAND):
            result = checker.type_table.pointer_to(operand_type)
        elif node.flags == cast[i32](token.TokenKind.STAR) and operand_type.index >= 0 and operand_type.index < cast[i32](len(checker.type_table.types)):
            operand_record = checker.type_table.types[operand_type.index]
            if operand_record.kind == types.TypeKind.POINTER or operand_record.kind == types.TypeKind.REFERENCE or operand_record.kind == types.TypeKind.OWNED:
                result = operand_record.inner
    elif node.kind == syntax.SyntaxKind.EXPR_BINARY:
        operator = node.flags
        if operator == cast[i32](token.TokenKind.EQUAL) or operator == cast[i32](token.TokenKind.NOT_EQUAL) or operator == cast[i32](token.TokenKind.LESS) or operator == cast[i32](token.TokenKind.LESS_EQUAL) or operator == cast[i32](token.TokenKind.GREATER) or operator == cast[i32](token.TokenKind.GREATER_EQUAL) or operator == cast[i32](token.TokenKind.AND) or operator == cast[i32](token.TokenKind.OR) or operator == cast[i32](token.TokenKind.IN) or operator == cast[i32](token.TokenKind.NOT):
            if operator == cast[i32](token.TokenKind.IN) or operator == cast[i32](token.TokenKind.NOT):
                infer_expression_type(checker, arena, checker_core.first_child(arena, id), source, current_scope)
                infer_expression_type(checker, arena, checker_core.second_child(arena, id), source, current_scope)
            result = types.type_bool()
        else:
            left = checker_core.first_child(arena, id)
            right = checker_core.second_child(arena, id)
            left_type = infer_expression_type(checker, arena, left, source, current_scope)
            right_type = infer_expression_type(checker, arena, right, source, current_scope)
            if is_set_algebra_operator(operator) and semantic_type_is_kind(checker.type_table, left_type, types.TypeKind.SET):
                if not checker.type_table.same(left_type, right_type):
                    right_node = arena.nodes[right.index]
                    checker_core.emit_error(checker, 107, right_node.start, right_node.length, right_node.line, right_node.column)
                    result = types.type_error()
                else:
                    result = left_type
            elif checker.specialization_declaration.index >= 0 and not specialized_operand_types_compatible(checker, left_type, right_type):
                right_node = arena.nodes[right.index]
                checker_core.emit_error(checker, 107, right_node.start, right_node.length, right_node.line, right_node.column)
                result = types.type_error()
            else:
                result = left_type
    checker.model.record_expr_type(id, result)
    return result


def infer_attribute_expression_type(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> types.TypeId:
    receiver = checker_core.first_child(arena, id)
    member = checker_core.second_child(arena, id)
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)) or member.index < 0:
        return receiver_type
    receiver_record = checker.type_table.types[receiver_type.index]
    member_node = arena.nodes[member.index]
    if receiver_record.kind == types.TypeKind.OPTION and checker_core.range_text_equals(source, member_node.value_start, member_node.value_length, "value"):
        return receiver_record.inner
    if not types.is_nominal_kind(receiver_record.kind) or receiver_record.name_length == 0:
        return receiver_type
    owner = checker.symbols.find_in_scope(source, symbols.root_scope(), receiver_record.name_start, receiver_record.name_length)
    if owner.index < 0:
        return receiver_type
    field = checker.symbols.find_in_current_scope(source, checker.symbols.symbols[owner.index].member_scope, member_node.value_start, member_node.value_length)
    if field.index < 0 or checker.symbols.symbols[field.index].kind != symbols.SymbolKind.FIELD:
        return receiver_type
    checker.model.record_name_symbol(member, field)
    field_type = checker.symbols.symbols[field.index].type_id
    args: List[types.TypeId] = generics.specialization_arguments(checker.type_table, receiver_type)
    declaration = checker.symbols.symbols[owner.index].node
    if len(args) > 0 and generics.has_type_params(arena, declaration):
        field_type = generics.substitute_type(checker.type_table, field_type, arena, declaration, &args, source)
    return field_type


def infer_list_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    element = types.type_error()
    if node.child_count > 0:
        element = infer_expression_type(checker, arena, arena.children[node.first_child], source, current_scope)
    return collections.list_type(checker.type_table, element)


def infer_set_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    element = types.type_error()
    if node.child_count > 0:
        element = infer_expression_type(checker, arena, arena.children[node.first_child], source, current_scope)
    return collections.set_type(checker.type_table, element)


def infer_map_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    key_type = types.type_error()
    value_type = types.type_error()
    if node.child_count > 0:
        entry_id = arena.children[node.first_child]
        entry = arena.nodes[entry_id.index]
        if entry.child_count > 0:
            key_type = infer_expression_type(checker, arena, arena.children[entry.first_child], source, current_scope)
        if entry.child_count > 1:
            value_type = infer_expression_type(checker, arena, arena.children[entry.first_child + 1], source, current_scope)
    return collections.map_type(checker.type_table, key_type, value_type)


def infer_tuple_literal_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    node = arena.nodes[id.index]
    args: List[types.TypeId] = []
    for offset in range(0, node.child_count):
        args.append(infer_expression_type(checker, arena, arena.children[node.first_child + offset], source, current_scope))
    return checker.type_table.tuple_from_args(args)


def indexed_element_type(table: &const types.TypeTable, arena: &const syntax.SyntaxArena, index: NodeId, source: &const String, receiver_type: types.TypeId) -> types.TypeId:
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(table.types)):
        return types.type_error()
    record = table.types[receiver_type.index]
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.ARRAY or record.kind == types.TypeKind.SLICE:
        return record.inner
    if record.kind == types.TypeKind.MAP:
        return record.second
    if record.kind != types.TypeKind.TUPLE or index.index < 0:
        return receiver_type
    index_node = arena.nodes[index.index]
    if index_node.kind != syntax.SyntaxKind.EXPR_LITERAL:
        return types.type_error()
    offset = parse_decimal_index(source, index_node.value_start, index_node.value_length)
    if offset < 0 or offset >= record.flags:
        return types.type_error()
    return table.type_args[cast[usize](record.extra + offset)]


def parse_decimal_index(source: &const String, start: usize, length: usize) -> i32:
    result: i32 = 0
    for offset in range(0, length):
        byte = source.byte_at(start + offset)
        if byte < 48 or byte > 57:
            return -1
        result = result * 10 + cast[i32](byte - 48)
    return result


def validate_collection_method_call(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> void:
    receiver = checker_core.first_child(arena, callee_id)
    member = checker_core.second_child(arena, callee_id)
    if receiver.index < 0 or member.index < 0:
        return
    receiver_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, receiver, source, current_scope))
    if receiver_type.index < 0 or receiver_type.index >= cast[i32](len(checker.type_table.types)):
        return
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    receiver_record = checker.type_table.types[receiver_type.index]
    if receiver_record.kind == types.TypeKind.STRING:
        expected: i32 = 0
        result = types.type_void()
        if collections.text_equals(&member_name, "clone"):
            result = types.type_string()
        elif collections.text_equals(&member_name, "byte_at"):
            expected = 1
            result = types.type_i32()
        elif collections.text_equals(&member_name, "append") or collections.text_equals(&member_name, "append_char") or collections.text_equals(&member_name, "reserve"):
            expected = 1
        elif not collections.text_equals(&member_name, "clear"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.STRING_BUILDER:
        expected: i32 = 1
        result = types.type_void()
        if collections.text_equals(&member_name, "finish"):
            expected = 0
            result = types.type_string()
        elif not collections.text_equals(&member_name, "append") and not collections.text_equals(&member_name, "append_char") and not collections.text_equals(&member_name, "reserve"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.LIST:
        expected: i32 = 0
        result = types.type_void()
        takes_element = false
        if collections.text_equals(&member_name, "append"):
            expected = 1
            takes_element = true
        elif collections.text_equals(&member_name, "pop"):
            result = receiver_record.inner
        elif not collections.text_equals(&member_name, "clear") and not collections.text_equals(&member_name, "sort"):
            return
        validate_collection_method_argument_count(checker, arena, call_id, expected)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            argument_type = infer_expression_type(checker, arena, argument, source, current_scope)
            if takes_element:
                validate_partial_move_source(checker, arena, argument, argument_type, receiver_record.inner, source)
        checker.model.record_expr_type(call_id, result)
        return
    if receiver_record.kind == types.TypeKind.MAP and (collections.text_equals(&member_name, "keys") or collections.text_equals(&member_name, "values") or collections.text_equals(&member_name, "items")):
        validate_collection_method_argument_count(checker, arena, call_id, 0)
        checker.model.record_expr_type(call_id, collections.map_view_type(checker.type_table, receiver_type, &member_name))
        return
    if receiver_record.kind == types.TypeKind.MAP and collections.text_equals(&member_name, "get"):
        validate_collection_method_argument_count(checker, arena, call_id, 1)
        argument = call_argument_value(arena, call_id, 0)
        if argument.index >= 0:
            infer_expression_type(checker, arena, argument, source, current_scope)
        checker.model.record_expr_type(call_id, checker.type_table.generic1(types.TypeKind.OPTION, 0, 0, receiver_record.second))
        return
    if receiver_record.kind == types.TypeKind.SET:
        is_algebra = collections.text_equals(&member_name, "union") or collections.text_equals(&member_name, "intersection") or collections.text_equals(&member_name, "difference") or collections.text_equals(&member_name, "symmetric_difference")
        is_update = collections.text_equals(&member_name, "update")
        if is_algebra or is_update:
            validate_collection_method_argument_count(checker, arena, call_id, 1)
            argument = call_argument_value(arena, call_id, 0)
            if argument.index >= 0:
                argument_type = strip_collection_indirection(checker.type_table, infer_expression_type(checker, arena, argument, source, current_scope))
                if not checker.type_table.same(receiver_type, argument_type):
                    argument_node = arena.nodes[argument.index]
                    checker_core.emit_error(checker, 107, argument_node.start, argument_node.length, argument_node.line, argument_node.column)
            if is_algebra:
                checker.model.record_expr_type(call_id, receiver_type)
            else:
                checker.model.record_expr_type(call_id, types.type_void())


def validate_collection_method_argument_count(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, call_id: NodeId, expected: i32) -> void:
    call = arena.nodes[call_id.index]
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    if actual < expected:
        checker_core.emit_error(checker, 78, call.start, call.length, call.line, call.column)
    elif actual > expected:
        checker_core.emit_error(checker, 77, call.start, call.length, call.line, call.column)


def strip_collection_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current


def semantic_type_is_kind(table: &const types.TypeTable, type_id: types.TypeId, kind: types.TypeKind) -> bool:
    value_type = strip_collection_indirection(table, type_id)
    return value_type.index >= 0 and value_type.index < cast[i32](len(table.types)) and table.types[value_type.index].kind == kind


def is_set_algebra_operator(operator: i32) -> bool:
    return operator == cast[i32](token.TokenKind.PIPE) or operator == cast[i32](token.TokenKind.AMPERSAND) or operator == cast[i32](token.TokenKind.MINUS) or operator == cast[i32](token.TokenKind.CARET)


def types_compatible(checker: &checker_core.Checker, expected: types.TypeId, actual: types.TypeId) -> bool:
    if checker.type_table.same(expected, actual):
        return true
    if expected.index < 0 or actual.index < 0:
        return true
    expected_kind = checker.type_table.types[expected.index].kind
    actual_kind = checker.type_table.types[actual.index].kind
    if expected_kind == types.TypeKind.ERROR or actual_kind == types.TypeKind.ERROR:
        return true
    if types.is_map_view_kind(expected_kind) or types.is_map_view_kind(actual_kind):
        return checker.type_table.same(expected, actual)
    if is_numeric_kind(expected_kind) and is_numeric_kind(actual_kind):
        return true
    if expected_kind == types.TypeKind.BOOL and is_scalar_kind(actual_kind):
        return true
    if actual_kind == types.TypeKind.STRING:
        if expected_kind == types.TypeKind.CONST or expected_kind == types.TypeKind.POINTER:
            return true
        return false
    return true


def specialized_operand_types_compatible(checker: &checker_core.Checker, left: types.TypeId, right: types.TypeId) -> bool:
    if checker.type_table.same(left, right):
        return true
    if left.index < 0 or right.index < 0:
        return false
    left_kind = checker.type_table.types[left.index].kind
    right_kind = checker.type_table.types[right.index].kind
    return is_numeric_kind(left_kind) and is_numeric_kind(right_kind)


def is_numeric_kind(kind: types.TypeKind) -> bool:
    return kind == types.TypeKind.I32 or kind == types.TypeKind.I64 or kind == types.TypeKind.F64 or kind == types.TypeKind.CHAR


def is_scalar_kind(kind: types.TypeKind) -> bool:
    return kind == types.TypeKind.BOOL or is_numeric_kind(kind) or kind == types.TypeKind.ENUM or kind == types.TypeKind.POINTER or kind == types.TypeKind.REFERENCE or kind == types.TypeKind.DYN


def validate_hashable_collection_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind != syntax.SyntaxKind.TYPE_GENERIC or node.child_count <= 1:
        return
    base_id = arena.children[node.first_child]
    base = arena.nodes[base_id.index]
    code: i32 = 0
    if checker_core.range_text_equals(source, base.value_start, base.value_length, "Map"):
        code = 297
    elif checker_core.range_text_equals(source, base.value_start, base.value_length, "Set"):
        code = 300
    if code == 0:
        return
    item_id = arena.children[node.first_child + 1]
    if type_node_is_hashable(checker, arena, item_id, source, current_scope):
        return
    item = arena.nodes[item_id.index]
    checker_core.emit_error(checker, code, item.start, item.length, item.line, item.column)


def type_node_is_hashable(checker: &const checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if type_node_is_c_string(arena, id, source):
        return true
    if node.kind != syntax.SyntaxKind.TYPE_NAME:
        return false
    if type_name_is_hash_scalar(source, &node) or checker_core.range_text_equals(source, node.value_start, node.value_length, "String"):
        return true
    type_name = source[node.start:node.start + node.length]
    if checker_core.string_list_contains(&checker.imported_enum_names, &type_name):
        return true
    found = checker.symbols.find_in_scope(source, current_scope, node.value_start, node.value_length)
    return found.index >= 0 and checker.symbols.symbols[found.index].kind == symbols.SymbolKind.ENUM


def type_node_is_c_string(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.TYPE_CONST:
        pointer = checker_core.first_child(arena, id)
        if pointer.index < 0 or arena.nodes[pointer.index].kind != syntax.SyntaxKind.TYPE_POINTER:
            return false
        return type_node_is_exact_name(arena, checker_core.first_child(arena, pointer), source, "char")
    if node.kind == syntax.SyntaxKind.TYPE_POINTER:
        const_type = checker_core.first_child(arena, id)
        if const_type.index < 0 or arena.nodes[const_type.index].kind != syntax.SyntaxKind.TYPE_CONST:
            return false
        return type_node_is_exact_name(arena, checker_core.first_child(arena, const_type), source, "char")
    return false


def type_node_is_exact_name(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, expected: String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    return node.kind == syntax.SyntaxKind.TYPE_NAME and checker_core.range_text_equals(source, node.value_start, node.value_length, expected)


def type_name_is_hash_scalar(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    return checker_core.range_text_equals(source, node.value_start, node.value_length, "bool") or checker_core.range_text_equals(source, node.value_start, node.value_length, "char") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i8") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i16") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i32") or checker_core.range_text_equals(source, node.value_start, node.value_length, "i64") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u8") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u16") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u32") or checker_core.range_text_equals(source, node.value_start, node.value_length, "u64") or checker_core.range_text_equals(source, node.value_start, node.value_length, "isize") or checker_core.range_text_equals(source, node.value_start, node.value_length, "usize") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_int") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_long") or checker_core.range_text_equals(source, node.value_start, node.value_length, "c_size_t")


def semantic_type_is_hashable(table: &const types.TypeTable, type_id: types.TypeId, source: &const String) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return true
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.ERROR or record.kind == types.TypeKind.BOOL or record.kind == types.TypeKind.I32 or record.kind == types.TypeKind.I64 or record.kind == types.TypeKind.CHAR or record.kind == types.TypeKind.STRING or record.kind == types.TypeKind.ENUM:
        return true
    if semantic_type_is_c_string(table, type_id):
        return true
    if record.kind != types.TypeKind.NAMED:
        return false
    name = source[record.name_start:record.name_start + record.name_length]
    return name == "i8" or name == "i16" or name == "i32" or name == "i64" or name == "u8" or name == "u16" or name == "u32" or name == "u64" or name == "isize" or name == "usize" or name == "c_int" or name == "c_long" or name == "c_size_t"


def semantic_type_is_c_string(table: &const types.TypeTable, type_id: types.TypeId) -> bool:
    if type_id.index < 0 or type_id.index >= cast[i32](len(table.types)):
        return false
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.CONST:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        pointer = table.types[record.inner.index]
        return pointer.kind == types.TypeKind.POINTER and pointer.inner.index >= 0 and pointer.inner.index < cast[i32](len(table.types)) and table.types[pointer.inner.index].kind == types.TypeKind.CHAR
    if record.kind == types.TypeKind.POINTER:
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(table.types)):
            return false
        const_type = table.types[record.inner.index]
        return const_type.kind == types.TypeKind.CONST and const_type.inner.index >= 0 and const_type.inner.index < cast[i32](len(table.types)) and table.types[const_type.inner.index].kind == types.TypeKind.CHAR
    return false


def is_string_literal(arena: &const syntax.SyntaxArena, id: NodeId) -> bool:
    node = arena.nodes[id.index]
    return node.kind == syntax.SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING)


def is_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "print") or checker_core.range_text_equals(source, start, length, "len") or checker_core.range_text_equals(source, start, length, "open") or checker_core.range_text_equals(source, start, length, "range") or checker_core.range_text_equals(source, start, length, "sort") or checker_core.range_text_equals(source, start, length, "input") or checker_core.range_text_equals(source, start, length, "to_string") or checker_core.range_text_equals(source, start, length, "set") or checker_core.range_text_equals(source, start, length, "free") or checker_core.range_text_equals(source, start, length, "panic") or checker_core.range_text_equals(source, start, length, "String") or checker_core.range_text_equals(source, start, length, "StringBuilder") or checker_core.range_text_equals(source, start, length, "Some") or checker_core.range_text_equals(source, start, length, "Owned") or checker_core.range_text_equals(source, start, length, "Ok") or checker_core.range_text_equals(source, start, length, "Err") or checker_core.range_text_equals(source, start, length, "closure") or checker_core.range_text_equals(source, start, length, "super") or is_parse_builtin_name(source, start, length) or is_reflection_builtin_name(source, start, length)


def is_parse_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "parse_i32") or checker_core.range_text_equals(source, start, length, "parse_i64") or checker_core.range_text_equals(source, start, length, "parse_u32") or checker_core.range_text_equals(source, start, length, "parse_u64") or checker_core.range_text_equals(source, start, length, "parse_isize") or checker_core.range_text_equals(source, start, length, "parse_usize") or checker_core.range_text_equals(source, start, length, "parse_f32") or checker_core.range_text_equals(source, start, length, "parse_f64") or checker_core.range_text_equals(source, start, length, "parse_bool")


def is_reflection_builtin_name(source: &const String, start: usize, length: usize) -> bool:
    return checker_core.range_text_equals(source, start, length, "type_of") or checker_core.range_text_equals(source, start, length, "type_name") or checker_core.range_text_equals(source, start, length, "type_info") or checker_core.range_text_equals(source, start, length, "size_of") or checker_core.range_text_equals(source, start, length, "align_of") or checker_core.range_text_equals(source, start, length, "field_count") or checker_core.range_text_equals(source, start, length, "method_count") or checker_core.range_text_equals(source, start, length, "fields") or checker_core.range_text_equals(source, start, length, "methods") or checker_core.range_text_equals(source, start, length, "fields_of") or checker_core.range_text_equals(source, start, length, "methods_of") or checker_core.range_text_equals(source, start, length, "has_field") or checker_core.range_text_equals(source, start, length, "has_method") or checker_core.range_text_equals(source, start, length, "implements")
