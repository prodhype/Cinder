import cinder


extern "C":
    def cinder_unicode_display_column(
        source: const char*,
        source_length: usize,
        start: usize,
        end: usize,
        initial_column: i32,
    ) -> i32


# DiagnosticId is intentionally phase-qualified. Legacy numeric codes overlap
# between phases, so the enum value is an identity only; diagnostic_code()
# is the sole stable numeric mapping.
