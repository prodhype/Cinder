enum DiagnosticCategory:
    LEXICAL
    SYNTAX
    NAME_RESOLUTION
    TYPE_SYSTEM
    OWNERSHIP
    IMPORT
    GENERICS
    CONCURRENCY
    LOCK_ORDER
    SEMANTIC
    INTERNAL


enum DiagnosticArgumentKind:
    TEXT
    TYPE
    TOKEN
    SYMBOL
    PATH
    SIGNED_INTEGER
    UNSIGNED_INTEGER
    COUNT
    BOOLEAN
    CHARACTER


struct SourceSpan:
    path: String
    start: usize
    length: usize
    line: i32
    column: i32


struct RelatedSpan:
    label: String
    span: SourceSpan


# DiagnosticArgument uses an explicit tag plus primitive storage instead of an
# owning variant payload. This keeps diagnostics independent of compiler AST,
# token, symbol, and type modules.
struct DiagnosticArgument:
    name: String
    kind: DiagnosticArgumentKind
    text: String
    signed_value: i64
    unsigned_value: u64
    bool_value: bool
    char_value: char


struct DiagnosticDefinition:
    id: DiagnosticId
    code: i32
    category: DiagnosticCategory
    name: String
    title: String
    message_template: String
    note: String
    help: String


struct Diagnostic:
    id: DiagnosticId
    primary: SourceSpan
    arguments: List[DiagnosticArgument]
    related: List[RelatedSpan]
    notes: List[String]
    help: String

    def add_argument(self: &Diagnostic, argument: DiagnosticArgument) -> void:
        self.arguments.append(argument)

    def add_related(self: &Diagnostic, related: RelatedSpan) -> void:
        self.related.append(related)

    def add_note(self: &Diagnostic, note: String) -> void:
        self.notes.append(note)

    def set_help(self: &Diagnostic, help: String) -> void:
        self.help = help


def source_span(start: usize, length: usize, line: i32, column: i32) -> SourceSpan:
    return SourceSpan(path="", start=start, length=length, line=line, column=column)


def source_span_in(path: String, start: usize, length: usize, line: i32, column: i32) -> SourceSpan:
    return SourceSpan(path=path, start=start, length=length, line=line, column=column)


def related_span(label: String, span: SourceSpan) -> RelatedSpan:
    return RelatedSpan(label=label, span=span)


def new_diagnostic(id: DiagnosticId, primary: SourceSpan) -> Diagnostic:
    arguments: List[DiagnosticArgument] = []
    related: List[RelatedSpan] = []
    notes: List[String] = []
    return Diagnostic(id=id, primary=primary, arguments=arguments, related=related, notes=notes, help="")


def clone_diagnostic(value: &const Diagnostic) -> Diagnostic:
    result = new_diagnostic(value.id, clone_source_span(&value.primary))
    for argument in value.arguments:
        result.add_argument(
            DiagnosticArgument(
                name=argument.name[0:len(argument.name)],
                kind=argument.kind,
                text=argument.text[0:len(argument.text)],
                signed_value=argument.signed_value,
                unsigned_value=argument.unsigned_value,
                bool_value=argument.bool_value,
                char_value=argument.char_value,
            )
        )
    for related in value.related:
        result.add_related(
            related_span(
                related.label[0:len(related.label)],
                clone_source_span(&related.span),
            )
        )
    for note in value.notes:
        result.add_note(note[0:len(note)])
    result.set_help(value.help[0:len(value.help)])
    return result


def clone_source_span(value: &const SourceSpan) -> SourceSpan:
    return source_span_in(
        value.path[0:len(value.path)],
        value.start,
        value.length,
        value.line,
        value.column,
    )


def clone_diagnostic_at(values: &const List[Diagnostic], index: usize) -> Diagnostic:
    return clone_diagnostic(&values[index])


def diagnostic_matches_at(
    values: &const List[Diagnostic],
    index: usize,
    id: DiagnosticId,
    start: usize,
) -> bool:
    if index >= len(values):
        return false
    value: &const Diagnostic = &values[index]
    return value.id == id and value.primary.start == start


def diagnostic_with_argument(id: DiagnosticId, primary: SourceSpan, argument: DiagnosticArgument) -> Diagnostic:
    result = new_diagnostic(id, primary)
    result.add_argument(argument)
    return result


def diagnostic_with_arguments(
    id: DiagnosticId,
    primary: SourceSpan,
    first: DiagnosticArgument,
    second: DiagnosticArgument,
) -> Diagnostic:
    result = new_diagnostic(id, primary)
    result.add_argument(first)
    result.add_argument(second)
    return result


def diagnostic_with_three_arguments(
    id: DiagnosticId,
    primary: SourceSpan,
    first: DiagnosticArgument,
    second: DiagnosticArgument,
    third: DiagnosticArgument,
) -> Diagnostic:
    result = new_diagnostic(id, primary)
    result.add_argument(first)
    result.add_argument(second)
    result.add_argument(third)
    return result


def parser_expected_diagnostic(id: DiagnosticId, primary: SourceSpan, expected: String, actual: String) -> Diagnostic:
    return diagnostic_with_arguments(id, primary, argument_token("expected", expected), argument_token("actual", actual))


def type_mismatch_diagnostic(primary: SourceSpan, expected: String, actual: String) -> Diagnostic:
    return diagnostic_with_arguments(
        DiagnosticId.CHECK_107,
        primary,
        argument_type("expected", expected),
        argument_type("actual", actual),
    )


def argument_text(name: String, value: String) -> DiagnosticArgument:
    return text_argument(name, DiagnosticArgumentKind.TEXT, value)


def argument_type(name: String, display: String) -> DiagnosticArgument:
    return text_argument(name, DiagnosticArgumentKind.TYPE, display)


def argument_token(name: String, display: String) -> DiagnosticArgument:
    return text_argument(name, DiagnosticArgumentKind.TOKEN, display)


def argument_symbol(name: String, display: String) -> DiagnosticArgument:
    return text_argument(name, DiagnosticArgumentKind.SYMBOL, display)


def argument_path(name: String, path: String) -> DiagnosticArgument:
    return text_argument(name, DiagnosticArgumentKind.PATH, path)


def argument_signed(name: String, value: i64) -> DiagnosticArgument:
    return primitive_argument(name, DiagnosticArgumentKind.SIGNED_INTEGER, value, 0, false, cast[char](0))


def argument_unsigned(name: String, value: u64) -> DiagnosticArgument:
    return primitive_argument(name, DiagnosticArgumentKind.UNSIGNED_INTEGER, 0, value, false, cast[char](0))


def argument_count(name: String, value: i32) -> DiagnosticArgument:
    return primitive_argument(name, DiagnosticArgumentKind.COUNT, cast[i64](value), 0, false, cast[char](0))


def argument_boolean(name: String, value: bool) -> DiagnosticArgument:
    return primitive_argument(name, DiagnosticArgumentKind.BOOLEAN, 0, 0, value, cast[char](0))


def argument_character(name: String, value: char) -> DiagnosticArgument:
    return primitive_argument(name, DiagnosticArgumentKind.CHARACTER, 0, 0, false, value)


def text_argument(name: String, kind: DiagnosticArgumentKind, value: String) -> DiagnosticArgument:
    return DiagnosticArgument(
        name=name,
        kind=kind,
        text=value,
        signed_value=0,
        unsigned_value=0,
        bool_value=false,
        char_value=cast[char](0),
    )


def primitive_argument(
    name: String,
    kind: DiagnosticArgumentKind,
    signed_value: i64,
    unsigned_value: u64,
    bool_value: bool,
    char_value: char,
) -> DiagnosticArgument:
    return DiagnosticArgument(
        name=name,
        kind=kind,
        text="",
        signed_value=signed_value,
        unsigned_value=unsigned_value,
        bool_value=bool_value,
        char_value=char_value,
    )


def diagnostic_code(id: DiagnosticId) -> i32:
    definition_value = diagnostic_definition(id)
    return definition_value.code


def diagnostic_definition(id: DiagnosticId) -> DiagnosticDefinition:
    # LexerCode is currently cast directly to i32, so compatibility requires
    # retaining its actual ordinal-derived values 0 through 10. The explicit
    # mapping here prevents future enum edits from changing those values.
    if id == DiagnosticId.LEX_001:
        return definition(id, 0, DiagnosticCategory.LEXICAL, "lexer.L001", "Tab in indentation", "tabs are not allowed in indentation", "replace indentation tabs with spaces")
    if id == DiagnosticId.LEX_002:
        return definition(id, 1, DiagnosticCategory.LEXICAL, "lexer.L002", "Incomplete continuation", "the file ends after an explicit line continuation", "continue the expression on the next line or remove the backslash")
    if id == DiagnosticId.LEX_003:
        return definition(id, 2, DiagnosticCategory.LEXICAL, "lexer.L003", "Unclosed delimiter", "the opening delimiter is not closed", "add the matching closing delimiter")
    if id == DiagnosticId.LEX_004:
        return definition(id, 3, DiagnosticCategory.LEXICAL, "lexer.L004", "Inconsistent indentation", "indentation does not match an earlier indentation level", "align this line with an existing block indentation")
    if id == DiagnosticId.LEX_005:
        return definition(id, 4, DiagnosticCategory.LEXICAL, "lexer.L005", "Unexpected character", "the character {actual} is not valid here", "remove the character or replace it with a valid token")
    if id == DiagnosticId.LEX_006:
        return definition(id, 5, DiagnosticCategory.LEXICAL, "lexer.L006", "Unterminated string", "the string literal is not terminated on this line", "add the matching quote")
    if id == DiagnosticId.LEX_007:
        return definition(id, 6, DiagnosticCategory.LEXICAL, "lexer.L007", "Incomplete exponent", "the floating-point exponent has no digits", "add exponent digits after e or E")
    if id == DiagnosticId.LEX_008:
        return definition(id, 7, DiagnosticCategory.LEXICAL, "lexer.L008", "Invalid decimal literal", "the decimal literal has invalid digit separators", "place underscores only between digits")
    if id == DiagnosticId.LEX_009:
        return definition(id, 8, DiagnosticCategory.LEXICAL, "lexer.L009", "Invalid based literal", "the integer literal is invalid for its base", "use at least one valid digit and place underscores only between digits")
    if id == DiagnosticId.LEX_010:
        return definition(id, 9, DiagnosticCategory.LEXICAL, "lexer.L010", "Unexpected closing delimiter", "a closing delimiter has no matching opener", "remove it or add the matching opening delimiter")
    if id == DiagnosticId.LEX_011:
        return definition(id, 10, DiagnosticCategory.LEXICAL, "lexer.L011", "Mismatched delimiter", "expected {expected}, found {actual}", "close delimiters in the reverse order in which they were opened")

    if id == DiagnosticId.PARSE_002:
        return parser_definition(id, 2)
    if id == DiagnosticId.PARSE_003:
        return parser_definition(id, 3)
    if id == DiagnosticId.PARSE_005:
        return parser_definition(id, 5)
    if id == DiagnosticId.PARSE_006:
        return parser_definition(id, 6)
    if id == DiagnosticId.PARSE_007:
        return parser_definition(id, 7)
    if id == DiagnosticId.PARSE_008:
        return parser_definition(id, 8)
    if id == DiagnosticId.PARSE_009:
        return parser_definition(id, 9)
    if id == DiagnosticId.PARSE_010:
        return parser_definition(id, 10)
    if id == DiagnosticId.PARSE_011:
        return parser_definition(id, 11)
    if id == DiagnosticId.PARSE_012:
        return parser_definition(id, 12)
    if id == DiagnosticId.PARSE_013:
        return parser_definition(id, 13)
    if id == DiagnosticId.PARSE_014:
        return parser_definition(id, 14)
    if id == DiagnosticId.PARSE_015:
        return parser_definition(id, 15)
    if id == DiagnosticId.PARSE_017:
        return parser_definition(id, 17)
    if id == DiagnosticId.PARSE_018:
        return parser_definition(id, 18)
    if id == DiagnosticId.PARSE_019:
        return parser_definition(id, 19)
    if id == DiagnosticId.PARSE_020:
        return parser_definition(id, 20)
    if id == DiagnosticId.PARSE_021:
