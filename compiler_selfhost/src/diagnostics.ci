        return checker_definition(id, 18, DiagnosticCategory.CONCURRENCY, "non-constant-atomic-global", "Non-constant atomic global", "an atomic global initializer must be a compile-time scalar constant", "use a scalar literal or another compile-time scalar constant")
    if id == DiagnosticId.CHECK_024:
        return checker_definition(id, 24, DiagnosticCategory.TYPE_SYSTEM, "string-condition", "String used as condition", "a String value cannot be used as a condition", "compare the string explicitly or use a bool expression")
    if id == DiagnosticId.CHECK_042:
        return checker_definition(id, 42, DiagnosticCategory.TYPE_SYSTEM, "missing-return-value", "Missing return value", "this function must return a value of type {expected}", "return a value compatible with the declared return type")
    if id == DiagnosticId.CHECK_048:
        return checker_definition(id, 48, DiagnosticCategory.NAME_RESOLUTION, "unresolved-name-or-member", "Unresolved name", "cannot resolve {name}", "check the spelling, scope, and imported module members")
    if id == DiagnosticId.CHECK_076:
        return checker_definition(id, 76, DiagnosticCategory.SEMANTIC, "positional-after-named", "Positional argument after named argument", "a positional argument cannot follow a named argument", "move positional arguments before named arguments")
    if id == DiagnosticId.CHECK_077:
        return checker_definition(id, 77, DiagnosticCategory.TYPE_SYSTEM, "too-many-arguments", "Too many arguments", "expected {expected} arguments, found {actual}", "remove the extra arguments")
    if id == DiagnosticId.CHECK_078:
        return checker_definition(id, 78, DiagnosticCategory.TYPE_SYSTEM, "too-few-arguments", "Too few arguments", "expected {expected} arguments, found {actual}", "supply the missing arguments")
    if id == DiagnosticId.CHECK_107:
        return checker_definition(id, 107, DiagnosticCategory.TYPE_SYSTEM, "type-mismatch", "Type mismatch", "expected {expected}, found {actual}", "change the value or its declared type")
    if id == DiagnosticId.CHECK_121:
        return checker_definition(id, 121, DiagnosticCategory.SEMANTIC, "non-final-wildcard-case", "Wildcard case is not last", "a wildcard match case must be the final case", "move the wildcard case to the end")
    if id == DiagnosticId.CHECK_179:
        return checker_definition(id, 179, DiagnosticCategory.TYPE_SYSTEM, "override-mismatch", "Override does not match", "implementation of {name} does not match the base declaration", "match the base method parameters and return type")
    if id == DiagnosticId.CHECK_214:
        return checker_definition(id, 214, DiagnosticCategory.SEMANTIC, "static-assertion-failed", "Static assertion failed", "the compile-time assertion evaluates to false", "")
    if id == DiagnosticId.CHECK_254:
        return checker_definition(id, 254, DiagnosticCategory.OWNERSHIP, "invalid-partial-move", "Invalid move", "cannot perform {transfer} from owner {owner}", "borrow the value, clone it when supported, or move the complete owner")
    if id == DiagnosticId.CHECK_297:
        return checker_definition(id, 297, DiagnosticCategory.TYPE_SYSTEM, "unhashable-map-key", "Map key is not hashable", "Map key type {actual} is not hashable", "use a scalar, String, enum, pointer, or another supported hashable type")
    if id == DiagnosticId.CHECK_300:
        return checker_definition(id, 300, DiagnosticCategory.TYPE_SYSTEM, "unhashable-set-element", "Set element is not hashable", "Set element type {actual} is not hashable", "use a scalar, String, enum, pointer, or another supported hashable type")
    if id == DiagnosticId.CHECK_316:
        return checker_definition(id, 316, DiagnosticCategory.SEMANTIC, "or-pattern-binding-mismatch", "Inconsistent or-pattern bindings", "every alternative in an or-pattern must bind the same names", "make each alternative bind the same set of names")
    if id == DiagnosticId.CHECK_351:
        return checker_definition(id, 351, DiagnosticCategory.GENERICS, "unspecialized-atomic", "Atomic type is not specialized", "Atomic must be written with one supported scalar type argument", "use Atomic[bool], Atomic[u32], Atomic[u64], or Atomic[usize]")
    if id == DiagnosticId.CHECK_352:
        return checker_definition(id, 352, DiagnosticCategory.GENERICS, "generic-arity-mismatch", "Wrong number of type arguments", "expected {expected} type arguments, found {actual}", "supply the declared number of type arguments")
    if id == DiagnosticId.CHECK_354:
        return checker_definition(id, 354, DiagnosticCategory.GENERICS, "specialization-arity-mismatch", "Wrong specialization arity", "the explicit specialization has the wrong number of type arguments", "supply one type argument for each declared type parameter")
    if id == DiagnosticId.CHECK_355:
        return checker_definition(id, 355, DiagnosticCategory.GENERICS, "cannot-infer-type-argument", "Cannot infer type argument", "a generic type argument cannot be inferred from this call", "provide explicit type arguments")
    if id == DiagnosticId.CHECK_359:
        return checker_definition(id, 359, DiagnosticCategory.GENERICS, "generic-call-requires-specialization", "Generic call is not specialized", "this generic call requires explicit or inferable type arguments", "provide explicit type arguments")
    if id == DiagnosticId.CHECK_378:
        return checker_definition(id, 378, DiagnosticCategory.TYPE_SYSTEM, "closure-constructor-arity", "Invalid closure constructor", "closure construction requires an environment and an adapter function", "pass exactly two positional arguments")
    if id == DiagnosticId.CHECK_379:
        return checker_definition(id, 379, DiagnosticCategory.TYPE_SYSTEM, "named-closure-constructor-argument", "Named closure argument", "closure constructor arguments must be positional", "remove the argument names")
    if id == DiagnosticId.CHECK_380:
        return checker_definition(id, 380, DiagnosticCategory.TYPE_SYSTEM, "closure-environment-not-struct", "Invalid closure environment", "the closure environment must be a struct value", "place captured values in a struct")
    if id == DiagnosticId.CHECK_381:
        return checker_definition(id, 381, DiagnosticCategory.TYPE_SYSTEM, "closure-environment-ownership", "Invalid closure environment ownership", "the closure environment has unsupported ownership", "use an owned struct environment")
    if id == DiagnosticId.CHECK_382:
        return checker_definition(id, 382, DiagnosticCategory.TYPE_SYSTEM, "closure-adapter-signature", "Invalid closure adapter signature", "the closure adapter signature is incompatible with the closure", "make the adapter accept the environment and declared closure arguments")
    if id == DiagnosticId.CHECK_383:
        return checker_definition(id, 383, DiagnosticCategory.NAME_RESOLUTION, "invalid-closure-adapter", "Invalid closure adapter", "the closure adapter must name a function", "pass the name of a compatible function")
    if id == DiagnosticId.CHECK_384:
        return checker_definition(id, 384, DiagnosticCategory.TYPE_SYSTEM, "closure-adapter-missing-environment", "Closure adapter has no environment parameter", "the closure adapter must accept its environment as the first parameter", "add an environment reference parameter")
    if id == DiagnosticId.CHECK_385:
        return checker_definition(id, 385, DiagnosticCategory.TYPE_SYSTEM, "closure-adapter-environment-reference", "Closure environment is not passed by reference", "the first closure adapter parameter must be a reference", "change the first adapter parameter to a reference type")
    if id == DiagnosticId.CHECK_394:
        return checker_definition(id, 394, DiagnosticCategory.CONCURRENCY, "unsupported-atomic-element", "Unsupported atomic element type", "Atomic does not support element type {actual}", "use bool, u32, u64, or usize")
    if id == DiagnosticId.CHECK_395:
        return checker_definition(id, 395, DiagnosticCategory.OWNERSHIP, "immobile-atomic-storage", "Atomic storage cannot move", "owner {owner} has type {actual} with immobile atomic storage during {transfer}", "store Atomic directly and access it by address")
    if id == DiagnosticId.CHECK_396:
        return checker_definition(id, 396, DiagnosticCategory.CONCURRENCY, "atomic-in-callable-signature", "Atomic storage in callable signature", "callable parameters and returns cannot contain atomic storage", "pass a reference to the owning object instead")
    if id == DiagnosticId.CHECK_397:
        return checker_definition(id, 397, DiagnosticCategory.CONCURRENCY, "atomic-missing-initializer", "Atomic declaration needs an initializer", "an Atomic declaration must have a scalar initializer", "initialize the Atomic where it is declared")
    if id == DiagnosticId.CHECK_398:
        return checker_definition(id, 398, DiagnosticCategory.CONCURRENCY, "invalid-atomic-declaration", "Invalid atomic declaration", "Atomic storage must be declared directly and cannot be const", "declare a mutable value whose declared type is Atomic[T]")
    if id == DiagnosticId.CHECK_399:
        return checker_definition(id, 399, DiagnosticCategory.OWNERSHIP, "atomic-value-move", "Atomic value cannot move", "cannot perform {transfer} on Atomic owner {owner}", "operate through Atomic methods on an addressable receiver")
    if id == DiagnosticId.CHECK_400:
        return checker_definition(id, 400, DiagnosticCategory.TYPE_SYSTEM, "atomic-used-as-value", "Atomic used as a scalar value", "Atomic value {actual} is not valid in this scalar context", "use load(), store(), exchange(), compare_exchange(), or a supported fetch operation")
    if id == DiagnosticId.CHECK_401:
        return checker_definition(id, 401, DiagnosticCategory.CONCURRENCY, "assignment-to-atomic", "Direct assignment to Atomic", "Atomic storage cannot be assigned directly", "use store() to update an Atomic value")
    if id == DiagnosticId.CHECK_402:
        return checker_definition(id, 402, DiagnosticCategory.CONCURRENCY, "unknown-atomic-member", "Unknown Atomic operation", "Atomic has no supported operation named {name}", "use load, store, exchange, compare_exchange, or a supported fetch operation")
    if id == DiagnosticId.CHECK_403:
        return checker_definition(id, 403, DiagnosticCategory.CONCURRENCY, "invalid-atomic-operation", "Invalid Atomic operation", "the Atomic operation is not valid for this receiver or argument list", "use an addressable receiver and the operation's required positional or named arguments")
    if id == DiagnosticId.CHECK_405:
        return checker_definition(id, 405, DiagnosticCategory.TYPE_SYSTEM, "sorted-argument-count", "Invalid sorted call", "sorted expects one positional argument", "pass exactly one collection")
    if id == DiagnosticId.CHECK_406:
        return checker_definition(id, 406, DiagnosticCategory.TYPE_SYSTEM, "sorted-argument-not-sequence", "Value is not sortable", "sorted expects a List, array, or slice", "pass a supported sequence")
    if id == DiagnosticId.CHECK_407:
        return checker_definition(id, 407, DiagnosticCategory.TYPE_SYSTEM, "unsortable-element", "Element type is not sortable", "values of type {actual} cannot be sorted", "use a sequence with sortable elements")
    if id == DiagnosticId.CHECK_408:
        return checker_definition(id, 408, DiagnosticCategory.LOCK_ORDER, "unordered-lock-list", "Lock list has no canonical order", "this List[Lock] is not the result of sorted()", "sort the lock list before entering a dynamic critical section")
    if id == DiagnosticId.CHECK_409:
        return checker_definition(id, 409, DiagnosticCategory.LOCK_ORDER, "invalid-critical-section-target", "Invalid critical-section target", "CriticalSection expects a Lock or canonically ordered List[Lock]", "pass a static Lock or sorted lock list")
    if id == DiagnosticId.CHECK_419:
        return checker_definition(id, 419, DiagnosticCategory.LOCK_ORDER, "ordered-lock-list-mutation", "Ordered lock list cannot be mutated", "a canonically ordered lock list cannot be mutated except by sort", "create a new list or preserve canonical order")
    if id == DiagnosticId.CHECK_420:
        return checker_definition(id, 420, DiagnosticCategory.OWNERSHIP, "string-indexing", "String indexing is not supported", "owner {owner} cannot be used for {transfer}", "use byte_at() or an owned UTF-8 slice")
    if id == DiagnosticId.CHECK_421:
        return checker_definition(id, 421, DiagnosticCategory.OWNERSHIP, "temporary-reference-escape", "Reference to temporary escapes", "owner {owner} cannot be used for {transfer}", "bind the owner to a local before taking or returning a reference")

    if id == DiagnosticId.LOCK_404:
        return lock_definition(id, 404, "unresolved-reference", "Unresolved lock reference", "cannot resolve lock order reference {lock}", "import or declare the referenced lock")
    if id == DiagnosticId.LOCK_410:
        return lock_definition(id, 410, "order-cycle", "Lock-order cycle", "lock order contains a cycle near {before} -> {after}", "remove or reverse an ordering edge so the graph is acyclic")
    if id == DiagnosticId.LOCK_411:
        return lock_definition(id, 411, "recursive-acquisition", "Lock is already held", "cannot acquire {lock} while it is already held", "avoid recursive acquisition or restructure the critical section")
    if id == DiagnosticId.LOCK_412:
        return lock_definition(id, 412, "order-inversion", "Lock-order inversion", "cannot acquire {lock} while {held} is held", "acquire locks in canonical order")
    if id == DiagnosticId.LOCK_413:
        return lock_definition(id, 413, "unknown-call-effect", "Unknown lock effect", "cannot call a function with an unknown lock effect while a lock is held", "move the call outside the critical section or make its lock effect resolvable")
    if id == DiagnosticId.LOCK_414:
        return lock_definition(id, 414, "static-from-dynamic-effect", "Static lock under dynamic lock set", "cannot acquire another lock while a dynamic lock set is held", "finish the dynamic critical section before acquiring another lock")
    if id == DiagnosticId.LOCK_415:
        return lock_definition(id, 415, "static-under-dynamic", "Static lock under dynamic lock set", "cannot acquire a static lock while a dynamic lock set is held", "acquire the static lock before the dynamic set or in a separate section")
    if id == DiagnosticId.LOCK_416:
        return lock_definition(id, 416, "dynamic-under-lock", "Dynamic lock set under held lock", "cannot acquire a dynamic lock while another lock is held", "enter the dynamic critical section before other lock acquisitions")

    return definition(id, -1, DiagnosticCategory.INTERNAL, "internal.unknown-diagnostic", "Unknown diagnostic", "an unregistered diagnostic was emitted", "")


def definition(
    id: DiagnosticId,
    code: i32,
    category: DiagnosticCategory,
    name: String,
    title: String,
    message_template: String,
    help: String,
) -> DiagnosticDefinition:
    return DiagnosticDefinition(
        id=id,
        code=code,
        category=category,
        name=name,
        title=title,
        message_template=message_template,
        note="",
        help=help,
    )


def parser_definition(id: DiagnosticId, code: i32) -> DiagnosticDefinition:
    return definition(
        id,
        code,
        DiagnosticCategory.SYNTAX,
        catalog_name("parser.P", code),
        "Invalid syntax",
        "expected {expected}, found {actual}",
        "check the surrounding declaration, delimiters, and indentation",
    )


def checker_definition(
    id: DiagnosticId,
    code: i32,
    category: DiagnosticCategory,
    suffix: String,
    title: String,
    message_template: String,
    help: String,
) -> DiagnosticDefinition:
    return definition(id, code, category, "checker." + suffix, title, message_template, help)


def lock_definition(
    id: DiagnosticId,
    code: i32,
    suffix: String,
    title: String,
    message_template: String,
    help: String,
) -> DiagnosticDefinition:
    return definition(id, code, DiagnosticCategory.LOCK_ORDER, "lock." + suffix, title, message_template, help)


def catalog_name(prefix: String, code: i32) -> String:
    builder = StringBuilder()
    builder.append(prefix)
    if code < 10:
        builder.append("00")
    elif code < 100:
        builder.append("0")
    builder.append(to_string(code))
    return builder.finish()


def category_name(category: DiagnosticCategory) -> String:
    if category == DiagnosticCategory.LEXICAL:
        return "lexical"
    if category == DiagnosticCategory.SYNTAX:
        return "syntax"
    if category == DiagnosticCategory.NAME_RESOLUTION:
        return "name resolution"
    if category == DiagnosticCategory.TYPE_SYSTEM:
        return "type"
    if category == DiagnosticCategory.OWNERSHIP:
        return "ownership"
    if category == DiagnosticCategory.IMPORT:
        return "import"
    if category == DiagnosticCategory.GENERICS:
        return "generics"
    if category == DiagnosticCategory.CONCURRENCY:
        return "concurrency"
    if category == DiagnosticCategory.LOCK_ORDER:
        return "lock order"
    if category == DiagnosticCategory.SEMANTIC:
        return "semantic"
    return "internal"


def catalog_is_valid() -> bool:
    names: List[String] = []
    category_codes: List[String] = []
    index: i32 = 0
    final_index = cast[i32](DiagnosticId.LOCK_416)
    while index <= final_index:
        id = cast[DiagnosticId](index)
        definition_value = diagnostic_definition(id)
        if (
            definition_value.code < 0
            or len(definition_value.name) == 0
            or len(definition_value.title) == 0
            or len(definition_value.message_template) == 0
            or not template_placeholders_are_valid(&definition_value.message_template)
        ):
            return false
        category_code = category_name(definition_value.category) + ":" + to_string(definition_value.code)
        if contains_catalog_value(&names, &definition_value.name) or contains_catalog_value(&category_codes, &category_code):
            return false
        names.append(definition_value.name[0:len(definition_value.name)])
        category_codes.append(category_code)
        index += 1
    return true


def contains_catalog_value(values: &const List[String], wanted: &const String) -> bool:
    for value in values:
        if value == wanted[0:len(wanted)]:
            return true
    return false


def template_placeholders_are_valid(template: &const String) -> bool:
    index: usize = 0
    while index < len(template):
        byte = template.byte_at(index)
        if byte == 123:
            if index + 1 < len(template) and template.byte_at(index + 1) == 123:
                index += 2
                continue
            close = index + 1
            while close < len(template) and template.byte_at(close) != 125:
                close += 1
            if close >= len(template) or close == index + 1:
                return false
            index = close + 1
            continue
        if byte == 125:
            if index + 1 < len(template) and template.byte_at(index + 1) == 125:
                index += 2
                continue
            return false
        index += 1
    return true


def interpolate_template(template: &const String, arguments: &const List[DiagnosticArgument]) -> String:
    builder = StringBuilder()
    literal_start: usize = 0
    index: usize = 0
    while index < len(template):
        byte = template.byte_at(index)
        if byte == 123:
            if index + 1 < len(template) and template.byte_at(index + 1) == 123:
                append_range(&builder, template, literal_start, index)
                builder.append("{")
                index += 2
                literal_start = index
                continue
            close = index + 1
            while close < len(template) and template.byte_at(close) != 125:
                close += 1
            if close < len(template):
                append_range(&builder, template, literal_start, index)
                name = template[index + 1:close]
                if not append_named_argument(&builder, arguments, &name):
                    builder.append("{")
                    builder.append(name)
                    builder.append("}")
                index = close + 1
                literal_start = index
                continue
        elif byte == 125 and index + 1 < len(template) and template.byte_at(index + 1) == 125:
            append_range(&builder, template, literal_start, index)
            builder.append("}")
            index += 2
            literal_start = index
            continue
        index += 1
    append_range(&builder, template, literal_start, len(template))
    return builder.finish()


def append_named_argument(
    builder: &StringBuilder,
    arguments: &const List[DiagnosticArgument],
    name: &const String,
) -> bool:
    index: usize = 0
    while index < len(arguments):
        argument: &const DiagnosticArgument = &arguments[index]
        if argument.name == name[0:len(name)]:
            append_argument_value(builder, argument)
            return true
        index += 1
    return false


def append_argument_value(builder: &StringBuilder, argument: &const DiagnosticArgument) -> void:
    if argument.kind == DiagnosticArgumentKind.TEXT or argument.kind == DiagnosticArgumentKind.TYPE or argument.kind == DiagnosticArgumentKind.TOKEN or argument.kind == DiagnosticArgumentKind.SYMBOL or argument.kind == DiagnosticArgumentKind.PATH:
        append_escaped_diagnostic_range(builder, &argument.text, 0, len(argument.text))
    elif argument.kind == DiagnosticArgumentKind.SIGNED_INTEGER or argument.kind == DiagnosticArgumentKind.COUNT:
        builder.append(to_string(argument.signed_value))
    elif argument.kind == DiagnosticArgumentKind.UNSIGNED_INTEGER:
        builder.append(to_string(argument.unsigned_value))
    elif argument.kind == DiagnosticArgumentKind.BOOLEAN:
        builder.append(to_string(argument.bool_value))
    else:
        value = to_string(argument.char_value)
        append_escaped_diagnostic_range(builder, &value, 0, len(value))


def render_diagnostic(diagnostic: &const Diagnostic, path: &const String, source: &const String) -> String:
    definition_value = diagnostic_definition(diagnostic.id)
    effective_path = path[0:len(path)]
    if len(diagnostic.primary.path) > 0:
        effective_path = diagnostic.primary.path[0:len(diagnostic.primary.path)]
    line = diagnostic.primary.line
    column = diagnostic.primary.column
    if line <= 0 or column <= 0:
        location = line_and_column(source, diagnostic.primary.start)
        line = location[0]
        column = location[1]

    builder = StringBuilder()
    if len(effective_path) > 0:
        builder.append(effective_path)
    else:
        builder.append("<source>")
    builder.append(":")
    builder.append(to_string(line))
    builder.append(":")
    builder.append(to_string(column))
    builder.append(": error[")
    category = category_name(definition_value.category)
    builder.append(category)
    builder.append(" ")
    builder.append(definition_value.name[0:len(definition_value.name)])
    builder.append("/")
    builder.append(to_string(definition_value.code))
    builder.append("]: ")
    builder.append(definition_value.title[0:len(definition_value.title)])
    builder.append("\n")
    message = interpolate_template(&definition_value.message_template, &diagnostic.arguments)
    builder.append("  ")
    builder.append(message)
    builder.append("\n")
    append_source_excerpt(&builder, source, &diagnostic.primary, line, "")

    related_index: usize = 0
    while related_index < len(diagnostic.related):
        related: &const RelatedSpan = &diagnostic.related[related_index]
        related_path = effective_path[0:len(effective_path)]
        if len(related.span.path) > 0:
            related_path = related.span.path[0:len(related.span.path)]
        related_line = related.span.line
        related_column = related.span.column
        if related_line <= 0 or related_column <= 0:
            related_location = line_and_column(source, related.span.start)
            related_line = related_location[0]
            related_column = related_location[1]
        builder.append("  = related: ")
        builder.append(related.label[0:len(related.label)])
        builder.append(" at ")
        if len(related_path) > 0:
            builder.append(related_path)
        else:
            builder.append("<source>")
        builder.append(":")
        builder.append(to_string(related_line))
        builder.append(":")
        builder.append(to_string(related_column))
        builder.append("\n")
        if related_path == effective_path:
            append_source_excerpt(&builder, source, &related.span, related_line, related.label[0:len(related.label)])
        related_index += 1

    if len(definition_value.note) > 0:
        builder.append("  = note: ")
        builder.append(definition_value.note[0:len(definition_value.note)])
        builder.append("\n")
    for note in diagnostic.notes:
        builder.append("  = note: ")
        builder.append(note[0:len(note)])
        builder.append("\n")

    help = definition_value.help[0:len(definition_value.help)]
    if len(diagnostic.help) > 0:
        help = diagnostic.help[0:len(diagnostic.help)]
    if len(help) > 0:
        builder.append("  = help: ")
        builder.append(help)
        builder.append("\n")
    return builder.finish()


def write_diagnostic_stderr(diagnostic: &const Diagnostic, path: &const String, source: &const String) -> void:
    rendered = render_diagnostic(diagnostic, path, source)
    cinder.write_stderr(rendered)


def write_diagnostics_stderr(
    values: &const List[Diagnostic],
    path: &const String,
    source: &const String,
) -> void:
    for value in values:
        write_diagnostic_stderr(&value, path, source)


def append_source_excerpt(
    builder: &StringBuilder,
    source: &const String,
    span: &const SourceSpan,
    line: i32,
    label: String,
) -> void:
    if span.start > len(source):
        return
    line_start = span.start
    while line_start > 0:
        byte = source.byte_at(line_start - 1)
        if byte == 10 or byte == 13:
            break
        line_start -= 1
    line_end = span.start
    while line_end < len(source):
        byte = source.byte_at(line_end)
        if byte == 10 or byte == 13:
            break
        line_end += 1

    rendered_line = to_string(line)
    line_width = len(rendered_line)
    gutter_width: usize = 0
    while gutter_width < line_width:
        builder.append(" ")
        gutter_width += 1
    builder.append(" |\n")
    builder.append(rendered_line)
    builder.append(" | ")
    append_escaped_diagnostic_range(builder, source, line_start, line_end)
    builder.append("\n")
    gutter_width = 0
    while gutter_width < line_width:
        builder.append(" ")
        gutter_width += 1
    builder.append(" | ")
    source_display_column = cast[i32](line_width) + 3
    marker_column = display_column_at(source, line_start, span.start, source_display_column)
    marker_indent = marker_column - source_display_column
    while marker_indent > 0:
        builder.append(" ")
        marker_indent -= 1
    marker_count = span_display_width(source, span, line_end, marker_column)
    while marker_count > 0:
        builder.append("^")
        marker_count -= 1
    if len(label) > 0:
        builder.append(" ")
        builder.append(label)
    builder.append("\n")


def display_column_at(
    source: &const String,
    start: usize,
    target: usize,
    initial_column: i32,
) -> i32:
    end = target
    if end > len(source):
        end = len(source)
    escaped = StringBuilder()
    append_escaped_diagnostic_range(&escaped, source, start, end)
    rendered = escaped.finish()
    return cinder_unicode_display_column(
        rendered,
        len(rendered),
        0,
        len(rendered),
        initial_column,
    )


def span_display_width(
    source: &const String,
    span: &const SourceSpan,
    line_end: usize,
    start_column: i32,
) -> i32:
    end = span.start + span.length
    if end > line_end:
        end = line_end
    width = display_column_at(source, span.start, end, start_column) - start_column
    if width <= 0:
        return 1
    return width


def line_and_column(source: &const String, target: usize) -> Tuple[i32, i32]:
    end = target
    if end > len(source):
        end = len(source)
    line: i32 = 1
    column: i32 = 1
    index: usize = 0
    while index < end:
        byte = source.byte_at(index)
        if byte == 10:
            line += 1
            column = 1
        elif byte == 13:
            line += 1
            column = 1
            if index + 1 < end and source.byte_at(index + 1) == 10:
                index += 1
        elif byte < 128 or byte > 191:
            column += 1
        index += 1
    return (line, column)


def append_range(builder: &StringBuilder, value: &const String, start: usize, end: usize) -> void:
    if start >= end or start >= len(value):
        return
    bounded_end = end
    if bounded_end > len(value):
        bounded_end = len(value)
    builder.append(value[start:bounded_end])


def append_escaped_diagnostic_range(
    builder: &StringBuilder,
    value: &const String,
    start: usize,
    end: usize,
) -> void:
    if start >= end or start >= len(value):
        return
    bounded_end = end
    if bounded_end > len(value):
        bounded_end = len(value)
    literal_start = start
    index = start
    while index < bounded_end:
        byte = value.byte_at(index)
        if byte < 32 or byte == 127:
            append_range(builder, value, literal_start, index)
            append_escaped_diagnostic_byte(builder, byte)
            literal_start = index + 1
        index += 1
    append_range(builder, value, literal_start, bounded_end)


def append_escaped_diagnostic_byte(builder: &StringBuilder, value: u8) -> void:
    digits = "0123456789abcdef"
    builder.append("\\x")
    builder.append_char(cast[char](digits.byte_at(cast[usize](value / 16))))
    builder.append_char(cast[char](digits.byte_at(cast[usize](value % 16))))
