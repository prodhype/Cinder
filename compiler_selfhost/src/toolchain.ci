import process
import fs
import manifest


extern "C":
    def cinder_process_result_drop_raw(value: *void) -> void


struct ToolchainResult:
    ok: bool
    command: List[String]
    stdout: String
    stderr: String
    exit_code: i32


def compile_c11(
    compiler: String,
    generated_sources: &const List[String],
    runtime_root: String,
    output: String,
    build_dir: String,
    source_root: String,
    native: &const manifest.NativeConfig,
    cflags: &const List[String],
    ldflags: &const List[String],
) -> ToolchainResult:
    objects_name: String = "objects"
    object_dir = fs.join_path(&build_dir, &objects_name)
    if not fs.ensure_dir(&object_dir):
        failed_command: List[String] = []
        return ToolchainResult(ok=false, command=failed_command, stdout="", stderr="failed to create object directory: " + object_dir, exit_code=1)

    objects: List[String] = []
    index: usize = 0
    while index < len(generated_sources):
        object_name = "unit_" + decimal(index) + ".o"
        object_path = fs.join_path(&object_dir, &object_name)
        compile_command = compile_command_for(
            compiler[0:len(compiler)],
            generated_sources[index][0:len(generated_sources[index])],
            object_path[0:len(object_path)],
            runtime_root[0:len(runtime_root)],
            build_dir[0:len(build_dir)],
            source_root[0:len(source_root)],
            native,
            cflags,
        )
        result = process.run(compile_command)
        if result.exit_code != 0:
            result_stdout = result.stdout[0:len(result.stdout)]
            result_stderr = result.stderr[0:len(result.stderr)]
            cinder_process_result_drop_raw(&result)
            return ToolchainResult(
                ok=false,
                command=compile_command,
                stdout=result_stdout,
                stderr=result_stderr,
                exit_code=result.exit_code,
            )
        cinder_process_result_drop_raw(&result)
        objects.append(object_path[0:len(object_path)])
        index += 1

    runtime_c_name: String = "cinder_runtime.c"
    runtime_c = fs.join_path(&runtime_root, &runtime_c_name)
    runtime_object_name: String = "runtime.o"
    runtime_object = fs.join_path(&object_dir, &runtime_object_name)
    runtime_command = compile_command_for(
        compiler[0:len(compiler)],
        runtime_c[0:len(runtime_c)],
        runtime_object[0:len(runtime_object)],
        runtime_root[0:len(runtime_root)],
        build_dir[0:len(build_dir)],
        source_root[0:len(source_root)],
        native,
        cflags,
    )
    runtime_result = process.run(runtime_command)
    if runtime_result.exit_code != 0:
        runtime_stdout = runtime_result.stdout[0:len(runtime_result.stdout)]
        runtime_stderr = runtime_result.stderr[0:len(runtime_result.stderr)]
        cinder_process_result_drop_raw(&runtime_result)
        return ToolchainResult(
            ok=false,
            command=runtime_command,
            stdout=runtime_stdout,
            stderr=runtime_stderr,
            exit_code=runtime_result.exit_code,
        )
    cinder_process_result_drop_raw(&runtime_result)
    objects.append(runtime_object[0:len(runtime_object)])

    link_command = link_command_for(
        compiler[0:len(compiler)],
        &objects,
        output[0:len(output)],
        runtime_root[0:len(runtime_root)],
        build_dir[0:len(build_dir)],
        source_root[0:len(source_root)],
        native,
        cflags,
        ldflags,
    )
    link_result = process.run(link_command)
    link_stdout = link_result.stdout[0:len(link_result.stdout)]
    link_stderr = link_result.stderr[0:len(link_result.stderr)]
    cinder_process_result_drop_raw(&link_result)
    return ToolchainResult(
        ok=link_result.exit_code == 0,
        command=link_command,
        stdout=link_stdout,
        stderr=link_stderr,
        exit_code=link_result.exit_code,
    )


def compile_command_for(
    compiler: String,
    source: String,
    object: String,
    runtime_root: String,
    build_dir: String,
    source_root: String,
    native: &const manifest.NativeConfig,
    cflags: &const List[String],
) -> List[String]:
    command: List[String] = []
    append_compiler(&command, &compiler)
    append_common_flags(command, &runtime_root, &build_dir, &source_root, native, cflags)
    command.append("-c")
    command.append(source[0:len(source)])
    command.append("-o")
    command.append(object[0:len(object)])
    return command


def link_command_for(
    compiler: String,
    objects: &const List[String],
    output: String,
    runtime_root: String,
    build_dir: String,
    source_root: String,
    native: &const manifest.NativeConfig,
    cflags: &const List[String],
    ldflags: &const List[String],
) -> List[String]:
    command: List[String] = []
    append_compiler(&command, &compiler)
    append_common_flags(command, &runtime_root, &build_dir, &source_root, native, cflags)
    index: usize = 0
    while index < len(objects):
        command.append(objects[index][0:len(objects[index])])
        index += 1
    command.append("-o")
    command.append(output[0:len(output)])
    index = 0
    while index < len(native.link_files):
        command.append(native.link_files[index][0:len(native.link_files[index])])
        index += 1
    index = 0
    while index < len(native.library_dirs):
        command.append("-L" + native.library_dirs[index])
        index += 1
    index = 0
    while index < len(native.libraries):
        command.append("-l" + native.libraries[index])
        index += 1
    index = 0
    while index < len(native.ldflags):
        command.append(native.ldflags[index][0:len(native.ldflags[index])])
        index += 1
    index = 0
    while index < len(ldflags):
        command.append(ldflags[index][0:len(ldflags[index])])
        index += 1
    command.append("-lm")
    return command


def append_compiler(command: &List[String], compiler: &const String) -> void:
    if len(compiler) == 0:
        command.append("cc")
    else:
        command.append(compiler[0:len(compiler)])


def append_common_flags(
    command: &List[String],
    runtime_root: &const String,
    build_dir: &const String,
    source_root: &const String,
    native: &const manifest.NativeConfig,
    cflags: &const List[String],
) -> void:
    command.append("-std=c11")
    command.append("-Wall")
    command.append("-Wextra")
    command.append("-Wpedantic")
    command.append("-O2")
    command.append("-I" + runtime_root)
    command.append("-I" + build_dir)
    command.append("-I" + source_root)
    index: usize = 0
    while index < len(native.include_dirs):
        command.append("-I" + native.include_dirs[index])
        index += 1
    index = 0
    while index < len(native.cflags):
        command.append(native.cflags[index][0:len(native.cflags[index])])
        index += 1
    index = 0
    while index < len(cflags):
        command.append(cflags[index][0:len(cflags[index])])
        index += 1


def decimal(value: usize) -> String:
    if value == 0:
        return "0"
    divisor: usize = 1
    remaining = value
    while remaining >= 10:
        remaining = remaining / 10
        divisor = divisor * 10
    builder = StringBuilder()
    current = value
    while divisor > 0:
        digit = current / divisor
        builder.append_char(cast[char](48 + digit))
        current = current - digit * divisor
        divisor = divisor / 10
    return builder.finish()


def runtime_root(executable_path: &const String) -> String:
    runtime: String = "runtime"
    if has_runtime(&runtime):
        return runtime[0:len(runtime)]

    binary_dir = fs.parent_dir(executable_path)
    candidate = fs.join_path(&binary_dir, &runtime)
    if has_runtime(&candidate):
        return candidate[0:len(candidate)]

    parent = fs.parent_dir(&binary_dir)
    candidate = fs.join_path(&parent, &runtime)
    if has_runtime(&candidate):
        return candidate[0:len(candidate)]

    grandparent = fs.parent_dir(&parent)
    candidate = fs.join_path(&grandparent, &runtime)
    if has_runtime(&candidate):
        return candidate[0:len(candidate)]

    great_grandparent = fs.parent_dir(&grandparent)
    candidate = fs.join_path(&great_grandparent, &runtime)
    if has_runtime(&candidate):
        return candidate[0:len(candidate)]

    return runtime[0:len(runtime)]


def has_runtime(root: &const String) -> bool:
    runtime_c_name: String = "cinder_runtime.c"
    runtime_h_name: String = "cinder_runtime.h"
    runtime_c = fs.join_path(root, &runtime_c_name)
    runtime_h = fs.join_path(root, &runtime_h_name)
    return fs.file_exists(&runtime_c) and fs.file_exists(&runtime_h)
