import codegen_context
import codegen_context as codegen_model
import classes
import codegen_names
import codegen_reflection
import codegen_specializations
import codegen_type_names
import project
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_dyn_conversion(
    arena: &const SyntaxArena,
    id: NodeId,
    interface_index: i32,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    existing_interface = codegen_context.context_expression_dyn_interface(arena, context, id, source)
    if existing_interface >= 0:
        emit_nested(state, id)
        return
    concrete_index = codegen_context.context_expression_class(arena, context, id, source)
    if concrete_index < 0 or interface_index < 0:
        emit_nested(state, id)
        return
    concrete: &const classes.ClassInfo = &model.classes[cast[usize](concrete_index)]
    interface: &const classes.ClassInfo = &model.classes[cast[usize](interface_index)]
    builder.append("((CinderDyn_")
    builder.append(interface.c_name[0:len(interface.c_name)])
    builder.append("){ .object = (void *)(")
    if not codegen_context.context_expression_is_pointer_like(arena, context, id, source):
        builder.append("&")
    emit_nested(state, id)
    builder.append("), .vtable = &")
    builder.append(concrete.c_name[0:len(concrete.c_name)])
    builder.append("__as__")
    builder.append(interface.c_name[0:len(interface.c_name)])
    builder.append("__vtable })")


def emit_array_as_list(
    arena: &const SyntaxArena,
    id: NodeId,
    type_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    builder.append("(CinderList){ .data = (void *)")
    emit_nested(state, id)
    builder.append(", .length = ")
    length = codegen_specializations.array_length_node(context.type_arena, type_id)
    codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
    builder.append(", .capacity = 0 }")

def emit_imported_nominal_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    module_name: &const String,
    name: &const String,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    class_index = classes.find_class(model, module_name, name)
    if class_index >= 0:
        emit_imported_class_constructor_call(arena, id, source, builder, context, class_index, state, emit_nested)
        return
    builder.append("(")
    builder.append(codegen_names.c_prefix(project_name, module_name))
    builder.append(name[0:len(name)])
    builder.append("){")
    node = arena.nodes[id.index]
    emitted = false
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted:
                builder.append(", ")
            named = codegen_names.first_child(arena, child_id)
            if child.flags == 1 and named.index >= 0:
                named_node = arena.nodes[named.index]
                builder.append(".")
                codegen_names.append_source(builder, source, named_node.value_start, named_node.value_length)
                builder.append(" = ")
            value = codegen_names.last_child(arena, child_id)
            emit_nested(state, value)
            codegen_context.mark_context_expression_moved(arena, context, value, source)
            emitted = true
    builder.append("}")


def emit_imported_class_constructor_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    class_index: i32,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append("__new(")
    node = arena.nodes[id.index]
    emitted = false
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != SyntaxKind.EXPR_ARGUMENT:
            continue
        if emitted:
            builder.append(", ")
        argument = codegen_names.last_child(arena, child_id)
        emit_nested(state, argument)
        codegen_context.mark_context_expression_moved(arena, context, argument, source)
        emitted = true
    builder.append(")")

def emit_access_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    path = codegen_names.first_call_argument(arena, id)
    mode = codegen_names.second_call_argument(arena, id)
    builder.append("access(")
    emit_c_string_argument(arena, path, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(", ")
    emit_nested(state, mode)
    builder.append(")")

def emit_open_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    path = codegen_names.first_call_argument(arena, id)
    mode = codegen_names.second_call_argument(arena, id)
    if path.index >= 0:
        path_node = arena.nodes[path.index]
        if path_node.kind == SyntaxKind.EXPR_LITERAL and path_node.flags == cast[i32](token.TokenKind.STRING):
            builder.append("fopen(")
            codegen_names.append_source(builder, source, path_node.value_start, path_node.value_length)
            builder.append(", ")
            emit_c_string_argument(arena, mode, source, builder, prefix, project_name, imports, context, state, emit_nested)
            builder.append(")")
            return
    builder.append("fopen(")
    emit_c_string_argument(arena, path, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(", ")
    emit_c_string_argument(arena, mode, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(")")

def emit_attribute_call(
    arena: &const SyntaxArena,
    call_id: NodeId,
    callee_id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    receiver = codegen_names.first_child(arena, callee_id)
    member = codegen_names.second_child(arena, callee_id)
    if member.index < 0:
        emit_nested(state, callee_id)
        return
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    if emit_super_call(arena, call_id, receiver, &member_name, source, builder, prefix, project_name, imports, context, state, emit_nested):
        return
    if receiver.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME:
            receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = codegen_names.find_import_alias(imports, &receiver_name)
            if len(imported.module_name) > 0:
                if codegen_names.is_uppercase_start(source, member_node.value_start):
                    emit_imported_nominal_constructor(arena, call_id, source, builder, prefix, project_name, imports, &imported.module_name, &member_name, context, state, emit_nested)
                    return
                if imported.virtual_builtin and imported.module_name == "process" and member_name == "run":
                    builder.append("({ __auto_type cinder_process_args = &(")
                    emit_nested(state, codegen_names.first_call_argument(arena, call_id))
                    builder.append("); cinder_selfhost_process_run_list(cinder_process_args->data, cinder_process_args->length); })")
                    return
                if imported.virtual_builtin and imported.module_name == "cinder" and (member_name == "write_stdout" or member_name == "write_stderr"):
                    if member_name == "write_stdout":
                        builder.append("cinder_write_stdout")
                    else:
                        builder.append("cinder_write_stderr")
                    builder.append("(&")
                    emit_nested(state, codegen_names.first_call_argument(arena, call_id))
                    builder.append(")")
                    return
                if imported.virtual_builtin:
                    codegen_names.emit_builtin_function_name(builder, &imported.module_name, &member_name)
                    builder.append("(")
                    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, false, context, state, emit_nested)
                    builder.append(")")
                    return
                builder.append(codegen_names.c_prefix(project_name, &imported.module_name))
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                builder.append("(")
                if member_name == "dump_summary":
                    emit_nested(state, codegen_names.first_call_argument(arena, call_id))
                else:
                    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, false, context, state, emit_nested)
                builder.append(")")
                return
            if not codegen_context.context_has_name(context, source, receiver_node.value_start, receiver_node.value_length):
                imported_member = codegen_names.find_import_member(imports, &receiver_name)
                if imported_member.virtual_builtin and imported_member.module_name == "std.path" and imported_member.member == "Path":
                    emit_path_namespace_call(arena, call_id, &member_name, source, builder, prefix, project_name, imports, context, state, emit_nested)
                    return
    dyn_interface = codegen_context.context_expression_dyn_interface(arena, context, receiver, source)
    if dyn_interface >= 0:
        emit_dynamic_method_call(arena, call_id, receiver, &member_name, dyn_interface, source, builder, context, state, emit_nested)
        return
    if member_name == "dump" and receiver.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, receiver_node.value_start, receiver_node.value_length, "scan"):
            lexer_module = "lexer"
            builder.append(codegen_names.c_prefix(project_name, &lexer_module))
            builder.append("Lexer_dump(")
            emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
            emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context, state, emit_nested)
            builder.append(")")
            return
    if member_name == "get" and codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP):
        receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
        codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
        builder.append("_get(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_nested(state, receiver)
        builder.append(", ")
        argument = codegen_names.first_call_argument(arena, call_id)
        previous_expected = context.expected_type
        key_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 0)
        if key_type.index >= 0:
            context.expected_type = key_type
        emit_nested(state, argument)
        context.expected_type = previous_expected
        builder.append(")")
        return
    if (member_name == "keys" or member_name == "values" or member_name == "items") and codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP):
        codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
        builder.append("_")
        builder.append(member_name[0:len(member_name)])
        builder.append("(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_nested(state, receiver)
        builder.append(")")
        return
    if member_name == "add" and codegen_context.context_expression_is_collection(arena, context, receiver, source, "Set", types.TypeKind.SET):
        receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
        name_builder = StringBuilder()
        codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, &name_builder, prefix, project_name, imports, "Set", types.TypeKind.SET)
        name = name_builder.finish()
        argument = codegen_names.first_call_argument(arena, call_id)
        element_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 0)
        element_is_string = codegen_context.context_type_is_string(context.type_arena, element_type, context.type_source)
        if not element_is_string:
            semantic_element_type = codegen_context.context_semantic_type(context, argument)
            element_is_string = codegen_context.context_semantic_type_is_kind(context, semantic_element_type, types.TypeKind.STRING)
        materialize_argument = false
        temporary_index: i32 = -1
        if element_is_string and argument.index >= 0 and not codegen_context.context_expression_is_pointer_like(arena, context, argument, source):
            argument_node = arena.nodes[argument.index]
            materialize_argument = (
                argument_node.kind != SyntaxKind.EXPR_NAME
                and argument_node.kind != SyntaxKind.EXPR_ATTRIBUTE
                and argument_node.kind != SyntaxKind.EXPR_INDEX
                and argument_node.kind != SyntaxKind.EXPR_LITERAL
            )
        if materialize_argument:
            temporary_index = context.temporary_index
            context.temporary_index += 1
            builder.append("({ CinderString cinder_set_item_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(" = ")
            previous_expected = context.expected_type
            if element_type.index >= 0:
                context.expected_type = element_type
            emit_nested(state, argument)
            context.expected_type = previous_expected
            builder.append("; bool cinder_set_result_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append(" = ")
        builder.append(name[0:len(name)])
        builder.append("_add(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_nested(state, receiver)
        builder.append(", ")
        if materialize_argument:
            builder.append("cinder_set_item_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
        else:
            previous_expected = context.expected_type
            if element_type.index >= 0:
                context.expected_type = element_type
            emit_nested(state, argument)
            context.expected_type = previous_expected
        if not element_is_string:
            codegen_context.mark_context_expression_moved(arena, context, argument, source)
        builder.append(")")
        if materialize_argument:
            builder.append("; cinder_string_drop(&cinder_set_item_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append("); cinder_set_result_")
            codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
            builder.append("; })")
        return
    if (member_name == "union" or member_name == "intersection" or member_name == "difference" or member_name == "symmetric_difference" or member_name == "update") and codegen_context.context_expression_is_collection(arena, context, receiver, source, "Set", types.TypeKind.SET):
        receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
        name_builder = StringBuilder()
        codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, &name_builder, prefix, project_name, imports, "Set", types.TypeKind.SET)
        name = name_builder.finish()
        argument = codegen_names.first_call_argument(arena, call_id)
        previous_expected = context.expected_type
        context.expected_type = receiver_type
        builder.append("({ ")
        builder.append(name[0:len(name)])
        builder.append(" cinder_argument = ")
        emit_nested(state, argument)
        context.expected_type = previous_expected
        builder.append("; ")
        if member_name == "update":
            builder.append(name[0:len(name)])
            builder.append("_update(")
            if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("&")
            emit_nested(state, receiver)
            builder.append(", &cinder_argument); ")
            if access_expression_creates_owned_set(arena, argument, source):
                builder.append(name[0:len(name)])
                builder.append("_drop(&cinder_argument); ")
            builder.append("(void)0; })")
            return
        builder.append(name[0:len(name)])
        builder.append(" cinder_receiver = ")
        emit_nested(state, receiver)
        builder.append("; ")
        builder.append(name[0:len(name)])
        builder.append(" cinder_result = ")
        builder.append(name[0:len(name)])
        builder.append("_")
        builder.append(member_name[0:len(member_name)])
        builder.append("(&cinder_receiver, &cinder_argument); ")
        if access_expression_creates_owned_set(arena, receiver, source):
            builder.append(name[0:len(name)])
            builder.append("_drop(&cinder_receiver); ")
        if access_expression_creates_owned_set(arena, argument, source):
            builder.append(name[0:len(name)])
            builder.append("_drop(&cinder_argument); ")
        builder.append("cinder_result; })")
        return
    receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
    is_string = codegen_context.context_type_is_string(context.type_arena, receiver_type, context.type_source) or codegen_context.context_semantic_type_is_kind(context, codegen_context.context_semantic_type(context, receiver), types.TypeKind.STRING)
    is_string_builder = codegen_context.context_type_is_string_builder(context.type_arena, receiver_type, context.type_source) or codegen_context.context_semantic_type_is_kind(context, codegen_context.context_semantic_type(context, receiver), types.TypeKind.STRING_BUILDER)
    if member_name == "clone" and is_string:
        builder.append("cinder_string_clone(")
        emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
        builder.append(")")
        return
    if member_name == "reserve" and (is_string or is_string_builder):
        if is_string_builder:
            builder.append("cinder_string_builder_reserve(")
        else:
            builder.append("cinder_string_reserve(")
        emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
        builder.append(", ")
        emit_nested(state, codegen_names.first_call_argument(arena, call_id))
        builder.append(")")
        return
    if member_name == "clear":
        is_map = codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP)
        is_set = codegen_context.context_expression_is_collection(arena, context, receiver, source, "Set", types.TypeKind.SET)
        is_list = codegen_context.context_type_is_list(context.type_arena, receiver_type, context.type_source)
        if is_string:
            builder.append("cinder_string_clear(")
        elif is_map:
            codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
            builder.append("_clear(")
        elif is_set:
            codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Set", types.TypeKind.SET)
            builder.append("_clear(")
        elif is_list:
            builder.append("cinder_selfhost_list_clear(")
        if is_string or is_map or is_set or is_list:
            if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("&")
            emit_nested(state, receiver)
            builder.append(")")
            return
    if member_name == "append":
        arg = codegen_names.first_call_argument(arena, call_id)
        if is_string_builder:
            emit_builder_append_call(arena, receiver, arg, source, builder, prefix, project_name, imports, context, state, emit_nested)
        elif is_string:
            emit_string_append_call(arena, receiver, arg, "cinder_string_append", source, builder, prefix, project_name, imports, context, state, emit_nested)
        else:
            builder.append("cinder_selfhost_list_append_value(")
            if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("&")
            emit_nested(state, receiver)
            builder.append(", (")
            previous_expected = context.expected_type
            receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
            element_type = codegen_context.context_list_element_type(context.type_arena, receiver_type, context.type_source)
            if element_type.index >= 0:
                context.expected_type = element_type
            emit_nested(state, arg)
            context.expected_type = previous_expected
            codegen_context.mark_context_expression_moved(arena, context, arg, source)
            builder.append("))")
        return
    if member_name == "append_char" and (is_string or is_string_builder):
        if is_string_builder:
            builder.append("cinder_string_builder_append_char(")
        else:
            builder.append("cinder_string_append_char(")
        emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
        builder.append(", ")
        emit_nested(state, codegen_names.first_call_argument(arena, call_id))
        builder.append(")")
        return
    if member_name == "pop" and not codegen_context.context_expression_is_collection(arena, context, receiver, source, "Set", types.TypeKind.SET):
        builder.append("({ __auto_type cinder_list = ")
        if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_nested(state, receiver)
        builder.append("; if (cinder_list->length == 0) cinder_panic(\"pop from empty list\"); cinder_list->data[--cinder_list->length]; })")
        return
    if member_name == "finish" and is_string_builder:
        builder.append("cinder_string_builder_finish(")
        emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
        builder.append(")")
        codegen_context.mark_context_expression_moved(arena, context, receiver, source)
        return
    if member_name == "byte_at":
        if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("cinder_string_byte_at(")
        else:
            builder.append("cinder_selfhost_string_byte_at_value(")
        emit_nested(state, receiver)
        builder.append(", ")
        emit_nested(state, codegen_names.first_call_argument(arena, call_id))
        builder.append(")")
        return
    if member_name == "read":
        emit_file_read_call(arena, receiver, codegen_names.first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context, state, emit_nested)
        return
    if member_name == "read_line":
        emit_file_read_line_call(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
        return
    if member_name == "read_text":
        builder.append("cinder_read_all_text(")
        emit_nested(state, receiver)
        builder.append(")")
        return
    if member_name == "read_all":
        builder.append("cinder_selfhost_file_read_all(")
        emit_nested(state, receiver)
        builder.append(")")
        return
    if member_name == "write" and receiver_is_file(arena, receiver, source, context):
        emit_file_write_call(arena, receiver, codegen_names.first_call_argument(arena, call_id), source, builder, prefix, project_name, imports, context, state, emit_nested)
        return
    receiver_class = codegen_context.context_expression_class(arena, context, receiver, source)
    if receiver_class >= 0:
        method_index = classes.find_effective_method(model, receiver_class, &member_name)
        if method_index >= 0:
            method: &const classes.ClassMethodInfo = &model.methods[cast[usize](method_index)]
            builder.append(method.c_name[0:len(method.c_name)])
            builder.append("(")
            if method.self_is_dyn:
                emit_dyn_conversion(arena, receiver, method.owner, source, builder, context, state, emit_nested)
            else:
                emit_static_class_receiver(arena, receiver, receiver_class, method.owner, source, builder, context, state, emit_nested)
            emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context, state, emit_nested)
            builder.append(")")
            return
    receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
    type_arena: &const SyntaxArena = context.type_arena
    if receiver_type.index >= 0 and type_arena.nodes[receiver_type.index].kind == SyntaxKind.TYPE_GENERIC:
        codegen_context.emit_context_c_type(type_arena, receiver_type, context.type_source, builder, prefix, project_name, imports, context)
        builder.append("_")
    codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
    builder.append("(")
    emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context, state, emit_nested)
    builder.append(")")


def emit_path_namespace_call(
    arena: &const SyntaxArena,
    call_id: NodeId,
    member_name: &const String,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    expected: i32 = 1
    if member_name == "join" or member_name == "with_suffix" or member_name == "rename":
        expected = 2
    first = path_call_argument(arena, call_id, source, member_name, 0)
    second = syntax.missing_node()
    if expected == 2:
        second = path_call_argument(arena, call_id, source, member_name, 1)
    materialize_first = path_argument_needs_materialization(arena, context, first, source)
    materialize_second = expected == 2 and path_argument_needs_materialization(arena, context, second, source)
    if not materialize_first and not materialize_second:
        emit_path_runtime_call(arena, member_name, first, second, false, false, -1, -1, source, builder, prefix, project_name, imports, context, state, emit_nested)
        return

    builder.append("({ ")
    first_temporary: i32 = -1
    second_temporary: i32 = -1
    if materialize_first:
        first_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        append_path_temporary_name(builder, "argument", first_temporary)
        builder.append(" = ")
        emit_nested(state, first)
        builder.append("; ")
    if materialize_second:
        second_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("CinderString ")
        append_path_temporary_name(builder, "argument", second_temporary)
        builder.append(" = ")
        emit_nested(state, second)
        builder.append("; ")

    returns_string = path_member_returns_string(member_name)
    returns_bool = member_name == "exists" or member_name == "is_file" or member_name == "is_dir"
    result_temporary: i32 = -1
    if returns_string or returns_bool:
        result_temporary = context.temporary_index
        context.temporary_index += 1
        if returns_string:
            builder.append("CinderString ")
        else:
            builder.append("bool ")
        append_path_temporary_name(builder, "result", result_temporary)
        builder.append(" = ")
    emit_path_runtime_call(arena, member_name, first, second, materialize_first, materialize_second, first_temporary, second_temporary, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append("; ")
    if materialize_second:
        builder.append("cinder_string_drop(&")
        append_path_temporary_name(builder, "argument", second_temporary)
        builder.append("); ")
    if materialize_first:
        builder.append("cinder_string_drop(&")
        append_path_temporary_name(builder, "argument", first_temporary)
        builder.append("); ")
    if returns_string or returns_bool:
        append_path_temporary_name(builder, "result", result_temporary)
        builder.append("; ")
    builder.append("})")


def emit_path_runtime_call(
    arena: &const SyntaxArena,
    member_name: &const String,
    first: NodeId,
    second: NodeId,
    materialized_first: bool,
    materialized_second: bool,
    first_temporary: i32,
    second_temporary: i32,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    builder.append("cinder_path_")
    builder.append(member_name[0:len(member_name)])
    builder.append("(")
    if materialized_first:
        builder.append("cinder_string_cstr(&")
        append_path_temporary_name(builder, "argument", first_temporary)
        builder.append(")")
    else:
        emit_c_string_argument(arena, first, source, builder, prefix, project_name, imports, context, state, emit_nested)
    if second.index >= 0:
        builder.append(", ")
        if materialized_second:
            builder.append("cinder_string_cstr(&")
            append_path_temporary_name(builder, "argument", second_temporary)
            builder.append(")")
        else:
            emit_c_string_argument(arena, second, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(")")


def path_argument_needs_materialization(
    arena: &const SyntaxArena,
    context: &codegen_model.ModuleCodegenContext,
    argument: NodeId,
    source: &const String,
) -> bool:
    if argument.index < 0 or codegen_context.context_expression_is_pointer_like(arena, context, argument, source):
        return false
    node = arena.nodes[argument.index]
    if node.kind == SyntaxKind.EXPR_LITERAL:
        return false
    return not codegen_context.context_expression_is_addressable_for_borrow(arena, context, argument, source)


def path_member_returns_string(member_name: &const String) -> bool:
    return member_name == "parent" or member_name == "name" or member_name == "stem" or member_name == "join" or member_name == "with_suffix"


def expression_is_owned_path_string(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0 or arena.nodes[callee.index].kind != SyntaxKind.EXPR_ATTRIBUTE:
        return false
    receiver = codegen_names.first_child(arena, callee)
    member = codegen_names.second_child(arena, callee)
    if receiver.index < 0 or member.index < 0 or arena.nodes[receiver.index].kind != SyntaxKind.EXPR_NAME:
        return false
    receiver_node = arena.nodes[receiver.index]
    if codegen_context.context_has_name(context, source, receiver_node.value_start, receiver_node.value_length):
        return false
    receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
    imported = codegen_names.find_import_member(imports, &receiver_name)
    if not imported.virtual_builtin or imported.module_name != "std.path" or imported.member != "Path":
        return false
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    return path_member_returns_string(&member_name)


def append_path_temporary_name(builder: &StringBuilder, role: String, index: i32) -> void:
    builder.append("cinder_path_")
    builder.append(role)
    builder.append("_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](index))


def path_call_argument(
    arena: &const SyntaxArena,
    call_id: NodeId,
    source: &const String,
    member_name: &const String,
    wanted: i32,
) -> NodeId:
    call = arena.nodes[call_id.index]
    source_index: i32 = 0
    for offset in range(0, call.child_count):
        argument_id = arena.children[call.first_child + offset]
        argument = arena.nodes[argument_id.index]
        if argument.kind != SyntaxKind.EXPR_ARGUMENT:
            continue
        role = source_index
        if argument.flags == 1:
            role = path_codegen_named_argument_index(arena, argument_id, source, member_name)
        if role == wanted:
            return codegen_names.last_child(arena, argument_id)
        source_index += 1
    return syntax.missing_node()


def path_codegen_named_argument_index(
    arena: &const SyntaxArena,
    argument_id: NodeId,
    source: &const String,
    member_name: &const String,
) -> i32:
    name = codegen_names.first_child(arena, argument_id)
    if name.index < 0:
        return -1
    name_node = arena.nodes[name.index]
    argument_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
    if member_name == "join":
        if argument_name == "left":
            return 0
        if argument_name == "right":
            return 1
        return -1
    if member_name == "rename":
        if argument_name == "source":
            return 0
        if argument_name == "destination":
            return 1
        return -1
    if member_name == "with_suffix":
        if argument_name == "path":
            return 0
        if argument_name == "suffix":
            return 1
        return -1
    if argument_name == "path":
        return 0
    return -1


def emit_dynamic_method_call(
    arena: &const SyntaxArena,
    call_id: NodeId,
    receiver: NodeId,
    member_name: &const String,
    interface_index: i32,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    interface: &const classes.ClassInfo = &model.classes[cast[usize](interface_index)]
    temporary_index = context.temporary_index
    context.temporary_index += 1
    builder.append("({ CinderDyn_")
    builder.append(interface.c_name[0:len(interface.c_name)])
    builder.append(" cinder_dyn_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(" = ")
    emit_nested(state, receiver)
    builder.append("; cinder_dyn_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".vtable->")
    builder.append(member_name[0:len(member_name)])
    builder.append("(cinder_dyn_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".object, cinder_dyn_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".vtable")
    emit_remaining_call_arguments(arena, call_id, source, builder, state.prefix, state.project_name, state.imports, true, context, state, emit_nested)
    builder.append("); })")


def emit_static_class_receiver(
    arena: &const SyntaxArena,
    receiver: NodeId,
    source_class: i32,
    target_class: i32,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    if source_class != target_class:
        target: &const classes.ClassInfo = &model.classes[cast[usize](target_class)]
        builder.append("((")
        builder.append(target.c_name[0:len(target.c_name)])
        builder.append(" *)")
    emit_receiver_argument(arena, receiver, source, builder, state.prefix, state.project_name, state.imports, context, state, emit_nested)
    if source_class != target_class:
        builder.append(")")


def emit_super_call(
    arena: &const SyntaxArena,
    call_id: NodeId,
    receiver: NodeId,
    member_name: &const String,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    model: &const classes.ProjectClassModel = context.class_model
    if not expression_is_super(arena, receiver, source) or context.current_class < 0:
        return false
    owner: &const classes.ClassInfo = &model.classes[cast[usize](context.current_class)]
    if owner.primary_base < 0:
        return false
    base: &const classes.ClassInfo = &model.classes[cast[usize](owner.primary_base)]
    if member_name == "__init__":
        if base.constructor < 0:
            builder.append("(*(( ")
            builder.append(base.c_name[0:len(base.c_name)])
            builder.append(" *)&self->_base) = ")
            builder.append(base.c_name[0:len(base.c_name)])
            builder.append("__new())")
            return true
        constructor: &const classes.ClassMethodInfo = &model.methods[cast[usize](base.constructor)]
        builder.append(constructor.c_name[0:len(constructor.c_name)])
    else:
        method_index = classes.find_effective_method(model, owner.primary_base, member_name)
        if method_index < 0:
            return false
        method: &const classes.ClassMethodInfo = &model.methods[cast[usize](method_index)]
        builder.append(method.c_name[0:len(method.c_name)])
    builder.append("(( ")
    builder.append(base.c_name[0:len(base.c_name)])
    builder.append(" *)&self->_base")
    emit_remaining_call_arguments(arena, call_id, source, builder, prefix, project_name, imports, true, context, state, emit_nested)
    builder.append(")")
    return true


def expression_is_super(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        return codegen_names.range_text_equals(source, node.value_start, node.value_length, "super")
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0:
        return false
    callee_node = arena.nodes[callee.index]
    return callee_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, callee_node.value_start, callee_node.value_length, "super")


def receiver_is_file(
    arena: &const SyntaxArena,
    receiver: NodeId,
    source: &const String,
    context: &codegen_context.ModuleCodegenContext,
) -> bool:
    type_arena: &const SyntaxArena = context.type_arena
    type_table: &const types.TypeTable = context.type_table
    receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
    if codegen_type_names.context_type_name_equals(type_arena, receiver_type, context.type_source, "File"):
        return true
    if receiver_type.index >= 0:
        receiver_type_node = type_arena.nodes[receiver_type.index]
        if receiver_type_node.kind == SyntaxKind.EXPR_CALL:
            callee = codegen_names.first_child(type_arena, receiver_type)
            if callee.index >= 0:
                callee_node = type_arena.nodes[callee.index]
                if callee_node.kind == SyntaxKind.EXPR_NAME:
                    if codegen_names.range_text_equals(context.type_source, callee_node.value_start, callee_node.value_length, "open"):
                        return true
                    if codegen_names.is_uppercase_start(context.type_source, callee_node.value_start):
                        return false
        elif receiver_type_node.kind == SyntaxKind.TYPE_NAME:
            return false
    semantic_type = codegen_context.context_semantic_type(context, receiver)
    if semantic_type.index >= 0 and semantic_type.index < cast[i32](len(type_table.types)):
        if codegen_type_names.semantic_type_is_kind(type_table, semantic_type, types.TypeKind.FILE):
            return true
        if types.is_nominal_kind(type_table.types[semantic_type.index].kind):
            return false
    return true


def access_expression_creates_owned_set(arena: &const SyntaxArena, id: NodeId, source: &const String) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_SET or node.kind == SyntaxKind.EXPR_BINARY:
        return true
    if node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, id)
    if callee.index < 0:
        return true
    callee_node = arena.nodes[callee.index]
    if callee_node.kind != SyntaxKind.EXPR_ATTRIBUTE:
        return true
    member = codegen_names.second_child(arena, callee)
    if member.index < 0:
        return true
    member_node = arena.nodes[member.index]
    return (
        codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "union")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "intersection")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "difference")
        or codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "symmetric_difference")
    )


def emit_builder_append_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    emit_string_append_call(arena, receiver, arg, "cinder_string_builder_append", source, builder, prefix, project_name, imports, context, state, emit_nested)


def emit_string_append_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    runtime: String,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg_node = arena.nodes[arg.index]
    addressable = arg_node.kind == SyntaxKind.EXPR_NAME or arg_node.kind == SyntaxKind.EXPR_ATTRIBUTE or arg_node.kind == SyntaxKind.EXPR_LITERAL or arg_node.kind == SyntaxKind.EXPR_INDEX
    if arg_node.kind == SyntaxKind.EXPR_INDEX and codegen_context.context_expression_is_collection(arena, context, codegen_names.first_child(arena, arg), source, "Map", types.TypeKind.MAP):
        addressable = false
    materialize = not codegen_context.context_expression_is_pointer_like(arena, context, arg, source) and not addressable
    if materialize:
        builder.append("({ CinderString cinder_string_argument = ")
        emit_nested(state, arg)
        builder.append("; ")
    builder.append(runtime[0:len(runtime)])
    builder.append("(")
    emit_receiver_argument(arena, receiver, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(", ")
    if materialize:
        builder.append("&cinder_string_argument")
    else:
        emit_receiver_argument(arena, arg, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(")")
    if materialize:
        builder.append("; cinder_string_drop(&cinder_string_argument); })")

def emit_file_write_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg_type = codegen_context.context_expression_type(arena, context, arg, source)
    if codegen_specializations.context_type_is_array(context.type_arena, arg_type):
        builder.append("fwrite((const void *)")
        emit_nested(state, arg)
        builder.append(", 1, ")
        length = codegen_specializations.array_length_node(context.type_arena, arg_type)
        codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
        builder.append(", ")
        emit_nested(state, receiver)
        builder.append(")")
        return
    if codegen_context.context_type_is_list(context.type_arena, arg_type, context.type_source):
        builder.append("fwrite(")
        emit_nested(state, arg)
        if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->data, 1, ")
        else:
            builder.append(".data, 1, ")
        emit_nested(state, arg)
        if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->length, ")
        else:
            builder.append(".length, ")
        emit_nested(state, receiver)
        builder.append(")")
        return
    builder.append("fwrite(cinder_string_cstr(")
    if not codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("&")
    emit_nested(state, arg)
    builder.append("), 1, ")
    emit_nested(state, arg)
    if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("->length, ")
    else:
        builder.append(".length, ")
    emit_nested(state, receiver)
    builder.append(")")

def emit_file_read_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg_type = codegen_context.context_expression_type(arena, context, arg, source)
    if arg.index >= 0 and arena.nodes[arg.index].kind == SyntaxKind.EXPR_SLICE:
        emit_file_read_slice_call(arena, receiver, arg, source, builder, prefix, project_name, imports, context, state, emit_nested)
        return
    builder.append("({ size_t cinder_read_length = ")
    if codegen_specializations.context_type_is_array(context.type_arena, arg_type):
        length = codegen_specializations.array_length_node(context.type_arena, arg_type)
        codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
    elif codegen_context.context_type_is_list(context.type_arena, arg_type, context.type_source) or codegen_type_names.type_node_kind(context.type_arena, arg_type) == SyntaxKind.EXPR_SLICE:
        emit_nested(state, arg)
        if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->length")
        else:
            builder.append(".length")
    else:
        builder.append("0")
    builder.append("; size_t cinder_read_count = fread(")
    if codegen_specializations.context_type_is_array(context.type_arena, arg_type):
        builder.append("(void *)")
        emit_nested(state, arg)
    elif codegen_context.context_type_is_list(context.type_arena, arg_type, context.type_source) or codegen_type_names.type_node_kind(context.type_arena, arg_type) == SyntaxKind.EXPR_SLICE:
        emit_nested(state, arg)
        if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("->data")
        else:
            builder.append(".data")
    else:
        builder.append("NULL")
    builder.append(", 1, cinder_read_length, ")
    emit_nested(state, receiver)
    builder.append("); if (cinder_read_count < cinder_read_length && ferror(")
    emit_nested(state, receiver)
    builder.append(")) cinder_panic(\"File.read failed\"); cinder_read_count; })")

def emit_file_read_slice_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    arg: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    temporary_index = context.temporary_index
    context.temporary_index += 1
    builder.append("({ __auto_type ")
    append_file_read_slice_name(builder, temporary_index)
    builder.append(" = ")
    emit_nested(state, arg)
    builder.append("; size_t cinder_read_length = ")
    append_file_read_slice_name(builder, temporary_index)
    builder.append(".length; size_t cinder_read_count = fread(")
    append_file_read_slice_name(builder, temporary_index)
    builder.append(".data, 1, cinder_read_length, ")
    emit_nested(state, receiver)
    builder.append("); if (cinder_read_count < cinder_read_length && ferror(")
    emit_nested(state, receiver)
    builder.append(")) cinder_panic(\"File.read failed\"); cinder_read_count; })")

def append_file_read_slice_name(builder: &StringBuilder, index: i32) -> void:
    builder.append("cinder_read_slice_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](index))

def emit_file_read_line_call(
    arena: &const SyntaxArena,
    receiver: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    builder.append("({ CinderOption_String cinder_line = { CinderOption_String_Tag_None, { 0 } }; CinderString cinder_text = {0}; if (cinder_read_line(")
    emit_nested(state, receiver)
    builder.append(", &cinder_text)) { cinder_line.tag = CinderOption_String_Tag_Some; cinder_line.data.value = cinder_text; } cinder_line; })")

def emit_module_index(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    receiver = codegen_names.first_child(arena, id)
    index = codegen_names.second_child(arena, id)
    receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
    table: &const types.TypeTable = context.type_table
    semantic_receiver_type = access_strip_semantic_indirection(table, codegen_context.context_semantic_type(context, receiver))
    receiver_node = arena.nodes[receiver.index]
    is_tuple_item_name = receiver_node.kind == SyntaxKind.EXPR_NAME and codegen_context.context_name_is_tuple_item(context, source, receiver_node.value_start, receiver_node.value_length)
    is_tuple = codegen_type_names.semantic_type_is_kind(table, semantic_receiver_type, types.TypeKind.TUPLE) or codegen_context.context_type_is_runtime_generic(context.type_arena, receiver_type, context.type_source, "Tuple") or is_tuple_item_name
    if is_tuple and index.index >= 0 and arena.nodes[index.index].kind == SyntaxKind.EXPR_LITERAL:
        emit_nested(state, receiver)
        builder.append(".item_")
        index_node = arena.nodes[index.index]
        codegen_names.append_numeric_literal(builder, source, index_node.value_start, index_node.value_length)
        return
    if codegen_specializations.context_type_is_array(context.type_arena, receiver_type):
        emit_nested(state, receiver)
        builder.append("[")
        emit_nested(state, index)
        builder.append("]")
        return
    if codegen_context.context_expression_is_collection(arena, context, receiver, source, "Map", types.TypeKind.MAP):
        previous_expected = context.expected_type
        key_type = codegen_context.context_generic_argument(context.type_arena, receiver_type, 0)
        index_owned_path = expression_is_owned_path_string(arena, index, source, imports, context)
        index_temporary: i32 = -1
        result_temporary: i32 = -1
        if index_owned_path:
            index_temporary = context.temporary_index
            context.temporary_index += 1
            result_temporary = context.temporary_index
            context.temporary_index += 1
            builder.append("(*({ CinderString ")
            append_path_temporary_name(builder, "index", index_temporary)
            builder.append(" = ")
            if key_type.index >= 0:
                context.expected_type = key_type
            emit_nested(state, index)
            context.expected_type = previous_expected
            builder.append("; __auto_type ")
            append_path_temporary_name(builder, "index_result", result_temporary)
            builder.append(" = ")
        else:
            builder.append("(*")
        codegen_context.emit_context_expression_specialization_name(arena, context, receiver, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
        builder.append("_at_ref(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("&")
        emit_nested(state, receiver)
        builder.append(", ")
        if index_owned_path:
            append_path_temporary_name(builder, "index", index_temporary)
        else:
            if key_type.index >= 0:
                context.expected_type = key_type
            emit_nested(state, index)
        context.expected_type = previous_expected
        builder.append(")")
        if index_owned_path:
            builder.append("; cinder_string_drop(&")
            append_path_temporary_name(builder, "index", index_temporary)
            builder.append("); ")
            append_path_temporary_name(builder, "index_result", result_temporary)
            builder.append("; }))")
        else:
            builder.append(")")
        return
    if emit_known_list_index(arena, receiver, index, source, builder, prefix, project_name, imports, context, state, emit_nested):
        return
    element_type = codegen_context.context_expression_list_element_type(arena, context, receiver, source)
    if element_type.index >= 0:
        receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
        semantic_element_type = codegen_context.context_semantic_type(context, id)
        builder.append("((")
        if codegen_context.context_semantic_type_is_kind(context, semantic_element_type, types.TypeKind.ATOMIC):
            codegen_type_names.emit_semantic_c_type(table, semantic_element_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        else:
            codegen_context.emit_context_c_type(arena, element_type, source, builder, prefix, project_name, imports, context)
        builder.append(" *)")
        emit_nested(state, receiver)
        if codegen_context.context_type_is_pointer_like(arena, receiver_type):
            builder.append("->data")
        else:
            builder.append(".data")
        builder.append(")")
    else:
        emit_nested(state, receiver)
    builder.append("[")
    emit_nested(state, index)
    builder.append("]")

def access_strip_semantic_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current


def emit_known_list_index(
    arena: &const SyntaxArena,
    receiver: NodeId,
    index: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    element = known_list_element_name(arena, receiver, source, context)
    if len(element) == 0:
        return false
    builder.append("(((")
    builder.append(element)
    builder.append(" *)")
    emit_nested(state, receiver)
    if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
        builder.append("->data)[")
    else:
        builder.append(".data)[")
    emit_nested(state, index)
    builder.append("])")
    return true

def known_list_element_name(arena: &const SyntaxArena, receiver: NodeId, source: &const String, context: &codegen_model.ModuleCodegenContext) -> String:
    if receiver.index < 0:
        return ""
    receiver_node = arena.nodes[receiver.index]
    if codegen_context.context_type_is_file_read_call(arena, receiver, source, "read_all"):
        return "uint8_t"
    if receiver_node.kind == SyntaxKind.EXPR_NAME:
        receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
        receiver_type = codegen_context.context_name_type(context, &receiver_name)
        if codegen_context.context_type_is_file_read_call(context.type_arena, receiver_type, context.type_source, "read_all"):
            return "uint8_t"
    if receiver_node.kind != SyntaxKind.EXPR_ATTRIBUTE:
        return ""
    object = codegen_names.first_child(arena, receiver)
    member = codegen_names.second_child(arena, receiver)
    if object.index < 0 or member.index < 0:
        return ""
    object_node = arena.nodes[object.index]
    member_node = arena.nodes[member.index]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    owner = ""
    if object_node.kind == SyntaxKind.EXPR_NAME:
        object_name = source[object_node.value_start:object_node.value_start + object_node.value_length]
        if object_name == "self":
            owner = context.current_owner[0:len(context.current_owner)]
        if object_name == "arena":
            owner = "SyntaxArena"
        if object_name == "scan":
            owner = "Lexer"
        if object_name == "parser" or object_name == "parsed":
            owner = "Parser"
        if object_name == "checker" or object_name == "check":
            owner = "Checker"
        if len(owner) == 0:
            owner = codegen_type_names.context_type_owner_name(arena, codegen_context.context_name_type(context, &object_name), source)
    if owner == "SyntaxArena" and member_name == "nodes":
        return "cinder_cinder_selfhost_syntax__SyntaxNode"
    if owner == "SyntaxArena" and member_name == "children":
        return "cinder_cinder_selfhost_syntax__NodeId"
    if owner == "IRModule" and member_name == "nodes":
        return "cinder_cinder_selfhost_backend_ir__IRNode"
    if owner == "IRModule" and member_name == "children":
        return "cinder_cinder_selfhost_backend_ir__IRNodeId"
    if owner == "TypeTable" and member_name == "types":
        return "cinder_cinder_selfhost_types__TypeRecord"
    if owner == "TypeTable" and member_name == "type_args":
        return "cinder_cinder_selfhost_types__TypeId"
    if member_name == "types":
        return "cinder_cinder_selfhost_types__TypeRecord"
    if owner == "ProjectClassModel" and member_name == "classes":
        return "cinder_cinder_selfhost_classes__ClassInfo"
    if owner == "ProjectClassModel" and member_name == "bases":
        return "cinder_cinder_selfhost_classes__ClassBaseInfo"
    if owner == "ProjectClassModel" and member_name == "fields":
        return "cinder_cinder_selfhost_classes__ClassFieldInfo"
    if owner == "ProjectClassModel" and member_name == "methods":
        return "cinder_cinder_selfhost_classes__ClassMethodInfo"
    if owner == "ProjectClassModel" and member_name == "parameters":
        return "cinder_cinder_selfhost_classes__ClassParameterInfo"
    if owner == "ProjectClassModel" and member_name == "functions":
        return "cinder_cinder_selfhost_classes__ClassFunctionInfo"
    if owner == "ProjectReflectionModel" and member_name == "nominals":
        return "cinder_cinder_selfhost_codegen_reflection__ReflectionNominalInfo"
    if owner == "ProjectReflectionModel" and member_name == "fields":
        return "cinder_cinder_selfhost_codegen_reflection__ReflectionFieldInfo"
    if owner == "ProjectReflectionModel" and member_name == "methods":
        return "cinder_cinder_selfhost_codegen_reflection__ReflectionMethodInfo"
    if owner == "ModuleCodegenContext" and member_name == "reflection_bindings":
        return "cinder_cinder_selfhost_codegen_context__ModuleReflectionBinding"
    if member_name == "type_args":
        return "cinder_cinder_selfhost_types__TypeId"
    if member_name == "canonical_bytes" or member_name == "readable_bytes":
        return "char"
    if member_name == "canonical_starts" or member_name == "readable_starts":
        return "size_t"
    if member_name == "local_types":
        return "cinder_cinder_selfhost_codegen_context__ModuleNameTypeBinding"
    if member_name == "field_types":
        return "cinder_cinder_selfhost_codegen_context__ModuleFieldTypeBinding"
    if member_name == "semantic_nodes":
        return "cinder_cinder_selfhost_backend_ir__IRNode"
    if member_name == "deferred_expressions":
        return "cinder_cinder_selfhost_syntax__NodeId"
    if member_name == "pointer_names" or member_name == "with_resources" or member_name == "global_names" or member_name == "extern_names":
        return "CinderString"
    if owner == "SymbolTable" and member_name == "symbols":
        return "cinder_cinder_selfhost_symbols__SymbolRecord"
    if owner == "SymbolTable" and member_name == "scopes":
        return "cinder_cinder_selfhost_symbols__ScopeRecord"
    if member_name == "symbols":
        return "cinder_cinder_selfhost_symbols__SymbolRecord"
    if member_name == "scopes":
        return "cinder_cinder_selfhost_symbols__ScopeRecord"
    if owner == "Lexer" and member_name == "tokens":
        return "cinder_cinder_selfhost_token__Token"
    if member_name == "tokens":
        return "cinder_cinder_selfhost_token__Token"
    if owner == "Lexer" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_token__LexerDiagnostic"
    if owner == "Parser" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_syntax__ParseDiagnostic"
    if owner == "Checker" and member_name == "diagnostics":
        return "cinder_cinder_selfhost_checker__CheckerDiagnostic"
    if owner == "ProjectGraph" and member_name == "modules":
        return "cinder_cinder_selfhost_project__ParsedModule"
    if owner == "DriverOptions" and member_name == "program_args":
        return "CinderString"
    if owner == "DriverOptions" and member_name == "cflags":
        return "CinderString"
    if owner == "DriverOptions" and member_name == "ldflags":
        return "CinderString"
    if owner == "EmitResult" and member_name == "sources":
        return "CinderString"
    if owner == "EmitResult" and member_name == "headers":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "include_dirs":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "library_dirs":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "libraries":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "link_files":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "cflags":
        return "CinderString"
    if owner == "NativeConfig" and member_name == "ldflags":
        return "CinderString"
    return ""

def emit_module_slice(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    receiver = codegen_names.first_child(arena, id)
    start = codegen_names.second_child(arena, id)
    stop = codegen_names.last_child(arena, id)
    receiver_type = codegen_context.context_expression_type(arena, context, receiver, source)
    if not codegen_context.expression_may_be_string(arena, context, receiver, source):
        element_type = codegen_context.context_expression_list_element_type(arena, context, receiver, source)
        if codegen_specializations.context_type_is_array(context.type_arena, receiver_type):
            builder.append("(CinderList){ .data = (void *)(&")
            emit_nested(state, receiver)
            builder.append("[")
            if start.index >= 0 and start.index != stop.index:
                emit_nested(state, start)
            else:
                builder.append("0")
            builder.append("]), .length = (")
            if stop.index >= 0 and stop.index != receiver.index:
                emit_nested(state, stop)
            else:
                length = codegen_specializations.array_length_node(context.type_arena, receiver_type)
                codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
            builder.append(" - ")
            if start.index >= 0 and start.index != stop.index:
                emit_nested(state, start)
            else:
                builder.append("0")
            builder.append("), .capacity = 0 }")
            return
        builder.append("cinder_selfhost_list_slice(")
        if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("*")
        emit_nested(state, receiver)
        builder.append(", ")
        if start.index >= 0 and start.index != stop.index:
            emit_nested(state, start)
        else:
            builder.append("0")
        builder.append(", ")
        if stop.index >= 0 and stop.index != receiver.index:
            emit_nested(state, stop)
        else:
            emit_nested(state, receiver)
            if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                builder.append("->length")
            else:
                builder.append(".length")
        builder.append(", sizeof(")
        if element_type.index >= 0:
            codegen_context.emit_context_c_type(context.type_arena, element_type, context.type_source, builder, prefix, project_name, imports, context)
        else:
            builder.append("char")
        builder.append("))")
        return
    materialize_receiver = expression_is_owned_path_string(arena, receiver, source, imports, context)
    receiver_temporary: i32 = -1
    result_temporary: i32 = -1
    if materialize_receiver:
        receiver_temporary = context.temporary_index
        context.temporary_index += 1
        result_temporary = context.temporary_index
        context.temporary_index += 1
        builder.append("({ CinderString ")
        append_path_temporary_name(builder, "slice", receiver_temporary)
        builder.append(" = ")
        emit_nested(state, receiver)
        builder.append("; CinderString ")
        append_path_temporary_name(builder, "slice_result", result_temporary)
        builder.append(" = ")
    builder.append("cinder_string_slice(")
    receiver_is_pointer = codegen_context.context_expression_is_pointer_like(arena, context, receiver, source)
    if materialize_receiver:
        builder.append("&")
        append_path_temporary_name(builder, "slice", receiver_temporary)
    else:
        if not receiver_is_pointer:
            builder.append("&")
        emit_nested(state, receiver)
    builder.append(", ")
    if start.index >= 0 and start.index != stop.index:
        emit_nested(state, start)
    else:
        builder.append("0")
    builder.append(", ")
    if stop.index >= 0 and stop.index != receiver.index:
        emit_nested(state, stop)
    elif materialize_receiver:
        append_path_temporary_name(builder, "slice", receiver_temporary)
        builder.append(".length")
    else:
        emit_nested(state, receiver)
        if receiver_is_pointer:
            builder.append("->length")
        else:
            builder.append(".length")
    builder.append(")")
    if materialize_receiver:
        builder.append("; cinder_string_drop(&")
        append_path_temporary_name(builder, "slice", receiver_temporary)
        builder.append("); ")
        append_path_temporary_name(builder, "slice_result", result_temporary)
        builder.append("; })")

def emit_nominal_member_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    owner = codegen_names.first_child(arena, id)
    member = codegen_names.second_child(arena, id)
    if owner.index < 0 or member.index < 0:
        return false
    member_node = arena.nodes[member.index]
    if member_node.kind != SyntaxKind.NAME:
        return false
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    nominal_index = codegen_reflection.find_expression_nominal(context.reflection_model, imports, &context.module_name, arena, owner, source)
    if nominal_index < 0:
        owner_node = arena.nodes[owner.index]
        if owner_node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, owner_node.value_start, owner_node.value_length, "ConvertError"):
            builder.append("CinderParseError_")
            builder.append(member_name[0:len(member_name)])
            return true
        return false
    nominal_kind = codegen_reflection.nominal_kind_at(context.reflection_model, nominal_index)
    nominal_c_name = codegen_reflection.nominal_c_name_at(context.reflection_model, nominal_index)
    if nominal_kind == codegen_reflection.ReflectionNominalKind.ENUM:
        builder.append(nominal_c_name[0:len(nominal_c_name)])
        builder.append("_")
        builder.append(member_name[0:len(member_name)])
        return true
    if nominal_kind != codegen_reflection.ReflectionNominalKind.VARIANT:
        return false
    case_index = codegen_reflection.find_variant_case(context.reflection_model, nominal_index, &member_name)
    if case_index < 0 or codegen_reflection.variant_case_field_count_at(context.reflection_model, case_index) != 0:
        return false
    expected_type = context.expected_type
    if expected_type.index >= 0 and arena.nodes[expected_type.index].kind == SyntaxKind.TYPE_GENERIC:
        expected_owner = codegen_type_names.context_type_owner_name(context.type_arena, expected_type, context.type_source)
        nominal_name = codegen_reflection.nominal_name_at(context.reflection_model, nominal_index)
        if codegen_reflection.text_equals(&expected_owner, &nominal_name):
            name_builder = StringBuilder()
            codegen_context.emit_context_c_type(arena, expected_type, source, &name_builder, prefix, project_name, imports, context)
            nominal_c_name = name_builder.finish()
    builder.append("((")
    builder.append(nominal_c_name[0:len(nominal_c_name)])
    builder.append("){ .tag = ")
    builder.append(nominal_c_name[0:len(nominal_c_name)])
    builder.append("_")
    builder.append(member_name[0:len(member_name)])
    builder.append(" })")
    return true


def emit_module_attribute(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    receiver = codegen_names.first_child(arena, id)
    member = codegen_names.second_child(arena, id)
    if emit_comptime_reflection_attribute(arena, receiver, member, source, builder, context):
        return
    if receiver.index >= 0 and member.index >= 0:
        member_node = arena.nodes[member.index]
        member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
        if member_name == "is_ok" or member_name == "is_err":
            result_builder = StringBuilder()
            if emit_result_expression_name(arena, receiver, source, &result_builder, prefix, project_name, imports, context):
                result_name = result_builder.finish()
                builder.append("((")
                emit_nested(state, receiver)
                builder.append(").tag == ")
                builder.append(result_name[0:len(result_name)])
                if member_name == "is_ok":
                    builder.append("_Tag_Ok")
                else:
                    builder.append("_Tag_Err")
                builder.append(")")
                return
        if member_name == "is_some" or member_name == "is_none" or member_name == "value":
            option_builder = StringBuilder()
            if emit_option_expression_name(arena, receiver, source, &option_builder, prefix, project_name, imports, context):
                option_name = option_builder.finish()
                is_value = member_name == "value"
                if not is_value:
                    builder.append("(")
                builder.append("(")
                emit_nested(state, receiver)
                builder.append(")")
                if is_value:
                    builder.append(".data.value")
                else:
                    builder.append(".tag == ")
                    builder.append(option_name[0:len(option_name)])
                    if member_name == "is_some":
                        builder.append("_Tag_Some")
                    else:
                        builder.append("_Tag_None")
                    builder.append(")")
                return
    if emit_nominal_member_expression(arena, id, source, builder, prefix, project_name, imports, context):
        return
    if receiver.index >= 0 and member.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        member_node = arena.nodes[member.index]
        if receiver_node.kind == SyntaxKind.EXPR_NAME and member_node.kind == SyntaxKind.NAME:
            receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = codegen_names.find_import_alias(imports, &receiver_name)
            if len(imported.module_name) > 0:
                if imported.virtual_builtin and imported.module_name == "math" and codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "pi"):
                    builder.append("CINDER_PI")
                    return
                builder.append(codegen_names.c_prefix(project_name, &imported.module_name))
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            imported_member = codegen_names.find_import_member(imports, &receiver_name)
            if len(imported_member.module_name) > 0 and len(imported_member.member) > 0:
                builder.append(codegen_names.c_prefix(project_name, &imported_member.module_name))
                builder.append(imported_member.member)
                builder.append("_")
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            if codegen_names.is_uppercase_start(source, receiver_node.value_start):
                builder.append(prefix[0:len(prefix)])
                codegen_names.append_source(builder, source, receiver_node.value_start, receiver_node.value_length)
                builder.append("_")
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            if codegen_names.range_text_equals(source, receiver_node.value_start, receiver_node.value_length, "self"):
                field_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
                field_owner = classes.find_field_owner(model, context.current_class, &field_name)
                if context.current_self_is_dyn:
                    owner_index = context.current_class
                    if field_owner >= 0:
                        owner_index = field_owner
                    owner: &const classes.ClassInfo = &model.classes[cast[usize](owner_index)]
                    builder.append("((")
                    builder.append(owner.c_name[0:len(owner.c_name)])
                    builder.append(" *)self.object)->")
                else:
                    builder.append("self->")
                    append_inherited_field_path(builder, context.current_class, field_owner, model)
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
            receiver_type = codegen_context.context_name_type(context, &receiver_name)
            if codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "length") and codegen_specializations.context_type_is_array(context.type_arena, receiver_type):
                length = codegen_specializations.array_length_node(context.type_arena, receiver_type)
                codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
                return
            if codegen_context.context_name_is_pointer(arena, context, &receiver_name):
                codegen_names.append_source(builder, source, receiver_node.value_start, receiver_node.value_length)
                builder.append("->")
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
    if receiver.index >= 0 and member.index >= 0:
        receiver_node = arena.nodes[receiver.index]
        member_node = arena.nodes[member.index]
        if receiver_node.kind == SyntaxKind.EXPR_ATTRIBUTE and codegen_names.is_uppercase_start(source, member_node.value_start):
            emit_nested(state, receiver)
            builder.append("_")
            codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
            return
        dyn_interface = codegen_context.context_expression_dyn_interface(arena, context, receiver, source)
        if dyn_interface >= 0:
            interface: &const classes.ClassInfo = &model.classes[cast[usize](dyn_interface)]
            builder.append("((")
            builder.append(interface.c_name[0:len(interface.c_name)])
            builder.append(" *)(")
            emit_nested(state, receiver)
            builder.append(".object))->")
            codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
            return
        receiver_class = codegen_context.context_expression_class(arena, context, receiver, source)
        if receiver_class >= 0:
            field_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
            field_owner = classes.find_field_owner(model, receiver_class, &field_name)
            if field_owner >= 0 and field_owner != receiver_class:
                emit_nested(state, receiver)
                if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
                    builder.append("->")
                else:
                    builder.append(".")
                append_inherited_field_path(builder, receiver_class, field_owner, model)
                codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
                return
        emit_nested(state, receiver)
        if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
            builder.append("->")
        else:
            builder.append(".")
        codegen_names.append_source(builder, source, member_node.value_start, member_node.value_length)
        return
    codegen_names.append_source(builder, source, codegen_names.node_start(arena, id), codegen_names.node_length(arena, id))


def emit_comptime_reflection_attribute(
    arena: &const SyntaxArena,
    receiver: NodeId,
    member: NodeId,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    if receiver.index < 0 or member.index < 0:
        return false
    receiver_node = arena.nodes[receiver.index]
    member_node = arena.nodes[member.index]
    if receiver_node.kind != SyntaxKind.EXPR_NAME or member_node.kind != SyntaxKind.NAME:
        return false
    if not codegen_context.context_reflection_binding_is(context, source, receiver_node.value_start, receiver_node.value_length, codegen_context.ReflectionBindingKind.COMPTIME_FIELD):
        return false
    field_index = codegen_context.context_reflection_binding_field(context, source, receiver_node.value_start, receiver_node.value_length)
    nominal_index = codegen_context.context_reflection_binding_nominal(context, source, receiver_node.value_start, receiver_node.value_length)
    model: &const codegen_reflection.ProjectReflectionModel = context.reflection_model
    if field_index < 0 or field_index >= cast[i32](len(model.fields)):
        builder.append("0")
        return true
    field: &const codegen_reflection.ReflectionFieldInfo = &model.fields[cast[usize](field_index)]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    if member_name == "name" or member_name == "type_name":
        builder.append("cinder_string_from_cstr(\"")
        if member_name == "name":
            builder.append(field.name[0:len(field.name)])
        else:
            builder.append(field.type_name[0:len(field.type_name)])
        builder.append("\")")
        return true
    if member_name == "offset":
        append_comptime_field_offset(builder, model, context.class_model, nominal_index, field.owner, &field.name)
        return true
    if member_name == "size":
        builder.append("sizeof(")
        builder.append(field.c_type[0:len(field.c_type)])
        builder.append(")")
        return true
    if member_name == "alignment":
        builder.append("CINDER_ALIGNOF(")
        builder.append(field.c_type[0:len(field.c_type)])
        builder.append(")")
        return true
    if member_name == "is_private":
        if field.is_private:
            builder.append("true")
        else:
            builder.append("false")
        return true
    builder.append("0")
    return true


def append_comptime_field_offset(
    builder: &StringBuilder,
    model: &const codegen_reflection.ProjectReflectionModel,
    class_model: &const classes.ProjectClassModel,
    root: i32,
    owner: i32,
    field_name: &const String,
) -> void:
    if root < 0 or root >= cast[i32](len(model.nominals)):
        builder.append("0")
        return
    nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[cast[usize](root)]
    if root == owner:
        builder.append("offsetof(")
        builder.append(nominal.c_name[0:len(nominal.c_name)])
        builder.append(", ")
        builder.append(field_name[0:len(field_name)])
        builder.append(")")
        return
    base = codegen_reflection.nominal_primary_base(model, class_model, root)
    if base < 0:
        builder.append("0")
        return
    builder.append("(offsetof(")
    builder.append(nominal.c_name[0:len(nominal.c_name)])
    builder.append(", _base) + ")
    append_comptime_field_offset(builder, model, class_model, base, owner, field_name)
    builder.append(")")


def append_inherited_field_path(
    builder: &StringBuilder,
    source_class: i32,
    field_owner: i32,
    model: &const classes.ProjectClassModel,
) -> void:
    current = source_class
    while current >= 0 and field_owner >= 0 and current != field_owner:
        builder.append("_base.")
        current = model.classes[cast[usize](current)].primary_base


def emit_result_expression_name(
    arena: &const SyntaxArena,
    expression: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    expression_type = codegen_context.context_expression_type(arena, context, expression, source)
    if codegen_context.context_type_is_runtime_generic(context.type_arena, expression_type, context.type_source, "Result"):
        codegen_context.emit_context_c_type(context.type_arena, expression_type, context.type_source, builder, prefix, project_name, imports, context)
        return true
    call_name = codegen_context.context_call_result_c_type(arena, context, expression, source)
    if len(call_name) > 0:
        builder.append(call_name[0:len(call_name)])
        return true
    semantic_type = codegen_context.context_semantic_type(context, expression)
    if codegen_type_names.semantic_type_is_kind(context.type_table, semantic_type, types.TypeKind.RESULT):
        codegen_type_names.emit_semantic_c_type(context.type_table, semantic_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        return true
    return false


def emit_option_expression_name(
    arena: &const SyntaxArena,
    expression: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    expression_type = codegen_context.context_expression_type(arena, context, expression, source)
    if codegen_context.context_type_is_file_read_call(context.type_arena, expression_type, context.type_source, "read_line"):
        builder.append("CinderOption_String")
        return true
    if codegen_context.context_type_is_runtime_generic(context.type_arena, expression_type, context.type_source, "Option"):
        codegen_context.emit_context_c_type(context.type_arena, expression_type, context.type_source, builder, prefix, project_name, imports, context)
        return true
    semantic_type = codegen_context.context_semantic_type(context, expression)
    if codegen_type_names.semantic_type_is_kind(context.type_table, semantic_type, types.TypeKind.OPTION):
        codegen_type_names.emit_semantic_c_type(context.type_table, semantic_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
        return true
    expression_node = arena.nodes[expression.index]
    if expression_node.kind != SyntaxKind.EXPR_CALL:
        return false
    callee = codegen_names.first_child(arena, expression)
    if callee.index < 0 or arena.nodes[callee.index].kind != SyntaxKind.EXPR_ATTRIBUTE:
        return false
    member = codegen_names.second_child(arena, callee)
    if member.index < 0:
        return false
    member_node = arena.nodes[member.index]
    if not codegen_names.range_text_equals(source, member_node.value_start, member_node.value_length, "get"):
        return false
    map_receiver = codegen_names.first_child(arena, callee)
    map_type = codegen_context.context_expression_type(arena, context, map_receiver, source)
    value_type = codegen_context.context_generic_argument(context.type_arena, map_type, 1)
    builder.append("CinderOption_")
    if value_type.index >= 0:
        codegen_type_names.emit_readable_specialized_type_name(context.type_arena, value_type, context.type_source, builder)
        return true
    semantic_map = codegen_context.context_semantic_type(context, map_receiver)
    if not codegen_type_names.semantic_type_is_kind(context.type_table, semantic_map, types.TypeKind.MAP):
        return false
    type_table: &const types.TypeTable = context.type_table
    semantic_value = type_table.types[semantic_map.index].second
    codegen_type_names.emit_semantic_readable_type_name(type_table, semantic_value, context.type_source, builder)
    return true

def emit_remaining_call_arguments(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    already_emitted: bool,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    node = arena.nodes[id.index]
    emitted_argument = already_emitted
    argument_index: usize = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted_argument:
                builder.append(", ")
            arg = codegen_names.last_child(arena, child_id)
            callee = codegen_names.first_child(arena, id)
            dyn_interface = codegen_context.context_callee_dyn_parameter(arena, context, callee, source, argument_index)
            if dyn_interface >= 0:
                emit_dyn_conversion(arena, arg, dyn_interface, source, builder, context, state, emit_nested)
                emitted_argument = true
                argument_index += 1
                continue
            expected_type = codegen_context.context_callee_parameter_type(arena, context, callee, source, argument_index)
            arg_type = codegen_context.context_expression_type(arena, context, arg, source)
            if expected_type.index >= 0 and codegen_type_names.type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_SLICE and codegen_specializations.context_type_is_array(context.type_arena, arg_type):
                emit_array_as_list(arena, arg, arg_type, source, builder, prefix, project_name, imports, context, state, emit_nested)
                emitted_argument = true
                argument_index += 1
                continue
            borrow_argument = codegen_context.should_borrow_named_argument(arena, context, arg, source)
            if not borrow_argument:
                borrow_argument = codegen_context.should_borrow_for_callee(arena, context, callee, arg, source, argument_index)
            if borrow_argument and not codegen_context.call_is_name(arena, callee, source, "dump_summary"):
                builder.append("&")
            previous_expected = context.expected_type
            if expected_type.index >= 0:
                context.expected_type = expected_type
            emit_nested(state, arg)
            context.expected_type = previous_expected
            if not borrow_argument:
                codegen_context.mark_context_expression_moved(arena, context, arg, source)
            emitted_argument = true
            argument_index += 1

def emit_c_string_argument(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    if id.index < 0:
        builder.append("\"\"")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL and node.flags == cast[i32](token.TokenKind.STRING):
        codegen_names.append_source(builder, source, node.value_start, node.value_length)
        return
    if codegen_context.expression_may_be_string(arena, context, id, source):
        builder.append("cinder_string_cstr(")
        emit_receiver_argument(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
        builder.append(")")
        return
    emit_nested(state, id)

def emit_receiver_argument(
    arena: &const SyntaxArena,
    receiver: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    if receiver.index >= 0:
        node = arena.nodes[receiver.index]
        if node.kind == SyntaxKind.EXPR_NAME and codegen_names.range_text_equals(source, node.value_start, node.value_length, "self"):
            builder.append("self")
            return
    if codegen_context.context_expression_is_pointer_like(arena, context, receiver, source):
        emit_nested(state, receiver)
        return
    builder.append("&")
    emit_nested(state, receiver)
