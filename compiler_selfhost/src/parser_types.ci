import diagnostics
import parser_core
import syntax
from syntax import NodeId, SyntaxKind
from token import Token, TokenKind

def parse_type(context: &parser_core.ParserContext) -> NodeId:
    start = parser_core.current(context)
    if parser_core.match_kind(context, TokenKind.STAR):
        token = parser_core.previous(context)
        children: List[NodeId] = []
        syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_POINTER, token, parser_core.previous(context), token, children, 0)
    if parser_core.match_kind(context, TokenKind.AMPERSAND):
        token = parser_core.previous(context)
        children: List[NodeId] = []
        if parser_core.match_kind(context, TokenKind.DYN):
            syntax.append_valid(children, parse_type(context))
            return parser_core.make_node(context, SyntaxKind.TYPE_DYN, token, parser_core.previous(context), token, children, 0)
        syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_REFERENCE, token, parser_core.previous(context), token, children, 0)
    if parser_core.at(context, TokenKind.LEFT_BRACKET) and parser_core.peek(context, 1).kind == TokenKind.RIGHT_BRACKET:
        parser_core.advance(context)
        token = parser_core.previous(context)
        parser_core.advance(context)
        children: List[NodeId] = []
        syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_SLICE, token, parser_core.previous(context), token, children, 0)
    if parser_core.match_kind(context, TokenKind.CONST):
        token = parser_core.previous(context)
        children: List[NodeId] = []
        syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_CONST, token, parser_core.previous(context), token, children, 0)
    if parser_core.match_kind(context, TokenKind.DEF):
        token = parser_core.previous(context)
        children: List[NodeId] = []
        parser_core.expect(context, TokenKind.LEFT_PAREN, diagnostics.DiagnosticId.PARSE_149)
        parse_type_list(context, children, TokenKind.RIGHT_PAREN)
        parser_core.expect(context, TokenKind.RIGHT_PAREN, diagnostics.DiagnosticId.PARSE_150)
        if parser_core.match_kind(context, TokenKind.ARROW):
            syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_FUNCTION, token, parser_core.previous(context), token, children, 0)
    if parser_core.at(context, TokenKind.NAME) and parser_core.token_text_equals(context, parser_core.current(context), "closure"):
        token = parser_core.advance(context)
        children: List[NodeId] = []
        parser_core.expect(context, TokenKind.LEFT_BRACKET, diagnostics.DiagnosticId.PARSE_151)
        syntax.append_valid(children, parse_type(context))
        parser_core.expect(context, TokenKind.RIGHT_BRACKET, diagnostics.DiagnosticId.PARSE_152)
        parser_core.expect(context, TokenKind.LEFT_PAREN, diagnostics.DiagnosticId.PARSE_153)
        parse_type_list(context, children, TokenKind.RIGHT_PAREN)
        parser_core.expect(context, TokenKind.RIGHT_PAREN, diagnostics.DiagnosticId.PARSE_154)
        if parser_core.match_kind(context, TokenKind.ARROW):
            syntax.append_valid(children, parse_type(context))
        return parser_core.make_node(context, SyntaxKind.TYPE_CLOSURE, token, parser_core.previous(context), token, children, 0)
    name = parser_core.expect(context, TokenKind.NAME, diagnostics.DiagnosticId.PARSE_066)
    children: List[NodeId] = []
    syntax.append_valid(children, parser_core.make_token_node(context, SyntaxKind.NAME, name, 0))
    while parser_core.match_kind(context, TokenKind.DOT):
        part = parser_core.expect(context, TokenKind.NAME, diagnostics.DiagnosticId.PARSE_067)
        syntax.append_valid(children, parser_core.make_token_node(context, SyntaxKind.NAME, part, 0))
    node = parser_core.make_node(context, SyntaxKind.TYPE_NAME, start, parser_core.previous(context), name, children, 0)
    if parser_core.at(context, TokenKind.LEFT_BRACKET) and parser_core.peek(context, 1).kind != TokenKind.INTEGER and parser_core.peek(context, 1).kind != TokenKind.RIGHT_BRACKET:
        parser_core.advance(context)
        generic_children: List[NodeId] = []
        syntax.append_valid(generic_children, node)
        parse_type_list(context, generic_children, TokenKind.RIGHT_BRACKET)
        parser_core.expect(context, TokenKind.RIGHT_BRACKET, diagnostics.DiagnosticId.PARSE_068)
        node = parser_core.make_node(context, SyntaxKind.TYPE_GENERIC, start, parser_core.previous(context), name, generic_children, 0)
    while true:
        if parser_core.match_kind(context, TokenKind.STAR):
            token = parser_core.previous(context)
            postfix_children: List[NodeId] = []
            syntax.append_valid(postfix_children, node)
            node = parser_core.make_node(context, SyntaxKind.TYPE_POINTER, start, token, token, postfix_children, 1)
            continue
        if parser_core.match_kind(context, TokenKind.LEFT_BRACKET):
            array_children: List[NodeId] = []
            syntax.append_valid(array_children, node)
            if not parser_core.at(context, TokenKind.RIGHT_BRACKET):
                length = parser_core.expect(context, TokenKind.INTEGER, diagnostics.DiagnosticId.PARSE_069)
                syntax.append_valid(array_children, parser_core.make_token_node(context, SyntaxKind.EXPR_LITERAL, length, cast[i32](TokenKind.INTEGER)))
            close = parser_core.expect(context, TokenKind.RIGHT_BRACKET, diagnostics.DiagnosticId.PARSE_070)
            node = parser_core.make_node(context, SyntaxKind.TYPE_ARRAY, start, close, close, array_children, 0)
            continue
        break
    return node

def parse_type_list(context: &parser_core.ParserContext, children: &List[NodeId], closing: TokenKind) -> void:
    if parser_core.at(context, closing):
        return
    while not *context.failed:
        syntax.append_valid(children, parse_type(context))
        if not parser_core.match_kind(context, TokenKind.COMMA):
            break
        if parser_core.at(context, closing):
            break
