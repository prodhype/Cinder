import diagnostics
import lexer
import syntax
from syntax import NodeId, SyntaxArena, SyntaxKind
from token import Token, TokenKind, token_kind_display

struct ParserContext:
    scan: &const lexer.Lexer
    index: *usize
    arena: &SyntaxArena
    diagnostic_values: &List[diagnostics.Diagnostic]
    failed: *bool


def new_context(
    scan: &const lexer.Lexer,
    index: *usize,
    arena: &SyntaxArena,
    diagnostic_values: &List[diagnostics.Diagnostic],
    failed: *bool,
) -> ParserContext:
    return ParserContext(scan=scan, index=index, arena=arena, diagnostic_values=diagnostic_values, failed=failed)


def current(context: &ParserContext) -> Token:
    return context.scan.tokens[*context.index]

def previous(context: &ParserContext) -> Token:
    if *context.index == 0:
        return current(context)
    return context.scan.tokens[*context.index - 1]

def peek(context: &ParserContext, offset: usize) -> Token:
    position: usize = *context.index + offset
    if position >= len(context.scan.tokens):
        position = len(context.scan.tokens) - 1
    return context.scan.tokens[position]

def token_count(context: &ParserContext) -> usize:
    return len(context.scan.tokens)


def token_at(context: &ParserContext, index: usize) -> Token:
    return context.scan.tokens[index]


def at(context: &ParserContext, kind: TokenKind) -> bool:
    return current(context).kind == kind

def advance(context: &ParserContext) -> Token:
    token = current(context)
    if token.kind != TokenKind.EOF:
        *context.index += 1
    return token

def match_kind(context: &ParserContext, kind: TokenKind) -> bool:
    if at(context, kind):
        advance(context)
        return true
    return false

def emit_error(
    context: &ParserContext,
    id: diagnostics.DiagnosticId,
    expected: String,
    token: Token,
) -> void:
    if not *context.failed:
        context.diagnostic_values.append(
            diagnostics.parser_expected_diagnostic(
                id,
                diagnostics.source_span(token.start, token.length, token.line, token.column),
                expected,
                token_kind_display(token.kind),
            )
        )
    *context.failed = true

def expect(context: &ParserContext, kind: TokenKind, id: diagnostics.DiagnosticId) -> Token:
    if at(context, kind):
        return advance(context)
    token = current(context)
    emit_error(context, id, token_kind_display(kind), token)
    return token

def make_token_node(context: &ParserContext, kind: SyntaxKind, token: Token, flags: i32) -> NodeId:
    return context.arena.add_token_node(kind, token.start, token.length, token.line, token.column, flags)

def make_leaf(context: &ParserContext, kind: SyntaxKind, start: Token, end: Token, value: Token, flags: i32) -> NodeId:
    children: List[NodeId] = []
    return make_node(context, kind, start, end, value, children, flags)

def make_node(
    context: &ParserContext,
    kind: SyntaxKind,
    start: Token,
    end: Token,
    value: Token,
    children: &const List[NodeId],
    flags: i32,
) -> NodeId:
    node_end = end.start + end.length
    first_child = cast[i32](len(context.arena.children))
    index: usize = 0
    while index < len(children):
        child = children[index]
        if child.index >= 0:
            context.arena.children.append(child)
        index += 1
    child_count = cast[i32](len(context.arena.children)) - first_child
    return context.arena.add_node_raw(
        kind,
        start.start,
        node_end,
        start.line,
        start.column,
        value.start,
        value.length,
        first_child,
        child_count,
        flags,
    )

def make_node_from_range(
    context: &ParserContext,
    kind: SyntaxKind,
    start: Token,
    end: Token,
    children: &const List[NodeId],
    flags: i32,
) -> NodeId:
    return make_node(context, kind, start, end, start, children, flags)

def token_text_equals(context: &ParserContext, token: Token, text: String) -> bool:
    if token.length != len(text):
        return false
    offset: usize = 0
    while offset < token.length:
        if context.scan.source.byte_at(token.start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true

def is_assignment_kind(kind: TokenKind) -> bool:
    return kind == TokenKind.ASSIGN or kind == TokenKind.PLUS_ASSIGN or kind == TokenKind.MINUS_ASSIGN or kind == TokenKind.STAR_ASSIGN or kind == TokenKind.SLASH_ASSIGN or kind == TokenKind.PERCENT_ASSIGN or kind == TokenKind.AMPERSAND_ASSIGN or kind == TokenKind.PIPE_ASSIGN or kind == TokenKind.CARET_ASSIGN or kind == TokenKind.SHIFT_LEFT_ASSIGN or kind == TokenKind.SHIFT_RIGHT_ASSIGN


def binary_precedence(kind: TokenKind) -> i32:
    if kind == TokenKind.OR:
        return 1
    if kind == TokenKind.AND:
        return 2
    if kind == TokenKind.PIPE:
        return 3
    if kind == TokenKind.CARET:
        return 4
    if kind == TokenKind.AMPERSAND:
        return 5
    if kind == TokenKind.EQUAL or kind == TokenKind.NOT_EQUAL or kind == TokenKind.LESS or kind == TokenKind.LESS_EQUAL or kind == TokenKind.GREATER or kind == TokenKind.GREATER_EQUAL or kind == TokenKind.IN:
        return 6
    if kind == TokenKind.SHIFT_LEFT or kind == TokenKind.SHIFT_RIGHT:
        return 7
    if kind == TokenKind.PLUS or kind == TokenKind.MINUS:
        return 8
    if kind == TokenKind.STAR or kind == TokenKind.SLASH or kind == TokenKind.PERCENT:
        return 9
    return 0
