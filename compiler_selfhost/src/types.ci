import syntax
from syntax import NodeId


enum TypeKind:
    ERROR
    VOID
    BOOL
    I32
    I64
    F64
    CHAR
    STRING
    STRING_BUILDER
    CONVERT_ERROR
    NAMED
    POINTER
    REFERENCE
    SLICE
    ARRAY
    FUNCTION
    CLOSURE
    DYN
    CONST
    ENUM
    UNION
    VARIANT
    CLASS
    STRUCT
    TUPLE
    OPTION
    RESULT
    OWNED
    LIST
    MAP
    SET
    MAP_KEYS
    MAP_VALUES
    MAP_ITEMS
    FILE
    ATOMIC
    ATOMIC_COMPARE_EXCHANGE_RESULT


enum AtomicElementKind:
    INVALID
    BOOL
    U32
    U64
    USIZE


struct TypeId:
    index: i32


struct TypeRecord:
    kind: TypeKind
    name_start: usize
    name_length: usize
    inner: TypeId
    second: TypeId
    extra: i32
    flags: i32


struct TypeTable:
    types: List[TypeRecord]
    type_args: List[TypeId]

    def add(self: &TypeTable, kind: TypeKind, name_start: usize, name_length: usize, inner: TypeId, extra: i32, flags: i32) -> TypeId:
        return self.add_full(kind, name_start, name_length, inner, missing_type(), extra, flags)

    def add_full(self: &TypeTable, kind: TypeKind, name_start: usize, name_length: usize, inner: TypeId, second: TypeId, extra: i32, flags: i32) -> TypeId:
        id = TypeId(index=cast[i32](len(self.types)))
        self.types.append(
            TypeRecord(
                kind=kind,
                name_start=name_start,
                name_length=name_length,
                inner=inner,
                second=second,
                extra=extra,
                flags=flags,
            )
        )
        return id

    def primitive(self: &TypeTable, kind: TypeKind) -> TypeId:
        return self.add(kind, 0, 0, missing_type(), 0, 0)

    def pointer_to(self: &TypeTable, inner: TypeId) -> TypeId:
        return self.add(TypeKind.POINTER, 0, 0, inner, 0, 0)

    def reference_to(self: &TypeTable, inner: TypeId) -> TypeId:
        return self.add(TypeKind.REFERENCE, 0, 0, inner, 0, 0)

    def const_of(self: &TypeTable, inner: TypeId) -> TypeId:
        return self.add(TypeKind.CONST, 0, 0, inner, 0, 0)

    def slice_of(self: &TypeTable, inner: TypeId) -> TypeId:
        return self.add(TypeKind.SLICE, 0, 0, inner, 0, 0)

    def array_of(self: &TypeTable, inner: TypeId, length: i32) -> TypeId:
        return self.add(TypeKind.ARRAY, 0, 0, inner, length, 0)

    def dyn_of(self: &TypeTable, inner: TypeId) -> TypeId:
        return self.add(TypeKind.DYN, 0, 0, inner, 0, 0)

    def atomic_of(self: &TypeTable, inner: TypeId, element_kind: AtomicElementKind) -> TypeId:
        return self.add(TypeKind.ATOMIC, 0, 0, inner, cast[i32](element_kind), 0)

    def atomic_compare_exchange_result(self: &TypeTable, inner: TypeId, element_kind: AtomicElementKind) -> TypeId:
        return self.add(TypeKind.ATOMIC_COMPARE_EXCHANGE_RESULT, 0, 0, inner, cast[i32](element_kind), 0)

    def named(self: &TypeTable, start: usize, length: usize) -> TypeId:
        return self.add(TypeKind.NAMED, start, length, missing_type(), 0, 0)

    def nominal(self: &TypeTable, kind: TypeKind, start: usize, length: usize) -> TypeId:
        return self.add(kind, start, length, missing_type(), 0, 0)

    def generic1(self: &TypeTable, kind: TypeKind, start: usize, length: usize, inner: TypeId) -> TypeId:
        return self.add(kind, start, length, inner, 0, 1)

    def generic2(self: &TypeTable, kind: TypeKind, start: usize, length: usize, first: TypeId, second: TypeId) -> TypeId:
        return self.add_full(kind, start, length, first, second, 0, 2)

    def generic_from_args(self: &TypeTable, kind: TypeKind, start: usize, length: usize, args: &const List[TypeId]) -> TypeId:
        first = cast[i32](len(self.type_args))
        index: usize = 0
        while index < len(args):
            self.type_args.append(args[index])
            index += 1
        return self.add(kind, start, length, missing_type(), first, cast[i32](len(args)))

    def map_view(self: &TypeTable, kind: TypeKind, map_type: TypeId) -> TypeId:
        return self.generic1(kind, 0, 0, map_type)

    def tuple_from_args(self: &TypeTable, args: &const List[TypeId]) -> TypeId:
        first = cast[i32](len(self.type_args))
        index: usize = 0
        while index < len(args):
            self.type_args.append(args[index])
            index += 1
        return self.add(TypeKind.TUPLE, 0, 0, missing_type(), first, cast[i32](len(args)))

    def function_from_args(self: &TypeTable, args: &const List[TypeId], return_type: TypeId) -> TypeId:
        first = cast[i32](len(self.type_args))
        index: usize = 0
        while index < len(args):
            self.type_args.append(args[index])
            index += 1
        return self.add_full(TypeKind.FUNCTION, 0, 0, return_type, missing_type(), first, cast[i32](len(args)))

    def closure_from_args(self: &TypeTable, environment: TypeId, args: &const List[TypeId], return_type: TypeId) -> TypeId:
        first = cast[i32](len(self.type_args))
        index: usize = 0
        while index < len(args):
            self.type_args.append(args[index])
            index += 1
        return self.add_full(TypeKind.CLOSURE, 0, 0, return_type, environment, first, cast[i32](len(args)))

    def same(self: &const TypeTable, left: TypeId, right: TypeId) -> bool:
        if left.index == right.index:
            return true
        if left.index < 0 or right.index < 0:
            return false
        left_type = self.types[left.index]
        right_type = self.types[right.index]
        if left_type.kind != right_type.kind:
            return false
        if is_nominal_kind(left_type.kind):
            if left_type.name_start != right_type.name_start or left_type.name_length != right_type.name_length or left_type.flags != right_type.flags:
                return false
            offset: i32 = 0
            while offset < left_type.flags:
                if not self.same(self.type_args[cast[usize](left_type.extra + offset)], self.type_args[cast[usize](right_type.extra + offset)]):
                    return false
                offset += 1
            return true
        if left_type.kind == TypeKind.ATOMIC or left_type.kind == TypeKind.ATOMIC_COMPARE_EXCHANGE_RESULT:
            return left_type.extra == right_type.extra and self.same(left_type.inner, right_type.inner)
        if left_type.kind == TypeKind.ARRAY:
            return left_type.extra == right_type.extra and self.same(left_type.inner, right_type.inner)
        if left_type.kind == TypeKind.POINTER or left_type.kind == TypeKind.REFERENCE or left_type.kind == TypeKind.SLICE or left_type.kind == TypeKind.CONST or left_type.kind == TypeKind.DYN:
            return self.same(left_type.inner, right_type.inner)
        if left_type.kind == TypeKind.MAP or left_type.kind == TypeKind.RESULT:
            return self.same(left_type.inner, right_type.inner) and self.same(left_type.second, right_type.second)
        if left_type.kind == TypeKind.OPTION or left_type.kind == TypeKind.OWNED or left_type.kind == TypeKind.LIST or left_type.kind == TypeKind.SET or is_map_view_kind(left_type.kind):
            return self.same(left_type.inner, right_type.inner)
        if left_type.kind == TypeKind.TUPLE or left_type.kind == TypeKind.FUNCTION or left_type.kind == TypeKind.CLOSURE:
            if left_type.flags != right_type.flags:
                return false
            if left_type.kind == TypeKind.FUNCTION or left_type.kind == TypeKind.CLOSURE:
                if not self.same(left_type.inner, right_type.inner):
                    return false
            if left_type.kind == TypeKind.CLOSURE and not self.same(left_type.second, right_type.second):
                return false
            offset: i32 = 0
            while offset < left_type.flags:
                if not self.same(self.type_args[cast[usize](left_type.extra + offset)], self.type_args[cast[usize](right_type.extra + offset)]):
                    return false
                offset += 1
            return true
        return true

    def resolve_type_node(self: &TypeTable, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> TypeId:
        if id.index < 0:
            return type_i32()
        node = arena.nodes[id.index]
        if node.kind == syntax.SyntaxKind.TYPE_NAME:
            return self.resolve_type_name(source, node.value_start, node.value_length)
        if node.kind == syntax.SyntaxKind.TYPE_POINTER:
            return self.pointer_to(self.resolve_type_node(arena, first_child(arena, id), source))
        if node.kind == syntax.SyntaxKind.TYPE_REFERENCE:
            return self.reference_to(self.resolve_type_node(arena, first_child(arena, id), source))
        if node.kind == syntax.SyntaxKind.TYPE_CONST:
            return self.const_of(self.resolve_type_node(arena, first_child(arena, id), source))
        if node.kind == syntax.SyntaxKind.TYPE_SLICE:
            return self.slice_of(self.resolve_type_node(arena, first_child(arena, id), source))
        if node.kind == syntax.SyntaxKind.TYPE_DYN:
            return self.dyn_of(self.resolve_type_node(arena, first_child(arena, id), source))
        if node.kind == syntax.SyntaxKind.TYPE_ARRAY:
            return self.array_of(self.resolve_type_node(arena, first_child(arena, id), source), array_length_from_node(arena, id, source))
        if node.kind == syntax.SyntaxKind.TYPE_GENERIC:
            return self.resolve_generic_type_node(arena, id, source)
        if node.kind == syntax.SyntaxKind.TYPE_FUNCTION:
            return self.resolve_callable_type_node(arena, id, source, false)
        if node.kind == syntax.SyntaxKind.TYPE_CLOSURE:
            return self.resolve_callable_type_node(arena, id, source, true)
        return type_error()

    def resolve_type_name(self: &TypeTable, source: &const String, start: usize, length: usize) -> TypeId:
        if range_text_equals(source, start, length, "void"):
            return type_void()
        if range_text_equals(source, start, length, "bool"):
            return type_bool()
        if range_text_equals(source, start, length, "i32"):
            return type_i32()
        if range_text_equals(source, start, length, "i64"):
            return type_i64()
        if range_text_equals(source, start, length, "f64"):
            return type_f64()
        if range_text_equals(source, start, length, "char"):
            return type_char()
        if range_text_equals(source, start, length, "String"):
            return type_string()
        if range_text_equals(source, start, length, "StringBuilder"):
            return type_string_builder()
        if range_text_equals(source, start, length, "ConvertError"):
            return type_convert_error()
        if range_text_equals(source, start, length, "File"):
            return self.nominal(TypeKind.FILE, start, length)
        return self.named(start, length)

    def resolve_generic_type_node(self: &TypeTable, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> TypeId:
        node = arena.nodes[id.index]
        if node.child_count <= 0:
            return type_error()
        base_id = arena.children[node.first_child]
        base = arena.nodes[base_id.index]
        first_arg = child_at(arena, id, 1)
        second_arg = child_at(arena, id, 2)
        if range_text_equals(source, base.value_start, base.value_length, "Option"):
            return self.generic1(TypeKind.OPTION, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Owned"):
            return self.generic1(TypeKind.OWNED, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "List"):
            return self.generic1(TypeKind.LIST, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Set"):
            return self.generic1(TypeKind.SET, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Map"):
            return self.generic2(TypeKind.MAP, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source), self.resolve_type_node(arena, second_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "MapKeys"):
            return self.map_view(TypeKind.MAP_KEYS, self.generic2(TypeKind.MAP, 0, 0, self.resolve_type_node(arena, first_arg, source), self.resolve_type_node(arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "MapValues"):
            return self.map_view(TypeKind.MAP_VALUES, self.generic2(TypeKind.MAP, 0, 0, self.resolve_type_node(arena, first_arg, source), self.resolve_type_node(arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "MapItems"):
            return self.map_view(TypeKind.MAP_ITEMS, self.generic2(TypeKind.MAP, 0, 0, self.resolve_type_node(arena, first_arg, source), self.resolve_type_node(arena, second_arg, source)))
        if range_text_equals(source, base.value_start, base.value_length, "Result"):
            return self.generic2(TypeKind.RESULT, base.value_start, base.value_length, self.resolve_type_node(arena, first_arg, source), self.resolve_type_node(arena, second_arg, source))
        if range_text_equals(source, base.value_start, base.value_length, "Tuple"):
            args: List[TypeId] = []
            offset: i32 = 1
            while offset < node.child_count:
                args.append(self.resolve_type_node(arena, child_at(arena, id, offset), source))
                offset += 1
            return self.tuple_from_args(args)
        args: List[TypeId] = []
        offset: i32 = 1
        while offset < node.child_count:
            args.append(self.resolve_type_node(arena, child_at(arena, id, offset), source))
            offset += 1
        return self.generic_from_args(TypeKind.NAMED, base.value_start, base.value_length, args)

    def resolve_callable_type_node(self: &TypeTable, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, is_closure: bool) -> TypeId:
        node = arena.nodes[id.index]
        args: List[TypeId] = []
        offset: i32 = 0
        environment = type_error()
        if is_closure and node.child_count > 0:
            environment = self.resolve_type_node(arena, child_at(arena, id, 0), source)
            offset = 1
        parameter_end = node.child_count
        return_type = type_void()
        if callable_type_has_return(source, &node) and parameter_end > offset:
            parameter_end -= 1
            return_type = self.resolve_type_node(arena, child_at(arena, id, parameter_end), source)
        while offset < parameter_end:
            args.append(self.resolve_type_node(arena, child_at(arena, id, offset), source))
            offset += 1
        if is_closure:
            return self.closure_from_args(environment, args, return_type)
        return self.function_from_args(args, return_type)


def missing_type() -> TypeId:
    return TypeId(index=-1)


def is_map_view_kind(kind: TypeKind) -> bool:
    return kind == TypeKind.MAP_KEYS or kind == TypeKind.MAP_VALUES or kind == TypeKind.MAP_ITEMS


def is_nominal_kind(kind: TypeKind) -> bool:
    return kind == TypeKind.NAMED or kind == TypeKind.ENUM or kind == TypeKind.UNION or kind == TypeKind.VARIANT or kind == TypeKind.CLASS or kind == TypeKind.STRUCT or kind == TypeKind.FILE


def strip_const(table: &const TypeTable, type_id: TypeId) -> TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)) and table.types[current.index].kind == TypeKind.CONST:
        current = table.types[current.index].inner
    return current


def atomic_element_kind(table: &const TypeTable, type_id: TypeId, source: &const String) -> AtomicElementKind:
    current = strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return AtomicElementKind.INVALID
    record = table.types[current.index]
    if record.kind == TypeKind.BOOL:
        return AtomicElementKind.BOOL
    if record.kind != TypeKind.NAMED or record.flags != 0 or record.name_length == 0:
        return AtomicElementKind.INVALID
    if range_text_equals(source, record.name_start, record.name_length, "u32"):
        return AtomicElementKind.U32
    if range_text_equals(source, record.name_start, record.name_length, "u64"):
        return AtomicElementKind.U64
    if range_text_equals(source, record.name_start, record.name_length, "usize"):
        return AtomicElementKind.USIZE
    return AtomicElementKind.INVALID


def atomic_type_element_kind(table: &const TypeTable, type_id: TypeId) -> AtomicElementKind:
    current = strip_const(table, type_id)
    if current.index < 0 or current.index >= cast[i32](len(table.types)):
        return AtomicElementKind.INVALID
    record = table.types[current.index]
    if record.kind != TypeKind.ATOMIC and record.kind != TypeKind.ATOMIC_COMPARE_EXCHANGE_RESULT:
        return AtomicElementKind.INVALID
    if record.extra == cast[i32](AtomicElementKind.BOOL):
        return AtomicElementKind.BOOL
    if record.extra == cast[i32](AtomicElementKind.U32):
        return AtomicElementKind.U32
    if record.extra == cast[i32](AtomicElementKind.U64):
        return AtomicElementKind.U64
    if record.extra == cast[i32](AtomicElementKind.USIZE):
        return AtomicElementKind.USIZE
    return AtomicElementKind.INVALID


def atomic_element_is_integer(kind: AtomicElementKind) -> bool:
    return kind == AtomicElementKind.U32 or kind == AtomicElementKind.U64 or kind == AtomicElementKind.USIZE


def is_atomic_type(table: &const TypeTable, type_id: TypeId) -> bool:
    current = strip_const(table, type_id)
    return current.index >= 0 and current.index < cast[i32](len(table.types)) and table.types[current.index].kind == TypeKind.ATOMIC


def new_type_table() -> TypeTable:
    records: List[TypeRecord] = []
    args: List[TypeId] = []
    table = TypeTable(types=records, type_args=args)
    table.primitive(TypeKind.ERROR)
    table.primitive(TypeKind.VOID)
    table.primitive(TypeKind.BOOL)
    table.primitive(TypeKind.I32)
    table.primitive(TypeKind.I64)
    table.primitive(TypeKind.F64)
    table.primitive(TypeKind.CHAR)
    table.primitive(TypeKind.STRING)
    table.primitive(TypeKind.STRING_BUILDER)
    table.primitive(TypeKind.CONVERT_ERROR)
    return table


def type_error() -> TypeId:
    return TypeId(index=0)


def type_void() -> TypeId:
    return TypeId(index=1)


def type_bool() -> TypeId:
    return TypeId(index=2)


def type_i32() -> TypeId:
    return TypeId(index=3)


def type_i64() -> TypeId:
    return TypeId(index=4)


def type_f64() -> TypeId:
    return TypeId(index=5)


def type_char() -> TypeId:
    return TypeId(index=6)


def type_string() -> TypeId:
    return TypeId(index=7)


def type_string_builder() -> TypeId:
    return TypeId(index=8)


def type_convert_error() -> TypeId:
    return TypeId(index=9)


def first_child(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    return child_at(arena, id, 0)


def child_at(arena: &const syntax.SyntaxArena, id: NodeId, offset: i32) -> NodeId:
    if id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[id.index]
    if offset < 0 or offset >= node.child_count:
        return syntax.missing_node()
    return arena.children[node.first_child + offset]


def array_length_from_node(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> i32:
    length_id = child_at(arena, id, 1)
    if length_id.index < 0:
        return 0
    node = arena.nodes[length_id.index]
    value: i32 = 0
    offset: usize = 0
    while offset < node.value_length:
        byte = source.byte_at(node.value_start + offset)
        if byte >= 48 and byte <= 57:
            value = value * 10 + cast[i32](byte - 48)
        offset += 1
    return value


def callable_type_has_return(source: &const String, node: &const syntax.SyntaxNode) -> bool:
    offset = node.start
    end = node.start + node.length
    paren_depth: i32 = 0
    bracket_depth: i32 = 0
    while offset + 1 < end:
        if source[offset:offset + 1] == "#":
            while offset < end and not (source[offset:offset + 1] == "\n"):
                offset += 1
            continue
        if paren_depth == 0 and bracket_depth == 0 and source[offset:offset + 2] == "->":
            return true
        if source[offset:offset + 1] == "(":
            paren_depth += 1
        if source[offset:offset + 1] == ")":
            paren_depth -= 1
        if source[offset:offset + 1] == "[":
            bracket_depth += 1
        if source[offset:offset + 1] == "]":
            bracket_depth -= 1
        offset += 1
    return false


def range_text_equals(source: &const String, start: usize, length: usize, text: String) -> bool:
    if length != len(text):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true
