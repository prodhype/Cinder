import types
from syntax import NodeId
from types import TypeId


enum OwnershipKind:
    COPYABLE
    MOVE_ONLY
    BORROWED


struct CleanupRecord:
    node: NodeId
    type_id: TypeId
    flags: i32


struct OwnershipState:
    cleanups: List[CleanupRecord]
    moved_nodes: List[NodeId]

    def register_cleanup(self: &OwnershipState, node: NodeId, type_id: TypeId) -> void:
        if type_needs_drop(type_id):
            self.cleanups.append(CleanupRecord(node=node, type_id=type_id, flags=0))

    def mark_moved(self: &OwnershipState, node: NodeId) -> void:
        self.moved_nodes.append(node)

    def is_moved(self: &const OwnershipState, node: NodeId) -> bool:
        index: usize = 0
        while index < len(self.moved_nodes):
            if self.moved_nodes[index].index == node.index:
                return true
            index += 1
        return false


def new_ownership_state() -> OwnershipState:
    cleanups: List[CleanupRecord] = []
    moved_nodes: List[NodeId] = []
    return OwnershipState(cleanups=cleanups, moved_nodes=moved_nodes)


def ownership_kind(table: &const types.TypeTable, type_id: TypeId) -> OwnershipKind:
    if type_id.index < 0:
        return OwnershipKind.COPYABLE
    record = table.types[type_id.index]
    if record.kind == types.TypeKind.POINTER or record.kind == types.TypeKind.REFERENCE or record.kind == types.TypeKind.DYN or types.is_map_view_kind(record.kind):
        return OwnershipKind.BORROWED
    if type_needs_drop_record(table, record):
        return OwnershipKind.MOVE_ONLY
    return OwnershipKind.COPYABLE


def type_needs_drop(type_id: TypeId) -> bool:
    if type_id.index < 0:
        return false
    kind_index = type_id.index
    return kind_index == types.type_string().index or kind_index == types.type_string_builder().index


def type_needs_drop_for_table(table: &const types.TypeTable, type_id: TypeId) -> bool:
    if type_id.index < 0:
        return false
    return type_needs_drop_record(table, table.types[type_id.index])


def type_needs_drop_record(table: &const types.TypeTable, record: types.TypeRecord) -> bool:
    if record.kind == types.TypeKind.STRING or record.kind == types.TypeKind.STRING_BUILDER or record.kind == types.TypeKind.OWNED or record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.MAP or record.kind == types.TypeKind.SET or record.kind == types.TypeKind.FILE:
        return true
    if record.kind == types.TypeKind.CONST:
        return type_needs_drop_for_table(table, record.inner)
    if record.kind == types.TypeKind.CLOSURE:
        return type_needs_drop_for_table(table, record.second)
    if record.kind == types.TypeKind.OPTION or record.kind == types.TypeKind.RESULT or record.kind == types.TypeKind.TUPLE:
        return true
    if record.kind == types.TypeKind.STRUCT or record.kind == types.TypeKind.CLASS:
        return true
    return false


def is_move_only(table: &const types.TypeTable, type_id: TypeId) -> bool:
    return ownership_kind(table, type_id) == OwnershipKind.MOVE_ONLY


def can_copy(table: &const types.TypeTable, type_id: TypeId) -> bool:
    return ownership_kind(table, type_id) == OwnershipKind.COPYABLE or ownership_kind(table, type_id) == OwnershipKind.BORROWED
