import codegen_access
import classes
import codegen_context
import codegen_format
import codegen_context as codegen_model
import codegen_names
import codegen_reflection
import codegen_specializations
import codegen_type_names
import project
import syntax
import token
import types
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_module_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    type_table: &const types.TypeTable = context.type_table
    node = arena.nodes[id.index]
    callee = codegen_names.first_child(arena, id)
    if callee.index >= 0:
        callee_node = arena.nodes[callee.index]
        callee_type = codegen_context.context_semantic_type(context, callee)
        if codegen_type_names.semantic_type_is_kind(type_table, callee_type, types.TypeKind.CLOSURE):
            emit_closure_call(arena, id, callee, source, builder, prefix, project_name, imports, context, callee_type, state, emit_nested)
            return
        if callee_node.kind == SyntaxKind.EXPR_NAME:
            name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
            if emit_reflection_call(arena, id, &name, source, builder, context, state, emit_nested):
                return
            if name == "closure":
                emit_closure_constructor(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "Ok" or name == "Err":
                if emit_result_constructor(arena, id, source, builder, prefix, project_name, imports, context, &name, state, emit_nested):
                    return
            if name == "Some":
                if emit_option_some(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested):
                    return
            if name == "String":
                emit_string_constructor(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "StringBuilder":
                builder.append("cinder_selfhost_string_builder_new()")
                return
            if name == "len":
                emit_len_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "print":
                codegen_format.emit_print_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "input":
                builder.append("cinder_selfhost_input_string(")
                emit_nested(state, codegen_names.first_call_argument(arena, id))
                builder.append(")")
                return
            if name == "parse_i32":
                builder.append("cinder_selfhost_parse_i32(")
                emit_nested(state, codegen_names.first_call_argument(arena, id))
                builder.append(")")
                return
            if name == "sort":
                emit_sort_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "free":
                builder.append("free(")
                emit_nested(state, codegen_names.first_call_argument(arena, id))
                builder.append(")")
                return
            if name == "open":
                codegen_access.emit_open_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            if name == "access":
                codegen_access.emit_access_call(arena, id, source, builder, prefix, project_name, imports, context, state, emit_nested)
                return
            else:
                if codegen_names.is_uppercase_start(source, callee_node.value_start):
                    emit_nominal_constructor(arena, id, source, builder, prefix, project_name, imports, &name, context, state, emit_nested)
                    return
                imported = codegen_names.find_import_member(imports, &name)
                if len(imported.module_name) > 0 and len(imported.member) > 0:
                    if project.is_builtin_module(&imported.module_name):
                        codegen_names.emit_builtin_function_name(builder, &imported.module_name, &imported.member)
                    else:
                        builder.append(codegen_names.c_prefix(project_name, &imported.module_name))
                        builder.append(imported.member)
                elif codegen_context.context_name_is_extern(context, &name) or codegen_context.context_has_name(context, source, callee_node.value_start, callee_node.value_length):
                    builder.append(name)
                else:
                    builder.append(prefix[0:len(prefix)])
                    builder.append(name)
                codegen_context.append_call_specialization_suffix(context, id, builder)
        if callee_node.kind == SyntaxKind.EXPR_ATTRIBUTE:
            if emit_variant_constructor(arena, id, callee, source, builder, prefix, project_name, imports, context, state, emit_nested):
                return
            codegen_access.emit_attribute_call(arena, id, callee, source, builder, prefix, project_name, imports, context, state, emit_nested)
            return
        if callee_node.kind != SyntaxKind.EXPR_NAME:
            emit_nested(state, callee)
    builder.append("(")
    emitted_argument = false
    argument_index: usize = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted_argument:
                builder.append(", ")
            arg = codegen_names.last_child(arena, child_id)
            dyn_interface = codegen_context.context_callee_dyn_parameter(arena, context, callee, source, argument_index)
            if dyn_interface >= 0:
                codegen_access.emit_dyn_conversion(arena, arg, dyn_interface, source, builder, context, state, emit_nested)
                emitted_argument = true
                argument_index += 1
                continue
            expected_type = codegen_context.context_callee_parameter_type(arena, context, callee, source, argument_index)
            arg_type = codegen_context.context_expression_type(arena, context, arg, source)
            if expected_type.index >= 0 and codegen_type_names.type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_SLICE and codegen_specializations.context_type_is_array(context.type_arena, arg_type):
                codegen_access.emit_array_as_list(arena, arg, arg_type, source, builder, prefix, project_name, imports, context, state, emit_nested)
                emitted_argument = true
                argument_index += 1
                continue
            if expected_type.index >= 0 and codegen_type_names.type_node_kind(context.type_arena, expected_type) == SyntaxKind.TYPE_SLICE and codegen_context.context_expression_is_collection(arena, context, arg, source, "List", types.TypeKind.LIST):
                builder.append("({ __auto_type cinder_slice_list = ")
                if not codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
                    builder.append("&")
                emit_nested(state, arg)
                builder.append("; (CinderList){ .data = (void *)cinder_slice_list->data, .length = cinder_slice_list->length, .capacity = 0 }; })")
                emitted_argument = true
                argument_index += 1
                continue
            borrow_argument = codegen_context.should_borrow_named_argument(arena, context, arg, source)
            if not borrow_argument:
                borrow_argument = codegen_context.should_borrow_for_callee(arena, context, callee, arg, source, argument_index)
            if borrow_argument and not codegen_context.call_is_name(arena, callee, source, "dump_summary"):
                builder.append("&")
            previous_expected = context.expected_type
            if expected_type.index >= 0:
                context.expected_type = expected_type
            emit_nested(state, arg)
            context.expected_type = previous_expected
            if not borrow_argument:
                codegen_context.mark_context_expression_moved(arena, context, arg, source)
            emitted_argument = true
            argument_index += 1
    builder.append(")")
    return


def emit_reflection_call(
    arena: &const SyntaxArena,
    id: NodeId,
    name: &const String,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    is_query = name == "field_count" or name == "method_count" or name == "has_field" or name == "has_method" or name == "implements"
    is_runtime = name == "type_info" or name == "type_name" or name == "fields"
    if not is_query and not is_runtime and not (name == "fields_of"):
        return false
    model: &const codegen_reflection.ProjectReflectionModel = context.reflection_model
    class_model: &const classes.ProjectClassModel = context.class_model
    if name == "fields_of":
        builder.append("0")
        return true
    if is_query:
        left = codegen_names.first_call_argument(arena, id)
        nominal_index = reflection_nominal_for_type_expression(arena, left, source, context)
        if name == "implements":
            right = codegen_names.second_call_argument(arena, id)
            right_index = reflection_nominal_for_type_expression(arena, right, source, context)
            value = false
            if nominal_index >= 0 and right_index >= 0:
                source_nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[cast[usize](nominal_index)]
                target_nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[cast[usize](right_index)]
                if source_nominal.class_index >= 0 and target_nominal.class_index >= 0:
                    value = classes.class_implements(class_model, source_nominal.class_index, target_nominal.class_index)
            if value:
                builder.append("true")
            else:
                builder.append("false")
            return true
        if name == "field_count":
            codegen_type_names.append_specialization_decimal(builder, cast[usize](codegen_reflection.effective_field_count(model, class_model, nominal_index)))
            return true
        if name == "method_count":
            codegen_type_names.append_specialization_decimal(builder, cast[usize](codegen_reflection.effective_method_count(model, class_model, nominal_index)))
            return true
        member_argument = codegen_names.second_call_argument(arena, id)
        member_name = reflection_string_literal(arena, member_argument, source)
        value = false
        if name == "has_field":
            value = codegen_reflection.has_effective_field(model, class_model, nominal_index, &member_name)
        else:
            value = codegen_reflection.has_effective_method(model, class_model, nominal_index, &member_name)
        if value:
            builder.append("true")
        else:
            builder.append("false")
        return true
    argument = codegen_names.first_call_argument(arena, id)
    dyn_interface = codegen_context.context_expression_dyn_interface(arena, context, argument, source)
    if dyn_interface >= 0:
        emit_dynamic_reflection_call(arena, argument, name, source, builder, context, dyn_interface, state, emit_nested)
        return true
    nominal_index = reflection_nominal_for_value_expression(arena, argument, source, context)
    if nominal_index < 0:
        if name == "type_name":
            builder.append("cinder_string_from_cstr(\"value\")")
            return true
        if name == "fields":
            builder.append("((CinderList){ .data = NULL, .length = 0, .capacity = 0 })")
            return true
        builder.append("NULL")
        return true
    nominal: &const codegen_reflection.ReflectionNominalInfo = &model.nominals[cast[usize](nominal_index)]
    builder.append("({ (void)(")
    emit_nested(state, argument)
    builder.append("); ")
    if name == "type_name":
        builder.append("cinder_string_from_cstr(\"")
        builder.append(nominal.name[0:len(nominal.name)])
        builder.append("\"); })")
        return true
    if name == "type_info":
        builder.append("&")
        codegen_reflection.append_type_info_name(builder, nominal)
        builder.append("; })")
        return true
    builder.append("(CinderList){ .data = (void *)")
    codegen_reflection.append_type_info_name(builder, nominal)
    builder.append(".fields, .length = ")
    codegen_reflection.append_type_info_name(builder, nominal)
    builder.append(".field_count, .capacity = 0 }")
    builder.append("; })")
    return true


def emit_dynamic_reflection_call(
    arena: &const SyntaxArena,
    argument: NodeId,
    name: &const String,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    interface_index: i32,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    class_model: &const classes.ProjectClassModel = context.class_model
    interface: &const classes.ClassInfo = &class_model.classes[cast[usize](interface_index)]
    temporary_index = context.temporary_index
    context.temporary_index += 1
    builder.append("({ CinderDyn_")
    builder.append(interface.c_name[0:len(interface.c_name)])
    builder.append(" cinder_reflect_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(" = ")
    emit_nested(state, argument)
    builder.append("; const CinderTypeInfo *cinder_reflect_info = cinder_reflect_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](temporary_index))
    builder.append(".vtable->type_info; ")
    if name == "type_name":
        builder.append("cinder_string_from_cstr(cinder_reflect_info->name)")
        builder.append("; })")
        return
    if name == "type_info":
        builder.append("cinder_reflect_info")
        builder.append("; })")
        return
    builder.append("(CinderList){ .data = (void *)cinder_reflect_info->fields, .length = cinder_reflect_info->field_count, .capacity = 0 }")
    builder.append("; })")


def reflection_nominal_for_type_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    context: &codegen_model.ModuleCodegenContext,
) -> i32:
    if id.index < 0:
        return -1
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_NAME:
        name = source[node.value_start:node.value_start + node.value_length]
        return codegen_reflection.find_nominal_for_name(context.reflection_model, context.imports, &context.module_name, &name)
    if node.kind == SyntaxKind.EXPR_ATTRIBUTE:
        receiver = codegen_names.first_child(arena, id)
        member = codegen_names.second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            alias = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
            imported = codegen_names.find_import_alias(context.imports, &alias)
            if len(imported.module_name) > 0:
                name = source[member_node.value_start:member_node.value_start + member_node.value_length]
                return codegen_reflection.find_nominal(context.reflection_model, &imported.module_name, &name)
    return -1


def reflection_nominal_for_value_expression(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    context: &codegen_model.ModuleCodegenContext,
) -> i32:
    class_model: &const classes.ProjectClassModel = context.class_model
    class_index = codegen_context.context_expression_class(arena, context, id, source)
    if class_index >= 0:
        class_info: &const classes.ClassInfo = &class_model.classes[cast[usize](class_index)]
        return codegen_reflection.find_nominal(context.reflection_model, &class_info.module_name, &class_info.name)
    type_id = codegen_context.context_expression_type(arena, context, id, source)
    owner = codegen_type_names.context_type_owner_name(context.type_arena, type_id, context.type_source)
    if len(owner) > 0:
        return codegen_reflection.find_nominal_for_name(context.reflection_model, context.imports, &context.module_name, &owner)
    if id.index >= 0 and arena.nodes[id.index].kind == SyntaxKind.EXPR_CALL:
        callee = codegen_names.first_child(arena, id)
        if callee.index >= 0 and arena.nodes[callee.index].kind == SyntaxKind.EXPR_NAME:
            callee_node = arena.nodes[callee.index]
            name = source[callee_node.value_start:callee_node.value_start + callee_node.value_length]
            return codegen_reflection.find_nominal_for_name(context.reflection_model, context.imports, &context.module_name, &name)
    return -1


def reflection_string_literal(arena: &const SyntaxArena, id: NodeId, source: &const String) -> String:
    if id.index < 0:
        return ""
    node = arena.nodes[id.index]
    if node.kind != SyntaxKind.EXPR_LITERAL or node.value_length <= 2:
        return ""
    return source[node.value_start + 1:node.value_start + node.value_length - 1]


def emit_closure_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    type_table: &const types.TypeTable = context.type_table
    closure_type = codegen_context.context_semantic_type(context, id)
    if not codegen_type_names.semantic_type_is_kind(type_table, closure_type, types.TypeKind.CLOSURE):
        builder.append("0")
        return
    environment = codegen_names.call_argument_at(arena, id, 0)
    adapter = codegen_names.call_argument_at(arena, id, 1)
    builder.append("((")
    codegen_type_names.emit_semantic_c_type(type_table, closure_type, context.type_source, builder, prefix, project_name, imports, context.specialization_names)
    builder.append("){ .env = ")
    emit_nested(state, environment)
    builder.append(", .call = ")
    emit_nested(state, adapter)
    builder.append(" })")
    codegen_context.mark_context_expression_moved(arena, context, environment, source)


def emit_closure_call(
    arena: &const SyntaxArena,
    id: NodeId,
    callee: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    closure_type: types.TypeId,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    type_table: &const types.TypeTable = context.type_table
    temporary_index = context.temporary_index
    context.temporary_index += 1
    builder.append("({ __auto_type ")
    append_closure_temporary_name(builder, temporary_index)
    builder.append(" = &(")
    emit_nested(state, callee)
    builder.append("); ")
    append_closure_temporary_name(builder, temporary_index)
    builder.append("->call(&")
    append_closure_temporary_name(builder, temporary_index)
    builder.append("->env")
    call = arena.nodes[id.index]
    record = type_table.types[closure_type.index]
    argument_index: i32 = 0
    for offset in range(1, call.child_count):
        child_id = arena.children[call.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != SyntaxKind.EXPR_ARGUMENT:
            continue
        argument = codegen_names.last_child(arena, child_id)
        builder.append(", ")
        if argument_index < record.flags:
            parameter_type = type_table.type_args[cast[usize](record.extra + argument_index)]
            if codegen_type_names.semantic_type_is_kind(type_table, parameter_type, types.TypeKind.REFERENCE) and not codegen_context.context_expression_is_pointer_like(arena, context, argument, source):
                builder.append("&")
        emit_nested(state, argument)
        codegen_context.mark_context_expression_moved(arena, context, argument, source)
        argument_index += 1
    builder.append("); })")


def append_closure_temporary_name(builder: &StringBuilder, index: i32) -> void:
    builder.append("cinder_closure_")
    codegen_type_names.append_specialization_decimal(builder, cast[usize](index))


def emit_option_none(
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
) -> bool:
    option_type = context.expected_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, option_type, context.type_source, "Option"):
        option_type = context.current_return_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, option_type, context.type_source, "Option"):
        return false
    name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, option_type, context.type_source, &name_builder, prefix, project_name, imports, context.specialization_names)
    name = name_builder.finish()
    builder.append("((")
    builder.append(name[0:len(name)])
    builder.append("){ .tag = ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_None })")
    return true

def emit_option_some(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    option_type = context.expected_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, option_type, context.type_source, "Option"):
        option_type = context.current_return_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, option_type, context.type_source, "Option"):
        return false
    name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, option_type, context.type_source, &name_builder, prefix, project_name, imports, context.specialization_names)
    name = name_builder.finish()
    builder.append("((")
    builder.append(name[0:len(name)])
    builder.append("){ .tag = ")
    builder.append(name[0:len(name)])
    builder.append("_Tag_Some")
    argument = codegen_names.first_call_argument(arena, id)
    if argument.index >= 0:
        builder.append(", .data.value = ")
        previous_expected = context.expected_type
        payload_type = codegen_context.context_generic_argument(context.type_arena, option_type, 0)
        if payload_type.index >= 0:
            context.expected_type = payload_type
        emit_nested(state, argument)
        context.expected_type = previous_expected
    builder.append(" })")
    return true

def emit_result_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    constructor: &const String,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    result_type = context.expected_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, result_type, context.type_source, "Result"):
        result_type = context.current_return_type
    if not codegen_context.context_type_is_runtime_generic(context.type_arena, result_type, context.type_source, "Result"):
        return false
    name_builder = StringBuilder()
    codegen_type_names.emit_specialized_type_name(context.type_arena, result_type, context.type_source, &name_builder, prefix, project_name, imports, context.specialization_names)
    name = name_builder.finish()
    is_ok = constructor == "Ok"
    builder.append("((")
    builder.append(name[0:len(name)])
    builder.append("){ .tag = ")
    builder.append(name[0:len(name)])
    if is_ok:
        builder.append("_Tag_Ok")
    else:
        builder.append("_Tag_Err")
    argument = codegen_names.first_call_argument(arena, id)
    payload_type = codegen_context.context_generic_argument(context.type_arena, result_type, 0)
    if not is_ok:
        payload_type = codegen_context.context_generic_argument(context.type_arena, result_type, 1)
    if argument.index >= 0 and not codegen_type_names.context_type_name_equals(context.type_arena, payload_type, context.type_source, "void"):
        if is_ok:
            builder.append(", .data.ok = ")
        else:
            builder.append(", .data.err = ")
        previous_expected = context.expected_type
        context.expected_type = payload_type
        emit_nested(state, argument)
        context.expected_type = previous_expected
    builder.append(" })")
    return true

def emit_variant_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    callee: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> bool:
    owner = codegen_names.first_child(arena, callee)
    member = codegen_names.second_child(arena, callee)
    if owner.index < 0 or member.index < 0:
        return false
    member_node = arena.nodes[member.index]
    if member_node.kind != SyntaxKind.NAME:
        return false
    case_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    nominal_index = codegen_reflection.find_expression_nominal(context.reflection_model, imports, &context.module_name, arena, owner, source)
    if nominal_index < 0 or codegen_reflection.nominal_kind_at(context.reflection_model, nominal_index) != codegen_reflection.ReflectionNominalKind.VARIANT:
        return false
    case_index = codegen_reflection.find_variant_case(context.reflection_model, nominal_index, &case_name)
    if case_index < 0:
        return false
    variant_builder = StringBuilder()
    expected_type = context.expected_type
    if expected_type.index >= 0 and arena.nodes[expected_type.index].kind == SyntaxKind.TYPE_GENERIC:
        expected_owner = codegen_type_names.context_type_owner_name(context.type_arena, expected_type, context.type_source)
        nominal_name = codegen_reflection.nominal_name_at(context.reflection_model, nominal_index)
        if codegen_reflection.text_equals(&expected_owner, &nominal_name):
            codegen_context.emit_context_c_type(arena, expected_type, source, &variant_builder, prefix, project_name, imports, context)
    variant_name = variant_builder.finish()
    if len(variant_name) == 0:
        variant_name = codegen_reflection.nominal_c_name_at(context.reflection_model, nominal_index)
    local_case = syntax.missing_node()
    nominal_module = codegen_reflection.nominal_module_name_at(context.reflection_model, nominal_index)
    if codegen_reflection.text_equals(&nominal_module, &context.module_name):
        nominal_name = codegen_reflection.nominal_name_at(context.reflection_model, nominal_index)
        local_variant = codegen_names.find_module_variant_declaration(context.type_arena, context.root, context.type_source, &nominal_name)
        local_case = codegen_names.find_variant_case_declaration(context.type_arena, local_variant, context.type_source, &case_name)
    builder.append("((")
    builder.append(variant_name[0:len(variant_name)])
    builder.append("){ .tag = ")
    builder.append(variant_name[0:len(variant_name)])
    builder.append("_")
    builder.append(case_name[0:len(case_name)])
    emitted_payload = false
    field_count = codegen_reflection.variant_case_field_count_at(context.reflection_model, case_index)
    for field_offset in range(0, field_count):
        metadata_field = codegen_reflection.variant_field_at(context.reflection_model, case_index, field_offset)
        if metadata_field < 0:
            continue
        field_name = codegen_reflection.variant_field_name_at(context.reflection_model, metadata_field)
        argument = codegen_names.call_argument_at(arena, id, field_offset)
        if argument.index >= 0:
            if not emitted_payload:
                builder.append(", .data.")
                builder.append(case_name[0:len(case_name)])
                builder.append(" = { ")
            else:
                builder.append(", ")
            builder.append(".")
            builder.append(field_name[0:len(field_name)])
            builder.append(" = ")
            previous_expected = context.expected_type
            local_field = local_variant_field_at(arena, local_case, field_offset)
            if local_field.index >= 0:
                context.expected_type = codegen_type_names.find_child_type(context.type_arena, local_field)
            emit_nested(state, argument)
            context.expected_type = previous_expected
            emitted_payload = true
    if emitted_payload:
        builder.append(" }")
    builder.append(" })")
    return true


def local_variant_field_at(arena: &const SyntaxArena, case_id: NodeId, wanted: i32) -> NodeId:
    if case_id.index < 0:
        return syntax.missing_node()
    node = arena.nodes[case_id.index]
    seen: i32 = 0
    for offset in range(0, node.child_count):
        field_id = arena.children[node.first_child + offset]
        if arena.nodes[field_id.index].kind != SyntaxKind.FIELD_DECL:
            continue
        if seen == wanted:
            return field_id
        seen += 1
    return syntax.missing_node()


def emit_nominal_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    name: &const String,
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    imported = codegen_names.find_import_member(imports, name)
    class_module = context.module_name[0:len(context.module_name)]
    if len(imported.module_name) > 0 and len(imported.member) > 0:
        class_module = imported.module_name[0:len(imported.module_name)]
    class_index = classes.find_class(context.class_model, &class_module, name)
    if class_index >= 0:
        emit_class_constructor_call(arena, id, source, builder, context, class_index, state, emit_nested)
        return
    specialized_builder = StringBuilder()
    expected_type = context.expected_type
    if expected_type.index >= 0 and arena.nodes[expected_type.index].kind == SyntaxKind.TYPE_GENERIC:
        expected_base = codegen_names.first_child(arena, expected_type)
        if expected_base.index >= 0 and codegen_names.range_text_equals(source, arena.nodes[expected_base.index].value_start, arena.nodes[expected_base.index].value_length, name[0:len(name)]):
            codegen_context.emit_context_c_type(arena, expected_type, source, &specialized_builder, prefix, project_name, imports, context)
    specialized_name = specialized_builder.finish()
    builder.append("(")
    if len(specialized_name) > 0:
        builder.append(specialized_name[0:len(specialized_name)])
    elif len(imported.module_name) > 0 and len(imported.member) > 0:
        builder.append(codegen_names.c_prefix(project_name, &imported.module_name))
        builder.append(imported.member)
    else:
        builder.append(prefix[0:len(prefix)])
        builder.append(name[0:len(name)])
    builder.append("){")
    node = arena.nodes[id.index]
    emitted = false
    positional_index: i32 = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.EXPR_ARGUMENT:
            if emitted:
                builder.append(", ")
            named = codegen_names.first_child(arena, child_id)
            field_type = syntax.missing_node()
            if child.flags == 1 and named.index >= 0:
                named_node = arena.nodes[named.index]
                builder.append(".")
                codegen_names.append_source(builder, source, named_node.value_start, named_node.value_length)
                builder.append(" = ")
                field_name = source[named_node.value_start:named_node.value_start + named_node.value_length]
                field_type = codegen_context.context_field_type(context, name, &field_name)
            else:
                field_type = codegen_context.context_field_type_at(context, name, positional_index)
                positional_index += 1
            value = codegen_names.last_child(arena, child_id)
            previous_expected = context.expected_type
            if field_type.index >= 0:
                context.expected_type = field_type
            emit_nested(state, value)
            context.expected_type = previous_expected
            codegen_context.mark_context_expression_moved(arena, context, value, source)
            emitted = true
    builder.append("}")


def emit_class_constructor_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    context: &codegen_model.ModuleCodegenContext,
    class_index: i32,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    model: &const classes.ProjectClassModel = context.class_model
    class_info: &const classes.ClassInfo = &model.classes[cast[usize](class_index)]
    builder.append(class_info.c_name[0:len(class_info.c_name)])
    builder.append("__new(")
    node = arena.nodes[id.index]
    emitted = false
    argument_index: usize = 0
    for offset in range(1, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != SyntaxKind.EXPR_ARGUMENT:
            continue
        if emitted:
            builder.append(", ")
        argument = codegen_names.last_child(arena, child_id)
        previous_expected = context.expected_type
        expected_type = codegen_context.context_class_constructor_parameter_type(context, class_index, argument_index)
        if expected_type.index >= 0:
            context.expected_type = expected_type
        emit_nested(state, argument)
        context.expected_type = previous_expected
        codegen_context.mark_context_expression_moved(arena, context, argument, source)
        emitted = true
        argument_index += 1
    builder.append(")")

def emit_string_constructor(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg = codegen_names.first_call_argument(arena, id)
    builder.append("cinder_string_from_cstr(")
    codegen_access.emit_c_string_argument(arena, arg, source, builder, prefix, project_name, imports, context, state, emit_nested)
    builder.append(")")

def emit_len_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg = codegen_names.first_call_argument(arena, id)
    arg_type = codegen_context.context_expression_type(arena, context, arg, source)
    if codegen_specializations.context_type_is_array(context.type_arena, arg_type):
        length = codegen_specializations.array_length_node(context.type_arena, arg_type)
        codegen_specializations.append_node_numeric_literal(builder, context.type_arena, context.type_source, length)
        return
    table: &const types.TypeTable = context.type_table
    semantic_arg_type = len_strip_semantic_indirection(table, codegen_context.context_semantic_type(context, arg))
    if semantic_arg_type.index >= 0 and semantic_arg_type.index < cast[i32](len(table.types)) and types.is_map_view_kind(table.types[semantic_arg_type.index].kind):
        builder.append("({ __auto_type cinder_view = ")
        emit_nested(state, arg)
        builder.append("; cinder_view.map == NULL ? 0 : cinder_view.map->length; })")
        return
    if codegen_context.context_expression_is_collection(arena, context, arg, source, "Map", types.TypeKind.MAP):
        codegen_context.emit_context_expression_specialization_name(arena, context, arg, source, builder, prefix, project_name, imports, "Map", types.TypeKind.MAP)
        builder.append("_len(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("&")
        emit_nested(state, arg)
        builder.append(")")
        return
    if codegen_context.context_expression_is_collection(arena, context, arg, source, "Set", types.TypeKind.SET):
        codegen_context.emit_context_expression_specialization_name(arena, context, arg, source, builder, prefix, project_name, imports, "Set", types.TypeKind.SET)
        builder.append("_len(")
        if not codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
            builder.append("&")
        emit_nested(state, arg)
        builder.append(")")
        return
    emit_nested(state, arg)
    if codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("->length")
    else:
        builder.append(".length")


def len_strip_semantic_indirection(table: &const types.TypeTable, type_id: types.TypeId) -> types.TypeId:
    current = type_id
    while current.index >= 0 and current.index < cast[i32](len(table.types)):
        kind = table.types[current.index].kind
        if kind != types.TypeKind.CONST and kind != types.TypeKind.REFERENCE and kind != types.TypeKind.POINTER:
            break
        current = table.types[current.index].inner
    return current

def emit_sort_call(
    arena: &const SyntaxArena,
    id: NodeId,
    source: &const String,
    builder: &StringBuilder,
    prefix: &const String,
    project_name: &const String,
    imports: &const List[project.ImportBinding],
    context: &codegen_model.ModuleCodegenContext,
    state: &codegen_model.ModuleExpressionState,
    emit_nested: def(&codegen_model.ModuleExpressionState, NodeId) -> void,
) -> void:
    arg = codegen_names.first_call_argument(arena, id)
    element_type = codegen_context.context_expression_list_element_type(arena, context, arg, source)
    builder.append("({ __auto_type cinder_sort_list = ")
    if not codegen_context.context_expression_is_pointer_like(arena, context, arg, source):
        builder.append("&")
    emit_nested(state, arg)
    builder.append("; ")
    if codegen_type_names.context_type_name_equals(context.type_arena, element_type, context.type_source, "String"):
        builder.append("cinder_selfhost_sort_string(")
    else:
        builder.append("cinder_selfhost_sort_i32(")
    builder.append("cinder_sort_list->data, cinder_sort_list->length); })")
