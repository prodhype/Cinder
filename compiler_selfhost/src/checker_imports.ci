import checker_core
import diagnostics
import project
import semantic
import symbols
import syntax
import types
from syntax import NodeId


def validate_import_member_calls(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    collect_imported_atomic_types(checker, arena, root, source, imports, modules)
    collect_qualified_import_enum_names(checker, imports, modules)
    validate_from_import_members_in_node(checker, arena, root, source, modules)
    validate_import_member_calls_in_node(checker, arena, root, source, imports, modules)


def collect_imported_atomic_types(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    root: NodeId,
    source: &const String,
    imports: &const List[project.ImportBinding],
    modules: &const List[project.ParsedModule],
) -> void:
    for imported in imports:
        if len(imported.member) == 0:
            continue
        is_atomic_template = imported_member_is_atomic_template(&imported.module_name, &imported.member, modules)
        atomic_type = types.missing_type()
        if is_atomic_template:
            atomic_type = checker.type_table.atomic_of(types.type_error(), types.AtomicElementKind.INVALID)
        else:
            atomic_type = imported_member_atomic_type(checker, &imported.module_name, &imported.member, modules)
        if atomic_type.index < 0:
            continue
        symbol_index: usize = 0
        while symbol_index < len(checker.symbols.symbols):
            symbol = checker.symbols.symbols[symbol_index]
            if symbol.scope.index == symbols.root_scope().index and checker_core.range_text_equals(source, symbol.name_start, symbol.name_length, imported.alias[0:len(imported.alias)]):
                checker.symbols.symbols[symbol_index].type_id = atomic_type
                if is_atomic_template:
                    checker.symbols.symbols[symbol_index].kind = symbols.SymbolKind.BUILTIN
            symbol_index += 1
    collect_qualified_atomic_types_in_node(checker, arena, root, source, imports, modules)


def collect_qualified_atomic_types_in_node(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    imports: &const List[project.ImportBinding],
    modules: &const List[project.ParsedModule],
) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        receiver = checker_core.first_child(arena, id)
        member = checker_core.second_child(arena, id)
        if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == syntax.SyntaxKind.EXPR_NAME:
            receiver_node = arena.nodes[receiver.index]
            member_node = arena.nodes[member.index]
            for imported in imports:
                if len(imported.member) == 0 and checker_core.range_text_equals(source, receiver_node.value_start, receiver_node.value_length, imported.alias[0:len(imported.alias)]):
                    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
                    atomic_type = imported_member_atomic_type(checker, &imported.module_name, &member_name, modules)
                    if atomic_type.index >= 0:
                        checker.model.record_expr_type(id, atomic_type)
    elif node.kind == syntax.SyntaxKind.EXPR_CALL:
        callee = checker_core.first_child(arena, id)
        if callee.index >= 0 and arena.nodes[callee.index].kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
            receiver = checker_core.first_child(arena, callee)
            member = checker_core.second_child(arena, callee)
            if receiver.index >= 0 and member.index >= 0 and arena.nodes[receiver.index].kind == syntax.SyntaxKind.EXPR_NAME:
                receiver_node = arena.nodes[receiver.index]
                member_node = arena.nodes[member.index]
                for imported in imports:
                    if len(imported.member) == 0 and checker_core.range_text_equals(source, receiver_node.value_start, receiver_node.value_length, imported.alias[0:len(imported.alias)]):
                        member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
                        return_type = imported_function_atomic_return_type(checker, &imported.module_name, &member_name, modules)
                        if return_type.index >= 0:
                            checker.model.record_expr_type(id, return_type)
    for offset in range(0, node.child_count):
        collect_qualified_atomic_types_in_node(checker, arena, arena.children[node.first_child + offset], source, imports, modules)


def imported_member_atomic_type(
    checker: &checker_core.Checker,
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> types.TypeId:
    return imported_declaration_atomic_type(checker, module_name, member_name, syntax.SyntaxKind.GLOBAL_DECL, modules)


def imported_function_atomic_return_type(
    checker: &checker_core.Checker,
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> types.TypeId:
    return imported_declaration_atomic_type(checker, module_name, member_name, syntax.SyntaxKind.FUNCTION_DECL, modules)


def imported_declaration_atomic_type(
    checker: &checker_core.Checker,
    module_name: &const String,
    member_name: &const String,
    declaration_kind: syntax.SyntaxKind,
    modules: &const List[project.ParsedModule],
) -> types.TypeId:
    for module in modules:
        if not (module.name == module_name[0:len(module_name)]):
            continue
        module_arena: &const syntax.SyntaxArena = &module.arena
        declaration = find_exported_declaration(module_arena, module.root, &module.source, member_name)
        if declaration.index < 0 or module_arena.nodes[declaration.index].kind != declaration_kind:
            return types.missing_type()
        annotation = checker_core.find_child_type(module_arena, declaration)
        if annotation.index < 0:
            return types.missing_type()
        return resolve_imported_atomic_annotation(checker, module_arena, annotation, &module.source, &module.imports, modules)
    return types.missing_type()


def resolve_imported_atomic_annotation(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    annotation: NodeId,
    source: &const String,
    imports: &const List[project.ImportBinding],
    modules: &const List[project.ParsedModule],
) -> types.TypeId:
    if annotation.index < 0:
        return types.missing_type()
    annotation_node = arena.nodes[annotation.index]
    if annotation_node.kind == syntax.SyntaxKind.TYPE_POINTER or annotation_node.kind == syntax.SyntaxKind.TYPE_REFERENCE or annotation_node.kind == syntax.SyntaxKind.TYPE_CONST:
        inner = resolve_imported_atomic_annotation(checker, arena, checker_core.first_child(arena, annotation), source, imports, modules)
        if inner.index < 0:
            return types.missing_type()
        if annotation_node.kind == syntax.SyntaxKind.TYPE_POINTER:
            return checker.type_table.pointer_to(inner)
        if annotation_node.kind == syntax.SyntaxKind.TYPE_REFERENCE:
            return checker.type_table.reference_to(inner)
        return checker.type_table.const_of(inner)
    if annotation_node.kind != syntax.SyntaxKind.TYPE_GENERIC or annotation_node.child_count != 2:
        return types.missing_type()
    base = checker_core.first_child(arena, annotation)
    argument = checker_core.second_child(arena, annotation)
    if base.index < 0 or argument.index < 0:
        return types.missing_type()
    if not atomic_type_import_matches(arena, base, source, imports, modules):
        return types.missing_type()
    element_type = checker.type_table.resolve_type_node(arena, argument, source)
    element_kind = types.atomic_element_kind(&checker.type_table, element_type, source)
    if element_kind == types.AtomicElementKind.INVALID:
        return types.missing_type()
    return checker.type_table.atomic_of(element_type, element_kind)


def atomic_type_import_matches(
    arena: &const syntax.SyntaxArena,
    base: NodeId,
    source: &const String,
    imports: &const List[project.ImportBinding],
    modules: &const List[project.ParsedModule],
) -> bool:
    if base.index < 0:
        return false
    base_node = arena.nodes[base.index]
    for imported in imports:
        if checker_core.range_text_equals(source, base_node.value_start, base_node.value_length, imported.alias[0:len(imported.alias)]):
            if base_node.child_count == 1:
                return imported_member_is_atomic_template(&imported.module_name, &imported.member, modules)
            if base_node.child_count == 2 and len(imported.member) == 0:
                leaf = arena.nodes[arena.children[base_node.first_child + 1].index]
                member_name = source[leaf.value_start:leaf.value_start + leaf.value_length]
                return imported_member_is_atomic_template(&imported.module_name, &member_name, modules)
    return false


def imported_member_is_atomic_template(
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> bool:
    if module_name == "std.atomic" and member_name == "Atomic" and project.module_name_is_virtual_builtin(module_name, modules):
        return true
    for module in modules:
        if not (module.name == module_name[0:len(module_name)]):
            continue
        module_imports: &const List[project.ImportBinding] = &module.imports
        for imported in module_imports:
            if imported.alias == member_name[0:len(member_name)] and len(imported.member) > 0:
                return imported_member_is_atomic_template(&imported.module_name, &imported.member, modules)
        return false
    return false


def imported_member_is_path_namespace(
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> bool:
    return module_name == "std.path" and member_name == "Path" and project.module_name_is_virtual_builtin(module_name, modules)


def imported_member_is_net_builtin(
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> bool:
    if module_name != "std.net" or not project.module_name_is_virtual_builtin(module_name, modules):
        return false
    return member_name == "AF_INET" or member_name == "AF_INET6" or member_name == "SOCK_STREAM" or member_name == "POLL_IN" or member_name == "POLL_OUT" or member_name == "POLL_ERROR" or member_name == "POLL_HANGUP" or member_name == "POLL_INVALID" or member_name == "Socket" or member_name == "PollFd" or member_name == "NetError" or member_name == "NetErrorKind" or member_name == "socket" or member_name == "poll"


def imported_member_is_lock(
    module_name: &const String,
    member_name: &const String,
    modules: &const List[project.ParsedModule],
) -> bool:
    for module in modules:
        if not (module.name == module_name[0:len(module_name)]):
            continue
        module_arena: &const syntax.SyntaxArena = &module.arena
        declaration = find_exported_declaration(module_arena, module.root, &module.source, member_name)
        return declaration.index >= 0 and module_arena.nodes[declaration.index].kind == syntax.SyntaxKind.LOCK_DECL
    return false


def collect_qualified_import_enum_names(checker: &checker_core.Checker, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    for imported in imports:
        if len(imported.member) > 0:
            continue
        for module in modules:
            if not (module.name == imported.module_name):
                continue
            collect_module_enum_names(checker, &module.arena, module.root, &module.source, &imported.alias)


def collect_module_enum_names(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, alias: &const String) -> void:
    if root.index < 0:
        return
    node = arena.nodes[root.index]
    for offset in range(0, node.child_count):
        declaration = arena.nodes[arena.children[node.first_child + offset].index]
        if declaration.kind == syntax.SyntaxKind.ENUM_DECL:
            name = source[declaration.value_start:declaration.value_start + declaration.value_length]
            record_imported_enum_name(checker, alias[0:len(alias)] + "." + name)


def record_imported_enum_name(checker: &checker_core.Checker, name: String) -> void:
    if checker_core.string_list_contains(&checker.imported_enum_names, &name):
        return
    checker.imported_enum_names.append(name[0:len(name)])


def validate_from_import_members_in_node(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, modules: &const List[project.ParsedModule]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.FROM_IMPORT_DECL:
        validate_from_import_members(checker, arena, id, source, modules)
    for offset in range(0, node.child_count):
        validate_from_import_members_in_node(checker, arena, arena.children[node.first_child + offset], source, modules)


def validate_from_import_members(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, modules: &const List[project.ParsedModule]) -> void:
    dotted = checker_core.find_child_kind(arena, id, syntax.SyntaxKind.DOTTED_NAME)
    if dotted.index < 0:
        return
    dotted_node = arena.nodes[dotted.index]
    module_name = source[dotted_node.start:dotted_node.start + dotted_node.length]
    if module_name == "std.path" and project.module_name_is_virtual_builtin(&module_name, modules):
        validate_path_import_members(checker, arena, id, source, &module_name, modules)
        return
    if module_name == "std.net" and project.module_name_is_virtual_builtin(&module_name, modules):
        validate_net_import_members(checker, arena, id, source, &module_name, modules)
        return
    module_index: i32 = -1
    index: i32 = 0
    for module in modules:
        if module.name == module_name:
            module_index = index
        index += 1
    if module_index < 0:
        return
    target_module: &const project.ParsedModule = &modules[cast[usize](module_index)]
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        import_id = arena.children[node.first_child + offset]
        imported = arena.nodes[import_id.index]
        if imported.kind == syntax.SyntaxKind.IMPORT_NAME:
            for item_offset in range(0, imported.child_count):
                name_id = arena.children[imported.first_child + item_offset]
                name_node = arena.nodes[name_id.index]
                if name_node.kind == syntax.SyntaxKind.NAME and name_node.flags != 1:
                    member_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
                    declaration = find_exported_declaration(&target_module.arena, target_module.root, &target_module.source, &member_name)
                    if declaration.index < 0:
                        if not imported_member_is_atomic_template(&module_name, &member_name, modules):
                            checker_core.emit_import_member_error(
                                checker,
                                &name_node,
                                module_name[0:len(module_name)],
                                member_name[0:len(member_name)],
                            )
                    elif exported_declaration_kind(&target_module.arena, declaration) == syntax.SyntaxKind.ENUM_DECL:
                        binding_id = name_id
                        for binding_offset in range(0, imported.child_count):
                            candidate_id = arena.children[imported.first_child + binding_offset]
                            candidate = arena.nodes[candidate_id.index]
                            if candidate.kind == syntax.SyntaxKind.NAME and candidate.flags == 1:
                                binding_id = candidate_id
                        binding = arena.nodes[binding_id.index]
                        found = checker.symbols.find_in_scope(source, symbols.root_scope(), binding.value_start, binding.value_length)
                        if found.index >= 0:
                            checker.symbols.symbols[found.index].kind = symbols.SymbolKind.ENUM
                        record_imported_enum_name(checker, source[binding.value_start:binding.value_start + binding.value_length])


def validate_path_import_members(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    module_name: &const String,
    modules: &const List[project.ParsedModule],
) -> void:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        import_id = arena.children[node.first_child + offset]
        imported = arena.nodes[import_id.index]
        if imported.kind != syntax.SyntaxKind.IMPORT_NAME:
            continue
        for item_offset in range(0, imported.child_count):
            name_id = arena.children[imported.first_child + item_offset]
            name_node = arena.nodes[name_id.index]
            if name_node.kind == syntax.SyntaxKind.NAME and name_node.flags != 1:
                member_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
                if not imported_member_is_path_namespace(module_name, &member_name, modules):
                    checker_core.emit_import_member_error(
                        checker,
                        &name_node,
                        module_name[0:len(module_name)],
                        member_name[0:len(member_name)],
                    )


def validate_net_import_members(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    module_name: &const String,
    modules: &const List[project.ParsedModule],
) -> void:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        import_id = arena.children[node.first_child + offset]
        imported = arena.nodes[import_id.index]
        if imported.kind != syntax.SyntaxKind.IMPORT_NAME:
            continue
        for item_offset in range(0, imported.child_count):
            name_id = arena.children[imported.first_child + item_offset]
            name_node = arena.nodes[name_id.index]
            if name_node.kind == syntax.SyntaxKind.NAME and name_node.flags != 1:
                member_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
                if not imported_member_is_net_builtin(module_name, &member_name, modules):
                    checker_core.emit_import_member_error(
                        checker,
                        &name_node,
                        module_name[0:len(module_name)],
                        member_name[0:len(member_name)],
                    )


def validate_import_member_calls_in_node(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        callee = checker_core.first_child(arena, id)
        if callee.index >= 0 and arena.nodes[callee.index].kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
            validate_import_member_call(checker, arena, id, callee, source, imports, modules)
    for offset in range(0, node.child_count):
        validate_import_member_calls_in_node(checker, arena, arena.children[node.first_child + offset], source, imports, modules)


def validate_import_member_call(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, call_id: NodeId, callee: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    receiver = checker_core.first_child(arena, callee)
    member = checker_core.second_child(arena, callee)
    if receiver.index < 0 or member.index < 0 or arena.nodes[receiver.index].kind != syntax.SyntaxKind.EXPR_NAME:
        return
    receiver_node = arena.nodes[receiver.index]
    member_node = arena.nodes[member.index]
    receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    import_index: i32 = -1
    index: i32 = 0
    for imported in imports:
        if imported.alias == receiver_name and len(imported.member) == 0:
            import_index = index
        index += 1
    if import_index < 0:
        return
    module_name = imports[cast[usize](import_index)].module_name[0:len(imports[cast[usize](import_index)].module_name)]
    module_index: i32 = -1
    index = 0
    for module in modules:
        if module.name == module_name:
            module_index = index
        index += 1
    if module_index < 0:
        return
    target_module: &const project.ParsedModule = &modules[cast[usize](module_index)]
    declaration = find_exported_declaration(&target_module.arena, target_module.root, &target_module.source, &member_name)
    if declaration.index < 0:
        checker_core.emit_import_member_error(
            checker,
            &member_node,
            module_name[0:len(module_name)],
            member_name[0:len(member_name)],
        )
        return
    declaration_kind = exported_declaration_kind(&target_module.arena, declaration)
    if declaration_kind != syntax.SyntaxKind.FUNCTION_DECL and declaration_kind != syntax.SyntaxKind.STRUCT_DECL and declaration_kind != syntax.SyntaxKind.CLASS_DECL and declaration_kind != syntax.SyntaxKind.ENUM_DECL and declaration_kind != syntax.SyntaxKind.UNION_DECL and declaration_kind != syntax.SyntaxKind.VARIANT_DECL:
        checker_core.emit_import_member_error(
            checker,
            &member_node,
            module_name[0:len(module_name)],
            member_name[0:len(member_name)],
        )
        return
    if declaration_kind != syntax.SyntaxKind.FUNCTION_DECL:
        return
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    expected = checker_core.count_direct_children(&target_module.arena, declaration, syntax.SyntaxKind.PARAMETER)
    call = arena.nodes[call_id.index]
    if actual < expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_078,
            &call,
            expected,
            actual,
        )
    elif actual > expected:
        checker_core.emit_argument_count_error(
            checker,
            diagnostics.DiagnosticId.CHECK_077,
            &call,
            expected,
            actual,
        )


def find_exported_declaration(arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, name: &const String) -> NodeId:
    node = arena.nodes[root.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if (child.kind == syntax.SyntaxKind.FUNCTION_DECL or child.kind == syntax.SyntaxKind.STRUCT_DECL or child.kind == syntax.SyntaxKind.CLASS_DECL or child.kind == syntax.SyntaxKind.ENUM_DECL or child.kind == syntax.SyntaxKind.UNION_DECL or child.kind == syntax.SyntaxKind.VARIANT_DECL or child.kind == syntax.SyntaxKind.GLOBAL_DECL or child.kind == syntax.SyntaxKind.LOCK_DECL) and source[child.value_start:child.value_start + child.value_length] == name:
            return child_id
    return syntax.missing_node()


def exported_declaration_kind(arena: &const syntax.SyntaxArena, declaration: NodeId) -> syntax.SyntaxKind:
    return arena.nodes[declaration.index].kind
