import checker_core
import lexer
import parser
import project
import syntax
from syntax import NodeId


def validate_import_member_calls(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    validate_from_import_members_in_node(checker, arena, root, source, modules)
    validate_import_member_calls_in_node(checker, arena, root, source, imports, modules)


def validate_from_import_members_in_node(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, modules: &const List[project.ParsedModule]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.FROM_IMPORT_DECL:
        validate_from_import_members(checker, arena, id, source, modules)
    for offset in range(0, node.child_count):
        validate_from_import_members_in_node(checker, arena, arena.children[node.first_child + offset], source, modules)


def validate_from_import_members(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, modules: &const List[project.ParsedModule]) -> void:
    dotted = checker_core.find_child_kind(arena, id, syntax.SyntaxKind.DOTTED_NAME)
    if dotted.index < 0:
        return
    dotted_node = arena.nodes[dotted.index]
    module_name = source[dotted_node.start:dotted_node.start + dotted_node.length]
    module_index: i32 = -1
    index: i32 = 0
    for module in modules:
        if module.name == module_name:
            module_index = index
        index += 1
    if module_index < 0:
        return
    module_source = modules[cast[usize](module_index)].source[0:len(modules[cast[usize](module_index)].source)]
    scan = lexer.new_lexer(module_source[0:len(module_source)])
    scan.tokenize()
    parsed = parser.new_parser(scan)
    module_root = parsed.parse_module()
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        import_id = arena.children[node.first_child + offset]
        imported = arena.nodes[import_id.index]
        if imported.kind == syntax.SyntaxKind.IMPORT_NAME:
            for item_offset in range(0, imported.child_count):
                name_id = arena.children[imported.first_child + item_offset]
                name_node = arena.nodes[name_id.index]
                if name_node.kind == syntax.SyntaxKind.NAME and name_node.flags != 1:
                    member_name = source[name_node.value_start:name_node.value_start + name_node.value_length]
                    if find_exported_declaration(parsed.arena, module_root, &module_source, &member_name).index < 0:
                        checker_core.emit_error(checker, 48, name_node.start, name_node.length, name_node.line, name_node.column)


def validate_import_member_calls_in_node(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_CALL:
        callee = checker_core.first_child(arena, id)
        if callee.index >= 0 and arena.nodes[callee.index].kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
            validate_import_member_call(checker, arena, id, callee, source, imports, modules)
    for offset in range(0, node.child_count):
        validate_import_member_calls_in_node(checker, arena, arena.children[node.first_child + offset], source, imports, modules)


def validate_import_member_call(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, call_id: NodeId, callee: NodeId, source: &const String, imports: &const List[project.ImportBinding], modules: &const List[project.ParsedModule]) -> void:
    receiver = checker_core.first_child(arena, callee)
    member = checker_core.second_child(arena, callee)
    if receiver.index < 0 or member.index < 0 or arena.nodes[receiver.index].kind != syntax.SyntaxKind.EXPR_NAME:
        return
    receiver_node = arena.nodes[receiver.index]
    member_node = arena.nodes[member.index]
    receiver_name = source[receiver_node.value_start:receiver_node.value_start + receiver_node.value_length]
    member_name = source[member_node.value_start:member_node.value_start + member_node.value_length]
    import_index: i32 = -1
    index: i32 = 0
    for imported in imports:
        if imported.alias == receiver_name and len(imported.member) == 0:
            import_index = index
        index += 1
    if import_index < 0:
        return
    module_name = imports[cast[usize](import_index)].module_name[0:len(imports[cast[usize](import_index)].module_name)]
    module_index: i32 = -1
    index = 0
    for module in modules:
        if module.name == module_name:
            module_index = index
        index += 1
    if module_index < 0:
        return
    module_source = modules[cast[usize](module_index)].source[0:len(modules[cast[usize](module_index)].source)]
    scan = lexer.new_lexer(module_source[0:len(module_source)])
    scan.tokenize()
    parsed = parser.new_parser(scan)
    module_root = parsed.parse_module()
    declaration = find_exported_declaration(parsed.arena, module_root, &module_source, &member_name)
    if declaration.index < 0:
        checker_core.emit_error(checker, 48, member_node.start, member_node.length, member_node.line, member_node.column)
        return
    declaration_kind = exported_declaration_kind(parsed.arena, declaration)
    if declaration_kind != syntax.SyntaxKind.FUNCTION_DECL and declaration_kind != syntax.SyntaxKind.STRUCT_DECL and declaration_kind != syntax.SyntaxKind.CLASS_DECL and declaration_kind != syntax.SyntaxKind.ENUM_DECL and declaration_kind != syntax.SyntaxKind.UNION_DECL and declaration_kind != syntax.SyntaxKind.VARIANT_DECL:
        checker_core.emit_error(checker, 48, member_node.start, member_node.length, member_node.line, member_node.column)
        return
    if declaration_kind != syntax.SyntaxKind.FUNCTION_DECL:
        return
    actual = checker_core.count_direct_children(arena, call_id, syntax.SyntaxKind.EXPR_ARGUMENT)
    expected = checker_core.count_direct_children(parsed.arena, declaration, syntax.SyntaxKind.PARAMETER)
    call = arena.nodes[call_id.index]
    if actual < expected:
        checker_core.emit_error(checker, 78, call.start, call.length, call.line, call.column)
    elif actual > expected:
        checker_core.emit_error(checker, 77, call.start, call.length, call.line, call.column)


def find_exported_declaration(arena: &const syntax.SyntaxArena, root: NodeId, source: &const String, name: &const String) -> NodeId:
    node = arena.nodes[root.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if (child.kind == syntax.SyntaxKind.FUNCTION_DECL or child.kind == syntax.SyntaxKind.STRUCT_DECL or child.kind == syntax.SyntaxKind.CLASS_DECL or child.kind == syntax.SyntaxKind.ENUM_DECL or child.kind == syntax.SyntaxKind.UNION_DECL or child.kind == syntax.SyntaxKind.VARIANT_DECL or child.kind == syntax.SyntaxKind.GLOBAL_DECL) and source[child.value_start:child.value_start + child.value_length] == name:
            return child_id
    return syntax.missing_node()


def exported_declaration_kind(arena: &const syntax.SyntaxArena, declaration: NodeId) -> syntax.SyntaxKind:
    return arena.nodes[declaration.index].kind
