import diagnostics
from token import BracketFrame, Token, TokenKind, token_kind_display


struct Lexer:
    source: String
    tokens: List[Token]
    diagnostic_values: List[diagnostics.Diagnostic]
    indent_stack: List[i32]
    brackets: List[BracketFrame]

    def emit_token(self: &Lexer, kind: TokenKind, start: usize, end: usize, line: i32, column: i32) -> void:
        self.tokens.append(Token(kind=kind, start=start, length=end - start, line=line, column=column))

    def emit_zero_token(self: &Lexer, kind: TokenKind, start: usize, line: i32, column: i32) -> void:
        self.tokens.append(Token(kind=kind, start=start, length=0, line=line, column=column))

    def emit_diagnostic(self: &Lexer, id: diagnostics.DiagnosticId, start: usize, length: usize, line: i32, column: i32) -> void:
        self.diagnostic_values.append(
            diagnostics.new_diagnostic(id, diagnostics.source_span(start, length, line, column))
        )

    def emit_actual_character_diagnostic(
        self: &Lexer,
        id: diagnostics.DiagnosticId,
        start: usize,
        length: usize,
        line: i32,
        column: i32,
        actual: char,
    ) -> void:
        self.diagnostic_values.append(
            diagnostics.diagnostic_with_argument(
                id,
                diagnostics.source_span(start, length, line, column),
                diagnostics.argument_character("actual", actual),
            )
        )

    def emit_expected_token_diagnostic(
        self: &Lexer,
        id: diagnostics.DiagnosticId,
        start: usize,
        length: usize,
        line: i32,
        column: i32,
        expected: TokenKind,
        actual: TokenKind,
    ) -> void:
        self.diagnostic_values.append(
            diagnostics.parser_expected_diagnostic(
                id,
                diagnostics.source_span(start, length, line, column),
                token_kind_display(expected),
                token_kind_display(actual),
            )
        )

    def emit_indentation(self: &Lexer, indentation: i32, line_number: i32, line_start: usize) -> void:
        current = self.indent_stack[len(self.indent_stack) - 1]
        length = cast[usize](indentation)
        if indentation > current:
            self.indent_stack.append(indentation)
            self.emit_token(TokenKind.INDENT, line_start, line_start + length, line_number, 1)
            return

        if indentation == current:
            return

        while len(self.indent_stack) > 1 and indentation < self.indent_stack[len(self.indent_stack) - 1]:
            self.indent_stack.pop()
            self.emit_token(TokenKind.DEDENT, line_start, line_start + length, line_number, 1)

        if indentation != self.indent_stack[len(self.indent_stack) - 1]:
            self.emit_diagnostic(diagnostics.DiagnosticId.LEX_004, line_start, length, line_number, 1)

    def tokenize(self: &Lexer) -> void:
        source_len = len(self.source)
        line_start: usize = 0
        line_number: i32 = 1
        line_count: i32 = 0
        explicit_continuation = false

        while line_start < source_len:
            line_count += 1
            line_end = line_start
            while line_end < source_len:
                byte = self.source.byte_at(line_end)
                if byte == 10 or byte == 13:
                    break
                line_end += 1

            next_line_start = line_end
            if next_line_start < source_len:
                if self.source.byte_at(next_line_start) == 13:
                    next_line_start += 1
                    if next_line_start < source_len and self.source.byte_at(next_line_start) == 10:
                        next_line_start += 1
                else:
                    next_line_start += 1

            logical_start = len(self.brackets) == 0 and not explicit_continuation
            scan_start = line_start
            start_column: i32 = 1

            if logical_start:
                indent_end = line_start
                saw_tab = false
                while indent_end < line_end:
                    byte = self.source.byte_at(indent_end)
                    if byte == 9:
                        saw_tab = true
                    if byte != 32 and byte != 9:
                        break
                    indent_end += 1

                if saw_tab:
                    self.emit_diagnostic(
                        diagnostics.DiagnosticId.LEX_001,
                        line_start,
                        indent_end - line_start,
                        line_number,
                        1,
                    )

                if is_blank_or_comment_line(self.source, indent_end, line_end):
                    explicit_continuation = false
                    line_start = next_line_start
                    line_number += 1
                    continue

                indentation = cast[i32](indent_end - line_start)
                self.emit_indentation(indentation, line_number, line_start)
                scan_start = indent_end
                start_column = indentation + 1

            explicit_continuation = self.scan_line(line_start, line_end, line_number, scan_start, start_column)
            if len(self.brackets) == 0 and not explicit_continuation:
                newline_column = column_at(self.source, line_start, line_end)
                self.emit_zero_token(TokenKind.NEWLINE, line_end, line_number, newline_column)

            line_start = next_line_start
            line_number += 1

        if explicit_continuation:
            error_line = line_count
            if error_line < 1:
                error_line = 1
            self.emit_diagnostic(diagnostics.DiagnosticId.LEX_002, source_len, 0, error_line, 1)

        if len(self.brackets) > 0:
            frame = self.brackets[len(self.brackets) - 1]
            self.emit_diagnostic(diagnostics.DiagnosticId.LEX_003, frame.start, frame.length, frame.line, frame.column)

        eof_line = line_count + 1
        if source_len > 0:
            last = self.source.byte_at(source_len - 1)
            if last == 10 or last == 13:
                eof_line = line_count
        if eof_line < 1:
            eof_line = 1

        while len(self.indent_stack) > 1:
            self.indent_stack.pop()
            self.emit_zero_token(TokenKind.DEDENT, source_len, eof_line, 1)

        self.emit_zero_token(TokenKind.EOF, source_len, eof_line, 1)

    def dump(self: &const Lexer) -> i32:
        path: String = ""
        return self.dump_with_path(&path)

    def dump_with_path(self: &const Lexer, path: &const String) -> i32:
        if len(self.diagnostic_values) > 0:
            diagnostics.write_diagnostics_stderr(&self.diagnostic_values, path, &self.source)
            return 1

        for token in self.tokens:
            print(
                "T",
                cast[i32](token.kind),
                token.start,
                token.length,
                token.line,
                token.column,
            )

        return 0

    def scan_line(
        self: &Lexer,
        line_start: usize,
        line_end: usize,
        line_number: i32,
        start: usize,
        start_column: i32,
    ) -> bool:
        index = start
        explicit_continuation = false
        ignored_column = start_column

        while index < line_end:
            byte = self.source.byte_at(index)
            column = column_at(self.source, line_start, index)

            if byte == 32 or byte == 9:
                index += 1
                continue

            if byte == 35 or (byte == 47 and index + 1 < line_end and self.source.byte_at(index + 1) == 47):
                break

            if byte == 92 and rest_is_spaces_or_tabs(self.source, index + 1, line_end):
                explicit_continuation = true
                break

            if byte == 34 or byte == 39:
                index = self.scan_string(line_start, line_end, line_number, index, 0)
                continue

            if (byte == 102 or byte == 70) and index + 1 < line_end:
                next = self.source.byte_at(index + 1)
                if next == 34 or next == 39:
                    index = self.scan_string(line_start, line_end, line_number, index, 1)
                    continue

            if is_identifier_start(byte):
                end = index + 1
                while end < line_end and is_identifier_continue(self.source.byte_at(end)):
                    end += 1
                kind = keyword_kind(self.source, index, end - index)
                self.emit_token(kind, index, end, line_number, column)
                index = end
                continue

            if is_digit(byte) or (byte == 46 and index + 1 < line_end and is_digit(self.source.byte_at(index + 1))):
                index = self.scan_number(line_start, line_end, line_number, index)
                continue

            multi_length: usize = 0
            multi_kind = TokenKind.EOF
            if range_equals(self.source, index, 3, "<<="):
                multi_kind = TokenKind.SHIFT_LEFT_ASSIGN
                multi_length = 3
            elif range_equals(self.source, index, 3, ">>="):
                multi_kind = TokenKind.SHIFT_RIGHT_ASSIGN
                multi_length = 3
            elif range_equals(self.source, index, 3, "..."):
                multi_kind = TokenKind.ELLIPSIS
                multi_length = 3
            elif range_equals(self.source, index, 2, "->"):
                multi_kind = TokenKind.ARROW
                multi_length = 2
            elif range_equals(self.source, index, 2, "=="):
                multi_kind = TokenKind.EQUAL
                multi_length = 2
            elif range_equals(self.source, index, 2, "!="):
                multi_kind = TokenKind.NOT_EQUAL
                multi_length = 2
            elif range_equals(self.source, index, 2, "<="):
                multi_kind = TokenKind.LESS_EQUAL
                multi_length = 2
            elif range_equals(self.source, index, 2, ">="):
                multi_kind = TokenKind.GREATER_EQUAL
                multi_length = 2
            elif range_equals(self.source, index, 2, "<<"):
                multi_kind = TokenKind.SHIFT_LEFT
                multi_length = 2
            elif range_equals(self.source, index, 2, ">>"):
                multi_kind = TokenKind.SHIFT_RIGHT
                multi_length = 2
            elif range_equals(self.source, index, 2, "+="):
                multi_kind = TokenKind.PLUS_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "-="):
                multi_kind = TokenKind.MINUS_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "*="):
                multi_kind = TokenKind.STAR_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "/="):
                multi_kind = TokenKind.SLASH_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "%="):
                multi_kind = TokenKind.PERCENT_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "&="):
                multi_kind = TokenKind.AMPERSAND_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "|="):
                multi_kind = TokenKind.PIPE_ASSIGN
                multi_length = 2
            elif range_equals(self.source, index, 2, "^="):
                multi_kind = TokenKind.CARET_ASSIGN
                multi_length = 2

            if multi_length > 0:
                end = index + multi_length
                self.emit_token(multi_kind, index, end, line_number, column)
                self.track_bracket(multi_kind, index, multi_length, line_number, column)
                index = end
                continue

            single_kind = single_char_kind(byte)
            if single_kind != TokenKind.EOF:
                end = index + 1
                self.emit_token(single_kind, index, end, line_number, column)
                self.track_bracket(single_kind, index, 1, line_number, column)
                index = end
                continue

            self.emit_actual_character_diagnostic(
                diagnostics.DiagnosticId.LEX_005,
                index,
                1,
                line_number,
                column,
                cast[char](byte),
            )
            index += 1
            ignored_column += 1

        return explicit_continuation

    def scan_string(
        self: &Lexer,
        line_start: usize,
        line_end: usize,
        line_number: i32,
        start: usize,
        prefix_length: usize,
    ) -> usize:
        if prefix_length > 0:
            return self.scan_fstring(line_start, line_end, line_number, start, prefix_length)

        quote = self.source.byte_at(start)
        index = start + 1
        escaped = false
        decoded_length: i32 = 0

        while index < line_end:
            byte = self.source.byte_at(index)
            if escaped:
                escaped = false
                decoded_length += 1
                index += 1
                continue
            if byte == 92:
                escaped = true
                index += 1
                continue
            if byte == quote:
                end = index + 1
                kind = TokenKind.STRING
                if quote == 39 and decoded_length == 1:
                    kind = TokenKind.CHAR
                self.emit_token(kind, start, end, line_number, column_at(self.source, line_start, start))
                return end
            if not is_utf8_continuation(byte):
                decoded_length += 1
            index += 1

        self.emit_diagnostic(
            diagnostics.DiagnosticId.LEX_006,
            start,
            line_end - start,
            line_number,
            column_at(self.source, line_start, start),
        )
        return line_end

    def scan_fstring(
        self: &Lexer,
        line_start: usize,
        line_end: usize,
        line_number: i32,
        start: usize,
        prefix_length: usize,
    ) -> usize:
        quote = self.source.byte_at(start + prefix_length)
        index = start + prefix_length + 1
        replacement_depth: i32 = 0
        escaped = false

        while index < line_end:
            byte = self.source.byte_at(index)
            if replacement_depth == 0:
                if escaped:
                    escaped = false
                    index += 1
                    continue
                if byte == 92:
                    escaped = true
                    index += 1
                    continue
                if byte == quote:
                    end = index + 1
                    self.emit_token(TokenKind.FSTRING, start, end, line_number, column_at(self.source, line_start, start))
                    return end
                if byte == 123 and not range_equals(self.source, index, 2, "{{"):
                    replacement_depth = 1
                    index += 1
                    continue
                if range_equals(self.source, index, 2, "{{") or range_equals(self.source, index, 2, "}}"):
                    index += 2
                    continue
                index += 1
                continue

            if byte == 34 or byte == 39:
                index = skip_quoted_text(self.source, index, line_end)
                continue
            if byte == 123:
                replacement_depth += 1
            elif byte == 125:
                replacement_depth -= 1
            index += 1

        self.emit_diagnostic(
            diagnostics.DiagnosticId.LEX_006,
            start,
            line_end - start,
            line_number,
            column_at(self.source, line_start, start),
        )
        return line_end

    def scan_number(self: &Lexer, line_start: usize, line_end: usize, line_number: i32, start: usize) -> usize:
        index = start
        is_float = false

        if range_equals(self.source, index, 2, "0x") or range_equals(self.source, index, 2, "0X"):
            index += 2
            digit_start = index
            while index < line_end and (is_hex_digit(self.source.byte_at(index)) or self.source.byte_at(index) == 95):
                index += 1
            if valid_prefixed_digits(self.source, digit_start, index, 16):
                self.emit_token(TokenKind.INTEGER, start, index, line_number, column_at(self.source, line_start, start))
            else:
                self.emit_diagnostic(diagnostics.DiagnosticId.LEX_009, start, index - start, line_number, column_at(self.source, line_start, start))
            return index

        if range_equals(self.source, index, 2, "0b") or range_equals(self.source, index, 2, "0B"):
            index += 2
            digit_start = index
            while index < line_end and (self.source.byte_at(index) == 48 or self.source.byte_at(index) == 49 or self.source.byte_at(index) == 95):
                index += 1
            if valid_prefixed_digits(self.source, digit_start, index, 2):
                self.emit_token(TokenKind.INTEGER, start, index, line_number, column_at(self.source, line_start, start))
            else:
                self.emit_diagnostic(diagnostics.DiagnosticId.LEX_009, start, index - start, line_number, column_at(self.source, line_start, start))
            return index

        if range_equals(self.source, index, 2, "0o") or range_equals(self.source, index, 2, "0O"):
            index += 2
            digit_start = index
            while index < line_end and (is_octal_digit(self.source.byte_at(index)) or self.source.byte_at(index) == 95):
                index += 1
            if valid_prefixed_digits(self.source, digit_start, index, 8):
                self.emit_token(TokenKind.INTEGER, start, index, line_number, column_at(self.source, line_start, start))
            else:
                self.emit_diagnostic(diagnostics.DiagnosticId.LEX_009, start, index - start, line_number, column_at(self.source, line_start, start))
            return index

        integer_start = index
        while index < line_end and (is_digit(self.source.byte_at(index)) or self.source.byte_at(index) == 95):
            index += 1
        integer_end = index

        fraction_start = index
        fraction_end = index
        if index < line_end and self.source.byte_at(index) == 46:
            is_float = true
            index += 1
            fraction_start = index
            while index < line_end and (is_digit(self.source.byte_at(index)) or self.source.byte_at(index) == 95):
                index += 1
            fraction_end = index

        exponent_start = index
        exponent_digits_start = index
        exponent_digits_end = index
        exponent_missing_digits = false
        has_exponent = false
        if index < line_end:
            byte = self.source.byte_at(index)
            if byte == 101 or byte == 69:
                is_float = true
                has_exponent = true
                index += 1
                if index < line_end:
                    sign = self.source.byte_at(index)
                    if sign == 43 or sign == 45:
                        index += 1
                exponent_digits_start = index
                while index < line_end and (is_digit(self.source.byte_at(index)) or self.source.byte_at(index) == 95):
                    index += 1
                exponent_digits_end = index
                if exponent_digits_start == exponent_digits_end:
                    exponent_missing_digits = true
                    self.emit_diagnostic(
                        diagnostics.DiagnosticId.LEX_007,
                        start,
                        index - start,
                        line_number,
                        column_at(self.source, line_start, start),
                    )

        valid = true
        if integer_start < integer_end and not valid_decimal_digits(self.source, integer_start, integer_end):
            valid = false
        if fraction_start < fraction_end and not valid_decimal_digits(self.source, fraction_start, fraction_end):
            valid = false
        if has_exponent and not valid_decimal_digits(self.source, exponent_digits_start, exponent_digits_end):
            valid = false
        if exponent_missing_digits:
            valid = false
        if not is_float and not valid_decimal_digits(self.source, integer_start, integer_end):
            valid = false

        if valid:
            if is_float:
                self.emit_token(TokenKind.FLOAT, start, index, line_number, column_at(self.source, line_start, start))
            else:
                self.emit_token(TokenKind.INTEGER, start, index, line_number, column_at(self.source, line_start, start))
        else:
            self.emit_diagnostic(diagnostics.DiagnosticId.LEX_008, start, index - start, line_number, column_at(self.source, line_start, start))

        ignored_exponent_start = exponent_start
        return index

    def track_bracket(
        self: &Lexer,
        kind: TokenKind,
        start: usize,
        length: usize,
        line: i32,
        column: i32,
    ) -> void:
        if kind == TokenKind.LEFT_PAREN or kind == TokenKind.LEFT_BRACKET or kind == TokenKind.LEFT_BRACE:
            self.brackets.append(BracketFrame(kind=kind, start=start, length=length, line=line, column=column))
            return

        if kind != TokenKind.RIGHT_PAREN and kind != TokenKind.RIGHT_BRACKET and kind != TokenKind.RIGHT_BRACE:
            return

        if len(self.brackets) == 0:
            self.emit_diagnostic(diagnostics.DiagnosticId.LEX_010, start, length, line, column)
            return

        opening = self.brackets[len(self.brackets) - 1]
        expected = matching_close(opening.kind)
        if expected != kind:
            self.emit_expected_token_diagnostic(
                diagnostics.DiagnosticId.LEX_011,
                start,
                length,
                line,
                column,
                expected,
                kind,
            )
            self.brackets.pop()
            return

        self.brackets.pop()


def new_lexer(source: String) -> Lexer:
    tokens: List[Token] = []
    diagnostic_values: List[diagnostics.Diagnostic] = []
    indent_stack: List[i32] = [0]
    brackets: List[BracketFrame] = []
    return Lexer(
        source=source,
        tokens=tokens,
        diagnostic_values=diagnostic_values,
        indent_stack=indent_stack,
        brackets=brackets,
    )


def is_utf8_continuation(byte: u8) -> bool:
    return byte >= 128 and byte <= 191


def column_at(source: &const String, line_start: usize, target: usize) -> i32:
    column: i32 = 1
    index = line_start
    while index < target:
        if not is_utf8_continuation(source.byte_at(index)):
            column += 1
        index += 1
    return column


def is_blank_or_comment_line(source: &const String, start: usize, end: usize) -> bool:
    index = start
    while index < end:
        byte = source.byte_at(index)
        if byte != 32 and byte != 9:
            break
        index += 1
    if index >= end:
        return true
    byte = source.byte_at(index)
    if byte == 35:
        return true
    if byte == 47 and index + 1 < end and source.byte_at(index + 1) == 47:
        return true
    return false


def rest_is_spaces_or_tabs(source: &const String, start: usize, end: usize) -> bool:
    index = start
    while index < end:
        byte = source.byte_at(index)
        if byte != 32 and byte != 9:
            return false
        index += 1
    return true


def range_equals(source: &const String, start: usize, length: usize, expected: String) -> bool:
    if length != len(expected):
        return false
    if start + length > len(source):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != expected.byte_at(offset):
            return false
        offset += 1
    return true


def keyword_kind(source: &const String, start: usize, length: usize) -> TokenKind:
    if range_equals(source, start, length, "import"):
        return TokenKind.IMPORT
    if range_equals(source, start, length, "from"):
        return TokenKind.FROM
    if range_equals(source, start, length, "as"):
        return TokenKind.AS
    if range_equals(source, start, length, "extern"):
        return TokenKind.EXTERN
    if range_equals(source, start, length, "def"):
        return TokenKind.DEF
    if range_equals(source, start, length, "struct"):
        return TokenKind.STRUCT
    if range_equals(source, start, length, "enum"):
        return TokenKind.ENUM
    if range_equals(source, start, length, "union"):
        return TokenKind.UNION
    if range_equals(source, start, length, "variant"):
        return TokenKind.VARIANT
    if range_equals(source, start, length, "class"):
        return TokenKind.CLASS
    if range_equals(source, start, length, "abstract"):
        return TokenKind.ABSTRACT
    if range_equals(source, start, length, "dyn"):
        return TokenKind.DYN
    if range_equals(source, start, length, "comptime"):
        return TokenKind.COMPTIME
    if range_equals(source, start, length, "if"):
        return TokenKind.IF
    if range_equals(source, start, length, "elif"):
        return TokenKind.ELIF
    if range_equals(source, start, length, "else"):
        return TokenKind.ELSE
    if range_equals(source, start, length, "while"):
        return TokenKind.WHILE
    if range_equals(source, start, length, "for"):
        return TokenKind.FOR
    if range_equals(source, start, length, "match"):
        return TokenKind.MATCH
    if range_equals(source, start, length, "case"):
        return TokenKind.CASE
    if range_equals(source, start, length, "in"):
        return TokenKind.IN
    if range_equals(source, start, length, "return"):
        return TokenKind.RETURN
    if range_equals(source, start, length, "break"):
        return TokenKind.BREAK
    if range_equals(source, start, length, "continue"):
        return TokenKind.CONTINUE
    if range_equals(source, start, length, "pass"):
        return TokenKind.PASS
    if range_equals(source, start, length, "const"):
        return TokenKind.CONST
    if range_equals(source, start, length, "true"):
        return TokenKind.TRUE
    if range_equals(source, start, length, "false"):
        return TokenKind.FALSE
    if range_equals(source, start, length, "null"):
        return TokenKind.NULL
    if range_equals(source, start, length, "None"):
        return TokenKind.NONE
    if range_equals(source, start, length, "and"):
        return TokenKind.AND
    if range_equals(source, start, length, "or"):
        return TokenKind.OR
    if range_equals(source, start, length, "not"):
        return TokenKind.NOT
    if range_equals(source, start, length, "unsafe"):
        return TokenKind.UNSAFE
    if range_equals(source, start, length, "defer"):
        return TokenKind.DEFER
    if range_equals(source, start, length, "with"):
        return TokenKind.WITH
    if range_equals(source, start, length, "private"):
        return TokenKind.PRIVATE
    if range_equals(source, start, length, "lock"):
        return TokenKind.LOCK
    return TokenKind.NAME


def single_char_kind(byte: u8) -> TokenKind:
    if byte == 40:
        return TokenKind.LEFT_PAREN
    if byte == 41:
        return TokenKind.RIGHT_PAREN
    if byte == 91:
        return TokenKind.LEFT_BRACKET
    if byte == 93:
        return TokenKind.RIGHT_BRACKET
    if byte == 123:
        return TokenKind.LEFT_BRACE
    if byte == 125:
        return TokenKind.RIGHT_BRACE
    if byte == 58:
        return TokenKind.COLON
    if byte == 44:
        return TokenKind.COMMA
    if byte == 46:
        return TokenKind.DOT
    if byte == 59:
        return TokenKind.SEMICOLON
    if byte == 64:
        return TokenKind.AT
    if byte == 63:
        return TokenKind.QUESTION
    if byte == 61:
        return TokenKind.ASSIGN
    if byte == 43:
        return TokenKind.PLUS
    if byte == 45:
        return TokenKind.MINUS
    if byte == 42:
        return TokenKind.STAR
    if byte == 47:
        return TokenKind.SLASH
    if byte == 37:
        return TokenKind.PERCENT
    if byte == 38:
        return TokenKind.AMPERSAND
    if byte == 124:
        return TokenKind.PIPE
    if byte == 94:
        return TokenKind.CARET
    if byte == 126:
        return TokenKind.TILDE
    if byte == 33:
        return TokenKind.BANG
    if byte == 60:
        return TokenKind.LESS
    if byte == 62:
        return TokenKind.GREATER
    return TokenKind.EOF


def matching_close(kind: TokenKind) -> TokenKind:
    if kind == TokenKind.LEFT_PAREN:
        return TokenKind.RIGHT_PAREN
    if kind == TokenKind.LEFT_BRACKET:
        return TokenKind.RIGHT_BRACKET
    if kind == TokenKind.LEFT_BRACE:
        return TokenKind.RIGHT_BRACE
    return TokenKind.EOF


def is_identifier_start(byte: u8) -> bool:
    return byte == 95 or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)


def is_identifier_continue(byte: u8) -> bool:
    return is_identifier_start(byte) or is_digit(byte)


def is_digit(byte: u8) -> bool:
    return byte >= 48 and byte <= 57


def is_octal_digit(byte: u8) -> bool:
    return byte >= 48 and byte <= 55


def is_hex_digit(byte: u8) -> bool:
    return is_digit(byte) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)


def digit_allowed_for_base(byte: u8, base: i32) -> bool:
    if base == 2:
        return byte == 48 or byte == 49
    if base == 8:
        return is_octal_digit(byte)
    return is_hex_digit(byte)


def valid_prefixed_digits(source: &const String, start: usize, end: usize, base: i32) -> bool:
    index = start
    seen_digit = false
    previous_underscore = false
    while index < end:
        byte = source.byte_at(index)
        if byte == 95:
            if previous_underscore:
                return false
            previous_underscore = true
        elif digit_allowed_for_base(byte, base):
            seen_digit = true
            previous_underscore = false
        else:
            return false
        index += 1
    return seen_digit and not previous_underscore


def valid_decimal_digits(source: &const String, start: usize, end: usize) -> bool:
    if start >= end:
        return false
    index = start
    previous_underscore = false
    seen_digit = false
    while index < end:
        byte = source.byte_at(index)
        if byte == 95:
            if not seen_digit or previous_underscore:
                return false
            previous_underscore = true
        elif is_digit(byte):
            seen_digit = true
            previous_underscore = false
        else:
            return false
        index += 1
    return seen_digit and not previous_underscore


def skip_quoted_text(source: &const String, start: usize, end: usize) -> usize:
    quote = source.byte_at(start)
    index = start + 1
    escaped = false
    while index < end:
        byte = source.byte_at(index)
        if escaped:
            escaped = false
        elif byte == 92:
            escaped = true
        elif byte == quote:
            return index + 1
        index += 1
    return index
