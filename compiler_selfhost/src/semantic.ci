import symbols
import types
from symbols import ScopeId, SymbolId
from syntax import NodeId
from types import TypeId


enum ValueUseKind:
    COPY
    MOVE
    BORROW
    ADDRESS


enum AtomicIntrinsicKind:
    NONE
    INIT
    LOAD
    STORE
    EXCHANGE
    COMPARE_EXCHANGE
    FETCH_ADD
    FETCH_SUB
    FETCH_AND
    FETCH_OR
    FETCH_XOR
    RESULT_EXCHANGED
    RESULT_OBSERVED


enum AtomicArgumentRole:
    NONE
    VALUE
    EXPECTED
    DESIRED


struct NodeTypeBinding:
    node: NodeId
    type_id: TypeId
    specialization: i32


struct NodeSymbolBinding:
    node: NodeId
    symbol: SymbolId


struct NodeScopeBinding:
    node: NodeId
    scope: ScopeId


struct ValueUseResolution:
    node: NodeId
    kind: ValueUseKind
    symbol: SymbolId
    type_id: TypeId
    destination_type: TypeId
    previous_move: NodeId


struct CleanupBinding:
    node: NodeId
    type_id: TypeId
    flags: i32


struct CallResolution:
    node: NodeId
    callee: SymbolId
    return_type: TypeId
    flags: i32


struct AtomicIntrinsicResolution:
    node: NodeId
    specialization: i32
    kind: AtomicIntrinsicKind
    element_kind: types.AtomicElementKind
    atomic_type: TypeId
    element_type: TypeId
    result_type: TypeId
    receiver: NodeId
    operand0: NodeId
    operand1: NodeId
    first_evaluated: NodeId
    second_evaluated: NodeId
    first_role: AtomicArgumentRole
    second_role: AtomicArgumentRole
    flags: i32


struct LockBinding:
    node: NodeId
    lock_index: i32
    canonical_key: i32


struct CriticalSectionResolution:
    node: NodeId
    kind: i32
    lock_index: i32


struct SpecializationBinding:
    node: NodeId
    callee: SymbolId
    first_arg: i32
    arg_count: i32
    suffix: String


struct UserSpecialization:
    declaration: NodeId
    first_arg: i32
    arg_count: i32
    suffix: String


struct SemanticModel:
    expr_types: List[NodeTypeBinding]
    type_nodes: List[NodeTypeBinding]
    name_symbols: List[NodeSymbolBinding]
    declaration_symbols: List[NodeSymbolBinding]
    function_symbols: List[NodeSymbolBinding]
    struct_symbols: List[NodeSymbolBinding]
    class_symbols: List[NodeSymbolBinding]
    enum_symbols: List[NodeSymbolBinding]
    union_symbols: List[NodeSymbolBinding]
    variant_symbols: List[NodeSymbolBinding]
    global_symbols: List[NodeSymbolBinding]
    node_scopes: List[NodeScopeBinding]
    call_resolutions: List[CallResolution]
    specialization_args: List[TypeId]
    specializations: List[SpecializationBinding]
    user_specializations: List[UserSpecialization]
    cleanups: List[CleanupBinding]
    value_use_resolutions: List[ValueUseResolution]
    atomic_intrinsics: List[AtomicIntrinsicResolution]
    locks: List[LockBinding]
    critical_sections: List[CriticalSectionResolution]
    active_user_specialization: i32

    def record_expr_type(self: &SemanticModel, node: NodeId, type_id: TypeId) -> void:
        record_node_type(self.expr_types, node, type_id, self.active_user_specialization)

    def record_type_node(self: &SemanticModel, node: NodeId, type_id: TypeId) -> void:
        record_node_type(self.type_nodes, node, type_id, self.active_user_specialization)

    def record_name_symbol(self: &SemanticModel, node: NodeId, symbol: SymbolId) -> void:
        record_node_symbol(self.name_symbols, node, symbol)

    def record_declaration_symbol(self: &SemanticModel, node: NodeId, symbol: SymbolId) -> void:
        record_node_symbol(self.declaration_symbols, node, symbol)

    def record_scope(self: &SemanticModel, node: NodeId, scope: ScopeId) -> void:
        index: usize = 0
        while index < len(self.node_scopes):
            if self.node_scopes[index].node.index == node.index:
                self.node_scopes[index].scope = scope
                return
            index += 1
        self.node_scopes.append(NodeScopeBinding(node=node, scope=scope))

    def record_call(self: &SemanticModel, node: NodeId, callee: SymbolId, return_type: TypeId, flags: i32) -> void:
        index: usize = 0
        while index < len(self.call_resolutions):
            if self.call_resolutions[index].node.index == node.index:
                self.call_resolutions[index].callee = callee
                self.call_resolutions[index].return_type = return_type
                self.call_resolutions[index].flags = flags
                return
            index += 1
        self.call_resolutions.append(CallResolution(node=node, callee=callee, return_type=return_type, flags=flags))

    def record_specialization(self: &SemanticModel, node: NodeId, callee: SymbolId, args: &const List[TypeId], suffix: String) -> void:
        first = cast[i32](len(self.specialization_args))
        index: usize = 0
        while index < len(args):
            self.specialization_args.append(args[index])
            index += 1
        self.specializations.append(
            SpecializationBinding(
                node=node,
                callee=callee,
                first_arg=first,
                arg_count=cast[i32](len(args)),
                suffix=suffix,
            )
        )

    def record_user_specialization(self: &SemanticModel, declaration: NodeId, args: &const List[TypeId], suffix: String) -> void:
        index: usize = 0
        while index < len(self.user_specializations):
            if self.user_specializations[index].declaration.index == declaration.index and self.user_specializations[index].suffix == suffix:
                return
            index += 1
        first = cast[i32](len(self.specialization_args))
        arg_index: usize = 0
        while arg_index < len(args):
            self.specialization_args.append(args[arg_index])
            arg_index += 1
        self.user_specializations.append(
            UserSpecialization(
                declaration=declaration,
                first_arg=first,
                arg_count=cast[i32](len(args)),
                suffix=suffix,
            )
        )

    def record_cleanup(self: &SemanticModel, node: NodeId, type_id: TypeId, flags: i32) -> void:
        index: usize = 0
        while index < len(self.cleanups):
            if self.cleanups[index].node.index == node.index:
                self.cleanups[index].type_id = type_id
                self.cleanups[index].flags = flags
                return
            index += 1
        self.cleanups.append(CleanupBinding(node=node, type_id=type_id, flags=flags))

    def record_value_use(
        self: &SemanticModel,
        node: NodeId,
        kind: ValueUseKind,
        symbol: SymbolId,
        type_id: TypeId,
        destination_type: TypeId,
    ) -> void:
        previous_move = NodeId(index=-1)
        index: usize = 0
        while index < len(self.value_use_resolutions):
            existing: &const ValueUseResolution = &self.value_use_resolutions[index]
            if (
                kind == ValueUseKind.MOVE
                and symbol.index >= 0
                and existing.kind == ValueUseKind.MOVE
                and existing.symbol.index == symbol.index
            ):
                previous_move = existing.node
            if self.value_use_resolutions[index].node.index == node.index:
                self.value_use_resolutions[index].kind = kind
                self.value_use_resolutions[index].symbol = symbol
                self.value_use_resolutions[index].type_id = type_id
                self.value_use_resolutions[index].destination_type = destination_type
                self.value_use_resolutions[index].previous_move = previous_move
                return
            index += 1
        self.value_use_resolutions.append(
            ValueUseResolution(
                node=node,
                kind=kind,
                symbol=symbol,
                type_id=type_id,
                destination_type=destination_type,
                previous_move=previous_move,
            )
        )

    def record_lock(self: &SemanticModel, node: NodeId, lock_index: i32, canonical_key: i32) -> void:
        index: usize = 0
        while index < len(self.locks):
            if self.locks[index].node.index == node.index:
                self.locks[index].lock_index = lock_index
                self.locks[index].canonical_key = canonical_key
                return
            index += 1
        self.locks.append(LockBinding(node=node, lock_index=lock_index, canonical_key=canonical_key))

    def record_critical_section(self: &SemanticModel, node: NodeId, kind: i32, lock_index: i32) -> void:
        index: usize = 0
        while index < len(self.critical_sections):
            if self.critical_sections[index].node.index == node.index:
                self.critical_sections[index].kind = kind
                self.critical_sections[index].lock_index = lock_index
                return
            index += 1
        self.critical_sections.append(CriticalSectionResolution(node=node, kind=kind, lock_index=lock_index))

    def record_atomic_intrinsic(
        self: &SemanticModel,
        node: NodeId,
        kind: AtomicIntrinsicKind,
        element_kind: types.AtomicElementKind,
        atomic_type: TypeId,
        element_type: TypeId,
        result_type: TypeId,
        receiver: NodeId,
        operand0: NodeId,
        operand1: NodeId,
        first_evaluated: NodeId,
        second_evaluated: NodeId,
        first_role: AtomicArgumentRole,
        second_role: AtomicArgumentRole,
        flags: i32,
    ) -> void:
        if element_kind == types.AtomicElementKind.INVALID:
            return
        index: usize = 0
        while index < len(self.atomic_intrinsics):
            if self.atomic_intrinsics[index].node.index == node.index and self.atomic_intrinsics[index].specialization == self.active_user_specialization:
                self.atomic_intrinsics[index].kind = kind
                self.atomic_intrinsics[index].element_kind = element_kind
                self.atomic_intrinsics[index].atomic_type = atomic_type
                self.atomic_intrinsics[index].element_type = element_type
                self.atomic_intrinsics[index].result_type = result_type
                self.atomic_intrinsics[index].receiver = receiver
                self.atomic_intrinsics[index].operand0 = operand0
                self.atomic_intrinsics[index].operand1 = operand1
                self.atomic_intrinsics[index].first_evaluated = first_evaluated
                self.atomic_intrinsics[index].second_evaluated = second_evaluated
                self.atomic_intrinsics[index].first_role = first_role
                self.atomic_intrinsics[index].second_role = second_role
                self.atomic_intrinsics[index].flags = flags
                return
            index += 1
        self.atomic_intrinsics.append(
            AtomicIntrinsicResolution(
                node=node,
                specialization=self.active_user_specialization,
                kind=kind,
                element_kind=element_kind,
                atomic_type=atomic_type,
                element_type=element_type,
                result_type=result_type,
                receiver=receiver,
                operand0=operand0,
                operand1=operand1,
                first_evaluated=first_evaluated,
                second_evaluated=second_evaluated,
                first_role=first_role,
                second_role=second_role,
                flags=flags,
            )
        )

    def expr_type(self: &const SemanticModel, node: NodeId) -> TypeId:
        return find_node_type(self.expr_types, node, self.active_user_specialization)

    def type_node(self: &const SemanticModel, node: NodeId) -> TypeId:
        return find_node_type(self.type_nodes, node, self.active_user_specialization)

    def expr_type_for_specialization(self: &const SemanticModel, node: NodeId, specialization: i32) -> TypeId:
        return find_node_type(self.expr_types, node, specialization)

    def type_node_for_specialization(self: &const SemanticModel, node: NodeId, specialization: i32) -> TypeId:
        return find_node_type(self.type_nodes, node, specialization)

    def scope_for_node(self: &const SemanticModel, node: NodeId) -> ScopeId:
        index: usize = 0
        while index < len(self.node_scopes):
            if self.node_scopes[index].node.index == node.index:
                return self.node_scopes[index].scope
            index += 1
        return symbols.missing_scope()


def new_semantic_model() -> SemanticModel:
    expr_types: List[NodeTypeBinding] = []
    type_nodes: List[NodeTypeBinding] = []
    name_symbols: List[NodeSymbolBinding] = []
    declaration_symbols: List[NodeSymbolBinding] = []
    function_symbols: List[NodeSymbolBinding] = []
    struct_symbols: List[NodeSymbolBinding] = []
    class_symbols: List[NodeSymbolBinding] = []
    enum_symbols: List[NodeSymbolBinding] = []
    union_symbols: List[NodeSymbolBinding] = []
    variant_symbols: List[NodeSymbolBinding] = []
    global_symbols: List[NodeSymbolBinding] = []
    node_scopes: List[NodeScopeBinding] = []
    call_resolutions: List[CallResolution] = []
    specialization_args: List[TypeId] = []
    specializations: List[SpecializationBinding] = []
    user_specializations: List[UserSpecialization] = []
    cleanups: List[CleanupBinding] = []
    value_use_resolutions: List[ValueUseResolution] = []
    atomic_intrinsics: List[AtomicIntrinsicResolution] = []
    locks: List[LockBinding] = []
    critical_sections: List[CriticalSectionResolution] = []
    return SemanticModel(
        expr_types=expr_types,
        type_nodes=type_nodes,
        name_symbols=name_symbols,
        declaration_symbols=declaration_symbols,
        function_symbols=function_symbols,
        struct_symbols=struct_symbols,
        class_symbols=class_symbols,
        enum_symbols=enum_symbols,
        union_symbols=union_symbols,
        variant_symbols=variant_symbols,
        global_symbols=global_symbols,
        node_scopes=node_scopes,
        call_resolutions=call_resolutions,
        specialization_args=specialization_args,
        specializations=specializations,
        user_specializations=user_specializations,
        cleanups=cleanups,
        value_use_resolutions=value_use_resolutions,
        atomic_intrinsics=atomic_intrinsics,
        locks=locks,
        critical_sections=critical_sections,
        active_user_specialization=-1,
    )


def record_node_type(bindings: &List[NodeTypeBinding], node: NodeId, type_id: TypeId, specialization: i32) -> void:
    index: usize = 0
    while index < len(bindings):
        if bindings[index].node.index == node.index and bindings[index].specialization == specialization:
            bindings[index].type_id = type_id
            return
        index += 1
    bindings.append(NodeTypeBinding(node=node, type_id=type_id, specialization=specialization))


def record_node_symbol(bindings: &List[NodeSymbolBinding], node: NodeId, symbol: SymbolId) -> void:
    index: usize = 0
    while index < len(bindings):
        if bindings[index].node.index == node.index:
            bindings[index].symbol = symbol
            return
        index += 1
    bindings.append(NodeSymbolBinding(node=node, symbol=symbol))


def find_node_type(bindings: &const List[NodeTypeBinding], node: NodeId, specialization: i32) -> TypeId:
    index: usize = 0
    while index < len(bindings):
        if bindings[index].node.index == node.index and bindings[index].specialization == specialization:
            return bindings[index].type_id
        index += 1
    if specialization >= 0:
        index = 0
        while index < len(bindings):
            if bindings[index].node.index == node.index and bindings[index].specialization < 0:
                return bindings[index].type_id
            index += 1
    return types.type_error()
