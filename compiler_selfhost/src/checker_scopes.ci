import checker_core
import checker_types
import diagnostics
import lock_order
import ownership
import reflection
import semantic
import symbols
import syntax
import token
import types
import variants
from syntax import NodeId


def validate_names(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, root: NodeId, source: &const String) -> void:
    validate_names_in_scope(checker, arena, root, source, symbols.root_scope(), types.type_void())
    validate_specializations(checker, arena, source)


def validate_specializations(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, source: &const String) -> void:
    user_specializations: &const List[semantic.UserSpecialization] = &checker.model.user_specializations
    specialization_args: &const List[types.TypeId] = &checker.model.specialization_args
    index: usize = 0
    while index < len(user_specializations):
        declaration = user_specializations[index].declaration
        first_arg = user_specializations[index].first_arg
        arg_count = user_specializations[index].arg_count
        while len(checker.specialization_args) > 0:
            checker.specialization_args.pop()
        offset: i32 = 0
        while offset < arg_count:
            checker.specialization_args.append(specialization_args[cast[usize](first_arg + offset)])
            offset += 1
        checker.specialization_declaration = declaration
        checker.model.active_user_specialization = cast[i32](index)
        validate_specialized_declaration(checker, arena, declaration, source)
        if declaration.index >= 0 and arena.nodes[declaration.index].kind == syntax.SyntaxKind.CLASS_DECL:
            validate_specialized_class_implementations(checker, arena, declaration, source)
        index += 1
    checker.specialization_declaration = syntax.missing_node()
    checker.model.active_user_specialization = -1
    while len(checker.specialization_args) > 0:
        checker.specialization_args.pop()


def validate_specialized_declaration(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, declaration: NodeId, source: &const String) -> void:
    if declaration.index < 0:
        return
    node = arena.nodes[declaration.index]
    if node.kind == syntax.SyntaxKind.FUNCTION_DECL:
        validate_names_in_scope(checker, arena, declaration, source, symbols.root_scope(), types.type_void())
        return
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child_kind = arena.nodes[child_id.index].kind
        if child_kind == syntax.SyntaxKind.FUNCTION_DECL or child_kind == syntax.SyntaxKind.FIELD_DECL or child_kind == syntax.SyntaxKind.VARIANT_CASE_DECL:
            validate_names_in_scope(checker, arena, child_id, source, symbols.root_scope(), types.type_void())


def validate_specialized_class_implementations(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, declaration: NodeId, source: &const String) -> void:
    candidate_index: usize = 0
    while candidate_index < len(arena.nodes):
        candidate_id = NodeId(index=cast[i32](candidate_index))
        candidate = arena.nodes[candidate_index]
        if candidate.kind == syntax.SyntaxKind.CLASS_DECL and candidate_id.index != declaration.index and class_has_active_generic_base(checker, arena, candidate_id, declaration, source):
            validate_class_methods_against_specialization(checker, arena, candidate_id, declaration, source)
        candidate_index += 1


def class_has_active_generic_base(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    candidate: NodeId,
    declaration: NodeId,
    source: &const String,
) -> bool:
    candidate_node = arena.nodes[candidate.index]
    declaration_node = arena.nodes[declaration.index]
    active_args: &const List[types.TypeId] = &checker.specialization_args
    for offset in range(0, candidate_node.child_count):
        base_id = arena.children[candidate_node.first_child + offset]
        base = arena.nodes[base_id.index]
        if base.kind != syntax.SyntaxKind.TYPE_GENERIC:
            continue
        base_name = checker_core.first_child(arena, base_id)
        if base_name.index < 0:
            continue
        base_name_node = arena.nodes[base_name.index]
        if not symbols.range_equals(source, base_name_node.value_start, base_name_node.value_length, declaration_node.value_start, declaration_node.value_length):
            continue
        base_type = checker_core.resolve_type_node(checker, arena, base_id, source)
        if base_type.index < 0 or base_type.index >= cast[i32](len(checker.type_table.types)):
            continue
        record = checker.type_table.types[base_type.index]
        if record.flags != cast[i32](len(active_args)):
            continue
        matches = true
        argument_offset: i32 = 0
        while argument_offset < record.flags:
            if not checker.type_table.same(checker.type_table.type_args[cast[usize](record.extra + argument_offset)], active_args[cast[usize](argument_offset)]):
                matches = false
            argument_offset += 1
        if matches:
            return true
    return false


def validate_class_methods_against_specialization(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    implementation: NodeId,
    declaration: NodeId,
    source: &const String,
) -> void:
    declaration_node = arena.nodes[declaration.index]
    for offset in range(0, declaration_node.child_count):
        expected_id = arena.children[declaration_node.first_child + offset]
        expected = arena.nodes[expected_id.index]
        if expected.kind != syntax.SyntaxKind.FUNCTION_DECL:
            continue
        actual_id = find_method_declaration(arena, implementation, source, expected.value_start, expected.value_length)
        if actual_id.index < 0 or not specialized_method_signatures_match(checker, arena, expected_id, actual_id, source):
            implementation_node = arena.nodes[implementation.index]
            method_name = source[expected.value_start:expected.value_start + expected.value_length]
            if actual_id.index >= 0:
                checker_core.emit_override_error(
                    checker,
                    &arena.nodes[actual_id.index],
                    method_name,
                    &expected,
                )
            else:
                checker_core.emit_override_error(checker, &implementation_node, method_name, &expected)
            return


def find_method_declaration(arena: &const syntax.SyntaxArena, declaration: NodeId, source: &const String, start: usize, length: usize) -> NodeId:
    node = arena.nodes[declaration.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == syntax.SyntaxKind.FUNCTION_DECL and symbols.range_equals(source, child.value_start, child.value_length, start, length):
            return child_id
    return syntax.missing_node()


def specialized_method_signatures_match(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    expected_id: NodeId,
    actual_id: NodeId,
    source: &const String,
) -> bool:
    expected_count = checker_core.count_direct_children(arena, expected_id, syntax.SyntaxKind.PARAMETER)
    actual_count = checker_core.count_direct_children(arena, actual_id, syntax.SyntaxKind.PARAMETER)
    if expected_count != actual_count:
        return false
    parameter_index: i32 = 1
    while parameter_index < expected_count:
        expected_parameter = parameter_at(arena, expected_id, parameter_index)
        actual_parameter = parameter_at(arena, actual_id, parameter_index)
        expected_type = checker_core.resolve_declared_type_or_default(checker, arena, expected_parameter, source, types.type_i32())
        actual_type = checker_core.resolve_declared_type_or_default(checker, arena, actual_parameter, source, types.type_i32())
        if not checker.type_table.same(expected_type, actual_type):
            return false
        parameter_index += 1
    expected_return = checker_core.resolve_declared_type_or_default(checker, arena, expected_id, source, types.type_i32())
    actual_return = checker_core.resolve_declared_type_or_default(checker, arena, actual_id, source, types.type_i32())
    return checker.type_table.same(expected_return, actual_return)


def parameter_at(arena: &const syntax.SyntaxArena, declaration: NodeId, wanted: i32) -> NodeId:
    node = arena.nodes[declaration.index]
    seen: i32 = 0
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind == syntax.SyntaxKind.PARAMETER:
            if seen == wanted:
                return child_id
            seen += 1
    return syntax.missing_node()


def validate_names_in_node(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> void:
    validate_names_in_scope(checker, arena, id, source, symbols.root_scope(), types.type_void())


def validate_names_in_scope(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId, expected_return: types.TypeId) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.FUNCTION_DECL:
        function_scope = checker.symbols.add_scope(current_scope)
        function_return = checker_core.resolve_declared_type_or_default(checker, arena, id, source, types.type_i32())
        if ownership.type_contains_atomic_storage(&checker.type_table, function_return):
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_396, &node)
        checker.model.record_scope(id, function_scope)
        for offset in range(0, node.child_count):
            validate_names_in_scope(checker, arena, arena.children[node.first_child + offset], source, function_scope, function_return)
        return
    if node.kind == syntax.SyntaxKind.MATCH_CASE:
        case_scope = checker.symbols.add_scope(current_scope)
        checker.model.record_scope(id, case_scope)
        if node.child_count > 0:
            pattern = arena.children[node.first_child]
            validate_or_pattern_bindings(checker, arena, pattern, source)
            declare_pattern_bindings(checker, arena, pattern, source, case_scope)
        for offset in range(0, node.child_count):
            validate_names_in_scope(checker, arena, arena.children[node.first_child + offset], source, case_scope, expected_return)
        return
    if node.kind == syntax.SyntaxKind.BLOCK:
        block_scope = checker.symbols.add_scope(current_scope)
        checker.model.record_scope(id, block_scope)
        for offset in range(0, node.child_count):
            validate_names_in_scope(checker, arena, arena.children[node.first_child + offset], source, block_scope, expected_return)
        return
    if node.kind == syntax.SyntaxKind.PARAMETER or node.kind == syntax.SyntaxKind.VAR_DECL_STMT or node.kind == syntax.SyntaxKind.WITH_STMT:
        local_type = checker_core.resolve_declared_type_or_default(checker, arena, id, source, types.type_i32())
        local_kind = symbols.SymbolKind.LOCAL
        if node.kind == syntax.SyntaxKind.PARAMETER:
            local_kind = symbols.SymbolKind.PARAMETER
        symbol = checker.symbols.add_symbol(
            local_kind,
            node.value_start,
            node.value_length,
            local_type,
            id,
            current_scope,
            0,
        )
        checker.model.record_declaration_symbol(id, symbol)
        if node.kind == syntax.SyntaxKind.PARAMETER and ownership.type_contains_atomic_storage(&checker.type_table, local_type):
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_396, &node)
        if ownership.type_needs_drop_for_table(checker.type_table, local_type):
            checker.model.record_cleanup(id, local_type, 0)
        if node.kind == syntax.SyntaxKind.VAR_DECL_STMT:
            validate_var_decl(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.GLOBAL_DECL:
        validate_atomic_global(checker, arena, id, source, current_scope)
        global_symbol = symbols.missing_symbol()
        for binding: semantic.NodeSymbolBinding in checker.model.declaration_symbols:
            if binding.node.index == id.index:
                global_symbol = binding.symbol
        if global_symbol.index >= 0:
            global_type = checker.symbols.symbols[global_symbol.index].type_id
            if not types.is_atomic_type(&checker.type_table, global_type) and ownership.type_contains_atomic_storage(&checker.type_table, global_type):
                checker_types.emit_ownership_failure(
                    checker,
                    arena,
                    diagnostics.DiagnosticId.CHECK_395,
                    id,
                    global_type,
                    global_type,
                    source,
                    "storage",
                )
            elif not types.is_atomic_type(&checker.type_table, global_type):
                initializer = atomic_declaration_initializer(arena, id)
                if initializer.index >= 0:
                    initializer_type = checker_types.infer_expression_type(checker, arena, initializer, source, current_scope)
                    if types.is_atomic_type(&checker.type_table, initializer_type):
                        initializer_node = arena.nodes[initializer.index]
                        checker_core.emit_actual_type_error(
                            checker,
                            diagnostics.DiagnosticId.CHECK_400,
                            &initializer_node,
                            initializer_type,
                            source,
                        )
    elif node.kind == syntax.SyntaxKind.FIELD_DECL:
        field_type = checker_core.resolve_declared_type_or_default(checker, arena, id, source, types.type_i32())
        if ownership.type_contains_atomic_storage(&checker.type_table, field_type):
            checker_types.emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_395,
                id,
                field_type,
                field_type,
                source,
                "storage",
            )
    elif node.kind == syntax.SyntaxKind.EXPR_NAME:
        if not checker_types.is_builtin_name(source, node.value_start, node.value_length):
            found = checker.symbols.find_in_scope(source, current_scope, node.value_start, node.value_length)
            if found.index < 0:
                checker_core.emit_symbol_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_048,
                    &node,
                    source[node.value_start:node.value_start + node.value_length],
                )
                return
            checker.model.record_name_symbol(id, found)
            checker.model.record_expr_type(id, checker.symbols.symbols[found.index].type_id)
    elif node.kind == syntax.SyntaxKind.EXPR_CALL:
        checker_types.validate_call(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.EXPR_TUPLE or node.kind == syntax.SyntaxKind.EXPR_INDEX or node.kind == syntax.SyntaxKind.EXPR_UNARY:
        inferred_expression = checker_types.infer_expression_type(checker, arena, id, source, current_scope)
        ignored_inferred_expression = inferred_expression
    elif node.kind == syntax.SyntaxKind.EXPR_STMT:
        expression = checker_core.first_child(arena, id)
        if expression.index >= 0:
            expression_type = checker_types.infer_expression_type(checker, arena, expression, source, current_scope)
            checker_types.validate_discarded_expression(checker, arena, expression, expression_type, source, current_scope)
    elif node.kind == syntax.SyntaxKind.CRITICAL_SECTION_STMT:
        expression = checker_core.first_child(arena, id)
        expression_type = types.strip_const(&checker.type_table, checker_types.infer_expression_type(checker, arena, expression, source, current_scope))
        lock_index = lock_order.resolve_lock_expression(
            &checker.lock_model,
            &checker.module_name,
            &checker.module_imports,
            arena,
            expression,
            source,
        )
        if expression_type.index == types.type_lock().index:
            critical_kind: i32 = 2
            if lock_index >= 0:
                critical_kind = 1
            checker.model.record_critical_section(id, critical_kind, lock_index)
        elif types.is_ordered_lock_list(&checker.type_table, expression_type):
            checker.model.record_critical_section(id, 3, -1)
        elif expression_type.index >= 0 and expression_type.index < cast[i32](len(checker.type_table.types)) and checker.type_table.types[expression_type.index].kind == types.TypeKind.LIST and types.strip_const(&checker.type_table, checker.type_table.types[expression_type.index].inner).index == types.type_lock().index:
            expression_node = arena.nodes[expression.index]
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_408, &expression_node)
        else:
            expression_node = arena.nodes[expression.index]
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_409, &expression_node)
    elif node.kind == syntax.SyntaxKind.RETURN_STMT:
        if node.child_count == 0:
            if expected_return.index != types.type_void().index:
                checker_core.emit_expected_type_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_042,
                    &node,
                    expected_return,
                    source,
                )
            return
        returned = checker_core.first_child(arena, id)
        returned_type = checker_types.infer_expression_type(checker, arena, returned, source, current_scope)
        if types.is_atomic_type(&checker.type_table, returned_type) and not types.is_atomic_type(&checker.type_table, expected_return):
            returned_node = arena.nodes[returned.index]
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_400,
                &returned_node,
                returned_type,
                source,
            )
        checker_types.validate_partial_move_source(checker, arena, returned, returned_type, expected_return, source, current_scope)
        if expected_return.index != types.type_void().index and returned_type.index != types.type_error().index and not checker_types.types_compatible(checker, expected_return, returned_type) and not (checker.specialization_declaration.index < 0 and checker_core.type_is_unbound_parameter(checker, expected_return, source)):
            returned_node = arena.nodes[returned.index]
            checker_core.emit_type_mismatch(
                checker,
                &returned_node,
                expected_return,
                returned_type,
                source,
            )
            return
    elif node.kind == syntax.SyntaxKind.ASSIGN_STMT:
        declare_assignment_target_if_missing(checker, arena, id, source, current_scope)
        validate_set_compound_assignment(checker, arena, id, source, current_scope)
        target = checker_core.first_child(arena, id)
        value = checker_core.second_child(arena, id)
        if target.index >= 0 and value.index >= 0:
            target_type = checker_types.infer_expression_type(checker, arena, target, source, current_scope)
            value_type = checker_types.infer_expression_type(checker, arena, value, source, current_scope)
            checker_types.validate_ordered_lock_element_mutation(checker, arena, target, source, current_scope)
            if types.is_atomic_type(&checker.type_table, target_type):
                target_node = arena.nodes[target.index]
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_401, &target_node)
            elif types.is_atomic_type(&checker.type_table, value_type):
                value_node = arena.nodes[value.index]
                checker_core.emit_actual_type_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_400,
                    &value_node,
                    value_type,
                    source,
                )
            elif ownership.type_contains_atomic_storage(&checker.type_table, value_type):
                value_node = arena.nodes[value.index]
                checker_types.emit_ownership_failure(
                    checker,
                    arena,
                    diagnostics.DiagnosticId.CHECK_395,
                    value,
                    value_type,
                    target_type,
                    source,
                    "assignment",
                )
            checker_types.validate_partial_move_source(checker, arena, value, value_type, target_type, source, current_scope)
    elif node.kind == syntax.SyntaxKind.FOR_EACH_STMT:
        declare_for_each_target_if_missing(checker, arena, id, source, current_scope)
    elif node.kind == syntax.SyntaxKind.IF_STMT or node.kind == syntax.SyntaxKind.WHILE_STMT:
        condition = checker_core.first_child(arena, id)
        if condition.index >= 0 and checker_types.is_string_literal(arena, condition):
            checker_core.emit_error_at(
                checker,
                diagnostics.DiagnosticId.CHECK_024,
                &arena.nodes[condition.index],
            )
            return
        if condition.index >= 0:
            condition_type = checker_types.infer_expression_type(checker, arena, condition, source, current_scope)
            if types.is_atomic_type(&checker.type_table, condition_type):
                condition_node = arena.nodes[condition.index]
                checker_core.emit_actual_type_error(
                    checker,
                    diagnostics.DiagnosticId.CHECK_400,
                    &condition_node,
                    condition_type,
                    source,
                )
    elif node.kind == syntax.SyntaxKind.MATCH_STMT:
        wildcard = variants.first_wildcard_before_last(arena, id)
        if wildcard.index >= 0:
            wildcard_node = arena.nodes[wildcard.index]
            checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_121, &wildcard_node)
            return
    elif node.kind == syntax.SyntaxKind.STATIC_ASSERT_DECL:
        static_assert = reflection.summarize_static_assert(arena, id)
        ignored_static_assert = static_assert
        assertion = checker_core.first_child(arena, id)
        if assertion.index >= 0:
            assertion_node = arena.nodes[assertion.index]
            if assertion_node.kind == syntax.SyntaxKind.EXPR_LITERAL and assertion_node.flags == cast[i32](token.TokenKind.FALSE):
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_214, &assertion_node)
                return
    elif node.kind == syntax.SyntaxKind.TYPE_GENERIC:
        checker_types.validate_hashable_collection_type(checker, arena, id, source, current_scope)
        generic_type = checker_core.resolve_type_node(checker, arena, id, source)
        if generic_type.index >= 0 and generic_type.index < cast[i32](len(checker.type_table.types)) and checker.type_table.types[generic_type.index].kind != types.TypeKind.ATOMIC and ownership.type_contains_atomic_storage(&checker.type_table, generic_type):
            checker_types.emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_395,
                id,
                generic_type,
                generic_type,
                source,
                "storage",
            )
        checker_types.record_user_type_specialization(checker, arena, id, source)
    for offset in range(0, node.child_count):
        validate_names_in_scope(checker, arena, arena.children[node.first_child + offset], source, current_scope, expected_return)


def declare_pattern_bindings(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.PATTERN_PATH:
        if node.flags == 0 and node.child_count == 1:
            name_id = arena.children[node.first_child]
            name = arena.nodes[name_id.index]
            if name.kind == syntax.SyntaxKind.NAME and is_pattern_binding_name(source, name.value_start, name.value_length):
                if checker.symbols.find_in_current_scope(source, current_scope, name.value_start, name.value_length).index < 0:
                    symbol = checker.symbols.add_symbol(
                        symbols.SymbolKind.LOCAL,
                        name.value_start,
                        name.value_length,
                        types.type_i32(),
                        name_id,
                        current_scope,
                        0,
                    )
                    checker.model.record_declaration_symbol(name_id, symbol)
                return
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind != syntax.SyntaxKind.NAME:
                declare_pattern_bindings(checker, arena, child_id, source, current_scope)
        return
    if node.kind == syntax.SyntaxKind.PATTERN_CAPTURE or node.kind == syntax.SyntaxKind.PATTERN_OR:
        for offset in range(0, node.child_count):
            declare_pattern_bindings(checker, arena, arena.children[node.first_child + offset], source, current_scope)


def validate_or_pattern_bindings(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.PATTERN_OR and node.child_count > 1:
        expected: List[String] = []
        collect_pattern_binding_names(arena, arena.children[node.first_child], source, expected)
        for offset in range(1, node.child_count):
            actual: List[String] = []
            collect_pattern_binding_names(arena, arena.children[node.first_child + offset], source, actual)
            if not pattern_binding_names_equal(&expected, &actual):
                checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_316, &node)
                return
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        if arena.nodes[child_id.index].kind != syntax.SyntaxKind.NAME:
            validate_or_pattern_bindings(checker, arena, child_id, source)


def collect_pattern_binding_names(arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, result: &List[String]) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.PATTERN_PATH:
        if node.flags == 0 and node.child_count == 1:
            name_id = arena.children[node.first_child]
            name = arena.nodes[name_id.index]
            if name.kind == syntax.SyntaxKind.NAME and is_pattern_binding_name(source, name.value_start, name.value_length):
                text = source[name.value_start:name.value_start + name.value_length]
                if not checker_core.string_list_contains(result, &text):
                    result.append(text[0:len(text)])
                return
        for offset in range(0, node.child_count):
            child_id = arena.children[node.first_child + offset]
            if arena.nodes[child_id.index].kind != syntax.SyntaxKind.NAME:
                collect_pattern_binding_names(arena, child_id, source, result)
        return
    if node.kind == syntax.SyntaxKind.PATTERN_CAPTURE or node.kind == syntax.SyntaxKind.PATTERN_OR:
        for offset in range(0, node.child_count):
            collect_pattern_binding_names(arena, arena.children[node.first_child + offset], source, result)


def pattern_binding_names_equal(left: &const List[String], right: &const List[String]) -> bool:
    if len(left) != len(right):
        return false
    for name in left:
        if not checker_core.string_list_contains(right, &name):
            return false
    return true


def is_pattern_binding_name(source: &const String, start: usize, length: usize) -> bool:
    if length <= 0:
        return false
    first = source.byte_at(start)
    return first >= 97 and first <= 122


def declare_for_each_target_if_missing(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    target = checker_core.first_child(arena, id)
    if target.index < 0:
        return
    target_node = arena.nodes[target.index]
    if target_node.kind != syntax.SyntaxKind.NAME:
        return
    if checker.symbols.find_in_scope(source, current_scope, target_node.value_start, target_node.value_length).index >= 0:
        return
    local_type = for_each_element_type(checker, arena, id, source, current_scope)
    if local_type.index < 0 or local_type.index == types.type_error().index:
        local_type = types.type_i32()
    symbol = checker.symbols.add_symbol(
        symbols.SymbolKind.LOCAL,
        target_node.value_start,
        target_node.value_length,
        local_type,
        target,
        current_scope,
        1,
    )
    checker.model.record_declaration_symbol(target, symbol)
    checker.model.record_expr_type(target, local_type)


def for_each_element_type(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> types.TypeId:
    iterable = for_each_iterable(arena, id)
    if iterable.index < 0:
        return types.type_error()
    iterable_type = checker_types.strip_collection_indirection(checker.type_table, checker_types.infer_expression_type(checker, arena, iterable, source, current_scope))
    if iterable_type.index < 0 or iterable_type.index >= cast[i32](len(checker.type_table.types)):
        return types.type_error()
    record = checker.type_table.types[iterable_type.index]
    if record.kind == types.TypeKind.LIST or record.kind == types.TypeKind.SET:
        return record.inner
    if record.kind == types.TypeKind.MAP:
        return record.inner
    if types.is_map_view_kind(record.kind):
        if record.inner.index < 0 or record.inner.index >= cast[i32](len(checker.type_table.types)):
            return types.type_error()
        map_record = checker.type_table.types[record.inner.index]
        if map_record.kind != types.TypeKind.MAP:
            return types.type_error()
        if record.kind == types.TypeKind.MAP_KEYS:
            return map_record.inner
        if record.kind == types.TypeKind.MAP_VALUES:
            return map_record.second
        tuple_args: List[types.TypeId] = []
        tuple_args.append(map_record.inner)
        tuple_args.append(map_record.second)
        return checker.type_table.tuple_from_args(tuple_args)
    return types.type_error()


def for_each_iterable(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind != syntax.SyntaxKind.NAME and not checker_core.is_type_kind(child.kind) and child.kind != syntax.SyntaxKind.BLOCK:
            return child_id
    return syntax.missing_node()


def validate_set_compound_assignment(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    operator = arena.nodes[id.index].flags
    if operator != cast[i32](token.TokenKind.PIPE_ASSIGN) and operator != cast[i32](token.TokenKind.AMPERSAND_ASSIGN) and operator != cast[i32](token.TokenKind.MINUS_ASSIGN) and operator != cast[i32](token.TokenKind.CARET_ASSIGN):
        return
    target = checker_core.first_child(arena, id)
    value = checker_core.second_child(arena, id)
    if target.index < 0 or value.index < 0:
        return
    target_type = checker_types.strip_collection_indirection(checker.type_table, checker_types.infer_expression_type(checker, arena, target, source, current_scope))
    if not checker_types.semantic_type_is_kind(checker.type_table, target_type, types.TypeKind.SET):
        return
    value_type = checker_types.strip_collection_indirection(checker.type_table, checker_types.infer_expression_type(checker, arena, value, source, current_scope))
    if not checker.type_table.same(target_type, value_type):
        value_node = arena.nodes[value.index]
        checker_core.emit_type_mismatch(checker, &value_node, target_type, value_type, source)


def declare_assignment_target_if_missing(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    target = checker_core.first_child(arena, id)
    if target.index < 0:
        return
    target_node = arena.nodes[target.index]
    if target_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return
    if checker.symbols.find_in_scope(source, current_scope, target_node.value_start, target_node.value_length).index >= 0:
        return
    value = checker_core.second_child(arena, id)
    local_type = checker_types.infer_expression_type(checker, arena, value, source, current_scope)
    if local_type.index >= 0 and local_type.index < cast[i32](len(checker.type_table.types)):
        inferred = checker.type_table.types[local_type.index]
        if inferred.kind == types.TypeKind.MAP and not checker_types.semantic_type_is_hashable(checker.type_table, inferred.inner, source):
            value_node = arena.nodes[value.index]
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_297,
                &value_node,
                inferred.inner,
                source,
            )
        elif inferred.kind == types.TypeKind.SET and not checker_types.semantic_type_is_hashable(checker.type_table, inferred.inner, source):
            value_node = arena.nodes[value.index]
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_300,
                &value_node,
                inferred.inner,
                source,
            )
    if local_type.index == types.type_error().index:
        local_type = types.type_i32()
    symbol = checker.symbols.add_symbol(
        symbols.SymbolKind.LOCAL,
        target_node.value_start,
        target_node.value_length,
        local_type,
        target,
        current_scope,
        0,
    )
    checker.model.record_declaration_symbol(target, symbol)


def validate_var_decl(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    annotation = checker_core.find_child_type(arena, id)
    if annotation.index >= 0:
        annotation_type = checker_core.resolve_type_node(checker, arena, annotation, source)
        checker.model.record_type_node(annotation, annotation_type)
        if types.is_atomic_type(&checker.type_table, annotation_type):
            validate_atomic_declaration(checker, arena, id, source, current_scope, annotation_type, false)
            return
        if ownership.type_contains_atomic_storage(&checker.type_table, annotation_type):
            annotation_node = arena.nodes[annotation.index]
            checker_types.emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_395,
                annotation,
                annotation_type,
                annotation_type,
                source,
                "storage",
            )
    initializer = checker_core.last_child(arena, id)
    if initializer.index < 0:
        return
    if annotation.index < 0:
        inferred = checker_types.infer_expression_type(checker, arena, initializer, source, current_scope)
        if inferred.index < 0 or inferred.index >= cast[i32](len(checker.type_table.types)):
            return
        declared = checker.symbols.find_in_current_scope(source, current_scope, arena.nodes[id.index].value_start, arena.nodes[id.index].value_length)
        if declared.index >= 0:
            checker.symbols.symbols[declared.index].type_id = inferred
        inferred_type = checker.type_table.types[inferred.index]
        initializer_node = arena.nodes[initializer.index]
        if inferred_type.kind == types.TypeKind.ATOMIC:
            checker_types.emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_399,
                initializer,
                inferred,
                inferred,
                source,
                "initialization",
            )
        elif ownership.type_contains_atomic_storage(&checker.type_table, inferred):
            checker_types.emit_ownership_failure(
                checker,
                arena,
                diagnostics.DiagnosticId.CHECK_395,
                initializer,
                inferred,
                inferred,
                source,
                "initialization",
            )
        elif inferred_type.kind == types.TypeKind.MAP and not checker_types.semantic_type_is_hashable(checker.type_table, inferred_type.inner, source):
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_297,
                &initializer_node,
                inferred_type.inner,
                source,
            )
        elif inferred_type.kind == types.TypeKind.SET and not checker_types.semantic_type_is_hashable(checker.type_table, inferred_type.inner, source):
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_300,
                &initializer_node,
                inferred_type.inner,
                source,
            )
        checker_types.validate_partial_move_source(checker, arena, initializer, inferred, inferred, source, current_scope)
        return
    annotation_type = checker_core.resolve_type_node(checker, arena, annotation, source)
    checker.model.record_type_node(annotation, annotation_type)
    initializer_type = checker_types.infer_expression_type(checker, arena, initializer, source, current_scope)
    if initializer_matches_nominal_annotation(checker, arena, initializer, annotation_type, source):
        initializer_type = annotation_type
        checker.model.record_expr_type(initializer, annotation_type)
    initializer_node = arena.nodes[initializer.index]
    if checker_types.is_mutable_reference_type(&checker.type_table, annotation_type):
        checker_types.validate_ordered_lock_element_mutation(checker, arena, initializer, source, current_scope)
    if initializer_type.index >= 0 and initializer_type.index != types.type_error().index and not checker_types.types_compatible(checker, annotation_type, initializer_type):
        if types.is_atomic_type(&checker.type_table, initializer_type):
            checker_core.emit_actual_type_error(
                checker,
                diagnostics.DiagnosticId.CHECK_400,
                &initializer_node,
                initializer_type,
                source,
            )
        else:
            checker_core.emit_type_mismatch(
                checker,
                &initializer_node,
                annotation_type,
                initializer_type,
                source,
            )
    checker_types.validate_partial_move_source(checker, arena, initializer, initializer_type, annotation_type, source, current_scope)


def validate_atomic_global(checker: &checker_core.Checker, arena: &const syntax.SyntaxArena, id: NodeId, source: &const String, current_scope: symbols.ScopeId) -> void:
    symbol = symbols.missing_symbol()
    for binding: semantic.NodeSymbolBinding in checker.model.declaration_symbols:
        if binding.node.index == id.index:
            symbol = binding.symbol
    if symbol.index < 0:
        return
    atomic_type = checker.symbols.symbols[symbol.index].type_id
    if not types.is_atomic_type(&checker.type_table, atomic_type):
        return
    validate_atomic_declaration(checker, arena, id, source, current_scope, atomic_type, true)


def validate_atomic_declaration(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
    atomic_type: types.TypeId,
    is_global: bool,
) -> void:
    node = arena.nodes[id.index]
    storage_atomic_type = types.strip_const(&checker.type_table, atomic_type)
    atomic_record = checker.type_table.types[storage_atomic_type.index]
    initializer = atomic_declaration_initializer(arena, id)
    if initializer.index < 0:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_397, &node)
        return
    if node.flags == 1 or storage_atomic_type.index != atomic_type.index:
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_398, &node)
    initializer_type = checker_types.infer_expression_type(checker, arena, initializer, source, current_scope)
    initializer_node = arena.nodes[initializer.index]
    element_kind = types.atomic_type_element_kind(&checker.type_table, storage_atomic_type)
    if is_global and not atomic_global_initializer_is_constant(checker, arena, initializer, source, current_scope):
        checker_core.emit_error_at(checker, diagnostics.DiagnosticId.CHECK_018, &initializer_node)
    if types.is_atomic_type(&checker.type_table, initializer_type):
        checker_types.emit_ownership_failure(
            checker,
            arena,
            diagnostics.DiagnosticId.CHECK_399,
            initializer,
            initializer_type,
            storage_atomic_type,
            source,
            "initialization",
        )
    elif not checker_types.atomic_value_type_is_compatible(checker, element_kind, initializer_type, source):
        checker_core.emit_type_mismatch(
            checker,
            &initializer_node,
            atomic_record.inner,
            initializer_type,
            source,
        )
    flags: i32 = 4
    if is_global:
        flags = flags | 8
    missing = syntax.missing_node()
    checker.model.record_atomic_intrinsic(
        id,
        semantic.AtomicIntrinsicKind.INIT,
        element_kind,
        storage_atomic_type,
        atomic_record.inner,
        storage_atomic_type,
        missing,
        initializer,
        missing,
        initializer,
        missing,
        semantic.AtomicArgumentRole.VALUE,
        semantic.AtomicArgumentRole.NONE,
        flags,
    )


def atomic_global_initializer_is_constant(
    checker: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    if id.index < 0:
        return false
    node = arena.nodes[id.index]
    if node.kind == syntax.SyntaxKind.EXPR_LITERAL:
        return true
    if node.kind == syntax.SyntaxKind.EXPR_UNARY:
        return atomic_global_initializer_is_constant(checker, arena, checker_core.first_child(arena, id), source, current_scope)
    if node.kind == syntax.SyntaxKind.EXPR_BINARY:
        return atomic_global_initializer_is_constant(checker, arena, checker_core.first_child(arena, id), source, current_scope) and atomic_global_initializer_is_constant(checker, arena, checker_core.second_child(arena, id), source, current_scope)
    if node.kind == syntax.SyntaxKind.EXPR_CAST and node.child_count > 1:
        return atomic_global_initializer_is_constant(checker, arena, arena.children[node.first_child + 1], source, current_scope)
    if node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        return atomic_global_attribute_is_enum_member(checker, arena, id, source, current_scope)
    return false


def atomic_global_attribute_is_enum_member(
    checker: &const checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    id: NodeId,
    source: &const String,
    current_scope: symbols.ScopeId,
) -> bool:
    receiver = checker_core.first_child(arena, id)
    if receiver.index < 0:
        return false
    receiver_node = arena.nodes[receiver.index]
    if receiver_node.kind == syntax.SyntaxKind.EXPR_NAME:
        found = checker.symbols.find_in_scope(source, current_scope, receiver_node.value_start, receiver_node.value_length)
        return found.index >= 0 and checker.symbols.symbols[found.index].kind == symbols.SymbolKind.ENUM
    if receiver_node.kind != syntax.SyntaxKind.EXPR_ATTRIBUTE:
        return false
    module = checker_core.first_child(arena, receiver)
    enum_name = checker_core.second_child(arena, receiver)
    if module.index < 0 or enum_name.index < 0:
        return false
    module_node = arena.nodes[module.index]
    enum_node = arena.nodes[enum_name.index]
    if module_node.kind != syntax.SyntaxKind.EXPR_NAME or enum_node.kind != syntax.SyntaxKind.NAME:
        return false
    qualified_name = source[module_node.value_start:module_node.value_start + module_node.value_length] + "." + source[enum_node.value_start:enum_node.value_start + enum_node.value_length]
    return checker_core.string_list_contains(&checker.imported_enum_names, &qualified_name)


def atomic_declaration_initializer(arena: &const syntax.SyntaxArena, id: NodeId) -> NodeId:
    annotation = checker_core.find_child_type(arena, id)
    candidate = checker_core.last_child(arena, id)
    if candidate.index < 0 or candidate.index == annotation.index:
        return syntax.missing_node()
    candidate_node = arena.nodes[candidate.index]
    if candidate_node.kind == syntax.SyntaxKind.NAME or checker_core.is_type_kind(candidate_node.kind):
        return syntax.missing_node()
    return candidate


def initializer_matches_nominal_annotation(
    checker: &checker_core.Checker,
    arena: &const syntax.SyntaxArena,
    initializer: NodeId,
    annotation_type: types.TypeId,
    source: &const String,
) -> bool:
    if initializer.index < 0 or annotation_type.index < 0 or annotation_type.index >= cast[i32](len(checker.type_table.types)):
        return false
    annotation = checker.type_table.types[annotation_type.index]
    if not types.is_nominal_kind(annotation.kind) or annotation.name_length == 0:
        return false
    initializer_node = arena.nodes[initializer.index]
    if initializer_node.kind != syntax.SyntaxKind.EXPR_CALL:
        return false
    callee = checker_core.first_child(arena, initializer)
    if callee.index < 0:
        return false
    callee_node = arena.nodes[callee.index]
    owner = callee
    if callee_node.kind == syntax.SyntaxKind.EXPR_ATTRIBUTE:
        owner = checker_core.first_child(arena, callee)
    if owner.index < 0:
        return false
    owner_node = arena.nodes[owner.index]
    if owner_node.kind != syntax.SyntaxKind.EXPR_NAME:
        return false
    return symbols.range_equals(source, annotation.name_start, annotation.name_length, owner_node.value_start, owner_node.value_length)
