    )
    write_test_text(
        extern_import_format_path[0:len(extern_import_format_path)],
        "# formatting-only comment\n\nextern import \"stdlib.h\"\n",
    )
    write_test_text(
        extern_import_insert_path[0:len(extern_import_insert_path)],
        "extern import \"assert.h\"\nextern import \"ctype.h\"\nextern import \"math.h\"\n",
    )
    write_test_text(
        extern_import_reorder_path[0:len(extern_import_reorder_path)],
        "extern import \"math.h\"\nextern import \"ctype.h\"\n",
    )
    write_test_text(
        ordinary_import_path[0:len(ordinary_import_path)],
        "import ordinary_import_b\nimport ordinary_import_router\n\n\ndef probe() -> i32:\n    return ordinary_import_router.route()\n",
    )
    command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        repository.clone(),
    ]
    result = process.run(command)
    selected_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        selected_path,
    ]
    selected = process.run(selected_command)
    implementation_command: List[String] = [
