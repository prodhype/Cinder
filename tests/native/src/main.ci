        "1",
    ]
    target_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/model.ci:2",
    ]
    constructor = process.run(constructor_context)
    variant_constructor = process.run(variant_constructor_context)
    variant_fstring = process.run(variant_fstring_context)
    target = process.run(target_impact)
    ok = (
        constructor.exit_code == 0
        and variant_constructor.exit_code == 0
        and variant_fstring.exit_code == 0
        and target.exit_code == 0
        and contains(&constructor.stdout, "symbol: cache::function:construct_entry_only")
        and contains(&constructor.stdout, "type: void")
        and contains(&constructor.stdout, "DEPENDS ON\n- model::struct:CacheEntry")
        and contains(
            &variant_constructor.stdout,
            "symbol: cache::function:construct_token",
        )
        and contains(
            &variant_constructor.stdout,
            "model::variant-case:Token.Integer",
        )
        and not contains(
            &variant_constructor.stdout,
            "model::variant-case:Token.End",
        )
        and contains(
            &variant_fstring.stdout,
            "symbol: cache::function:format_constructed_token",
        )
        and contains(
            &variant_fstring.stdout,
            "model::variant-case:Token.Integer",
        )
        and not contains(
            &variant_fstring.stdout,
            "model::variant-case:Token.End",
        )
        and contains(&target.stdout, "cache::function:construct_entry_only")
    )
    expect(state, "semantic queries record module-qualified constructor uses", ok)
    if not ok:
        report_process_failure(&constructor.stdout, &constructor.stderr)
        report_process_failure(
            &variant_constructor.stdout,
            &variant_constructor.stderr,
        )
        report_process_failure(
            &variant_fstring.stdout,
            &variant_fstring.stderr,
        )
        report_process_failure(&target.stdout, &target.stderr)


def test_import_type_resolution(state: &TestState) -> void:
    qualified_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:44",
    ]
    shadowed_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:48",
    ]
    imported_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:52",
    ]
    field_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/cache.ci:57",
    ]
    target_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/type_targets.ci:6",
    ]
    method_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/type_targets.ci:2",
    ]
    qualified = process.run(qualified_context)
    shadowed = process.run(shadowed_context)
    imported = process.run(imported_context)
    field = process.run(field_context)
    target = process.run(target_impact)
    method = process.run(method_impact)
    ok = (
        qualified.exit_code == 0
        and shadowed.exit_code == 0
        and imported.exit_code == 0
        and field.exit_code == 0
        and target.exit_code == 0
        and method.exit_code == 0
        and contains(&qualified.stdout, "DEPENDS ON\n- type_targets::struct:Target")
        and contains(&qualified.stdout, "type: type_targets.Target")
        and not contains(&qualified.stdout, "type_targets::method:Holder.Target")
        and not contains(&shadowed.stdout, "type_targets::struct:Target")
        and not contains(&shadowed.stdout, "type_targets::method:Holder.Target")
        and contains(&imported.stdout, "DEPENDS ON\n- type_targets::struct:Target")
        and contains(&imported.stdout, "type: Target")
        and contains(&field.stdout, "symbol: cache::field:QualifiedHolder.entry")
        and contains(&field.stdout, "type: model.CacheEntry")
        and contains(&target.stdout, "main::function:use_qualified_target")
        and contains(&target.stdout, "main::function:use_imported_target")
        and contains(&target.stdout, "main::function:export_spaced_qualified_target")
        and contains(&target.stdout, "C ABI sensitive")
        and not contains(&target.stdout, "main::function-template:identity")
        and not contains(&method.stdout, "main::function:use_qualified_target")
    )
    expect(state, "semantic queries resolve imported types without false edges", ok)
    if not ok:
        report_process_failure(&qualified.stdout, &qualified.stderr)
        report_process_failure(&shadowed.stdout, &shadowed.stderr)
        report_process_failure(&imported.stdout, &imported.stderr)
        report_process_failure(&field.stdout, &field.stderr)
        report_process_failure(&target.stdout, &target.stderr)
        report_process_failure(&method.stdout, &method.stderr)


def test_ownership_use_resolution(state: &TestState) -> void:
    discard_void_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:13",
        "--depth",
        "0",
    ]
    discard_value_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:17",
        "--depth",
        "0",
    ]
    argument_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:21",
        "--depth",
        "0",
    ]
    return_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:25",
        "--depth",
        "0",
    ]
    void_return_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:29",
        "--depth",
        "0",
    ]
    explicit_address_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/ownership_uses.ci:36",
        "--depth",
        "0",
    ]
    discard_void = process.run(discard_void_command)
    discard_value = process.run(discard_value_command)
    argument = process.run(argument_command)
    returned = process.run(return_command)
    void_return = process.run(void_return_command)
    explicit_address = process.run(explicit_address_command)
    ok = (
        discard_void.exit_code == 0
        and discard_value.exit_code == 0
        and argument.exit_code == 0
        and returned.exit_code == 0
        and void_return.exit_code == 0
        and explicit_address.exit_code == 0
        and contains(&discard_void.stdout, "uses: copy=0, move=0, borrow=0, address=0")
        and contains(&discard_value.stdout, "uses: copy=0, move=0, borrow=0, address=0")
        and contains(&argument.stdout, "uses: copy=1, move=0, borrow=0, address=0")
        and contains(&returned.stdout, "uses: copy=1, move=0, borrow=0, address=0")
        and contains(&void_return.stdout, "uses: copy=0, move=0, borrow=0, address=0")
        and contains(&explicit_address.stdout, "uses: copy=0, move=0, borrow=2, address=2")
    )
    expect(state, "context counts transfer and explicit address uses", ok)
    if not ok:
        report_process_failure(&discard_void.stdout, &discard_void.stderr)
        report_process_failure(&discard_value.stdout, &discard_value.stderr)
        report_process_failure(&argument.stdout, &argument.stderr)
        report_process_failure(&returned.stdout, &returned.stderr)
        report_process_failure(&void_return.stdout, &void_return.stderr)
        report_process_failure(&explicit_address.stdout, &explicit_address.stderr)


def test_semantic_query_diagnostics(state: &TestState) -> void:
    target = state.root + "/tests/cases/semantic_context/src/cache.ci:999"
    command: List[String] = [
        state.compiler.clone(),
        "context",
        target,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 2
        and len(result.stdout) == 0
        and contains(&result.stderr, "line is outside the source file")
    )
    expect(state, "semantic queries reject invalid locations", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_semantic_diff_missing_manifest(state: &TestState) -> void:
    missing_manifest = state.workspace + "/missing-semantic-diff-project/cinder.toml"
    command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        missing_manifest,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 1
        and len(result.stdout) == 0
        and contains(
            &result.stderr,
            "analysis error: project error: manifest file not found:",
        )
    )
    expect(state, "semantic-diff rejects a missing manifest path", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_semantic_diff(state: &TestState) -> void:
    repository = state.workspace + "/semantic-diff-project"
    source_dir = repository + "/src"
    create: List[String] = ["mkdir", "-p", source_dir.clone()]
    if process.run(create).exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        return
    write_test_text(
        repository + "/cinder.toml",
        "[project]\nname = \"semantic_diff_fixture\"\nsource-root = \"src\"\nentry = \"main.ci\"\n",
    )
    source_path = source_dir + "/main.ci"
    write_test_text(
        source_path[0:len(source_path)],
        semantic_diff_stress_source(96, false),
    )
    selected_path = source_dir + "/selected.ci"
    write_test_text(
        selected_path[0:len(selected_path)],
        "def selected(value: i32) -> i32:\n    return value\n",
    )
    implementation_path = source_dir + "/implementation.ci"
    write_test_text(
        implementation_path[0:len(implementation_path)],
        "def implementation_probe() -> i32:\n    return 1\n",
    )
    literal_format_path = source_dir + "/literal_format.ci"
    write_test_text(
        literal_format_path[0:len(literal_format_path)],
        "def literal_format_probe() -> i32:\n    return 1_000\n\n\ndef literal_case_probe() -> f64:\n    return cast[f64](0XAF + 0B10 + 0O7) + 1E6\n",
    )
    literal_change_path = source_dir + "/literal_change.ci"
    write_test_text(
        literal_change_path[0:len(literal_change_path)],
        "def literal_change_probe() -> i32:\n    return 1_000\n",
    )
    fstring_format_path = source_dir + "/fstring_format.ci"
    write_test_text(
        fstring_format_path[0:len(fstring_format_path)],
        "const LIMIT: i32 = 42\n\n\ndef fstring_format_probe() -> i32:\n    print(f\"limit={LIMIT:d}\")\n    return 0\n",
    )
    fstring_change_path = source_dir + "/fstring_change.ci"
    write_test_text(
        fstring_change_path[0:len(fstring_change_path)],
        "const LIMIT: i32 = 42\n\n\ndef fstring_change_probe() -> i32:\n    print(f\"limit={LIMIT}\")\n    return 0\n",
    )
    type_format_model_path = source_dir + "/type_format_model.ci"
    write_test_text(
        type_format_model_path[0:len(type_format_model_path)],
        "struct Item:\n    value: i32\n",
    )
    type_format_path = source_dir + "/type_format.ci"
    write_test_text(
        type_format_path[0:len(type_format_path)],
        "import type_format_model\n\n\nstruct Holder:\n    items: List[i32]\n    item: type_format_model.Item\n    nested: List[type_format_model.Item]\n    array_items: type_format_model.Item[1_000]\n",
    )
    enum_format_path = source_dir + "/enum_format.ci"
    write_test_text(
        enum_format_path[0:len(enum_format_path)],
        "enum FormatEnum:\n    neg = -0XAF\n    pos = 42\n",
    )
    assertion_path = source_dir + "/assertion.ci"
    write_test_text(
        assertion_path[0:len(assertion_path)],
        "struct Pair:\n    first: i32\n    second: i32\n\nstatic_assert(size_of(Pair) >= 8)\n",
    )
    assertion_format_path = source_dir + "/assertion_format.ci"
    write_test_text(
        assertion_format_path[0:len(assertion_format_path)],
        "static_assert(true)\n",
    )
    assertion_insert_values_path = source_dir + "/assertion_insert_values.ci"
    write_test_text(
        assertion_insert_values_path[0:len(assertion_insert_values_path)],
        "const LIMIT: i32 = 3\n",
    )
    assertion_insert_path = source_dir + "/assertion_insert.ci"
    write_test_text(
        assertion_insert_path[0:len(assertion_insert_path)],
        "import assertion_insert_values\n\nstatic_assert(assertion_insert_values.LIMIT == 3)\nstatic_assert(2 == 2)\n",
    )
    lock_order_insert_path = source_dir + "/lock_order_insert.ci"
    write_test_text(
        lock_order_insert_path[0:len(lock_order_insert_path)],
        "lock database\nlock cache\nlock metrics\nlockorder cache before metrics\n",
    )
    extern_import_path = source_dir + "/extern_import.ci"
    write_test_text(
        extern_import_path[0:len(extern_import_path)],
        "extern import \"ctype.h\"\n",
    )
    extern_import_format_path = source_dir + "/extern_import_format.ci"
    write_test_text(
        extern_import_format_path[0:len(extern_import_format_path)],
        "extern import \"stdlib.h\"\n",
    )
    extern_import_insert_path = source_dir + "/extern_import_insert.ci"
    write_test_text(
        extern_import_insert_path[0:len(extern_import_insert_path)],
        "extern import \"ctype.h\"\nextern import \"math.h\"\n",
    )
    extern_import_reorder_path = source_dir + "/extern_import_reorder.ci"
    write_test_text(
        extern_import_reorder_path[0:len(extern_import_reorder_path)],
        "extern import \"ctype.h\"\nextern import \"math.h\"\n",
    )
    ordinary_import_a_path = source_dir + "/ordinary_import_a.ci"
    write_test_text(
        ordinary_import_a_path[0:len(ordinary_import_a_path)],
        "def value() -> i32:\n    return 1\n",
    )
    ordinary_import_b_path = source_dir + "/ordinary_import_b.ci"
    write_test_text(
        ordinary_import_b_path[0:len(ordinary_import_b_path)],
        "def value() -> i32:\n    return 2\n",
    )
    ordinary_import_router_path = source_dir + "/ordinary_import_router.ci"
    write_test_text(
        ordinary_import_router_path[0:len(ordinary_import_router_path)],
        "import ordinary_import_a\nimport ordinary_import_b\n\n\ndef route() -> i32:\n    return ordinary_import_a.value() + ordinary_import_b.value()\n",
    )
    ordinary_import_path = source_dir + "/ordinary_import.ci"
    write_test_text(
        ordinary_import_path[0:len(ordinary_import_path)],
        "import ordinary_import_a\nimport ordinary_import_router\n\n\ndef probe() -> i32:\n    return ordinary_import_router.route()\n",
    )
    init: List[String] = ["git", "-C", repository.clone(), "init", "-q"]
    add: List[String] = ["git", "-C", repository.clone(), "add", "."]
    commit: List[String] = [
        "git",
        "-C",
        repository.clone(),
        "-c",
        "user.name=Cinder Tests",
        "-c",
        "user.email=cinder@example.invalid",
        "commit",
        "-q",
        "-m",
        "baseline",
    ]
    initialized = process.run(init)
    added = process.run(add)
    committed = process.run(commit)
    if initialized.exit_code != 0 or added.exit_code != 0 or committed.exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        report_process_failure(&committed.stdout, &committed.stderr)
        return
    standalone_repository = state.workspace + "/semantic-diff-standalone"
    standalone_create: List[String] = ["mkdir", "-p", standalone_repository.clone()]
    if process.run(standalone_create).exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        return
    standalone_path = standalone_repository + "/selected.ci"
    write_test_text(
        standalone_path[0:len(standalone_path)],
        "def selected(value: i32) -> i32:\n    return value\n",
    )
    standalone_init: List[String] = ["git", "-C", standalone_repository.clone(), "init", "-q"]
    standalone_add: List[String] = ["git", "-C", standalone_repository.clone(), "add", "."]
    standalone_commit: List[String] = [
        "git",
        "-C",
        standalone_repository.clone(),
        "-c",
        "user.name=Cinder Tests",
        "-c",
        "user.email=cinder@example.invalid",
        "commit",
        "-q",
        "-m",
        "baseline",
    ]
    standalone_initialized = process.run(standalone_init)
    standalone_added = process.run(standalone_add)
    standalone_committed = process.run(standalone_commit)
    if (
        standalone_initialized.exit_code != 0
        or standalone_added.exit_code != 0
        or standalone_committed.exit_code != 0
    ):
        expect(state, "semantic-diff reports canonical changes", false)
        report_process_failure(&standalone_committed.stdout, &standalone_committed.stderr)
        return
    write_test_text(
        selected_path[0:len(selected_path)],
        "def selected(\n    value: i32,\n) -> i32:\n    return value\n",
    )
    write_test_text(
        implementation_path[0:len(implementation_path)],
        "def implementation_probe() -> i32:\n    return 2\n",
    )
    write_test_text(
        literal_format_path[0:len(literal_format_path)],
        "def literal_format_probe() -> i32:\n    return 1000\n\n\ndef literal_case_probe() -> f64:\n    return cast[f64](0xaf + 0b10 + 0o7) + 1e6\n",
    )
    write_test_text(
        literal_change_path[0:len(literal_change_path)],
        "def literal_change_probe() -> i32:\n    return 1_001\n",
    )
    write_test_text(
        fstring_format_path[0:len(fstring_format_path)],
        "const LIMIT: i32 = 42\n\n\ndef fstring_format_probe() -> i32:\n    print(f\"limit={ LIMIT : d }\")\n    return 0\n",
    )
    write_test_text(
        fstring_change_path[0:len(fstring_change_path)],
        "const LIMIT: i32 = 42\n\n\ndef fstring_change_probe() -> i32:\n    print(f\"limit={LIMIT + 1}\")\n    return 0\n",
    )
    write_test_text(
        source_path,
        semantic_diff_stress_source(97, true),
    )
    write_test_text(
        type_format_path[0:len(type_format_path)],
        "import type_format_model\n\n\nstruct Holder:\n    items: List[\n        i32\n    ]\n    item: type_format_model . Item\n    nested: List[\n        type_format_model . Item\n    ]\n    array_items: type_format_model . Item[1000]\n",
    )
    write_test_text(
        enum_format_path[0:len(enum_format_path)],
        "enum FormatEnum:\n    neg = - 0xaf\n    pos = 42\n",
    )
    write_test_text(
        assertion_path[0:len(assertion_path)],
        "struct Pair:\n    first: i32\n    second: i32\n\nstatic_assert(size_of(Pair) >= 4)\n",
    )
    write_test_text(
        assertion_format_path[0:len(assertion_format_path)],
        "# formatting-only comment\n\nstatic_assert(true)\n",
