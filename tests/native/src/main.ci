import cinder
import process


struct TestState:
    compiler: String
    root: String
    workspace: String
    passed: i32
    failed: i32


def main(argc: i32, argv: **char) -> i32:
    if argc != 3:
        cinder.write_stderr("usage: cinder-native-tests <compiler> <repository-root>\n")
        return 2

    compiler = String(argv[1])
    root = String(argv[2])
    workspace = root + "/.cinder/native-tests"
    state = TestState(
        compiler=compiler,
        root=root,
        workspace=workspace,
        passed=0,
        failed=0,
    )

    cleanup: List[String] = ["rm", "-rf", state.workspace.clone()]
    cleanup_result = process.run(cleanup)
    if cleanup_result.exit_code != 0:
        cinder.write_stderr(cleanup_result.stderr)
        return 2

    create: List[String] = ["mkdir", "-p", state.workspace.clone()]
    create_result = process.run(create)
    if create_result.exit_code != 0:
        cinder.write_stderr(create_result.stderr)
        return 2

    test_check_valid(&state)
    test_check_diagnostic(&state)
    test_check_ir_validation(&state)
    test_emit_c(&state)
    test_emit_c_is_deterministic(&state)
    test_emit_project(&state)
    test_build_and_run(&state)
    test_multi_module_project(&state)
    test_atomic_codegen(&state)
    test_context_capsule(&state)
    test_impact_report(&state)
    test_inherited_field_resolution(&state)
    test_deep_field_chain_resolution(&state)
    test_enum_member_resolution(&state)
    test_decorator_line_resolution(&state)
    test_impact_caller_truncation(&state)
    test_import_call_resolution(&state)
    test_fstring_call_resolution(&state)
    test_import_value_resolution(&state)
    test_import_constructor_resolution(&state)
    test_import_type_resolution(&state)
    test_ownership_use_resolution(&state)
    test_semantic_query_diagnostics(&state)
    test_semantic_diff_missing_manifest(&state)
    test_semantic_diff(&state)

    print("native compiler tests:", state.passed, "passed,", state.failed, "failed")
    if state.failed > 0:
        return 1
    return 0


def test_check_valid(state: &TestState) -> void:
    source = state.root + "/examples/hello.ci"
    command: List[String] = [
        state.compiler.clone(),
        "check",
        source,
    ]
    result = process.run(command)
    ok = result.exit_code == 0 and contains(&result.stdout, "ok: ")
    expect(state, "check accepts a valid source file", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_check_diagnostic(state: &TestState) -> void:
    source_path = state.root + "/tests/cases/invalid_syntax.ci"
    command: List[String] = [
        state.compiler.clone(),
        "check",
        source_path,
    ]
    result = process.run(command)
    ok = result.exit_code == 1 and contains(&result.stderr, "project error: lexing failed")
    expect(state, "check reports source diagnostics", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_check_ir_validation(state: &TestState) -> void:
    source_path = state.root + "/examples/atomics.ci"
    check_command: List[String] = [
        state.compiler.clone(),
        "check",
        source_path,
    ]
    context_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/compiler_selfhost/src/emit_project.ci:115",
    ]
    checked = process.run(check_command)
    context = process.run(context_command)
    ok = (
        checked.exit_code == 0
        and context.exit_code == 0
        and contains(&checked.stdout, "ok: ")
        and contains(&context.stdout, "CALLS")
        and contains(&context.stdout, "backend_ir::function:lower")
        and not contains(&context.stdout, "emit_project::function:compile_project")
    )
    expect(state, "check validates atomic IR without retaining compiled modules", ok)
    if not ok:
        report_process_failure(&checked.stdout, &checked.stderr)
        report_process_failure(&context.stdout, &context.stderr)


def test_emit_c(state: &TestState) -> void:
    source = state.root + "/examples/classes.ci"
    command: List[String] = [
        state.compiler.clone(),
        "emit-c",
        source,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 0
        and contains(&result.stdout, "int main(void)")
        and contains(&result.stdout, "typedef struct")
        and not contains(&result.stdout, "#include \"cinder_gen/")
    )
    expect(state, "emit-c produces self-contained C11", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_emit_c_is_deterministic(state: &TestState) -> void:
    source = state.root + "/examples/reflection.ci"
    first_command: List[String] = [
        state.compiler.clone(),
        "emit-c",
        source.clone(),
    ]
    second_command: List[String] = [
        state.compiler.clone(),
        "emit-c",
        source,
    ]
    first = process.run(first_command)
    second = process.run(second_command)
    ok = (
        first.exit_code == 0
        and second.exit_code == 0
        and first.stdout == second.stdout
    )
    expect(state, "emit-c is deterministic", ok)
    if not ok:
        report_process_failure(&first.stdout, &first.stderr)
        report_process_failure(&second.stdout, &second.stderr)


def test_emit_project(state: &TestState) -> void:
    source = state.root + "/examples/module_project"
    output = state.workspace + "/module-project-output"
    command: List[String] = [
        state.compiler.clone(),
        "emit-project",
        source,
        "-o",
        output.clone(),
    ]
    result = process.run(command)
    header = output + "/cinder_gen/model.cinder.h"
    generated_source = output + "/cinder_gen/main.c"
    header_test: List[String] = ["test", "-f", header]
    source_test: List[String] = ["test", "-f", generated_source]
    has_header = process.run(header_test)
    has_source = process.run(source_test)
    ok = (
        result.exit_code == 0
        and has_header.exit_code == 0
        and has_source.exit_code == 0
    )
    expect(state, "emit-project writes module headers and sources", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_build_and_run(state: &TestState) -> void:
    source = state.root + "/examples/hello.ci"
    output = state.workspace + "/hello"
    build_dir = state.workspace + "/hello-build"
    command: List[String] = [
        state.compiler.clone(),
        "run",
        source,
        "-o",
        output,
        "--build-dir",
        build_dir,
    ]
    result = process.run(command)
    ok = result.exit_code == 0 and result.stdout == "Hello from Cinder!\n"
    expect(state, "run builds and executes a native program", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_multi_module_project(state: &TestState) -> void:
    source = state.root + "/examples/module_project"
    output = state.workspace + "/module-project"
    build_dir = state.workspace + "/module-project-build"
    command: List[String] = [
        state.compiler.clone(),
        "run",
        source,
        "-o",
        output,
        "--build-dir",
        build_dir,
    ]
    result = process.run(command)
    ok = result.exit_code == 0 and result.stdout == "value=42\n"
    expect(state, "run resolves and links a multi-module project", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_atomic_codegen(state: &TestState) -> void:
    source = state.root + "/examples/atomics.ci"
    command: List[String] = [
        state.compiler.clone(),
        "emit-c",
        source,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 0
        and contains(&result.stdout, "#include <stdatomic.h>")
        and contains(&result.stdout, "atomic_compare_exchange_strong_explicit")
        and contains(&result.stdout, "memory_order_seq_cst")
    )
    expect(state, "emit-c lowers atomic operations to C11 atomics", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_context_capsule(state: &TestState) -> void:
    target = state.root + "/tests/cases/semantic_context/src/cache.ci:16"
    command: List[String] = [
        state.compiler.clone(),
        "context",
        target.clone(),
        "--depth",
        "2",
    ]
    repeated_command: List[String] = [
        state.compiler.clone(),
        "context",
        target,
        "--depth",
        "2",
    ]
    first = process.run(command)
    second = process.run(repeated_command)
    method_target = state.root + "/tests/cases/semantic_context/src/cache.ci:24"
    method_command: List[String] = [
        state.compiler.clone(),
        "context",
        method_target,
    ]
    method = process.run(method_command)
    qualified_target = state.root + "/tests/cases/semantic_context/src/cache.ci:29"
    qualified_command: List[String] = [
        state.compiler.clone(),
        "context",
        qualified_target,
    ]
    qualified = process.run(qualified_command)
    lock_target = state.root + "/tests/cases/semantic_context/src/lock_collision.ci:7"
    lock_command: List[String] = [
        state.compiler.clone(),
        "context",
        lock_target,
    ]
    lock_context = process.run(lock_command)
    lock_order_target = state.root + "/tests/cases/semantic_context/src/lock_collision.ci:11"
    lock_order_command: List[String] = [
        state.compiler.clone(),
        "context",
        lock_order_target.clone(),
    ]
    lock_order_context = process.run(lock_order_command)
    lock_order_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        lock_order_target,
    ]
    lock_order_impact = process.run(lock_order_impact_command)
    collision_target = state.root + "/tests/cases/semantic_context/src/lock_collision.ci:2"
    collision_command: List[String] = [
        state.compiler.clone(),
        "impact",
        collision_target,
    ]
    collision = process.run(collision_command)
    extern_import_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:10",
    ]
    extern_import = process.run(extern_import_command)
    extern_block_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:11",
    ]
    extern_block = process.run(extern_block_command)
    extern_child_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:12",
    ]
    extern_child = process.run(extern_child_command)
    import_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:1",
    ]
    import_context = process.run(import_command)
    ok = (
        first.exit_code == 0
        and second.exit_code == 0
        and method.exit_code == 0
        and qualified.exit_code == 0
        and lock_context.exit_code == 0
        and lock_order_context.exit_code == 0
        and lock_order_impact.exit_code == 0
        and collision.exit_code == 0
        and extern_import.exit_code == 0
        and extern_block.exit_code == 0
        and extern_child.exit_code == 0
        and import_context.exit_code == 0
        and first.stdout == second.stdout
        and contains(&first.stdout, "def cache_get(key: i32) -> model.CacheEntry:")
        and contains(&first.stdout, "type: model.CacheEntry")
        and contains(&first.stdout, "cache::function:hash_key")
        and contains(&first.stdout, "main::function:lookup_twice")
        and contains(&first.stdout, "lock_effect: unknown (unresolved callee)")
        and contains(&first.stdout, "cache::lock:database < cache::lock:cache")
        and contains(&first.stdout, "allocation: unknown")
        and contains(&method.stdout, "cache::method:CacheWorker.refresh")
        and contains(&method.stdout, "lock_effect: acquires cache.cache")
        and contains(&qualified.stdout, "model::struct:CacheEntry")
        and contains(&lock_context.stdout, "symbol: lock_collision::lock:cache")
        and contains(&lock_context.stdout, "lock_collision::lock:database < lock_collision::lock:cache")
        and contains(&lock_order_context.stdout, "lockorder cache before metrics")
        and contains(&lock_order_context.stdout, "symbol: lock_collision::lock-order:order_0")
        and contains(&lock_order_context.stdout, "kind: lock-order")
        and contains(
            &lock_order_context.stdout,
            "lock_collision::lock:cache < lock_collision::lock:metrics (explicit)",
        )
        and not contains(&lock_order_context.stdout, "LOCK ORDER\n(none)")
        and contains(
            &lock_order_impact.stdout,
            "lock-before: lock_collision::lock:cache -> lock_collision::lock:metrics",
        )
        and contains(&collision.stdout, "symbol: lock_collision::method:Holder.cache")
        and contains(&collision.stdout, "LOCK IMPACT\n(none)")
        and contains(&extern_import.stdout, "extern import \"stdlib.h\"")
        and contains(&extern_import.stdout, "symbol: main::extern-import:import_0")
        and contains(&extern_import.stdout, "abi: C")
        and contains(&extern_block.stdout, "extern \"C\":")
        and contains(&extern_block.stdout, "symbol: main::extern-block:block_0")
        and contains(&extern_block.stdout, "kind: extern-block")
        and contains(&extern_block.stdout, "abi: C")
        and contains(&extern_child.stdout, "symbol: main::function:abs")
        and contains(&import_context.stdout, "import cache")
        and contains(&import_context.stdout, "symbol: main::import:import_0")
        and contains(&import_context.stdout, "abi: not applicable")
    )
    expect(state, "context emits deterministic compiler-derived facts", ok)
    if not ok:
        report_process_failure(&first.stdout, &first.stderr)
        report_process_failure(&method.stdout, &method.stderr)
        report_process_failure(&qualified.stdout, &qualified.stderr)
        report_process_failure(&lock_context.stdout, &lock_context.stderr)
        report_process_failure(&lock_order_context.stdout, &lock_order_context.stderr)
        report_process_failure(&lock_order_impact.stdout, &lock_order_impact.stderr)
        report_process_failure(&collision.stdout, &collision.stderr)
        report_process_failure(&extern_import.stdout, &extern_import.stderr)
        report_process_failure(&extern_block.stdout, &extern_block.stderr)
        report_process_failure(&extern_child.stdout, &extern_child.stderr)
        report_process_failure(&import_context.stdout, &import_context.stderr)


def test_impact_report(state: &TestState) -> void:
    nominal_target = state.root + "/tests/cases/semantic_context/src/model.ci:2"
    field_target = state.root + "/tests/cases/semantic_context/src/model.ci:3"
    indexed_context_target = state.root + "/tests/cases/semantic_context/src/cache.ci:79"
    unrelated_method_target = state.root + "/tests/cases/semantic_context/src/model.ci:14"
    borrowed_target = state.root + "/tests/cases/semantic_context/src/model.ci:18"
    status_target = state.root + "/tests/cases/semantic_context/src/model.ci:22"
    status_member_target = state.root + "/tests/cases/semantic_context/src/model.ci:23"
    abi_payload_target = state.root + "/tests/cases/semantic_context/src/model.ci:27"
    abi_indirect_payload_target = state.root + "/tests/cases/semantic_context/src/model.ci:35"
    abi_nested_payload_target = state.root + "/tests/cases/semantic_context/src/model.ci:48"
    abi_nested_indirect_payload_target = state.root + "/tests/cases/semantic_context/src/model.ci:56"
    interface_target = state.root + "/tests/cases/semantic_context/src/model.ci:6"
    nominal_command: List[String] = [
        state.compiler.clone(),
        "impact",
        nominal_target,
    ]
    field_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        field_target.clone(),
    ]
    indexed_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        indexed_context_target,
        "--depth",
        "1",
    ]
    field_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        field_target,
    ]
    unrelated_method_command: List[String] = [
        state.compiler.clone(),
        "impact",
        unrelated_method_target,
    ]
    borrowed_command: List[String] = [
        state.compiler.clone(),
        "impact",
        borrowed_target,
    ]
    status_command: List[String] = [
        state.compiler.clone(),
        "impact",
        status_target,
    ]
    status_member_command: List[String] = [
        state.compiler.clone(),
        "impact",
        status_member_target,
    ]
    abi_payload_command: List[String] = [
        state.compiler.clone(),
        "impact",
        abi_payload_target,
    ]
    abi_indirect_payload_command: List[String] = [
        state.compiler.clone(),
        "impact",
        abi_indirect_payload_target,
    ]
    abi_nested_payload_command: List[String] = [
        state.compiler.clone(),
        "impact",
        abi_nested_payload_target,
    ]
    abi_nested_indirect_payload_command: List[String] = [
        state.compiler.clone(),
        "impact",
        abi_nested_indirect_payload_target,
    ]
    interface_command: List[String] = [
        state.compiler.clone(),
        "impact",
        interface_target,
    ]
    nominal = process.run(nominal_command)
    field_context = process.run(field_context_command)
    indexed_context = process.run(indexed_context_command)
    field_impact = process.run(field_impact_command)
    unrelated_method = process.run(unrelated_method_command)
    borrowed = process.run(borrowed_command)
    status = process.run(status_command)
    status_member = process.run(status_member_command)
    abi_payload = process.run(abi_payload_command)
    abi_indirect_payload = process.run(abi_indirect_payload_command)
    abi_nested_payload = process.run(abi_nested_payload_command)
    abi_nested_indirect_payload = process.run(abi_nested_indirect_payload_command)
    interface = process.run(interface_command)
    ok = (
        nominal.exit_code == 0
        and field_context.exit_code == 0
        and indexed_context.exit_code == 0
        and field_impact.exit_code == 0
        and unrelated_method.exit_code == 0
        and borrowed.exit_code == 0
        and status.exit_code == 0
        and status_member.exit_code == 0
        and abi_payload.exit_code == 0
        and abi_indirect_payload.exit_code == 0
        and abi_nested_payload.exit_code == 0
        and abi_nested_indirect_payload.exit_code == 0
        and interface.exit_code == 0
        and contains(&nominal.stdout, "model::struct:CacheEntry")
        and contains(&nominal.stdout, "TYPE / MEMBER CONSUMERS")
        and contains(&nominal.stdout, "cache::function:cache_get")
        and contains(&nominal.stdout, "cache::function:cache_entry_value")
        and contains(&nominal.stdout, "cache::function:export_cache_entry")
        and contains(&nominal.stdout, "cache::function:consume_cache_entry")
        and contains(&nominal.stdout, "cache::function:construct_entry_only")
        and contains(&nominal.stdout, "C ABI sensitive")
        and not contains(&nominal.stdout, "source-level layout sensitive")
        and contains(&nominal.stdout, "emitted runtime reflection metadata")
        and contains(&field_context.stdout, "model::field:CacheEntry.value")
        and contains(&field_context.stdout, "reflected: yes")
        and contains(&indexed_context.stdout, "DEPENDS ON")
        and contains(&indexed_context.stdout, "model::field:CacheEntry.value")
        and contains(&field_impact.stdout, "cache::function:cache_entry_value")
        and contains(&field_impact.stdout, "cache::function:format_cache_entry")
        and contains(&field_impact.stdout, "cache::function:indexed_cache_entry_value")
        and contains(&field_impact.stdout, "main::function:lookup_twice")
        and contains(&field_impact.stdout, "main::function:cinder_cache_lookup")
        and contains(&field_impact.stdout, "emitted runtime reflection metadata")
        and contains(&field_impact.stdout, "C ABI sensitive")
        and not contains(&field_impact.stdout, "source-level layout sensitive")
        and not contains(&unrelated_method.stdout, "emitted runtime reflection metadata")
        and not contains(&unrelated_method.stdout, "C ABI sensitive")
        and not contains(&nominal.stdout, "transitive caller search truncated")
        and contains(&borrowed.stdout, "model::struct:BorrowedEntry")
        and contains(&borrowed.stdout, "cache::function:export_borrowed_entry_value")
        and contains(&borrowed.stdout, "source-level layout sensitive")
        and not contains(&borrowed.stdout, "C ABI sensitive")
        and contains(&status.stdout, "model::enum:Status")
        and contains(&status.stdout, "cache::function:export_status")
        and contains(&status.stdout, "C ABI sensitive")
        and not contains(&status.stdout, "no explicit C ABI exposure recorded")
        and contains(&status_member.stdout, "model::enum-member:Status.Ready")
        and contains(&status_member.stdout, "C ABI sensitive")
        and contains(&abi_payload.stdout, "model::struct:AbiPayload")
        and contains(&abi_payload.stdout, "cache::function:export_abi_box")
        and contains(&abi_payload.stdout, "C ABI sensitive")
        and not contains(&abi_payload.stdout, "source-level layout sensitive")
        and contains(&abi_indirect_payload.stdout, "model::struct:AbiIndirectPayload")
        and contains(
            &abi_indirect_payload.stdout,
            "cache::function:export_abi_ref_box",
        )
        and contains(&abi_indirect_payload.stdout, "source-level layout sensitive")
        and not contains(&abi_indirect_payload.stdout, "C ABI sensitive")
        and contains(
            &abi_nested_payload.stdout,
            "model::struct:AbiNestedPayload",
        )
        and contains(
            &abi_nested_payload.stdout,
            "model::field:AbiNestedHolder.payload",
        )
        and contains(&abi_nested_payload.stdout, "C ABI sensitive")
        and not contains(
            &abi_nested_payload.stdout,
            "source-level layout sensitive",
        )
        and contains(
            &abi_nested_indirect_payload.stdout,
            "model::struct:AbiNestedIndirectPayload",
        )
        and contains(
            &abi_nested_indirect_payload.stdout,
            "model::field:AbiNestedRefHolder.payload",
        )
        and contains(
            &abi_nested_indirect_payload.stdout,
            "source-level layout sensitive",
        )
        and not contains(
            &abi_nested_indirect_payload.stdout,
            "C ABI sensitive",
        )
        and contains(&interface.stdout, "model::class:Store")
        and contains(&interface.stdout, "source-level layout sensitive")
        and not contains(&interface.stdout, "C ABI sensitive")
    )
    expect(state, "impact reports semantic consumers and exposure", ok)
    if not ok:
        report_process_failure(&nominal.stdout, &nominal.stderr)
        report_process_failure(&field_context.stdout, &field_context.stderr)
        report_process_failure(&indexed_context.stdout, &indexed_context.stderr)
        report_process_failure(&field_impact.stdout, &field_impact.stderr)
        report_process_failure(&unrelated_method.stdout, &unrelated_method.stderr)
        report_process_failure(&borrowed.stdout, &borrowed.stderr)
        report_process_failure(&status.stdout, &status.stderr)
        report_process_failure(&status_member.stdout, &status_member.stderr)
        report_process_failure(&abi_payload.stdout, &abi_payload.stderr)
        report_process_failure(
            &abi_indirect_payload.stdout,
            &abi_indirect_payload.stderr,
        )
        report_process_failure(
            &abi_nested_payload.stdout,
            &abi_nested_payload.stderr,
        )
        report_process_failure(
            &abi_nested_indirect_payload.stdout,
            &abi_nested_indirect_payload.stderr,
        )
        report_process_failure(&interface.stdout, &interface.stderr)


def test_inherited_field_resolution(state: &TestState) -> void:
    example = state.root + "/examples/classes.ci"
    ordinary_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        example + ":30",
        "--depth",
        "1",
    ]
    fstring_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        example + ":34",
        "--depth",
        "1",
    ]
    typed_fstring_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/cache.ci:75",
        "--depth",
        "1",
    ]
    impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":5",
    ]
    base_method_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":11",
    ]
    override_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        example + ":27",
        "--depth",
        "1",
    ]
    override_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":27",
    ]
    ordinary_context = process.run(ordinary_context_command)
    fstring_context = process.run(fstring_context_command)
    typed_fstring_context = process.run(typed_fstring_context_command)
    impact = process.run(impact_command)
    base_method_impact = process.run(base_method_impact_command)
    override_context = process.run(override_context_command)
    override_impact = process.run(override_impact_command)
    ok = (
        ordinary_context.exit_code == 0
        and fstring_context.exit_code == 0
        and typed_fstring_context.exit_code == 0
        and impact.exit_code == 0
        and base_method_impact.exit_code == 0
        and override_context.exit_code == 0
        and override_impact.exit_code == 0
        and contains(
            &ordinary_context.stdout,
            "classes::field:Shape.name",
        )
        and contains(
            &fstring_context.stdout,
            "classes::field:Shape.name",
        )
        and contains(
            &typed_fstring_context.stdout,
            "model::field:CacheEntry.value",
        )
        and contains(
            &impact.stdout,
            "classes::method:Circle.print_inherited_name",
        )
        and contains(
            &impact.stdout,
            "classes::method:Circle.format_inherited_name",
        )
        and contains(&impact.stdout, "C ABI sensitive")
        and not contains(&impact.stdout, "source-level layout sensitive")
        and contains(
            &base_method_impact.stdout,
            "classes::method:Circle.area",
        )
        and not contains(&base_method_impact.stdout, "C ABI sensitive")
        and contains(
            &override_context.stdout,
            "DEPENDS ON\n- classes::method:Shape.area",
        )
        and not contains(&override_impact.stdout, "C ABI sensitive")
    )
    expect(
        state,
        "semantic queries resolve inherited fields and embedded base ABI",
        ok,
    )
    if not ok:
        report_process_failure(
            &ordinary_context.stdout,
            &ordinary_context.stderr,
        )
        report_process_failure(
            &fstring_context.stdout,
            &fstring_context.stderr,
        )
        report_process_failure(
            &typed_fstring_context.stdout,
            &typed_fstring_context.stderr,
        )
        report_process_failure(&impact.stdout, &impact.stderr)
        report_process_failure(
            &base_method_impact.stdout,
            &base_method_impact.stderr,
        )
        report_process_failure(&override_context.stdout, &override_context.stderr)
        report_process_failure(&override_impact.stdout, &override_impact.stderr)


def test_deep_field_chain_resolution(state: &TestState) -> void:
