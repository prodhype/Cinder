def test_enum_member_resolution(state: &TestState) -> void:
    example = state.root + "/examples/types_and_results.ci"
    explicit_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        example + ":3",
    ]
    negative_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":2",
    ]
    explicit_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":3",
    ]
    enum_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        example + ":1",
    ]
    fstring_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        example + ":40",
    ]
    qualified_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/examples/module_project/src/model.ci:2",
    ]
    explicit_context = process.run(explicit_context_command)
    negative_impact = process.run(negative_impact_command)
    explicit_impact = process.run(explicit_impact_command)
    enum_impact = process.run(enum_impact_command)
    fstring_context = process.run(fstring_context_command)
    qualified_impact = process.run(qualified_impact_command)
    ok = (
        explicit_context.exit_code == 0
        and negative_impact.exit_code == 0
        and explicit_impact.exit_code == 0
        and enum_impact.exit_code == 0
        and fstring_context.exit_code == 0
        and qualified_impact.exit_code == 0
        and contains(
            &explicit_context.stdout,
            "symbol: types_and_results::enum-member:ParseError.too_large",
        )
        and contains(&explicit_context.stdout, "kind: enum-member")
        and contains(&explicit_context.stdout, "too_large = 10")
        and contains(
            &negative_impact.stdout,
            "symbol: types_and_results::enum-member:ParseError.negative",
        )
        and contains(&negative_impact.stdout, "types_and_results::function:parse")
        and contains(
            &negative_impact.stdout,
            "types_and_results::function:negative_error",
        )
        and not contains(
            &negative_impact.stdout,
            "types_and_results::function:too_large_error",
        )
        and not contains(
            &negative_impact.stdout,
            "types_and_results::function:increment",
        )
        and not contains(
            &negative_impact.stdout,
            "types_and_results::function:format_too_large_error",
        )
        and contains(
            &explicit_impact.stdout,
            "symbol: types_and_results::enum-member:ParseError.too_large",
        )
        and contains(&explicit_impact.stdout, "types_and_results::function:parse")
        and contains(
            &explicit_impact.stdout,
            "types_and_results::function:too_large_error",
        )
        and contains(
            &explicit_impact.stdout,
            "types_and_results::function:format_too_large_error",
        )
        and not contains(
            &explicit_impact.stdout,
            "types_and_results::function:negative_error",
        )
        and not contains(
            &explicit_impact.stdout,
            "types_and_results::function:increment",
        )
        and contains(
            &enum_impact.stdout,
            "symbol: types_and_results::enum:ParseError",
        )
        and contains(&enum_impact.stdout, "types_and_results::function:increment")
        and contains(
            &fstring_context.stdout,
            "types_and_results::enum-member:ParseError.too_large",
        )
        and contains(
            &qualified_impact.stdout,
            "symbol: model::enum-member:ParseError.negative",
        )
        and contains(
            &qualified_impact.stdout,
            "support.parser::function:parse",
        )
    )
    expect(state, "enum members are addressable with precise consumers", ok)
    if not ok:
        report_process_failure(&explicit_context.stdout, &explicit_context.stderr)
        report_process_failure(&negative_impact.stdout, &negative_impact.stderr)
        report_process_failure(&explicit_impact.stdout, &explicit_impact.stderr)
        report_process_failure(&enum_impact.stdout, &enum_impact.stderr)
        report_process_failure(&fstring_context.stdout, &fstring_context.stderr)
        report_process_failure(&qualified_impact.stdout, &qualified_impact.stderr)


def test_decorator_line_resolution(state: &TestState) -> void:
    reflected_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/model.ci:1",
    ]
    abstract_method_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/model.ci:7",
    ]
    exported_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:34",
    ]
    override_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/model.ci:14",
    ]
    reflected = process.run(reflected_command)
    abstract_method = process.run(abstract_method_command)
    exported = process.run(exported_command)
    overridden = process.run(override_command)
    ok = (
        reflected.exit_code == 0
        and abstract_method.exit_code == 0
        and exported.exit_code == 0
        and overridden.exit_code == 0
        and contains(&reflected.stdout, "symbol: model::struct:CacheEntry")
        and contains(&reflected.stdout, "reflected: yes")
        and contains(&reflected.stdout, "TARGET\n@reflect\nstruct CacheEntry:")
        and contains(&reflected.stdout, "RELEVANT SOURCE\n@reflect\nstruct CacheEntry:")
        and contains(&abstract_method.stdout, "symbol: model::method:Store.lookup")
        and contains(&abstract_method.stdout, "modifiers: abstractmethod")
        and contains(&abstract_method.stdout, "TARGET\n@abstractmethod\n    def lookup(self, key: i32) -> CacheEntry:")
        and contains(&abstract_method.stdout, "RELEVANT SOURCE\n@abstractmethod\n    def lookup(self, key: i32) -> CacheEntry:")
        and contains(&exported.stdout, "symbol: main::function:cinder_cache_lookup")
        and contains(&exported.stdout, "exported: yes")
        and contains(&exported.stdout, "TARGET\n@export\ndef cinder_cache_lookup(key: i32) -> i32:")
        and contains(&exported.stdout, "RELEVANT SOURCE\n@export\ndef cinder_cache_lookup(key: i32) -> i32:")
        and contains(&overridden.stdout, "symbol: model::method:MemoryStore.lookup")
        and contains(&overridden.stdout, "modifiers: override")
        and contains(&overridden.stdout, "TARGET\n@override\n    def lookup(self, key: i32) -> CacheEntry:")
        and contains(&overridden.stdout, "RELEVANT SOURCE\n@override\n    def lookup(self, key: i32) -> CacheEntry:")
    )
    expect(state, "semantic queries retain decorators in declaration source", ok)
    if not ok:
        report_process_failure(&reflected.stdout, &reflected.stderr)
        report_process_failure(&abstract_method.stdout, &abstract_method.stderr)
        report_process_failure(&exported.stdout, &exported.stderr)
        report_process_failure(&overridden.stdout, &overridden.stderr)


def test_impact_caller_truncation(state: &TestState) -> void:
    project_dir = state.workspace + "/impact-caller-project"
    source_dir = project_dir + "/src"
    create: List[String] = ["mkdir", "-p", source_dir.clone()]
    if process.run(create).exit_code != 0:
        expect(state, "impact reports transitive caller truncation", false)
        return
    write_test_text(
        project_dir + "/cinder.toml",
        "[project]\nname = \"impact_caller_fixture\"\nsource-root = \"src\"\nentry = \"main.ci\"\n",
    )
    source_path = source_dir + "/main.ci"
    write_test_text(source_path[0:len(source_path)], caller_chain_source(66))
    command: List[String] = [
        state.compiler.clone(),
        "impact",
        source_path + ":1",
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 0
        and contains(&result.stdout, "- main::function:node_64")
        and not contains(&result.stdout, "- main::function:node_65")
        and not contains(&result.stdout, "- main::function:main")
        and contains(
            &result.stdout,
            "- transitive caller search truncated at 64 hops; additional callers may exist",
        )
    )
    expect(state, "impact reports transitive caller truncation", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_import_call_resolution(state: &TestState) -> void:
    shadow_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:20",
    ]
    top_level_context: List[String] = [
