def test_atomic_codegen(state: &TestState) -> void:
    source = state.root + "/examples/atomics.ci"
    command: List[String] = [
        state.compiler.clone(),
        "emit-c",
        source,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 0
        and contains(&result.stdout, "#include <stdatomic.h>")
        and contains(&result.stdout, "atomic_compare_exchange_strong_explicit")
        and contains(&result.stdout, "memory_order_seq_cst")
    )
    expect(state, "emit-c lowers atomic operations to C11 atomics", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_context_capsule(state: &TestState) -> void:
    target = state.root + "/tests/cases/semantic_context/src/cache.ci:15"
    command: List[String] = [
        state.compiler.clone(),
        "context",
        target.clone(),
        "--depth",
        "2",
    ]
    repeated_command: List[String] = [
        state.compiler.clone(),
        "context",
        target,
        "--depth",
        "2",
    ]
    first = process.run(command)
    second = process.run(repeated_command)
    method_target = state.root + "/tests/cases/semantic_context/src/cache.ci:23"
    method_command: List[String] = [
        state.compiler.clone(),
        "context",
        method_target,
    ]
    method = process.run(method_command)
    qualified_target = state.root + "/tests/cases/semantic_context/src/cache.ci:28"
    qualified_command: List[String] = [
        state.compiler.clone(),
        "context",
        qualified_target,
    ]
    qualified = process.run(qualified_command)
    lock_target = state.root + "/tests/cases/semantic_context/src/lock_collision.ci:7"
    lock_command: List[String] = [
        state.compiler.clone(),
        "context",
        lock_target,
    ]
    lock_context = process.run(lock_command)
    collision_target = state.root + "/tests/cases/semantic_context/src/lock_collision.ci:2"
    collision_command: List[String] = [
        state.compiler.clone(),
        "impact",
        collision_target,
    ]
    collision = process.run(collision_command)
    ok = (
        first.exit_code == 0
        and second.exit_code == 0
        and method.exit_code == 0
        and qualified.exit_code == 0
        and lock_context.exit_code == 0
        and collision.exit_code == 0
        and first.stdout == second.stdout
        and contains(&first.stdout, "def cache_get(key: i32) -> model.CacheEntry:")
        and contains(&first.stdout, "cache::function:hash_key")
        and contains(&first.stdout, "main::function:lookup_twice")
        and contains(&first.stdout, "lock_effect: unknown (unresolved callee)")
        and contains(&first.stdout, "cache::lock:database < cache::lock:cache")
        and contains(&first.stdout, "allocation: unknown")
        and contains(&method.stdout, "cache::method:CacheWorker.refresh")
        and contains(&method.stdout, "lock_effect: acquires cache.cache")
        and contains(&qualified.stdout, "DEPENDS ON\n- model::struct:CacheEntry")
        and contains(&lock_context.stdout, "symbol: lock_collision::lock:cache")
        and contains(&lock_context.stdout, "lock_collision::lock:database < lock_collision::lock:cache")
        and contains(&collision.stdout, "symbol: lock_collision::method:Holder.cache")
        and contains(&collision.stdout, "LOCK IMPACT\n(none)")
    )
    expect(state, "context emits deterministic compiler-derived facts", ok)
    if not ok:
        report_process_failure(&first.stdout, &first.stderr)
        report_process_failure(&method.stdout, &method.stderr)
        report_process_failure(&qualified.stdout, &qualified.stderr)
        report_process_failure(&lock_context.stdout, &lock_context.stderr)
        report_process_failure(&collision.stdout, &collision.stderr)


def test_impact_report(state: &TestState) -> void:
    nominal_target = state.root + "/tests/cases/semantic_context/src/model.ci:2"
    field_target = state.root + "/tests/cases/semantic_context/src/model.ci:3"
    unrelated_method_target = state.root + "/tests/cases/semantic_context/src/model.ci:14"
    nominal_command: List[String] = [
        state.compiler.clone(),
        "impact",
        nominal_target,
    ]
    field_context_command: List[String] = [
        state.compiler.clone(),
        "context",
        field_target.clone(),
    ]
    field_impact_command: List[String] = [
        state.compiler.clone(),
        "impact",
        field_target,
    ]
    unrelated_method_command: List[String] = [
        state.compiler.clone(),
        "impact",
        unrelated_method_target,
    ]
    nominal = process.run(nominal_command)
    field_context = process.run(field_context_command)
    field_impact = process.run(field_impact_command)
    unrelated_method = process.run(unrelated_method_command)
    ok = (
        nominal.exit_code == 0
        and field_context.exit_code == 0
        and field_impact.exit_code == 0
        and unrelated_method.exit_code == 0
        and contains(&nominal.stdout, "model::struct:CacheEntry")
        and contains(&nominal.stdout, "TYPE / MEMBER CONSUMERS")
        and contains(&nominal.stdout, "cache::function:cache_get")
        and contains(&nominal.stdout, "cache::function:cache_entry_value")
        and contains(&nominal.stdout, "source-level layout sensitive")
        and contains(&nominal.stdout, "emitted runtime reflection metadata")
        and contains(&field_context.stdout, "model::field:CacheEntry.value")
        and contains(&field_context.stdout, "reflected: yes")
        and contains(&field_impact.stdout, "emitted runtime reflection metadata")
        and not contains(&unrelated_method.stdout, "emitted runtime reflection metadata")
        and not contains(&nominal.stdout, "transitive caller search truncated")
    )
    expect(state, "impact reports semantic consumers and exposure", ok)
    if not ok:
        report_process_failure(&nominal.stdout, &nominal.stderr)
        report_process_failure(&field_context.stdout, &field_context.stderr)
        report_process_failure(&field_impact.stdout, &field_impact.stderr)
        report_process_failure(&unrelated_method.stdout, &unrelated_method.stderr)


def test_decorator_line_resolution(state: &TestState) -> void:
    reflected_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/model.ci:1",
    ]
    abstract_method_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/model.ci:7",
    ]
    exported_command: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:33",
    ]
    reflected = process.run(reflected_command)
    abstract_method = process.run(abstract_method_command)
    exported = process.run(exported_command)
    ok = (
        reflected.exit_code == 0
        and abstract_method.exit_code == 0
        and exported.exit_code == 0
        and contains(&reflected.stdout, "symbol: model::struct:CacheEntry")
        and contains(&reflected.stdout, "reflected: yes")
        and contains(&abstract_method.stdout, "symbol: model::method:Store.lookup")
        and contains(&abstract_method.stdout, "modifiers: abstractmethod")
        and contains(&exported.stdout, "symbol: main::function:cinder_cache_lookup")
        and contains(&exported.stdout, "exported: yes")
    )
    expect(state, "semantic queries locate declarations from decorator lines", ok)
    if not ok:
        report_process_failure(&reflected.stdout, &reflected.stderr)
        report_process_failure(&abstract_method.stdout, &abstract_method.stderr)
        report_process_failure(&exported.stdout, &exported.stderr)


def test_impact_caller_truncation(state: &TestState) -> void:
    project_dir = state.workspace + "/impact-caller-project"
    source_dir = project_dir + "/src"
    create: List[String] = ["mkdir", "-p", source_dir.clone()]
    if process.run(create).exit_code != 0:
        expect(state, "impact reports transitive caller truncation", false)
        return
    write_test_text(
        project_dir + "/cinder.toml",
        "[project]\nname = \"impact_caller_fixture\"\nsource-root = \"src\"\nentry = \"main.ci\"\n",
    )
    source_path = source_dir + "/main.ci"
    write_test_text(source_path[0:len(source_path)], caller_chain_source(66))
    command: List[String] = [
        state.compiler.clone(),
        "impact",
        source_path + ":1",
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 0
        and contains(&result.stdout, "- main::function:node_64")
        and not contains(&result.stdout, "- main::function:node_65")
        and not contains(&result.stdout, "- main::function:main")
        and contains(
            &result.stdout,
            "- transitive caller search truncated at 64 hops; additional callers may exist",
        )
    )
    expect(state, "impact reports transitive caller truncation", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_import_call_resolution(state: &TestState) -> void:
    shadow_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:20",
    ]
    top_level_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:24",
    ]
    instance_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:28",
    ]
    global_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:64",
    ]
    constant_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:65",
    ]
    field_receiver_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:75",
    ]
    action_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:15",
    ]
    inherited_method_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:2",
    ]
    inherited_method_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:2",
    ]
    direct_method_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:7",
    ]
    child_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:6",
    ]
    overridden_base_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/call_targets.ci:25",
    ]
    shadow = process.run(shadow_context)
    top_level = process.run(top_level_context)
    instance = process.run(instance_context)
    global = process.run(global_context)
    constant = process.run(constant_context)
    field_receiver = process.run(field_receiver_context)
    action = process.run(action_impact)
    inherited_context = process.run(inherited_method_context)
    inherited_method = process.run(inherited_method_impact)
    direct_method = process.run(direct_method_impact)
    child = process.run(child_impact)
    overridden_base = process.run(overridden_base_impact)
    ok = (
        shadow.exit_code == 0
        and top_level.exit_code == 0
        and instance.exit_code == 0
        and global.exit_code == 0
        and constant.exit_code == 0
        and field_receiver.exit_code == 0
        and action.exit_code == 0
        and inherited_context.exit_code == 0
        and inherited_method.exit_code == 0
        and direct_method.exit_code == 0
        and child.exit_code == 0
        and overridden_base.exit_code == 0
        and not contains(&shadow.stdout, "call_targets::function:action")
        and contains(&top_level.stdout, "call_targets::function:run")
        and not contains(&top_level.stdout, "call_targets::method:Child.run")
        and contains(&instance.stdout, "call_targets::method:Base.work")
        and contains(&instance.stdout, "call_targets::method:Child.run")
        and contains(&global.stdout, "call_targets::function:action")
        and contains(&constant.stdout, "call_targets::function:action")
        and contains(&field_receiver.stdout, "call_targets::method:Base.work")
        and not contains(&action.stdout, "main::function:call_shadowed")
        and contains(&action.stdout, "main::global:IMPORTED_GLOBAL")
        and contains(&action.stdout, "main::constant:IMPORTED_CONSTANT")
        and contains(&inherited_context.stdout, "reflected: yes")
        and contains(&inherited_method.stdout, "main::function:call_imported_method")
        and contains(&inherited_method.stdout, "main::method:ChildHolder.call")
        and contains(&inherited_method.stdout, "emitted runtime reflection metadata")
        and contains(&direct_method.stdout, "main::function:call_imported_method")
        and contains(&child.stdout, "DIRECT CALLERS\n(none)")
        and not contains(&overridden_base.stdout, "emitted runtime reflection metadata")
    )
    expect(state, "semantic queries resolve imported calls without false edges", ok)
    if not ok:
        report_process_failure(&shadow.stdout, &shadow.stderr)
        report_process_failure(&top_level.stdout, &top_level.stderr)
        report_process_failure(&instance.stdout, &instance.stderr)
        report_process_failure(&global.stdout, &global.stderr)
        report_process_failure(&constant.stdout, &constant.stderr)
        report_process_failure(&field_receiver.stdout, &field_receiver.stderr)
        report_process_failure(&action.stdout, &action.stderr)
        report_process_failure(&inherited_context.stdout, &inherited_context.stderr)
        report_process_failure(&inherited_method.stdout, &inherited_method.stderr)
        report_process_failure(&direct_method.stdout, &direct_method.stderr)
        report_process_failure(&child.stdout, &child.stderr)
        report_process_failure(&overridden_base.stdout, &overridden_base.stderr)


def test_import_value_resolution(state: &TestState) -> void:
    imported_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:56",
    ]
    qualified_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:78",
    ]
    shadowed_qualified_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:86",
    ]
    shadowed_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:60",
    ]
    target_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/value_targets.ci:1",
    ]
    imported = process.run(imported_context)
    qualified = process.run(qualified_context)
    shadowed_qualified = process.run(shadowed_qualified_context)
    shadowed = process.run(shadowed_context)
    target = process.run(target_impact)
    ok = (
        imported.exit_code == 0
        and qualified.exit_code == 0
        and shadowed_qualified.exit_code == 0
        and shadowed.exit_code == 0
        and target.exit_code == 0
        and contains(&imported.stdout, "DEPENDS ON\n- value_targets::constant:LIMIT")
        and contains(&qualified.stdout, "DEPENDS ON\n- value_targets::constant:LIMIT")
        and not contains(&shadowed_qualified.stdout, "value_targets::constant:LIMIT")
        and not contains(&shadowed.stdout, "value_targets::constant:LIMIT")
        and contains(&target.stdout, "main::function:read_imported_limit")
        and contains(&target.stdout, "main::function:read_qualified_limit")
        and not contains(&target.stdout, "main::function:read_shadowed_qualified_limit")
        and not contains(&target.stdout, "main::function:read_shadowed_limit")
    )
    expect(state, "semantic queries resolve imported values without false edges", ok)
    if not ok:
        report_process_failure(&imported.stdout, &imported.stderr)
        report_process_failure(&qualified.stdout, &qualified.stderr)
        report_process_failure(&shadowed_qualified.stdout, &shadowed_qualified.stderr)
        report_process_failure(&shadowed.stdout, &shadowed.stderr)
        report_process_failure(&target.stdout, &target.stderr)


def test_import_type_resolution(state: &TestState) -> void:
    qualified_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:44",
    ]
    shadowed_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:48",
    ]
    imported_context: List[String] = [
        state.compiler.clone(),
        "context",
        state.root + "/tests/cases/semantic_context/src/main.ci:52",
    ]
    target_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/type_targets.ci:6",
    ]
    method_impact: List[String] = [
        state.compiler.clone(),
        "impact",
        state.root + "/tests/cases/semantic_context/src/type_targets.ci:2",
    ]
    qualified = process.run(qualified_context)
    shadowed = process.run(shadowed_context)
    imported = process.run(imported_context)
    target = process.run(target_impact)
    method = process.run(method_impact)
    ok = (
        qualified.exit_code == 0
        and shadowed.exit_code == 0
        and imported.exit_code == 0
        and target.exit_code == 0
        and method.exit_code == 0
        and contains(&qualified.stdout, "DEPENDS ON\n- type_targets::struct:Target")
        and not contains(&qualified.stdout, "type_targets::method:Holder.Target")
        and not contains(&shadowed.stdout, "type_targets::struct:Target")
        and not contains(&shadowed.stdout, "type_targets::method:Holder.Target")
        and contains(&imported.stdout, "DEPENDS ON\n- type_targets::struct:Target")
        and contains(&target.stdout, "main::function:use_qualified_target")
        and contains(&target.stdout, "main::function:use_imported_target")
        and not contains(&target.stdout, "main::function-template:identity")
        and not contains(&method.stdout, "main::function:use_qualified_target")
    )
    expect(state, "semantic queries resolve imported types without false edges", ok)
    if not ok:
        report_process_failure(&qualified.stdout, &qualified.stderr)
        report_process_failure(&shadowed.stdout, &shadowed.stderr)
        report_process_failure(&imported.stdout, &imported.stderr)
        report_process_failure(&target.stdout, &target.stderr)
        report_process_failure(&method.stdout, &method.stderr)


def test_semantic_query_diagnostics(state: &TestState) -> void:
    target = state.root + "/tests/cases/semantic_context/src/cache.ci:999"
    command: List[String] = [
        state.compiler.clone(),
        "context",
        target,
    ]
    result = process.run(command)
    ok = (
        result.exit_code == 2
        and len(result.stdout) == 0
        and contains(&result.stderr, "line is outside the source file")
    )
    expect(state, "semantic queries reject invalid locations", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)


def test_semantic_diff(state: &TestState) -> void:
    repository = state.workspace + "/semantic-diff-project"
    source_dir = repository + "/src"
    create: List[String] = ["mkdir", "-p", source_dir.clone()]
    if process.run(create).exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        return
    write_test_text(
        repository + "/cinder.toml",
        "[project]\nname = \"semantic_diff_fixture\"\nsource-root = \"src\"\nentry = \"main.ci\"\n",
    )
    source_path = source_dir + "/main.ci"
    write_test_text(
        source_path[0:len(source_path)],
        semantic_diff_stress_source(96, false),
    )
    selected_path = source_dir + "/selected.ci"
    write_test_text(
        selected_path[0:len(selected_path)],
        "def selected(value: i32) -> i32:\n    return value\n",
    )
    implementation_path = source_dir + "/implementation.ci"
    write_test_text(
        implementation_path[0:len(implementation_path)],
        "def implementation_probe() -> i32:\n    return 1\n",
    )
    type_format_path = source_dir + "/type_format.ci"
    write_test_text(
        type_format_path[0:len(type_format_path)],
        "struct Holder:\n    items: List[i32]\n",
    )
    enum_format_path = source_dir + "/enum_format.ci"
    write_test_text(
        enum_format_path[0:len(enum_format_path)],
        "enum FormatEnum:\n    neg = -1\n    pos = 42\n",
    )
    assertion_path = source_dir + "/assertion.ci"
    write_test_text(
        assertion_path[0:len(assertion_path)],
        "struct Pair:\n    first: i32\n    second: i32\n\nstatic_assert(size_of(Pair) >= 8)\n",
    )
    assertion_format_path = source_dir + "/assertion_format.ci"
    write_test_text(
        assertion_format_path[0:len(assertion_format_path)],
        "static_assert(true)\n",
    )
    init: List[String] = ["git", "-C", repository.clone(), "init", "-q"]
    add: List[String] = ["git", "-C", repository.clone(), "add", "."]
    commit: List[String] = [
        "git",
        "-C",
        repository.clone(),
        "-c",
        "user.name=Cinder Tests",
        "-c",
        "user.email=cinder@example.invalid",
        "commit",
        "-q",
        "-m",
        "baseline",
    ]
    initialized = process.run(init)
    added = process.run(add)
    committed = process.run(commit)
    if initialized.exit_code != 0 or added.exit_code != 0 or committed.exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        report_process_failure(&committed.stdout, &committed.stderr)
        return
    standalone_repository = state.workspace + "/semantic-diff-standalone"
    standalone_create: List[String] = ["mkdir", "-p", standalone_repository.clone()]
    if process.run(standalone_create).exit_code != 0:
        expect(state, "semantic-diff reports canonical changes", false)
        return
    standalone_path = standalone_repository + "/selected.ci"
    write_test_text(
        standalone_path[0:len(standalone_path)],
        "def selected(value: i32) -> i32:\n    return value\n",
    )
    standalone_init: List[String] = ["git", "-C", standalone_repository.clone(), "init", "-q"]
    standalone_add: List[String] = ["git", "-C", standalone_repository.clone(), "add", "."]
    standalone_commit: List[String] = [
        "git",
        "-C",
        standalone_repository.clone(),
        "-c",
        "user.name=Cinder Tests",
        "-c",
        "user.email=cinder@example.invalid",
        "commit",
        "-q",
        "-m",
        "baseline",
    ]
    standalone_initialized = process.run(standalone_init)
    standalone_added = process.run(standalone_add)
    standalone_committed = process.run(standalone_commit)
    if (
        standalone_initialized.exit_code != 0
        or standalone_added.exit_code != 0
        or standalone_committed.exit_code != 0
    ):
        expect(state, "semantic-diff reports canonical changes", false)
        report_process_failure(&standalone_committed.stdout, &standalone_committed.stderr)
        return
    write_test_text(
        selected_path[0:len(selected_path)],
        "def selected(\n    value: i32,\n) -> i32:\n    return value\n",
    )
    write_test_text(
        implementation_path[0:len(implementation_path)],
        "def implementation_probe() -> i32:\n    return 2\n",
    )
    write_test_text(
        source_path,
        semantic_diff_stress_source(97, true),
    )
    write_test_text(
        type_format_path[0:len(type_format_path)],
        "struct Holder:\n    items: List[\n        i32\n    ]\n",
    )
    write_test_text(
        enum_format_path[0:len(enum_format_path)],
        "enum FormatEnum:\n    neg = - 1\n    pos = 42\n",
    )
    write_test_text(
        assertion_path[0:len(assertion_path)],
        "struct Pair:\n    first: i32\n    second: i32\n\nstatic_assert(size_of(Pair) >= 4)\n",
    )
    write_test_text(
        assertion_format_path[0:len(assertion_format_path)],
        "# formatting-only comment\n\nstatic_assert(true)\n",
    )
    command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        repository.clone(),
    ]
    result = process.run(command)
    selected_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        selected_path,
    ]
    selected = process.run(selected_command)
    implementation_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        implementation_path,
    ]
    implementation = process.run(implementation_command)
    type_format_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        type_format_path.clone(),
    ]
    type_format = process.run(type_format_command)
    enum_format_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        enum_format_path,
    ]
    enum_format = process.run(enum_format_command)
    assertion_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        assertion_path.clone(),
    ]
    assertion = process.run(assertion_command)
    assertion_format_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        assertion_format_path,
    ]
    assertion_format = process.run(assertion_format_command)
    write_test_text(
        type_format_path[0:len(type_format_path)],
        "struct Holder:\n    items: List[\n        i64\n    ]\n",
    )
    type_change_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        type_format_path,
    ]
    type_change = process.run(type_change_command)
    standalone_command: List[String] = [
        state.compiler.clone(),
        "semantic-diff",
        "HEAD",
        "--project",
        standalone_path,
    ]
    standalone = process.run(standalone_command)
    worktree_command: List[String] = [
        "git",
        "-C",
        repository,
        "worktree",
        "list",
        "--porcelain",
    ]
    worktrees = process.run(worktree_command)
    ok = (
        result.exit_code == 0
        and selected.exit_code == 0
        and implementation.exit_code == 0
        and type_format.exit_code == 0
        and enum_format.exit_code == 0
        and assertion.exit_code == 0
        and assertion_format.exit_code == 0
        and type_change.exit_code == 0
        and standalone.exit_code == 0
        and worktrees.exit_code == 0
        and contains(&result.stdout, "schema: cinder-semantic-v1")
        and contains(&result.stdout, "+ added main::function:node_96")
        and contains(&result.stdout, "- calls: main::function:main -> main::function:node_95")
        and contains(&result.stdout, "+ calls: main::function:main -> main::function:node_96")
        and contains(&result.stdout, "~ changed main::struct:LayoutStruct")
        and contains(&result.stdout, "~ changed main::class:LayoutClass")
        and contains(&result.stdout, "~ changed main::union:LayoutUnion")
        and contains(&result.stdout, "~ changed main::enum:LayoutEnum")
        and contains(&result.stdout, "~ changed main::enum:ValueEnum")
        and contains(&result.stdout, "~ changed main::variant:LayoutVariant")
        and contains(&result.stdout, "~ changed main::constant:multiline_value")
        and contains(&result.stdout, "~ changed main::function:multiline_signature")
        and contains(&result.stdout, "~ changed main::field:ModifierStruct.value")
        and contains(&result.stdout, "~ changed main::method:ModifierBase.apply")
        and contains(&result.stdout, "~ changed main::method:ModifierImpl.apply")
        and contains(&result.stdout, "~ changed main::class:MethodOrder")
        and contains(&result.stdout, "~ changed main::class:ReflectedMethodChild")
        and contains(&result.stdout, "~ changed main::class:MultilineDerived")
        and contains(&result.stdout, "members: main::field:LayoutStruct.first, main::field:LayoutStruct.second -> main::field:LayoutStruct.second, main::field:LayoutStruct.first")
        and contains(&result.stdout, "members: main::enum-member:LayoutEnum.first, main::enum-member:LayoutEnum.second -> main::enum-member:LayoutEnum.second, main::enum-member:LayoutEnum.first")
        and contains(&result.stdout, "members: main::enum-member:ValueEnum.first=1, main::enum-member:ValueEnum.second=7 -> main::enum-member:ValueEnum.first=3, main::enum-member:ValueEnum.second=7")
        and contains(&result.stdout, "members: main::variant-case:LayoutVariant.First, main::variant-case:LayoutVariant.Second -> main::variant-case:LayoutVariant.Second, main::variant-case:LayoutVariant.First")
        and contains(&result.stdout, "members: main::method:MethodOrder.first, main::method:MethodOrder.second -> main::method:MethodOrder.second, main::method:MethodOrder.first")
        and contains(&result.stdout, "members: main::method:ReflectedMethodChild.own_method, main::method:UnreflectedMethodBase.inherited_first, main::method:UnreflectedMethodBase.inherited_second -> main::method:ReflectedMethodChild.own_method, main::method:UnreflectedMethodBase.inherited_second, main::method:UnreflectedMethodBase.inherited_first")
        and contains(&result.stdout, "signature: const multiline_value: i32 = (\n    1\n) -> const multiline_value: i32 = (\n    2\n)")
        and contains(&result.stdout, "signature: def multiline_signature(\n    value: i32,\n) -> i32: -> def multiline_signature(\n    value: i64,\n) -> i32:")
        and contains(&result.stdout, "signature: class MultilineDerived(\n    SpecializedBase[i32],\n): -> class MultilineDerived(\n    SpecializedBase[i64],\n):")
        and contains(&result.stdout, "modifiers: private -> none")
        and contains(&result.stdout, "modifiers: abstractmethod -> none")
        and contains(&result.stdout, "modifiers: override -> none")
        and contains(&result.stdout, "~ changed main::function:node_0")
        and contains(
            &result.stdout,
            "  reachable callers:\n    - main::function:node_1\n",
        )
        and contains(&result.stdout, "    - main::function:node_96\n")
        and contains(&result.stdout, "    - main::function:main\n")
        and contains(&selected.stdout, "NO SEMANTIC CHANGES")
        and not contains(&selected.stdout, "~ changed selected::function:selected")
        and contains(
            &implementation.stdout,
            "~ changed implementation::function:implementation_probe",
        )
        and contains(&implementation.stdout, "implementation: changed")
        and not contains(&implementation.stdout, "NO SEMANTIC CHANGES")
        and contains(&type_format.stdout, "NO SEMANTIC CHANGES")
        and not contains(&type_format.stdout, "~ changed type_format::field:Holder.items")
        and contains(&enum_format.stdout, "NO SEMANTIC CHANGES")
        and not contains(&enum_format.stdout, "~ changed enum_format::enum:FormatEnum")
        and contains(&assertion.stdout, "~ changed assertion::static-assert:assertion_0")
        and contains(
            &assertion.stdout,
            "signature: static_assert(size_of(Pair) >= 8) -> static_assert(size_of(Pair) >= 4)",
        )
        and not contains(&assertion.stdout, "NO SEMANTIC CHANGES")
        and contains(&assertion_format.stdout, "NO SEMANTIC CHANGES")
        and not contains(&assertion_format.stdout, "- removed assertion_format::static-assert:")
        and not contains(&assertion_format.stdout, "+ added assertion_format::static-assert:")
        and contains(&type_change.stdout, "~ changed type_format::field:Holder.items")
        and contains(&type_change.stdout, "type: CinderList_i32 -> CinderList_i64")
        and not contains(&type_change.stdout, "NO SEMANTIC CHANGES")
        and contains(&standalone.stdout, "NO SEMANTIC CHANGES")
        and not contains(&worktrees.stdout, "cinder-semantic-diff.")
    )
    expect(state, "semantic-diff reports canonical changes", ok)
    if not ok:
        report_process_failure(&result.stdout, &result.stderr)
        report_process_failure(&selected.stdout, &selected.stderr)
        report_process_failure(&implementation.stdout, &implementation.stderr)
        report_process_failure(&type_format.stdout, &type_format.stderr)
        report_process_failure(&enum_format.stdout, &enum_format.stderr)
        report_process_failure(&assertion.stdout, &assertion.stderr)
        report_process_failure(&assertion_format.stdout, &assertion_format.stderr)
        report_process_failure(&type_change.stdout, &type_change.stderr)
        report_process_failure(&standalone.stdout, &standalone.stderr)


def write_test_text(path: String, content: String) -> void:
    with open(path, "wb") as file:
        file.write(content)


def semantic_diff_stress_source(function_count: i32, reverse_fields: bool) -> String:
    builder = StringBuilder()
    append_layout_fixture(&builder, reverse_fields)
    builder.append("const multiline_value: i32 = (\n")
    if reverse_fields:
        builder.append("    2\n")
    else:
        builder.append("    1\n")
    builder.append(")\n\n\n")
    builder.append("def multiline_signature(\n")
    if reverse_fields:
        builder.append("    value: i64,\n")
    else:
        builder.append("    value: i32,\n")
    builder.append(") -> i32:\n")
    builder.append("    return 0\n\n\n")
    append_caller_chain(&builder, function_count, reverse_fields)
    return builder.finish()


def caller_chain_source(function_count: i32) -> String:
    builder = StringBuilder()
    append_caller_chain(&builder, function_count, false)
    return builder.finish()


def append_caller_chain(
    builder: &StringBuilder,
    function_count: i32,
    change_leaf: bool,
) -> void:
    builder.append("def node_0(value: i32) -> i32:\n")
    if change_leaf:
        builder.append("    return value + 1\n\n\n")
    else:
        builder.append("    return value\n\n\n")
    index: i32 = 1
    while index < function_count:
        current = to_string(index)
        previous = to_string(index - 1)
        builder.append("def node_")
        builder.append(current)
        builder.append("(value: i32) -> i32:\n")
        builder.append("    return node_")
        builder.append(previous)
        builder.append("(value) + 1\n\n\n")
        index += 1
    final_index = to_string(function_count - 1)
    builder.append("def main() -> i32:\n")
    builder.append("    return node_")
    builder.append(final_index)
    builder.append("(0)\n")


def append_layout_fixture(builder: &StringBuilder, reverse_fields: bool) -> void:
    builder.append("struct LayoutStruct:\n")
    append_layout_fields(builder, reverse_fields)
    builder.append("class LayoutClass:\n")
    append_layout_fields(builder, reverse_fields)
    builder.append("union LayoutUnion:\n")
    append_layout_fields(builder, reverse_fields)
    builder.append("enum LayoutEnum:\n")
    if reverse_fields:
        builder.append("    second\n")
        builder.append("    first\n\n\n")
    else:
        builder.append("    first\n")
        builder.append("    second\n\n\n")
    builder.append("enum ValueEnum:\n")
    if reverse_fields:
        builder.append("    first = 3\n")
    else:
        builder.append("    first = 1\n")
    builder.append("    second = 7\n\n\n")
    builder.append("variant LayoutVariant:\n")
    if reverse_fields:
        builder.append("    Second\n")
        builder.append("    First(value: i32)\n\n\n")
    else:
        builder.append("    First(value: i32)\n")
        builder.append("    Second\n\n\n")
    builder.append("@reflect\n")
    builder.append("struct ModifierStruct:\n")
    if reverse_fields:
        builder.append("    value: i32\n\n\n")
    else:
        builder.append("    private value: i32\n\n\n")
    builder.append("abstract class ModifierBase:\n")
    if not reverse_fields:
        builder.append("    @abstractmethod\n")
    builder.append("    def apply(self, value: i32) -> i32:\n")
    builder.append("        pass\n\n\n")
    builder.append("class ModifierImpl(ModifierBase):\n")
    if not reverse_fields:
        builder.append("    @override\n")
    builder.append("    def apply(self, value: i32) -> i32:\n")
    builder.append("        return value\n\n\n")
    builder.append("@reflect\n")
    builder.append("class MethodOrder:\n")
    if reverse_fields:
        append_reflected_method(builder, "second", 2)
        append_reflected_method(builder, "first", 1)
    else:
        append_reflected_method(builder, "first", 1)
        append_reflected_method(builder, "second", 2)
    builder.append("class UnreflectedMethodBase:\n")
    if reverse_fields:
        append_reflected_method(builder, "inherited_second", 2)
        append_reflected_method(builder, "inherited_first", 1)
    else:
        append_reflected_method(builder, "inherited_first", 1)
        append_reflected_method(builder, "inherited_second", 2)
    builder.append("@reflect\n")
    builder.append("class ReflectedMethodChild(UnreflectedMethodBase):\n")
    append_reflected_method(builder, "own_method", 3)
    builder.append("class SpecializedBase[T]:\n")
    builder.append("    value: T\n\n\n")
    builder.append("class MultilineDerived(\n")
    if reverse_fields:
        builder.append("    SpecializedBase[i64],\n")
    else:
        builder.append("    SpecializedBase[i32],\n")
    builder.append("):\n")
    builder.append("    pass\n\n\n")


def append_reflected_method(
    builder: &StringBuilder,
    name: String,
    value: i32,
) -> void:
    builder.append("    def ")
    builder.append(name)
    builder.append("(self) -> i32:\n")
    builder.append("        return ")
    builder.append(to_string(value))
    builder.append("\n\n\n")


def append_layout_fields(builder: &StringBuilder, reverse_fields: bool) -> void:
    if reverse_fields:
        builder.append("    second: i64\n")
        builder.append("    first: i32\n\n\n")
    else:
        builder.append("    first: i32\n")
        builder.append("    second: i64\n\n\n")


def expect(state: &TestState, name: String, condition: bool) -> void:
    if condition:
        state.passed += 1
        print("PASS", name)
    else:
        state.failed += 1
        print("FAIL", name)


def report_process_failure(stdout: &const String, stderr: &const String) -> void:
    if len(stdout) > 0:
        cinder.write_stderr("--- stdout ---\n")
        output = stdout[0:len(stdout)]
        cinder.write_stderr(output)
    if len(stderr) > 0:
        cinder.write_stderr("--- stderr ---\n")
        error = stderr[0:len(stderr)]
        cinder.write_stderr(error)


def contains(text: &const String, fragment: String) -> bool:
    if len(fragment) == 0:
        return true
    if len(fragment) > len(text):
        return false
    limit = len(text) - len(fragment)
    for start in range(0, limit + 1):
        if text[start:start + len(fragment)] == fragment:
            return true
    return false
