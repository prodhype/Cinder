import cache
import call_targets
import type_targets
from call_targets import Child
from call_targets import action
from model import CacheEntry
from type_targets import Target
from value_targets import LIMIT

extern import "stdlib.h"
extern "C":
    def abs(value: c_int) -> c_int


def lookup_twice(key: i32) -> CacheEntry:
    first = cache.cache_get(key)
    return cache.cache_get(first.value)


def call_shadowed(action: def(i32) -> i32, value: i32) -> i32:
    return action(value)


def call_top_level(value: i32) -> i32:
    return call_targets.run(value)


def call_imported_method(value: i32) -> i32:
    child = Child()
    return child.work(value) + child.run(value)


@export
def cinder_cache_lookup(key: i32) -> i32:
    return lookup_twice(key).value


def main() -> i32:
    if cinder_cache_lookup(-1) != 2:
        return 1
    return 0


def use_qualified_target(value: type_targets.Target) -> type_targets.Target:
    return value


def identity[Target](value: Target) -> Target:
    return value


def use_imported_target(value: Target) -> Target:
    return value


def read_imported_limit() -> i32:
    return LIMIT


def read_shadowed_limit(LIMIT: i32) -> i32:
    return LIMIT
