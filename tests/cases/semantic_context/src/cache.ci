import model
import lock_collision


lock database
lock cache after database

request_count: i32 = 0


def hash_key(key: i32) -> i32:
    return key + 1


def cache_get(key: i32) -> model.CacheEntry:
    hashed = hash_key(key)
    CriticalSection cache:
        request_count += 1
    return model.CacheEntry(value=hashed)


struct CacheWorker:
    def refresh(self) -> void:
        CriticalSection cache:
            request_count += 1


def cache_entry_value(entry: model.CacheEntry) -> i32:
    return entry.value


@export
def export_cache_entry(key: i32) -> model.CacheEntry:
    return cache_get(key)


@export
def export_borrowed_entry_value(entry: &model.BorrowedEntry) -> i32:
    return entry.value


@export
def export_status(status: model.Status) -> i32:
    return 0


extern "C":
    def consume_cache_entry(entry: model.CacheEntry) -> i32
