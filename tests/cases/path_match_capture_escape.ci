from std.path import Path


def borrowed_capture() -> bool:
    match Path.name("a/b"):
        case value:
            return value == "b"
    return false


def returned_capture() -> String:
    match Path.name("a/b"):
        case value:
            return value
    return ""


def assigned_capture() -> String:
    result = ""
    match Path.name("a/b"):
        case value:
            result = value
    return result


def collected_capture() -> String:
    values: List[String] = []
    match Path.name("a/b"):
        case value:
            values.append(value)
    return values.pop()


def main() -> i32:
    if not borrowed_capture():
        return 1
    returned = returned_capture()
    assigned = assigned_capture()
    collected = collected_capture()
    if returned != "b" or assigned != "b" or collected != "b":
        return 1
    return 0
