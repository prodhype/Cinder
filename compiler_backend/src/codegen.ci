import syntax
from syntax import NodeId, SyntaxArena, SyntaxKind


def emit_c(arena: &const SyntaxArena, root: NodeId, source: &const String) -> String:
    builder = StringBuilder()
    builder.append("#include <stdint.h>\n")
    builder.append("#include <stdbool.h>\n\n")
    emit_top_level(arena, root, source, builder)
    return builder.finish()


def emit_top_level(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.MODULE:
        for offset in range(0, node.child_count):
            emit_top_level(arena, arena.children[node.first_child + offset], source, builder)
        return
    if node.kind == SyntaxKind.STRUCT_DECL:
        emit_struct(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.ENUM_DECL:
        emit_enum(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.UNION_DECL:
        emit_union(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.FUNCTION_DECL:
        emit_function(arena, id, source, builder)
        return


def emit_struct(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef struct ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    int32_t ")
            append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_enum(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef enum ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    emitted = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.ENUM_MEMBER_DECL:
            if emitted:
                builder.append(",\n")
            builder.append("    ")
            append_source(builder, source, node.value_start, node.value_length)
            builder.append("_")
            append_source(builder, source, child.value_start, child.value_length)
            emitted = true
    if emitted:
        builder.append("\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_union(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    builder.append("typedef union ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(" {\n")
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.FIELD_DECL:
            builder.append("    int32_t ")
            append_source(builder, source, child.value_start, child.value_length)
            builder.append(";\n")
    builder.append("} ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append(";\n\n")


def emit_function(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    return_type = find_direct_child_kind(arena, id, SyntaxKind.TYPE_NAME)
    emit_c_type(arena, return_type, source, builder)
    builder.append(" ")
    append_source(builder, source, node.value_start, node.value_length)
    builder.append("(")
    emitted_parameter = false
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == SyntaxKind.PARAMETER:
            if emitted_parameter:
                builder.append(", ")
            emit_parameter(arena, child_id, source, builder)
            emitted_parameter = true
    if not emitted_parameter:
        builder.append("void")
    builder.append(") {\n")
    body = find_child_kind(arena, id, SyntaxKind.BLOCK)
    if body.index >= 0:
        emit_block(arena, body, source, builder)
    builder.append("}\n\n")


def emit_parameter(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    parameter_type = find_child_kind(arena, id, SyntaxKind.TYPE_NAME)
    emit_c_type(arena, parameter_type, source, builder)
    builder.append(" ")
    append_source(builder, source, node.value_start, node.value_length)


def emit_block(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        emit_statement(arena, arena.children[node.first_child + offset], source, builder)


def emit_statement(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.RETURN_STMT:
        builder.append("    return")
        expr = first_child(arena, id)
        if expr.index >= 0:
            builder.append(" ")
            emit_expression(arena, expr, source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.VAR_DECL_STMT:
        builder.append("    int32_t ")
        append_source(builder, source, node.value_start, node.value_length)
        expr = last_child(arena, id)
        if expr.index >= 0 and arena.nodes[expr.index].kind != SyntaxKind.TYPE_NAME:
            builder.append(" = ")
            emit_expression(arena, expr, source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.ASSIGN_STMT:
        builder.append("    ")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(" = ")
        emit_expression(arena, second_child(arena, id), source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.IF_STMT:
        emit_if(arena, id, source, builder)
        return
    if node.kind == SyntaxKind.WHILE_STMT:
        builder.append("    while (")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(") {\n")
        emit_block(arena, second_child(arena, id), source, builder)
        builder.append("    }\n")
        return
    if node.kind == SyntaxKind.BREAK_STMT:
        builder.append("    break;\n")
        return
    if node.kind == SyntaxKind.CONTINUE_STMT:
        builder.append("    continue;\n")
        return
    if node.kind == SyntaxKind.EXPR_STMT:
        builder.append("    ")
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(";\n")
        return
    if node.kind == SyntaxKind.PASS_STMT:
        builder.append("    ;\n")


def emit_if(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    builder.append("    if (")
    emit_expression(arena, first_child(arena, id), source, builder)
    builder.append(") {\n")
    emit_block(arena, second_child(arena, id), source, builder)
    builder.append("    }")
    node = arena.nodes[id.index]
    for offset in range(2, node.child_count):
        branch_id = arena.children[node.first_child + offset]
        branch = arena.nodes[branch_id.index]
        if branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 1:
            builder.append(" else if (")
            emit_expression(arena, first_child(arena, branch_id), source, builder)
            builder.append(") {\n")
            emit_block(arena, second_child(arena, branch_id), source, builder)
            builder.append("    }")
        elif branch.kind == SyntaxKind.IF_BRANCH and branch.flags == 2:
            builder.append(" else {\n")
            emit_block(arena, first_child(arena, branch_id), source, builder)
            builder.append("    }")
    builder.append("\n")


def emit_expression(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        builder.append("0")
        return
    node = arena.nodes[id.index]
    if node.kind == SyntaxKind.EXPR_LITERAL or node.kind == SyntaxKind.EXPR_NAME:
        append_source(builder, source, node.value_start, node.value_length)
        return
    if node.kind == SyntaxKind.EXPR_BINARY:
        emit_expression(arena, first_child(arena, id), source, builder)
        builder.append(" ")
        append_source(builder, source, node.value_start, node.value_length)
        builder.append(" ")
        emit_expression(arena, second_child(arena, id), source, builder)
        return
    if node.kind == SyntaxKind.EXPR_UNARY:
        append_source(builder, source, node.value_start, node.value_length)
        emit_expression(arena, first_child(arena, id), source, builder)
        return
    if node.kind == SyntaxKind.EXPR_CALL:
        callee = first_child(arena, id)
        emit_expression(arena, callee, source, builder)
        builder.append("(")
        emitted_argument = false
        for offset in range(1, node.child_count):
            child_id = arena.children[node.first_child + offset]
            child = arena.nodes[child_id.index]
            if child.kind == SyntaxKind.EXPR_ARGUMENT:
                if emitted_argument:
                    builder.append(", ")
                emit_expression(arena, last_child(arena, child_id), source, builder)
                emitted_argument = true
        builder.append(")")
        return
    if node.kind == SyntaxKind.EXPR_CAST:
        builder.append("(int32_t)(")
        emit_expression(arena, last_child(arena, id), source, builder)
        builder.append(")")
        return
    append_source(builder, source, node.start, node.length)


def first_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child]


def second_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 1:
        return syntax.missing_node()
    return arena.children[node.first_child + 1]


def last_child(arena: &const SyntaxArena, id: NodeId) -> NodeId:
    node = arena.nodes[id.index]
    if node.child_count <= 0:
        return syntax.missing_node()
    return arena.children[node.first_child + node.child_count - 1]


def find_child_kind(arena: &const SyntaxArena, id: NodeId, kind: SyntaxKind) -> NodeId:
    node = arena.nodes[id.index]
    for offset in range(0, node.child_count):
        child_id = arena.children[node.first_child + offset]
        child = arena.nodes[child_id.index]
        if child.kind == kind:
            return child_id
    return syntax.missing_node()


def find_direct_child_kind(arena: &const SyntaxArena, id: NodeId, kind: SyntaxKind) -> NodeId:
    return find_child_kind(arena, id, kind)


def emit_c_type(arena: &const SyntaxArena, id: NodeId, source: &const String, builder: &StringBuilder) -> void:
    if id.index < 0:
        builder.append("int32_t")
        return
    node = arena.nodes[id.index]
    if range_text_equals(source, node.value_start, node.value_length, "void"):
        builder.append("void")
    elif range_text_equals(source, node.value_start, node.value_length, "bool"):
        builder.append("bool")
    elif range_text_equals(source, node.value_start, node.value_length, "i64"):
        builder.append("int64_t")
    else:
        builder.append("int32_t")


def append_source(builder: &StringBuilder, source: &const String, start: usize, length: usize) -> void:
    if length == 0:
        return
    builder.append(source[start:start + length])


def range_text_equals(source: &const String, start: usize, length: usize, text: String) -> bool:
    if length != len(text):
        return false
    offset: usize = 0
    while offset < length:
        if source.byte_at(start + offset) != text.byte_at(offset):
            return false
        offset += 1
    return true
