import syntax
from syntax import NodeId


struct ClassSummary:
    declaration: NodeId
    field_count: i32
    method_count: i32
    base_count: i32
    is_abstract: bool


def summarize_class(arena: &const syntax.SyntaxArena, declaration: NodeId) -> ClassSummary:
    node = arena.nodes[declaration.index]
    field_count: i32 = 0
    method_count: i32 = 0
    base_count: i32 = 0
    offset: i32 = 0
    while offset < node.child_count:
        child = arena.nodes[arena.children[node.first_child + offset].index]
        if child.kind == syntax.SyntaxKind.FIELD_DECL:
            field_count += 1
        elif child.kind == syntax.SyntaxKind.FUNCTION_DECL:
            method_count += 1
        elif is_type_node(child.kind):
            base_count += 1
        offset += 1
    return ClassSummary(
        declaration=declaration,
        field_count=field_count,
        method_count=method_count,
        base_count=base_count,
        is_abstract=node.flags == 1,
    )


def is_type_node(kind: syntax.SyntaxKind) -> bool:
    return kind == syntax.SyntaxKind.TYPE_NAME or kind == syntax.SyntaxKind.TYPE_GENERIC or kind == syntax.SyntaxKind.TYPE_CONST or kind == syntax.SyntaxKind.TYPE_POINTER or kind == syntax.SyntaxKind.TYPE_REFERENCE or kind == syntax.SyntaxKind.TYPE_ARRAY or kind == syntax.SyntaxKind.TYPE_SLICE or kind == syntax.SyntaxKind.TYPE_DYN or kind == syntax.SyntaxKind.TYPE_FUNCTION or kind == syntax.SyntaxKind.TYPE_CLOSURE
